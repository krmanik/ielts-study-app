{"w":2400,"h":3106,"lines":[{"h":0.015594468912000559,"t":"Test 1","y":0.080485729714332988,"c":1,"x":0.10686507936525023,"w":0.058787218729654936},{"y":0.1292368372880035,"x":0.10880667436240778,"t":"Questions 38-40","w":0.17149753570556642,"h":0.018309631273966009,"c":1},{"x":0.10893834444144006,"y":0.15941281837191035,"w":0.78216013590494804,"h":0.022029407547891067,"c":1,"t":"Do the following statements agree with the claims of the writer in Reading Passage 3?"},{"h":0.018522064837807606,"c":1,"t":"In boxes 38-40 on your answer sheet, wnite","x":0.10703711352906406,"y":0.19751901107242575,"w":0.39868230183919262},{"c":1,"t":"YES","h":0.013081395234588844,"w":0.04135338465372726,"x":0.18045112712802361,"y":0.23982558141976951},{"c":1,"x":0.18045112812492506,"t":"NO","w":0.031954886118570947,"h":0.014534883321060788,"y":0.25726744191505102},{"h":0.014564832870375355,"c":1,"t":"NOT GIVEN","x":0.18045112667554183,"y":0.27616279088485918,"w":0.1127819569905599},{"y":0.23669034749525819,"h":0.020265667651901631,"c":1,"t":"if the statement agrees with the claims of the writer","x":0.31001892238370998,"w":0.46645507812499998},{"y":0.25724404356887187,"x":0.31015037048825755,"w":0.46052632649739589,"c":1,"h":0.014558281809456286,"t":"if the statement contradicts the claims of the writer"},{"w":0.51518218994140619,"t":"if it is impossible to say what the writer thinks about this","c":1,"y":0.27443804732725963,"x":0.30069350026560454,"h":0.019922257697897017},{"t":"38 Moffat's research may help explain people's reactions to EMI.","c":1,"h":0.01751486255672785,"x":0.11090226836747458,"y":0.32260141663835107,"w":0.60338343302408859},{"h":0.013081395234588733,"x":0.11278195450455705,"y":0.35319767442122307,"t":"39","c":1,"w":0.024436090787251785},{"y":0.35174418591501588,"t":"The non-experts in Moffat's study all responded in a predictable way.","x":0.14285714103329089,"c":1,"h":0.017541068642659807,"w":0.63909774780273443},{"c":1,"y":0.38081395350662084,"t":"40","h":0.014534