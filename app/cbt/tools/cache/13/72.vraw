{"lines":[{"t":"Test 3","y":0.067510013546961845,"w":0.06294989903767903,"h":0.023410205141007334,"c":1,"x":0.17059271987540831},{"h":0.023462525200091622,"c":1,"y":0.11619069604065713,"t":"WRITING TASK 2","x":0.17272390942434745,"w":0.22789843241373697},{"h":0.022433969334334058,"x":0.16904681839574556,"w":0.43635396321614583,"y":0.15521648825048784,"c":1,"t":"You should spend about 40 minutes on this task."},{"c":1,"x":0.17087871150551687,"y":0.19029827420933754,"t":"Write about the following topic:","w":0.28419390360514324,"h":0.022407400324048421},{"x":0.19167354942612558,"t":"Some people say History is one of the most important school subjects. Other","y":0.23834019190343636,"h":0.023048097520817268,"c":1,"w":0.72192220052083333},{"x":0.18973831568356408,"y":0.25463898858012546,"h":0.026085152905446329,"c":1,"t":"people think that, in today's world, subjects like Science and Technology are","w":0.71828440348307288},{"h":0.021893110109465597,"c":1,"x":0.19172932822423011,"y":0.274629748481654,"t":"more important than History.","w":0.27255638122558601},{"c":1,"h":0.023760980432907197,"y":0.30948989212084821,"x":0.19156297440480149,"w":0.50035934448242181,"t":"Discuss both these views and give your own opinion."},{"c":1,"y":0.3589548779597227,"t":"Give reasons for your answer and include any relevant examples from your own","h":0.02173567831477885,"w":0.70512125651041657,"x":0.17091192118460233},{"t":"knowledge or experience.","x":0.16917293577199832,"w":0.23120300292968748,"h":0.018995492594977459,"y":0.37636831949279015,"c":1},{"h":0.017804675154431182,"c":1,"t":"Write at least 250 words.","w":0.22406613667805989,"y":0.41253846125457816,"x":0.16901360515841504},{"h":0.011627907148116789,"w":0.026315789222717267,"t":"74","c":1,"x":0.16353383462519427,"y":0.9607558138230794}],"h":3106,"w":2400}