{"lines":[{"y":0.079652648352118494,"t":"Reading","w":0.081316032409668004,"x":0.78927596557846258,"c":1,"h":0.020066512452350915},{"y":0.12936046529914058,"w":0.16917292277018228,"c":1,"h":0.015988371407532842,"t":"Questions 27-29","x":0.067669176096111894},{"x":0.067537170205300326,"t":"Choose the correct letter, A, B, C or D.","w":0.35175320943196614,"c":1,"y":0.16709340231164527,"h":0.020992836642096391},{"h":0.019407078902028974,"t":"Write the correct letter in boxes 27-29 on your answer sheet.","x":0.067600925988592492,"w":0.55089294433593761,"c":1,"y":0.20345258289292534},{"y":0.24114616884561635,"h":0.019028249741828818,"t":"27 What is the reviewer's attitude to advocates of positive psychology?","w":0.65977442423502608,"c":1,"x":0.06390978026213967},{"y":0.27034883707653945,"w":0.4266917419433594,"c":1,"t":"They are wrong to reject the ideas of Bentham.","h":0.017481169544030783,"x":0.15413533193318557},{"c":1,"h":0.013081395234588733,"w":0.016917292277018228,"x":0.10902255677502472,"y":0.2892441860101973,"t":"B"},{"h":0.019034801416833114,"x":0.15413534664455672,"w":0.56390975952148437,"c":1,"t":"They are over-influenced by their study of Bentham's theories.","y":0.28779069764371079},{"h":0.018995492594977459,"t":"They have a fresh new approach to ideas on human happiness.","x":0.15225563421618205,"y":0.30811332880875486,"w":0.58082707722981775,"c":1},{"t":"D They are ignorant about the ideas they should be considering.","x":0.10893968565082332,"w":0.60919235229492186,"y":0.32467367368903655,"h":0.02132137713705573,"c":1},{"x":0.063909774061261332,"c":1,"y":0.35465116292456467,"t":"28","h":0.014534883321060899,"w":0.024436090787251785},{"h":0.020429326270521631,"c":1,"x":0.10714286278237921,"w":0.70300750732421879,"y":0.35465116294495513,"t":"The reviewer refers to the Greek philosopher Aristotle in order to suggest that"},{"t":"happiness","y":0.37315066846090228,"x":0.10702692719598045,"w":0.097976220448811852,"h":0.018233546731706962,"c":1},{"y":0.40116279092621698,"t":"A","x":0.10714285715192967,"w":0.018796992301940929,"c":1,"h":0.015988371407532842},{"t":"may not be just pleasure and the absence of pain.","x":0.15216412259660839,"w":0.45697204589843754,"h":0.019481368473246996,"y":0.40223096773077061,"c":1},{"y":0.42151162787066254,"h":0.013081395234588733,"c":1,"w":0.016917292277018228,"x":0.10714285752690443,"t":"B"},{"x":0.15037593590671841,"y":0.42144236940109214,"w":0.36466166178385417,"h":0.017511119093345351,"t":"should not be the main goal of humans.","c":1},{"w":0.016917292277018228,"c":1,"y":0.44040697671955154,"x":0.10714285753865255,"h":0.013081395234588733,"t":"C"},{"t":"D","h":0.014534883321060899,"x":0.10714285754256858,"y":0.45784883728811299,"w":0.016917292277018228,"c":1},{"x":0.1503759435740534,"y":0.44040697661113803,"c":1,"w":0.38533833821614583,"h":0.017441860722175129,"t":"is not something that should be fought for."},{"w":0.28195487976074218,"h":0.017516734288418934,"y":0.45930232544689265,"t":"is not just an abstract concept.","x":0.15037594348300312,"c":1},{"x":0.062030075617268116,"y":0.48691860477842308,"h":0.014534883321060788,"c":1,"w":0.024436089197794594,"t":"29"},{"t":"According to Davies, Bentham's suggestion for linking the price of goods to","y":0.48546511618180077,"w":0.68421051025390622,"h":0.020348836895119238,"x":0.10338346507981384,"c":1},{"x":0.10526315688280793,"y":0.5057952348062934,"t":"happiness was significant because","c":1,"w":0.31954887390136721,"h":0.017460579267257526},{"t":"it was the first successful way of assessing happiness.","y":0.5320372003390279,"x":0.15023803606662423,"w":0.49656173706054685,"h":0.021801827572578758,"c":1},{"t":"B","x":0.10714285752690443,"y":0.55377906973112756,"h":0.013081395234588844,"w":0.016917292277018228,"c":1},{"h":0.014534883321060899,"y":0.57122093031136878,"w":0.015037593841552746,"t":"C","x":0.10714285712057701,"c":1},{"y":0.59011627903345321,"t":"D","x":0.10714285713400344,"w":0.015037593841552732,"h":0.013081395234588844,"c":1},{"x":0.14830937760834645,"c":1,"t":"it established a connection between work and psychology.","y":0.55015620007366772,"w":0.53050638834635411,"h":0.022808347605000945},{"y":0.57078575642083651,"h":0.020131084739355987,"x":0.14839587179367375,"c":1,"t":"it was the first successful example of psychological research.","w":0.55660929361979172},{"y":0.58766324251539048,"x":0.15018091143970774,"w":0.47035069783528644,"h":0.021668740571581524,"c":1,"t":"it involved consideration of the rights of consumers."}],"w":2400,"h":3106}