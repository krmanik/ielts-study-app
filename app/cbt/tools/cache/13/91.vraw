{"lines":[{"t":"Reading","h":0.020081034339172854,"x":0.77798956359888027,"y":0.069330779956757294,"w":0.079655672709146974,"c":1},{"w":0.16541353861490884,"c":1,"y":0.12354651181929177,"x":0.075187967441771614,"h":0.014573256277070845,"t":"Questions 35-40"},{"x":0.073245192615176508,"y":0.15623113881864836,"w":0.76141667683919279,"h":0.02149960431297282,"t":"Do the following statements agree with the claims of the writer in Reading Passage 3?","c":1},{"y":0.19476744169559845,"h":0.017441860722175129,"c":1,"w":0.38721804300944018,"x":0.073308272284440312,"t":"In boxes 35-40 on your answer sheet, write"},{"t":"YES","x":0.14266805674693445,"w":0.039851856231689436,"h":0.013776948662320043,"y":0.23221036284719476,"c":1},{"y":0.22895147208508204,"t":"if the statement agrees with the claims of the writer","x":0.26682440940123153,"w":0.45509699503580725,"c":1,"h":0.020393309559426087},{"t":"NO","y":0.25000000007881074,"x":0.14097744392379724,"w":0.031954886118570974,"h":0.014534883321060788,"c":1},{"h":0.016102555023802423,"c":1,"x":0.2687969937834917,"w":0.44736841837565106,"y":0.24854651135064543,"t":"if the statement contradicts the claims of the writer"},{"x":0.14097744523757411,"c":1,"y":0.26883451391858182,"t":"NOT GIVEN","h":0.013200257566001294,"w":0.11090225219726563},{"t":"if it is impossible to say what the writer thinks about this","x":0.25552851272557137,"w":0.50402501424153656,"y":0.26425190998956127,"h":0.022060040574033879,"c":1},{"h":0.014534883321060788,"t":"35","x":0.073308270715419843,"y":0.31395348851612437,"w":0.026315789222717295,"c":1},{"h":0.023098868857025723,"x":0.11642580288117652,"w":0.66381484985351558,"c":1,"t":"One strength of The Happiness Industry is its discussion of the relationship","y":0.31055423972869645},{"c":1,"h":0.019630903746340245,"w":0.33290285746256509,"x":0.11643277104108174,"y":0.33120930993676723,"t":"between psychology and economics."},{"y":0.36191860464882608,"w":0.026315789222717281,"c":1,"t":"36","h":0.013081395234588733,"x":0.073308270699646155},{"y":0.35898261440636936,"h":0.016097875080489321,"t":"It is more difficult to measure some emotions than others.","w":0.52443608601888025,"c":1,"x":0.10338346505446959},{"h":0.014534883321060788,"t":"37","x":0.073308270301862821,"w":0.024436090787251799,"c":1,"y":0.38953488385479729},{"x":0.11462472223077479,"t":"Watson's ideas on behaviourism were supported by research on humans he carried","w":0.74069493611653647,"c":1,"y":0.38660314358560044,"h":0.018474099870965488},{"y":0.40695428202967265,"w":0.15037593841552732,"c":1,"h":0.017464322730639803,"t":"out before 1915.","x":0.11654135405873593},{"x":0.073249530408302232,"y":0.43291799812102383,"h":0.018926127987067609,"c":1,"w":0.72002705891927077,"t":"38 Watson's ideas have been most influential on governments outside America."},{"t":"39 The need for happiness is linked to industrialisation.","y":0.46099533391027347,"w":0.5058075968424478,"h":0.019667536384892048,"x":0.073211268358430601,"c":1},{"x":0.073308263911517596,"y":0.48969735966000649,"t":"40 A main aim of government should be to increase the happiness of the population.","c":1,"w":0.76315790812174478,"h":0.017707662588538287},{"t":"93","y":0.96220930245944836,"x":0.83082706731143219,"w":0.024436090787251841,"h":0.014534883321060788,"c":1}],"h":3106,"w":2400}