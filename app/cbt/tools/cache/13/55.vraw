{"h":3106,"w":2400,"lines":[{"t":"Listening","x":0.7777946356892208,"y":0.075835095714004153,"c":1,"w":0.085530560811360679,"h":0.017804648748767526},{"t":"SECTION 3","h":0.016097875080489321,"x":0.06390977424775196,"y":0.12781712842832882,"w":0.14661654154459636,"c":1},{"t":"Questions 21-30","x":0.26487774329914748,"y":0.12634559093084186,"h":0.017796639849582352,"c":1,"w":0.19395064036051435},{"w":0.16729323069254559,"h":0.014598526497157427,"c":1,"y":0.16569767461018603,"x":0.065789474785306126,"t":"Questions 21-24"},{"t":"Choose the correct letter, A, B or C.","x":0.065789481422807508,"y":0.20203488354625776,"h":0.018895348808647183,"w":0.32330825805664065,"c":1},{"y":0.24090212831062008,"t":"Project on using natural dyes to colour fabrics","w":0.61485855102539066,"h":0.024520280817133866,"c":1,"x":0.15404882915060947},{"w":0.45690129597981771,"x":0.061944192737423076,"h":0.019924409452439562,"c":1,"y":0.28192065528900145,"t":"21 What first inspired Jim to choose this project?"},{"t":"textiles displayed in an exhibition","y":0.3124999997225576,"w":0.32142857869466146,"c":1,"x":0.13157894365000042,"h":0.015988372635703185},{"t":"B a book about a botanic garden","x":0.10714285341582713,"y":0.33129426890896319,"w":0.32142857869466146,"h":0.016097875080489321,"c":1},{"w":0.015037593841552732,"x":0.10714285713400344,"y":0.35029069763810428,"t":"C","h":0.013081395234588844,"c":1},{"c":1,"x":0.14849624367547284,"w":0.24060150146484374,"t":"carpets he saw on holiday","y":0.34867997428243558,"h":0.017707662588538176},{"w":0.61842107137044278,"c":1,"h":0.01745683518978991,"x":0.10338344921068937,"t":"Jim eventually decided to do a practical investigation which involved","y":0.37790697661220962},{"c":1,"x":0.1503759391770538,"h":0.016097875080489321,"y":0.40695428190156702,"t":"using a range of dyes with different fibres.","w":0.37969924926757814},{"x":0.14840878138562461,"t":"applying different dyes to one type of fibre.","w":0.38926465352376294,"c":1,"h":0.019183810418909486,"y":0.42448891295649371},{"c":1,"h":0.013081395234588733,"x":0.063909774061261332,"y":0.47383720929998896,"t":"23","w":0.024436090787251785},{"c":1,"h":0.013081395234588844,"x":0.10714285712057701,"y":0.44476744180857763,"w":0.015037593841552746,"t":"C"},{"w":0.016917292277018242,"h":0.014534883321060788,"c":1,"x":0.1052631582787841,"y":0.50145348842667892,"t":"A"},{"y":0.44331395375590454,"t":"testing one dye and a range of fibres.","w":0.34586466471354166,"h":0.017441859494004897,"c":1,"x":0.14473684348909377},{"w":0.46052632649739578,"c":1,"h":0.018995492594977348,"x":0.10714285171169413,"t":"When doing his experiments, Jim was surprised by","y":0.47231165497098648},{"c":1,"h":0.015988372635703185,"y":0.50145348809764245,"t":"how much natural material was needed to make the dye.","x":0.1390977563100384,"w":0.52631576538085934},{"x":0.13909775470744734,"c":1,"h":0.017485848873258769,"y":0.51889534910474178,"t":"the fact that dyes were widely available on the internet.","w":0.51127817789713537},{"c":1,"h":0.013081395234588844,"x":0.10714285712057701,"w":0.015037593841552746,"y":0.53924418602187707,"t":"C"},{"t":"the time that he had to leave the fabric in the dye.","w":0.45488723754882815,"h":0.017707662588538287,"y":0.53766902761088364,"c":1,"x":0.14661653154931192},{"x":0.10526315744652157,"h":0.017492400548263176,"c":1,"t":"What problem did Jim have with using tartrazine as a fabric dye?","w":0.58646616617838532,"y":0.56686046498411591},{"h":0.017707662588538287,"t":"It caused a slight allergic reaction.","w":0.31203005472819012,"x":0.14849625219417562,"y":0.59433354776792546,"c":1},{"t":"B","x":0.10714285712057701,"h":0.013081395234588844,"c":1,"w":0.015037593841552746,"y":0.61482558134346144},{"y":0.63226744187871387,"c":1,"h":0.014534883321060788,"w":0.015037593841552746,"t":"C","x":0.10714285712057701},{"c":1,"t":"It was not a permanent dye on cotton.","y":0.6148255811106853,"h":0.015988372635703185,"x":0.14849623634777251,"w":0.34774436950683596},{"t":"It was ineffective when used on nylon.","y":0.63159696868971105,"x":0.14649394144009459,"w":0.3499054972330729,"c":1,"h":0.018410357827151613}]}