39078045552,"w":0.54541107177734371,"t":"25 What surprised both students about one flavour of crisps?","y":0.62593696311578506,"h":0.020315964914335405,"c":1},{"y":0.65180356230488157,"w":0.53979919433593748,"c":1,"h":0.023289515292038043,"t":"A The percentage of artificial additives given was incorrect.","x":0.13703076169311743},{"y":0.6758720929869414,"c":1,"h":0.013081395234588844,"t":"B","x":0.1390977443251957,"w":0.015037593841552732},{"h":0.017515798422573226,"w":0.34210525512695311,"t":"The products did not contain any meat.","c":1,"x":0.18045113194054666,"y":0.67289117843484236},{"w":0.015037593841552732,"h":0.013081395234588844,"y":0.69331395345205782,"t":"C","c":1,"x":0.1390977443251957},{"y":0.68837364056225891,"h":0.022249216889076218,"x":0.17466765225550879,"w":0.35932365417480466,"c":1,"t":"The labels did not list all the ingredients."},{"x":0.095678368442008221,"t":"26 What do the students think about research into the impact of nutritional","w":0.66017364501953124,"h":0.022984518823666589,"c":1,"y":0.7146308036319784},{"w":0.13157894134521486,"t":"food labelling?","c":1,"x":0.13533834878504408,"h":0.016111914296343621,"y":0.73824855107951926},{"y":0.76431424661893044,"x":0.17848122132487559,"w":0.27463528951009114,"c":1,"h":0.016789995771949728,"t":"It did not produce clear results."},{"h":0.013081395234588733,"c":1,"x":0.13909774474494954,"t":"B","w":0.016917292277018242,"y":0.78343023248444976},{"t":"C","w":0.016917292277018242,"y":0.8008720929869414,"x":0.13909774474494951,"h":0.013081395234588844,"c":1},{"w":0.27819549560546875,"y":0.78197674390679162,"c":1,"x":0.18045112431816193,"h":0.015988372635703185,"t":"It focused on the wrong people."},{"x":0.18045113808571112,"t":"It made unrealistic recommendations.","y":0.79781068890032125,"w":0.33082705179850258,"h":0.017707662588538287,"c":1},{"c":1,"y":0.93750000013386703,"w":0.031954886118571002,"x":0.84210526357947058,"t":"79","h":0.014534883321060788}]}