{"blocks":[{"l":"paragraph_title","b":[0.1704,0.0676,0.2308,0.0856],"t":"Test 4"},{"l":"paragraph_title","b":[0.1696,0.113,0.3379,0.1333],"t":"Questions 17–20"},{"l":"text","b":[0.1667,0.1462,0.9258,0.1687],"t":"What information does Annie give about skiing on each of the following mountain trails?"},{"l":"text","b":[0.1683,0.1819,0.84,0.2209],"t":"Choose FOUR answers from the box and write the correct letter, A-F, next to Questions 17-20."},{"l":"paragraph_title","b":[0.4958,0.2489,0.6108,0.2688],"t":"Information"},{"l":"text","b":[0.3613,0.2759,0.7212,0.2975],"t":"A It has a good place to stop and rest."},{"l":"text","b":[0.3621,0.3033,0.6454,0.3245],"t":"B It is suitable for all abilities."},{"l":"text","b":[0.3621,0.3303,0.6429,0.3513],"t":"C It involves crossing a river."},{"l":"text","b":[0.3629,0.3574,0.6183,0.3786],"t":"D It demands a lot of skill."},{"l":"text","b":[0.3625,0.3847,0.6937,0.4063],"t":"E It may be closed in bad weather."},{"l":"text","b":[0.3629,0.4121,0.7042,0.4334],"t":"F It has some very narrow sections."},{"l":"paragraph_title","b":[0.2125,0.4768,0.3583,0.4965],"t":"Mountain trails"},{"l":"text","b":[0.1713,0.5119,0.5096,0.5325],"t":"17 Highland Trail"},{"l":"text","b":[0.1713,0.5383,0.5104,0.5596],"t":"18 Pine Trail"},{"l":"text","b":[0.1717,0.566,0.51,0.5866],"t":"19 Stony Trail"},{"l":"text","b":[0.1713,0.5937,0.51,0.6133],"t":"20 Loser's Trail"},{"l":"number","b":[0.1754,0.9334,0.2017,0.9495],"t":"78"}]}