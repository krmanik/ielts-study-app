,{"h":0.017463386864794206,"c":1,"w":0.45864659627278648,"x":0.3909774535360121,"t":"• than evaporation, and suggests that there was an","y":0.4258720928865759},{"w":0.25248855590820313,"t":"extended period of drought.","h":0.020964713996253548,"c":1,"x":0.071180525108762729,"y":0.44501209826970056},{"h":0.022493675610210095,"t":"Petrie and Singh's team are using archaeological records to look at 35.","y":0.48754027408150558,"c":1,"x":0.071291797511991037,"w":0.64689875284830733},{"w":0.7823512268066406,"y":0.51256981281287661,"t":"from five millennia ago, in order to know whether people had adapted their agricultural","h":0.024675144507511848,"c":1,"x":0.069337105347562725},{"c":1,"t":"practices to changing climatic conditions. They are also examining objects including","w":0.75601282755533861,"x":0.07125961043812272,"y":0.53633777494220702,"h":0.024808684703387152},{"t":", so as to find out about links between inhabitants of different parts","y":0.56330573729972011,"w":0.6054701741536459,"c":1,"h":0.021241966095265519,"x":0.25744244107463471},{"h":0.022531210954006564,"t":"of the region and whether these changed over time.","x":0.069289520537732394,"w":0.47045333862304684,"y":0.58513263547840466,"c":1}]}