{"w":2400,"h":3106,"lines":[{"x":0.17481203026081593,"w":0.062030073801676411,"h":0.017491464068332352,"t":"Test 3","y":0.065357373095080828,"c":1},{"h":0.016097875080489432,"t":"Questions 27-31","y":0.1162266579290272,"x":0.17481203117737645,"c":1,"w":0.16729323069254556},{"h":0.020617900782067489,"t":"Reading Passage 3 has eight paragraphs, A-H.","c":1,"x":0.17470659096796984,"w":0.43065216064453127,"y":0.15257593668043223},{"w":0.47007949829101559,"c":1,"h":0.019416973042779784,"t":"Which paragraph contains the following information?","y":0.18886034349872105,"x":0.17472171215713639},{"t":"Write the correct letter, A-H, in boxes 27-31 on your answer sheet.","w":0.59774434407552079,"x":0.17481203829444258,"y":0.22529069768252474,"h":0.018895348808647183,"c":1},{"x":0.17279025761089362,"w":0.40254150390624999,"h":0.020805326954288272,"c":1,"y":0.26130622825863736,"t":"NB You may use any letter more than once."},{"w":0.63174011230468752,"h":0.020099180556848117,"t":"27 proposed explanations for the decline of the Harappan Civilisation","x":0.17097269860242761,"y":0.29724779757732234,"c":1},{"y":0.32251810259443703,"c":1,"w":0.75597661336263022,"x":0.1708659816796442,"h":0.024936163878333417,"t":"28 reference to a present-day application of some archaeological research findings"},{"t":"29 a difference between the Harappan Civilisation and another culture of the same","c":1,"h":0.020707102798294796,"y":0.35288580552627136,"w":0.75017710367838542,"x":0.17096485102532655},{"t":"period","c":1,"x":0.21310584799366405,"y":0.37012884900646226,"w":0.060947176615397114,"h":0.0200715430383136},{"w":0.55451126098632819,"t":"30 a description of some features of Harappan urban design","c":1,"y":0.40115904710249639,"h":0.017445604185557517,"x":0.17105264008039056},{"w":0.65625773111979169,"t":"31 reference to the discovery of errors made by previous archaeologists","x":0.17092680222996287,"h":0.021480073947255596,"y":0.42730729997885164,"c":1},{"w":0.026315789222717295,"h":0.013081