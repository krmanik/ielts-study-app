 Hall?","x":0.07706767596981981,"c":1,"y":0.64098837196192127},{"t":"The diagrams of plant development are useful.","x":0.1597744340845369,"y":0.66999356097455121,"w":0.43233083089192709,"h":0.017506439150032138,"c":1},{"h":0.013081395234588844,"y":0.68895348832020564,"w":0.015037593841552732,"x":0.12406015035365972,"c":1,"t":"B"},{"x":0.16729323298727583,"w":0.5,"t":"The analysis of seed germination statistics is thorough.","y":0.68895348809767842,"h":0.016133440438962698,"c":1},{"h":0.015988372635703296,"c":1,"x":0.12406014109885774,"t":"C The findings on seed germination after fires are surprising.","y":0.70784883693519607,"w":0.57518798828124995}],"w":2400,"h":3106}