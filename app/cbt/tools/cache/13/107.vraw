{"w":2400,"lines":[{"t":"Audioscripts","y":0.057755032518672977,"c":1,"x":0.10329974558844529,"w":0.12046817779541014,"h":0.016757376794268586},{"y":0.10610465101922517,"c":1,"x":0.10526315659513794,"w":0.15601504007975261,"t":"SECTION 3","h":0.017527029426805618},{"t":"TUTOR:","y":0.14068831334511367,"w":0.050977058410644524,"h":0.012228024366664925,"x":0.10515056854653411,"c":1},{"c":1,"h":0.011627907148116901,"x":0.10338345905537617,"y":0.15843023241431364,"t":"JIM:","w":0.03195488611857096},{"w":0.052698895136515309,"t":"TUTOR:","y":0.19176897552339778,"h":0.011810886115315555,"c":1,"x":0.10522949970255534},{"w":0.030075187683105478,"t":"JIM:","h":0.011627907148116789,"c":1,"x":0.10714285717885542,"y":0.20930232545418082},{"c":1,"x":0.10893283014315432,"y":0.27591583743848414,"t":"TUTOR:","w":0.052811031341552725,"h":0.012121813418553562},{"y":0.29360465120499923,"x":0.10902255642697573,"c":1,"t":"JIM:","w":0.030075187683105464,"h":0.010174418447559619},{"x":0.11073073706689994,"y":0.32639493255894059,"t":"TUTOR:","w":0.051094916661580406,"h":0.010000832527587988,"c":1},{"t":"JIM:","x":0.10902255644040215,"y":0.34447674423279728,"h":0.010174418447559508,"c":1,"w":0.030075187683105464},{"x":0.10899152715665689,"w":0.052693637212117506,"c":1,"h":0.011796498099067243,"t":"TUTOR:","y":0.37636919278703318},{"h":0.011627907148116678,"x":0.10902255644040215,"c":1,"t":"JIM:","y":0.39389534870999476,"w":0.030075187683105464},{"c":1,"x":0.11079692205356634,"y":0.42704531157384518,"h":0.012188446575491452,"w":0.050962546666463215,"t":"TUTOR:"},{"y":0.44476744190509621,"h":0.010174418447559619,"w":0.028195489247639982,"c":1,"x":0.11090225528219505,"t":"JIM:"},{"x":0.11278195422778581,"w":0.04887218157450357,"h":0.0087209303610875644,"c":1,"t":"TUTOR:","y":0.46075581387178177},{"t":"JIM:","c":1,"y":0.4767441858962258,"w":0.028195489247639982,"h":0.011627907148116901,"x":0.11090225532396616},{"w":0.052843996683756514,"h":0.012214755213652229,"t":"TUTOR:","x":0.11079604667734642,"c":1,"y":0.52732285492790432},{"h":0.0087209303610875644,"y":0.59447674410282314,"t":"TUTOR:","c":1,"x":0.11466165347557919,"w":0.04887218157450357},{"t":"JIM:","x":0.11278195493664275,"w":0.030075187683105464,"y":0.61191860469791348,"h":0.010174418447559508,"c":1},{"y":0.62790697663524386,"w":0.05075188000996908,"c":1,"x":0.11278195463787261,"h":0.011627907148116789,"t":"TUTOR:"},{"h":0.010174418447559619,"c":1,"x":0.11278195493664275,"t":"JIM:","y":0.64534883725151093,"w":0.030075187683105464},{"h":0.011627907148116789,"c":1,"y":0.69476744175152294,"t":"TUTOR:","x":0.11466165387847412,"w":0.050751880009969066},{"c":1,"x":0.11466165377172244,"h":0.010174418447559619,"y":0.71220930236779001,"w":0.028195489247639954,"t":"JIM:"},{"w":0.048872181574503584,"c":1,"x":0.11654135272369949,"h":0.010174418447559619,"y":0.72819767447503225,"t":"TUTOR:"},{"y":0.13605887243636439,"h":0.018149197216733914,"t":"OK, Jim. You wanted to see me about your textile design project.","x":0.17661249650911817,"w":0.51145365397135423,"c":1},{"y":0.15186972702291635,"c":1,"h":0.020010030123777556,"t":"That's right. I've been looking at how a range of natural dyes can be used to colour","w":0.65624710083007809,"x":0.17658691111060629},{"h":0.014579807952075141,"c":1,"t":"fabrics like cotton and wool.","x":0.17481202816652919,"y":0.17151162808095632,"w":0.2255639139811198},{"y":0.18741943860957344,"h":0.018006612159940261,"x":0.1765722646180358,"t":"Why did you choose that topic?","w":0.25213768005371096,"c":1},{"h":0.02141516145704947,"x":0.17842717288627777,"y":0.20142153545346719,"c":1,"w":0.63003758748372396,"t":"Well, I got a lot of useful ideas from the museum, you know, at that exhibition of"},{"t":"textiles. But l've always been interested in anything to do with colour. Years ago,","x":0.17841267752694279,"y":0.21816214425811165,"w":0.63748799641927079,"h":0.020695705376973295,"c":1},{"y":0.23558438851719532,"w":0.65065216064453124,"h":0.019515853655852622,"x":0.17842128829140763,"t":"Iwent to a carpet shop with my parents when we were on holiday in Turkey, and I","c":1},{"y":0.25724404403749102,"w":0.2763157908121745,"t":"remember all the amazing colours.","c":1,"x":0.18045112707794364,"h":0.013200257566001183},{"x":0.18026875543687357,"t":"They might not all have been natural dyes.","w":0.34055885314941403,"y":0.27105176943006626,"h":0.018632562100618699,"c":1},{"x":0.18028496252253404,"y":0.28448273006761426,"t":"Maybe not, but for the project I decided to follow it up. And I found a great book","w":0.6263289388020834,"h":0.021819063715986964,"c":1},{"h":0.020306537478337106,"w":0.60173055013020837,"c":1,"y":0.30179216618794258,"t":"about a botanic garden in California that specialises in plants used for dyes.","x":0.18031652613305596},{"t":"OK. So, in your project, you had to include a practical investigation.","w":0.53411107381184886,"y":0.31917296733297396,"c":1,"x":0.18031520126255979,"h":0.020381958194494398},{"x":0.18023689829511008,"y":0.33272492675246745,"w":0.673434600830078,"h":0.024604324517676801,"c":1,"t":"Yeah. At first I couldn't decide on my variables. I was going to just look at one type of"},{"y":0.35505397261321692,"h":0.018491533135722937,"x":0.18027796051500228,"w":0.24844874064127603,"t":"fibre for example, like cotton ...","c":1},{"x":0.18401805504126595,"y":0.37004956239264786,"w":0.39512344360351553,"h":0.018751311440354246,"t":"... and see how different types of dyes affected it?","c":1},{"t":"Yes. Then I decided to include others as well, so I looked at cotton and wool and","y":0.3850824480828603,"h":0.022157271140172852,"c":1,"x":0.18031483632514608,"w":0.63940648396809896},{"w":0.048944867451985646,"t":"nylon.","y":0.4083488361057086,"h":0.013244187993076029,"c":1,"x":0.18229448341613641},{"c":1,"x":0.18204186881209206,"h":0.019060849682868697,"w":0.20929264068603515,"y":0.42134451651102955,"t":"With just one type of dye?"},{"x":0.18209772244249015,"h":0.022761230075735495,"w":0.52863057454427087,"t":"Various types, including some that weren't natural, for comparison.","c":1,"y":0.43551134136333192},{"c":1,"y":0.45784883722282199,"x":0.18421052635894852,"h":0.013081395234588733,"t":"OK.","w":0.030075187683105464},{"h":0.021782004902306085,"c":1,"y":0.46829103158123031,"x":0.18217501707275402,"t":"So, I did the experiments last week. I used some ready-made natural dyes, I found a","w":0.66949122111002612},{"c":1,"t":"website which supplied them, they came in just a few days, but I also made some of","w":0.66760406494140623,"h":0.02209496974023939,"y":0.48519563033632962,"x":0.18218929714607934},{"w":0.071428572336832669,"t":"my own.","y":0.51017441864133573,"x":0.18233082651367957,"c":1,"h":0.013081395234588733},{"h":0.018588204270244324,"x":0.18214680754230717,"t":"That must have taken quite a bit of time.","y":0.52125470085889536,"w":0.32177121480305992,"c":1},{"w":0.63389521280924477,"c":1,"t":"Yes, I'd thought it'd just be a matter of a teaspoon or so of dye, and actually that","h":0.023157380123101534,"x":0.18399810554061646,"y":0.5345679879889812},{"x":0.1840449857548388,"y":0.55246792483337115,"h":0.020885418402480815,"w":0.66013753255208329,"c":1,"t":"wasn't the case at all. Like I was using one vegetable, beetroot, for a red dye, and I"},{"t":"had to chop up a whole pile of it. So it all took longer than I'd expected","y":0.57012351212924128,"h":0.020215064575038078,"c":1,"x":0.1840235270807426,"w":0.55677261352539054},{"y":0.58842257025716738,"c":1,"x":0.18410687644784085,"h":0.017942486312875983,"w":0.32348981221516926,"t":"One possibility is to use food colourings."},{"w":0.42709075927734375,"x":0.18397940070747543,"y":0.6037635317598935,"t":"I did use one. That was a yellow dye, an artificial one.","h":0.021756034011005676,"c":1},{"t":"Tartrazine?","w":0.092105261484781931,"x":0.18421052705836094,"y":0.62500000004320777,"h":0.013081395234588844,"c":1},{"t":"Yeah. I used it on cotton first. It came out a great colour, but when I rinsed the","x":0.18406566509418174,"y":0.63633789375260597,"h":0.020998333932811475,"w":0.61679611206054685,"c":1},{"h":0.021330829136462226,"t":"material, the colour just washed away. I'd been going to try it out on nylon, but I","w":0.62815928141276045,"y":0.65293937347947872,"c":1,"x":0.1840591243910733},{"c":1,"w":0.17147059122721356,"y":0.67388956308495407,"t":"abandoned that idea.","x":0.18582372348349793,"h":0.015802020498497993},{"h":0.018121797963257191,"y":0.68884334810669134,"c":1,"x":0.18589985131340162,"t":"Were you worried about health issues?","w":0.31056241353352865},{"h":0.021401456303544286,"c":1,"y":0.7042464770530511,"t":"I'd thought if it's a legal food colouring, it must be safe.","x":0.1840217788230718,"w":0.43455627441406253},{"c":1,"y":0.72053028307443601,"x":0.18407159433999704,"t":"Well, it can occasionally cause allergic reactions, I believe.","h":0.021299078475254585,"w":0.46832519531250011},{"t":"So what natural dyes did you look at?","x":0.1859417824723881,"y":0.76442015368117966,"c":1,"h":0.019066186697346499,"w":0.29929176330566409},{"c":1,"t":"Well, one was turmeric. The colour's great, it's a really strong yellow. It's generally","x":0.18594251900938161,"y":0.77782910898231594,"w":0.64882751464843746,"h":0.022388897936956642},{"w":0.19736841837565103,"h":0.013081395234588733,"t":"used in dishes like curry.","c":1,"y":0.80087209306890517,"x":0.18609022678533108},{"c":1,"h":0.022575577381573786,"t":"It's meant to be quite good for your health when eaten, but you might find it's not","y":0.81147333986991099,"x":0.17842307926448456,"w":0.64886316935221355},{"c":1,"t":"permanent when it's used as a dye - a few washes, and it's gone.","w":0.52279032389322921,"h":0.018744224897140227,"y":0.83016826614338979,"x":0.1878335464501987},{"t":"Right. I used beetroot as a dye for wool. When I chop up beetroot to eat I always","x":0.1878108043327783,"w":0.63753285725911457,"y":0.84499193953651786,"h":0.020514574806228203,"c":1},{"h":0.020731968336234363,"t":"end up with bright red hands, but the wool ended up just a sort of watery cream","c":1,"y":0.86246768848899313,"x":0.18780202447565367,"w":0.63186192830403654},{"x":0.1879699275772552,"c":1,"w":0.17481202443440755,"t":"shade. Disappointing.","y":0.88372093041669419,"h":0.014540499130219486},{"t":"There's a natural dye called Tyrian purple. Have you heard of that?","y":0.89594054501334042,"w":0.53041137695312501,"x":0.18784195704596754,"h":0.020983481668151782,"c":1},{"x":0.18783542158822247,"y":0.91197319860724912,"w":0.66951573689778643,"h":0.021650148528050472,"c":1,"t":"Yes. It comes from a shellfish, and it was worn in ancient times but only by important"},{"w":0.30486803690592451,"h":0.017321374749492469,"t":"people as it was so rare. I didn't use it","y":0.9321822756307161,"x":0.18779818536510418,"c":1},{"x":0.18782048755365907,"y":0.94511992239954179,"w":0.66201828002929686,"t":"It fell out of use centuries ago, though one researcher managed to get hold of some","h":0.022252304509464471,"c":1},{"t":"recently. But that shade of purple can be produced by chemical dyes nowadays.","x":0.18784902154214536,"h":0.020116270547978599,"w":0.63556248982747399,"y":0.96279498954609288,"c":1},{"y":0.9825581392315671,"h":0.015988372635703185,"c":1,"t":"Did you use any black dyes?","x":0.18984962939796882,"w":0.22932329813639321},{"y":0.23350991639056096,"w":0.03939159393310554,"h":0.016357278179063184,"t":"Q21","c":1,"x":0.85634901101544791},{"y":0.38372093025080689,"c":1,"t":"Q22","h":0.014534883321060788,"w":0.03571428616841632,"x":0.86090225562349854},{"t":"Q23","h":0.013081395234588733,"w":0.037593984603881747,"x":0.86278195497249521,"y":0.55232558141613586,"c":1},{"y":0.63517441876421121,"x":0.86278195497249521,"w":0.037593984603881747,"c":1,"h":0.014534883321060788,"t":"Q24"},{"t":"Q25","x":0.86366454911057644,"w":0.03975405375162766,"h":0.016065322424009931,"y":0.8103881668864229,"c":1},{"h":0.014534883321060788,"w":0.03571428616841632,"t":"Q26","y":0.86046511629731848,"x":0.86654135336785942,"c":1},{"x":0.86654135347368233,"w":0.037593984603881858,"c":1,"y":0.92877906979014124,"t":"Q27","h":0.013081395234588733}],"h":3106}