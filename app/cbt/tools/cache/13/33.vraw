{"w":2400,"lines":[{"c":1,"x":0.80075187880414356,"y":0.074127906825264933,"w":0.084586467742919891,"t":"Listening","h":0.017441860722175129},{"x":0.082706771628733078,"t":"SECTION 3","w":0.14849623362223308,"c":1,"y":0.12354651132495886,"h":0.01747087440564421},{"w":0.19592580159505207,"h":0.0200981310852405,"x":0.28549944191470172,"c":1,"t":"Questions 21-30","y":0.12248403719737333},{"t":"Questions 21-25","y":0.16419832574132787,"x":0.084586464493922195,"w":0.16917293548583984,"h":0.014580743817920738,"c":1},{"w":0.32540939331054686,"h":0.020875236869856262,"c":1,"x":0.084480204545717572,"t":"Choose the correct letter, A, B or C.","y":0.20001926405762971},{"h":0.023255814296233579,"y":0.23982558121983821,"c":1,"t":"Planning a presentation on nanotechnology","x":0.19360902761679255,"w":0.58270675659179694},{"y":0.2819767443052319,"x":0.082706767337192941,"t":"21","w":0.024436089197794594,"h":0.014534883321060788,"c":1},{"y":0.28197674405463879,"t":"Russ says that his difficulty in planning the presentation is due to","w":0.59022557576497403,"c":1,"h":0.017443732453866434,"x":0.12218044510592463},{"w":0.34398495992024741,"h":0.016097875080489321,"t":"his lack of knowledge about the topic.","c":1,"x":0.16917293347646628,"y":0.31101094660755801},{"y":0.32994186041322882,"w":0.01503759384155276,"h":0.013081395234588844,"x":0.12781954884990032,"t":"B","c":1},{"y":0.3283966515225667,"c":1,"h":0.017533581101809914,"t":"his uncertainty about what he should try to achieve.","w":0.47368418375651039,"x":0.16541354844129369},{"h":0.016145607309040577,"c":1,"t":"the short time that he has for preparation.","x":0.15601504017240836,"y":0.34867997435332709,"w":0.39473683675130206},{"c":1,"w":0.026315789222717281,"h":0.014534883321060788,"t":"22","x":0.082706766957335823,"y":0.37645348850596005},{"c":1,"w":0.62406016031901035,"h":0.017527029426805618,"y":0.3763683195341414,"t":"Russ and his tutor agree that his approach in the presentation will be","x":0.12593984462877045},{"w":0.53591974894205729,"c":1,"h":0.021317149774535471,"t":"to concentrate on how nanotechnology is used in one field.","x":0.16906321675730226,"y":0.40353517971885955},{"w":0.015037593841552732,"t":"B","h":0.013081395234588844,"x":0.12781954886869731,"c":1,"y":0.42441860457747305},{"w":0.01503759384155276,"t":"C","y":0.44331395343648472,"x":0.12781954884990032,"h":0.013081395234588733,"c":1},{"x":0.16721049601861324,"y":0.42078516670756061,"w":0.53968856811523436,"h":0.021196366584615767,"t":"to follow the chronological development of nanotechnology.","c":1},{"t":"to show the range of applications of nanotechnology.","h":0.017707662588538398,"c":1,"y":0.44172569214845825,"x":0.16917293834718625,"w":0.48120300292968743},{"c":1,"y":0.47093023267732492,"t":"23","w":0.024436089197794594,"h":0.014534883321060788,"x":0.084586466585313241},{"w":0.46820271809895836,"h":0.020388115012714758,"c":1,"t":"In connection with slides, the tutor advises Russ to","y":0.47043793846577253,"x":0.11835945313282309},{"y":0.49999999972487119,"w":0.46804509480794265,"h":0.016097875080489432,"c":1,"x":0.16917294123186585,"t":"talk about things that he can find slides to illustrate."},{"x":0.12781954884990032,"y":0.51889534885545796,"w":0.01503759384155276,"c":1,"t":"B","h":0.014534883321060788},{"x":0.12781954884990032,"w":0.01503759384155276,"h":0.014534883321060788,"c":1,"y":0.5377906977532293,"t":"C"},{"y":0.51889534856208053,"w":0.43045115152994795,"c":1,"x":0.16729322112728628,"h":0.015988372635703296,"t":"look for slides to illustrate the points he makes."},{"y":0.53766902761012669,"t":"consider omitting slides altogether.","w":0.31954887390136721,"c":1,"x":0.16917293138519521,"h":0.017707662588538287},{"t":"They both agree that the best way for Russ to start his presentation is","h":0.017491464682417579,"w":0.63533833821614583,"x":0.12218045491287986,"c":1,"y":0.56535737265128105},{"t":"to encourage the audience to talk.","c":1,"x":0.1671927771996615,"h":0.018483912952469761,"y":0.5940889387394821,"w":0.31596433003743485},{"t":"B","h":0.013081395234588733,"c":1,"x":0.1278195488364739,"w":0.015037593841552732,"y":0.61482558135903453},{"h":0.014534883321060788,"t":"C","w":0.01503759384155276,"x":0.12781954884990032,"c":1,"y":0.63226744193927586},{"t":"to explain what Russ intends to do.","y":0.61332904059898119,"h":0.017484913007413172,"w":0.32894737243652344,"x":0.16353383256401022,"c":1},{"y":0.63109641889447587,"w":0.21452018737792972,"c":1,"h":0.018924585405043826,"x":0.16715992354899678,"t":"to provide an example."},{"h":0.021818119252948631,"c":1,"y":0.65818202970663808,"w":0.74269546508789064,"x":0.082613427219661917,"t":"25 What does the tutor advise Russ to do next while preparing his presentation?"},{"w":0.40225563049316404,"t":"summarise the main point he wants to make","y":0.68895348809392043,"x":0.17105263585231911,"h":0.016133440438962587,"c":1},{"x":0.12593985000810742,"h":0.014534883321060788,"c":1,"w":0.016917292277018242,"y":0.70784883726388825,"t":"B"},{"c":1,"t":"C","x":0.12593985000810742,"h":0.014534883321060788,"y":0.7267441861426257,"w":0.016917292277018242},{"h":0.017521414231732035,"c":1,"x":0.1691729276444896,"y":0.70784883706462309,"t":"read the notes he has already made","w":0.33082707722981769},{"y":0.72665808133912069,"h":0.017527965292651215,"x":0.16729323552942929,"c":1,"t":"list the topics he wants to cover","w":0.29135337829589847},{"h":0.011627907148116789,"c":1,"w":0.024436090787251841,"y":0.98691860451702695,"x":0.85902255600831645,"t":"3.5"}],"h":3106}