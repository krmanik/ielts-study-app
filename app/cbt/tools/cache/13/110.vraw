{"lines":[{"w":0.058270676930745391,"h":0.014557345943610578,"t":"Test 4","x":0.81766917271883799,"c":1,"y":0.078488372267897843},{"c":1,"w":0.0960707410176595,"y":0.12320246042254446,"x":0.39275410308117692,"t":"TEST 4","h":0.018129962225998164},{"w":0.14285714467366536,"t":"SECTION 1","y":0.18737926612701017,"x":0.09398496140376883,"h":0.01481004507405026,"c":1},{"c":1,"x":0.26503759350969897,"t":"FB.com\/LouisQuangVo","h":0.014534883321060788,"y":0.18750000018479418,"w":0.15977443695068361},{"h":0.010174418447559619,"w":0.058270676930745446,"c":1,"t":"MARTHA:","x":0.092105262916989422,"y":0.21802325587130256},{"y":0.21506761115823214,"x":0.18609022388443028,"w":0.59022557576497392,"h":0.016097875080489432,"c":1,"t":"Hi Alex. It's Martha Clines here. James White gave me your number. I hope you"},{"y":0.22987459792221587,"h":0.016645641535693256,"w":0.19606964111328123,"x":0.18580548675616626,"c":1,"t":"don't mind me calling you."},{"x":0.092105263687093236,"y":0.24854651142594164,"t":"ALEX:","w":0.03947368303934734,"h":0.011627907148116789,"c":1},{"y":0.26594013132328742,"t":"MARTHA:","x":0.093972513157409759,"c":1,"w":0.056415875752766936,"h":0.0088174117432819887},{"c":1,"x":0.092105263712155938,"t":"ALEX:","y":0.28052325583597471,"w":0.039473683039347313,"h":0.010174418447559619},{"w":0.058270676930745446,"t":"MARTHA:","c":1,"x":0.092105262916989422,"h":0.011627907148116901,"y":0.29651162779706564},{"c":1,"y":0.31249999989939803,"w":0.037593984603881844,"x":0.093984962522620466,"t":"ALEX:","h":0.0087209303610875644},{"t":"MARTHA:","w":0.056453043619791671,"x":0.093953929224044802,"h":0.0089634479589025817,"y":0.32836711321491197,"c":1},{"h":0.010174418447559619,"y":0.34302325586572446,"c":1,"x":0.092105263238225279,"w":0.037593984603881844,"t":"ALEX:"},{"w":0.27819549560546875,"t":"Of course not. How are you, Martha?","c":1,"h":0.014810045074050149,"x":0.18421052278062053,"y":0.24694140397247288},{"x":0.18421052105363411,"y":0.26303927851180031,"h":0.014577000354538461,"w":0.41729324340820306,"c":1,"t":"Good thanks. I'm ringing because I need a bit of advice."},{"x":0.1842105282295399,"c":1,"y":0.27906976763362956,"w":0.17105262756347658,"h":0.014555473597834157,"t":"Oh yeah. What about?"},{"y":0.29491307131503508,"w":0.58646616617838543,"x":0.18421052583559402,"c":1,"t":"The training you did at JPNW a few years ago. I'm applying for the same thing.","h":0.01481004507405026},{"x":0.18421053806484677,"w":0.56954884847005205,"h":0.015988372635703074,"t":"Oh right. Yes, I did mine in 2014. Best thing I ever did. I'm still working there.","y":0.30959302298049685,"c":1},{"c":1,"t":"Really? What are you doing?","x":0.1842105377464045,"h":0.015988371407532842,"y":0.32412790711963479,"w":0.21804509480794271},{"x":0.18233081530969761,"c":1,"t":"Well, now I work in the customer services department but I did my initial training. Q1","y":0.34156976763963875,"w":0.63721806844075513,"h":0.014534883321060788},{"x":0.18233082008970133,"w":0.55639099121093749,"y":0.35755813973235484,"h":0.014624731969004379,"c":1,"t":"in Finance. I stayed there for the first two years and then moved to where I"},{"c":1,"h":0.0094336480842585058,"t":"MARTHA:","x":0.09201932735459678,"y":0.39063201315375284,"w":0.058442548116048182},{"h":0.010174418447559619,"c":1,"t":"ALEX:","y":0.40697674424036756,"x":0.09022556440137898,"w":0.039473683039347326},{"w":0.060150375366210942,"c":1,"h":0.010174418447559508,"t":"MARTHA:","x":0.090225564105640574,"y":0.45348837215515869},{"x":0.090225564413910289,"c":1,"t":"ALEX:","w":0.039473683039347326,"h":0.011627907148116678,"y":0.48401162778253082},{"t":"MARTHA:","c":1,"h":0.010662529595959036,"y":0.51574431658001973,"w":0.060285695393880193,"x":0.090157904081819687},{"t":"ALEX:","y":0.54651162770501138,"c":1,"w":0.03759398460388183,"x":0.09022556423941247,"h":0.011627907148116789},{"h":0.0088240899198376299,"y":0.59442516432643488,"w":0.054538803100585939,"x":0.092091500611310315,"c":1,"t":"MARTHA:"},{"x":0.09022556423941247,"w":0.03759398460388183,"t":"ALEX:","y":0.62499999979803467,"h":0.011627907148116789,"c":1},{"h":0.010413306801839495,"c":1,"x":0.090190970727216616,"t":"MARTHA:","y":0.65685730006758192,"w":0.058339862823486313},{"h":0.010174418447559619,"t":"ALEX:","y":0.67296511631136824,"x":0.090225564054860194,"w":0.037593984603881844,"c":1},{"h":0.012281561542616615,"x":0.088242689998286425,"c":1,"t":"MARTHA:","w":0.06035672505696614,"y":0.71914991688271612},{"x":0.088299109680690102,"y":0.75134430008313791,"h":0.010392795127971866,"c":1,"t":"ALEX:","w":0.039567193984985344},{"x":0.090191984409914883,"t":"MARTHA:","w":0.056458136240641277,"h":0.010398674379681672,"y":0.79785298837239127,"c":1},{"t":"ALEX:","y":0.81395348842386406,"h":0.010174418447559619,"c":1,"x":0.088345865153258665,"w":0.039473683039347326},{"c":1,"w":0.058270676930745446,"y":0.84447674408098028,"x":0.088345864451293943,"t":"MARTHA:","h":0.011627907148116789},{"y":0.86046511614866072,"w":0.039473683039347313,"h":0.011627907148116789,"c":1,"t":"ALEX:","x":0.088345865167717891},{"t":"ALEX:","y":0.89962916100868395,"h":0.0097012743977524796,"w":0.038107035954793284,"c":1,"x":0.089943439490417137},{"x":0.088329960333051405,"c":1,"y":0.91564308629664781,"t":"MARTHA:","w":0.058302485148111982,"h":0.010283594813104258},{"x":0.088345865143365496,"h":0.011627907148116789,"t":"ALEX:","y":0.9316860463953418,"w":0.039473683039347326,"c":1},{"y":0.38795878927941263,"x":0.18421052086784348,"h":0.016110978430498135,"c":1,"t":"That's the same department I'm applying for. Did you enjoy it?","w":0.46052632649739578},{"x":0.18233082225704569,"h":0.014547986671069491,"t":"I was pretty nervous to begin with. I didn't do well in my exams at school and I","c":1,"w":0.58082707722981775,"y":0.40405666428781517},{"w":0.59586466471354171,"h":0.015988372635703074,"t":"was really worried because | failed Maths. But it didn't actually matter because I","c":1,"x":0.182330825453944,"y":0.420058139260719},{"h":0.013200257566001294,"w":0.21804512023925784,"c":1,"t":"did lots of courses on the job","x":0.182330823244201,"y":0.43593045694536725},{"x":0.18421053308442006,"y":0.45058139549172771,"t":"Did you get a diploma at the end of your trainee period? I'm hoping to do the one","w":0.59774434407552091,"h":0.015988371407532842,"c":1},{"t":"in business skills","y":0.46802325588442439,"h":0.010174418447559508,"x":0.18421052841329369,"w":0.12781954447428387,"c":1},{"y":0.48255813973219486,"x":0.18233082677907836,"t":"Yes. That sounds good. I took the one on IT skills but I wish I'd done that","h":0.014544242593601875,"w":0.54323308308919271,"c":1},{"w":0.090288956960042327,"x":0.18229913049998772,"h":0.013344658472732918,"t":"one instead","c":1,"y":0.49841488004498413},{"t":"OK, that's good to know. What about the other trainees? How did you get on","w":0.55827067057291668,"h":0.015988371407532731,"x":0.18421052747669961,"y":0.51308139553169874,"c":1},{"t":"with them?","y":0.52834233187572432,"x":0.1821522259557718,"w":0.08494366963704425,"h":0.014536266240932405,"c":1},{"t":"There were about 20 of us who started at the same time and we were all around","x":0.18417294140194551,"c":1,"h":0.01416174427432848,"y":0.54405043240982565,"w":0.59406422932942704},{"c":1,"y":0.56104651180188658,"w":0.59210525512695322,"t":"the same age - I was 18 and there was only one person younger than me, who","x":0.18233083061657168,"h":0.014613500964772097},{"w":0.52067667643229165,"c":1,"y":0.57694784286737877,"h":0.014621924371467587,"t":"was 17. The rest were between 18 and 20. I made some good friends.","x":0.18233083462100524},{"h":0.016122209434730306,"t":"I've heard lots of good things about the training at JPNW. It seems like there are","y":0.59143593036601794,"w":0.59398498535156252,"x":0.1823308154725862,"c":1},{"h":0.014534883321060788,"c":1,"w":0.026315789222717267,"x":0.79323308274680948,"t":"Q3","y":0.48255813966875083},{"h":0.014534883321060788,"x":0.79323308274680948,"w":0.026315789222717267,"c":1,"t":"Q4","y":0.561046511761774},{"y":0.62354651182495779,"x":0.18233083001630745,"t":"Yeah, definitely. Because of its size you can work in loads of different areas","h":0.014573256277070845,"c":1,"w":0.55827067057291668},{"w":0.17105262756347656,"y":0.63940759817140158,"h":0.01481004507405026,"c":1,"t":"within the organisation.","x":0.18233082898582514},{"x":0.18233083977631698,"w":0.60338343302408859,"h":0.014552666000297365,"t":"What about pay? I know you get a lower minimum wage than regular employees.","y":0.65550547333217968,"c":1},{"y":0.66999356080607864,"w":0.63533833821614583,"t":"That's right - which isn't great. But you get the same number of days' holiday as. Q5","h":0.016097875080489432,"c":1,"x":0.18233083143495132},{"x":0.18233082685173108,"c":1,"w":0.58646616617838543,"y":0.68604651133372663,"t":"everyone else. And the pay goes up massively if they offer you a job at the end","h":0.016142799711503675},{"c":1,"t":"of the training period.","x":0.18233083012991755,"y":0.70203488391142677,"w":0.1616541290283203,"h":0.014642514648241067},{"t":"Yeah, but I'm not doing it for the money - it's the experience I think will be really","w":0.59210525512695322,"y":0.7179652286446061,"h":0.014592910687998617,"c":1,"x":0.18233083098763908},{"x":0.1822497639546295,"t":"useful. Everyone says by the end of the year you gain so much confidence.","w":0.56031585693359376,"c":1,"h":0.018036307477981794,"y":0.73200032157396033},{"t":"You're right. That's the most useful part about it. There's a lot of variety too.","y":0.74821345305192433,"w":0.55841852823893223,"x":0.18226134793030213,"h":0.016466776939337957,"c":1},{"x":0.18045112521294338,"h":0.015988372635703185,"c":1,"w":0.56203008015950517,"t":"You're given lots of different things to do. I enjoyed it all - I didn't even mind","y":0.76453488344612963},{"c":1,"w":0.095944023132324224,"x":0.18041144724592664,"t":"the studying","y":0.78036557103495574,"h":0.014850252916639439},{"c":1,"x":0.18233082888581312,"y":0.7965116281025596,"h":0.014534883321060899,"t":"Do you have to spend any time in college?","w":0.31766916910807297},{"x":0.18045113399650223,"t":"Yes, one day each month. So you get lots of support from both your tutor and","c":1,"y":0.81101094660844331,"w":0.57330825805664065,"h":0.016097875080489432},{"w":0.026315789222717267,"y":0.81250000000681122,"h":0.013081395234588844,"c":1,"t":"Q6","x":0.79135338349737483},{"x":0.18045113024535217,"h":0.013200257566001294,"c":1,"y":0.82839665166150112,"t":"your manager.","w":0.1109022521972656},{"h":0.01481004507405026,"c":1,"t":"That's good. And the company is easy to get to, isn't it?","y":0.84288473926821417,"x":0.18233083012826584,"w":0.41165412902832038},{"h":0.016097875080489321,"y":0.8589826145621744,"t":"Yes, it's very close to the train station so the location's a real advantage.","w":0.53759399414062492,"c":1,"x":0.18045112309425709},{"t":"Q7","x":0.79135338349868922,"y":0.85901162790464003,"h":0.013081395234588733,"c":1,"w":0.026315789222717267},{"c":1,"w":0.31954887390136721,"h":0.014534883321060788,"y":0.89825581414912281,"x":0.18233082611267007,"t":"Have you got a date for your interview yet?"},{"h":0.016844645670284764,"c":1,"t":"Yes, it's on the 23rd of this month.","y":0.91217012493801797,"x":0.18033417928862899,"w":0.25583661397298174},{"t":"So long as you're well prepared there's nothing to worry about. Everyone's very","w":0.58834584554036462,"x":0.1823308364321439,"y":0.92877906949073652,"h":0.015988372635703185,"c":1},{"w":0.063462479909261071,"x":0.17977562133003142,"t":"friendly.","h":0.015652722262292307,"c":1,"y":0.94424298758649516},{"h":0.016290643793954729,"w":0.076061617533365822,"c":1,"t":"Example","y":0.30951872791903701,"x":0.78712004680443048},{"t":"113","y":0.96511627912435338,"w":0.03571428616841632,"h":0.014534883321060788,"x":0.83458646606992715,"c":1}],"w":2400,"h":3106}