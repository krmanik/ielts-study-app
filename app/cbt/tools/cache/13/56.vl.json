{"blocks":[{"l":"paragraph_title","b":[0.1646,0.066,0.2258,0.084],"t":"Test 3"},{"l":"paragraph_title","b":[0.1633,0.1137,0.3375,0.1339],"t":"Questions 25–30"},{"l":"text","b":[0.1604,0.1494,0.7596,0.1713],"t":"What problem is identified with each of the following natural dyes?"},{"l":"text","b":[0.1621,0.1858,0.8371,0.2247],"t":"Choose SIX answers from the box and write the correct letter, A–H, next to Questions 25–30."},{"l":"paragraph_title","b":[0.5117,0.2556,0.6117,0.275],"t":"Problems"},{"l":"text","b":[0.385,0.284,0.5725,0.3049],"t":"A It is expensive."},{"l":"text","b":[0.3854,0.3117,0.6562,0.3329],"t":"B The colour is too strong."},{"l":"text","b":[0.3858,0.3393,0.7037,0.3612],"t":"C The colour is not long-lasting."},{"l":"text","b":[0.3867,0.368,0.6179,0.3899],"t":"D It is very poisonous."},{"l":"text","b":[0.3867,0.3963,0.6625,0.4182],"t":"E It can damage the fabric."},{"l":"text","b":[0.3867,0.4247,0.7229,0.4466],"t":"F The colour may be unexpected."},{"l":"text","b":[0.3867,0.453,0.7238,0.4742],"t":"G It is unsuitable for some fabrics."},{"l":"text","b":[0.3867,0.4813,0.6837,0.5035],"t":"H It is not generally available."},{"l":"paragraph_title","b":[0.2075,0.5483,0.3367,0.5686],"t":"Natural dyes"},{"l":"text","b":[0.1633,0.5766,0.5167,0.5972],"t":"25 turmeric"},{"l":"text","b":[0.1629,0.605,0.5167,0.6256],"t":"26 beetroot"},{"l":"text","b":[0.1638,0.6333,0.5175,0.6549],"t":"27 Tyrian purple"},{"l":"text","b":[0.1638,0.6619,0.5162,0.6829],"t":"28 logwood"},{"l":"text","b":[0.1646,0.6922,0.5167,0.7125],"t":"29 cochineal"},{"l":"text","b":[0.1654,0.7205,0.5167,0.7408],"t":"30 metal oxide"},{"l":"number","b":[0.1675,0.9652,0.1942,0.982],"t":"58"}]}