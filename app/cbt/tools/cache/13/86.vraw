{"lines":[{"h":0.014576063874607637,"t":"Test 4","x":0.12030075207253361,"y":0.072674418780361072,"w":0.060150375366210942,"c":1},{"h":0.016097875080489321,"x":0.12030075102191873,"w":0.17293233235677086,"c":1,"t":"Questions 22-26","y":0.12202189287263043},{"c":1,"h":0.018895348808647183,"w":0.4548872375488282,"x":0.11842104278453647,"y":0.1598837209404933,"t":"Reading Passage 2 has seven paragraphs, A-G."},{"y":0.1960721183617179,"w":0.45300750732421868,"c":1,"t":"Which section contains the following information?","h":0.019044160689374201,"x":0.12030075753259249},{"y":0.23401162791684305,"h":0.019046968286910881,"t":"Write the correct letter, A-G, in boxes 22-26 on your answer sheet.","w":0.61654134114583337,"c":1,"x":0.12030075785621695},{"h":0.017512054959190948,"t":"NB You may use any letter more than once.","x":0.11842105404421309,"w":0.40413533528645829,"c":1,"y":0.27173213121075013},{"x":0.11842105616016388,"t":"22 a reference to one person's motivation for a soil-improvement project","w":0.67857142130533854,"c":1,"y":0.30959302312458448,"h":0.017515798422573337},{"y":0.34738372079943192,"w":0.74624059041341151,"c":1,"h":0.01744186072217524,"t":"23 an explanation of how soil stayed healthy before the development of farming","x":0.11654135883195541},{"y":0.38372093010079866,"t":"24 examples of different ways of collecting information on soil degradation","w":0.69736841837565111,"x":0.11654135464919761,"c":1,"h":0.01744186072217524},{"y":0.41994576037585962,"w":0.7350538635253907,"h":0.019955266005595274,"x":0.11649453711371241,"c":1,"t":"25 a suggestion for a way of keeping some types of soil safe in the near future"},{"c":1,"h":0.018995492594977459,"y":0.45782356700019344,"t":"26 a reason why it is difficult to provide an overview of soil degradation","x":0.11654136359722457,"w":0.66541351318359376}],"h":3106,"w":2400}