{"w":2400,"h":3396,"lines":[{"w":0.061728394826253266,"t":"Test 2","x":0.086419753105087052,"h":0.014567411690072807,"y":0.033430232400607829,"c":1},{"h":0.014723203769140158,"t":"Questions 1-8","c":1,"x":0.086419753062030841,"y":0.08127208488699067,"w":0.15226337432861328},{"y":0.11627906959922862,"w":0.79835393269856758,"c":1,"t":"Do the following statements agree with the information given in Reading Passage 1?","h":0.017441860778592888,"x":0.086419741786410306},{"h":0.019310359258393306,"y":0.1510071164457063,"c":1,"x":0.084226903810649678,"w":0.39323697408040365,"t":"In boxes 1-8 on your answer sheet, write"},{"t":"TRUE","x":0.15843621538023142,"w":0.059670778910319022,"y":0.18749999985822141,"h":0.013081395583944722,"c":1},{"t":"FALSE","h":0.015070932071537535,"x":0.15627203676658388,"y":0.20467383626565305,"w":0.072229588826497382,"c":1},{"c":1,"x":0.2921810703219393,"t":"if the statement agrees with the information","y":0.18749999985202526,"h":0.01598837238037687,"w":0.41358024597167964},{"c":1,"w":0.40740740458170571,"t":"if the statement contradicts the information","x":0.29218107126488263,"y":0.20494186031707107,"h":0.01598837238037687},{"c":1,"w":0.43621398925781241,"t":"NOT GIVEN if there is no information on this","y":0.22379269706528682,"x":0.15843621514068185,"h":0.014723203769140158},{"h":0.011627907185728703,"t":"1","x":0.086419753086559456,"y":0.26889534858736819,"c":1,"w":0.012345678806304938},{"t":"Most geoglyphs in England are located in a particular area of the country.","x":0.13168724388113276,"y":0.26737338036459746,"w":0.69341562906901044,"c":1,"h":0.017510339986309242},{"c":1,"w":0.73662551879882809,"x":0.10493827064173823,"h":0.017446995904785378,"t":"There are more geoglyphs in the shape of a horse than any other creature.","y":0.29505300347228403},{"y":0.32267441844272193,"c":1,"w":0.77983540852864586,"t":"A recent dating of the Uffington White Horse indicates that people were mistaken","x":0.11728394166882916,"h":0.017441860778592888},{"h":0.01512737745952264,"w":0.1343141810099284,"c":1,"y":0.34142718269544692,"t":"about its age.","x":0.1314792495666581},{"c":1,"h":0.017441860778592888,"x":0.082304519739374388,"t":"4 Historians have come to an agreement about the origins of the Long Man of","w":0.76748972574869789,"y":0.36773255798044591},{"t":"Wilmington.","c":1,"x":0.13134704128307206,"y":0.3867940703419136,"w":0.1181191380818685,"h":0.015469536483638802},{"c":1,"x":0.084362133219039306,"h":0.015988372380376759,"t":"5 Geoglyphs were created by people placing white chalk on the hillside.","y":0.41424418590043421,"w":0.70987655639648439},{"x":0.08436212882255982,"y":0.44186046496928522,"w":0.51646092732747395,"h":0.016031172025610774,"t":"6 Many geoglyphs in England are no longer visible.","c":1},{"t":"7 The shape of some geoglyphs has been altered over time.","h":0.016195524146054185,"w":0.60288065592447915,"c":1,"y":0.46937573600051108,"x":0.084362141064252119},{"y":0.49705535915174726,"h":0.016026036337772664,"c":1,"w":0.58024693806966143,"x":0.084362127565098324,"t":"8 The fame of the Uffington White Horse is due to its size."},{"t":"40","w":0.026748971939086916,"h":0.011627907185728703,"y":0.90697674403683148,"x":0.086419752610703449,"c":1}]}