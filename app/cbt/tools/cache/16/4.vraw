{"w":2400,"h":3396,"lines":[{"w":0.24897120157877606,"c":1,"x":0.072016456776813467,"h":0.027616278442814113,"t":"Introduction","y":0.081395349120668259},{"h":0.020448927323304389,"t":"Prepare for the exam with practice tests from Cambridge","x":0.076060751059838866,"c":1,"y":0.17820554249293452,"w":0.75117284138997398},{"y":0.21643109529813265,"h":0.016195524146054185,"t":"Inside you'll find four authentic examination papers from Cambridge Assessment English.","w":0.81069956461588533,"c":1,"x":0.074074085984622964},{"t":"They are the perfect way to practise - EXACTLY like the real exam.","w":0.61534296671549482,"h":0.018634206414643972,"y":0.23321673103791685,"x":0.076058972801362479,"c":1},{"y":0.2862190810175963,"h":0.017667844522968212,"c":1,"w":0.28806584676106772,"x":0.076131685571574459,"t":"Why are they unique?"},{"t":"All our authentic practice tests go through the same design process as the IELTS test. We","h":0.019932092008377422,"w":0.81501729329427075,"c":1,"y":0.32083788383440703,"x":0.076037418850645605},{"x":0.074023575570001776,"y":0.33898215728723169,"w":0.80668182373046893,"h":0.018933331025643652,"t":"check every single part of our practice tests with real students under exam conditions, to","c":1},{"c":1,"x":0.076038189022483063,"h":0.018298350178030054,"t":"make sure we give you the most authentic experience possible.","y":0.35739769517546938,"w":0.57834777832031259},{"t":"Students can practise these tests on their own or with the help of a teacher to familiarise","c":1,"x":0.096707821022635865,"y":0.37632508816719601,"w":0.7633744812011718,"h":0.016195524146054074},{"c":1,"h":0.017470964694612956,"x":0.074074065843609566,"t":"themselves with the exam format, understand the scoring system and practise exam technique.","w":0.83127573649088549,"y":0.39389534867726472},{"h":0.016195524146054185,"w":0.25925926208496086,"c":1,"y":0.44464075391553193,"t":"Further information","x":0.076131688041881612},{"y":0.48010336048994739,"c":1,"w":0.73676554361979174,"t":"IELTS is jointly managed by the British Council, IDP: IELTS Australia and Cambridge","x":0.074005388148221135,"h":0.019840838069488997},{"c":1,"w":0.74897120157877606,"x":0.07613168307717634,"h":0.01598837238037687,"t":"Assessment English. Further information can be found on the IELTS official website at","y":0.49999999985371069},{"t":"ielts.org.","x":0.073021055688876763,"y":0.51735628531674482,"w":0.082570813496907536,"c":1,"h":0.01851930270065838},{"h":0.015988372380376759,"t":"WHAT IS THE TEST FORMAT?","x":0.0781892956653545,"y":0.56831395333114587,"c":1,"w":0.39300412495930998},{"c":1,"w":0.8087869262695313,"t":"IELTS consists of four components. All candidates take the same Listening and Speaking","y":0.60440278675978909,"x":0.076057062164990821,"h":0.018677792363790191},{"c":1,"w":0.80452672322591146,"t":"tests. There is a choice of Reading and Writing tests according to whether a candidate is","x":0.076131700098127725,"y":0.62354651148038676,"h":0.016029460129664774},{"c":1,"x":0.076131686511983973,"t":"taking the Academic or General Training module.","y":0.64244186031740202,"h":0.015988372380376759,"w":0.44855967203776037},{"t":"Academic","h":0.014300595745181055,"x":0.092438085351053328,"y":0.67526249281049855,"w":0.099074446360270185,"c":1},{"t":"For candidates wishing to study at","x":0.092461020075501776,"w":0.31300155639648436,"y":0.69325429147031281,"h":0.016595421466445437,"c":1},{"h":0.016000356213644928,"y":0.71220930217535194,"c":1,"x":0.09259259424351475,"w":0.34979423522949221,"t":"undergraduate or postgraduate levels,"},{"y":0.7296511626329959,"w":0.31481480916341142,"c":1,"t":"and for those seeking professional","h":0.015988372380376759,"x":0.09259259542009915},{"h":0.015652521760219362,"t":"registration.","c":1,"x":0.090396509734265135,"y":0.74798769258021292,"w":0.11344566345214843},{"w":0.16307455698649093,"t":"General Training","x":0.47092975558305367,"h":0.016070825331904737,"y":0.67448117697252274,"c":1},{"t":"For candidates wishing to migrate to an","x":0.46913580674909799,"c":1,"y":0.6931684332112924,"w":0.36008229573567713,"h":0.014723203769140158},{"x":0.47119341600105635,"t":"English-speaking country (Australia, Canada,","w":0.41358024597167975,"h":0.015988372380376759,"y":0.71075581380560426,"c":1},{"t":"New Zealand, UK), and for those wishing to","h":0.017441860778592888,"x":0.47119341427137668,"y":0.72819767425530935,"w":0.39711934407552091,"c":1},{"x":0.46913579804261168,"t":"train or study below degree level.","w":0.30658437093098961,"c":1,"y":0.74705535914510968,"h":0.016026036337772775},{"h":0.013081395583944722,"y":0.90988372071924029,"w":0.016460905075073251,"t":"4","c":1,"x":0.078189300431305231}]}