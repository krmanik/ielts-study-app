{"w":2400,"h":3396,"lines":[{"y":0.085377863548959598,"w":0.10324333190917967,"c":1,"h":0.017160143812918638,"t":"TEST 3","x":0.39695548902406053},{"c":1,"x":0.078056816231179202,"t":"PART 1","w":0.101088015238444,"h":0.016843949667275648,"y":0.14637453664121591},{"t":"JAKE:","w":0.041152264277140305,"x":0.078189299868745815,"h":0.008720930389296444,"y":0.17877906966484791,"c":1},{"x":0.076111886108857829,"y":0.19326127711715757,"h":0.011733259553763364,"w":0.061767997741699221,"c":1,"t":"WOMAN:"},{"h":0.0089054045884995325,"y":0.22519846047393588,"c":1,"t":"JAKE.","w":0.041229852040608722,"x":0.078150505980790777},{"t":"WOMAN:","x":0.07818930179998454,"y":0.27034883708476198,"c":1,"w":0.059670778910318995,"h":0.011627907185728592},{"t":"JAKE:","x":0.076106722966705176,"y":0.3008256436516914,"w":0.043259805043538407,"h":0.011720805623084862,"c":1},{"c":1,"w":0.059715499877929692,"h":0.0088748971199961169,"y":0.34730673747119667,"x":0.080224554488497871,"t":"WOMAN:"},{"w":0.039094651540120443,"x":0.080246912804471104,"c":1,"t":"JAKE:","y":0.36337209292066186,"h":0.008720930389296444},{"h":0.013233804871252475,"c":1,"y":0.4228889114096136,"t":"WOMAN:","w":0.061792780558268243,"x":0.078157107972432457},{"x":0.078189300073166837,"h":0.010174418787512574,"y":0.44040697662598061,"c":1,"t":"JAKE:","w":0.043209877014160167},{"h":0.010700189884756406,"t":"WOMAN:","x":0.082213752466516798,"c":1,"y":0.51572548642812099,"w":0.0577947171529134},{"y":0.53197674405095452,"w":0.045267489751180001,"c":1,"x":0.078189300283604282,"t":"JAKE:","h":0.011627907185728592},{"h":0.011966783952656823,"y":0.59140032880573279,"c":1,"t":"WOMAN:","x":0.080183819117998004,"w":0.06185458501180012},{"w":0.043209877014160153,"y":0.60901162776614737,"h":0.011627907185728703,"t":"JAKE:","x":0.08024691327404132,"c":1},{"x":0.08024691359510383,"t":"WOMAN:","y":0.65552325570556547,"w":0.061728394826253252,"h":0.010174418787512574,"c":1},{"h":0.011627907185728592,"t":"JAKE:","x":0.080246913447652418,"y":0.67005813934733505,"c":1,"w":0.043209877014160167},{"h":0.008720930389296444,"x":0.084362139500847963,"t":"WOMAN.","y":0.70203488362698807,"c":1,"w":0.057613169352213542},{"w":0.041152264277140305,"h":0.008720930389296444,"t":"JAKE:","y":0.71656976732715405,"x":0.082304526211909965,"c":1},{"w":0.059889462788899742,"c":1,"t":"WOMAN.","h":0.010834643360582707,"x":0.082195186198545087,"y":0.73222802713823754},{"c":1,"x":0.082304526188711383,"w":0.041152264277140305,"t":"JAKE:","h":0.010174418787512574,"y":0.76308139522748164},{"x":0.082304526767375707,"t":"WOMAN:","y":0.7936046510382504,"w":0.061728394826253252,"h":0.011627907185728592,"c":1},{"c":1,"y":0.80955953531189917,"x":0.082290356183957886,"w":0.041180604298909504,"t":"JAKE:","h":0.0087879060716032908},{"w":0.33127571105957032,"c":1,"h":0.016195524146054296,"t":"Hello, Junior Cycle camp, Jake speaking.","x":0.17489712378280417,"y":0.17579505306340293},{"y":0.18876853274327776,"h":0.017976877124907809,"x":0.17482387226832258,"t":"Hi. I'm calling for some information about the cycle camp - I'm thinking of","c":1,"w":0.58658599853515625},{"c":1,"y":0.20708713364084474,"t":"sending my son.","w":0.13237097422281904,"h":0.013805883652470263,"x":0.17662700626085101},{"c":1,"t":"Great. Well, it's held every weekday morning over the summer vacation and we","h":0.018447546852210728,"x":0.17480227915494614,"y":0.21896263493338319,"w":0.63190831502278644},{"w":0.62153559366861977,"t":"focus on basic cycling skills and safety. We have eight levels for children from","y":0.235056961656949,"h":0.017651992636097624,"c":1,"x":0.17277825957731399},{"w":0.33571370442708337,"h":0.015277487369532716,"c":1,"t":"three years upwards. How old's your son?","x":0.17680995897812216,"y":0.25138761547792776},{"c":1,"w":0.59259256998697918,"h":0.016195524146054074,"x":0.17695474409125361,"y":0.26590106018648263,"t":"Charlie? He's seven. He can ride a bike, but he needs a little more training"},{"w":0.27572016398111981,"h":0.01309509131315878,"y":0.28343023243518028,"c":1,"t":"before he's safe to go on the road.","x":0.17695473272732604},{"t":"He'd probably be best in Level 5. They start off practising on the site here, and","y":0.29651162775695539,"w":0.62551442464192708,"x":0.17489710870751651,"c":1,"h":0.015988372380376759},{"x":0.17479325878610269,"y":0.31135625122221766,"h":0.018529167444882866,"c":1,"w":0.62775543212890628,"t":"we aim to get them riding on the road, but first they're taken to ride in the park,"},{"h":0.014562276002234698,"y":0.32848837184128399,"t":"away from the traffic.","x":0.17489711932558913,"w":0.17283950805664064,"c":1},{"w":0.43018661499023442,"t":"Right. And can you tell me a bit about the instructors?","h":0.016491832104111204,"x":0.17484622606681527,"y":0.34298011865476696,"c":1},{"c":1,"w":0.6256013997395834,"t":"Well, all our staff wear different coloured shirts. So, we have three supervisors,","y":0.35743540214743197,"x":0.17896157727937104,"h":0.016213412560057483},{"x":0.17688247967469106,"w":0.63802683512369796,"h":0.01639895781751799,"c":1,"t":"and they have red shirts. They support the instructors, and they also stand in for","y":0.37333327708776309},{"t":"me if I'm not around. Then the instructors themselves are in blue shirts, and one","x":0.17489711487563578,"y":0.38953488358683774,"w":0.63991770426432293,"h":0.014534883982160851,"c":1},{"c":1,"h":0.013250883392226021,"x":0.17901235022650772,"w":0.30246912638346357,"t":"of these is responsible for each class.","y":0.40547703169010996},{"w":0.034979422887166323,"x":0.17695473287927505,"y":0.42151162772996198,"t":"OK.","h":0.013081395583944833,"c":1},{"y":0.43539801385984056,"h":0.014472161642373305,"t":"In order to be accepted, all our instructors have to submit a reference from","x":0.17688948407790747,"w":0.59272384643554688,"c":1},{"x":0.17901235788965789,"y":0.45200235590459759,"h":0.011778563015312216,"t":"someone who's seen them work with children - like if they've worked as a","c":1,"w":0.5864197285970052},{"w":0.64620244344075517,"t":"babysitter, for example. Then they have to complete our training course, including","h":0.01530748149391048,"x":0.17896177871350999,"y":0.46635517257401582,"c":1},{"t":"how to do lesson plans, and generally care for the well-being of the kids in their","w":0.63188339233398438,"h":0.016773040780470705,"x":0.17891861317503563,"c":1,"y":0.48040462207195267},{"x":0.17695473790465893,"y":0.49852767951192645,"c":1,"t":"class. They do a great job, have to say.","w":0.32510286966959639,"h":0.014553715960858638},{"x":0.18095396486908782,"h":0.015488034283174135,"c":1,"w":0.59897939046223958,"y":0.51108161447210043,"t":"Right. And tell me a bit about the classes. What size will Charlie's class be?"},{"y":0.52740470586159816,"w":0.61945602416992185,"c":1,"h":0.015748804674272088,"x":0.17895723498775168,"t":"We have a limit of eight children in each class, so their instructor really gets to"},{"x":0.17901235417773098,"y":0.54358068337320453,"w":0.61111109415690101,"h":0.013250883392226132,"c":1,"t":"know them well. They're out riding most of the time but they have quiet times"},{"t":"too, where their instructor might tell them a story that's got something to do with","y":0.55788142324023704,"w":0.63397343953450513,"c":1,"x":0.17684440535488061,"h":0.017355613349042898},{"y":0.57366202757125928,"h":0.016825469278755723,"x":0.17891103130688227,"t":"cycling, or get them to play a game together. It's a lot of fun.","w":0.47753458658854164,"c":1},{"h":0.017531283752657112,"t":"It must be. Now, what happens if there's rain? Do the classes still run?","x":0.17887688182045225,"w":0.55995162963867184,"c":1,"y":0.58831598822062281},{"c":1,"x":0.17893438149135535,"h":0.01707513425038476,"y":0.60368219014273805,"t":"Oh yes. We don't let that put us off - we just put on our waterproofs and","w":0.57218551635742188},{"h":0.015799122508198371,"t":"keep cycling.","w":0.10991636912027997,"x":0.17857807919306207,"c":1,"y":0.62080016638481339},{"c":1,"t":"And is there anything special Charlie should bring along with him?","w":0.52704406738281251,"x":0.17888154621226288,"y":0.64908021590313036,"h":0.018960184427537663},{"h":0.019190259198839099,"t":"Well, maybe some spare clothes, especially if the weather's not so good. And","x":0.17888424635413608,"w":0.61957600911458344,"y":0.66468205286149751,"c":1},{"c":1,"x":0.18092474255672797,"h":0.014414399756980889,"w":0.18551919301350911,"t":"a snack for break time.","y":0.68189181838616564},{"c":1,"t":"How about a drink?","x":0.17901234471546634,"y":0.69905771519919202,"w":0.15843621571858724,"h":0.011778563015312105},{"c":1,"t":"No, we'll provide that. And make sure he has shoes, not sandals.","x":0.18106995591831104,"w":0.51851852416992195,"y":0.71366279056408077,"h":0.014546867815428799},{"c":1,"t":"Sure. And just at present Charlie has to take medication every few hours, so I'Il","w":0.63389511108398433,"y":0.72743124866479192,"x":0.17894074300305116,"h":0.017072859585495759},{"c":1,"w":0.18724280039469401,"x":0.17901234457063006,"t":"make sure he has that.","y":0.74558303883548505,"h":0.011778563015312105},{"h":0.017239884577595066,"t":"Absolutely. Just give us details of when he has to take it and we'll make sure","y":0.75705148108617593,"c":1,"x":0.18093863754190806,"w":0.60930658976236973},{"y":0.77694134936482317,"h":0.012977766344769104,"w":0.072429052988688181,"t":"he does.","x":0.18086366269065962,"c":1},{"x":0.17901234472427008,"y":0.79215116264798735,"w":0.067901236216227207,"t":"Thanks.","h":0.013081395583944722,"c":1},{"t":"Now, there are a few things you should know about Day 1 of the camp. The","c":1,"x":0.17894626059626897,"y":0.80335973617014278,"w":0.60096176147460945,"h":0.017987514131903248},{"y":0.82122093009811792,"x":0.18106996727556729,"w":0.61111109415690112,"c":1,"t":"classes normally start at 9.30 every morning, but on Day 1 you should aim to","h":0.014534883982160851},{"y":0.83225004544323777,"x":0.178817888119124,"t":"get Charlie here by 9.20. The finishing time will be 12.30 as usual. We need the","w":0.63412511189778642,"h":0.02105594495721641,"c":1},{"h":0.013096803209104779,"c":1,"t":"additional time because there are a few extra things to do. The most important","y":0.85174418592494516,"x":0.18312757859398562,"w":0.62345677693684898},{"c":1,"w":0.62369028727213549,"y":0.86615933656108068,"t":"is that we have a very careful check to make sure that every child's helmet fits","x":0.17889921508796106,"h":0.018420523833329816},{"c":1,"h":0.013081395583944722,"t":"Q1","x":0.83744856054629546,"y":0.31104651145089235,"w":0.039094648361206019},{"c":1,"x":0.84979423821598477,"t":"Q2","y":0.38808139517677764,"h":0.013081395583944611,"w":0.026748971939086985},{"x":0.84979423842326351,"t":"Q3","w":0.028806584676106861,"h":0.013081395583944722,"c":1,"y":0.43459302308375436},{"t":"Q4","y":0.54215116262283092,"c":1,"x":0.8518518513761355,"h":0.013081395583944611,"w":0.026748971939086874},{"y":0.5886627905484596,"h":0.011627907185728592,"t":"Q5","w":0.026748971939086874,"x":0.8518518513761355,"c":1},{"w":0.02880658467610675,"h":0.013081395583944722,"y":0.68023255796252025,"c":1,"x":0.85185185160134058,"t":"Q6"},{"y":0.72674418586949696,"x":0.85390946454485972,"w":0.026748971939086874,"h":0.013081395583944722,"t":"Q7","c":1},{"h":0.013081395583944722,"c":1,"x":0.85390946476071194,"w":0.02880658467610675,"y":0.86627906959538215,"t":"Q8"},{"x":0.084362141020014256,"h":0.014534882858869391,"t":"110","c":1,"w":0.039094648361206047,"y":0.91279069792376299},{"h":0.027081890577983492,"y":0.95559854902539954,"w":0.25427068074544268,"c":1,"t":"IELTSXpress.com","x":0.71952531067331094}]}