{"w":2400,"h":3396,"lines":[{"x":0.80242414249689353,"h":0.0149017430587427,"c":1,"t":"Introduction","y":0.034700291245212012,"w":0.11737393697102871},{"c":1,"t":"The test components are taken in the following order:","w":0.48559672037760421,"x":0.076131680855019493,"y":0.081272084880421924,"h":0.016195524146054185},{"x":0.16849876603911393,"t":"Academic Reading","y":0.17158273236862265,"w":0.18360061645507811,"c":1,"h":0.016023606097038234},{"h":0.016012340046912987,"c":1,"t":"3 sections, 40 items","w":0.18312756856282553,"x":0.16872428143248952,"y":0.19040697658892347},{"x":0.20986025550259327,"t":"60 minutes","y":0.20778461176229168,"w":0.10291323343912759,"h":0.013209845629401196,"c":1},{"y":0.12241018412309135,"w":0.094468313852945907,"h":0.019031940275985315,"c":1,"x":0.44975900120054474,"t":"Listening"},{"c":1,"h":0.01598837238037687,"w":0.3991769663492839,"y":0.14244186031670925,"t":"4 parts, 40 items, approximately 30 minutes","x":0.29835390353975166},{"h":0.018919060732928039,"c":1,"x":0.60876604755215857,"y":0.17016144425315027,"w":0.24961255391438819,"t":"General Training Reading"},{"h":0.011627907185728592,"w":0.024691357612609821,"c":1,"t":"or","y":0.19186046491488762,"x":0.48559670802497085},{"x":0.64197530568615979,"c":1,"w":0.18518519083658858,"y":0.19040697658875305,"h":0.016012340046912987,"t":"3 sections, 40 items"},{"x":0.68308094714830381,"w":0.10297390619913738,"t":"60 minutes","y":0.20766330293282498,"c":1,"h":0.013452463633039646},{"y":0.23529827267706904,"h":0.017872805308958628,"t":"Academic Writing","w":0.17579881032307942,"x":0.17246703947164738,"c":1},{"x":0.2262277178464373,"w":0.068120695749918636,"h":0.013661792337262502,"y":0.25552375496795454,"t":"2 tasks","c":1},{"c":1,"y":0.27229448201161666,"t":"60 minutes","x":0.20964908657878642,"w":0.10333557128906248,"h":0.015004059170384942},{"h":0.011627907185728592,"y":0.25726744165907367,"c":1,"x":0.48559670802497085,"t":"or","w":0.024691357612609821},{"c":1,"x":0.61522634330006198,"t":"General Training Writing","h":0.016044868316470562,"w":0.23868311564127598,"y":0.23837209287181771},{"y":0.25547286759419419,"t":"2 tasks","c":1,"w":0.068158226013183665,"h":0.013763567022496703,"x":0.70151759453054463},{"t":"60 minutes","w":0.10319796880086263,"x":0.68296891664486326,"h":0.015700648052813126,"y":0.27267293175744323,"c":1},{"w":0.093787015279134134,"x":0.45204456161801476,"c":1,"t":"Speaking","y":0.30205472221943885,"h":0.018027538124327003},{"h":0.01453488398216074,"t":"11 to 14 minutes","x":0.42181069951579747,"w":0.15226337432861331,"c":1,"y":0.32122093008711139},{"t":"Total Test Time","w":0.14814814249674479,"h":0.013096803209104779,"c":1,"x":0.42386831545655868,"y":0.35174418591748302},{"t":"2 hours 44 minutes","w":0.17695472717285154,"x":0.40946502299793641,"h":0.01453488398216074,"y":0.36773255786357084,"c":1},{"w":0.34773661295572916,"y":0.42432273272676002,"x":0.07818930658797911,"h":0.014723203769140047,"c":1,"t":"ACADEMIC TEST FORMAT"},{"x":0.077181785185839194,"y":0.45752300354515685,"h":0.021180938073687261,"t":"Listening","w":0.10718035380045572,"c":1},{"h":0.018226776302773473,"t":"This test consists of four parts, each with ten questions. The first two parts are concerned","w":0.80874043782552085,"c":1,"y":0.48399285856727459,"x":0.078146759711577543},{"h":0.01598837238037687,"c":1,"w":0.83950617472330724,"y":0.50290697659851569,"x":0.078189299368024198,"t":"with social needs. The first part is a conversation between two speakers and the second part"},{"x":0.076131680851585587,"c":1,"t":"is a monologue. The final two parts are concerned with situations related to educational or","h":0.016019188192342826,"y":0.5203180212514753,"w":0.81893005371093741},{"h":0.018657411366385213,"t":"training contexts. The third part is a conversation between up to four people and the fourth","w":0.81700663248697913,"c":1,"x":0.078127489329325117,"y":0.53674950550225919},{"c":1,"x":0.08024692011795774,"w":0.18724278767903646,"t":"part is a monologue.","y":0.55668604670041022,"h":0.014574259273857026},{"h":0.017450420819968837,"c":1,"t":"A variety of question types is used, including: multiple choice, matching, plan\/map\/","y":0.57412790681744841,"x":0.10082303292653923,"w":0.74691360473632806},{"x":0.078189307551573203,"h":0.017441860778592888,"w":0.84156377156575524,"t":"diagram labelling, form completion, note completion, table completion, flow-chart completion,","y":0.5915697672823359,"c":1},{"c":1,"y":0.61042402838250398,"h":0.016029460129664885,"x":0.078189302218394985,"w":0.65432098388671878,"t":"summary completion, sentence completion and short-answer questions."},{"c":1,"y":0.62639312715003737,"t":"Candidates hear the recording once only and answer the questions as they listen. Ten","h":0.018218850920983853,"x":0.10078315563616561,"w":0.77786590576171888},{"x":0.076131687141488366,"h":0.014545155919482688,"c":1,"t":"minutes are allowed at the end for candidates to transfer their answers to the answer sheet.","w":0.83333333333333337,"y":0.64534883707683788},{"h":0.016505066160599657,"x":0.079726859878778769,"c":1,"w":0.093782571156819663,"t":"Reading","y":0.67608800937454572},{"y":0.70053003550299719,"w":0.77983540852864586,"x":0.078189291514924542,"t":"This test consists of three sections with 40 questions. There are three texts, which are","c":1,"h":0.017493220465202963},{"y":0.7171730303871986,"c":1,"x":0.076082932884923959,"w":0.82728968302408867,"t":"taken from journals, books, magazines and newspapers. The texts are on topics of general","h":0.018998596496941467},{"x":0.078189292772268382,"t":"interest. At least one text contains detailed logical argument.","w":0.54938273111979163,"h":0.014553715960858749,"c":1,"y":0.73691860451779467},{"y":0.75436046497036302,"w":0.76131688435872391,"c":1,"x":0.10082303919606876,"t":"A variety of question types is used, including: multiple choice, identifying information","h":0.015988372380376759},{"x":0.078189303139242647,"y":0.77179034158894622,"h":0.017453844611861058,"w":0.81481480916341142,"t":"(True\/False\/Not Given), identifying the writer's views\/claims (Yes\/No\/Not Given), matching","c":1},{"h":0.018432982257173491,"y":0.78914235690051349,"w":0.81696421305338529,"c":1,"t":"information, matching headings, matching features, matching sentence endings, sentence","x":0.078144912516016518},{"h":0.017667844522968212,"c":1,"t":"completion, summary completion, note completion, table completion, flow-chart completion,","x":0.078189292150705497,"y":0.80800942276959331,"w":0.83127573649088549},{"x":0.080246918431612455,"w":0.49382715861002602,"c":1,"y":0.82558139557932597,"h":0.017469252237021116,"t":"diagram-label completion and short-answer questions."},{"x":0.90740740722603508,"h":0.013081395583944722,"t":"5","w":0.014403292338053375,"y":0.90843023230977182,"c":1}]}