{"lines":[{"h":0.01910037567534062,"c":1,"w":0.085719801584879574,"y":0.03250765600664518,"x":0.83671368702106808,"t":"Reading"},{"h":0.014723203769140158,"t":"Questions 27-30","w":0.17695472717285154,"c":1,"y":0.081272084888328489,"x":0.0823045293160483},{"x":0.080246907824199243,"y":0.11773255797781323,"h":0.017441860778592888,"t":"Choose the correct letter, A, B, C or D.","w":0.3703703816731771,"c":1},{"w":0.57818929036458333,"y":0.15253239096703697,"x":0.082304531668817404,"h":0.016195524146054185,"c":1,"t":"Write the correct letter in boxes 27-30 on your answer sheet."},{"t":"27 What point does the writer make in the first paragraph?","w":0.56995885213216146,"x":0.078189298113933603,"h":0.017446996466431108,"y":0.18749999984001975,"c":1},{"t":"Wisdom appears to be unique to the human race.","w":0.47142740885416667,"h":0.018484634561168001,"c":1,"x":0.17273797797516921,"y":0.21411456323107347},{"h":0.013081395583944722,"t":"B","x":0.12551440354251311,"w":0.018518517812093099,"c":1,"y":0.23401162769598449},{"w":0.018518517812093099,"x":0.1255144035596599,"c":1,"t":"C","y":0.2514534881455277,"h":0.013081395583944611},{"t":"D","w":0.018518517812093099,"x":0.12551440354251311,"h":0.013081395583944722,"y":0.268895348626217,"c":1},{"y":0.23255813972176786,"t":"A basic assumption about wisdom may be wrong.","c":1,"w":0.47119338989257809,"h":0.017441860216947269,"x":0.17283951696214725},{"c":1,"x":0.17489711670492539,"t":"Concepts of wisdom may depend on the society we belong to.","h":0.01744185965530165,"w":0.58847737630208341,"y":0.25000000023048874},{"h":0.017420835573625504,"y":0.26749436856637998,"c":1,"x":0.17277299094912366,"t":"There is still much to be discovered about the nature of wisdom.","w":0.60920094807942704},{"c":1,"y":0.30377906960836554,"t":"28 What does Igor Grossmann suggest about the ability to make wise decisions?","x":0.078189290577600254,"w":0.78600824991861973,"h":0.017481236631934793},{"x":0.15843621231598357,"w":0.45473251342773435,"h":0.014723203769140158,"y":0.33274440524425963,"t":"It can vary greatly from one person to another.","c":1},{"y":0.34759866083963353,"h":0.017264837370603914,"t":"Earlier research into it was based on unreliable data.","w":0.50222544352213538,"x":0.1727682247724337,"c":1},{"x":0.12551440356823329,"w":0.018518517812093099,"t":"C","y":0.36627907001678617,"c":1,"h":0.014534882858869502},{"x":0.12551440334135813,"c":1,"w":0.016460905075073251,"y":0.38517441839365896,"h":0.013081395583944611,"t":"D"},{"h":0.01453488398216074,"w":0.59670781453450528,"c":1,"t":"The importance of certain influences on it was underestimated.","y":0.36773255800637861,"x":0.17283950826628797},{"h":0.016003780005537038,"c":1,"x":0.1728394960197944,"y":0.38515901083330817,"w":0.6769547526041666,"t":"Various branches of psychology define it according to their own criteria."},{"c":1,"h":0.014534883982160851,"w":0.028806584676106778,"y":0.41860465097627197,"t":"29","x":0.078189300159572442},{"y":0.42005813937546199,"w":0.75514404296875004,"h":0.017515476797438589,"c":1,"x":0.1255143981538015,"t":"According to the third paragraph, Grossmann claims that the level of wisdom an"},{"x":0.12345679093054822,"t":"individual shows","y":0.43895348824326219,"w":0.1604938252766927,"h":0.013081395583944833,"c":1},{"h":0.016195524146054185,"c":1,"t":"can be greater than they think it is.","w":0.33333333333333337,"x":0.17078189291044774,"y":0.46643109529590243},{"x":0.12757201648068797,"t":"B","y":0.48401162769598449,"w":0.016460905075073223,"c":1,"h":0.013081395583944611},{"c":1,"t":"C","w":0.018518517812093099,"x":0.12551440354251311,"y":0.5014534881611008,"h":0.013081395583944611},{"x":0.12551440354251311,"h":0.013081395583944611,"c":1,"t":"D","y":0.51889534862621711,"w":0.018518517812093099},{"x":0.16653628374765334,"y":0.48101270673036334,"h":0.019064434846803868,"c":1,"w":0.40569834391276044,"t":"will be different in different circumstances."},{"x":0.16666667159313447,"c":1,"t":"may be determined by particular aspects of their personality.","h":0.015988372380376759,"y":0.50145348822515334,"w":0.57818929036458333},{"h":0.016038020171040834,"t":"should develop over time as a result of their life experiences.","w":0.58230453491210943,"c":1,"x":0.16872427562893469,"y":0.51884570089859361},{"c":1,"x":0.080246913095957217,"w":0.026748971939086916,"t":"30","y":0.54651162773491724,"h":0.013081395583944611},{"h":0.01598837238037687,"c":1,"t":"What is described in the fifth paragraph?","y":0.54651162775900197,"x":0.10288065519974916,"w":0.40946502685546876},{"x":0.17078190263627296,"h":0.015988372380376759,"w":0.54732508341471364,"t":"a difficulty encountered when attempting to reason wisely","y":0.57412790682985693,"c":1},{"c":1,"y":0.59156976723086818,"h":0.013081395583944722,"x":0.12551440354251311,"w":0.018518517812093099,"t":"B"},{"c":1,"y":0.6090116276959846,"t":"C","h":0.013081395583944611,"x":0.12551440354251311,"w":0.018518517812093099},{"x":0.12551440352536636,"h":0.014534883982160851,"c":1,"t":"D","w":0.018518517812093099,"y":0.62645348812035362},{"h":0.017441860778592888,"x":0.17078188695308294,"c":1,"w":0.59465021769205728,"t":"an example of the type of person who is likely to reason wisely","y":0.59156976728147315},{"y":0.60687277975042242,"w":0.55789998372395833,"x":0.16860002882318573,"t":"a controversial view about the benefits of reasoning wisely","c":1,"h":0.020046076870076979},{"y":0.62632508849998358,"c":1,"x":0.17283951464632746,"w":0.59670781453450528,"t":"a recommended strategy that can help people to reason wisely","h":0.017667844522968212},{"x":0.88888888863837756,"t":"49","w":0.02880658467610675,"h":0.013081395583944722,"c":1,"y":0.90843023238112497},{"y":0.95619871442209903,"w":0.25052792867024742,"c":1,"x":0.71930827958083488,"t":"IELTSXpress.com","h":0.02767260251533854}],"w":2400,"h":3396}