{"lines":[{"x":0.07611227330773436,"y":0.0377107197508042,"h":0.014694839540443372,"w":0.11938039143880209,"c":1,"t":"Audioscripts"},{"h":0.011627906062437243,"y":0.084302325844750392,"c":1,"t":"тOM:","w":0.037037035624186199,"x":0.076131688360746394},{"t":"SHIRLEY:","x":0.078189300803608627,"y":0.10029069749820108,"c":1,"w":0.061728394826253238,"h":0.010174418787512574},{"t":"TOM:","x":0.074074075227833172,"y":0.11482558114550778,"w":0.039094648361206047,"h":0.011627907185728703,"c":1},{"c":1,"w":0.063992576599121082,"h":0.010841443766132275,"y":0.13193392926165548,"x":0.078086016121246077,"t":"SHIRLEY:"},{"w":0.04131492932637533,"x":0.073992740995711279,"c":1,"t":"TOM:","y":0.17718042056930294,"h":0.011918228562785238},{"h":0.010174418787512463,"c":1,"y":0.20784883694829803,"t":"SHIRLEY:","w":0.061728394826253266,"x":0.078189301146544141},{"x":0.074074075376812973,"h":0.013081395583944722,"y":0.28343023230977182,"c":1,"t":"TOM:","w":0.041152261098225923},{"h":0.010174418787512574,"t":"SHIRLEY:","x":0.078189300422831939,"c":1,"y":0.30087209291428296,"w":0.061728394826253266},{"y":0.31686046501226017,"w":0.03497942288716635,"c":1,"x":0.078189300799215183,"t":"TOM:","h":0.008720930389296444},{"h":0.011083174931286854,"y":0.33094097059328431,"c":1,"t":"SHIRLEY:","x":0.078050241018527533,"w":0.06406412760416666},{"w":0.039094651540120443,"y":0.3473837208262136,"h":0.0087209303892965551,"t":"TOM:","x":0.076131686472738144,"c":1},{"x":0.078097430007263477,"t":"SHIRLEY:","y":0.3616328622297591,"w":0.061912136077880861,"h":0.010745903347630925,"c":1},{"h":0.016195524146054074,"t":"It's more environmentally friendly, isn't it? Unless you spend half the day in it!","x":0.17489712776618935,"y":0.082744405230776419,"c":1,"w":0.61111109415690101},{"h":0.01453488398216074,"x":0.17283950659368069,"t":"Exactly.","y":0.09883720914142935,"c":1,"w":0.065843620300292977},{"w":0.55566691080729158,"h":0.016595797769032083,"t":"What about heating? It sometimes gets quite cool at that time of year.","y":0.1132173130974341,"x":0.17278048696856435,"c":1},{"w":0.617283935546875,"c":1,"t":"There's central heating, and if you want to light a fire, there's a stove. We can","h":0.016195524146054185,"x":0.1728395135969627,"y":0.12926972886810828},{"c":1,"x":0.17278545105327056,"w":0.60711451212565104,"t":"provide all the wood you need for it. It smells so much nicer than coal, and it","h":0.016813357951924734,"y":0.14322878264981531},{"x":0.17283949915106442,"t":"makes the room very cosy - we've got one in our own house.","y":0.15988372078478574,"w":0.49176956176757813,"h":0.01453488398216074,"c":1},{"c":1,"y":0.17282140346113073,"x":0.17274654254846611,"w":0.62981374104817711,"t":"That sounds very pleasant. Perhaps we should come in the winter, to make the","h":0.019432586831675813},{"w":0.082739677429199215,"c":1,"h":0.014523489315181215,"t":"most of it!","x":0.17262193093365505,"y":0.18968592970471743},{"y":0.2063953487039123,"h":0.014534883982160851,"x":0.17489712142999725,"t":"Yes, we find we don't want to go out when we've got the fire burning. There","c":1,"w":0.59670781453450517},{"c":1,"y":0.2193757363652411,"t":"are some attractive views from the cottage, which I haven't mentioned. There's","w":0.62757202148437508,"h":0.016195524146054185,"x":0.17283951109423204},{"c":1,"w":0.62139918009440109,"h":0.014553715960858749,"x":0.17283950450222421,"y":0.23691860451807556,"t":"a famous stone bridge - it's one of the oldest in the region, and you can see it"},{"w":0.63991770426432293,"h":0.014534883982160851,"y":0.25290697661119577,"c":1,"t":"from the living room. It isn't far away. The bedroom window looks in the opposite","x":0.17283950167274176},{"t":"direction, and has a lovely view of the hills and the monument at the top.","y":0.26884570092656013,"w":0.57818929036458333,"x":0.17283951108883894,"c":1,"h":0.013250883392226132},{"x":0.17283951800103114,"y":0.28343023242517995,"h":0.014567411690072807,"c":1,"w":0.64403289794921881,"t":"Well, that all sounds perfect. I'd like to book it, please. Would you want a deposit?"},{"h":0.01453488398216074,"y":0.29796511613547694,"t":"Yes, we ask for thirty percent to secure your booking, so that'll be, um, £144.","x":0.17489712812547359,"w":0.61111109415690112,"c":1},{"w":0.38477366129557294,"t":"And when would you like the rest of the money?","h":0.014723203769140047,"x":0.17283950669844567,"y":0.31389870419742283,"c":1},{"c":1,"w":0.45679011027018224,"t":"You're coming in May, so the last day of March, please.","y":0.32979976454258553,"x":0.16049383364356848,"h":0.014723203769140158},{"x":0.17119341415488085,"w":0.048930044174194331,"h":0.015901565551757812,"c":1,"t":"Fine.","y":0.34287770581981447},{"t":"Excellent. Could I just take your details ...","x":0.1687242787820955,"y":0.36042402840771715,"w":0.33950617472330724,"h":0.013250883392226243,"c":1},{"c":1,"h":0.011627907185728592,"x":0.84567901208581497,"w":0.02880658467610675,"t":"Q7","y":0.12936046496333731},{"w":0.026748971939086874,"x":0.8477366250301136,"y":0.23691860447910318,"t":"Q8","h":0.013081395583944722,"c":1},{"y":0.2514534881950784,"h":0.013081395583944722,"t":"Q9","x":0.84773662503868707,"w":0.026748971939086874,"c":1},{"x":0.8477366261248066,"y":0.32848837193186486,"h":0.013081395583944722,"t":"Q10","c":1,"w":0.037037035624186143},{"w":0.10498909632364908,"t":"PART 2","h":0.014719108249048762,"x":0.076106274782652666,"y":0.40979160865120967,"c":1},{"t":"CHAIRPERSON:","w":0.10288065592447915,"h":0.010174418787512463,"x":0.078189302696196616,"c":1,"y":0.43895348815348212},{"x":0.078189297561432003,"y":0.47084805641416549,"c":1,"t":"COUNCILLOR THORNTON:","w":0.17078189849853517,"h":0.0088339222614841617},{"x":0.26954732750844262,"h":0.01453488398216074,"c":1,"w":0.53909464518229178,"y":0.4374999998664777,"t":"Right. Next on the agenda we have traffic and highways. Councillor"},{"y":0.45277898451736498,"w":0.079254811604817732,"c":1,"h":0.012678873131777846,"x":0.27114584393774377,"t":"Thornton."},{"x":0.2695473286783901,"y":0.46790341565454008,"w":0.53292180379231779,"h":0.014723203769140047,"c":1,"t":"Thank you. Well, we now have the results of the survey carried out"},{"t":"last month about traffic and road transport in the town. People were","y":0.48401162777243312,"w":0.53909464518229155,"c":1,"x":0.26748971433800556,"h":0.014534883982160851},{"y":0.49798894421996365,"h":0.015126203058465237,"x":0.27151114958628264,"t":"generally satisfied with the state of the roads. There were one or two","w":0.54542683919270829,"c":1},{"h":0.017659394002494277,"t":"complaints about potholes which will be addressed, but a significant","x":0.26946870461704975,"w":0.54338485717773433,"c":1,"y":0.51426809916165817},{"c":1,"x":0.26748970429516478,"h":0.013081395583944722,"y":0.53052325569351844,"t":"number of people complained about the increasing number of heavy","w":0.54938273111979163},{"h":0.017378782917108038,"t":"vehicles using our local roads to avoid traffic elsewhere. We'd","w":0.49403035481770829,"x":0.26739912135734245,"c":1,"y":0.54416998440462194},{"c":1,"t":"expected more complaints by commuters about the reduction in the","w":0.53715031941731772,"x":0.27154511285921784,"y":0.56077454183007658,"h":0.014162360709182531},{"h":0.017019338124772854,"t":"train service, but it doesn't seem to have affected people too much.","x":0.26742881947474784,"w":0.53920450846354173,"y":0.57491020138978655,"c":1},{"c":1,"x":0.27160493166497834,"h":0.013081395583944722,"w":0.54320988972981765,"t":"The cycle path that runs alongside the river is very well used by both","y":0.5915697673196012},{"c":1,"t":"cyclists and pedestrians since the surface was improved last year,","x":0.27155238208476534,"y":0.60611091353349145,"w":0.52687952677408845,"h":0.014652320718035017},{"c":1,"t":"but overtaking can be a problem so we re going to add a bit on the","x":0.26954733755663274,"w":0.5288065592447917,"y":0.62354651149440787,"h":0.014557139752750747},{"c":1,"t":"side to make it wider. At some stage, we'd like to extend the path so","w":0.54115224202473966,"y":0.63808139521524343,"x":0.26954733567023498,"h":0.01453488398216074},{"c":1,"w":0.55144032796223963,"x":0.26748971244310638,"t":"that it goes all the way through the town, but that won't be happening","y":0.65400471133061577,"h":0.014723203769140158},{"h":0.013081395583944722,"t":"The plans to have a pedestrian crossing next to the Post Office","y":0.6845930231354409,"c":1,"x":0.27160494632742804,"w":0.50205759684244788},{"y":0.69755509244711766,"h":0.018858775935268524,"w":0.52082692464192704,"t":"have unfortunately had to be put on hold for the time being. We'd","x":0.26942879786391172,"c":1},{"x":0.26942280683133241,"y":0.71352450387707278,"w":0.49198460896809898,"t":"budgeted for this to be done this financial year, but then there","h":0.018341194754916246,"c":1},{"t":"were rumours that the Post Office was going to move, which would","c":1,"x":0.26954732848201618,"y":0.73110465102859545,"w":0.53292180379231779,"h":0.01453488398216074},{"y":0.74558303882209698,"x":0.26954732955613014,"w":0.52674896240234381,"c":1,"t":"have meant there wasn't really a need for a crossing. Now they've","h":0.013250883392226132},{"y":0.76148409915841297,"x":0.26954731494499168,"t":"confirmed that they're staying where they are, but the Highways","w":0.51028808593750008,"h":0.014723203769140158,"c":1},{"h":0.013081395583944611,"c":1,"t":"Department have told us that it would be dangerous to have a","y":0.77761627894925411,"x":0.2716049309391072,"w":0.49176956176757813},{"c":1,"w":0.51646092732747406,"y":0.7921083630095046,"t":"pedestrian crossing where we'd originally planned it as there's a","x":0.26954731405276627,"h":0.014723203769140158},{"c":1,"h":0.013250883392226243,"t":"bend in the road there. So that'll need some more thought.","x":0.27160492655933449,"y":0.80800942280809807,"w":0.46502059936523438},{"c":1,"x":0.26954732310074253,"t":"On Station Road near the station and level crossing, drivers can","y":0.82412790684271708,"h":0.01453488398216074,"w":0.51234568277994796},{"x":0.26954732121073877,"t":"face quite long waits if the level crossing's closed, and we've now","w":0.52469136555989582,"h":0.011778563015312105,"c":1,"y":0.84010600702517146},{"t":"got signs up requesting them not to leave their engines running at","y":0.85453474699143195,"c":1,"x":0.26954732943241766,"h":0.014723203769140158,"w":0.5267489624023437},{"y":0.8706395347497411,"h":0.01453488398216074,"t":"that time. This means pedestrians waiting on the pavement to cross","w":0.53909464518229155,"x":0.26954732750697191,"c":1},{"w":0.034979422887166378,"h":0.013081395583944722,"y":0.5145348835624971,"c":1,"x":0.84773662589566579,"t":"Q11"},{"y":0.62209302309465564,"x":0.8477366261248066,"w":0.037037035624186143,"h":0.013081395583944611,"t":"Q12","c":1},{"h":0.013081395583944722,"c":1,"x":0.84773662613080814,"w":0.037037035624186143,"y":0.77616279053924131,"t":"Q13"},{"x":0.84773662613080814,"h":0.013081395583944722,"t":"Q14","c":1,"w":0.037037035624186143,"y":0.83866279053924131},{"h":0.013081395583944722,"y":0.9098837207742041,"w":0.037037035624186199,"c":1,"t":"116","x":0.078189301021119206},{"c":1,"y":0.95563152777659655,"t":"IELTSXpress.com","w":0.25226125081380213,"x":0.71953327020158153,"h":0.02696306208418453}],"h":3396,"w":2400}