451},{"x":0.076060257078474316,"w":0.64213114420572925,"h":0.017475489873627681,"y":0.39360914478757103,"t":"Grossmann also believes that it is better to regard scenarios with 34","c":1},{"y":0.41704136510258727,"h":0.020134861814680827,"t":"By avoiding the first-person perspective, we focus more on 35 ..","w":0.59684972127278646,"x":0.076055112671105096,"c":1},{"x":0.073964725864841277,"w":0.60926035563151049,"t":"other moral ideals, which in turn leads to wiser decision-making.","y":0.43971168561714413,"c":1,"h":0.020375152920384831},{"x":0.82502439188507959,"c":1,"w":0.078346277872721304,"y":0.41688182371305693,"h":0.012166584900046074,"t":".. and on"},{"h":0.014534882858869391,"w":0.018518517812093099,"c":1,"t":"D","y":0.51308139559818156,"x":0.16049382743654605},{"h":0.013081395583944722,"c":1,"x":0.16049382742368598,"y":0.53633720910301308,"w":0.018518517812093099,"t":"G"},{"c":1,"h":0.013081395583944611,"w":0.016460905075073251,"y":0.5581395346571556,"t":"J","x":0.16049382719497365},{"y":0.49238149572091361,"w":0.084599043528238937,"h":0.015237008444131117,"c":1,"x":0.2056428649335631,"t":"opinions"},{"x":0.20781893088991713,"t":"modesty","y":0.51453488355570809,"w":0.084362138112386048,"h":0.01453488398216074,"c":1},{"h":0.013223102151715738,"c":1,"t":"fairness","w":0.084405949910481781,"x":0.20162418526177012,"y":0.53626635585010796},{"x":0.20569953822082543,"t":"reasons","y":0.55937639472380696,"w":0.080370470682779971,"c":1,"h":0.012061164011241909},{"c":1,"t":"B","w":0.016460905075073251,"x":0.41358024694806006,"y":0.49127906954087652,"h":0.013081395583944722},{"x":0.45265567463486389,"h":0.014685009618249145,"c":1,"t":"confidence","y":0.48975051826544724,"w":0.11320716857910151},{"x":0.44792307327720837,"c":1,"t":"problems","h":0.019015877210349696,"y":0.51087703540088758,"w":0.10426754633585611},{"h":0.016195524146054074,"t":"H experiences","w":0.16460905710856122,"c":1,"x":0.41358024495092405,"y":0.53474676067051152},{"c":1,"x":0.67901234592934434,"w"