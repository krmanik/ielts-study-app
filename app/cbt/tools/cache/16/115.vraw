{"lines":[{"c":1,"y":0.08415153071960435,"t":"TEST 4","w":0.10297374089558925,"h":0.016289960930850111,"x":0.39707280107389303},{"y":0.14520960396447224,"h":0.016266838541019624,"x":0.076088684068904233,"t":"PART 1","c":1,"w":0.10296666463216145},{"w":0.063856608072916668,"c":1,"h":0.010397619016038528,"t":"SHIRLEY:","x":0.076096387647946004,"y":0.17576049273391692},{"c":1,"y":0.19040697649434501,"x":0.074074075227833172,"w":0.039094648361206047,"t":"TOM:","h":0.011627907185728592},{"x":0.076014386093358255,"t":"SHIRLEY:","y":0.20609432114638482,"w":0.066078224182128914,"h":0.013683450516879248,"c":1},{"c":1,"x":0.074074075417965235,"w":0.041152261098225909,"t":"TOM:","h":0.013081394460653373,"y":0.23691860493173733},{"w":0.063890527089436849,"c":1,"t":"SHIRLEY:","h":0.011917387217599162,"x":0.076079428249216985,"y":0.28328549229038025},{"w":0.039094651540120443,"h":0.010174418787512574,"t":"TOM:","y":0.29941860453146973,"x":0.076131686467022536,"c":1},{"h":0.010283944182738591,"x":0.078171884956269561,"t":"SHIRLEY:","y":0.31535221393836765,"c":1,"w":0.063820838928222656},{"h":0.010174418787512574,"t":"TOM:","x":0.078189301460883556,"y":0.36046511601806541,"c":1,"w":0.037037035624186199},{"x":0.07600342975874376,"t":"SHIRLEY:","y":0.39062674961579769,"w":0.064042523701985668,"h":0.01235115177078161,"c":1},{"w":0.039094648361206061,"y":0.40697674396527517,"h":0.011627907185728703,"t":"TOM:","x":0.076131688309108908,"c":1},{"h":0.011804545866446081,"y":0.43741168045905821,"c":1,"t":"SHIRLEY:","x":0.076099649179759435,"w":0.063850084940592453},{"y":0.4680232555529491,"w":0.037037035624186199,"c":1,"x":0.078189301460883556,"t":"TOM:","h":0.010174418787512574},{"h":0.010462536267032307,"t":"SHIRLEY:","x":0.078142354403404418,"c":1,"y":0.48386756902453065,"w":0.06182228724161784},{"x":0.07613168647273813,"h":0.011627907185728592,"y":0.49999999986490806,"c":1,"t":"TOM:","w":0.039094651540120456},{"h":0.013081394460653373,"c":1,"y":0.51453488400150471,"t":"SHIRLEY:","w":0.065843620300292963,"x":0.076131688203762968},{"w":0.039094648361206061,"x":0.076131688285103416,"c":1,"t":"TOM:","y":0.54505813933349223,"h":0.011627907185728592},{"c":1,"w":0.06593032201131184,"h":0.011875364889946893,"y":0.56092278262259876,"x":0.076088337004951892,"t":"SHIRLEY:"},{"t":"TOM:","x":0.076131688285103416,"y":0.59156976724046906,"w":0.039094648361206061,"h":0.011627907185728592,"c":1},{"t":"SHIRLEY:","x":0.078092797128761618,"y":0.60788717180079233,"c":1,"w":0.064220186869303378,"h":0.01001655704421911},{"h":0.008720930389296444,"y":0.62354651152388796,"c":1,"t":"TOM:","w":0.037037035624186199,"x":0.078189301021119206},{"x":0.076057495343404488,"y":0.6378680815796457,"h":0.012054534345970591,"w":0.065992005666097017,"c":1,"t":"SHIRLEY:"},{"t":"TOM:","w":0.037037035624186199,"x":0.078189301054636881,"h":0.0087209303892965551,"y":0.68459302314390269,"c":1},{"y":0.70058139524099605,"h":0.010174418787512574,"w":0.063786010742187496,"t":"SHIRLEY:","x":0.078189299052774566,"c":1},{"x":0.16666666807656202,"y":0.17441860453853542,"w":0.059670778910319022,"t":"Hello?","h":0.010174418787512574,"c":1},{"t":"Oh hello. I was hoping to speak to Jack Fitzgerald about renting a cottage.","c":1,"x":0.1728395001930963,"y":0.188953488236134,"w":0.59465021769205717,"h":0.01453488398216074},{"y":0.20494186031842276,"x":0.16872426748275596,"w":0.58024693806966143,"c":1,"t":"I'm his wife, Shirley, and we own the cottages together, so I'm sure I can","h":0.01598837238037687},{"y":0.22071117334373136,"x":0.17225850557867281,"t":"nelp you.","w":0.079225610097249349,"h":0.015384055700403243,"c":1},{"h":0.014534882858869391,"c":1,"t":"Great. My name's Tom. Some friends of ours rented Granary Cottage from you","y":0.23401162809575915,"x":0.17489714219128416,"w":0.62551437377929686},{"c":1,"w":0.63374486287434895,"y":0.2499999998492487,"t":"last year, and they thought it was great. So my wife and I are hoping to come in","x":0.17078188961603216,"h":0.01598837238037687},{"c":1,"h":0.011778563015312105,"t":"May for a week.","x":0.17489712127946763,"y":0.26737338058140803,"w":0.125514399210612},{"c":1,"x":0.17489712143896033,"t":"What date did you have in mind?","y":0.28197674406317508,"h":0.013081395583944833,"w":0.26337448120117191},{"x":0.17283950245597793,"t":"The week beginning the 14th, if possible.","w":0.32921811421712244,"h":0.01453488398216074,"c":1,"y":0.29796511614370458},{"t":"I'Il just check... I'm sorry, Tom, it's already booked that week. It's free the week","y":0.31242638384756061,"c":1,"x":0.17283951080602511,"h":0.014723203769140158,"w":0.63580245971679683},{"y":0.32650764538444499,"h":0.017887882686475787,"t":"beginning the 28th, though, for seven nights. In fact, that's the only time you","w":0.60509689331054695,"x":0.17276299397751019,"c":1},{"w":0.16503406524658204,"h":0.014675331902026634,"y":0.34302409371040721,"c":1,"x":0.17266847037957589,"t":"could have it in May."},{"y":0.35895170804596122,"x":0.17489711766919064,"w":0.62139918009440098,"h":0.014723203769140047,"t":"Oh. Well, we could manage that, I think. We'd just need to change a couple of","c":1},{"h":0.011631330977620813,"c":1,"x":0.17489711782926171,"w":0.25925926208496092,"y":0.37499999989066279,"t":"things. How much would it cost?"},{"x":0.17283949413839536,"h":0.014534883982160851,"t":"That's the beginning of high season, so it'd be £550 for the week.","c":1,"w":0.52263376871744793,"y":0.38953488358740795},{"h":0.016195524146054074,"y":0.4040047112985079,"w":0.62139918009440098,"c":1,"t":"Ah. That's a bit more than we wanted to pay, I'm afraid. We've budgeted up to","x":0.17283950474017948},{"c":1,"y":0.41874281646774714,"t":"£500 for accommodation.","w":0.20608273824055989,"x":0.17476741584603217,"h":0.014457912692192432},{"t":"Well, we've just finished converting another building into a cottage, which we're","w":0.63180821736653647,"h":0.017593029952301942,"x":0.1727860135704401,"c":1,"y":0.4343931440650346},{"y":0.45200235588524462,"w":0.19135801951090492,"c":1,"h":0.013250883392226132,"x":0.17283950864571779,"t":"calling Chervil Cottage."},{"c":1,"w":0.23251029968261716,"t":"Sorry? What was that again?","x":0.17489711343121495,"y":0.46643109530844096,"h":0.014723203769140158},{"t":"Chervil. C-H-E-R-V for Victor I-L.","c":1,"h":0.013081395583944611,"x":0.17489712143394182,"y":0.48255813941201242,"w":0.26337448120117185},{"y":0.49705535912717513,"t":"Oh, that's a herb, isn't it?","x":0.17489711837748889,"w":0.20164609273274742,"h":0.016026036337772664,"c":1},{"c":1,"x":0.17480140639839201,"w":0.64834142049153642,"h":0.018633097164482026,"y":0.51041962158930143,"t":"That's right. It grows fairly wild around here. You could have that for the week you"},{"y":0.52713457435514355,"t":"want for £480.","h":0.016951781139216471,"w":0.11959269205729167,"x":0.17477155623789803,"c":1},{"h":0.013250883392226243,"x":0.17695473555073155,"y":0.54358068337538068,"c":1,"t":"OK. So could you tell me something about it, please?","w":0.42386830647786461},{"x":0.17481804743162685,"y":0.55746085942226331,"h":0.016642958031105159,"t":"Of course. The building was built as a garage. It's a little smaller than","w":0.55159301757812496,"c":1},{"w":0.1419753138224284,"c":1,"y":0.57558139521820206,"t":"Granary Cottage.","x":0.17489711661347712,"h":0.013081395583944722},{"x":0.1769547388430511,"y":0.59010600701058868,"h":0.01309166752126667,"w":0.31893002827962236,"t":"So that must sleep two people, as well?","c":1},{"x":0.17489712085499454,"y":0.60453474685065367,"h":0.014723203769140158,"c":1,"w":0.32098765055338541,"t":"That's right. There's a double bedroom."},{"w":0.18970831553141276,"t":"Does it have a garden?","y":0.62051842619559416,"h":0.015762845815561977,"x":0.17472596904877685,"c":1},{"c":1,"x":0.17483718819293748,"y":0.63450005622143846,"w":0.60712081909179683,"t":"Yes, you get to it from the living room through French doors, and we provide","h":0.016778942552977738},{"c":1,"w":0.63374486287434895,"h":0.017667844522968212,"x":0.17489711600381685,"y":0.6495877502452555,"t":"two deckchairs. We hope to build a patio in the near future, but I wouldn't like to"},{"w":0.26954732259114589,"h":0.01453488398216074,"y":0.66715116265076513,"c":1,"t":"guarantee it'Il be finished by May.","x":0.17489712053543902},{"t":"The front door opens onto the old farmyard, and parking isn't a problem - there's","y":0.69758539482769322,"w":0.64814814249674479,"x":0.17489712206372321,"c":1,"h":0.014723203769140158},{"x":0.17489711390702639,"y":0.71366279057767101,"h":0.013081395583944611,"c":1,"w":0.64609054565429691,"t":"plenty of room at the front for that. There are some trees and potted plants there."},{"h":0.013081395583944611,"y":0.31104651144494633,"t":"Q1","x":0.83333333286142985,"w":0.04115226427714036,"c":1},{"w":0.026748971939086874,"t":"Q2","h":0.013081395583944722,"x":0.84773662503868707,"y":0.3880813951718225,"c":1},{"c":1,"w":0.026748971939086874,"t":"Q3","y":0.45058139519962226,"x":0.84773662503868707,"h":0.011627907185728592},{"x":0.84773662525453919,"w":0.02880658467610675,"h":0.011627907185728703,"c":1,"t":"Q4","y":0.55813953473077904},{"t":"Q5","x":0.84979423820741129,"y":0.61918604633461338,"w":0.026748971939086874,"h":0.013081395583944722,"c":1},{"c":1,"h":0.013081395583944722,"x":0.84979423820741129,"w":0.026748971939086874,"t":"Q6","y":0.69622093005554353},{"w":0.037037035624186199,"x":0.078189301021119206,"y":0.75872093012853925,"t":"TOM.","h":0.0087209303892965551,"c":1},{"y":0.78924418593753876,"h":0.010174418787512574,"t":"SHIRLEY:","x":0.080246913591556224,"w":0.061728394826253252,"c":1},{"x":0.080216475862495126,"y":0.80517125806370249,"h":0.0088435303336459326,"t":"тOM.","c":1,"w":0.035040299097696931},{"w":0.065843620300292977,"t":"SHIRLEY:","h":0.013081395583944722,"x":0.078189301372487252,"y":0.81976744161209747,"c":1},{"t":"What about facilities in the cottage? It has standard things like a cooker and","w":0.60288065592447915,"h":0.011627907185728592,"x":0.17695473366362705,"c":1,"y":0.75581395338188873},{"x":0.17489712012533051,"y":0.77179034159328719,"c":1,"t":"fridge, presume.","w":0.14609053293863936,"h":0.01454686781542891},{"x":0.17489712207032729,"h":0.013250883392226132,"c":1,"w":0.64814814249674479,"y":0.78621908106073912,"t":"In the kitchen area there's a fridge-freezer and we've just put in an electric cooker."},{"y":0.80081838760577151,"w":0.230750249226888,"c":1,"h":0.015543792216881736,"x":0.17682137988030008,"t":"Is there a washing machine?"},{"x":0.17489712206394131,"y":0.81684334488640464,"w":0.64814814249674479,"h":0.016005492463128657,"c":1,"t":"Yes. There's also a TV in the living room, which plays DVDs too. The bathroom is"},{"t":"too small for a bath, so there's a shower instead. I think a lot of people prefer that","y":0.83161828843726482,"w":0.64838678995768229,"c":1,"x":0.17684334262053891,"h":0.018239855345062228},{"y":0.85092820900167998,"h":0.014985760193410247,"x":0.17669049507534382,"t":"nowadays, anyway.","w":0.15689904530843099,"c":1},{"h":0.01453488398216074,"t":"115","x":0.88065843704387403,"w":0.037037035624186143,"c":1,"y":0.90988372065426837},{"c":1,"x":0.71953327191129191,"h":0.027004518273019973,"y":0.9556315279170291,"t":"IELTSXpress.com","w":0.25425661722819015}],"h":3396,"w":2400}