{"h":3396,"lines":[{"y":0.07848837235258177,"t":"TEST 2","w":0.10493827184041338,"x":0.4032921811065423,"h":0.017506916194417022,"c":1},{"y":0.13989551058442518,"w":0.10351678848266602,"h":0.018174095063945295,"c":1,"t":"PART 1","x":0.081986461654406539},{"h":0.01061508708904435,"c":1,"t":"EMPLOYEE:","w":0.07830180486043295,"y":0.1712912935825105,"x":0.082248274971276347},{"t":"WOMAN:","w":0.060152829488118495,"x":0.082063502851552908,"y":0.1867408009984588,"h":0.011692816573683262,"c":1},{"t":"EMPLOYEE:","x":0.082271069206283132,"y":0.21788988112579977,"w":0.080313828786214209,"h":0.01044116789657179,"c":1},{"w":0.059731032053629562,"x":0.082274401573286859,"h":0.010352212211689693,"t":"WOMAN:","y":0.23392273108490014,"c":1},{"t":"EMPLOYEE:","c":1,"x":0.084327691125969342,"h":0.010434924643508703,"y":0.27893951425649943,"w":0.076200586954752611},{"w":0.059670778910319008,"x":0.084362141302483054,"y":0.29651162781303453,"h":0.008720930389296444,"t":"WOMAN.","c":1},{"w":0.078376522064208989,"h":0.010918747550326402,"c":1,"t":"EMPLOYEE:","y":0.32520923075618546,"x":0.084268529865316286},{"y":0.37209302303720304,"h":0.010174418787512574,"c":1,"t":"WOMAN:","x":0.084362141897721163,"w":0.059670778910319008},{"c":1,"w":0.078189303080240885,"y":0.40406976735201638,"t":"EMPLOYEE.","h":0.0087209303892965551,"x":0.084362138480455678},{"x":0.084362142129202594,"h":0.010174418787512574,"c":1,"t":"WOMAN:","y":0.43313953462271659,"w":0.059670778910319022},{"h":0.010454420487366889,"y":0.46352278959043103,"w":0.078261343638102207,"t":"EMPLOYEE:","x":0.084326119334416513,"c":1},{"x":0.084322821904653858,"t":"WOMAN:","y":0.47953483845434364,"h":0.010407067019189586,"c":1,"w":0.059749418894449888},{"w":0.078238722483317064,"x":0.084337429654021884,"y":0.49410255539074388,"t":"EMPLOYEE:","c":1,"h":0.011794888931112579},{"c":1,"y":0.51162790688280191,"h":0.008720930389296444,"x":0.084362141309831676,"t":"WOMAN:","w":0.059670778910319008},{"t":"EMPLOYEE:","h":0.0099860720415417825,"c":1,"x":0.084251659224336875,"w":0.078517335255940748,"y":0.52632437707204072},{"y":0.57211927838746479,"w":0.062076098124186199,"h":0.011284699007535259,"x":0.082130675117807458,"t":"WOMAN:","c":1},{"t":"EMPLOYEE:","c":1,"h":0.010807516998902034,"w":0.076296145121256514,"x":0.086337524195764154,"y":0.61014856704843157},{"w":0.059670778910319008,"t":"WOMAN:","h":0.008720930389296444,"x":0.084362141309831676,"y":0.62645348827815073,"c":1},{"y":0.65697674409589235,"t":"EMPLOYEE:","h":0.008720930389296444,"c":1,"w":0.078189303080240885,"x":0.086419751646399395},{"y":0.68604651136690264,"h":0.010174418787512574,"c":1,"w":0.059670778910319022,"t":"WOMAN:","x":0.084362142129202594},{"y":0.70348837200254177,"w":0.076131687164306627,"h":0.008720930389296444,"c":1,"t":"EMPLOYEE:","x":0.086419753019927159},{"x":0.084320147846935978,"c":1,"h":0.011844823722704567,"y":0.71791479741981468,"t":"WOMAN:","w":0.059754765828450518},{"t":"EMPLOYEE.","x":0.086419751649179991,"c":1,"h":0.0072674419910804255,"y":0.74999999992513,"w":0.078189303080240899},{"h":0.010174418787512574,"w":0.059670778910319022,"y":0.77906976718085608,"x":0.084362142129202594,"t":"WOMAN:","c":1},{"t":"EMPLOYEE:","y":0.81104651153806295,"w":0.078189303080240899,"x":0.086419751649179991,"h":0.008720930389296444,"c":1},{"t":"WOMAN:","y":0.83990758982446934,"x":0.084292212441423139,"c":1,"w":0.059810638427734389,"h":0.010591796767164041},{"c":1,"y":0.85755813944503967,"t":"EMPLOYEE.","x":0.086419751649179991,"h":0.008720930389296444,"w":0.078189303080240899},{"h":0.016043156420524562,"t":"Hello, Picturerep. Can I help you?","x":0.176954737274685,"y":0.17005813938505754,"w":0.27366254170735682,"c":1},{"t":"Oh, hi. I saw your advertisement about copying pictures to disk and I'd like a bit","c":1,"x":0.17901234224434784,"y":0.18459302310646752,"w":0.63374486287434895,"h":0.015988372380376759},{"y":0.20053003553844428,"w":0.29423868815104171,"h":0.013250883392226132,"c":1,"t":"more information about what you do.","x":0.18106995625271746},{"y":0.21643109530970139,"t":"Sure. What would you like to know?","w":0.28806584676106772,"x":0.17901234400703761,"h":0.014723203769140158,"c":1},{"w":0.62962961832682296,"h":0.01453488398216074,"c":1,"y":0.23110465102525402,"t":"Well, I've got a box full of old family photos that's been up in the attic for years,","x":0.17901235135785054},{"t":"some of them must be 50 or 60 years old, and I'd like to get them converted to","w":0.62563766479492189,"x":0.17894991550377484,"y":0.24555574522505164,"h":0.017318746928472351,"c":1},{"c":1,"x":0.17894840065169093,"y":0.26283340225097951,"h":0.015030869887209364,"w":0.11123900095621742,"t":"digital format."},{"y":0.27906976731661182,"w":0.23251029968261719,"c":1,"t":"Sure, we can do that for you.","x":0.1810699529049998,"h":0.013081395583944611},{"w":0.61126225789388022,"y":0.29153333663636471,"t":"Right. And what about size? The photos are all sorts of sizes - are there any","x":0.17894285607593871,"c":1,"h":0.017546980625327779},{"x":0.17901234589088721,"h":0.013081395583944611,"y":0.30813953463535326,"w":0.10082304636637368,"c":1,"t":"restrictions?"},{"c":1,"h":0.01588764010947219,"y":0.3225570659841378,"w":0.57830617268880202,"x":0.17895695791635036,"t":"Well the maximum size of photo we can do with our normal service is 30"},{"h":0.016017476296396826,"c":1,"t":"centimetres. And each picture must be at least 4 centimetres, that's the minimum","x":0.17901234044902897,"y":0.33863368662909521,"w":0.64609054565429691},{"t":"we can cope with.","h":0.013210130383746632,"c":1,"x":0.18088296305829468,"w":0.14640876770019531,"y":0.35568387617617936},{"x":0.18097134105324245,"y":0.36712813029876512,"w":0.62367396036783851,"t":"That should be fine. And some of them are in a frame - should I take them out","h":0.017499440129148724,"c":1},{"w":0.1625514348347982,"h":0.011778563015311994,"t":"before I send them?","y":0.3851590106812004,"c":1,"x":0.18106995957162705},{"y":0.4010600706429357,"t":"Yes please, we can't copy them otherwise. And also the photos must all be","x":0.18106995277766155,"h":0.013250883392226021,"c":1,"w":0.59465021769205728},{"c":1,"x":0.18106995310101737,"y":0.41715116266833463,"t":"separate, they musth't be stuck into an album.","w":0.37037038167317704,"h":0.013081395583944611},{"x":0.1831275756815133,"t":"OK, that's not a problem. So can you give me an idea of how much this will cost?","y":0.43168433449602495,"w":0.64197530110677081,"h":0.013083107479890832,"c":1},{"y":0.44758539482426229,"w":0.26337448120117191,"c":1,"x":0.17901234777226668,"t":"I've got about 360 photos I think.","h":0.014723203769140047},{"t":"We charge £195 for 300 to 400 photos for the basic service.","x":0.17901234850471401,"y":0.46220930218576683,"h":0.01453488398216074,"w":0.48148147583007805,"c":1},{"w":0.28806584676106772,"t":"OK. And does that include the disk?","x":0.18106995717502172,"y":0.47819767429631121,"h":0.013081395583944833,"c":1},{"h":0.015023970632025208,"y":0.49237680019673169,"x":0.18101590525640049,"w":0.44248280843098958,"t":"Yes, one disk - but you can get extra ones for £5 each.","c":1},{"x":0.18312757286185397,"c":1,"t":"That's good. So do I need to pay when I send you the photos?","y":0.50872093011211028,"w":0.49382715861002602,"h":0.013081395583944722},{"t":"No, we won't need anything until we've actually copied the pictures. Then we'll let","c":1,"w":0.65020573933919268,"h":0.01598837238037687,"x":0.18106996986249924,"y":0.52325581380351704},{"w":0.6277750651041667,"t":"you know how much it is, and once we've received the payment, we'll send the","y":0.53737699960010599,"h":0.017354914661852239,"x":0.18095733122947127,"c":1},{"x":0.18089583912035792,"y":0.55409146492369687,"h":0.014778239426539774,"c":1,"t":"parcel off to you.","w":0.13629966735839846},{"t":"Right.","x":0.1810699591475847,"h":0.013081395583944722,"c":1,"w":0.049382715225219753,"y":0.57122093008527397},{"w":0.4691357930501302,"t":"Is there anything else you'd like to ask about our services?","h":0.013250883392226243,"x":0.17901235028608767,"y":0.6089517080585557,"c":1},{"c":1,"x":0.17901233677800302,"y":0.62354651149466811,"h":0.014557139752750858,"w":0.61316874186197923,"t":"Yes. I've roughly sorted out the photos into groups, according to what they're"},{"x":0.18312756438035421,"c":1,"w":0.54938273111979163,"y":0.63953488360086086,"t":"about - so can you keep them in those groups when you copy them?","h":0.013081395583944722},{"t":"Sure. We'll save each group in a different folder on the disk and if you like, you","h":0.014723203769140158,"w":0.62551442464192708,"y":0.6540047113309142,"c":1,"x":0.18106994806998292},{"y":0.66921433434390476,"c":1,"h":0.01587672003306817,"t":"can suggest a name for each folder.","x":0.18092812559273644,"w":0.29036326090494791},{"t":"So I could have one called 'Grandparents' for instance?","w":0.44238683064778644,"h":0.01453488398216074,"c":1,"x":0.18106995915702712,"y":0.68459302311859194},{"y":0.7151162792878818,"x":0.1810699806027761,"w":0.59465016682942706,"c":1,"h":0.016038019609395104,"t":"And do you do anything besides scan the photos? Like, can you make any"},{"w":0.12797467549641928,"c":1,"h":0.013563513334564181,"y":0.73100312735144157,"t":"improvements?","x":0.1788686318170557},{"t":"Yes, in the standard service each photo is checked, and we can sometimes touch","y":0.7470553591787813,"c":1,"x":0.18312756657614368,"h":0.013250883392226132,"w":0.6460905456542968},{"y":0.76148409913402371,"w":0.60905349731445313,"t":"up the colour a bit, or improve the contrast - that can make a big difference.","h":0.014723203769140158,"x":0.17901234672105773,"c":1},{"h":0.01453488398216074,"w":0.63168726603190106,"x":0.1810699471287569,"c":1,"t":"OK. And some of the photos are actually quite fragile - they won't get damaged","y":0.77761627893676943},{"c":1,"x":0.18106995583959085,"t":"in the process, will they?","w":0.19958848317464195,"h":0.013250883392226243,"y":0.79358068337188759},{"t":"No, if any look particularly fragile, we'd do them by hand. We do realise how","h":0.016195524146054185,"y":0.80800942278225973,"w":0.60699590047200525,"c":1,"x":0.1810699508912911},{"y":0.82412790683787041,"t":"precious these old photos can be.","h":0.014534883982160851,"x":0.18106996364056963,"w":0.27366254170735682,"c":1},{"h":0.011829152685733813,"w":0.048528636296590155,"y":0.84068726874070643,"x":0.18056042597788616,"c":1,"t":"Sure."},{"t":"And another thing is we can make changes to a photo if you want - so if you want","c":1,"x":0.18312758410843222,"w":0.6440328979492187,"y":0.85306242663436471,"h":0.014723203769140158},{"y":0.86899956833075043,"h":0.017023688631989997,"t":"to remove an object from a photo, or maybe alter the background, we can do that.","w":0.64623560587565099,"x":0.17895098267213372,"c":1},{"h":0.013081395583944611,"c":1,"x":0.85390946454485972,"y":0.36918604633461327,"w":0.026748971939086874,"t":"Q1"},{"t":"Q2","x":0.85390946472490104,"w":0.026748971939086874,"h":0.013081394460653373,"y":0.46075581423406287,"c":1},{"x":0.85390946472490104,"h":0.013081394460653373,"t":"Q3","w":0.026748971939086874,"c":1,"y":0.53779069795499301},{"t":"Q4","y":0.68459302308375436,"w":0.02880658467610675,"h":0.013081395583944722,"c":1,"x":0.85390946476071194},{"x":0.8539094647700648,"t":"Q5","h":0.013081395583944722,"c":1,"w":0.02880658467610675,"y":0.74563953470670641},{"w":0.028806584676106861,"h":0.013081394460653373,"c":1,"x":0.85390946496647335,"t":"Q6","y":0.80668604679220235},{"w":0.02880658467610675,"t":"Q7","h":0.011627907185728703,"c":1,"x":0.85390946476862595,"y":0.86918604636241292},{"x":0.084362139147635268,"t":"104","w":0.039094651540120456,"h":0.013081395583944722,"c":1,"y":0.90552325565792502},{"w":0.25423940022786451,"t":"IELTSXpress.com","y":0.95570565020673848,"c":1,"x":0.71954278067704558,"h":0.026845186141410626}],"w":2400}