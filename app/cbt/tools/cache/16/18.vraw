53,"t":"Liu and colleagues were the first researchers to compare polar bears and brown","h":0.01598837238037687,"c":1},{"y":0.36042402834803755,"t":"bears genetically.","w":0.17078189849853515,"h":0.016029460129664774,"c":1,"x":0.13786007966999564},{"w":0.80685124715169254,"y":0.38425559650457985,"h":0.020573704767845036,"t":"4 Polar bears are able to control their levels of 'bad' cholesterol by genetic means.","x":0.092473121954815371,"c":1},{"c":1,"w":0.74086598714192708,"x":0.092536493575158169,"y":0.41411531105947463,"t":"5 Female polar bears are able to survive for about six months without food.","h":0.017597404610282252},{"y":0.44316843320059873,"t":"It was tound that the bones of female polar bears were very weak when they came","x":0.12345679566199398,"w":0.79629628499348948,"h":0.016195524146054074,"c":1},{"c":1,"t":"out of their dens in spring.","w":0.25163477579752602,"y":0.45810151899146678,"x":0.13763444860171858,"h":0.019319093971567058},{"h":0.021127208804073261,"c":1,"w":0.77389597574869784,"x":0.11306096800633034,"t":"The polar bear's mechanism for increasing bone density could also be used by","y":0.48473855099184759},{"x":0.13764237214955463,"h":0.017528268838799321,"w":0.15690091451009111,"y":0.50447188396857467,"t":"people one day.","c":1},{"t":"18","y":0.90697674403310469,"h":0.011627907185728592,"c":1,"x":0.090534978956725395,"w":0.026748971939086916}],"h":3396,"w":2400}