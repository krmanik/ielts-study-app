{"lines":[{"w":0.059758434295654278,"c":1,"h":0.013282305219850299,"t":"Test 3","x":0.10077921896680167,"y":0.034783265971700894},{"t":"Questions 23 and 24","y":0.081272084890028573,"h":0.01472320376914027,"c":1,"w":0.21810699462890626,"x":0.098765432624817295},{"y":0.11773255797540594,"h":0.017441860778592888,"x":0.098765426970671366,"t":"Choose TWO letters, A-E.","w":0.25514404296874998,"c":1},{"y":0.15253239095393489,"t":"Write the correct letters in boxes 23 and 24 on your answer sheet.","x":0.098765429483804651,"h":0.017667844522968212,"w":0.62757202148437496,"c":1},{"w":0.81275721232096365,"t":"Which TWO of the following statements does the writer make about the discoveries of","x":0.09876542665844823,"h":0.015993508068214979,"y":0.18895348822638214,"c":1},{"w":0.14609053293863933,"c":1,"h":0.014534883982160851,"t":"Barrett's team?","x":0.098765433016277063,"y":0.20639534869606146},{"c":1,"w":0.58230453491210943,"x":0.18930040733435941,"h":0.01598837238037687,"t":"Artefacts found in the higher mountain passes were limited to","y":0.23401162776032813},{"h":0.01598837238037687,"x":0.19135802640422397,"y":0.25145348821683045,"c":1,"w":0.16872427622477212,"t":"skiing equipment."},{"t":"Hunters went into the mountains even during periods of extreme cold.","h":0.017491508569256853,"w":0.66255142211914064,"c":1,"y":0.26884570088637361,"x":0.19135803366759346},{"h":0.018342190552656512,"y":0.28629473736975564,"x":0.19126715497434787,"w":0.64833429972330725,"c":1,"t":"The number of artefacts from certain time periods was relatively low."},{"w":0.62551442464192708,"y":0.30523255799260851,"x":0.19135801389018431,"t":"Radiocarbon dating of artefacts produced some unreliable results.","c":1,"h":0.016027748233718775},{"c":1,"w":0.66666666666666674,"x":0.18930041133122794,"t":"More artefacts were found in Oppland than at any other mountain site.","y":0.3226744184428425,"h":0.017441860778592999},{"x":0.098765437178335538,"y":0.39244186032744532,"c":1,"t":"Questions 25 and 26","h":0.014534883982160629,"w":0.21604937235514327},{"w":0.25514404296875004,"x":0.098765426969821463,"t":"Choose TWO letters, A-E.","c":1,"h":0.017481236631934793,"y":0.42873969375003318},{"w":0.625780537923177,"y":0.46172830743984106,"t":"Write the correct letters in boxes 25 and 26 on your answer sheet.","x":0.098644497689629324,"h":0.018824978346538179,"c":1},{"w":0.79435506184895832,"y":0.49809016544027995,"t":"Which TWO of the following statements does the writer make about the Viking Age?","c":1,"h":0.019202790636617562,"x":0.096640538597013687},{"c":1,"t":"Hunters at this time benefited from an increased demand for goods.","y":0.52428444830518917,"w":0.64225789388020837,"x":0.19122457522909703,"h":0.019666427998716873},{"y":0.54505300370095355,"t":"The beginning of the period saw the greatest growth in the wealth of Vikings.","c":1,"h":0.015993508068214979,"x":0.19135803243081076,"w":0.72633743286132812},{"h":0.017515476797438589,"t":"Vikings did not rely on ships alone to transport goods.","y":0.56242638382075172,"w":0.51028808593750008,"c":1,"x":0.18930040136935569},{"w":0.65652862548828128,"h":0.018844115860470634,"c":1,"t":"Norwegian towns at this time attracted traders from around the world.","x":0.19128640241751194,"y":0.57856517676340269},{"w":0.70390981038411471,"c":1,"y":0.59599923929891974,"h":0.019813156801904541,"t":"Vikings were primarily interested in their trading links with the Middle East.","x":0.18921508154620814},{"c":1,"x":0.094650205501452783,"t":"68","y":0.90697674401398698,"w":0.028806584676106778,"h":0.013081395583944722},{"y":0.90531603446059894,"w":0.12821688334147135,"x":0.16222503994394222,"h":0.018058020880421743,"t":"→ • p. 126","c":1},{"h":0.02906125116966074,"c":1,"t":"IELTSXpress.com","y":0.9561987124207002,"x":0.71922402793715989,"w":0.25061218261718743}],"h":3396,"w":2400}