ains and 21 ....","c":1},{"h":0.016451475055815901,"c":1,"t":".. gathered there in","y":0.79921760868286129,"x":0.67464154893771888,"w":0.17740990956624347},{"t":"the summer months to avoid being attacked by 22...","h":0.024997738140631887,"x":0.084110685486312439,"c":1,"y":0.81823515642739286,"w":0.4902690633138021},{"c":1,"x":0.77338260337666764,"t":"... on lower","w":0.10130953470865889,"y":0.82379519021137859,"h":0.015877563063191324},{"y":0.84738372076990542,"h":0.017457268403753057,"w":0.75308639526367183,"t":"ground. The people who used these mountains left things behind and it is those","c":1,"x":0.084362152032002577},{"w":0.42204833984375006,"x":0.086311542743726946,"c":1,"h":0.018963543068534205,"t":"objects that are of interest to archaeologists.","y":0.86933154269253476},{"x":0.87860082257812455,"y":0.90843023238608001,"w":0.026748971939086874,"h":0.013081395583944722,"c":1,"t":"67"},{"w":0.25230613708496097,"y":0.95624478928247569,"c":1,"x":0.71949110668231775,"t":"IELTSXpress.com","h":0.026175226002615681}]}