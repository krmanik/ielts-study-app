{"h":3396,"lines":[{"y":0.030523255657383119,"t":"Test 2","h":0.01453488398216074,"c":1,"w":0.059670778910319022,"x":0.83744856106291798},{"w":0.04732510248819987,"t":"SUSIE:","h":0.008720930389296444,"x":0.059670781991029119,"y":0.079941860366926853,"c":1},{"t":"LUKE:","c":1,"h":0.012006459724776763,"w":0.045459591547648108,"x":0.057517118117484216,"y":0.15533397929718518},{"y":0.20203488350015897,"w":0.049382715225219732,"h":0.011627907185728592,"x":0.057613169424427159,"t":"SUSIE:","c":1},{"t":"LUKE:","h":0.010174418787512574,"c":1,"x":0.057613168601776246,"w":0.045267489751180015,"y":0.24999999988544563},{"c":1,"y":0.28779069776786059,"h":0.0087209298276509362,"x":0.059670782012072911,"t":"SUSIE:","w":0.04732510248819987},{"w":0.043209877014160153,"x":0.059670781549504281,"y":0.30377906966727042,"t":"LUKE:","c":1,"h":0.0087209303892965551},{"x":0.059670782672223775,"t":"SUSIE:","y":0.31831395322736777,"h":0.010174418787512574,"c":1,"w":0.047325102488199856},{"h":0.0094292756385039311,"y":0.34934268741105656,"w":0.043895832697550465,"t":"LUKE:","x":0.059403862260474817,"c":1},{"x":0.059653339287702743,"h":0.0088158788332809435,"c":1,"t":"SUSIE:","y":0.3647781070753644,"w":0.047359987894693999},{"c":1,"w":0.043209877014160153,"y":0.38081395338923885,"t":"LUKE:","h":0.008720930389296444,"x":0.059670781554648319},{"y":0.39357244839036087,"h":0.013727195973390671,"c":1,"t":"SUSIE:","x":0.057445418108681326,"w":0.049718217849731447},{"w":0.043209877014160153,"h":0.008720930389296333,"c":1,"t":"LUKE:","y":0.41133720920215411,"x":0.059670781549504281},{"w":0.047325102488199856,"x":0.059670782356723094,"y":0.42587209283008098,"h":0.010174418787512574,"t":"SUSIE:","c":1},{"t":"LUKE:","c":1,"x":0.057613169013298868,"h":0.011627907185728703,"y":0.45639534858736819,"w":0.045267489751180015},{"w":0.049382715225219732,"x":0.057613169424427159,"h":0.011627907185728592,"t":"SUSIE:","y":0.48691860443039148,"c":1},{"t":"LUKE:","x":0.057613169013298868,"y":0.51744186021527527,"w":0.045267489751180015,"h":0.011627907185728703,"c":1},{"t":"SUSIE:","w":0.047568000157674151,"x":0.059549333637115232,"y":0.53314083711143978,"h":0.010753209234266814,"c":1},{"h":0.011627907185728592,"c":1,"t":"LUKE:","w":0.045267489751180008,"y":0.54941860443039148,"x":0.057613168910418226},{"y":0.594476743984655,"w":0.049382715225219725,"h":0.011627907185728592,"c":1,"t":"SUSIE:","x":0.057613169342122628},{"t":"LUKE:","x":0.059403989312998652,"h":0.0094292756385039311,"c":1,"w":0.043767480850219732,"y":0.61097342216463646},{"w":0.04732510248819987,"t":"SUSIE:","h":0.008720930389296444,"x":0.059670781991029119,"y":0.62645348827390346,"c":1},{"c":1,"x":0.057613168601776246,"y":0.67296511616451538,"h":0.010174418787512463,"w":0.045267489751180015,"t":"LUKE:"},{"x":0.057613169547883959,"c":1,"w":0.049382715225219732,"y":0.70203488347108933,"t":"SUSIE:","h":0.011627907185728592},{"t":"But most pre-school children have a short sleep in the day don't they? There was","h":0.016978033580263285,"w":0.64418080647786458,"y":0.07602934037404252,"c":1,"x":0.15836948758139271},{"y":0.093023255693995055,"c":1,"h":0.013081395583944722,"t":"an experiment some students did here last term to see at what age kids should","x":0.15637859822091163,"w":0.62757202148437508},{"t":"stop having naps. But they didn't really find an answer. They spent a lot of time","w":0.62962961832682296,"h":0.014723203769140158,"c":1,"x":0.1543209932000057,"y":0.10895170804586951},{"y":0.1225833812337872,"x":0.15425010393728106,"w":0.6153728739420572,"c":1,"h":0.018497696754087189,"t":"working out the most appropriate methodology, but the results didn't seem to"},{"w":0.22427983601888021,"c":1,"h":0.013081395583944722,"y":0.13953488359540001,"t":"show any obvious patterns.","x":0.15432098721865381},{"t":"Right. Anyway, let's think about our assignment. Last time I had problems with","y":0.15400471131687055,"c":1,"x":0.15637859910581473,"h":0.016195524146054185,"w":0.62139918009440098},{"y":0.17005813940156678,"w":0.63991770426432293,"t":"the final stage, where we had to describe and justify how successful we thought","h":0.014570836043610647,"x":0.15432098315131498,"c":1},{"h":0.01453488398216074,"w":0.41358024597167964,"x":0.15432098802122809,"c":1,"t":"we'd been. I struggled a bit with the action plan too.","y":0.18604651149318585},{"c":1,"x":0.15424220383437104,"t":"I was OK with the planning, but I got marked down for the self-assessment as","w":0.62568883260091146,"h":0.017320151042601317,"y":0.19928803456886857},{"t":"well. And I had big problems with the statistical stuff, that's where I really lost","h":0.016195524146054185,"y":0.21643109529905336,"w":0.61316874186197912,"c":1,"x":0.15432097876471546},{"y":0.23209635310947463,"t":"marks.","h":0.014004967940008051,"x":0.15412462766970042,"w":0.060063501993815105,"c":1},{"h":0.014534883982160851,"w":0.049382715225219725,"y":0.24709302300407465,"x":0.15637860089219127,"c":1,"t":"Right."},{"t":"So shall we plan what we have to do for this assignment?","c":1,"x":0.15637859004529156,"w":0.45884775797526045,"y":0.28621908104677996,"h":0.014723203769140158},{"y":0.30087209285119632,"h":0.013081395583944611,"t":"OK.","w":0.030864197413126626,"x":0.15637860078760676,"c":1},{"h":0.01309851566669662,"c":1,"x":0.15843621607288544,"y":0.31684334491339838,"w":0.59670781453450528,"t":"First, we have to decide on our research question. So how about 'Is there a"},{"t":"relationship between hours of sleep and number of dreams?'","x":0.15432098943837269,"w":0.48765431722005215,"h":0.013250883392226243,"y":0.33274440525809301,"c":1},{"x":0.15637859098753504,"h":0.014534883982160851,"t":"OK. Then we need to think about who we'll do the study on. About 12 people?","w":0.6193415832519531,"c":1,"y":0.34738372079719482},{"t":"Right. And shall we use other psychology students?","y":0.36336866909709642,"w":0.41358024597167964,"h":0.014538307774052961,"c":1,"x":0.15637860119111488},{"x":0.15432099191070042,"t":"Let's use people from a different department. What about history?","h":0.014723203769140158,"c":1,"w":0.52674896240234381,"y":0.3777974085290744},{"w":0.50823043823242187,"h":0.01453488398216074,"c":1,"x":0.15637860794140224,"t":"Yes, they might have interesting dreams! Or literature students?","y":0.39389534870365173},{"w":0.18518519083658858,"t":"I don't really know any.","h":0.011627907185728592,"c":1,"x":0.15637859782587582,"y":0.40988372081497371},{"x":0.15637858816149047,"t":"OK, forget that idea. Then we have to think about our methodology. So we could","w":0.63786010742187504,"h":0.014723203769140158,"c":1,"y":0.42432273272875221},{"w":0.4156378682454428,"t":"use observation, but that doesn't seem appropriate.","y":0.44040697660855876,"c":1,"x":0.15432098349896164,"h":0.01454001966999896},{"x":0.15843621627292712,"w":0.5843621317545572,"t":"No. It needs to be self-reporting I think. And we could ask them to answer","y":0.45494186028907957,"c":1,"h":0.014534883982160629},{"y":0.47084805634653848,"h":0.014723203769140158,"x":0.15637860269715465,"t":"questions online.","w":0.13991769154866535,"c":1},{"w":0.61124852498372395,"t":"But in this case, paper might be better as they'll be doing it straight after they","h":0.017255597176343951,"x":0.15630687571472304,"y":0.48543409919546476,"c":1},{"t":"wake up... in fact while they're still half-asleep.","y":0.50145348823635971,"w":0.38065844217936196,"x":0.15432098455643853,"h":0.014534883982160851,"c":1},{"w":0.60905349731445313,"t":"Right. And we'll have to check the ethical guidelines for this sort of research.","h":0.016195524146054185,"x":0.15637859542713575,"c":1,"y":0.51442873965064095},{"x":0.15427859517677064,"c":1,"h":0.016197279850361124,"y":0.53186234374809283,"t":"Mm, because our experiment involves humans, so there are special regulations.","w":0.64205291748046867},{"t":"Yes, I had a look at those for another assignment I did. There's a whole section","x":0.15424330681678214,"c":1,"h":0.018935359689737141,"y":0.54648157359746463,"w":0.63182149251302089},{"h":0.014723203769140158,"w":0.62551442464192708,"y":0.56389870419874366,"x":0.15432097687839796,"t":"on risk assessment, and another section on making sure they aren't put under","c":1},{"t":"any unnecessary stress.","y":0.57979976454944482,"w":0.19958848317464192,"x":0.15432098465504093,"h":0.013250883392226132,"c":1},{"t":"Let's hope they don't have any bad dreams!","y":0.59287424512827769,"x":0.15419881894466414,"c":1,"w":0.35412396748860675,"h":0.016668264099229058},{"c":1,"y":0.60901162773811179,"t":"Yeah.","x":0.15432098815771494,"h":0.01453488398216074,"w":0.051440327962239574},{"h":0.011631330977620702,"t":"Then when we've collected all our data we have to analyse it and calculate the","x":0.15843622047940281,"y":0.62499999989353694,"w":0.62345677693684887,"c":1},{"t":"correlation between our two variables, that's time sleeping and number of dreams","c":1,"x":0.15432099845199257,"y":0.63953488357158372,"w":0.65020573933919268,"h":0.01598837238037687},{"y":0.65547703168031646,"w":0.38477366129557294,"h":0.014723203769140158,"c":1,"t":"and then present our results visually in a graph.","x":0.15432098818298384},{"y":0.67005813938834169,"t":"Right. And the final thing is to think about our research and evaluate it. So that","w":0.62757202148437496,"x":0.15432098503159306,"h":0.016043156420524562,"c":1},{"w":0.23280838012695312,"h":0.015800596266388189,"c":1,"y":0.68486699472888868,"t":"seems quite straightforward.","x":0.15419998019546463},{"t":"Yeah. So now let's ...","w":0.17331114451090496,"x":0.15615988646089229,"y":0.70046679705861015,"h":0.014695250103414659,"c":1},{"c":1,"x":0.8292181075994296,"y":0.10755813937645065,"h":0.013081395583944611,"w":0.037037035624186143,"t":"Q23"},{"y":0.15406976728342736,"w":0.037037035624186143,"c":1,"t":"Q24","x":0.8292181075994296,"h":0.013081395583944722},{"w":0.037037035624186143,"y":0.37790697658815753,"t":"Q25","x":0.82921810760548131,"c":1,"h":0.013081395583944833},{"x":0.8292181076508699,"h":0.013081394460653373,"y":0.48546511655964419,"w":0.037037035624186365,"c":1,"t":"Q26"},{"c":1,"h":0.011627907185728592,"y":0.51744186032642436,"w":0.037037035624186143,"x":0.82921810760548131,"t":"Q27"},{"h":0.013081395583944722,"c":1,"t":"Q28","x":0.82921810767944781,"y":0.56249999980977183,"w":0.037037035624186254},{"t":"Q29","h":0.013081395583944722,"c":1,"x":0.82921810760548131,"w":0.037037035624186143,"y":0.65552325565792502},{"x":0.82921810623792813,"y":0.66860465097208932,"w":0.039094651540120484,"t":"Q30","h":0.01598837238037687,"c":1},{"w":0.10524791081746419,"h":0.017035248422791249,"t":"PART 4","y":0.74947656164221965,"c":1,"x":0.059515961588364516},{"y":0.77906976729588662,"t":"Dancing is something that humans do when they want to have a good time. It's a universal","x":0.059670773312722837,"h":0.015988372380376759,"c":1,"w":0.72222223917643225},{"c":1,"x":0.057613171156448664,"y":0.79505300370049303,"t":"response to music, found in all cultures. But what's only been discovered recently is that","w":0.70576131184895829,"h":0.01599350806821509},{"x":0.059670782103029674,"t":"dancing not only makes us feel good, it's also extremely good for our health.","y":0.8109540635105621,"w":0.60905349731445313,"h":0.013250883392226132,"c":1},{"y":0.83421672559654125,"w":0.74074076334635419,"c":1,"x":0.059670770482503507,"t":"Dancing, like other forms of exercise, releases hormones, such as dopamine, which make us","h":0.014723203769140158},{"t":"feel relaxed and happy. And it also reduces feelings of stress or anxiety.","x":0.057613157889850865,"y":0.84883720915258543,"h":0.01453488398216074,"w":0.57407409667968745,"c":1},{"w":0.043209877014160236,"t":"107","x":0.85802469102538448,"y":0.90116279049248649,"h":0.017441860778592888,"c":1},{"h":0.030702835819886864,"y":0.95379906773146628,"x":0.71937773692400941,"w":0.25462107340494788,"t":"IELTSXpress.com","c":1}],"w":2400}