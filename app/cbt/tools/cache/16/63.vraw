"w":0.17177979787190756,"c":1},{"t":"4 The Romans called the Mediterranean Sea Mare Nostrum because they dominated","y":0.36773255799388416,"h":0.01598837238037687,"c":1,"w":0.83539093017578125,"x":0.080246921640758348},{"w":0.075313892364501964,"c":1,"h":0.015207037908870791,"t":"its use.","x":0.12493512032151723,"y":0.3862149889428752},{"x":0.082304529760818257,"t":"5 Most rowers on ships were people from the Roman army.","y":0.41279069752728115,"w":0.59053497314453129,"h":0.015988372380376759,"c":1},{"h":0.013081395583944722,"t":"63","x":0.89300411475062103,"c":1,"y":0.90552325563693892,"w":0.026748971939086985},{"w":0.25054743448893235,"c":1,"y":0.95609090412250985,"h":0.027841228759190484,"t":"IELTSXpress.com","x":0.71929884506155906}]}