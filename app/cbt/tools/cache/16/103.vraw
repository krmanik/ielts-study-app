{"h":3396,"lines":[{"t":"Test 1","c":1,"x":0.84559280793344704,"h":0.014891943465413671,"y":0.031798214287505844,"w":0.05984319051106779},{"w":0.74279836018880208,"x":0.067901231310796575,"h":0.014723203769140158,"t":"simple way of living - control what you can and accept what you can't. This is not as easy as","y":0.079799764543956653,"c":1},{"t":"it sounds and will require considerable practice - it can take a lifetime to master. The Stoics","x":0.067832657677635383,"y":0.093792455793261897,"w":0.72646753946940101,"h":0.016163896756121732,"c":1},{"t":"also believed the most important foundation for a good and happy life is not money, fame,","w":0.71193415323893239,"x":0.069958849199463866,"y":0.11042402841021548,"h":0.013250883392226132,"c":1},{"h":0.016967408367826398,"c":1,"t":"power or pleasure, but having a disciplined and principled character - something which","w":0.69356068929036463,"y":0.1244709655613877,"x":0.067824159710597534},{"y":0.14098837194869585,"w":0.34979423522949221,"h":0.01453488398216074,"c":1,"t":"seems to resonate with many people today.","x":0.065843623129876974},{"y":0.90406976719349275,"t":"103","w":0.037037035624186254,"x":0.87037037120025251,"h":0.013081395583944722,"c":1},{"c":1,"t":"IELTSXpress.com","w":0.25052792867024742,"y":0.95619871442209903,"x":0.71930827958083488,"h":0.02767260251533854}],"w":2400}