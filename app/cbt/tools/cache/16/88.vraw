{"h":3396,"lines":[{"t":"Test 4","y":0.034746760689755241,"h":0.013250883392226243,"x":0.092592592610997115,"c":1,"w":0.061728394826253252},{"h":0.016704873847736779,"t":"Questions 14-17","w":0.17943659464518225,"y":0.080806920338343691,"c":1,"x":0.092402393279623074},{"h":0.018898772968701127,"t":"Choose the correct letter, A, B, C or D.","c":1,"x":0.092592586837126026,"y":0.11773255852595099,"w":0.3703703816731771},{"w":0.57818929036458322,"t":"Write the correct letter in boxes 14-17 on your answer sheet.","h":0.016195524146054185,"y":0.15253239096702653,"c":1,"x":0.092592597513554295},{"x":0.090534971849142637,"w":0.54938273111979175,"t":"14 What is the writer's main point in the first paragraph?","c":1,"y":0.18749999983794408,"h":0.017446996466430997},{"y":0.21511627892211349,"t":"Our use of technology is having a hidden effect on us.","x":0.18518518317598232,"w":0.51234568277994796,"h":0.016038020171040723,"c":1},{"t":"Technology can be used to help youngsters to read.","y":0.23401162775991258,"w":0.49382715861002607,"x":0.18518518602246131,"h":0.01598837238037687,"c":1},{"y":0.25145348822535329,"c":1,"h":0.01598837238037687,"t":"Travellers should be encouraged to use technology on planes.","w":0.59259256998697918,"x":0.18518519637525677},{"w":0.62139918009440098,"x":0.18312757032199889,"h":0.016038020171040723,"c":1,"y":0.2688457008996189,"t":"Playing games is a more popular use of technology than reading."},{"w":0.62139918009440098,"y":0.30377906962104595,"c":1,"x":0.092592590921977233,"h":0.016008916255020877,"t":"15 What main point does Sherry Turkle make about innovation?"},{"x":0.1378600850221692,"w":0.64814814249674479,"c":1,"t":"A Technological innovation has led to a reduction in print reading.","y":0.33127208488134019,"h":0.016195524146054185},{"y":0.34883720905395788,"c":1,"h":0.013081395583944722,"x":0.13786008255485882,"w":0.018518517812093099,"t":"B"},{"w":0.67078191121419262,"h":0.016003780005537038,"x":0.18518517595924286,"c":1,"t":"We should pay attention to what might be lost when innovation occurs.","y":0.34883720915573124},{"t":"C","y":0.36773255792854265,"c":1,"h":0.013081395583944611,"x":0.13786008255485882,"w":0.018518517812093099},{"t":"We should encourage more young people to become involved in innovation.","x":0.18518517660055125,"y":0.36627906960807677,"w":0.72222223917643236,"h":0.017441860778592888,"c":1},{"h":0.013081395583944611,"c":1,"t":"D","x":0.13991769549303365,"w":0.016460905075073251,"y":0.38517441839365896},{"y":0.38368669046469428,"w":0.69753087361653665,"h":0.017476100382451065,"x":0.18312756731810348,"c":1,"t":"There is a difference between developing products and developing ideas."},{"y":0.42005813938833136,"c":1,"x":0.0925925811872753,"h":0.016043156420524562,"w":0.57407409667968745,"t":"16 What point is the writer making in the fourth paragraph?"},{"t":"Humans have an inborn ability to read and write.","w":0.46296295166015622,"x":0.18518519072938119,"c":1,"h":0.016195524146054185,"y":0.4475853948132329},{"x":0.18518517593429795,"w":0.5041152445475261,"y":0.46511627892138807,"t":"Reading can be done using many different mediums.","h":0.016038020171040834,"c":1},{"c":1,"x":0.13991769550773087,"h":0.013081395583944722,"y":0.48401162770766426,"t":"C","w":0.016460905075073223},{"t":"D","x":0.13991769549303365,"h":0.013081395583944611,"y":0.5014534881611008,"w":0.016460905075073251,"c":1},{"t":"Writing systems make unexpected demands on the brain.","c":1,"y":0.48255813937472536,"x":0.18106995937077233,"w":0.55144032796223963,"h":0.017441860778592999},{"t":"Some brain circuits adjust to whatever is required of them.","y":0.49999999985277022,"x":0.18312756341864259,"w":0.55555557250976562,"h":0.01598837238037687,"c":1},{"t":"17 According to Mark Edmundson, the attitude of college students","x":0.092592596255638523,"h":0.017667844522968212,"c":1,"y":0.53621908102107507,"w":0.64197530110677081},{"x":0.1831275773977121,"y":0.56389870418255839,"t":"has changed the way he teaches.","w":0.32510286966959634,"h":0.016043156420524562,"c":1},{"t":"B","y":0.58139534861064401,"w":0.016460905075073223,"h":0.013081395583944722,"c":1,"x":0.13991769550773087},{"y":0.59883720905395799,"t":"C","c":1,"w":0.016460905075073251,"h":0.013081395583944611,"x":0.13991769552830699},{"y":0.61627906951570255,"c":1,"h":0.014534883982160851,"x":0.13991769550773087,"w":0.016460905075073223,"t":"D"},{"c":1,"t":"has influenced what they select to read.","x":0.18518518666172393,"w":0.37860081990559902,"h":0.016195524146054185,"y":0.58127208487905746},{"c":1,"y":0.59883720915448513,"t":"does not worry him as much as it does others.","h":0.016003780005537038,"x":0.18518517722348812,"w":0.4403292338053385},{"x":0.18518519269466954,"c":1,"y":0.61627906960262857,"w":0.45061726888020831,"t":"does not match the views of the general public.","h":0.017441860778592888},{"c":1,"y":0.90697674400903194,"x":0.092592592116876302,"t":"88","h":0.013081395583944722,"w":0.026748971939086916},{"y":0.9561987124207002,"c":1,"t":"IELTSXpress.com","h":0.02906125116966074,"x":0.71922402793715989,"w":0.25061218261718743}],"w":2400}