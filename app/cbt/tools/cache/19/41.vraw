{"lines":[{"t":"Reading","x":0.82458948958848433,"y":0.041867886154351774,"h":0.022487296045354044,"c":1,"w":0.086009400685628234},{"t":"Questions 8-13","y":0.092920354089023549,"w":0.16837782541910809,"h":0.017544762152837734,"x":0.073921970145955002,"c":1},{"h":0.019895788772267942,"y":0.13017683089143128,"x":0.073857842828253792,"t":"Do the following statements agree with the information given in Reading Passage 1?","w":0.79480214436848962,"c":1},{"x":0.073921971225511765,"t":"In boxes 8-13 on your answer sheet, write","y":0.16991150439399516,"w":0.4024640655517579,"h":0.017699115044247815,"c":1},{"h":0.015988371857499684,"x":0.14579055309146408,"y":0.20348837218223437,"t":"TRUE","w":0.061601645151774076,"c":1},{"h":0.022043976460234593,"y":0.20128641021408966,"t":"if the statement agrees with the information","x":0.27910534953805655,"w":0.41304400126139329,"c":1},{"c":1,"w":0.07597536087036133,"y":0.22093023264735068,"t":"FALSE","h":0.015988371857499684,"x":0.14373716548371054},{"y":0.22238372104362591,"t":"if the statement contradicts the information","w":0.40451746622721352,"x":0.27926077396497173,"h":0.015988371857499684,"c":1},{"t":"NOT GIVEN if there is no information on this","c":1,"x":0.14373715465997813,"y":0.23982300911917753,"w":0.4353182983398437,"h":0.015990944246275229},{"w":0.75975357055664061,"y":0.2659883725876655,"h":0.018967379229610226,"c":1,"t":"8 Britain's canal network grew rapidly so that more goods could be transported","x":0.084188923038181263},{"y":0.28710650965161899,"h":0.018354111505469062,"t":"around the country.","c":1,"x":0.11886606342720375,"w":0.18738707224527995},{"y":0.31238938037102559,"t":"9 Costs in the iron industry rose when the technique of smelting iron ore with coke","h":0.020459456992360403,"c":1,"w":0.79260777791341153,"x":0.082135535982195626},{"c":1,"w":0.15400410970052086,"h":0.016050970589516766,"y":0.33569321532355823,"x":0.11909650770761694,"t":"was introduced."},{"h":0.017441860412777732,"t":"10 Samuel Morse's communication system was more reliable than that developed by","y":0.36191860467435566,"c":1,"x":0.073921978015993664,"w":0.81519505818684901},{"h":0.015931670152332211,"c":1,"y":0.38237254706835211,"t":"William Cooke and Charles Wheatstone.","w":0.38827130635579432,"x":0.11696344078243513},{"h":0.019050015249786778,"x":0.073870807086351728,"t":"11 The economic benefits of industrialisation were limited to certain sectors of society.","c":1,"w":0.82557617187499999,"y":0.40976975725008691},{"c":1,"h":0.016003807315432494,"t":"12 Some skilled weavers believed that the introduction of the new textile machines","x":0.073921983812718681,"y":0.43893805302547495,"w":0.79260777791341142},{"t":"would lead to job losses.","w":0.23819302876790366,"h":0.014545173419963642,"c":1,"x":0.11704311588485533,"y":0.45929203566199628},{"t":"13 There was some sympathy among local people for the Luddites who were arrested","y":0.48450016089753067,"w":0.82357238769531238,"h":0.019691336752742483,"x":0.073853810247047416,"c":1},{"y":0.50436046531331569,"w":0.17864476521809894,"t":"near Huddersfield.","h":0.014534883302221635,"x":0.11909650849351552,"c":1},{"w":0.12740662892659504,"h":0.016378265988510221,"x":0.72479771213170385,"c":1,"t":"→ • p. 123","y":0.92131668066382677},{"y":0.92151162805026332,"c":1,"h":0.014534883302221635,"t":"43","w":0.047227926254272412,"x":0.86242299783048948},{"t":"IELTSXpress.com","y":0.94166666659226195,"w":0.45882354736328124,"c":1,"h":0.04166666666666663,"x":0.51176469619230891}],"w":2400,"h":3390}