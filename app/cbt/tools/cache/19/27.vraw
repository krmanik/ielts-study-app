{"w":2400,"lines":[{"x":0.82937543359035171,"w":0.084575621287027891,"h":0.019777254087735119,"t":"Reading","y":0.044617186881346527,"c":1},{"c":1,"t":"Questions 37-40","y":0.094395280345098254,"x":0.078028746586455353,"w":0.17659137725830076,"h":0.014749262536873142},{"c":1,"h":0.020995290300487524,"w":0.81123235066731769,"x":0.075907049853990147,"t":"Do the following statements agree with the claims of the writer in Reading Passage 3?","y":0.129067643834607},{"y":0.1684658845415844,"w":0.41909868876139317,"h":0.019303344906607234,"c":1,"x":0.075848011848009989,"t":"In boxes 37-40 on your answer sheet, write"},{"y":0.20494186073163834,"w":0.043121150334676089,"t":"YES","x":0.14784394218379132,"h":0.013081394746943587,"c":1},{"t":"NO","x":0.14784394185741406,"y":0.22383720956239306,"w":0.032854210535685241,"c":1,"h":0.013081394746943475},{"w":0.48254618326822912,"h":0.016002092389582279,"y":0.2049418605792932,"c":1,"x":0.28336756534372171,"t":"if the statement agrees with the claims of the writer"},{"c":1,"h":0.015988371857499684,"w":0.47638605753580732,"t":"if the statement contradicts the claims of the writer","y":0.22238372104431037,"x":0.28336754607288772},{"c":1,"w":0.65741012573242186,"t":"NOT GIVEN if it is impossible to say what the writer thinks about this","y":0.23661307749148419,"x":0.14769258939431704,"h":0.024287470814752687},{"t":"37","w":0.026694043477376306,"h":0.013081394746943475,"c":1,"y":0.27616279093916041,"x":0.075975360088827243},{"w":0.74743326822916667,"c":1,"y":0.27610619479231591,"h":0.017498456341678792,"x":0.11498973127902389,"t":"Campaigns designed to correct misinformation will fail to achieve their purpose"},{"x":0.12114989606536719,"y":0.29351032453252945,"w":0.38603696187337244,"t":"if people are unable to understand them.","h":0.016224188790560423,"c":1},{"x":0.07392197078129413,"h":0.017529327257544636,"c":1,"y":0.32848837211682913,"t":"38 Attempts to teach elementary school students about misinformation have been","w":0.788501027