0087209302063888661,"c":1,"x":0.073921971022167382,"w":0.045174538294474292,"t":"LEON:"},{"h":0.0087209302063888661,"x":0.075975358345972757,"w":0.071868584950764966,"t":"SHANNON:","y":0.42151162790684782,"c":1},{"c":1,"t":"LEON:","y":0.43604651137982553,"x":0.073921973167750496,"w":0.045174535115559883,"h":0.010174418761666804},{"w":0.071868584950764966,"x":0.075975358345972757,"t":"SHANNON:","h":0.0087209302063888661,"c":1,"y":0.46802325581382465},{"h":0.010174418761666915,"y":0.48255813928680225,"x":0.073921973167750496,"c":1,"w":0.045174535115559883,"t":"LEON:"},{"y":0.51453488372080136,"x":0.075975358345972757,"c":1,"t":"SHANNON:","w":0.071868584950764966,"h":0.0087209302063888661},{"h":0.010174418761666915,"x":0.073921970963308756,"c":1,"t":"LEON:","y":0.5508720929129528,"w":0.043121150334676103},{"w":0.072346928914388015,"c":1,"h":0.010410399985524399,"x":0.075754418476742302,"y":0.58166452477785069,"t":"SHANNON:"},{"w":0.045174538294474292,"c":1,"t":"LEON:","y":0.5973837209160644,"x":0.073921971022167382,"h":0.008720930206388755},{"c":1,"w":0.073921972910563155,"h":0.010174418761666915,"y":0.61337209292978567,"x":0.073921970314859753,"t":"SHANNON:"},{"t":"LEON:","x":0.073921971407177628,"h":0.010174418761666804,"w":0.045174538294474306,"c":1,"y":0.62790697653849792},{"w":0.071868584950764966,"h":0.008720930206388755,"t":"SHANNON:","c":1,"y":0.64389534883746913,"x":0.073921970258643346},{"x":0.073921970936358036,"w":0.043121150334676103,"h":0.008720930206388755,"t":"LEON:","y":0.65988372092151493,"c":1},{"y":0.67386092776575446,"t":"SHANNON:","w":0.072167065938313804,"c":1,"h":0.011289772101208184,"x":0.075826118592448657},{"t":"LEON:","y":0.69040697673001772,"w":0.045174538294474292,"x":0.073921971022167382,"h":0.0087209302063888661,"c":1},{"h":0.008720930206388755,"w":0.07186858495076498,"x":0.075975358342953075,"y":0.70639534883746913,"t":"SHANNON:","c":1},{"x":0.073646858070899573,"h":0.0096044433503728044,"c":1,"t":"LEON:","y":0.7213856292012456,"w":0.045753087997436534},{"c":1,"t":"SHANNON:","y":0.73691860465142245,"x":0.073921970258643346,"h":0.0087209302063888661,"w":0.071868584950764966},{"h":0.0094740470953746936,"t":"LEON:","c":1,"w":0.045820058186848964,"x":0.07367355241080048,"y":0.76795994895456743},{"t":"SHANNON:","x":0.073900806170527217,"h":0.011763489984833009,"c":1,"y":0.78190895248996228,"w":0.073964303334554032},{"c":1,"x":0.073921970931224573,"w":0.043121150334676103,"h":0.008720930206388755,"t":"LEON:","y":0.79941860464348335},{"x":0.073921974269834004,"t":"SHANNON:","y":0.82848837234021366,"w":0.073921966552734378,"h":0.011627906191665538,"c":1},{"x":0.073921970931224573,"h":0.0087209302063888661,"w":0.043121150334676103,"c":1,"t":"LEON:","y":0.84593023255046007},{"x":0.075893006136262209,"w":0.072033290863037114,"h":0.012149088361621985,"c":1,"y":0.85875103707385547,"t":"SHANNON:"},{"w":0.043121150334676103,"c":1,"t":"LEON:","h":0.0087209302063888661,"y":0.87645348836337533,"x":0.073921970926091096},{"h":0.013081394746943587,"t":"SHANNON:","c":1,"x":0.073921970916381669,"y":0.90552325598408634,"w":0.073921972910563155},{"w":0.35318275451660164,"c":1,"h":0.014749262536873142,"t":"Well, there's a really good fish market there.","x":0.17043120989735674,"y":0.094395280349030886},{"h":0.013274336283185861,"c":1,"t":"Oh great - where is it exactly?","y":0.11032448365241088,"w":0.24229980468750004,"x":0.17248459447349848},{"x":0.17043120173553747,"y":0.12500000011366219,"c":1,"w":0.69609858194986973,"t":"It's at the far end of Kite Place, so you have to go over the bridge and then it's on Q2","h":0.016002949852507387},{"c":1,"t":"the right.","x":0.17040164390624238,"y":0.14091478165842009,"w":0.071927719116210931,"h":0.014682064225188474},{"c":1,"t":"OK - is it open all day?","y":0.15693215359441726,"w":0.18685831705729167,"x":0.17043121097968184,"h":0.013125986194891914},{"w":0.63449691772460937,"x":0.17043121251122897,"y":0.17138643055278924,"h":0.016224188790560534,"c":1,"t":"It doesn't close until four, but I'd recommend going earlier than that - it does run"},{"c":1,"t":"out of some things.","x":0.17227230633089546,"y":0.18620080319631815,"w":0.15448933919270835,"h":0.014686049402287571},{"h":0.014534883302221635,"t":"Oh, I don't want that to happen.","c":1,"y":0.20203488387438118,"x":0.17248460039953045,"w":0.25256673177083333},{"t":"As long as you get there by 3.30, you should be fine. It's only 11 now, so plenty","x":0.17043121672361602,"y":0.2165191741242215,"h":0.017492453538562658,"c":1,"w":0.62628336588541667},{"w":0.028747431437174398,"h":0.014534883302221635,"c":1,"y":0.21802325584162174,"t":"Q3","x":0.83778234187894862},{"x":0.17212196875871461,"c":1,"t":"of time.","y":0.23457893925377449,"h":0.011519275091390724,"w":0.062689266204833977},{"h":0.013309835473344744,"x":0.17037115691257382,"c":1,"t":"Right.","y":0.24988577990754002,"w":0.049401423136393258},{"y":0.26447028796074878,"t":"Do you need to buy vegetables too?","x":0.17032474932523001,"w":0.28978085835774742,"c":1,"h":0.015600555554955431},{"x":0.16632444883252315,"w":0.54825459798177079,"c":1,"y":0.27905604743029566,"h":0.016002091826942566,"t":"I do, and I want to avoid all the plastic packaging in the supermarket!"},{"w":0.6057494608561198,"h":0.016061260707258773,"c":1,"x":0.17043122440451783,"t":"Well, there's a really nice organic shop there. Now what's it called... it's the","y":0.29498525079497129},{"y":0.31091445400671081,"c":1,"t":"name of a flower. I know, it's 'Rose'.","x":0.17043120782833546,"w":0.28747433980305992,"h":0.016224188790560534},{"t":"Q4","y":0.31250000024644098,"w":0.028747431437174509,"h":0.013081394746943587,"x":0.83778234169072141,"c":1},{"t":"That's a nice name.","x":0.17248459800211374,"y":0.32703488353664945,"w":0.15605749766031901,"h":0.011627907316944963,"c":1},{"x":0.17043121238799472,"t":"Yeah - it sells vegetables and quite a lot of other stuff.","w":0.43121149698893224,"h":0.014534883302221635,"y":0.34156976764770386,"c":1},{"x":0.17026619252174674,"w":0.14617506663004559,"h":0.012939261827497051,"y":0.35737101844411923,"t":"And where's that?","c":1},{"x":0.17043121249259807,"w":0.63449691772460937,"h":0.014749262536873253,"c":1,"y":0.37345132726116836,"t":"Well, as you reach the market, you'll see a big grey building on your left - I think"},{"y":0.38649154046179934,"x":0.17034401798295684,"w":0.63877365112304685,"c":1,"t":"it used to be a warehouse. Anyway, now it's a restaurant upstairs, but the ground","h":0.016729322225294996},{"t":"floor has two shops either side of the entrance and it's the one on the left.","w":0.58110880533854159,"x":0.17043122351069126,"y":0.40406976726967625,"h":0.011627907316944963,"c":1},{"c":1,"y":0.42005813973467565,"w":0.16427104949951171,"t":"That's easy enough.","x":0.17043121025510743,"h":0.014534883302221635},{"y":0.43334728961913693,"w":0.58948410034179699,"t":"You can't miss it - there's also a big sign on the pavement so you can look","x":0.17238945328106997,"h":0.01578037183193326,"c":1},{"t":"Q5","w":0.028747431437174509,"x":0.83778234167360999,"h":0.013081394746943587,"y":0.43604651187434795,"c":1},{"t":"for that.","x":0.16805885258654277,"w":0.066422189076741522,"h":0.012269667678878049,"c":1,"y":0.4510162435409093},{"c":1,"t":"Fine! I guess if I need anything else, I'll have to go to the supermarket.","y":0.46656976764851321,"w":0.55852157592773433,"x":0.17043120371876597,"h":0.014551176223079665},{"t":"Yeah - you should be able to get everything you need, but there's a minibus that","x":0.17248460699193496,"c":1,"w":0.6365502929687501,"h":0.014534883302221635,"y":0.48110465136945335},{"t":"goes to the supermarket if you need it. It's purple and the number is 289.","h":0.013124271269041476,"c":1,"w":0.57700205485026035,"y":0.49705014759366883,"x":0.17043121071826467},{"c":1,"t":"Q6","x":0.83778234168294341,"y":0.49709302349729989,"w":0.028747431437174398,"h":0.013081394746943587},{"t":"Thanks, that's great.","w":0.16427104949951174,"h":0.016224188790560423,"c":1,"y":0.51150442454000744,"x":0.17043121019974752},{"t":"So what do you need to get at the fish market? The salmon is always very good","c":1,"x":0.17248460674494634,"y":0.54941860438732548,"w":0.62833674112955729,"h":0.013118269028565166},{"y":0.56540697647038074,"t":"and the shellfish.","c":1,"x":0.16837782133489015,"w":0.13757700602213541,"h":0.013081395872223012},{"t":"I'm going to make a curry, I think, and I need about 12 prawns for that.","h":0.013082253335148231,"c":1,"w":0.5564681498209636,"y":0.5799410027380576,"x":0.16837783463815592},{"w":0.22587270100911458,"t":"They'Il have plenty of those.","y":0.59587020650832678,"h":0.01327433628318575,"x":0.17043120583616353,"c":1},{"h":0.013081394746943587,"c":1,"y":0.61046511652970348,"w":0.032854210535685213,"t":"OK.","x":0.17043121084335625},{"w":0.24845995585123695,"c":1,"h":0.014549461297229338,"x":0.16837782484645544,"t":"Have you ever tried samphire?","y":0.62645348857534033},{"x":0.17043120947873808,"w":0.13963039398193361,"y":0.64244186037901563,"h":0.010174418761666915,"t":"No - what's that?","c":1},{"w":0.63860371907552094,"c":1,"x":0.16837781183407269,"y":0.65693215341549438,"t":"It's a type of seaweed. I just ask for a handful and you fry it in butter. It's delicious!","h":0.016032962742808188},{"t":"Oh, I might try that - how do you spell it?","h":0.014749262536873142,"x":0.17043121541727166,"y":0.67286135671817004,"w":0.32648869832356775,"c":1},{"y":0.68895348857236316,"w":0.17248460133870444,"c":1,"t":"It's S-A-M-P-H-I-R-E.","x":0.16837782242869706,"h":0.014586334453571492},{"h":0.014534883302221635,"t":"Great - it's always good to try something different.","x":0.17043121775597675,"y":0.70348837229820083,"w":0.40041066487630211,"c":1},{"w":0.051334702173868818,"y":0.71947674435906361,"t":"Yeah.","c":1,"x":0.16837782333298348,"h":0.014534883302221635},{"c":1,"w":0.64271046956380207,"t":"Ill see what beans they have in the organic shop and I think I'll get something for","x":0.16837782466099119,"y":0.73539822987675851,"h":0.014601769911504414},{"t":"dessert there.","c":1,"y":0.75030330695760372,"x":0.17218615672726695,"w":0.11150923411051433,"h":0.012929429135843051},{"y":0.76440276984696021,"w":0.17298739115397133,"c":1,"x":0.17021790835437794,"t":"How about a mango?","h":0.017497747415638254},{"y":0.78052325588964067,"t":"I'm not sure - they're not always ripe. I'd prefer a melon - it's bigger too.","x":0.16837782360156381,"c":1,"h":0.015988371857499684,"w":0.57700205485026035},{"t":"Good idea. The owner also sells a lot of spices there that you can put in a curry,","x":0.17032185016737592,"y":0.79500981883461341,"w":0.63063618977864588,"h":0.017538628817307944,"c":1},{"y":0.81238938026110463,"c":1,"t":"and things like coconut.","x":0.16837782303029314,"w":0.19096509297688802,"h":0.013274336283185861},{"y":0.82703488382831014,"x":0.17043121454329713,"h":0.016032962742808299,"t":"Oh, that's very helpful. I'Il have a look.","c":1,"w":0.30184804280598954},{"x":0.17027908442210504,"y":0.84247578393028311,"c":1,"t":"No problem.","w":0.1009202702840169,"h":0.015629826886112363},{"w":0.61396306355794272,"h":0.014549461297229338,"c":1,"t":"I know bread doesn't really go with curry but I always like to have some in case.","y":0.858997050118671,"x":0.16632442293520303},{"c":1,"x":0.16837781821875258,"y":0.87345132726066665,"w":0.64065709431966145,"h":0.014749262536873253,"t":"As I said - all the bread is home-made and there's lots of variety. I like the brown"},{"t":"bread myself.","x":0.16837782047300034,"y":0.88953488391630864,"w":0.11088296254475913,"h":0.014594909645463172,"c":1},{"c":1,"x":0.16632443356207324,"h":0.013081395872223012,"w":0.14784394582112628,"t":"Mm, sounds good","y":0.90552325554278135},{"y":0.62645348861853412,"w":0.026694043477376361,"c":1,"h":0.013081394746943475,"t":"Q7","x":0.83778234161689014},{"w":0.02669404347737625,"h":0.013081394746943475,"t":"Q8","c":1,"x":0.83983572969868348,"y":0.78197674442753251},{"y":0.81395348862272687,"h":0.013081394746943587,"x":0.83983572969868348,"w":0.02669404347737625,"t":"Q9","c":1},{"y":0.92441860491577232,"w":0.036960986455281564,"h":0.013081394746943587,"x":0.87063654979083971,"c":1,"t":"109"},{"w":0.45294118245442705,"h":0.04166666666666663,"t":"IELTSXpress.com","x":0.51176470218665204,"y":0.94166666659226195,"c":1}]}