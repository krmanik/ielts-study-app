{"lines":[{"h":0.014550318760154557,"x":0.094455850832737193,"y":0.046511628090375901,"c":1,"w":0.061601645151774104,"t":"Test 4"},{"h":0.014749262536873142,"t":"Questions 27-30","y":0.094395280345200061,"w":0.17659137725830076,"x":0.094455851310455849,"c":1},{"c":1,"w":0.36755645751953125,"t":"Choose the correct letter, A, B, C or D.","y":0.13215339256089509,"h":0.017699115044247815,"x":0.094455857378094574},{"h":0.017509603922346018,"c":1,"w":0.57494867960611973,"t":"Write the correct letter in boxes 27-30 on your answer sheet.","x":0.09445584489882819,"y":0.16715116281371856},{"h":0.015988371857499684,"c":1,"w":0.48459960937499996,"t":"27 What is the writer doing in the first paragraph?","y":0.20203488383490331,"x":0.092402453948894514},{"c":1,"h":0.016071550825000891,"x":0.18480493079915883,"w":0.48870635986328126,"y":0.22965116290270826,"t":"setting out two opposing views about human nature"},{"y":0.24854651181984222,"t":"B","x":0.13963039056327134,"h":0.013081394746943475,"c":1,"w":0.016427103678385402},{"y":0.26598837228495842,"h":0.013081394746943587,"c":1,"t":"C","x":0.13963039056327134,"w":0.016427103678385402},{"w":0.016427103678385402,"t":"D","x":0.13963039056327134,"y":0.28343023275007473,"h":0.013081394746943587,"c":1},{"h":0.020378744074728616,"x":0.18267514023617243,"y":0.24564563880491219,"c":1,"w":0.50941823323567714,"t":"justifying his opinion about our tendency to be greedy"},{"x":0.18463615478864806,"h":0.022860765035173536,"y":0.26272294989904998,"c":1,"w":0.56918004353841145,"t":"describing a commonly held belief about people's behaviour"},{"h":0.017454722919295285,"w":0.57700205485026046,"c":1,"t":"explaining why he thinks that humans act in a selfish manner","y":0.28343023258028999,"x":0.18480492729009237},{"y":0.31624717483381093,"c":1,"t":"28 What point is made about Richard Dawkins' book The Selfish Gene?","h":0.018343746556644946,"w":0.69622390747070317,"x":0.092335339260409058},{"c":1,"x":0.18480492287768868,"h":0.01749159607563755,"y":0.34593023257592326,"w":0.43737167358398432,"t":"Its appeal lay in the radical nature of its ideas."},{"c":1,"y":0.36482558158728406,"x":0.13963039056327134,"w":0.016427103678385402,"t":"B","h":0.013081394746943475},{"t":"C","x":0.13963039056327134,"y":0.38226744205240037,"h":0.013081394746943475,"c":1,"w":0.016427103678385402},{"t":"D","y":0.39970930251751657,"w":0.016427103678385402,"c":1,"x":0.13963039056327134,"h":0.013081394746943587},{"w":0.51334701538085947,"h":0.01600037746373173,"c":1,"t":"Its success was due to the scientific support it offered.","x":0.18480493163069506,"y":0.36482558150984779},{"x":0.18275153998420174,"w":0.60164271036783856,"h":0.015988371857499684,"y":0.38226744197528784,"c":1,"t":"It presented a view that was in line with the attitudes of its time."},{"t":"It took an innovative approach to the analysis of human psychology.","x":0.18480492946008875,"y":0.39970501456104968,"w":0.64271046956380207,"h":0.01599265973476538,"c":1},{"h":0.017521609528578064,"x":0.092402457687080358,"c":1,"w":0.79466120402018225,"y":0.43451327415832608,"t":"29 What does the writer suggest about the prehistoric era in the fourth paragraph?"},{"x":0.18468365596569877,"w":0.53827036539713535,"c":1,"h":0.020043031585603277,"t":"Societies were more complex than many people believe.","y":0.45967124697277506},{"y":0.48110465135472591,"t":"B","w":0.016427103678385402,"x":0.13963039056327134,"c":1,"h":0.013081394746943475},{"t":"C","x":0.13963039056327134,"y":0.49854651181984222,"w":0.016427103678385402,"h":0.013081394746943587,"c":1},{"t":"D","h":0.013081394746943475,"c":1,"y":0.51598837226315619,"w":0.01642710367838543,"x":0.13963039058380525},{"w":0.59548253377278648,"h":0.015988371857499795,"c":1,"t":"Supplies of natural resources were probably relatively plentiful.","y":0.48110465127775726,"x":0.18480493424225225},{"y":0.49852507348186315,"w":0.62012318929036458,"x":0.18480493502344331,"t":"Most estimates about population sizes are likely to be inaccurate.","h":0.016009810118548629,"c":1},{"w":0.65503082275390634,"c":1,"y":0.51592920379675034,"t":"Humans moved across continents more than was previously thought.","x":0.18480491712979624,"h":0.017501028730454338},{"x":0.092402464811619872,"h":0.013081394746943587,"t":"30","w":0.026694043477376306,"y":0.55232558163683476,"c":1},{"y":0.55063805468955906,"h":0.018873412770859299,"x":0.12931746606079023,"t":"The writer refers to Bruce Knaufl's work as support for the idea that","w":0.64693740844726566,"c":1},{"c":1,"x":0.18474253129435311,"h":0.018623325606714647,"y":0.57832205003378068,"t":"selfishness is a relatively recent development in human societies.","w":0.62023686726888017},{"t":"B","w":0.016427103678385402,"h":0.013081394746943587,"c":1,"x":0.13963039056327134,"y":0.59738372112216775},{"x":0.13963038975387571,"w":0.016427105267842607,"t":"C","y":0.61482558160285705,"h":0.013081394746943587,"c":1},{"t":"D","x":0.13963039056327134,"y":0.63226744205240026,"h":0.013081394746943587,"c":1,"w":0.016427103678385402},{"w":0.64271046956380218,"c":1,"x":0.18480492937423548,"y":0.59734513296272707,"t":"only people in isolated communities can live in an unselfish manner.","h":0.016026959939692165},{"h":0.016064690558959649,"c":1,"y":0.61474926280864517,"w":0.64271046956380207,"t":"very few lifestyles have survived unchanged since prehistoric times.","x":0.18480492938609075},{"y":0.63215339255206437,"x":0.18480493992152711,"w":0.56468170166015619,"t":"hunter-gatherer cultures worldwide are declining in number.","c":1,"h":0.017699115044247815},{"y":0.92005813977636952,"w":0.026694043477376306,"c":1,"h":0.013081394746943587,"t":"94","x":0.092402464811619872},{"c":1,"t":"IELTSXpress.com","x":0.51817868965084268,"y":0.93898664284759048,"w":0.45188151041666658,"h":0.047816471786274017}],"w":2400,"h":3390}