{"lines":[{"c":1,"w":0.30595481872558594,"t":"@MirsIELTS","x":0.0061601675395455873,"y":0.0058139530576382104,"h":0.03343023339555673},{"t":"Audioscripts","h":0.01725267505927075,"y":0.044425988035212138,"w":0.12147015889485677,"c":1,"x":0.090188945081020128},{"h":0.018835221349665532,"x":0.41250820245552516,"y":0.089419598328990157,"w":0.10516839981079101,"c":1,"t":"TEST 4"},{"w":0.10280456542968749,"t":"PART 1","x":0.092334884347427149,"h":0.016429041409562806,"c":1,"y":0.15094245587634891},{"h":0.010634191057323328,"t":"KAEDEN:","x":0.092325746828557598,"y":0.18145616012181376,"w":0.059701690673828134,"c":1},{"y":0.18023255815715422,"c":1,"t":"Hello Charlotte. I'm Kaeden, one of the supervisors. Welcome to the team.","x":0.18685832230312238,"w":0.59548253377278648,"h":0.017441860412777732},{"x":0.092402463186410225,"h":0.011799410029498469,"w":0.17043121337890627,"c":1,"y":0.19616519157005485,"t":"CHARLOTTE: Hi Aiden."},{"h":0.0087209302063888661,"c":1,"x":0.092402462677112662,"t":"KAEDEN:","y":0.21366279069572292,"w":0.059548257191975901},{"t":"It's Kaeden.","y":0.21169140969887001,"w":0.10108002344767253,"c":1,"x":0.18463202090773584,"h":0.012893414567705541},{"h":0.013081394746943587,"y":0.22674418618394099,"x":0.09240246389510659,"w":0.19301848093668622,"c":1,"t":"CHARLOTTE: I'm SO sorry."},{"y":0.24472214716476803,"h":0.010446212003364708,"c":1,"x":0.088085455481994895,"w":0.064160423278808609,"t":"KAEDEN:"},{"h":0.015988371857499684,"x":0.18685831051098414,"w":0.62422999064127604,"t":"Don't worry. People often get my name wrong; they never know how to spell it.","y":0.24273255825409901,"c":1},{"c":1,"t":"It's K-A-E-D-E-N, in case you ever need to write it.","y":0.25870206512853267,"x":0.18685831619636861,"w":0.40246406555175784,"h":0.014553748611855322},{"w":0.26899383544921873,"x":0.090349078099750763,"t":"CHARLOTTE: IIl try and remember.","h":0.013274336283185972,"c":1,"y":0.27463126842860164},{"h":0.010579008479385643,"y":0.29049537946094506,"x":0.090283649407383093,"c":1,"w":0.061732495625813788,"t":"KAEDEN:"},{"y":0.28775572265117322,"x":0.18678447246774027,"c":1,"t":"So, there are a few practical things you need to sort out this morning. Then I'll","w":0.61820810953776051,"h":0.017721927834119744},{"h":0.014823074115764445,"x":0.18880061619268285,"c":1,"t":"show you what you're going to do today.","y":0.30357162414343786,"w":0.32058474222819011},{"w":0.084258613586425793,"c":1,"h":0.010467502290168684,"x":0.092367613024461739,"y":0.32107438837743008,"t":"CHARLOTTE:"},{"w":0.55441477457682287,"c":1,"t":"The email I received said to go to the front desk, to show my letter of","y":0.31976401156002454,"x":0.18069815672948381,"h":0.01599180227184005},{"c":1,"w":0.28980138142903644,"h":0.01603423768440182,"y":0.33441785717751049,"x":0.18672807921893508,"t":"appointment and pick up my badge."},{"y":0.35310559673972097,"x":0.090323325448947542,"w":0.061653143564860027,"h":0.0089050855608465707,"c":1,"t":"KAEDEN:"},{"h":0.013486720397409058,"x":0.18884541303189953,"y":0.35026174449595082,"w":0.5956049601236979,"t":"You'll need that for the staffroom and other areas of the supermarket where","c":1},{"x":0.18891170408694799,"t":"shoppers aren't allowed.","w":0.19712525685628254,"h":0.013081395872222901,"y":0.36627906949583888,"c":1},{"x":0.18685831720549365,"w":0.63449691772460937,"h":0.014534883302221635,"y":0.38226744206723318,"t":"So, after you've finished at the front desk, I'll take you to the staffroom. Put your","c":1},{"x":0.18891170373986332,"w":0.58521560668945316,"h":0.013107120885258228,"c":1,"y":0.39823008867620535,"t":"coat and rucksack in one of the lockers there. Take whichever one is free."},{"y":0.41424418595559598,"x":0.092402463460418055,"w":0.084188912709554031,"c":1,"t":"CHARLOTTE:","h":0.010174418761666915},{"t":"KAEDEN:","w":0.061601645151774076,"x":0.090349074652039035,"y":0.43023255813808459,"h":0.0087209302063888661,"c":1},{"c":1,"y":0.4126843658114856,"w":0.14784394582112631,"t":"Will I have a key?","x":0.18275153828486584,"h":0.013274336283185861},{"y":0.42717965251917556,"w":0.59357711791992185,"t":"Yes. Try not to lose it. At the end of the day, leave it in the door for the next","x":0.18677817572636429,"h":0.016912674130239891,"c":1},{"t":"person to use.","w":0.11753805796305336,"x":0.18867485932728126,"h":0.012688608085159703,"y":0.44384591168167886,"c":1},{"t":"CHARLOTTE: Will do.","x":0.090349074797017953,"w":0.16016427357991539,"h":0.01163819743468697,"c":1,"y":0.45929203526586737},{"c":1,"t":"KAEDEN:","y":0.47653607208564785,"w":0.061716543833414725,"x":0.090291625311027204,"h":0.0091371581266060931},{"t":"You also need to go to the HR department to see Tiffany. She's really helpful.","x":0.18685832283103687,"c":1,"w":0.61190963745117188,"h":0.016224188790560534,"y":0.47374631272027479},{"t":"CHARLOTTE: I was told to bring my passport with me. HR need to take a note of the number in it.","h":0.013124271269041587,"c":1,"w":0.74127309163411459,"y":0.48982558112964325,"x":0.09034908029939373},{"c":1,"t":"KAEDEN:","x":0.090272120350693874,"y":0.50557517964138343,"w":0.061755555470784512,"h":0.010651965971189892},{"t":"That's right. Or you can show your ID card.","w":0.3429158020019531,"h":0.013081395872223012,"c":1,"y":0.50581395322264167,"x":0.18891170875071556},{"t":"CHARLOTTE.","c":1,"x":0.092402463457851317,"y":0.52325581395567189,"w":0.084188912709554045,"h":0.008720930206388755},{"y":0.51917255460167877,"t":"I don't have one of those.","c":1,"x":0.17843326017667219,"w":0.21409317016601562,"h":0.014380024035068439},{"t":"KAEDEN:","h":0.0088369673332282517,"c":1,"w":0.061634222666422531,"y":0.5377326791092476,"x":0.090332785891118303},{"w":0.63053532918294275,"t":"OK. Tiffany will give you a uniform. They have lots in different sizes, so you just","y":0.53489044761992832,"h":0.017768373742567789,"x":0.18677518197048887,"c":1},{"h":0.01327433628318575,"c":1,"y":0.55221238927348404,"w":0.60164271036783856,"t":"tell her what you need. I won't come with you to HR - I've got to go and sort","x":0.18685831616499296},{"w":0.38398356119791677,"c":1,"h":0.013081395872223012,"x":0.18685832204031494,"t":"something else out. Problem with a bread slicer.","y":0.56686046484747676},{"x":0.090349075323761102,"w":0.38193018595377604,"y":0.58284883712738023,"h":0.010174418761666915,"t":"CHARLOTTE: Is the HR office near the staffroom?","c":1},{"w":0.061745217641194658,"c":1,"x":0.090277288407600478,"y":0.59857558548879053,"t":"KAEDEN:","h":0.0092441778267379204},{"t":"The staffroom's on the first floor, and HR are a couple of floors above that, on the","h":0.01457347194705394,"x":0.18891169910272423,"y":0.59734513249146615,"w":0.64065709431966145,"c":1},{"y":0.61177516616003569,"w":0.41496983846028646,"c":1,"t":"third floor. There's a staircase outside the staffroom.","x":0.18677239731415662,"h":0.014714153818676245},{"h":0.011627907316944963,"t":"CHARLOTTE: OK.","x":0.090349073972616628,"y":0.62790697652563598,"w":0.12731006622314453,"c":1},{"w":0.061754004160563161,"y":0.64507066672434277,"t":"KAEDEN:","c":1,"x":0.090272895147933921,"h":0.0092772711694768528},{"c":1,"w":0.61396306355794272,"t":"When you've finished with HR, come and find me in the bakery section of the","x":0.18480491568637764,"y":0.64389534895042899,"h":0.015988371857499684},{"t":"shop.","c":1,"y":0.65893186089815003,"x":0.18399629487826477,"w":0.053097343444824169,"h":0.014895076245333261},{"y":0.67587209277517424,"w":0.086242294311523443,"c":1,"x":0.090349079880514771,"t":"CHARLOTTE:","h":0.010174418761666915},{"y":0.67433628334612028,"t":"I'm looking forward to getting started.","x":0.17864476703295595,"c":1,"h":0.014749262536873142,"w":0.30595481872558594},{"t":"KAEDEN:","x":0.090302656140771181,"y":0.69169308570634602,"w":0.061694482167561848,"h":0.0090556890211976881,"c":1},{"y":0.69026548665753773,"c":1,"t":"Ill just give you my phone number, in case you can't find me. Have you got your","x":0.18891169885496822,"w":0.63244354248046886,"h":0.013274336283185861},{"y":0.70538549076727364,"x":0.18667079860353061,"h":0.012194133297180332,"t":"phone there?","c":1,"w":0.10920459747314451},{"x":0.090349071036754228,"y":0.72093023228158137,"c":1,"t":"CHARLOTTE: Yes... OK, ready.","w":0.24640658060709636,"h":0.013081395872223012},{"w":0.063678061167399089,"h":0.0088055467183610903,"c":1,"t":"KAEDEN:","y":0.73832978476518174,"x":0.088284172599092062},{"c":1,"x":0.18464638591655966,"y":0.73422326630689527,"w":0.39668492635091146,"h":0.01732765130237135,"t":"It's oh-four-one-two double-six-five nine-oh-three."},{"t":"CHARLOTTE:","x":0.090349076359369035,"y":0.75290697653849792,"w":0.086242300669352207,"h":0.010174418761666804,"c":1},{"c":1,"x":0.17451360500623025,"h":0.013262869685800371,"w":0.096558005015055348,"t":"OK, done.","y":0.75136275114360662},{"y":0.79069767441715444,"w":0.061601645151774076,"c":1,"h":0.008720930206388755,"t":"KAEDEN:","x":0.090349074652039035},{"w":0.62217656453450521,"h":0.014569184069788133,"t":"So, Charlotte, your tasks today are in the bakery section, on the sushi counter,","c":1,"x":0.18685832817080344,"y":0.787790697849166},{"y":0.80305249297815351,"h":0.015712434211663462,"x":0.1867926617072076,"w":0.62437535603841154,"t":"and on the meat and fish counters. The first job is to check sell-by dates on the","c":1},{"y":0.81976401165242541,"w":0.60780288696289064,"h":0.014538313716562001,"x":0.18685830998515693,"c":1,"t":"bread and cakes. If any of the dates are today's, put a new price label on the"},{"w":0.09240246454874676,"h":0.013081394746943587,"t":"packaging.","x":0.18480492778256144,"y":0.83575581422470469,"c":1},{"y":0.85174418604968605,"h":0.0087209302063888661,"x":0.090349075565895332,"w":0.090349076588948557,"c":1,"t":"CHARLOTTE:"},{"y":0.84864914834887095,"c":1,"t":"What if any of the labels are yesterday's dates, or older? Do I throw those","h":0.018738129427299355,"w":0.5936763000488281,"x":0.17646313198469576},{"y":0.86627906949266753,"w":0.10472279230753584,"h":0.013081395872223012,"c":1,"t":"items away?","x":0.18480492817682753},{"c":1,"w":0.028747431437174398,"t":"Q1","x":0.85626283463048902,"y":0.21075581401749388,"h":0.014534883302221635},{"t":"Q2","y":0.39825581419992939,"h":0.013081394746943587,"x":0.85626283443003193,"w":0.026694043477376361,"c":1},{"x":0.85626283443003193,"w":0.026694043477376361,"y":0.48982558117679886,"h":0.011627907316944963,"c":1,"t":"Q3"},{"t":"Q4","w":0.02669404347737625,"c":1,"h":0.013081394746943475,"x":0.8562628344214761,"y":0.54069767466009067},{"h":0.013081394746943587,"x":0.8562628344214761,"t":"Q5","w":0.02669404347737625,"c":1,"y":0.61337209326474185},{"w":0.028747434616088863,"c":1,"t":"Q6","x":0.85420944481484296,"y":0.73837209280843275,"h":0.011627907316944963},{"w":0.039014374415079753,"x":0.088295687679523768,"c":1,"t":"114","y":0.91715116285470322,"h":0.014534883302221524},{"w":0.45294118245442705,"x":0.51176470218665204,"y":0.94166666659970233,"c":1,"h":0.037500000000000089,"t":"IELTSXpress.com"}],"w":2400,"h":3390}