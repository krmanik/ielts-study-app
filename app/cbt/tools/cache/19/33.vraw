.016224188790560423,"c":1,"y":0.55368731571248719},{"x":0.16414303608848418,"c":1,"y":0.57050216482924843,"w":0.24870994567871096,"t":"eight and a half minutes.","h":0.018447704934089204},{"h":0.020270359410648808,"c":1,"w":0.5833486938476562,"x":0.084113119845808576,"y":0.5968133654647727,"t":"15 As a 'helmsman', David has the responsibility of deciding"},{"h":0.014549461297229338,"c":1,"x":0.17659138050072737,"y":0.62645348857572503,"t":"who will be the members of his crew.","w":0.3511293538411458},{"t":"B","y":0.64534883737943527,"x":0.13141683747242192,"w":0.01848049322764081,"c":1,"h":0.013081394746943475},{"w":0.41906588236490888,"t":"what equipment it will be necessary to take.","h":0.019004133106332977,"c":1,"y":0.64371911308593899,"x":0.17240220320262561},{"w":0.36550308227539063,"h":0.015988371857499573,"y":0.66133720928685102,"c":1,"x":0.13347022747969001,"t":"C if the lifeboat should be launched."},{"c":1,"y":0.68876123305961701,"h":0.019064412074806358,"t":"16 As well as going out on the lifeboat, David","x":0.0861445939597833,"w":0.44170486450195318},{"w":0.31211499532063802,"y":0.71799410049804502,"x":0.13141683486890543,"h":0.016017527284875377,"t":"A gives talks on safety at sea.","c":1},{"h":0.01605525790414275,"c":1,"t":"B helps with fundraising.","x":0.13347023599678054,"y":0.73539823015033368,"w":0.2587268829345703},{"t":"recruits new volunteers.","x":0.16208352300167234,"w":0.24467681884765624,"y":0.7530444736211197,"h":0.015919429925339124,"c":1},{"y":0.91715116285135811,"h":0.015988371857499684,"t":"35","w":0.03080082257588701,"x":0.89322381859618682,"c":1},{"t":"IELTSXpress.com","c":1,"y":0.94166666658950615,"h":0.04166666666666663,"x":0.51176469618764042,"w":0.45882354736328113}],"h":3390,"w":2400}