{"lines":[{"y":0.042151163255335966,"w":0.090349076588948529,"t":"Listening","x":0.82956878809510315,"h":0.018895347842776355,"c":1},{"y":0.090040343727797123,"w":0.10683375040690106,"h":0.020500707485682779,"c":1,"x":0.08416012705469815,"t":"PART 2"},{"c":1,"h":0.019174041297935096,"w":0.20123203277587892,"x":0.24435318269026784,"t":"Questions 11-20","y":0.08997050185719635},{"c":1,"t":"Questions 11-16","y":0.12790697675997331,"x":0.086242298947851639,"w":0.17659137725830082,"h":0.017520752065652956},{"x":0.084188916413154499,"w":0.3429158020019531,"h":0.020395142771853059,"t":"Choose the correct letter, A, B or C.","y":0.16279069749427921,"c":1},{"w":0.40451746622721352,"y":0.20203488402866043,"h":0.021858920882233512,"t":"Working as a lifeboat volunteer","x":0.29979465486339052,"c":1},{"x":0.082062265862008182,"t":"11 What made David leave London and move to Northsea?","y":0.23093743304898795,"w":0.58127258300781259,"h":0.020856259776427688,"c":1},{"t":"He was eager to develop a hobby.","h":0.018895347842776355,"x":0.17453799170221865,"c":1,"w":0.32648869832356775,"y":0.26017441908733274},{"h":0.013081394746943475,"c":1,"t":"B","y":0.2819767443935548,"w":0.016427105267842634,"x":0.13141683739247939},{"y":0.27758112117903089,"t":"He wanted to work shorter hours.","c":1,"w":0.32238192240397134,"x":0.17453799316146396,"h":0.018930506073268072},{"h":0.013081394746943475,"x":0.13141683820187505,"t":"C","y":0.29941860484309801,"w":0.016427103678385402,"c":1},{"c":1,"y":0.29498525032462042,"x":0.16427105012694304,"h":0.02042172637309303,"w":0.4640657043457031,"t":"He found his job in website design unsatisfying."},{"c":1,"h":0.018918501592315451,"w":0.69815195719401046,"t":"12 The Lifeboat Institution in Northsea was built with money provided by","y":0.32267441909507077,"x":0.084188908505058557},{"c":1,"w":0.20384176890055336,"t":"a local organisation.","y":0.35220335666841052,"x":0.16601271675182575,"h":0.019915922271818487},{"t":"a local resident.","w":0.1663244374593