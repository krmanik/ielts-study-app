{"h":3390,"lines":[{"c":1,"w":0.30390144348144532,"h":0.033430233395556841,"y":0.0058139530575510578,"x":0.0082135492068117818,"t":"@MirsIELTS"},{"w":0.063791186014811263,"c":1,"t":"Test 4","y":0.043479399117337669,"x":0.84592781551806806,"h":0.017692364492950863},{"w":0.055552914937337231,"c":1,"h":0.0090830541290013445,"x":0.073866252904675425,"y":0.094295682221700039,"t":"KIERAN:"},{"h":0.011627907316944852,"x":0.071868582917877552,"c":1,"t":"JANE:","y":0.12499999978145004,"w":0.043121150334676103},{"y":0.14054001003177086,"x":0.073764546714647883,"c":1,"t":"KIERAN:","w":0.055756327311197923,"h":0.011071142686151836},{"h":0.0087209302063888661,"y":0.15697674417732888,"x":0.073921970865949121,"c":1,"w":0.041067762374877928,"t":"JANE:"},{"w":0.055547917683919298,"x":0.073868752282338981,"t":"KIERAN:","h":0.011884774852291224,"c":1,"y":0.18591807749935474},{"c":1,"t":"JANE:","y":0.20348837199029057,"x":0.069815194820690887,"w":0.045174538294474292,"h":0.010174418761666915},{"h":0.012083433933314236,"x":0.073828341917631254,"w":0.055628738403320319,"t":"KIERAN:","y":0.23233037585746152,"c":1},{"y":0.24999999999128231,"h":0.0087209302063888661,"c":1,"x":0.071868582846008958,"w":0.043121150334676117,"t":"JANE."},{"h":0.012031594560561354,"y":0.26433303990818469,"x":0.071788412669900215,"w":0.057655207316080731,"c":1,"t":"KIERAN:"},{"t":"JANE:","y":0.3095930235320743,"w":0.043121150334676103,"c":1,"x":0.071868583169417591,"h":0.011627906191665427},{"h":0.011627907316944963,"c":1,"x":0.071868581739147258,"t":"KIERAN:","y":0.34156976724269028,"w":0.057494869232177753},{"x":0.069815195089586932,"h":0.011627907316944963,"w":0.045174538294474278,"c":1,"y":0.3720930229888143,"t":"JANE:"},{"y":0.40406976725022692,"c":1,"t":"KIERAN:","x":0.071868581704543869,"w":0.057494869232177712,"h":0.011627907316944963},{"h":0.011627907316944963,"t":"JANE:","x":0.069815194939005135,"y":0.43459302302757408,"w":0.045174538294474292,"c":1},{"w":0.055498701731363925,"t":"KIERAN:","x":0.073893360257792778,"h":0.010331794716263887,"c":1,"y":0.46503759084623553},{"h":0.011627906191665538,"x":0.06981519516487783,"y":0.49563953515998116,"w":0.045174538294474292,"c":1,"t":"JANE:"},{"t":"KIERAN:","h":0.011627906191665538,"y":0.54215116303788813,"w":0.057494862874348962,"c":1,"x":0.071868585451942552},{"y":0.559413260888738,"x":0.069735679046037821,"h":0.01053394328879742,"t":"JANE:","c":1,"w":0.045333569844563812},{"x":0.071824506056390708,"y":0.58999000742963692,"c":1,"t":"KIERAN:","w":0.057583020528157558,"h":0.01042696184816605},{"w":0.043121150334676117,"h":0.0087209302063888661,"c":1,"t":"JANE.","y":0.60610465115407297,"x":0.071868582846008958},{"c":1,"x":0.073921969733420079,"y":0.62063953478486422,"w":0.05544148127237955,"h":0.010174418761666915,"t":"KIERAN:"},{"t":"JANE:","x":0.069815194744822562,"y":0.63662790686997395,"w":0.043121150334676089,"h":0.010174418761666804,"c":1},{"c":1,"x":0.071868581772514831,"h":0.011627907316944963,"w":0.057494869232177739,"t":"KIERAN:","y":0.65116279049123682},{"y":0.66715116276017772,"w":0.043121150334676117,"c":1,"h":0.0087209302063888661,"t":"JANE:","x":0.071868582892210209},{"w":0.059548250834147123,"h":0.011627907316944963,"t":"KIERAN:","c":1,"x":0.069815197155528377,"y":0.68168604625847107},{"y":0.71366279068895677,"h":0.008720930206388755,"x":0.071868582846008958,"w":0.043121150334676117,"t":"JANE:","c":1},{"y":0.72819767416544767,"w":0.057494862874348948,"h":0.011627907316944963,"x":0.069815197104919971,"c":1,"t":"KIERAN:"},{"w":0.045174538294474292,"h":0.011627907316944963,"t":"JANE:","x":0.069815194815801854,"y":0.74418604631245777,"c":1},{"y":0.79651162771534312,"h":0.011627907316944963,"x":0.071868581704543869,"w":0.057494869232177712,"c":1,"t":"KIERAN:"},{"y":0.81249999980082976,"c":1,"t":"JANE:","h":0.011627907316944963,"w":0.043121150334676103,"x":0.069815194755659893},{"y":0.84302325562232006,"w":0.057494869232177712,"h":0.011627907316944963,"c":1,"t":"KIERAN:","x":0.071868581704543869},{"c":1,"w":0.045174538294474278,"t":"JANE:","x":0.069815194810398218,"y":0.85901162780169416,"h":0.010174418761666915},{"t":"KIERAN:","y":0.87345962523455445,"h":0.011801679718107638,"x":0.071832462821884088,"w":0.055513718922932956,"c":1},{"x":0.16837781812356051,"w":0.63244354248046886,"y":0.091445427551795411,"h":0.016224188790560423,"c":1,"t":"Well, it's pretty clear that ruins them, but a lot of people just can't be bothered to"},{"t":"protect their books.","w":0.15605749766031898,"c":1,"h":0.013112266225449032,"x":0.1683778219180663,"y":0.10901162763380901},{"h":0.015988371857499684,"x":0.16837781155603618,"t":"He always says it's such a shame that publishers don't use better-quality paper.","w":0.63039016723632812,"c":1,"y":0.1235465117430391},{"w":0.45379877726236972,"c":1,"t":"It's the acid in the paper that causes the problem, isn't it?","x":0.16837781902410262,"y":0.13805309748549388,"h":0.016016669821950269},{"w":0.56878850301106776,"x":0.16837782230614798,"c":1,"t":"Yeah - that's why old books go yellow. You know some of the books my","y":0.15398230071173269,"h":0.016075838702266476},{"w":0.34907597859700523,"x":0.1683778216956795,"y":0.16991150457674764,"c":1,"h":0.014749262536873253,"t":"grandfather's given me are like that already."},{"y":0.19911504442810468,"h":0.016001234364017236,"c":1,"w":0.62833674112955729,"x":0.16632444717649433,"t":"I should dump them really if they're going to deteriorate further, but I'd feel bad."},{"w":0.039014374415079711,"h":0.013081394746943587,"c":1,"y":0.2020348839834023,"x":0.83778234041053001,"t":"Q22"},{"h":0.017782433546398302,"w":0.52177001953125002,"t":"They'll always remind me of him. He's quite a collector, you know.","c":1,"x":0.16828244033029779,"y":0.21367800979898244},{"w":0.27515401204427081,"t":"Well, if they're important to you ...","x":0.1704312073898413,"h":0.01179941002949858,"c":1,"y":0.23244837735274937},{"t":"Yeah - I'd regret just throwing them away.","y":0.24656617239007173,"w":0.330912602742513,"h":0.015396764074454894,"x":0.17026286607587557,"c":1},{"t":"You know, maybe it's because I was taught to treasure books... but I hate","y":0.261627907091599,"h":0.015988371857499573,"c":1,"w":0.59342915852864575,"x":0.16837782309259325},{"y":0.27758112095363563,"c":1,"t":"seeing students force open the pages - of paperbacks. They press so hard they","x":0.16837781800263335,"w":0.63244354248046863,"h":0.0160235300879914},{"h":0.016078480858366717,"y":0.29199857735466073,"w":0.21209641774495444,"t":"end up breaking the spine.","c":1,"x":0.17017940942776236},{"x":0.1663244482823753,"y":0.30813953499428082,"w":0.6057494608561198,"t":"I know, but unfortunately, paperbacks aren't designed to last a long time and","h":0.016049255663666329,"c":1},{"c":1,"t":"people know that. Hardbacks aren't quite as weak.","h":0.014534883302221524,"x":0.1683778234010859,"y":0.32412790718169404,"w":0.40246406555175784},{"x":0.16830514498730756,"t":"Yeah, they're different, I suppose. But I still don't think people value hardbacks","w":0.6202740987141927,"h":0.017853317710853966,"y":0.33817407333367333,"c":1},{"x":0.16632443328472579,"w":0.13963039398193361,"h":0.014592337256687515,"y":0.35604719740576529,"t":"like they used to.","c":1},{"x":0.16837781798015811,"w":0.63244354248046886,"h":0.016224188790560423,"c":1,"y":0.37050147502828368,"t":"Well, they aren't decorative, are they, like other objects. Plus, nowadays, people"},{"y":0.38662790671171421,"x":0.17043120032977821,"w":0.45174540201822921,"c":1,"t":"don't keep them out on shelves as much as they used to.","h":0.013081395872223012},{"t":"That's such a pity. When I visit someone - if they have, say, a colourful book on","w":0.63244354248046886,"x":0.16837781815790359,"y":0.40116279089997287,"h":0.014534883302221635,"c":1},{"c":1,"y":0.40261627933437705,"w":0.039014374415079711,"t":"Q23","x":0.83572895232588473,"h":0.013081394746943587},{"y":0.417109144494763,"w":0.30595481872558594,"t":"a table, it's the first thing I'm drawn to.","x":0.16632443854918344,"h":0.014576901798754593,"c":1},{"t":"Lagree - and book covers can be a work of art in themselves. Some are really","w":0.62217661539713554,"x":0.16632442323457325,"h":0.014749262536873253,"y":0.43303834827573295,"c":1},{"t":"eye-catching.","x":0.16837782681761468,"w":0.1067761739095052,"h":0.013081394746943698,"c":1,"y":0.44912790723097173},{"c":1,"t":"I've always been taught to handle books carefully. If you watch someone take a","y":0.46366279090454832,"w":0.62833674112955729,"x":0.16632444247038128,"h":0.014534883302221635},{"t":"book off a shelf, well, they usually do it wrong.","x":0.16837782219016229,"c":1,"w":0.36550308227539063,"h":0.014540028642412439,"y":0.47964601765501613},{"t":"Ah, my grandfather says, you should put your hand right over the top of the book...","h":0.016074123776416149,"c":1,"w":0.63655029296874999,"y":0.4941002947077725,"x":0.16837783082152433},{"c":1,"t":"or if you can't do that, pull the other books on the shelf aside so that you can hold","x":0.16837783030663672,"y":0.51002949848309143,"w":0.6201231892903647,"h":0.016224188790560534},{"t":"the whole cover.","w":0.12985570271809899,"h":0.012613428166482255,"c":1,"y":0.52530700510437245,"x":0.16815918459351886},{"t":"When did you learn all this?","c":1,"x":0.16837781764004583,"y":0.54069767462110285,"w":0.22176592508951826,"h":0.014534883302221635},{"y":0.55516224215909815,"t":"He watched me pull a heavy book off the shelf when I was small, and it fell on the","c":1,"x":0.16837783031676792,"w":0.64476384480794269,"h":0.016058687755843515},{"t":"Q24","h":0.013081394746943587,"c":1,"w":0.057494869232177725,"y":0.55959302351588147,"x":0.81724845858206308},{"w":0.17453798929850259,"t":"floor and broke apart.","y":0.57256637181727199,"h":0.013274336283185861,"x":0.16632443440365516,"c":1},{"h":0.01332408938787677,"c":1,"y":0.5870879552859144,"w":0.074006938934326166,"t":"Oh dear!","x":0.1683353394683173},{"w":0.17864476521809899,"c":1,"h":0.013081395872223012,"x":0.16632443453674103,"t":"I can still remember it!","y":0.60319767414939363},{"x":0.16632443597280097,"w":0.22381930033365885,"y":0.61917404110795804,"h":0.014546888908453681,"t":"You know what I really like?","c":1},{"w":0.057494869232177725,"c":1,"x":0.16632443386440396,"y":0.63372093050834843,"t":"What?","h":0.013081394746943587},{"t":"The smell of new books.","h":0.0165821784365493,"x":0.16810919508144026,"y":0.64779378004304045,"w":0.19766958872477211,"c":1},{"y":0.6661215336981926,"w":0.064318262736002607,"c":1,"t":"Me too.","x":0.16805075828683788,"h":0.012066213782206403},{"h":0.016006379704208151,"t":"My parents used to laugh at me when I was a kid because I loved putting books","x":0.16632443053936868,"y":0.67876106200888697,"w":0.63244354248046863,"c":1},{"w":0.39219711303710936,"y":0.69616519197038895,"t":"up to my nose. Almost as much as reading them!","c":1,"x":0.16632444137241209,"h":0.014590621768197476},{"c":1,"w":0.34496920267740883,"t":"New books aren't cheap, though, are they?","x":0.16632443346683848,"y":0.71209439527631957,"h":0.01327433628318575},{"t":"Q25","c":1,"y":0.71075581412009303,"x":0.83572895233225963,"w":0.039014374415079822,"h":0.014534883302221524},{"y":0.72674418611051705,"w":0.30184804280598954,"c":1,"x":0.16632443722123516,"t":"I guess we're lucky we can buy them.","h":0.014553749174495034},{"y":0.7398230088147193,"t":"My grandfather stocks second-hand books as well as new ones and they don't","x":0.16632445459733011,"c":1,"h":0.017444432801553278,"w":0.62422993977864583},{"t":"smell quite as good.","x":0.16837782212924879,"y":0.75870206474296997,"w":0.16221766153971356,"h":0.01164677262657865,"c":1},{"y":0.79356245906865808,"c":1,"t":"I'd love to have a bookshop like your grandfather. What's it like?","x":0.16626478317994017,"w":0.50938090006510417,"h":0.016808484507872978},{"x":0.1663244416923563,"w":0.60369608561197918,"h":0.016070693362075672,"t":"Well, it's quite big - it's got two floors and an attic, and he stocks all kinds of","y":0.80959302337079997,"c":1},{"y":0.82535850300461777,"t":"books really.","w":0.10484445571899415,"c":1,"h":0.014980668374570794,"x":0.16626360364582993},{"t":"guess he treasures things like first editions and other rare books.","y":0.83995096386177859,"w":0.52986648559570315,"x":0.1642203972525966,"h":0.016218583773722761,"c":1},{"h":0.014592337256687515,"w":0.52566736857096352,"x":0.16632442648836199,"y":0.85604719741463819,"t":"Yeah - you might think he'd keep those in the attic or somewhere.","c":1},{"x":0.17410255093186577,"h":0.017246963140887139,"c":1,"t":".. so they'd be hidden?","y":0.86979946839223687,"w":0.19181676228841144},{"c":1,"t":"117","y":0.92005813961057081,"x":0.86652977374609619,"h":0.015988371857499684,"w":0.041067762374877859},{"h":0.049250923989445083,"t":"IELTSXpress.com","c":1,"w":0.45410827636718754,"x":0.51812829482262635,"y":0.93755588824717162}],"w":2400}