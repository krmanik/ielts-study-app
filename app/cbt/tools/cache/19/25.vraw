{"lines":[{"c":1,"x":0.82956878787586485,"w":0.084188912709554087,"y":0.046511628373716918,"h":0.018895347842776244,"t":"Reading"},{"x":0.078028746587692321,"w":0.17659137725830076,"h":0.014594909645463172,"t":"Questions 27-30","y":0.095870206415496373,"c":1},{"c":1,"t":"Choose the correct letter, A, B, C or D.","y":0.13362831863130942,"x":0.078028746232166712,"w":0.36550308227539058,"h":0.017534472035095727},{"c":1,"h":0.018539895701900733,"w":0.57301452636718742,"x":0.077967965308827214,"t":"Write the correct letter in boxes 27-30 on your answer sheet.","y":0.17002053681107832},{"y":0.20930232560182715,"w":0.77002054850260426,"h":0.01754133230113708,"c":1,"x":0.075975352078672051,"t":"27 What point does the writer make about misinformation in the first paragraph?"},{"y":0.23687315622083616,"w":0.4722792561848958,"t":"Misinformation is a relatively recent phenomenon.","x":0.16632444054204892,"h":0.016033820205733518,"c":1},{"t":"Some people find it easy to identify misinformation.","x":0.16828955859194547,"y":0.25398563390784101,"w":0.48270731608072914,"c":1,"h":0.02052028959831298},{"w":0.01642710526784262,"h":0.013081394746943587,"y":0.27470930253308967,"c":1,"x":0.12320328503108309,"t":"C"},{"c":1,"h":0.013081394746943698,"w":0.01642710526784262,"t":"D","y":0.29215116299820587,"x":0.12320328503108309},{"c":1,"w":0.63449691772460937,"t":"Misinformation changes as it is passed from one person to another.","y":0.27315634208819484,"x":0.16632443631369473,"h":0.01754133230113708},{"t":"There may be a number of reasons for the spread of misinformation.","w":0.64681727091471353,"h":0.017699115044247815,"c":1,"y":0.29056047193063916,"x":0.16837781219120737},{"w":0.56057495117187506,"c":1,"y":0.31828908539061096,"h":0.017466728525527442,"x":0.075975358240998686,"t":"28 What does the writer say about the role of technology?"},{"x":0.16624103317545461,"y":0.34517787082812201,"w":0.61410898844401041,"t":"It may at some point provide us with a solution to misinformation.","h":0.018946658334197619,"c":1},{"x":0.1663244376209507,"h":0.016000377463731841,"c":1,"y":0.36482558151033495,"t":"It could fundamentally alter the way in which people regard information.","w":0.67556467692057287},{"t":"C","x":0.12320328503108309,"y":0.3837209304400665,"w":0.01642710526784262,"h":0.013081394746943587,"c":1},{"t":"D","x":0.12320328503108309,"y":0.4011627909051827,"w":0.01642710526784262,"h":0.013081394746943587,"c":1},{"t":"It has changed the way in which organisations use misinformation.","c":1,"w":0.63049402872721361,"x":0.16421679791323424,"y":0.38111885341883767,"h":0.01893025401067594},{"y":0.39970501447016771,"x":0.16427105006535309,"c":1,"w":0.69199178059895838,"t":"It has made it easier for people to check whether information is accurate.","h":0.017446148290043428},{"h":0.018803639819840123,"x":0.075897737192339276,"y":0.42728896534673,"t":"29 What is the writer doing in the fourth paragraph?","w":0.50325159708658851,"c":1},{"y":0.45296561395480595,"w":0.59367752075195312,"h":0.019976025696700983,"c":1,"t":"comparing the different opinions people have of misinformation","x":0.16822920384307907},{"w":0.016427103678385402,"y":0.47383720932999385,"h":0.014534883302221635,"t":"B","x":0.12320328584047877,"c":1},{"x":0.12320328503108309,"t":"C","y":0.49273255834704321,"w":0.01642710526784262,"h":0.013081394746943475,"c":1},{"t":"D","h":0.013081394746943475,"x":0.12320328503108309,"c":1,"w":0.01642710526784262,"y":0.51017441881215952},{"h":0.017699115044247815,"c":1,"t":"explaining how the effects of misinformation have changed over time","y":0.47227138655571088,"w":0.64476384480794269,"x":0.16837783117850638},{"y":0.49115044256645191,"t":"outlining which issues connected with misinformation are significant today","c":1,"w":0.69404515584309912,"x":0.16837783264371325,"h":0.016224188790560423},{"h":0.0175327571092454,"x":0.16837782061399878,"t":"describing the attitude of policy makers towards misinformation in the media","y":0.50872093025347387,"w":0.71457906087239587,"c":1},{"c":1,"y":0.53628318578480982,"x":0.07597536652360086,"h":0.017495883952903246,"w":0.62833674112955729,"t":"30 What point does the writer make about regulation in the USA?"},{"x":0.16632443295033178,"w":0.52772074381510414,"y":0.56395348839316239,"c":1,"t":"The guidelines issued by the FDA need to be simplified.","h":0.017462440648261746},{"x":0.12114989702067651,"w":0.018480493227640796,"c":1,"y":0.58284883737943527,"t":"B","h":0.013081394746943475},{"w":0.018480493227640796,"t":"C","x":0.12114989702067654,"c":1,"y":0.60174418625401993,"h":0.013081394746943475},{"w":0.01642710526784262,"h":0.013081394746943587,"x":0.12320328503108309,"y":0.61918604671913613,"t":"D","c":1},{"t":"Regulation does not affect people's opinions of new prescription drugs.","y":0.58139534864535525,"x":0.16837783145941615,"c":1,"w":0.6694045003255209,"h":0.017441860412777732},{"w":0.60574951171875002,"h":0.017441860412777732,"x":0.1663244226835375,"y":0.60029069769711341,"c":1,"t":"The USA has more regulatory bodies than most other countries."},{"w":0.66940450032552079,"c":1,"t":"Regulation fails to prevent misinformation from appearing in the media.","x":0.16837783198855846,"y":0.6176991148549642,"h":0.017475303717419122},{"h":0.017441860412777732,"y":0.92151162786047169,"c":1,"x":0.88295687820238333,"t":"27","w":0.032854210535685269},{"y":0.94166666658950615,"h":0.04166666666666663,"t":"IELTSXpress.com","x":0.51176470218237247,"c":1,"w":0.45294118245442705}],"w":2400,"h":3390}