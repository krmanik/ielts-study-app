{"w":2400,"h":3390,"lines":[{"c":1,"y":0.044404493266145151,"h":0.020112152999832933,"w":0.085417219797770172,"t":"Reading","x":0.82690524331036364},{"c":1,"y":0.094526415256254159,"h":0.01753954366948407,"w":0.17520556131998699,"x":0.07769731501579609,"t":"Questions 31-34"},{"c":1,"x":0.078028746932235382,"w":0.57700205485026046,"t":"Complete each sentence with the correct ending, A-F, below.","y":0.13067846591661514,"h":0.017699115044247815},{"x":0.075975347525039413,"y":0.16715116328375212,"h":0.018984529613393697,"t":"Write the correct letter, A-F, in boxes 31-34 on your answer sheet.","c":1,"w":0.63039016723632812},{"y":0.20348837209427562,"w":0.58316223144531243,"h":0.017455580944860216,"c":1,"x":0.075975352930907902,"t":"31 Speech translation methods are developing fast in Japan"},{"w":0.6858316040039063,"c":1,"y":0.23097345156735249,"h":0.016224188790560534,"t":"32 TV interviews that use translation voiceover methods are successful","x":0.075975368594422193},{"h":0.017460725722411419,"t":"33 Future translation systems should address people appropriately","x":0.075975367171265878,"w":0.64476384480794269,"y":0.2587020649418863,"c":1},{"t":"34 Users may be able to maintain their local customs","x":0.075868366909384408,"y":0.28572044201388702,"w":0.51561436971028651,"h":0.01866694650115519,"c":1},{"t":"C","y":0.39244186052912178,"w":0.01642710367838543,"h":0.014534883302221635,"x":0.19301848093288118,"c":1},{"y":0.42151162811448506,"w":0.018480493227640782,"c":1,"t":"D","x":0.19096509209254511,"h":0.013081394746943587},{"h":0.017504459144794815,"x":0.23613962787971207,"t":"but there are concerns about this.","y":0.3356932152416674,"c":1,"w":0.32443532307942702},{"t":"as systems do not need to conform to standard practices.","h":0.01888898551288265,"c":1,"y":0.36355543087423814,"x":0.22992127996128886,"w":0.55042653401692709},{"t":"but they are far from perfect.","x":0.23613963274102909,"c":1,"w":0.27720738728841143,"h":0.019174041297935096,"y":0.39085545682721823},{"h":0.018915929203539905,"w":0.23819302876790371,"c":1,"y":0.41858407028799638,"x":0.23819301319989483,"t":"despite the noise issues."},{"w":0.34496920267740894,"h":0.016042395397625087,"y":0.44767441871487124,"c":1,"x":0.21355235950938359,"t":"because translation is immediate."},{"t":"and have an awareness of good manners.","w":0.41478439331054684,"y":0.47522123878815625,"h":0.016057830855558008,"c":1,"x":0.22381930219390986},{"c":1,"x":0.88090349158805192,"w":0.028747431437174398,"h":0.014534883302221635,"t":"73","y":0.92296511642786194},{"w":0.45882354736328124,"h":0.04166666666666663,"x":0.51176469619230891,"c":1,"y":0.94166666659226195,"t":"IELTSXpress.com"}]}