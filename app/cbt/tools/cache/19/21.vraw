{"h":3390,"w":2400,"lines":[{"c":1,"h":0.019855145929837392,"x":0.83106993892262793,"t":"Reading","y":0.045983657380519571,"w":0.085173543294270848},{"c":1,"w":0.21560574849446618,"y":0.095870206417196568,"h":0.014594909645463172,"t":"Questions 22 and 23","x":0.080082135917038},{"c":1,"t":"Choose TWO letters, A-E.","w":0.2549651590983073,"x":0.077863339224239853,"y":0.13072504599193324,"h":0.019379249505237173},{"h":0.016034677668658737,"y":0.1671511629057858,"x":0.078028735319912806,"t":"Write the correct letters in boxes 22 and 23 on your answer sheet.","w":0.62217661539713542,"c":1},{"h":0.017441860412777732,"c":1,"w":0.73921971638997397,"t":"Which TWO of the following statements does the writer make about piracy and","x":0.078028745398442165,"y":0.2020348837446635},{"t":"ancient Greece?","y":0.21946902652108546,"w":0.15811088562011719,"h":0.014542601031188096,"c":1,"x":0.078028746081111822},{"y":0.24709302306395997,"t":"The state estimated that very few people were involved in piracy.","h":0.017508747022060511,"x":0.16632445358560849,"c":1,"w":0.61396301269531239},{"x":0.16632443787184389,"w":0.68377822875976557,"t":"Attitudes towards piracy changed shortly after the lliad and the Odyssey","y":0.26598837211636095,"h":0.017492454101202481,"c":1},{"c":1,"h":0.014594738040350164,"t":"were written.","x":0.17223001000068683,"y":0.28349402542798363,"w":0.1217845026652018},{"c":1,"x":0.16616158603055226,"w":0.6163621012369791,"y":0.29847166315552043,"t":"Important officials were known to occasionally take part in piracy.","h":0.022113069742478508},{"y":0.31828908579001269,"t":"Every citizen regarded pirate attacks on cities as unacceptable.","w":0.5975359090169271,"x":0.16837784132315856,"h":0.017466727962887729,"c":1},{"w":0.68377822875976557,"y":0.33716814140709694,"h":0.016029532891107534,"x":0.12320328797202591,"c":1,"t":"E A favourable view of piracy is evident in certain ancient Greek texts."},{"y":0.92151162786047169,"t":"23","x":0.88090349012914582,"w":0.032854