{"h":3390,"w":2400,"lines":[{"x":0.0077148522828395013,"h":0.03649153807873573,"t":"@MirsIELTS","y":0.0031134506513651461,"c":1,"w":0.30494344075520829},{"w":0.12320329030354819,"y":0.049418604843616043,"h":0.014534883302221635,"c":1,"t":"Audioscripts","x":0.086242297219650363},{"w":0.07186858495076498,"h":0.0087209302063888661,"t":"COLEMAN:","c":1,"x":0.088295686888067215,"y":0.098837209302951701},{"w":0.059548250834147123,"t":"WOMAN:","h":0.010174418761666915,"c":1,"x":0.088295690317012662,"y":0.12790697653849792},{"h":0.010291676254047477,"c":1,"t":"COLEMAN:","x":0.088279216935691546,"w":0.07190152486165366,"y":0.14383671999738623},{"w":0.059605464935302735,"h":0.0089187965280538295,"c":1,"t":"WOMAN:","x":0.088267082620692203,"y":0.1597847877660683},{"x":0.088240969031768271,"y":0.17422125181768211,"w":0.071978022257486993,"c":1,"t":"COLEMAN:","h":0.010569124024877863},{"x":0.088295686321876538,"y":0.19040697671366602,"w":0.059548257191975901,"h":0.0087209302063888661,"t":"WOMAN:","c":1},{"c":1,"y":0.20450551284921259,"w":0.074186134338378923,"x":0.086110218664662758,"t":"COLEMAN:","h":0.012500602024494767},{"y":0.25286242861739061,"w":0.059574171702067052,"t":"WOMAN:","h":0.0088100264557695596,"c":1,"x":0.088282729241414087},{"x":0.088133162191503703,"w":0.072280235290527337,"h":0.0095060905524060324,"c":1,"y":0.26796880090670094,"t":"COLEMAN:"},{"y":0.31395348818261282,"w":0.06160164515177409,"t":"WOMAN:","h":0.011627907316944852,"c":1,"x":0.086242298471340892},{"x":0.088295686888067215,"t":"COLEMAN:","w":0.07186858495076498,"y":0.36046511627969591,"h":0.0087209302063888661,"c":1},{"w":0.059548257191975915,"x":0.088295686496414519,"t":"WOMAN:","y":0.37645348837014159,"h":0.0087209302063888661,"c":1},{"h":0.0087209302063888661,"c":1,"w":0.071868584950764966,"x":0.088295686891086897,"t":"COLEMAN:","y":0.39098837209328297},{"x":0.088295686492747757,"h":0.0087209302063888661,"c":1,"w":0.059548257191975915,"y":0.40697674418355811,"t":"WOMAN:"},{"y":0.42151162781104978,"x":0.088295690811334759,"c":1,"h":0.0087209302063888661,"w":0.071868578592936189,"t":"COLEMAN:"},{"t":"WOMAN:","c":1,"x":0.088295686496414491,"y":0.46802325581088833,"w":0.059548257191975915,"h":0.0087209302063888661},{"h":0.0087209302063888661,"c":1,"t":"COLEMAN:","x":0.088295686888067215,"y":0.48401162790760299,"w":0.07186858495076498},{"x":0.088160627075026338,"y":0.55330859043264835,"w":0.057764987945556651,"h":0.0096618888652429957,"t":"WOMAN:","c":1},{"h":0.0087209302063888661,"t":"COLEMAN:","y":0.56976744186109129,"c":1,"x":0.088295686888067215,"w":0.07186858495076498},{"h":0.009065036154777939,"w":0.057597071329752614,"c":1,"x":0.088244585382541485,"t":"WOMAN:","y":0.60011864469712117},{"x":0.08829568688504752,"y":0.61627906976770153,"h":0.0087209302063888661,"t":"COLEMAN:","w":0.07186858495076498,"c":1},{"h":0.011627907316944963,"c":1,"t":"WOMAN:","y":0.6613372090491686,"x":0.084188913867914383,"w":0.061601638793945312},{"x":0.086242298797718137,"w":0.07186858495076498,"h":0.0087209302063888661,"c":1,"t":"COLEMAN:","y":0.67732558139521981},{"h":0.011627906191665538,"w":0.059548250834147137,"c":1,"y":0.69186046531501999,"x":0.086242302406335014,"t":"WOMAN:"},{"y":0.70756201283640863,"x":0.086163456156681847,"h":0.010748067085018631,"c":1,"w":0.072026271820068363,"t":"COLEMAN:"},{"h":0.0087209302063888661,"y":0.72383720929983719,"x":0.086242298409732188,"c":1,"t":"WOMAN:","w":0.059548257191975901},{"x":0.086037711327591596,"w":0.072277762095133466,"h":0.011738821609181938,"y":0.73758989137316788,"c":1,"t":"COLEMAN:"},{"x":0.086229579892091499,"w":0.059573694864908863,"c":1,"h":0.010249281351545125,"t":"WOMAN:","y":0.78484628948383472},{"w":0.071868584950764966,"h":0.008720930206388755,"t":"COLEMAN:","x":0.086242298800737818,"y":0.80087209302351559,"c":1},{"w":0.059663073221842444,"c":1,"t":"WOMAN:","x":0.086184890398956687,"h":0.010516556596333992,"y":0.83122427982198022},{"w":0.071868584950764966,"c":1,"x":0.086242298800737818,"h":0.0087209302063888661,"t":"COLEMAN:","y":0.8473837209304923},{"y":0.09587020632919907,"w":0.59342915852864586,"h":0.016048398200741221,"c":1,"x":0.18480492779408753,"t":"He's retired, actually, but he's a really nice guy and he used to play in a lot"},{"t":"of bands.","c":1,"w":0.076387246449788448,"h":0.011531434860904688,"x":0.18670946709617964,"y":0.11140033460093901},{"t":"Thanks. So how long have you been going?","x":0.18480492654046723,"y":0.12645348848515237,"w":0.35318275451660164,"h":0.016024387550916619,"c":1},{"t":"About a month now.","y":0.1423211725211172,"w":0.16060165405273438,"h":0.012184521160294559,"x":0.18665302159785294,"c":1},{"c":1,"h":0.014558036489121018,"t":"And could you play anything before you started?","x":0.18480493400743248,"y":0.15840707957672884,"w":0.38809033711751306},{"c":1,"y":0.17232664780676921,"x":0.18259063992544042,"h":0.016051377378030529,"t":"I knew a few chords, but that's all.","w":0.27547208150227864},{"y":0.18890542504666419,"t":"I'm sure everyone will be better than me.","w":0.32875460306803395,"h":0.014168994194638351,"c":1,"x":0.18470083056061373},{"x":0.1848049157541207,"w":0.61396306355794272,"c":1,"y":0.20348837211617488,"t":"That's what I thought, too. When I first spoke to Gary on the phone, he said it","h":0.017455580944860327},{"h":0.015996089586466145,"c":1,"t":"was a class for beginners, but I was still worried that everyone would be better","x":0.18275154079006975,"y":0.21946902657161838,"w":0.62628336588541667},{"t":"than me, but we were all equally hopeless!","c":1,"y":0.2353982299667936,"w":0.34291580200195315,"x":0.18480493257253727,"h":0.01327433628318575},{"t":"Oh, that's reassuring. So where do you meet?","w":0.36755645751953125,"y":0.2500000001132453,"c":1,"h":0.016076696165191806,"x":0.18480493335638423},{"c":1,"h":0.016017527284875266,"x":0.18480493450229565,"y":0.26598837220801896,"t":"Well, when I joined the group, they were meeting in Gary's home, but as the","w":0.60369608561197918},{"y":0.28052325577183157,"x":0.18480494547100249,"w":0.5975359090169271,"h":0.015988371857499684,"t":"group got bigger, he decided to book a room at the college in town. I prefer","c":1},{"c":1,"h":0.01327891054406638,"x":0.18477895939203184,"w":0.098614565531412762,"t":"going there.","y":0.29786635865601385},{"w":0.58726898193359378,"h":0.016224188790560423,"y":0.31091445441834931,"c":1,"t":"I know that place. I used to go to tap dancing classes there when I was at","x":0.18275154673340846},{"x":0.18275152845856504,"y":0.32848837229982752,"c":1,"h":0.01457947418753025,"w":0.63860371907552083,"t":"secondary school. I haven't been since, though and I can't remember what road"},{"h":0.014534883302221524,"c":1,"x":0.18069815234414269,"t":"it's in... is it Lock Street?","w":0.21560574849446615,"y":0.34302325601625205},{"w":0.59548253377278648,"h":0.014549461297229338,"y":0.35899705011866123,"x":0.18275154614698,"c":1,"t":"It's just beyond there at the bottom of New Street near the city roundabout."},{"x":0.18672086982596198,"c":1,"y":0.37296968850894685,"w":0.11731801350911458,"h":0.015688529900744985,"t":"Yes, of course."},{"w":0.39219711303710936,"t":"The guitar club is on the first floor in Room T347.","x":0.18480493413633337,"y":0.38953488392639812,"h":0.014594909645463172,"c":1},{"w":0.41683779398600262,"t":"Right. And when do you meet? Is it at the weekend?","x":0.18480492220617728,"h":0.013081395872223123,"c":1,"y":0.40552325554903845},{"w":0.63449691772460937,"y":0.42005813926880109,"x":0.18480492901650411,"h":0.013081395872223012,"t":"We meet on Thursdays. It used to be 10.30 and that suited me well, but now we","c":1},{"x":0.18267549509741932,"c":1,"w":0.64081670125325518,"h":0.016909466521226491,"t":"meet at 11. The class that's in there before us asked if they could have the room","y":0.43437076676043163},{"y":0.45065164442525929,"w":0.18927767435709636,"t":"for another 30 minutes.","x":0.18463297329576989,"c":1,"h":0.013098693667611627},{"x":0.18480493619767069,"t":"Oh, I see. Well, I'd love to come, but I don't have a guitar.","w":0.45790552775065108,"y":0.46656976764701397,"h":0.014551176223079665,"c":1},{"y":0.48255813927083802,"h":0.013081395872223123,"x":0.18480493449890162,"c":1,"w":0.60369608561197907,"t":"Well, you can always buy a second-hand one. There's a website called 'The"},{"x":0.18269939773773491,"h":0.016838617240433118,"y":0.49700902982205841,"w":0.63871164957682292,"c":1,"t":"perfect instrument' that sells all kinds of guitars, violins and so on. I'm sure you'll"},{"t":"find something there.","y":0.51297935127020977,"h":0.014749262536873142,"c":1,"w":0.17248460133870441,"x":0.1827515390376569},{"c":1,"t":"So what's a typical lesson like with Gary?","x":0.18480492575651605,"y":0.55221238917969051,"h":0.014749262536873142,"w":0.32854209899902342},{"x":0.18275154563041743,"w":0.57905543009440108,"c":1,"y":0.56831395369513082,"t":"Well, he always starts by getting us to tune our guitars. That takes about","h":0.014576901798754704},{"t":"five minutes.","x":0.18449785538155178,"w":0.10528923670450846,"h":0.012593037540582053,"c":1,"y":0.58307531006221192},{"c":1,"h":0.013081394746943587,"w":0.053388086954752584,"t":"Uhuh.","y":0.59883720957212616,"x":0.18275154162089299},{"t":"Some people have an app they use, but others do it by ear. Gary goes round and","y":0.61334852819370833,"w":0.6448608907063802,"h":0.015393694312171524,"x":0.18475456532609827,"c":1},{"y":0.62936046522939315,"h":0.016067263510374907,"x":0.18275154685952144,"w":0.62012318929036458,"c":1,"t":"helps them. And while he's doing that, he tells us what he's going to do during"},{"w":0.090797506968180369,"h":0.011122393537763342,"c":1,"x":0.18461818513329617,"t":"the lesson.","y":0.64534696859600793},{"w":0.051334702173868818,"h":0.014534883302221635,"y":0.6598837210357662,"t":"Right.","x":0.18275153977548858,"c":1},{"t":"First, we usually spend about ten minutes doing some strumming.","h":0.015837637864734577,"x":0.18472308721666669,"w":0.52584014892578135,"c":1,"y":0.6745994229176745},{"c":1,"y":0.69037932428374027,"h":0.015739010498586947,"x":0.18475607476468189,"t":"So is that using... what are they called... plectrums?","w":0.44161321004231768},{"h":0.014333003671471611,"c":1,"t":"No - we just use our thumbs.","x":0.18464913966590862,"y":0.70630915294243468,"w":0.23643610636393225},{"x":0.18244018616514779,"w":0.10745999654134114,"h":0.013933443952802382,"c":1,"t":"Much easier.","y":0.72168958753328061},{"y":0.73614346862379543,"x":0.18474905120785004,"t":"Gary reminds us where to put our fingers for each chord and then we play them","c":1,"h":0.015526569557752556,"w":0.63255839029947925},{"c":1,"x":0.18275153436430733,"w":0.63244354248046875,"y":0.75280235971430287,"h":0.014749262536873142,"t":"together. Sometimes we all just start laughing because we're so bad at keeping"},{"t":"time, so Gary starts clapping to help us.","h":0.017585837665208937,"x":0.18259683109416433,"c":1,"w":0.32062192281087232,"y":0.76738647166009633},{"c":1,"t":"Do you learn to play any songs?","x":0.18480492353863126,"y":0.78343023229112896,"w":0.25872690836588541,"h":0.013081395872223012},{"w":0.63244354248046875,"x":0.18480492269200377,"t":"Yes - we do at least one song with words and chords. I mean that's harder than","h":0.013089970501474868,"c":1,"y":0.799410029757882},{"w":0.080676205952962238,"c":1,"x":0.18231416032173306,"h":0.013696933847612947,"t":"you think.","y":0.81472783497941437},{"c":1,"t":"Oh, I'm sure it is!","x":0.18480492602112786,"y":0.82994186019108229,"w":0.13757700602213541,"h":0.013125986194891914},{"y":0.84593023229426645,"h":0.013081395872223012,"t":"That part of the lesson takes about 15 minutes. He often brings a recording of","c":1,"x":0.18480492860351358,"w":0.61806981404622396},{"c":1,"t":"the song and plays it to us first. Then he hands out the song and if there's a new","x":0.18069815321371019,"y":0.86046511639340051,"w":0.64271046956380207,"h":0.015988371857499684},{"t":"chord in it, we practise that before we play it together - but really slowly.","h":0.014587191916496711,"c":1,"y":0.87640117996242217,"w":0.572895253499349,"x":0.18275155173068414},{"w":0.23819302876790363,"h":0.013274336283185861,"y":0.89233038326573422,"c":1,"t":"Do you do any finger picking?","x":0.18480492288504205},{"w":0.028747431437174398,"t":"Q2","y":0.21947674425005204,"c":1,"h":0.014534883302221524,"x":0.85831622272083796},{"c":1,"y":0.28197674443248755,"h":0.013081394746943587,"w":0.028747431437174398,"t":"Q3","x":0.85626283450386309},{"c":1,"w":0.028747431437174509,"h":0.013081394746943587,"t":"Q4","x":0.85626283449608498,"y":0.36046511652055568},{"y":0.43459302339324335,"c":1,"w":0.026694043477376361,"x":0.85831622269149666,"h":0.013081394746943475,"t":"Q5"},{"w":0.028747431437174509,"h":0.013081394746943587,"y":0.49854651186939292,"x":0.85626283449608498,"t":"Q6","c":1},{"y":0.6148255816417898,"w":0.03080082257588701,"c":1,"t":"Q7","h":0.013081394746943587,"x":0.85420944488077644},{"t":"Q8","h":0.011627907316944963,"w":0.028747431437174509,"x":0.85420944639640251,"c":1,"y":0.77034883699075229},{"h":0.013081394746943587,"w":0.026694043477376361,"c":1,"t":"Q9","x":0.85420944634979412,"y":0.84593023279962554},{"y":0.89384831262319231,"t":"WOMAN:","w":0.059580192565917983,"h":0.010268490996684254,"x":0.086226330715370614,"c":1},{"w":0.036960986455281591,"h":0.013081394746943587,"t":"104","c":1,"y":0.92296511653913726,"x":0.086242299277492676},{"t":"IELTSXpress.com","w":0.45294118245442705,"y":0.94166666659226195,"x":0.51176470218665204,"h":0.04166666666666663,"c":1}]}