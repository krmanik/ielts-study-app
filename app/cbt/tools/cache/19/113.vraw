{"lines":[{"y":0.0044532009191010635,"x":0.0099936789169633757,"w":0.30239781697591145,"h":0.033533133447697816,"c":1,"t":"@MirsIELTS"},{"c":1,"w":0.065708421071370426,"h":0.017441860412777732,"y":0.04215116278679476,"x":0.8501026682082079,"t":"Test 4"},{"w":0.061601645151774076,"c":1,"t":"KAEDEN:","y":0.095930232556188044,"x":0.078028746106404256,"h":0.0087209302063888661},{"w":0.63884562174479176,"c":1,"h":0.020254885693215319,"x":0.17236736297591876,"y":0.089805055305212655,"t":"Yes, but that shouldn't happen - we check the stock every day. When something"},{"h":0.021246682226130464,"x":0.17233799147290466,"c":1,"t":"needs a new price label, put a yellow one on the package, next to the original","y":0.10527238772325065,"w":0.61430241902669269},{"y":0.1250000001701328,"x":0.17248459932006943,"c":1,"t":"price.","w":0.049281314214070643,"h":0.013081394746943587},{"h":0.0087209302063888661,"y":0.14244186046756568,"x":0.078028746958525422,"c":1,"w":0.088295688629150396,"t":"CHARLOTTE:"},{"w":0.034907598495483388,"x":0.17043121093232463,"t":"OK.","h":0.013081394746943587,"c":1,"y":0.13953488397156399},{"c":1,"t":"KAEDEN:","y":0.15693052819936371,"x":0.075958570277180351,"w":0.06368860880533854,"h":0.011720338894554261},{"h":0.014749262536873253,"x":0.17248459969594904,"w":0.39835728963216149,"t":"After that, you'll go to the sushi takeaway counter.","y":0.15398230079273567,"c":1},{"y":0.17296511618751775,"h":0.010174418761666915,"c":1,"x":0.078028746890617409,"w":0.08624230066935222,"t":"CHARLOTTE:"},{"h":0.014749262536873142,"y":0.16991150457512716,"x":0.16632443127040641,"w":0.27515401204427081,"c":1,"t":"Will I be preparing boxes of food?"},{"t":"KAEDEN.","y":0.18879077887180806,"w":0.059641666412353522,"c":1,"x":0.077982041434647514,"h":0.0090463492019338121},{"h":0.017451860208427039,"c":1,"x":0.17236567593614846,"t":"For today, you'll just be helping the staff.","y":0.18439322020457438,"w":0.3246543375651042},{"x":0.079980215941363023,"h":0.011056782995353398,"w":0.084392751057942708,"c":1,"y":0.20304718986033843,"t":"CHARLOTTE:"},{"y":0.20203488399765224,"c":1,"t":"Yes, of course.","x":0.16221765682872133,"w":0.13347023010253903,"h":0.013081394746943587},{"h":0.010050331948429414,"t":"KAEDEN.","x":0.077854770484037814,"y":0.21881204331032256,"w":0.061949596405029297,"c":1},{"w":0.62650395711263018,"t":"You'll see lots of flat cardboard boxes at one end of the counter. Beneath those","x":0.17237863506451256,"h":0.018980603513464422,"c":1,"y":0.21330906147069062},{"h":0.016071550825000891,"x":0.17248460669341881,"y":0.2296511628983402,"w":0.62012318929036458,"c":1,"t":"is where we keep the plastic boxes - we run out of those really quickly, so you"},{"t":"should bring more trom the storeroom.","h":0.011630479705720509,"y":0.24854651145368323,"w":0.30800821940104167,"c":1,"x":0.1745379846533901},{"c":1,"w":0.42758127848307292,"t":"CHARLOTTE: IS that my only task on the sushi counter?","x":0.077821093131605318,"y":0.26128948551649112,"h":0.018376947926209031},{"y":0.28178402910915867,"x":0.077975454789342466,"h":0.009106360353902998,"t":"KAEDEN.","c":1,"w":0.061708227793375661},{"x":0.17444012858770028,"y":0.27540898692442173,"c":1,"t":"No. You also need to clean the area where they prepare the dishes. There are","w":0.61824971516927085,"h":0.018312168402657814},{"w":0.60164271036783845,"h":0.016224188790560534,"c":1,"t":"cloths and bottles of spray by the sink. Oh, and please make sure you clean","y":0.29203539809313961,"x":0.17453798773894544},{"c":1,"x":0.17222059561450634,"y":0.31074343099515489,"w":0.072470925649007173,"h":0.012582641646573745,"t":"that too."},{"t":"CHARLOTTE.","x":0.080082134918323569,"y":0.32848837209547255,"w":0.084188912709554045,"h":0.0087209302063888661,"c":1},{"c":1,"x":0.078028746113484898,"h":0.010174418761666804,"w":0.061601645151774104,"t":"KAEDEN:","y":0.3430232557179036},{"y":0.32206744794492637,"w":0.24285820007324219,"c":1,"h":0.01852534358831992,"t":"Sure. That's important, isn't it?","x":0.17427273127330692},{"w":0.64090815226236986,"h":0.019826262257443661,"t":"Absolutely. But you mustn't wash up knives. You have to do some training before","c":1,"x":0.17440539069324881,"y":0.33688675254882372},{"y":0.35491756956577458,"h":0.015783305435405737,"x":0.17235773650051489,"w":0.30411506652832032,"t":"you're allowed to touch sharp objects.","c":1},{"y":0.37500000000244937,"w":0.084188912709554045,"h":0.0087209302063888661,"x":0.080082134918323569,"c":1,"t":"CHARLOTTE."},{"w":0.27104723612467452,"h":0.013274336283185861,"t":"What should I do if there are any?","x":0.17453798359383807,"y":0.37050147520339338,"c":1},{"y":0.38787172287418403,"h":0.012047251698541817,"x":0.077951085705289178,"w":0.06175696690877279,"c":1,"t":"KAEDEN:"},{"y":0.38561668017677198,"c":1,"t":"Ask someone to put them in the dishwasher.","h":0.015075490608327913,"w":0.35135119120279945,"x":0.17647019334122216},{"y":0.40385522186966127,"w":0.08430508295694987,"h":0.012056997743679632,"c":1,"t":"CHARLOTTE:","x":0.080024050891712925},{"c":1,"w":0.38603696187337244,"t":"OK, thanks. I don't want to get anything wrong.","x":0.16221765858984075,"y":0.40261627927489663,"h":0.014534883302221524},{"t":"Don't worry. You'll be fine. And I'Il be around to help.","y":0.41710914449850689,"h":0.014576901798754704,"x":0.17248459369382155,"w":0.41683779398600262,"c":1},{"x":0.08008213386218116,"w":0.14373716990152996,"y":0.43451327450486721,"h":0.01179941002949858,"c":1,"t":"CHARLOTTE: Right."},{"t":"KAEDEN:","w":0.059548257191975915,"c":1,"h":0.0087209302063888661,"x":0.080082134135018204,"y":0.45203488371897871},{"h":0.018817477380983272,"x":0.17442293673274414,"t":"Finally, the meat and fish counters. You need to clean the area where staff serve","w":0.6367881266276042,"c":1,"y":0.44516558382755878},{"w":0.38827445983886716,"c":1,"t":"customers, including wiping the weighing scales.","x":0.17443378723381259,"y":0.4634766927143279,"h":0.016584291711317811},{"w":0.086242300669352207,"x":0.080082134983599035,"c":1,"t":"CHARLOTTE:","y":0.48255813944365789,"h":0.010174418761666915},{"w":0.059586334228515642,"x":0.08006309562034708,"y":0.4984809053030248,"c":1,"h":0.0088521428516128431,"t":"KAEDEN."},{"y":0.47964601764901427,"h":0.014540028642412439,"c":1,"w":0.15811088562011719,"x":0.17248459816729286,"t":"OK. Anything else?"},{"w":0.62445612589518229,"h":0.018782327027447532,"c":1,"y":0.49253823114660422,"x":0.17443687724922577,"t":"The fish is laid on ice, but when that starts to melt, you'll need to get more from"},{"h":0.012643782579090046,"w":0.11755298614501952,"t":"the cold-room.","c":1,"x":0.17634752621081617,"y":0.51072768421382708},{"w":0.084221382141113271,"t":"CHARLOTTE:","x":0.080065900801719936,"h":0.010309897903847509,"c":1,"y":0.5275485393361814},{"t":"KAEDEN:","y":0.54472483992479859,"w":0.059735940297444654,"h":0.0093875294238064955,"x":0.079988292585614532,"c":1},{"t":"I know the staff on the food counters wear a hat. Will that be the same for me?","y":0.52323049215131134,"h":0.016069349215797279,"c":1,"w":0.62229782104492193,"x":0.17243480087684085},{"y":0.54069767462223661,"c":1,"t":"You won't be serving customers directly, so no. But make sure you put on","x":0.17453798079143448,"w":0.58316223144531254,"h":0.014534883302221635},{"h":0.020113858923447858,"y":0.55364768497977401,"w":0.63071380615234374,"t":"thermal gloves when you take anything out of the cold-room. The temperature's","c":1,"x":0.17439327795890905},{"x":0.1745379961000926,"y":0.57109144563633574,"w":0.44969197591145837,"t":"low enough in there to get frostbite from touching things.","h":0.014749262536873142,"c":1},{"c":1,"t":"CHARLOTTE: Understood.","h":0.014582047138945509,"x":0.080082135427764461,"y":0.58866279089122997,"w":0.19712525685628254},{"x":0.84188911640329933,"t":"Q7","w":0.032854210535685269,"h":0.014534883302221635,"y":0.10465116294414856,"c":1},{"x":0.84188911639540176,"w":0.032854210535685158,"h":0.015988371857499573,"y":0.22819767446974826,"t":"Q8","c":1},{"x":0.84394250595399056,"w":0.028747431437174509,"h":0.013081394746943587,"c":1,"y":0.49273255838102081,"t":"Q9"},{"y":0.55523255820354034,"x":0.84599589293252353,"w":0.036960986455281564,"c":1,"t":"Q10","h":0.014534883302221635},{"t":"PART 2","w":0.10266940434773764,"x":0.080082135507987096,"y":0.63805309757827833,"h":0.01456318126667222,"c":1},{"c":1,"y":0.66300562487875092,"w":0.6367538960774739,"t":"My name's Liz Fuller and I'm a running coach with Compton Park Runners Club.","x":0.079961253098842916,"h":0.018797345006712041},{"y":0.68690284975826421,"w":0.67367197672526036,"t":"Welcome to my podcast. If you're thinking about taking up running - I'm here to help.","x":0.079988926905740013,"h":0.018573853259241435,"c":1},{"t":"There are many training programmes available online which aim to help people build up to","w":0.70650960286458342,"x":0.080011574746648939,"h":0.016983413696289085,"y":0.71048744262568952,"c":1},{"t":"running 5 kilometres. Some of them are great and thousands of people of all ages are taking","x":0.079998675261156602,"w":0.7229504903157552,"h":0.018149523889772312,"c":1,"y":0.72577282715076152},{"c":1,"t":"part in 5-kilometre races across the country as a result. People like them because they're easy","y":0.74131210278522564,"w":0.73942830403645832,"x":0.079966562441675632,"h":0.01745823660431356},{"t":"to follow and don't push them too hard. However, they don't work for everyone - especially if","x":0.079995577180565644,"c":1,"w":0.72502985636393236,"h":0.017561003873481917,"y":0.75722275828009844},{"t":"you suffer from something like a heart condition or asthma, because they're aimed at people","h":0.01701569740047848,"c":1,"w":0.72089497884114584,"y":0.77281220913731108,"x":0.080000520034300096},{"c":1,"t":"with average fitness and running ability. Another thing is that everyone is different - and if you","x":0.079969448114267525,"y":0.78707895196677202,"w":0.73123458862304691,"h":0.019181742710349781},{"t":"have any specific questions related to your needs, there's no one to provide any answers.","w":0.70445755004882815,"h":0.017624213069589501,"c":1,"y":0.8032922500880415,"x":0.079990390803162087},{"t":"I have a couple of simple tips I always give to new runners. I expect you've been told to run","c":1,"x":0.07997329925243396,"y":0.82594043345563428,"w":0.72094675699869781,"h":0.018464426586409899},{"y":0.84173698816623987,"t":"very slowly until your fitness increases - well, I find that can prevent progress. You should","c":1,"x":0.079998458756507962,"w":0.71064432779947917,"h":0.017768740583661735},{"t":"run at a speed that feels comfortable, but time yourself and try to run a bit faster each time.","h":0.018613619508996426,"c":1,"w":0.72092839558919275,"y":0.85677071546273642,"x":0.079972437487556558},{"w":0.73521082560221362,"t":"Listening to music can be very helpful - it takes your mind off things and helps your body get","y":0.87280123992618519,"h":0.016914623114211769,"x":0.082073849625861423,"c":1},{"h":0.018483289645484846,"c":1,"y":0.88784342764735369,"w":0.73122838338216145,"t":"into a rhythm. I'd say that is better than running with a friend - especially as most people are","x":0.079973742197825284},{"w":0.06171577453613275,"c":1,"h":0.013353271259319066,"x":0.84593882721206082,"t":"Q11\/12","y":0.75713150388223271},{"x":0.84599589190403923,"w":0.061601645151774131,"y":0.79069767469699737,"h":0.013081394746943475,"t":"Q11\/12","c":1},{"w":0.061677068074544206,"c":1,"x":0.84801156859611981,"y":0.87345696552912166,"t":"Q13\/14","h":0.01326048746924835},{"t":"115","h":0.014534883302221635,"x":0.87885010237810868,"y":0.91860465122679613,"w":0.036960986455281564,"c":1},{"y":0.94166666659226195,"w":0.45294118245442705,"c":1,"t":"IELTSXpress.com","x":0.51176470218665204,"h":0.04166666666666663}],"w":2400,"h":3390}