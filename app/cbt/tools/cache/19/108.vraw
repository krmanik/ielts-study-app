{"lines":[{"t":"@MirsIELTS","x":-0.0010762928607699488,"h":0.043458521119964511,"w":0.31377459208170572,"c":1,"y":0.0031298451494480295},{"c":1,"w":0.11958101908365887,"h":0.014353251949524082,"y":0.049623375749440979,"x":0.092157049766136978,"t":"Audioscripts"},{"w":0.043121150334676117,"c":1,"t":"LEON.","y":0.098837209294646122,"x":0.092402463744366253,"h":0.0087209302063888661},{"w":0.07186858495076498,"c":1,"h":0.0087209302063888661,"x":0.094455851156094756,"y":0.11337209302351559,"t":"SHANNON:"},{"h":0.0091721453146245135,"x":0.092313573350367953,"c":1,"t":"LEON:","y":0.12913485755556064,"w":0.043298931121826159},{"y":0.1598837209304923,"x":0.09240246313404081,"c":1,"t":"SHANNON:","w":0.073921972910563141,"h":0.0087209302063888661},{"h":0.013274336283185861,"y":0.09587020650622613,"x":0.19096508759676123,"c":1,"w":0.25462013244628906,"t":"They sell other things there too."},{"w":0.27747894287109376,"x":0.18878350904326907,"t":"Like cakes? I love chocolate cake.","h":0.014591569253477044,"c":1,"y":0.11047655892448405},{"c":1,"t":"Well - not that, but they have a whole range of tarts and the best are the","y":0.12645348848693727,"x":0.188911703476487,"w":0.57700205485026046,"h":0.016024387550916619},{"h":0.013081395872223012,"x":0.18891170222010406,"w":0.13757700602213541,"t":"strawberry ones.","y":0.14389534856496689,"c":1},{"y":0.15693215350579193,"h":0.01457947418753025,"c":1,"x":0.1889116947509035,"w":0.50102671305338542,"t":"Perfect - hopefully I won't even have to go to the supermarket!"},{"h":0.013081394746943475,"y":0.14389534909968149,"x":0.8603696094043698,"w":0.039014374415079822,"c":1,"t":"Q10"},{"t":"PART 2","y":0.20747489917145667,"w":0.10492481867472329,"c":1,"x":0.09230145093193888,"h":0.015282759202265073},{"h":0.017172058915669863,"c":1,"x":0.090300866000018618,"t":"PRESENTER: The children's book festival is coming up again soon and here to tell us all about","y":0.23391674530129447,"w":0.73728169759114581},{"x":0.1888261648326385,"h":0.01950058838610802,"w":0.6162100728352865,"c":1,"y":0.24885811657891821,"t":"it is the festival's organiser, Jenny Morgan. So tell us what we can expect this"},{"y":0.2674418607123068,"c":1,"t":"year, Jenny.","x":0.18891170421508746,"w":0.098562628428141286,"h":0.011627906191665538},{"h":0.011627907316944963,"t":"JENNY:","x":0.090349077819191589,"y":0.28343023230498265,"w":0.053388086954752598,"c":1},{"w":0.63054066975911449,"t":"Well, as usual we've got five days of action-packed exciting events for children,","x":0.18884724027895666,"h":0.018951395760595346,"c":1,"y":0.27903921998171954},{"h":0.016039822446209939,"x":0.18891171922760311,"y":0.29646017723617368,"w":0.49075973510742188,"c":1,"t":"with writers coming from all over the country getting involved."},{"t":"Just to give you an idea of what's on offer in the workshops, first of all, there's","h":0.020671178316999717,"y":0.31032542904268356,"w":0.61830958048502604,"c":1,"x":0.18880117033574786},{"c":1,"w":0.61408818562825518,"t":"a very special event called Superheroes. This is a chance for deaf children to","x":0.18884921770961627,"y":0.32685185752323886,"h":0.016371068701279912},{"w":0.62237040201822924,"c":1,"x":0.18882479302482372,"t":"share their reading experiences with author Madeleine Gordon, who is herself","h":0.019452604220679959,"y":0.34129463355468914},{"c":1,"h":0.014549461297229338,"x":0.1889117024161597,"y":0.35899705011014271,"t":"hearing impaired.","w":0.14373716990152999},{"h":0.016224188790560423,"x":0.18685830436120085,"y":0.37345132716912055,"w":0.63039016723632812,"t":"'Just do it'is a practical workshop led by the well-known illustrator Mark Keane.","c":1},{"y":0.38953488392708302,"x":0.18891170526989015,"w":0.63449691772460937,"h":0.014594909645463172,"c":1,"t":"He'll take participants on a magical journey to faraway lands with an opportunity"},{"x":0.18891170185421544,"w":0.31622177124023432,"h":0.014535741327786567,"c":1,"y":0.4055232558779589,"t":"for aspiring actors to do some role play."},{"h":0.013081395872222901,"c":1,"y":0.42005813927093549,"x":0.18891169809753933,"t":"'Count on me' is an inspiring and entertaining look at the issues of friendship","w":0.60780288696289064},{"y":0.43598820041718844,"x":0.18891171068666437,"h":0.014593194719612734,"t":"for 13-14-year-olds. It looks at some of the friendships described in popular","c":1,"w":0.60369608561197918},{"x":0.18891169756719298,"y":0.45191740428429361,"c":1,"t":"books and asks participants to compare these with their own experiences.","w":0.59137578328450524,"h":0.013274336283185861},{"w":0.63244354248046875,"h":0.014551176223079665,"c":1,"t":"'Speak up' is part of a series of workshops on the subject of mental health. This","y":0.4665697676488163,"x":0.18685831079160334},{"c":1,"x":0.18685830463842498,"y":0.48255813974147477,"w":0.63860371907552083,"h":0.014534883302221524,"t":"is a creative writing workshop encouraging children to describe situations where"},{"t":"young people experience loneliness. A recent survey revealed that children can","x":0.18891169888992956,"y":0.49852507366503329,"w":0.63244354248046875,"h":0.013102833570632355,"c":1},{"c":1,"x":0.18881838139244705,"h":0.016063384109542111,"w":0.44368174235026042,"t":"be lonely even when they're at home with their families.","y":0.51249655576242659},{"y":0.52761627917272524,"w":0.63655029296874999,"c":1,"h":0.016041537934699979,"t":"'Jump for joy', as many of you willknow, is the heart-warming, best-selling story","x":0.18480493506555273},{"w":0.61601643880208334,"h":0.014534883302221524,"t":"by Nina Karan about a young girl's trip to visit her relatives in India. It recently","c":1,"x":0.18891169738145719,"y":0.54360465134419333},{"y":0.55958702065913346,"h":0.014540886105337769,"x":0.18891169732666641,"w":0.58316223144531243,"t":"received the gold medal at the Waterford Awards. Nina will get children to","c":1},{"y":0.57551622396051172,"w":0.33880902608235675,"h":0.01327433628318575,"x":0.1889117085881484,"c":1,"t":"celebrate the word 'joy' by writing a poem."},{"w":0.61618489583333336,"h":0.017662160305147001,"t":"'Sticks and stones' is the beautifully illustrated picture book for young readers","x":0.1867671285198825,"y":0.58813930307814832,"c":1},{"y":0.60610465136961278,"h":0.014544315957038534,"x":0.18891171068655885,"w":0.60369608561197918,"c":1,"t":"about a community who organise an African-Caribbean festival to help local"},{"y":0.62209302299177682,"c":1,"t":"children learn about their Jamaican roots. This will be a musical event where","h":0.013081395872223012,"w":0.60780288696289064,"x":0.18891169809635158},{"y":0.63657817095750635,"w":0.58726898193359367,"h":0.014584619527721165,"c":1,"t":"children will have the chance to play steel drums. This is bound to be very","x":0.18891171014902294},{"c":1,"w":0.36139630635579434,"t":"popular, so please book as soon as possible.","x":0.18891170298846868,"y":0.65250737473106812,"h":0.014749262536873253},{"t":"PRESENTER:","y":0.69040697662328476,"h":0.010174418761666915,"x":0.094455851513373185,"w":0.086242300669352207,"c":1},{"x":0.19096508080377683,"w":0.63860371907552083,"y":0.6889534881081133,"h":0.013111408762523924,"c":1,"t":"Thanks Jenny. That all sounds really interesting. I'm just wondering if you have a"},{"t":"favourite book you could recommend for our readers?","w":0.42915812174479173,"c":1,"h":0.014534883302221635,"x":0.18891169877852823,"y":0.7049418606709934},{"h":0.01820148873118177,"x":0.18885399220273164,"t":"It's hard to choose, but Alive and Kicking is definitely worth mentioning. You won't","w":0.64900945027669277,"c":1,"y":0.7178241629342752},{"w":0.60369608561197918,"c":1,"t":"have heard of the writer as it's her first book - which is really impressive. It's","x":0.19096509879496296,"y":0.73539823005988336,"h":0.01179941002949858},{"w":0.62217661539713531,"x":0.1909650803480118,"c":1,"t":"basically the teenage diary of a boy from Somalia who comes to live in the UK.","y":0.75000000020552948,"h":0.014601769911504414},{"w":0.62833674112955729,"x":0.19096509958769237,"y":0.76598837182837087,"c":1,"h":0.013081395872223012,"t":"It deals with the serious issue of immigration and all the challenges the boy has"},{"y":0.7819767439217985,"h":0.013081395872223012,"c":1,"w":0.62217661539713542,"x":0.19096508027828349,"t":"to face at school and with the language barrier, etc. Usually, books like this are"},{"w":0.63244354248046875,"h":0.014586334453571492,"c":1,"y":0.79646017695516025,"x":0.18891169886354495,"t":"quite sad, but this one actually made me cry with laughter. On each page, there"},{"h":0.014749262536873142,"w":0.64065709431966145,"t":"are simple but hilarious black and white stick drawings of the boy with his friends","c":1,"x":0.18891169915456241,"y":0.8123893807376753},{"w":0.61396306355794272,"t":"and teachers. At the end of each diary entry, there are new English words the","x":0.19096508002911017,"h":0.011629622242795401,"c":1,"y":0.82848837192084634},{"t":"boy learns each day, which may help develop some children's vocabulary.","y":0.84302325592678051,"w":0.58726898193359367,"h":0.015988371857499684,"x":0.1889117101574965,"c":1},{"t":"PRESENTER:","y":0.86046511628097355,"h":0.0087209302063888661,"c":1,"w":0.086242300669352207,"x":0.094455851613410025},{"y":0.85899705011885996,"c":1,"t":"I think my kids would enjoy that. What about any advice for parents on how to","x":0.18685831669212821,"w":0.61806981404622396,"h":0.014549461297229227},{"h":0.013547706041364238,"y":0.87357330094056018,"w":0.31029800415039066,"t":"encourage their children to read more?","c":1,"x":0.19085967950202956},{"x":0.86036960933909423,"y":0.32703488398099767,"w":0.036960986455281564,"t":"Q11","h":0.013081394746943587,"c":1},{"c":1,"t":"Q12","h":0.013081394746943475,"x":0.86036960934513373,"y":0.39098837235549544,"w":0.036960986455281564},{"x":0.86036960934513373,"t":"Q13","w":0.036960986455281564,"h":0.013081394746943698,"y":0.43750000026247204,"c":1},{"x":0.86036961123655975,"w":0.03696098327636721,"h":0.013081394746943587,"y":0.48401162804440612,"t":"Q14","c":1},{"x":0.86036960934513373,"w":0.036960986455281564,"h":0.013081394746943475,"c":1,"y":0.54796511654154201,"t":"Q15"},{"y":0.60901162770457662,"x":0.85831622124874529,"w":0.036960986455281564,"c":1,"t":"Q16","h":0.011627907316944963},{"t":"Q17\/18","w":0.063655033111572279,"x":0.85831622051153544,"y":0.76598837237061046,"h":0.013081394746943475,"c":1},{"c":1,"y":0.79915569698817934,"w":0.063842671712239563,"t":"Q17\/18","x":0.85822240121128424,"h":0.01215372226231215},{"y":0.92296511654154179,"w":0.039014374415079739,"t":"110","x":0.092402463613815378,"h":0.013081394746943587,"c":1},{"t":"IELTSXpress.com","w":0.45294118245442705,"x":0.51176470218665204,"h":0.04166666666666663,"y":0.94166666659226195,"c":1}],"w":2400,"h":3390}