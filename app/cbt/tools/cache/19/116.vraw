{"lines":[{"t":"@MirsIELTS","h":0.036538844825947159,"x":0.0076787393000124857,"y":0.0030922081012348945,"w":0.30498380025227861,"c":1},{"t":"Audioscripts","y":0.047627730608852503,"w":0.12174018859863282,"x":0.088004812477071911,"h":0.016415132955815648,"c":1},{"t":"JANE:","w":0.045174538294474278,"x":0.086242299543483517,"y":0.097383720827499909,"c":1,"h":0.010174418761666915},{"x":0.088295690174735167,"h":0.013081394746943587,"y":0.12645348850952243,"t":"KIERAN:","w":0.057494862874348976,"c":1},{"t":"JANE:","w":0.041067762374877928,"x":0.090349075577334029,"c":1,"y":0.1438953489216992,"h":0.0072674416511107065},{"c":1,"h":0.011918344188228791,"x":0.090288984192455471,"y":0.15683152538992118,"t":"KIERAN:","w":0.05556166330973307},{"t":"JANE:","x":0.088295687574475423,"w":0.043121150334676089,"h":0.010174418761666804,"c":1,"y":0.17441860454588021},{"y":0.20494186027348271,"t":"KIERAN:","c":1,"h":0.011627907316944963,"x":0.088295686434941609,"w":0.057494869232177739},{"x":0.086242299543483517,"y":0.22093023245540688,"h":0.010174418761666915,"t":"JANE:","w":0.045174538294474278,"c":1},{"t":"KIERAN:","w":0.057562834421793621,"x":0.088261703900285884,"y":0.26590361302687948,"h":0.011797425036585096,"c":1},{"h":0.010174418761666804,"x":0.088295687632114386,"t":"JANE:","w":0.043121150334676103,"y":0.28197674405101414,"c":1},{"w":0.055469601949056008,"h":0.010251480147550174,"c":1,"y":0.31246146920805895,"t":"KIERAN:","x":0.090335014117931128},{"y":0.32844641482006542,"h":0.010258333099275152,"t":"JANE:","c":1,"w":0.043160521189371762,"x":0.088276002131286044},{"y":0.34277799301602996,"h":0.012118432374127242,"c":1,"t":"KIERAN:","x":0.088198618655082564,"w":0.057689005533854157},{"t":"JANE:","x":0.090349077759992208,"y":0.35901162777471263,"h":0.0087209302063888661,"c":1,"w":0.041067759195963532},{"c":1,"t":"KIERAN:","x":0.088067739708180617,"y":0.38754114604540635,"w":0.060004151662190766,"h":0.014161893681438942},{"c":1,"y":0.40534009442510666,"x":0.088198447829280199,"t":"JANE:","w":0.043315629959106441,"h":0.011994229657108502},{"w":0.059548250834147123,"h":0.013081394746943475,"c":1,"y":0.43459302339324335,"x":0.088295690214343261,"t":"KIERAN:"},{"w":0.043121150334676103,"x":0.088295687640670154,"y":0.45203488360002897,"t":"JANE:","h":0.010174418761666804,"c":1},{"c":1,"w":0.059591197967529305,"h":0.013179686779821287,"t":"KIERAN:","y":0.48105550531590868,"x":0.088274216559951144},{"x":0.088295687595752292,"y":0.4985465115176041,"w":0.043121150334676089,"h":0.010174418761666915,"t":"JANE:","c":1},{"h":0.011627906191665538,"w":0.055441474914550773,"t":"KIERAN:","x":0.090349078388036005,"y":0.55813953508246184,"c":1},{"y":0.094395280259510383,"x":0.18685831079058005,"w":0.63244354248046875,"t":"Yeah. But he likes people to know that he has them. So, he puts them out in the","h":0.016069835899150564,"c":1},{"x":0.18480492233111789,"t":"shop but makes sure you need a ladder to get them.","h":0.014749262536873142,"c":1,"y":0.11032448356248559,"w":0.42094456990559892},{"c":1,"x":0.18674859863588883,"y":0.12485585355700135,"t":"Right. That would prevent any thefts!","w":0.29593544006347655,"h":0.015976939018497061},{"t":"Uhuh.","x":0.18685831579191572,"h":0.013081394746943475,"y":0.14098837226315619,"w":0.051334702173868818,"c":1},{"h":0.010324483775811188,"x":0.18891170011014735,"t":"Does he stock books for children?","c":1,"y":0.15693215321831677,"w":0.27104723612467452},{"h":0.014749262536873142,"y":0.17138643064683257,"c":1,"w":0.63449691772460937,"t":"He does. He particularly likes to encourage kids to read; he always says that he","x":0.18480492925197475},{"y":0.18604651154581409,"c":1,"t":"used to sit under the stairs as a child with a pile of books and read them all.","h":0.016018385310440308,"x":0.18480493257275421,"w":0.60164271036783856},{"c":1,"w":0.28566688537597656,"h":0.017320245275806889,"y":0.20195797513049596,"x":0.18469604152149666,"t":"Is that where he keeps them, then?"},{"x":0.18473386733517505,"y":0.21591510087188237,"w":0.60589640299479164,"c":1,"h":0.017981260856695935,"t":"Not exactly - he's got a dedicated area on the ground floor with cushions so"},{"y":0.23244837744668945,"t":"that parents can enter with their toddlers, go there and spend some time reading","x":0.18480495111542686,"w":0.64065704345703123,"h":0.016224188790560534,"c":1},{"c":1,"w":0.069056924184163426,"y":0.24899521996431462,"x":0.18417405173019741,"h":0.014476926910490517,"t":"to them."},{"t":"Oh cool.","y":0.2647940443951301,"w":0.068335895538330083,"h":0.011059525301322815,"c":1,"x":0.18862588152198195},{"c":1,"w":0.6201231892903647,"x":0.18685832325088464,"h":0.016002092389582057,"y":0.27905604701985309,"t":"And then there's a place for pushchairs by the front door. And a café if anyone"},{"w":0.16666829427083335,"c":1,"y":0.29511549340983101,"h":0.013080662190035008,"x":0.18672533766575838,"t":"needs refreshments."},{"y":0.31091445427874287,"x":0.18891170301205112,"c":1,"h":0.01179941002949858,"t":"That's good to know.","w":0.16427104949951171},{"y":0.32412790689465143,"h":0.015990087345989723,"t":"As I said, it's a big shop and there's a storage area out the back as well.","w":0.57700205485026046,"c":1,"x":0.18480492691265216},{"x":0.18480492494817041,"h":0.015988371857499573,"t":"Oh, what does he keep there? Books he wants to throw away?","y":0.34156976755631896,"c":1,"w":0.50308008829752615},{"w":0.61190963745117188,"x":0.18891171094376225,"t":"He hardly ever throws anything away - he just leaves unwanted books by the","h":0.013117411003000345,"c":1,"y":0.35752212414017359},{"x":0.18480492353175709,"h":0.01179941002949858,"c":1,"t":"front door for customers to take.","y":0.3734513274418273,"w":0.25872690836588541},{"h":0.01457347194705394,"y":0.38808139554002297,"c":1,"x":0.18480492710382876,"t":"Well, that's very nice.","w":0.17453798929850259},{"y":0.4025896786398695,"w":0.58533381144205721,"c":1,"h":0.015695470624265462,"t":"Yeah - and books people or institutions have requested, they all go at the","x":0.18679259776798859},{"c":1,"y":0.41846923678954062,"w":0.065826975504557267,"t":"far end.","x":0.18474565015445668,"h":0.014805712179448483},{"c":1,"h":0.013081394746943475,"x":0.18685831553982341,"t":"Oh.","w":0.032854210535685213,"y":0.43459302350225504},{"w":0.63244354248046875,"h":0.014588906842347149,"c":1,"t":"He thinks it's best to keep these out of the main shopping area as they're boxed","x":0.18685831088388152,"y":0.44912790718161233},{"h":0.013897998776056131,"c":1,"x":0.18451519519787196,"y":0.46484079639997478,"t":"and new.","w":0.076774323781331366},{"w":0.32443532307942707,"h":0.014534883302221635,"c":1,"t":"Did you get your coursebooks from him?","y":0.48110465136751612,"x":0.18685831371630607},{"x":0.18685831104734907,"c":1,"w":0.64065709431966145,"t":"Naturally. He stocks books for a lot of the colleges. He used to keep these books","y":0.49557522096190509,"h":0.013274336283185861},{"y":0.50997006938140355,"x":0.18681061047708122,"c":1,"t":"on the first floor, but now there's a new university in my hometown, he's moved","w":0.62639231363932291,"h":0.015942818295639261},{"h":0.017432080046617116,"c":1,"x":0.18469657511527354,"y":0.52477658142854267,"w":0.63677937825520825,"t":"them downstairs to attract the students. They're actually part of the coffee shop,"},{"t":"on low shelves all around it.","x":0.18685831046312329,"y":0.54215116261434571,"h":0.011627907316944963,"w":0.22176592508951826,"c":1},{"y":0.55811209411764651,"c":1,"h":0.013108836373748378,"t":"Pretty central then. You'll have to take me there some time!","w":0.47022588094075518,"x":0.18891170008403718},{"x":0.85626283323008845,"y":0.095930232722072351,"t":"Q26","c":1,"w":0.039014374415079711,"h":0.014534883302221635},{"w":0.041549247105916343,"t":"Q27","h":0.016068627911683064,"x":0.85508744596164965,"y":0.21731151621981004,"c":1},{"c":1,"t":"Q28","w":0.039014374415079711,"y":0.35755813979735585,"h":0.013081394746943587,"x":0.85626283322367158},{"y":0.40406976770433256,"x":0.85626283322367158,"h":0.013081394746943587,"c":1,"t":"Q29","w":0.039014374415079711},{"h":0.011627907316944963,"c":1,"x":0.85626283322937546,"w":0.039014374415079711,"t":"Q30","y":0.511627906774344},{"c":1,"y":0.60755813972940653,"t":"PART 4","w":0.1047227923075358,"x":0.09034907602282348,"h":0.014565754218087368},{"h":0.013274336283185861,"t":"Tree planting now dominates political and popular agendas and is often presented as an easy","w":0.74127309163411459,"y":0.63510324497961945,"x":0.090349080349670027,"c":1},{"w":0.73305953979492178,"c":1,"x":0.08829569211058147,"h":0.01607240828792611,"t":"answer to the climate crisis, as well as a way for business corporations to offset their carbon","y":0.64970930243668124},{"w":0.70020533243815097,"t":"emissions. But unfortunately, tree planting isn't as straightforward as some people think.","y":0.66715116299782951,"x":0.088295690970294535,"h":0.014559751414971345,"c":1},{"c":1,"y":0.68168604671828059,"h":0.014534883302221635,"x":0.090349066964695149,"w":0.72073923746744795,"t":"When the wrong trees are planted in the wrong place, it can do considerably more damage"},{"w":0.46611907958984372,"h":0.016022672625066292,"t":"than good, failing to help either people or the environment.","x":0.088295696242501595,"c":1,"y":0.69764011795124536},{"t":"Reforestation projects are currently being undertaken on a huge scale in many countries and","x":0.09240246819259966,"y":0.7209302322946094,"w":0.73305953979492189,"h":0.013081395872223012,"c":1},{"y":0.73687315651026453,"w":0.74127309163411459,"t":"it's crucial that the right trees are selected. A mix of species should always be planted, typical","h":0.014580331650455358,"c":1,"x":0.088295692273006612},{"h":0.013274336283185861,"y":0.75132743374397049,"w":0.70431213378906254,"c":1,"t":"of the local natural forest ecosystem and including rare and endangered species in order","x":0.09034906646540776},{"x":0.08829568453612277,"w":0.69815195719401035,"h":0.01308911303854976,"c":1,"y":0.76744186020132699,"t":"to create a rich ecosystem. It's important to avoid non-native species that could become"},{"h":0.013081395872222901,"t":"invasive. Invasive species are a significant contributor to the current global biodiversity crisis","x":0.088295692010435023,"c":1,"w":0.73305953979492178,"y":0.78343023229458331},{"w":0.71663243611653649,"c":1,"h":0.01456489675516226,"x":0.088295691467849532,"y":0.79793510303278181,"t":"and are often in competition with native species and may threaten their long-term survival."},{"h":0.014534883302221635,"x":0.088295698432920441,"t":"Restoring biodiversity that will maximise carbon capture is key when reforesting an area, but","y":0.82122093043981215,"w":0.73511291503906251,"c":1},{"t":"ideally any reforestation project should have several goals. These could include selecting","y":0.83491586393458295,"w":0.7064727274576823,"x":0.09029254969290415,"h":0.01676152828520372,"c":1},{"h":0.016098257644338254,"c":1,"t":"trees that can contribute to wildlife conservation, improve the availability of food for the","w":0.6859413146972656,"x":0.090299986777677546,"y":0.85126360381045774},{"y":0.86773255834678875,"h":0.014568326606863025,"t":"local community and maintain the stability of soil systems. Meeting as many of these goals","c":1,"x":0.088295697911903712,"w":0.71868581136067711},{"y":0.88372092996878215,"h":0.013081395872223012,"c":1,"w":0.71252568562825525,"t":"as possible, whilst doing no harm to local communities, native ecosystems and vulnerable","x":0.090349066741647346},{"c":1,"t":"118","h":0.013081394746943587,"w":0.036960986455281578,"x":0.090349075458190833,"y":0.92151162816704424},{"w":0.036960986455281564,"x":0.85626283316443541,"t":"Q31","h":0.013081394746943587,"c":1,"y":0.78343023282061153},{"c":1,"y":0.85319767468107677,"t":"Q32","w":0.039014374415079711,"h":0.013081394746943587,"x":0.85626283322367158},{"h":0.04166666666666663,"c":1,"y":0.94166666659226195,"x":0.51176470218665204,"t":"IELTSXpress.com","w":0.45294118245442705}],"w":2400,"h":3390}