{"blocks":[{"l":"header","b":[0.0892,0.0413,0.1537,0.0581],"t":"Test 4"},{"l":"text","b":[0.0867,0.0876,0.2721,0.1074],"t":"Questions 15–18"},{"l":"text","b":[0.085,0.1245,0.8946,0.164],"t":"What reason prevented each of the following members of the Compton Park Runners Club from joining until recently?"},{"l":"text","b":[0.0854,0.1788,0.6492,0.1991],"t":"Write the correct letter, A, B, or C next to Questions 15–18."},{"l":"text","b":[0.4575,0.2242,0.5546,0.2431],"t":"Reasons"},{"l":"text","b":[0.3308,0.2507,0.5754,0.2717],"t":"A a lack of confidence"},{"l":"text","b":[0.3312,0.2764,0.5675,0.2976],"t":"B a dislike of running"},{"l":"text","b":[0.3317,0.3018,0.5133,0.3224],"t":"C a lack of time"},{"l":"paragraph_title","b":[0.13,0.3652,0.2871,0.3835],"t":"Club members"},{"l":"text","b":[0.0838,0.3938,0.3846,0.415],"t":"15 Ceri"},{"l":"text","b":[0.0838,0.4227,0.3846,0.4442],"t":"16 James"},{"l":"text","b":[0.0829,0.4528,0.3837,0.4737],"t":"17 Leo ....."},{"l":"text","b":[0.0833,0.4799,0.3837,0.5012],"t":"18 Mark"},{"l":"text","b":[0.0833,0.5268,0.3071,0.5472],"t":"Questions 19 and 20"},{"l":"text","b":[0.0825,0.5631,0.4263,0.5829],"t":"Choose the correct letter, A, B or C."},{"l":"text","b":[0.0825,0.6006,0.6304,0.6201],"t":"19 What does Liz say about running her first marathon?"},{"l":"text","b":[0.1275,0.6286,0.49,0.6466],"t":"A It had always been her ambition."},{"l":"text","b":[0.1283,0.6466,0.5204,0.664],"t":"B Her husband persuaded her to do it."},{"l":"text","b":[0.1275,0.6652,0.5142,0.6832],"t":"C She nearly gave up before the end."},{"l":"text","b":[0.0804,0.6912,0.5737,0.7112],"t":"20 Liz says new runners should sign up for a race"},{"l":"text","b":[0.1271,0.7195,0.3479,0.7372],"t":"A every six months."},{"l":"text","b":[0.1271,0.7378,0.5567,0.7563],"t":"B within a few weeks of taking up running."},{"l":"text","b":[0.1275,0.7563,0.5404,0.7743],"t":"C after completing several practice runs."},{"l":"number","b":[0.0817,0.9153,0.1104,0.9313],"t":"80"},{"l":"fo