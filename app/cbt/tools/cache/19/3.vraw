36139630635579428,"t":"For candidates wishing to migrate to an","x":0.47227925952044153,"c":1,"y":0.70203488420741078,"h":0.018909068374858951},{"w":0.41498753865559895,"h":0.020801202104506644,"x":0.47216588676993526,"y":0.7191751532570585,"t":"English-speaking country (Australia, Canada,","c":1},{"t":"New Zealand, UK) and for those wishing to","y":0.73834808230235083,"x":0.47227926050775731,"c":1,"w":0.39425051371256509,"h":0.018919359055240559},{"w":0.30800821940104167,"h":0.017482163420820651,"x":0.47022586965999552,"y":0.75722713887236215,"c":1,"t":"train or study below degree level."},{"w":0.016427103678385416,"c":1,"t":"4","x":0.080082135943148156,"y":0.92005813972681882,"h":0.013081394746943587}]}