{"h":3390,"w":2400,"lines":[{"t":"Introduction","x":0.073921966452455995,"y":0.09302325573223591,"w":0.25051335652669271,"c":1,"h":0.027616279174444536},{"y":0.19007913902801254,"w":0.7496136474609375,"t":"Prepare for the exam with practice tests from Cambridge","x":0.080019933201190274,"h":0.020089348086916869,"c":1},{"y":0.22721931448515242,"w":0.78860275268554691,"h":0.018589481139956621,"c":1,"x":0.07593260344610997,"t":"Inside you'll find four authentic examination papers from Cambridge University Press &"},{"c":1,"h":0.01945366198334364,"w":0.73730305989583333,"x":0.077948122885222612,"t":"Assessment. They are the perfect way to practise - EXACTLY like the real exam.","y":0.2448272592058427},{"c":1,"t":"Why are they unique?","y":0.2949811478246529,"x":0.079926823257388119,"w":0.28989410400390625,"h":0.022803879909459202},{"x":0.077966350356198949,"w":0.81531814575195327,"h":0.019015946289782759,"t":"All our authentic practice tests go through the same design process as the IELTS test. We","y":0.33261754162097357,"c":1},{"w":0.80082132975260434,"y":0.35162241901505897,"h":0.017699115044247815,"t":"check every single part of our practice tests with real students under exam conditions, to","x":0.078028760275835315,"c":1},{"x":0.080082134819966441,"t":"make sure we give you the most authentic experience possible.","y":0.37050147502403918,"w":0.57700205485026046,"h":0.016224188790560534,"c":1},{"t":"Students can take these tests on their own or with the help of a teacher to familiarise","h":0.018236573818510626,"x":0.10054362079838777,"c":1,"w":0.7311553955078125,"y":0.38649986301012085},{"h":0.019532532818549608,"c":1,"t":"themselves with the exam format, understand the scoring system and practise exam technique.","y":0.40429029177288034,"w":0.82969614664713542,"x":0.077959757060474713},{"y":0.45781710903319817,"t":"Further information","c":1,"w":0.25872690836588541,"x":0.080082130915864844,"h":0.014566611681012698},{"h":0.018491053510907851,"x":0.0779744695703753