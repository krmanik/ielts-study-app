{"lines":[{"c":1,"w":0.25689074198404949,"t":"Audioscripts","y":0.091126983710218101,"h":0.032862311619221374,"x":0.079973520066420223},{"h":0.016075838702266587,"c":1,"w":0.098562628428141286,"t":"TEST 1","x":0.39835728937489456,"y":0.15398230068009799},{"h":0.014821154389057956,"c":1,"w":0.1027495257059733,"t":"PART 1","y":0.21642663209205382,"x":0.080042074828956131},{"c":1,"h":0.0089702161715797812,"x":0.082088135281335753,"w":0.045269314448038736,"y":0.24696838026591628,"t":"SALLY:"},{"y":0.27729701693522568,"t":"JOHN:","x":0.079942700135943123,"h":0.010812942819961147,"c":1,"w":0.045453408559163411},{"y":0.32412790678136583,"h":0.011627907316944963,"c":1,"t":"SALLY:","x":0.080082135393634277,"w":0.049281314214070629},{"w":0.043121150334676103,"t":"JOHN:","x":0.080082135207405286,"y":0.3401162790610498,"h":0.0087209302063888661,"c":1},{"h":0.011627907316944963,"x":0.080082135332822713,"y":0.37063953468834243,"c":1,"w":0.047227926254272468,"t":"SALLY:"},{"x":0.082135523245463554,"h":0.0087209302063888661,"y":0.41715116277813258,"c":1,"w":0.041067762374877942,"t":"JOHN:"},{"h":0.011627906191665538,"w":0.049281314214070643,"c":1,"t":"SALLY:","y":0.43168604675881839,"x":0.080082135860110454},{"y":0.49369811511353867,"c":1,"t":"JOHN:","h":0.011150281337861778,"w":0.045594094594319665,"x":0.079872357149152015},{"c":1,"x":0.082135523418504983,"h":0.010174418761666915,"y":0.51017441850301959,"w":0.047227926254272454,"t":"SALLY:"},{"w":0.043121150334676117,"h":0.0087209302063888661,"c":1,"t":"JOHN:","y":0.54069767440443639,"x":0.082135523324705056},{"t":"SALLY:","h":0.010174418761666915,"c":1,"y":0.55668604640999642,"w":0.047227926254272454,"x":0.082135523418504983},{"t":"JOHN:","x":0.080001176270658378,"y":0.58702622094681411,"w":0.04533645629882814,"h":0.010540581312151409,"c":1},{"y":0.60294894930471366,"t":"SALLY:","w":0.047437041600545238,"x":0.082030965744893325,"c":1,"h":0.010671868788457495},{"x":0.082119301292576774,"w":0.04315359433492022,"c":1,"h":0.0088016538141751921,"t":"JOHN:","y":0.64966894051381652},{"h":0.010552284218217078,"x":0.082055662740219124,"c":1,"w":0.047387647628784182,"y":0.66405525321739189,"t":"SALLY:"},{"t":"JOHN.","x":0.082135523353007306,"y":0.69622093022487874,"w":0.045174538294474292,"h":0.008720930206388755,"c":1},{"x":0.079947055382340482,"w":0.049551474253336586,"h":0.012214850816754774,"y":0.71046234200938163,"c":1,"t":"SALLY:"},{"w":0.045174538294474292,"h":0.0087209302063888661,"c":1,"t":"JOHN.","x":0.082135523353007306,"y":0.74273255813185546},{"t":"SALLY:","y":0.75726744166508675,"w":0.047227926254272454,"c":1,"x":0.082135523423171777,"h":0.011627907316944852},{"t":"JOHN:","x":0.082135523362785359,"y":0.81976744185278561,"h":0.0087209302063888661,"c":1,"w":0.045174538294474278},{"x":0.081837381566941481,"h":0.010771504404973875,"t":"SALLY:","w":0.049752813975016269,"y":0.83461810295259675,"c":1},{"y":0.87339711426866873,"h":0.011926701638550918,"x":0.082062944039675928,"t":"SALLY:","w":0.047373085021972655,"c":1},{"c":1,"x":0.17653126069391856,"h":0.01731402416848149,"y":0.24248932577989957,"t":"Good morning. Hinchingbrooke Country Park, Sally speaking. I'm one of","w":0.57509104410807288},{"t":"the rangers.","w":0.09869515101114909,"h":0.012204654659845104,"c":1,"x":0.17857850241101927,"y":0.26133953312263647},{"x":0.1765913844940358,"w":0.5564681498209636,"t":"Oh hello. My name's John Chapman, and I'm a teaching assistant at a","y":0.27315634202300709,"h":0.016224188790560423,"c":1},{"t":"local primary school. I've been asked to arrange a visit to the park for two","x":0.17447572810544121,"y":0.28871505747496373,"h":0.016897480607384274,"c":1,"w":0.58125330607096359},{"w":0.11951817830403647,"c":1,"x":0.17845469339281081,"y":0.30644487629552319,"t":"of our classes.","h":0.011976209432326135},{"h":0.014534883302221635,"c":1,"y":0.32122093043553757,"w":0.27515401204427081,"t":"OK. What would you like to know?","x":0.17659137171301353},{"y":0.33499527820974639,"x":0.17650632758094256,"w":0.60592244466145839,"t":"Well, I'm new to this area, so perhaps you could tell me something about the","c":1,"h":0.01790104474993226},{"y":0.35309734525703274,"w":0.14168378194173178,"c":1,"h":0.014749262536873142,"t":"park first, please.","x":0.17659137378023018},{"c":1,"t":"Of course. Altogether the park covers 170 acres, that's 69 hectares. There are","x":0.17856144116528061,"y":0.36554876734549246,"w":0.61001708984375003,"h":0.018083516123723831},{"y":0.38226744197383455,"h":0.015988371857499573,"w":0.64476384480794269,"c":1,"t":"three main types of habitat: wetland, grassland and woodland. The woods are well","x":0.17659138352264828},{"w":0.63667460123697917,"t":"established and varied, with an oak plantation, and other areas of mixed species.","y":0.39786506934100219,"x":0.17652264232387457,"h":0.017466107933922226,"c":1},{"y":0.41424418621044445,"w":0.051334702173868846,"h":0.014534883302221635,"c":1,"t":"Right.","x":0.17659137567769598},{"t":"The wetland is quite varied, too. The original farmland was dug up around","y":0.4287790698808589,"w":0.58316223144531243,"h":0.016058688318483227,"x":0.17659136883006227,"c":1},{"h":0.013081395872223012,"w":0.60985626220703126,"c":1,"t":"40 years ago to extract gravel. Once this work was completed, the gravel pits","x":0.17864476413966771,"y":0.4447674415949695},{"x":0.17653210297856692,"t":"filled with water, forming the two large lakes. There are also several smaller","y":0.45923414970714571,"h":0.016796364123139007,"w":0.59765792846679688,"c":1},{"h":0.016622277206375879,"y":0.4749121378866572,"w":0.43138432820638029,"c":1,"t":"ones, ponds and a stream that flows through the park.","x":0.17649199983392441},{"t":"OK, so I suppose with these different habitats there's quite a variety of wildlife.","x":0.17864476452709235,"y":0.48982558150503563,"h":0.01607412377641626,"c":1,"w":0.61806981404622396},{"x":0.17864477979992824,"w":0.5811088053385417,"t":"There certainly is - a lot of different species of birds and insects, and also","h":0.016014954896099831,"c":1,"y":0.50581395340627922},{"w":0.23845517476399741,"h":0.014601064361302152,"c":1,"y":0.52181602499313395,"t":"animals like deer and rabbits.","x":0.17647852346993398},{"c":1,"h":0.01311398115129947,"t":"And I understand you organise educational visits for school parties.","w":0.53182749430338538,"x":0.18069816252842155,"y":0.53775811212723679},{"y":0.55123767723073902,"c":1,"h":0.017858142909047192,"w":0.61621785481770841,"x":0.17854876470369391,"t":"That's right. We can organise a wide range of activities and adapt them to suit"},{"t":"all ages.","x":0.17844653202286329,"w":0.070374259948730478,"h":0.011296799471244734,"y":0.57017798368629657,"c":1},{"h":0.014547090333471568,"y":0.58333758108182132,"w":0.39654604593912757,"c":1,"t":"Can you give me some examples of the activities?","x":0.18059195670243289},{"x":0.17652445925677984,"y":0.59799204173655329,"h":0.017757569934766182,"w":0.59975723266601566,"c":1,"t":"Well, one focus is on science, where we help children to discover and study"},{"c":1,"h":0.017227062011538674,"x":0.17856988031893584,"y":0.61373552131704789,"t":"plants, trees and insects. They also collect and analyse data about the things","w":0.60999318440755212},{"c":1,"h":0.011938676862238484,"t":"they see.","x":0.17825260172147978,"y":0.63259489350659248,"w":0.078686491648356116},{"h":0.014534883302221635,"c":1,"t":"Another focus is on geography. The park is a great environment to learn and","y":0.66133720950862629,"w":0.60369608561197918,"x":0.1786447702563195},{"y":0.67728613558606066,"w":0.58316223144531243,"h":0.013120841417340712,"c":1,"x":0.18069814496040634,"t":"practise reading a map and using a compass to navigate around the park."},{"y":0.69156985623549239,"w":0.34727673848470053,"c":1,"h":0.017067828783243533,"t":"Do you do anything connected with history?","x":0.17852753426900714},{"w":0.62012318929036458,"h":0.016044967786400743,"c":1,"x":0.17864477075205307,"y":0.70784883732431703,"t":"Yes, we do. For instance, the children can explore how the use of the land has"},{"w":0.41907267252604169,"h":0.015356827344866208,"x":0.18059623910378036,"y":0.7224066030913372,"c":1,"t":"changed over time. Then there's leisure and tourism."},{"w":0.36984255472819016,"c":1,"t":"That focuses on your visitors, I would imagine.","h":0.017681104946980386,"x":0.17851978898642898,"y":0.73755105739548732},{"c":1,"y":0.75269584251112343,"x":0.17857590981416724,"t":"Yes, mostly. The children find out about them, their requirements, the problems","w":0.62437586466471351,"h":0.017764719960260522},{"t":"they may cause and how we manage these. And another subject we cover is","x":0.17858790664402183,"w":0.60792795817057299,"h":0.014880081896936681,"y":0.76880907533237985,"c":1},{"t":"music: here the children experiment with natural materials to create sounds and","y":0.78334198981083525,"c":1,"h":0.016951849045654943,"x":0.17854988549752535,"w":0.63057469685872392},{"w":0.21593203226725258,"c":1,"x":0.18047119497738237,"t":"explore rhythm and tempo.","y":0.80007711498550926,"h":0.01488379869489187},{"w":0.14168378194173176,"t":"That must be fun!","y":0.81681415921901934,"h":0.010324483775811188,"c":1,"x":0.18069814999422651},{"w":0.22176592508951826,"y":0.83126843664969108,"c":1,"t":"Most children really enjoy it.","h":0.014749262536873142,"x":0.1786447580917912},{"x":0.18061160797578224,"w":0.63878031412760417,"c":1,"t":"And of course, all the activities are educational, too. Learning outside the classroom","y":0.86914364815686451,"h":0.016498151570998099},{"x":0.18061033623258699,"w":0.61000116984049479,"t":"encourages children to be creative, and to explore and discover for themselves.","h":0.016772706248415536,"y":0.88460306090562235,"c":1},{"c":1,"x":0.84599589414940224,"y":0.36627906990487125,"h":0.013081394746943475,"w":0.026694043477376361,"t":"Q1"},{"x":0.84599589403500619,"c":1,"w":0.028747431437174509,"h":0.013081394746943475,"t":"Q2","y":0.47383720954876662},{"y":0.61482558163683476,"w":0.028747431437174509,"x":0.84599589404433972,"t":"Q3","h":0.013081394746943587,"c":1},{"w":0.028747431437174509,"t":"Q4","h":0.013081394746943587,"x":0.84599589404433972,"c":1,"y":0.67732558163683476},{"h":0.011627907316944963,"x":0.84804928206007979,"c":1,"w":0.02669404347737625,"y":0.73837209280843275,"t":"Q5"},{"y":0.78488372116577243,"t":"Q6","x":0.84804928207034669,"h":0.013081394746943587,"c":1,"w":0.02669404347737625},{"y":0.91860465140923164,"t":"99","h":0.013081394746943587,"w":0.02669404347737625,"x":0.8911704319488547,"c":1},{"h":0.04166666666666663,"w":0.45294118245442705,"y":0.94166666659226195,"c":1,"x":0.51176470218665204,"t":"IELTSXpress.com"}],"w":2400,"h":3390}