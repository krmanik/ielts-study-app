{"lines":[{"t":"Test 2","x":0.084165453171638802,"y":0.046456065825004167,"w":0.061648559570312497,"h":0.01319251946643385,"c":1},{"x":0.084188912097736102,"h":0.014749262536873142,"c":1,"y":0.092920353713552228,"t":"Questions 17 and 18","w":0.21560574849446612},{"x":0.084188906976718575,"y":0.12936046513518096,"w":0.254620132446289,"t":"Choose TWO letters, A-E.","h":0.017542189764062188,"c":1},{"w":0.68191253662109375,"c":1,"y":0.162940255718243,"h":0.020271006446320849,"x":0.082036819714751158,"t":"Which TWO things does David say about the lifeboat volunteer training?"},{"t":"The residential course developed his leadership skills.","w":0.51150548299153642,"h":0.018032245017082671,"c":1,"y":0.1915349923983547,"x":0.17648566495476425},{"c":1,"w":0.50942520141601566,"t":"The training in use of ropes and knots was quite brief.","y":0.20926586199613417,"x":0.17444744034526841,"h":0.018317562992242187},{"c":1,"h":0.018918179762398624,"w":0.52999354044596358,"t":"The training exercises have built up his mental strength.","y":0.22685901035916478,"x":0.17443272686125566},{"c":1,"y":0.24557568541532926,"x":0.17446703690426907,"h":0.01827235489116652,"w":0.61205540974934891,"t":"The casualty care activities were particularly challenging for him."},{"h":0.01907560185345214,"x":0.17446098854495479,"t":"The wave tank activities provided practice in survival techniques.","y":0.2630486516112942,"w":0.61412409464518225,"c":1},{"y":0.30959302345811246,"t":"Questions 19 and 20","c":1,"w":0.21765914916992191,"x":0.082135517715830511,"h":0.014595767108388391},{"h":0.022277868040191828,"c":1,"t":"Choose TWO letters, A-E.","y":0.34183100556735591,"w":0.2593877410888672,"x":0.081809908116549007},{"t":"Which TWO things does David find most motivating about the work he does?","h":0.020002129928903933,"x":0.082020166803097261,"c":1,"w":0.72506866455078134,"y":0.37929296157132542},{"x":0.17453798883188285,"t":"working as part of a team","y":0.40843023257129252,"w":0.24024640401204425,"h":0.0