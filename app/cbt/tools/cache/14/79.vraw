{"h":3395,"w":2400,"lines":[{"c":1,"h":0.013250883392226243,"x":0.21193415513910238,"w":0.053497943878173831,"y":0.10747938757983211,"t":"Test 4"},{"c":1,"y":0.14811542990369519,"t":"Questions 14—17","x":0.21193415343553415,"h":0.014723203769140158,"w":0.1563786061604818},{"w":0.37889666239420572,"t":"Reading Passage 2 has six paragraphs, A-F.","h":0.018178949928957744,"c":1,"y":0.17979029045463113,"x":0.20972939147930206},{"c":1,"x":0.20969424201303288,"y":0.21042550137426785,"h":0.017282953251096189,"t":"Which paragraph contains the following information?","w":0.43447540283203123},{"y":0.2402827447943221,"c":1,"x":0.20971622621404881,"h":0.019517559325596734,"w":0.55381744384765619,"t":"Write the correct letter, A-F, in boxes 14-17 on your answer sheet."},{"c":1,"t":"14 a reference to how quickly animal species can die out","x":0.20967489853280738,"w":0.48389907836914059,"y":0.27115843488226021,"h":0.018514573644271892},{"y":0.2957657907446416,"t":"15 reasons why it is preferable to study animals in captivity rather than in the wild","x":0.20768429116306264,"h":0.018388310085337034,"w":0.68541890462239585,"c":1},{"h":0.018945035721023018,"y":0.3192287952335231,"c":1,"x":0.20766313229175248,"t":"16 mention of two ways of learning about animals other than visiting them in zoos","w":0.6875314331054686},{"x":0.20765429136786717,"y":0.34289230895285683,"w":0.60319183349609373,"h":0.019264362726110429,"c":1,"t":"17 reasons why animals in zoos may be healthier than those in the wild"},{"x":0.20781892710991093,"h":0.013250883392226243,"y":0.40400471132428284,"c":1,"w":0.15637860616048174,"t":"Questions 18-22"},{"h":0.018540066178752035,"x":0.20766821576434305,"c":1,"t":"Do the following statements agree with the information given in Reading Passage 2?","w":0.69574961344401043,"y":0.4352033145578269},{"h":0.017158767219426663,"t":"In boxes 18-22 on your answer sheet, write","y":0.46573542680074365,"w":0.36039787292480474,"c":1,"x":0.20763583603580757},{"y":0.49709302312709691,"h":0.011627907185728703,"c":1,"x":0.26954732425432876,"t":"TRUE","w":0.053497943878173804},{"w":0.063786010742187538,"h":0.013081395583944722,"c":1,"x":0.26748971050467785,"t":"FALSE","y":0.51162790681831105},{"w":0.35828346252441406,"h":0.015987773666112148,"c":1,"x":0.38875116703663098,"y":0.49701398738822822,"t":"if the statement agrees with the information"},{"y":0.51262879654177995,"x":0.38877499038277968,"t":"if the statement contradicts the information","w":0.35208229064941404,"h":0.013760244888467388,"c":1},{"c":1,"y":0.52655505765411792,"h":0.017016753431484122,"t":"NOT GIVEN if there is no information on this","x":0.26730712034809972,"w":0.3810410308837891},{"h":0.015456752305317289,"t":"18 An animal is likely to live longer in a zoo than in the wild.","y":0.56669224060119583,"c":1,"w":0.50429011027018222,"x":0.20772955810125798},{"x":0.20563424188365995,"y":0.58986225569706219,"h":0.017736539402614659,"c":1,"w":0.64636118570963541,"t":"19 There are some species in zoos which can no longer be found in the wild."},{"h":0.015545960169096817,"t":"20 Improvements in the quality of TV wildlife documentaries have resulted in increased","y":0.61393454593981267,"w":0.72854375203450528,"x":0.20568486041086687,"c":1},{"t":"numbers of zoo visitors.","x":0.24463194161794027,"c":1,"w":0.20221483866373696,"y":0.62822907095322722,"h":0.015825228921375722},{"x":0.20563269116329158,"w":0.71632410685221348,"c":1,"y":0.65207263125116866,"t":"21 Zoos have always excelled at transmitting information about animals to the public.","h":0.018267826983448421},{"x":0.20561592582962343,"c":1,"w":0.68750066121419273,"t":"22 Studying animals in zoos is less stressful for the animals than studying them in","h":0.017217066599707676,"y":0.67668750556447765},{"y":0.69316843319256805,"w":0.07407407124837237,"h":0.014723203769140158,"c":1,"t":"the wild.","x":0.24279835520947898},{"c":1,"w":0.022633744875590028,"h":0.011627907185728592,"t":"88","x":0.20164609042228732,"y":0.86482558123800246}]}