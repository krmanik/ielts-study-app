{"w":2400,"h":3395,"lines":[{"y":0.11010364044484788,"w":0.049714365005493144,"t":"Test 1","c":1,"x":0.2117683318029035,"h":0.012350858591751446},{"t":"Questions 14-18","y":0.15106007062270088,"w":0.15226337432861328,"h":0.013250883392226132,"c":1,"x":0.20987654302584521},{"c":1,"x":0.20765104617864003,"y":0.18217071795862894,"w":0.40979057312011713,"t":"Reading Passage 2 has seven paragraphs, A-G.","h":0.01877070596557906},{"w":0.434498036702474,"h":0.018473777389076962,"t":"Which paragraph contains the following information?","x":0.20763487917019821,"c":1,"y":0.21196493580984066},{"h":0.019789319437159558,"w":0.55591995239257819,"c":1,"t":"Write the correct letter, A-G, in boxes 14-18 on your answer sheet.","y":0.24263500409835881,"x":0.20764185763194301},{"y":0.27440138117933,"h":0.014990607757029206,"x":0.20972684757585663,"w":0.36861409505208337,"t":"NB You may use any letter more than once.","c":1},{"x":0.2076771999793374,"h":0.016763916285214897,"c":1,"y":0.29766961565851946,"t":"14 a description of how people misused a bike-sharing scheme","w":0.53522577921549475},{"c":1,"h":0.017463736876722424,"x":0.20566798094039779,"y":0.32201379526258533,"t":"15 an explanation of why a proposed bike-sharing scheme was turned down","w":0.64420811971028646},{"h":0.016392893167772038,"c":1,"y":0.3457003755642325,"w":0.512542724609375,"x":0.23652726073862274,"t":"a reference to a person being unable to profit from their work"},{"h":0.019063298076005042,"w":0.6504830932617186,"t":"17 an explanation of the potential savings a bike-sharing scheme would bring","x":0.20562298979872981,"y":0.36906746680259994,"c":1},{"t":"18 a reference to the problems a bike-sharing scheme was intended to solve","y":0.39348318799161697,"w":0.64428721110026044,"c":1,"x":0.20767123698975734,"h":0.017788699434278188},{"c":1,"t":"Questions 19 and 20","x":0.20576131732203037,"y":0.45347467620627746,"h":0.014548579711374909,"w":0.18930040995279948},{"y":0.48424194480415239,"w":0.22083445231119794,"t":"Choose TWO letters, A-E.","h":0.019352426517697752,"c":1,"x":0.20541500044492597},{"w":0.54361963907877608,"t":"Write the correct letters in boxes 19 and 20 on your answer sheet.","c":1,"y":0.51466424422993506,"x":0.20555681089602784,"h":0.018588184046661071},{"w":0.67719889322916671,"h":0.018503863623341665,"c":1,"y":0.54606447744481812,"x":0.20358085311969698,"t":"Which TWO of the following statements are made in the text about the Amsterdam"},{"y":0.56242638384399168,"t":"bike-sharing scheme of 1999?","h":0.014723203769140158,"c":1,"x":0.20370370767219678,"w":0.25102879842122394},{"c":1,"w":0.43656845092773433,"h":0.018407951395418953,"t":"It was initially opposed by a government department.","x":0.2837779770579173,"y":0.58567018189841269},{"w":0.014403292338053403,"h":0.011627907185728592,"x":0.24485596689681691,"c":1,"y":0.60174418585896283,"t":"B"},{"x":0.24279835396452099,"y":0.61627906954667055,"w":0.016460905075073251,"h":0.011627907185728592,"c":1,"t":"C"},{"t":"D","w":0.016460905075073223,"h":0.011627907185728703,"y":0.63226744165907367,"c":1,"x":0.24279835394394486},{"x":0.28382762450195154,"h":0.016482798033805257,"t":"It failed when a partner in the scheme withdrew support.","y":0.60149192728343237,"w":0.46115147908528642,"c":1},{"t":"It aimed to be more successful than the Copenhagen scheme.","w":0.51478729248046873,"y":0.6155940272460132,"x":0.283782118294579,"c":1,"h":0.017623975504413525},{"h":0.01746323364221869,"x":0.28380850460739576,"c":1,"y":0.63220292489376995,"t":"It was made possible by a change in people's attitudes.","w":0.457075449625651},{"y":0.64769256646222273,"w":0.4221115366617838,"h":0.017498021973878397,"c":1,"t":"It attracted interest from a range of bike designers.","x":0.27969084628082586},{"w":0.024691357612609877,"c":1,"y":0.8662790696100956,"t":"22","h":0.011627907185728592,"x":0.19958847746006245}]}