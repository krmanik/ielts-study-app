{"w":2400,"h":3181,"lines":[{"h":0.036056945340428026,"t":"Audioscripts","x":0.083866170370902896,"y":0.089199823154817004,"w":0.25215723673502605,"c":1},{"y":0.15839094906439866,"w":0.098265895843505813,"h":0.017598994343180463,"t":"TEST 1","c":1,"x":0.39884393055983558},{"t":"SECTION 1","x":0.084778419464440632,"y":0.22238372092054259,"w":0.14836223602294923,"h":0.014574167190446241,"c":1},{"t":"OFFICER:","w":0.061737740834554022,"x":0.08473806589209365,"h":0.010456284211912137,"y":0.25276604391180413,"c":1},{"x":0.084740664380404021,"t":"LOUISE.","c":1,"y":0.27021401785558385,"w":0.054025414784749357,"h":0.0089905689078858542},{"y":0.28488372076065893,"t":"OFFICER:","x":0.084778423087776764,"h":0.01017441860465107,"c":1,"w":0.061657028198242189},{"t":"LOUISE:","h":0.0088184273969744709,"y":0.31826520489076504,"x":0.084764636573615895,"w":0.053977470397949215,"c":1},{"w":0.063583812713623053,"h":0.013081395348837122,"y":0.33284883704578494,"c":1,"t":"OFFICER:","x":0.082851639524691365},{"w":0.053949902852376289,"h":0.008720930232558155,"t":"LOUISE:","y":0.35029069765546006,"x":0.084778420367394844,"c":1},{"h":0.008720930232558044,"t":"OFFICER:","x":0.084778419044918091,"y":0.36627906975337587,"w":0.061657034556070967,"c":1},{"t":"LOUISE:","x":0.084778420334890844,"y":0.38226744184302319,"h":0.008720930232558155,"c":1,"w":0.053949902852376316},{"y":0.39804028713514117,"c":1,"t":"OFFICER:","x":0.082783543294248002,"w":0.063720003763834632,"h":0.012058960574741762},{"h":0.011627906976744207,"t":"LOUISE:","w":0.055876687367757152,"y":0.41424418600775192,"c":1,"x":0.082851636926269137},{"c":1,"t":"OFFICER:","x":0.084778419044918091,"y":0.47965116277663167,"h":0.008720930232558155,"w":0.061657034556070967},{"y":0.49553737362932093,"w":0.054007333119710288,"h":0.0089252527070300403,"c":1,"t":"LOUISE.","x":0.084749705205486831},{"t":"OFFICER:","y":0.51017441841085276,"w":0.061657028198242175,"x":0.084778423152002846,"h":0.011627906976744207,"c":1},{"x":0.082835548458470326,"y":0.52756579125556391,"w":0.055908864339192704,"c":1,"h":0.010275394192736931,"t":"LOUISE:"},{"h":0.013081395348837122,"c":1,"t":"OFFICER:","x":0.084778421430141415,"y":0.57412790688330573,"w":0.063583812713623039},{"w":0.054053052266438792,"h":0.010490066221418237,"y":0.59141194360854943,"c":1,"t":"LOUISE:","x":0.084726845648795027},{"h":0.0088796058141682455,"w":0.053994611104329418,"t":"LOUISE.","c":1,"x":0.084756066216991124,"y":0.60893229009972805},{"t":"OFFICER.","x":0.086691177062858407,"w":0.059758300781250009,"c":1,"h":0.008830869520032647,"y":0.64674735592293997},{"c":1,"t":"LOUISE.","x":0.084778420339040844,"w":0.053949902852376302,"y":0.67877906975067082,"h":0.008720930232558155},{"y":0.69331395331879853,"w":0.059730250040690103,"h":0.010174418604651181,"t":"OFFICER:","x":0.086705203335467385,"c":1},{"t":"LOUISE:","h":0.008720930232558155,"y":0.71075581393604648,"c":1,"w":0.053949902852376316,"x":0.084778420334890844},{"w":0.059860871632893886,"x":0.086639892537101887,"y":0.75704476502591722,"h":0.010619771922631194,"c":1,"t":"OFFICER:"},{"x":0.084778420338423269,"w":0.053949902852376289,"y":0.77470930230438462,"c":1,"t":"LOUISE:","h":0.010174418604651181},{"w":0.059730250040690103,"y":0.85319767440043603,"h":0.010174418604651181,"x":0.086705202432861672,"t":"OFFICER:","c":1},{"t":"LOUISE:","h":0.010174418604651181,"c":1,"x":0.08477842040150245,"y":0.86918604647529074,"w":0.053949902852376316},{"t":"Good morning. What can I do for you?","w":0.29886622111002603,"x":0.17906634707262184,"c":1,"y":0.25139502658050161,"h":0.017002580452085136},{"x":0.17919074809961291,"c":1,"w":0.56840077718098958,"y":0.26889534883419519,"h":0.013081395348837122,"t":"I want to report a theft. I had some things stolen out of my bag yesterday."},{"w":0.63583816528320314,"t":"I'm sorry to hear that. Right, so I'll need to take a few details. Can I start with your","h":0.015988372093023284,"x":0.17726396154949262,"y":0.28488372092707281,"c":1},{"w":0.10789980570475258,"y":0.31678189804643297,"t":"Louise Taylor.","x":0.17919075229213235,"h":0.013199245757385292,"c":1},{"c":1,"y":0.33128983696967396,"h":0.017311762744416814,"t":"OK, thank you. And are you resident in the UK?","x":0.17908560534710205,"w":0.37013348897298182},{"h":0.014534883720930258,"y":0.34883720929913808,"w":0.44894027709960938,"c":1,"t":"No. I'm actually Canadian, though my mother was British.","x":0.17919074767158938},{"h":0.013081395348837122,"x":0.17919075201025578,"c":1,"t":"And your date of birth?","y":0.36482558138831589,"w":0.17919075012207034},{"y":0.38081395348076663,"t":"December 14th, 1977.","w":0.17341040293375648,"c":1,"h":0.013081395348837233,"x":0.18111753446537071},{"y":0.39528440057820546,"h":0.017495210480944823,"x":0.17909078962422323,"w":0.2719040171305338,"c":1,"t":"So you're just visiting this country?"},{"h":0.013081395348837344,"w":0.62813100179036463,"y":0.41279069767240606,"x":0.18111754332417451,"c":1,"t":"That's right. I come over most summers on business. I'm an interior designer and"},{"x":0.17726397113316997,"y":0.42866121935679935,"h":0.014770584538026377,"c":1,"t":"I come over to buy old furniture, antiques you know. There are some really lovely Q2","w":0.66859344482421879},{"x":0.17720385066313629,"t":"things around here, but you need to get out to the small towns. I've had a really","y":0.44361201981485476,"w":0.61669494628906252,"h":0.017636314118755214,"c":1},{"t":"good trip this year, until this happened.","c":1,"y":0.4622093023203151,"x":0.17726396570317804,"w":0.30635838826497397,"h":0.014534883720930258},{"h":0.016027655562539267,"c":1,"t":"OK. So you've been here quite a while?","x":0.17919075208375668,"w":0.31021194458007811,"y":0.47674418604148383},{"c":1,"y":0.49273255813298233,"x":0.17919075356331302,"w":0.39499036153157552,"t":"Yes, I'm here for two months. I go back next week.","h":0.016066939032055361},{"y":0.50872093022807197,"w":0.31599230448404947,"t":"So may I ask where you're staying now?","h":0.014534883720930258,"c":1,"x":0.17919074554217568},{"w":0.6109077962239583,"t":"Well at present I've got a place at Park Apartments, that's on King Street. I was","h":0.016527487600771273,"x":0.1810651979971282,"y":0.52407799459829618,"c":1},{"w":0.025048170089721711,"h":0.013081395348837233,"c":1,"t":"Q3","x":0.8208092481921333,"y":0.52470930227526835},{"x":0.17726396776214784,"w":0.62235066731770838,"h":0.014770584538026377,"c":1,"y":0.54054054035885457,"t":"staying at the Riverside Apartments on the same street, but the apartment there"},{"y":0.55656819609837427,"w":0.47591522216796878,"x":0.1791907510533578,"h":0.013199245757385292,"c":1,"t":"was only available for six weeks so I had to find another one."},{"w":0.25433525085449216,"t":"OK. And the apartment number?","x":0.17919075598404297,"h":0.014613450659962224,"c":1,"y":0.5725958516596622},{"c":1,"t":"Fifteen.","x":0.17888115875548455,"w":0.062300847371419277,"h":0.012373825351372325,"y":0.59023787740102773},{"x":0.17919075146818655,"t":"Right.","y":0.60610465112975687,"w":0.046242774327596048,"h":0.014534883720930258,"c":1},{"h":0.014534883720930147,"c":1,"x":0.17919074458152559,"y":0.64389534883478683,"w":0.61271677652994794,"t":"Now, I need to take some details of the theft. So you said you had some things"},{"h":0.014534883720930258,"x":0.17919075416462041,"w":0.18111752827962238,"t":"stolen out of your bag?","c":1,"y":0.65988372091476999},{"t":"That's right.","x":0.17886454858065037,"w":0.093081035614013652,"h":0.014419848180131867,"y":0.67576107451931366,"c":1},{"t":"And were you actually carrying the bag when the theft took place?","x":0.17919074139457791,"h":0.014613450659962224,"w":0.51445088704427089,"c":1,"y":0.69186046511237187},{"y":0.70773098679813062,"w":0.56069366455078129,"x":0.17919073987843195,"h":0.014770584538026377,"c":1,"t":"Yes. I really can't understand it. I had my backpack on. And I went into a"},{"t":"supermarket to buy a few things and when I opened it up my wallet wasn't","x":0.17919075844455781,"w":0.57803466796875003,"c":1,"y":0.72375864235984932,"h":0.014613450659962335},{"t":"And what did your wallet have in it?","x":0.17919075080637464,"y":0.75581395348072222,"h":0.014534883720930258,"c":1,"w":0.28516377766927087},{"t":"Well, fortunately I don't keep my credit cards in that wallet - I keep them with","x":0.17913082369608305,"w":0.59744222005208336,"y":0.77092129660284958,"h":0.017735289448391089,"c":1},{"y":0.78779069766977994,"x":0.18111753592508364,"h":0.013081395348837233,"w":0.59730250040690103,"t":"my passport in an inside compartment in my backpack. But there was quite a","c":1},{"h":0.015988372093023284,"c":1,"t":"bit of cash there ... about £250 sterling, I should think. I withdrew £300 from my","x":0.17919075085781486,"y":0.8037790697613395,"w":0.61849711100260418},{"w":0.63198460896809894,"y":0.81976744185700445,"x":0.18111752208005935,"c":1,"h":0.013081395348837233,"t":"account yesterday, but I did a bit of shopping, so I must have already spent about"},{"x":0.17915246791531506,"y":0.83560010008219987,"h":0.013392823061652348,"t":"£50 of that.","c":1,"w":0.092562115987141952},{"h":0.013081395348837233,"x":0.18111753362008182,"t":"OK.","w":0.032755298614501965,"c":1,"y":0.8517441859997924},{"t":"At first I thought, oh I must have left the wallet back in the apartment, but then","x":0.1791907618610685,"c":1,"w":0.60500961303710932,"h":0.014613450659962335,"y":0.86627906976301039},{"h":0.016106222501571343,"c":1,"y":0.88214959143922789,"w":0.60693639119466147,"t":"I realised my phone had gone as well. It was only a week old, and that's when","x":0.17919076419561664},{"w":0.57430694580078123,"y":0.89800407765010848,"x":0.17913003801838595,"c":1,"h":0.017338746152982143,"t":"I realised I'd been robbed. Anyway at least they didn't take the keys to my"},{"x":0.17915285185273072,"w":0.08292743682861331,"y":0.91701326481686052,"c":1,"t":"rental car.","h":0.013357191247658329},{"t":"Q5","h":0.014534883720930258,"w":0.02697495142618811,"x":0.82080924885337991,"c":1,"y":0.8808139533066861},{"t":"Example","y":0.31616788886764002,"w":0.075547148386637342,"c":1,"x":0.81868114579369433,"h":0.014466547651308836},{"w":0.0250481700897216,"x":0.82080924818410517,"y":0.34883720925387596,"h":0.011627906976744207,"t":"Q1","c":1},{"x":0.87861271688485065,"y":0.94912790691012583,"h":0.015988372093023284,"c":1,"w":0.026974951426188221,"t":"97"}]}