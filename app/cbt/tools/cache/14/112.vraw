{"w":2400,"lines":[{"w":0.059500961303710964,"y":0.042151162856537194,"c":1,"h":0.015988371561634906,"t":"Test 4","x":0.84452974902664735},{"t":"TEST 4","x":0.40105199708971734,"h":0.018105464204112409,"c":1,"y":0.088330988351833062,"w":0.10000733057657879},{"c":1,"t":"SECTION 1","y":0.1525851198475584,"w":0.14779270172119141,"x":0.088291750195066451,"h":0.017473019387051592},{"c":1,"w":0.061571388244628905,"t":"ANDREW:","h":0.0093508007246789759,"x":0.088216225170365259,"y":0.1857315763687355},{"w":0.03454894383748372,"x":0.088291746763279874,"h":0.010174418157166354,"t":"SAM:","c":1,"y":0.20203488390227919},{"w":0.061512387593587251,"x":0.088245725495981323,"c":1,"t":"ANDREW:","y":0.26582716345897373,"h":0.010496835840905883},{"x":0.086372360311528756,"y":0.29796511633067346,"c":1,"t":"SAM:","w":0.036468331019083658,"h":0.011627906808937327},{"w":0.063412030537923172,"t":"ANDREW:","x":0.086336211817457501,"y":0.31239924763482729,"h":0.013282899748331967,"c":1},{"x":0.086372362015615947,"c":1,"t":"SAM:","y":0.32994186040367091,"h":0.011627906808937327,"w":0.036468327840169262},{"w":0.061643778483072911,"t":"ANDREW.","x":0.08818003004867879,"h":0.0096701078426943976,"y":0.34690913211005481,"c":1},{"t":"SAM.","x":0.088291746795269646,"h":0.0087209301067029399,"y":0.39534883724800507,"c":1,"w":0.03454894383748372},{"t":"ANDREW.","y":0.41120194890683393,"w":0.061497764587402345,"h":0.010444939361995642,"x":0.088253036999349541,"c":1},{"w":0.036468331019083658,"c":1,"x":0.086372360311528756,"y":0.459302325632999,"h":0.011627906808937327,"t":"SAM:"},{"y":0.47520783209364015,"h":0.011793638087461478,"t":"ANDREW:","x":0.086345919568975638,"w":0.063392613728841141,"c":1},{"c":1,"h":0.010174418157166243,"t":"SAM:","w":0.03454894383748372,"x":0.088291747131162168,"y":0.52325581405005062},{"h":0.0095540794718911304,"w":0.061617800394694,"t":"ANDREW.","c":1,"x":0.08819301909281857,"y":0.54028109978400995},{"h":0.011627906808937327,"c":1,"y":0.57122093021956233,"t":"SAM:","x":0.086372360514130594,"w":0.036468331019083658},{"c":1,"x":0.088222907248430571,"y":0.58841978134088768,"t":"ANDREW:","h":0.010660437286877156,"w":0.061558024088541663},{"c":1,"x":0.086274467231863994,"h":0.011983303825310987,"y":0.6364502085210495,"w":0.036664117177327482,"t":"SAM:"},{"x":0.08631532262423719,"y":0.65243609118638468,"t":"ANDREW:","w":0.063453807830810532,"c":1,"h":0.011988282654655236},{"c":1,"x":0.088291746795269646,"y":0.70203488375963286,"t":"SAM.","w":0.03454894383748372,"h":0.0087209301067030509},{"t":"ANDREW.","h":0.0089842879306173407,"w":0.061484826405843102,"x":0.088259506087009193,"y":0.71789157695088601,"c":1},{"c":1,"h":0.0088194724440123773,"y":0.74995072886888103,"x":0.088270092035976702,"w":0.034592253367106113,"t":"SAM."},{"y":0.76575227250738331,"h":0.0091931293771366773,"w":0.061534608205159505,"c":1,"x":0.088234615190159307,"t":"ANDREW."},{"w":0.03454894383748372,"t":"SAM:","y":0.78197674421990415,"c":1,"x":0.088291746788871708,"h":0.0087209301067030509},{"c":1,"t":"ANDREW:","y":0.79796511648640189,"w":0.063339729309082049,"x":0.088291747533558784,"h":0.010174418157166243},{"t":"SAM.","x":0.09021113168208908,"c":1,"h":0.0087209301067030509,"w":0.032629559834798177,"y":0.82994186049897412},{"y":0.86009397052498082,"h":0.010916709899902344,"x":0.090110448071601304,"t":"ANDREW:","w":0.063541100819905591,"c":1},{"x":0.18226516688761307,"c":1,"w":0.60667175292968756,"t":"Good morning, Clare House Hotel. Andrew speaking. I'm the Events Manager.","y":0.18291503944582599,"h":0.017766750475196824},{"x":0.18223383518847205,"h":0.019735246107527082,"y":0.1974812826635477,"w":0.58177495320638017,"c":1,"t":"Good morning, Andrew. My name's Samantha. I'm arranging a party for my"},{"x":0.18042226389596408,"t":"parents fiftieth wedding anniversary, and I'm ringing to ask about hiring a room","y":0.21656976770430503,"h":0.01609101421745851,"w":0.61036468505859376,"c":1},{"t":"some time next September. Also my parents and several of the guests will need","c":1,"x":0.18042225478084012,"y":0.23255813979786799,"w":0.61804224650065098,"h":0.015988371561634906},{"c":1,"t":"accommodation.","x":0.18203831810006638,"y":0.24606025312620505,"h":0.015750574734893497,"w":0.13128238677978515},{"h":0.016078184110971061,"x":0.18234165784282122,"w":0.61420344034830732,"c":1,"y":0.26450189142256086,"t":"OK, I'm sure we can help you with that. Will you be having a sit-down meal or a"},{"x":0.18042226623665503,"h":0.013081395460708412,"c":1,"y":0.2790697672551109,"t":"buffet?","w":0.05758157094319663},{"x":0.18204662188923096,"y":0.29637100439576503,"t":"Probably a sit-down.","w":0.16179449717203773,"c":1,"h":0.01594111958488087},{"h":0.013240857503152625,"y":0.31242118531260865,"w":0.36660268147786457,"c":1,"t":"And do you know how many people there'll be?","x":0.182341653406941},{"x":0.18042226273552137,"w":0.17274472554524739,"t":"Around eighty, I think.","h":0.014534884112479607,"c":1,"y":0.32848837187861413},{"x":0.17844475995500658,"t":"Well we have two rooms that can hold that number. One is the Adelphi Room.","w":0.60472742716471362,"h":0.015232317083871072,"c":1,"y":0.34437028214422261},{"x":0.18226382061281518,"h":0.017536379800919266,"c":1,"t":"That can seat eighty-five. or hold over a hundred if people are standing for a","y":0.359099573090364,"w":0.58940541585286454},{"t":"Q1","x":0.81957773487015018,"y":0.36046511616862831,"w":0.026871401468912759,"c":1,"h":0.013081395460708412},{"h":0.013265535179032395,"x":0.18038185322203082,"t":"buffet.","w":0.051904239654541023,"y":0.37636141834770065,"c":1},{"t":"Right.","x":0.18218792390428037,"y":0.39357939332363578,"w":0.046372712453206372,"h":0.013713306316361251,"c":1},{"y":0.40843023235980591,"h":0.01464669070057445,"c":1,"t":"If you have live music, there's room for four or five musicians in the gallery","x":0.18234166126203719,"w":0.5738963317871093},{"x":0.18042226341457696,"c":1,"t":"overlooking the room. Our guests usually appreciate the fact that the music can","w":0.61612284342447921,"h":0.01607818411097095,"y":0.42433795689538978},{"h":0.015979850427500053,"x":0.18228822698204225,"y":0.43985004687889084,"c":1,"w":0.479945068359375,"t":"be loud enough for dancing, but not too loud for conversation."},{"x":0.18042226140953393,"y":0.45775535948836565,"c":1,"w":0.33973129272460939,"h":0.014628361633416298,"t":"Yes, I really don't like it when you can't talk."},{"h":0.014538549685388036,"c":1,"x":0.1823416492016085,"t":"Exactly. Now the Adelphi Room is at the back of the hotel, and there are French","y":0.47383354353118723,"w":0.61612284342447921},{"y":0.48982558133438192,"t":"windows leading out onto the terrace. This has a beautiful display of pots of","x":0.18234166041721722,"w":0.5854126485188802,"h":0.013081395460708412,"c":1},{"c":1,"y":0.50192939089127619,"t":"roses at that time of the yeart","h":0.021657639463792733,"x":0.18196021687116912,"w":0.24653592427571616},{"x":0.81957773487015018,"y":0.50581395337793067,"t":"Q2","h":0.013081395460708412,"c":1,"w":0.026871401468912759},{"h":0.013240857503152625,"c":1,"x":0.18042226253471569,"y":0.52175283727906574,"t":"Which direction does it face?","w":0.22648752848307294},{"c":1,"t":"Southwest, so that side of the hotel gets the sun in the afternoon and early","y":0.53779069747548414,"x":0.18234165259756746,"h":0.014542215258296465,"w":0.5758157348632813},{"x":0.18234165106685657,"t":"evening.","w":0.06909788767496744,"h":0.010174418157166243,"c":1,"y":0.55668604671895994},{"y":0.5710034135404144,"w":0.079794457753499359,"x":0.18170220971595863,"h":0.014234687761881637,"t":"Very nice.","c":1},{"x":0.1842610311855063,"w":0.66218811035156244,"y":0.58575031553459633,"c":1,"h":0.013240857503152514,"t":"From the terrace you can see the area of trees within the grounds of the hotel, or Q3"},{"h":0.01464302512766591,"x":0.18042226391415747,"w":0.61036468505859376,"t":"you can stroll through there to the river - that's on the far side, so it isn't visible","y":0.60308953320502001,"c":1},{"t":"from the hotel.","h":0.013053491166681197,"c":1,"w":0.11373493194580081,"y":0.61786809103578988,"x":0.18212863745710833},{"x":0.18234165071754677,"c":1,"w":0.030710172653198253,"h":0.013081395460708523,"t":"OK.","y":0.63372093006761088},{"t":"Then another option is the Carlton Room. This is a bit bigger - it can hold up to a","x":0.18234165686925621,"y":0.64970930258872162,"w":0.6257197570800781,"h":0.016116674430433409,"c":1},{"x":0.18037783505429558,"y":0.66558740854259302,"t":"hundred and ten people - and it has the advantage of a stage. which is useful if","h":0.017317013061061592,"c":1,"w":0.62772649129231772},{"c":1,"t":"Q4","x":0.80230326290310161,"h":0.013081395460708523,"y":0.66569767423185511,"w":0.044145873387654633},{"h":0.013081395460708412,"c":1,"x":0.18234165803956898,"t":"you have any entertainment, or indeed a small band can fit onto it.","y":0.68313953482415157,"w":0.51247599283854162},{"c":1,"y":0.69912790691666882,"h":0.013081395460708523,"t":"And can you go outside from the room?","x":0.18426104000889248,"w":0.30710172017415366},{"w":0.60844528198242187,"h":0.014644857914120069,"t":"No, the Carlton Room is on the first floor, but on one side the windows look out","x":0.18426104413385283,"y":0.71500630507005258,"c":1},{"h":0.012718031114768213,"y":0.7311444480952648,"c":1,"x":0.18410880459934015,"t":"onto the lake.","w":0.10595329920450847},{"w":0.42034548441569008,"t":"Lovely. I think either of those rooms would be suitable.","y":0.74709302319545901,"h":0.013081395460708412,"x":0.18426103892186915,"c":1},{"w":0.47039082845052083,"x":0.18228532555587842,"t":"Can I tell you about some of the options we offer in addition?","y":0.76159749994031911,"h":0.016876185827267243,"c":1},{"y":0.77949420259162483,"x":0.18203721606823328,"h":0.013543987634954679,"w":0.083086585998535162,"t":"Please do.","c":1},{"y":0.7950581393366456,"w":0.61612284342447909,"t":"As well as a meal, you can have an MC, a Master of Ceremonies, who'll be with","h":0.014534884112479496,"x":0.18426103501341837,"c":1},{"c":1,"t":"you throughout the party.","y":0.81242118516679218,"w":0.19385796864827476,"x":0.1823416489896697,"h":0.014613698740474468},{"x":0.18426104561802853,"t":"What exactly is the MC's function? I suppose they make a speech during the","y":0.82692307707431456,"w":0.59117080688476564,"h":0.013240857503152514,"c":1},{"t":"Q5","w":0.026871401468912759,"x":0.82149712067541969,"y":0.82558139523344087,"h":0.013081395460708412,"c":1},{"h":0.013240857503152625,"t":"meal if we need one, do they?","c":1,"x":0.18426103773581795,"y":0.8430012611114106,"w":0.23416506449381511},{"t":"That's right. All our MCs are trained as public speakers, so they can easily get","c":1,"h":0.017799043114218427,"y":0.85711001363310935,"x":0.18228555506430591,"w":0.60473968505859377},{"t":"people's attention - many guests are glad to have someone who can make","h":0.015407971145225741,"y":0.87349863431870733,"c":1,"w":0.57976292928059903,"x":0.18420519326126888},{"y":0.8893153322910361,"x":0.18228629106656019,"w":0.61431772867838541,"c":1,"h":0.017180351411259065,"t":"themselves heard above the chatter! And they're also your support - if anything"},{"y":0.88953488361048882,"x":0.82149712066669522,"t":"Q6","w":0.026871401468912759,"h":0.013081395460708412,"c":1},{"w":0.41480763753255212,"h":0.017093796748080647,"x":0.18411811989940352,"y":0.9050736650759168,"c":1,"t":"goes wrong, the MC will deal with it, so you can relax."},{"h":0.017124475476720802,"c":1,"t":"Example","x":0.81736590112334118,"y":0.18214423955835901,"w":0.077266864776611266},{"w":0.036468331019083644,"c":1,"y":0.95058139525656449,"h":0.013081395460708412,"t":"113","x":0.86756237950538662}],"h":3172}