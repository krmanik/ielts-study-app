{"w":2400,"h":3395,"lines":[{"w":0.057846934000651051,"t":"Test 1","h":0.017830716145473824,"c":1,"y":0.10591022317889331,"x":0.20770204764498057},{"h":0.020453269967482424,"y":0.14680232538238414,"c":1,"t":"WRITING TASK 2","x":0.20781892689516449,"w":0.2139917755126953},{"w":0.40598589579264327,"c":1,"t":"You should spend about 40 minutes on this task.","x":0.20544112900279971,"y":0.17860359270951032,"h":0.022351436817182657},{"x":0.20538650870551559,"h":0.021468705086320483,"w":0.25999369303385422,"c":1,"y":0.20904829552526061,"t":"Write about the following topic:"},{"x":0.22427983072545876,"t":"Some people believe that it is best to accept a bad situation, such as an","y":0.25581395332418,"w":0.63991770426432304,"c":1,"h":0.017448708362377219},{"c":1,"x":0.22407088644801093,"y":0.26969460880081297,"w":0.67323318481445305,"h":0.023099088275671309,"t":"unsatisfactory job or shortage of money. Others argue that it is better to try"},{"t":"and improve such situations.","w":0.27452659606933594,"c":1,"x":0.22387563208609193,"y":0.28291090092606797,"h":0.02366445876122647},{"w":0.47772481282552082,"h":0.019654416644811934,"t":"Discuss both these views and give your own opinion.","c":1,"x":0.22615541211232312,"y":0.31597022821426424},{"w":0.65456125895182304,"c":1,"t":"Give reasons for your answer and include any relevant examples from your own","x":0.20974038239264162,"h":0.017603010957176535,"y":0.35750253754090089},{"y":0.37281993163225757,"x":0.20755400153587208,"h":0.015349536397010644,"c":1,"w":0.21247770945231118,"t":"knowledge or experience."},{"y":0.40383085485268977,"h":0.014847379129542371,"w":0.20619575500488282,"c":1,"t":"Write at least 250 words.","x":0.20555859476207797},{"x":0.19958847762373622,"t":"30","w":0.024691357612609877,"y":0.86482558167592327,"h":0.013081394460653373,"c":1}]}