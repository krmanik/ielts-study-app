{"w":2400,"h":3395,"lines":[{"t":"Test 3","c":1,"w":0.053497943878173831,"x":0.20987654236132461,"h":0.013250883392226243,"y":0.10895170803628051},{"c":1,"x":0.20987654232207872,"w":0.14403292338053389,"t":"Questions 7-13","y":0.14958775028484539,"h":0.013250883392226132},{"w":0.662888437906901,"c":1,"y":0.17940038409890269,"t":"Look at the following statements (Questions 7-13) and the list of theories below.","x":0.20765463603167386,"h":0.019864060993890931},{"t":"Match each statement with the correct theory, A, B, or C.","w":0.46938919067382812,"h":0.018144086336780552,"x":0.20975010973531349,"y":0.21182552769166674,"c":1},{"h":0.021724622297343177,"t":"Write the correct letter, A, B, or C, in boxes 7-13 on your answer sheet.","c":1,"x":0.20760478591090739,"y":0.24118711882989996,"w":0.59300308227539067},{"h":0.018852633778422723,"y":0.27167746899913392,"x":0.20757382238625713,"w":0.37295374552408855,"c":1,"t":"NB You may use any letter more than once."},{"c":1,"t":"7 It is desirable for the same possibilities to be open to everyone.","y":0.30146830117813916,"h":0.020316972047336179,"x":0.20556581403124871,"w":0.56630503336588534},{"t":"8 No section of society should have preferential treatment at the expense of another.","h":0.019523485810512331,"x":0.20562880491534466,"y":0.32678176605498466,"w":0.72660140991210942,"c":1},{"w":0.66691329956054668,"h":0.018680884223102212,"x":0.20563719710971601,"t":"9 People should only gain benefits on the basis of what they actually achieve.","c":1,"y":0.3512131842252677},{"y":0.37366949783203296,"w":0.36260426839192705,"c":1,"t":"10 Variation in intelligence begins at birth.","h":0.018859700404010971,"x":0.20553975933916538},{"t":"11 The more intelligent people should be in positions of power.","x":0.20576132015765361,"w":0.53292180379231779,"y":0.39958775026324922,"h":0.016195524146054185,"c":1},{"x":0.20563042471038803,"y":0.42269640083689897,"w":0.38298665364583329,"h":0.01707339427215615,"c":1,"t":"12 Everyone can develop the same abilities."},{"h":0.019360714160932657,"c":1,"x":0.20557166473523278,"t":"13 People of low intelligence are likely to lead uncontrolled lives.","w":0.54770772298177084,"y":0.4458683110547742},{"c":1,"t":"List of Theories","x":0.49794239011019481,"y":0.49116607761418307,"h":0.013250883392226132,"w":0.14197530110677081},{"x":0.49563713147527438,"h":0.014508973021670091,"t":"A Hamiltonian","y":0.51481132457545653,"w":0.14252868652343748,"c":1},{"t":"B Jeffersonian","w":0.14403292338053392,"x":0.4979423858405973,"h":0.011778563015312105,"y":0.53916372176012572,"c":1},{"c":1,"x":0.49588477369703127,"h":0.013081395583944722,"t":"C","w":0.016460905075073307,"y":0.56249999977343468},{"y":0.56395348826569991,"w":0.10288065592447915,"c":1,"h":0.010174418787512574,"t":"Jacksonian","x":0.53086419866569556},{"y":0.86482558123271702,"x":0.19958847746941524,"w":0.024691357612609877,"h":0.011627907185728592,"c":1,"t":"62"}]}