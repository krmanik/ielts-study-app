.034749034245808913,"h":0.010174418632478699,"c":1},{"y":0.49704108634320199,"c":1,"w":0.061810417175292981,"x":0.098438420674374333,"t":"ANGELA:","h":0.011731780756970678},{"t":"MAN:","w":0.034784520467122396,"x":0.10036835743631466,"y":0.51304117338308208,"c":1,"h":0.0088013741123481593},{"t":"ANGELA:","h":0.010174418632478588,"y":0.52906976740759792,"w":0.059845561981201167,"x":0.10038609923719866,"c":1},{"w":0.036679534912109388,"y":0.56104651158573093,"t":"MAN:","x":0.09845559924814952,"h":0.010174418632478588,"c":1},{"x":0.10030690133141339,"c":1,"t":"ANGELA:","y":0.57535373573949011,"w":0.058073457082112631,"h":0.012083225896397431},{"x":0.098455599242787031,"t":"MAN.","y":0.60901162794594565,"w":0.036679534912109388,"h":0.011627906837606949,"c":1},{"c":1,"y":0.65545424885594461,"t":"ANGELA:","x":0.10036484364660722,"w":0.057957572937011731,"h":0.010312432177841613},{"w":0.036679534912109388,"c":1,"h":0.010174418632478588,"t":"MAN:","x":0.098455599242787031,"y":0.68895348833140446},{"h":0.010588860122891286,"t":"ANGELA:","y":0.70328115121053203,"x":0.10032309472493686,"w":0.058041070302327469,"c":1},{"x":0.09845559924814952,"t":"MAN.","y":0.72093023243651866,"w":0.036679534912109388,"h":0.0087209304273503374,"c":1},{"y":0.73536367971939243,"t":"ANGELA:","w":0.057986354827880851,"h":0.011830779809126168,"c":1,"x":0.10035045246146991},{"w":0.034749034245808913,"y":0.76744186057965591,"t":"MAN:","h":0.0087209298290602533,"x":0.10038610079215346,"c":1},{"x":0.098441591831477188,"y":0.78192985362048606,"w":0.059873574574788424,"c":1,"h":0.010268199398945299,"t":"ANGELA:"},{"x":0.098455599556493564,"y":0.81395348829631264,"c":1,"w":0.036679534912109388,"h":0.011627906837606949,"t":"MAN:"},{"c":1,"y":0.85319767434282445,"w":0.03861003875732423,"t":"MAN:","h":0.011627906837606949,"x":0.096525096692766446},{"x":0.098439731326271721,"h":0.0088451689429385194,"w":0.059877293904622389,"c":1,"t":"ANGELA:","y":0.90400764807234268},{"w":0.26271784464518233,"h":0.016275249131799785,"c":1,"x":0.19488070560585308,"t":"Hello, Flanders conference hotel.","y":0.18899347543965239},{"h":0.014534883247863672,"t":"Oh, hi. I wanted to ask about conference facilities at the hotel. Have | come","y":0.20639534907110946,"w":0.58494206746419275,"x":0.19498070361507228,"c":1},{"c":1,"y":0.22231593386784487,"w":0.2183582305908203,"x":0.19490866328666309,"h":0.014289632196557989,"t":"through to the right person?"},{"w":0.62548263549804684,"c":1,"x":0.19498068987585593,"t":"You have. I'm the customer services manager. My name's Angela. So how can I","h":0.014534883247863672,"y":0.23837209325751807},{"w":0.089325345357259112,"c":1,"y":0.23595315979146592,"h":0.016465773396988626,"x":0.81827169017390877,"t":"Exampie"},{"x":0.1928140434672182,"t":"help you?","h":0.015578763547775321,"y":0.25425169047074236,"w":0.081750214894612594,"c":1},{"h":0.014534883247863783,"c":1,"x":0.19498070293484907,"t":"Well, I'm calling from Barrett and Stansons, we're a medical company based in","y":0.27034883744349125,"w":0.61196909586588544},{"h":0.017565121764370861,"c":1,"x":0.19491788796557405,"t":"And we're organising a conference for our clients to be held in Sydney. Itill be","y":0.31667815024882917,"w":0.60050582885742188},{"t":"held over two days and we're expecting about fifty or sixty people.","x":0.19490841645542389,"c":1,"y":0.33368846866382973,"h":0.017837924071806177,"w":0.51365219116210936},{"y":0.35029069781260436,"t":"When were you thinking of having it?","w":0.28764478047688802,"x":0.19691120062457809,"h":0.013081395042735311,"c":1},{"h":0.016092323150060373,"c":1,"t":"Some time early next year, like the end of January? It'd have to be a weekend","x":0.1949806866940012,"y":0.36627906948553368,"w":0.60617762247721352},{"c":1,"t":"Let me see ... our conference facilities are already booked for the weekend","x":0.19691120019321262,"h":0.013081395042735311,"w":0.58301157633463541,"y":0.38226744201043084},{"y":0.39825581418623646,"t":"beginning January 28th. We could do the first weekend in February?","x":0.19498068500816315,"w":0.53281855265299483,"c":1,"h":0.014542178198265199},{"h":0.014551296736694419,"t":"How about January 21st?","y":0.41424418627029502,"x":0.19498069712394966,"w":0.20077219645182293,"c":1},{"y":0.42941249599175269,"t":"I'm afraid that's booked too.","x":0.19482889408048465,"w":0.22040939331054688,"h":0.01545567255247482,"c":1},{"h":0.014569533813553193,"x":0.19498069777282603,"w":0.31467180887858071,"t":"Well, let's go for the February date then.","y":0.44622093046159916,"c":1},{"h":0.016407510716762497,"c":1,"t":"So that's the weekend beginning the 4th.","x":0.19486699372315533,"y":0.46215346099237786,"w":0.32068812052408857},{"y":0.47804266009745766,"w":0.56563705444335932,"h":0.014742785445420292,"t":"OK. Now can you tell me a bit about what conference facilities you have?","x":0.19691120241826743,"c":1},{"w":0.47504811604817709,"c":1,"y":0.49341898686079144,"h":0.017612877274995387,"t":"Sure. So for talks and presentations we have the Tesla room.","x":0.19489673341104832},{"h":0.014547649560638698,"x":0.19498069596268711,"y":0.52760351299115071,"c":1,"w":0.60038609822591149,"t":"Tesla - that's spelled T-E-S-L-A. It holds up to a hundred people, and it's fully"},{"y":0.5436010035338904,"x":0.19691120231894643,"h":0.013174404015056429,"c":1,"w":0.28378377278645833,"t":"equipped with a projector and so on."},{"x":0.194980693214933,"w":0.2084942118326823,"y":0.55803011265224622,"t":"How about a microphone?","h":0.014742785445420292,"c":1},{"t":"Yes, that'll be all set up ready for you, and there'll be one that members of the","x":0.19685356488111749,"w":0.60048863728841151,"h":0.015997995546501276,"c":1,"y":0.57410369870262845},{"h":0.014742785445420292,"t":"audience can use too, for questions, if necessary.","c":1,"x":0.19691119788451497,"w":0.38223937988281254,"y":0.59002509391303537},{"c":1,"t":"Fine. And we'll also need some sort of open area where people can sit and have","x":0.19685290003321579,"y":0.60596401099360298,"h":0.015514207454667028,"w":0.62172103881835938},{"w":0.61776062011718746,"y":0.6220200752564633,"c":1,"h":0.016061320358716658,"x":0.19498069342783519,"t":"a cup of coffee, and we'd like to have an exhibition of our products and services"},{"w":0.40540540059407548,"x":0.19498069726850953,"h":0.013225467471286723,"c":1,"y":0.63953488387017843,"t":"there as well, so thatIl need to be quite a big space."},{"t":"That's fine, there's a central atrium with all those facilities, and you can come","x":0.19488945316329997,"h":0.019269682382849318,"w":0.59668162027994798,"c":1,"y":0.65394285537165076},{"x":0.19678217443544174,"w":0.47133646647135419,"t":"before the conference starts if you want to set everything up.","h":0.017897255896325404,"c":1,"y":0.66844833486600008},{"t":"Great. And presume there's wifi?","y":0.68750000014827672,"x":0.19498070072438534,"h":0.013081395042735311,"c":1,"w":0.27027025858561193},{"y":0.70348837224273719,"h":0.013081395042735311,"c":1,"x":0.1969112007820262,"t":"Oh yes, that's free and available throughout the hotel.","w":0.4150579071044922},{"x":0.83590733608887835,"y":0.52761627916831266,"t":"Q1","h":0.013081395042735311,"w":0.025096524556477817,"c":1},{"w":0.027027025222778334,"t":"Q2","c":1,"x":0.83590733671293527,"y":0.55959302335435901,"h":0.013081395042735311},{"c":1,"y":0.68750000002223699,"t":"Q4","x":0.83590733596500433,"w":0.025096524556477928,"h":0.013081395042735311},{"y":0.73388222609822151,"t":"Would you also like us to provide a buffet lunch? We can do a two-course meal","x":0.19492354401327161,"h":0.015734410495351181,"w":0.61592030843098955,"c":1},{"c":1,"x":0.19487375142058691,"t":"with a number of different options.","y":0.74889676894872992,"w":0.27052851359049479,"h":0.014588338667655409},{"c":1,"t":"What sort of price are we looking at for that?","x":0.19486672138200048,"y":0.76523073223225702,"w":0.34577270507812508,"h":0.014472348776785049},{"c":1,"h":0.016015727666570112,"t":"Well, I can send you a copy of the standard menu. That's $45 per person. Or you Q5","x":0.19111968307002372,"y":0.78197674390544814,"w":0.66988418579101561},{"t":"can have the special for $25 more.","y":0.79581405032546482,"x":0.1948497862406679,"h":0.015307709443823425,"c":1,"w":0.27252347310384112},{"y":0.81227781035904012,"w":0.49247940063476559,"c":1,"x":0.19102790242180845,"t":"I think the standard should be OK, but yes, send me the menu.","h":0.017056974892035948},{"t":"Now we're also going to need accommodation on the Saturday night for some","h":0.015274306911147839,"c":1,"y":0.85286621103187332,"x":0.19491367744883414,"w":0.60245015462239582},{"w":0.61980667114257815,"t":"of the participants... I'm not sure how many, but probably about 25. So what do","h":0.016830341430051354,"c":1,"x":0.1929906157314224,"y":0.86913781586989713},{"y":0.88391027766531938,"h":0.015448234012464979,"x":0.19279598011582977,"w":0.18390213012695311,"c":1,"t":"you charge for a room?"},{"c":1,"t":"Well, for conference attendees we have a 25% reduction, so we can offer you","w":0.60051259358723952,"x":0.1949128801865869,"y":0.90102305562037355,"h":0.016603236515518982},{"h":0.01603578833145658,"y":0.91715116291085852,"c":1,"x":0.19111969896413059,"t":"rooms at $135. Normally a standard room's $180.","w":0.38996136983235674},{"t":"Q6","x":0.8339768341583762,"c":1,"y":0.92005813955600269,"h":0.011627906837606949,"w":0.025096524556477928},{"w":0.034749034245808927,"h":0.014534883247863672,"c":1,"t":"108","x":0.098455598668601332,"y":0.9534883722568821}]}