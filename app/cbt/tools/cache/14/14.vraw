{"w":2400,"h":3395,"lines":[{"w":0.074981873830159529,"c":1,"y":0.11227566773625575,"x":0.83503444839468066,"h":0.014732412511243798,"t":"Reading"},{"x":0.17882554629835634,"w":0.18762322743733723,"c":1,"y":0.15292443478709561,"t":"Questions 21 and 22","h":0.015782401193859097},{"x":0.17901234164954835,"h":0.01598837238037687,"w":0.22016461690266928,"t":"Choose TWO letters, A-E.","y":0.18604651147646889,"c":1},{"y":0.21643109531216642,"h":0.01472320376914027,"c":1,"x":0.17901233898243654,"t":"Write the correct letters in boxes 21 and 22 on your answer sheet.","w":0.54320988972981776},{"c":1,"x":0.17691225035220262,"t":"Which TWO of the following statements are made in the text about Amsterdam today?","h":0.016489964632319665,"y":0.24561810954914554,"w":0.70997558593749988},{"w":0.62757202148437496,"t":"The majority of residents would like to prevent all cars from entering the city.","x":0.25925925704915187,"y":0.2703180212502041,"h":0.014565699794126807,"c":1},{"h":0.013081395583944722,"c":1,"w":0.014403292338053375,"y":0.28633720907576021,"t":"B","x":0.22016460885497879},{"h":0.016195524146054185,"c":1,"y":0.28621908103392613,"t":"There is little likelihood of the city having another bike-sharing scheme.","x":0.25925927139283972,"w":0.5864197285970052},{"t":"More trips in the city are made by bike than by any other form of transport.","x":0.26126228971561222,"w":0.61121571858723955,"c":1,"h":0.016161789461636822,"y":0.30042201949206571},{"y":0.31684334489796817,"h":0.014552004064912527,"w":0.60288065592447926,"c":1,"t":"A bike-sharing scheme would benefit residents who use public transport.","x":0.25514403417137932},{"h":0.017525751542988965,"c":1,"x":0.21801741632208801,"y":0.33123388206524274,"t":"E The city has a reputation as a place that welcomes cyclists.","w":0.53309331258138015},{"w":0.024691357612609877,"t":"23","x":0.88271604949522875,"y":0.86918604635428165,"h":0.011627907185728592,"c":1}]}