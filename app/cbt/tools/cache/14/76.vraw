{"h":3395,"w":2400,"lines":[{"c":1,"y":0.10901162826508082,"h":0.01889534805351778,"t":"Reading","x":0.83744856096605469,"w":0.074074071248372397},{"y":0.15299819797089609,"x":0.18077974008970765,"t":"Questions 9-13","w":0.14253475189208986,"h":0.015772815025877795,"c":1},{"w":0.69786712646484372,"h":0.023308174348972699,"c":1,"x":0.17889927567064945,"y":0.18153949611796982,"t":"Do the following statements agree with the information given in Reading Passage 1?"},{"w":0.35185185750325521,"h":0.014723203769140158,"c":1,"x":0.17901234274982489,"t":"In boxes 9-13 on your answer sheet, write","y":0.21643109531065474},{"y":0.246665731524499,"h":0.013935978758040313,"c":1,"x":0.24258684218587462,"t":"TRUE","w":0.05186335245768231},{"h":0.013819506929395264,"t":"FALSE","y":0.26271233953552575,"w":0.062033767700195308,"c":1,"x":0.24264566748788952},{"h":0.018153275421286308,"x":0.35991792080605695,"c":1,"t":"if the statement agrees with the information","w":0.36041130065917976,"y":0.24456434963321683},{"x":0.35802468794315617,"h":0.016032884483202503,"y":0.26017441843242373,"c":1,"w":0.35802469889322913,"t":"if the statement contradicts the information"},{"x":0.24279836559716994,"y":0.27616279095575957,"w":0.3806584167480469,"h":0.01598837125708541,"c":1,"t":"NOT GIVEN if there is no information on this"},{"h":0.013081395583944611,"y":0.31686046486791142,"c":1,"x":0.17901234549763997,"t":"9","w":0.014403292338053403},{"y":0.31311911860493158,"t":"Pheidole dentata ants are the only known animals which remain active for almost","x":0.21800781943542519,"h":0.019738854452072463,"w":0.67304351806640628,"c":1},{"c":1,"t":"their whole lives.","x":0.21781393073260516,"w":0.144649658203125,"y":0.33150197854065366,"h":0.01603977643699328},{"y":0.35600706735792009,"c":1,"x":0.18106996219849142,"h":0.013250883392226021,"w":0.69958847045898431,"t":"10 Ysabel Giraldo was the first person to study Pheidole dentata ants using precise"},{"c":1,"x":0.22002338088060763,"y":0.37052045392292809,"h":0.014944422511807387,"t":"data about the insects' ages.","w":0.23901115417480467},{"w":0.70790095011393217,"t":"11 The ants in Giraldo's experiments behaved as she had predicted that they would.","h":0.015983259720010468,"c":1,"y":0.39366644450482791,"x":0.18102784948081202},{"c":1,"y":0.41735578590280553,"t":"12 The recent studies of bees used different methods of measuring age-","x":0.1810243337048259,"h":0.01447016443043625,"w":0.61120061238606782},{"c":1,"h":0.015686440102764765,"x":0.21981862473340513,"w":0.13057193756103513,"y":0.43358912283118634,"t":"related decline."},{"x":0.18101804626711868,"y":0.45696076456322543,"w":0.6585327657063802,"h":0.015283337470639813,"c":1,"t":"13 Pheidole dentata ants kept in laboratory conditions tend to live longer lives."},{"y":0.86773255795657411,"h":0.013081395583944722,"c":1,"t":"85","w":0.022633744875590001,"x":0.88683127561776054}]}