,"h":0.011627906191665538,"y":0.49854651190416721,"c":1},{"c":1,"t":"CARL:","x":0.10344827529631469,"y":0.53052325582923654,"h":0.010174418520535577,"w":0.038314177195231128},{"y":0.54651162805603237,"t":"JULIE:","w":0.038314174016316746,"h":0.0087209296437491535,"x":0.10153256848354021,"c":1},{"y":0.56249999997004052,"t":"CARL:","x":0.10344827529631469,"w":0.038314177195231128,"c":1,"h":0.0087209302465774963},{"t":"JULIE:","y":0.57848837196550751,"x":0.10153256848354021,"h":0.010174418520535577,"w":0.038314174016316746,"c":1},{"t":"CARL:","h":0.011627906191665427,"c":1,"w":0.040229883193969737,"y":0.59447674443323706,"x":0.10153256829286188},{"y":0.62790697676080776,"t":"JULIE:","x":0.10153256630110583,"w":0.040229886372884133,"h":0.010174418520535577,"c":1},{"x":0.10344827742351467,"w":0.038314174016316732,"h":0.010174418520535577,"t":"CARL:","y":0.64244186033760042,"c":1},{"w":0.042145592371622714,"h":0.011627907397322002,"t":"CARL:","x":0.10153256770307753,"y":0.68313953464436228,"c":1},{"x":0.099616858899691629,"w":0.044061301549275705,"c":1,"y":0.71511627877642203,"t":"JULIE:","h":0.011627907397322113},{"w":0.040229883193969723,"t":"CARL:","h":0.011627906191665538,"y":0.7470930235320743,"c":1,"x":0.10153256819228718},{"w":0.042145592371622728,"t":"JULIE:","y":0.77906976745565604,"x":0.09961685891210266,"h":0.010174418520535577,"c":1},{"t":"CARL:","x":0.10153256829286188,"y":0.80959302350300444,"c":1,"h":0.011627906191665427,"w":0.040229883193969737},{"x":0.10153256812523737,"h":0.010174418520535577,"t":"JULIE:","w":0.040229883193969723,"y":0.82558139530610819,"c":1},{"h":0.0087209302465773852,"t":"CARL.","c":1,"x":0.10344827529127333,"w":0.038314177195231128,"y":0.85901162787816476},{"c":1,"t":"JULIE.","x":0.10153256647901281,"y":0.87499999996876554,"h":0.0087209302465774963,"w":0.0383141771952311},{"w":0.038314174016316718,"y":0.8895348836358079,"c":1,"h":0.010174418520535577,"x":0.10344827726387228,"t":"CARL:"},{"w":0.040229886372884133,"x":0.10153256630110583,"h":0.0087209302465773852,"c":1,"y":0.9069767441572345,"t":"JULIE:"},{"t":"CARL:","x":0.10344827529127333,"h":0.010174418520535577,"w":0.038314177195231128,"c":1,"y":0.92296511629569145},{"x":0.10153256666170904,"w":0.036398468017578123,"t":"102","h":0.013081395068451962,"c":1,"y":0.95784883731102022},{"t":"Hi, come and take a seat.","y":0.19031645882972192,"x":0.19717970547274735,"h":0.014640382508713135,"c":1,"w":0.19953130086263024},{"y":0.20575581349764127,"h":0.018148481318380982,"c":1,"x":0.19450581497631822,"t":"Thank you.","w":0.091660340627034514},{"x":0.19535448706460898,"y":0.22104070968728129,"t":"My name's Carl Rogers and I'm one of the doctors here at the Total Health Clinic.","h":0.017386534723409675,"w":0.63034632364908849,"c":1},{"w":0.38505747477213537,"t":"So I understand this is your first visit to the clinic?","c":1,"x":0.19540229700138934,"y":0.23830594189780441,"h":0.016118836915297141},{"c":1,"y":0.2554375280943586,"t":"Yes, it is.","x":0.19527476646070274,"w":0.073051999409993462,"h":0.015287734464507929},{"y":0.27024685649959002,"t":"OK, well I hope you'll be very happy with the service you receive here. So if","x":0.19535521963736036,"h":0.016442193394213711,"w":0.58631571451822917,"c":1},{"c":1,"x":0.19344828596686425,"t":"it's alright with you I'll take a few details to help me give you the best possible","y":0.28628394794434775,"w":0.59971201578776046,"h":0.017417520699097189},{"c":1,"t":"service.","x":0.19712169485295494,"y":0.30496740835059399,"w":0.063721237182617185,"h":0.01135381103014077},{"c":1,"h":0.015552324229938463,"t":"Sure.","x":0.19450999026452814,"y":0.31926122804955603,"w":0.047873929341634119},{"t":"So can I check first of all that we have the correct personal details for you? So","y":0.33420874558227598,"x":0.19535033590888265,"h":0.017101810493903247,"c":1,"w":0.60355626424153652},{"y":0.35079685929067417,"w":0.28374511718749995,"c":1,"x":0.19337932943948402,"t":"your full name is Julie Anne Garcia?","h":0.015557412703329665},{"t":"That's correct.","h":0.011627906191665538,"c":1,"y":0.36773255841579511,"x":0.19731800573225353,"w":0.1091954040527344},{"w":0.38697319030761712,"t":"Perfect. And can I have a contact phone number?","h":0.014564284482586953,"c":1,"x":0.19540229363929493,"y":0.38369152957942176},{"y":0.39944492133777065,"h":0.015258198290799663,"x":0.19521116682624495,"w":0.13825372060139973,"c":1,"t":"It's 219 442 9785."},{"c":1,"t":"OK, and then can I just check that we have the correct date of birth?","w":0.52873565673828127,"x":0.19540228648046196,"y":0.41561314813562933,"h":0.014619410113347886},{"h":0.014678211188045132,"y":0.43299620751967582,"c":1,"x":0.19540229911658979,"t":"October tenth. 1992.","w":0.16283524831136065},{"t":"Oh, I actually have 1991, I'll just correct that now. Right, so that's all good. Now I","x":0.19540229643586182,"c":1,"y":0.44753476618569121,"h":0.017699115044247815,"w":0.62452107747395835},{"w":0.61685821533203133,"h":0.014544070445180135,"c":1,"t":"just need just a few more personal details ... do you have an occupation, either","x":0.19348660274266885,"y":0.46365360324050231},{"t":"full-time or part-time?","x":0.19348658957822476,"y":0.48103666251525534,"h":0.013274336283185861,"w":0.17049808502197264,"c":1},{"y":0.49530924271577359,"w":0.62272511800130204,"x":0.19534423258465769,"c":1,"t":"Yes, I work full-time in Esterhazy's - you know, the restaurant chain. I started off","h":0.01737018421235792},{"t":"as a waitress there a few years ago and I'm a manager now.","c":1,"h":0.013274336283185861,"w":0.46551722208658852,"y":0.51295828047040559,"x":0.19731801718495282},{"t":"Oh I know them, yeah, they're down on 114th Street, aren't they?","x":0.19540230143002948,"h":0.017699115044247815,"c":1,"y":0.52749683948092785,"w":0.50574712117513021},{"x":0.19537077086237378,"y":0.54494011949813581,"c":1,"w":0.093932787577311189,"t":"That's right.","h":0.01477092316117512},{"h":0.01327433628318575,"c":1,"w":0.44252873738606768,"x":0.19731800668664054,"t":"Yeah, I've been there a few times. I just love their salads.","y":0.5609987358165951},{"y":0.57703488359742083,"c":1,"h":0.014621248136730158,"w":0.15708812713623047,"t":"That's good to hear.","x":0.19540229646540966},{"w":0.60930836995442705,"h":0.017451359860966353,"c":1,"t":"Right, so one more thing I need to know before we talk about why you're here,","y":0.59158893911622068,"x":0.19535200977086919},{"w":0.41954022725423179,"c":1,"h":0.014566121903140994,"t":"Julie, and that's the name of your insurance company.","x":0.19731800879671188,"y":0.6090116277879013},{"h":0.017779886195089967,"t":"It's Cawley Life Insurance, that's C-A-W-L-E-Y.","y":0.62438844961987061,"x":0.19530151650784661,"w":0.364163080851237,"c":1},{"x":0.19718786414288378,"t":"Excellent, thank you so much.","y":0.64092429095263204,"w":0.23398170471191407,"h":0.015692097197290367,"c":1},{"y":0.67931927828439664,"t":"Now Julie, let's look at how we can help you. So tell me a little about what","w":0.57296035766601572,"h":0.018704428835554121,"c":1,"x":0.1953290215165551},{"w":0.18390804290771487,"y":0.69753476608214671,"t":"brought you here today.","h":0.01467453634693705,"x":0.1954023002780346,"c":1},{"x":0.19540230460076258,"y":0.71365360287760027,"w":0.6053639729817708,"c":1,"h":0.01454407165083671,"t":"Well, I've been getting a pain in my knee. the left one. Not very serious at first,"},{"x":0.19731800348047121,"y":0.72965116292824228,"c":1,"w":0.50957855224609372,"h":0.013081395068451962,"t":"but it's gotten worse, so I thought I ought to see someone about it."},{"c":1,"y":0.745575221082455,"w":0.58429117838541667,"t":"That's certainly the right decision. So how long have you been aware of this","h":0.01327433628318575,"x":0.19731801223908443},{"x":0.19731801079379238,"h":0.01327433628318575,"w":0.59961685180664059,"c":1,"t":"Longer. It's been worse for the last couple of days. but it's three weeks since I","y":0.7774968396376758},{"w":0.59961685180664059,"h":0.013081395068451962,"c":1,"x":0.19731801078188749,"t":"first noticed it. It came on quite gradually though, so I kind of ignored it at first.","y":0.7936046513008802},{"h":0.014553259356434811,"t":"And have you taken any medication yourself, or treated it in anyway?","y":0.80813953476895262,"w":0.53639846801757807,"x":0.19540229846247523,"c":1},{"c":1,"y":0.82412790721233387,"w":0.61111109415690112,"x":0.19540230722369339,"h":0.015988371616368346,"t":"Yeah, I've been taking medication to deal with the pain, Tylenol, and that works"},{"w":0.39865020751953129,"c":1,"x":0.19531186036281326,"t":"OK for a few hours. But I don't like to keep taking it.","h":0.016469721546968796,"y":0.83975740380431174},{"w":0.56321838378906253,"c":1,"y":0.85610465139794589,"h":0.015988371616368346,"x":0.19540230224735286,"t":"OK. And what about heat treatment? Have you tried applying heat at all?"},{"x":0.19540230191702876,"t":"No, but I have been using ice on it for the last few days.","h":0.017537412390244755,"y":0.87199747133864858,"w":0.43295018513997396,"c":1},{"h":0.018588236098645239,"c":1,"x":0.19519858417421176,"t":"And does that seem to help the pain at all?","y":0.88631366160424019,"w":0.33559895833333331},{"h":0.018211018722669281,"c":1,"x":0.19454256851147908,"t":"A little, yes.","y":0.90362752576607941,"w":0.093583043416341133},{"t":"Good. Now you look as if you're quite fit normally?","x":0.19540229953782387,"c":1,"y":0.9200379269336233,"h":0.01611883691529703,"w":0.39080459594726569},{"y":0.35008755973992423,"t":"Example","w":0.071009699503580714,"x":0.83326909650339687,"h":0.013487671178149752,"c":1},{"h":0.013081395068451851,"c":1,"t":"Q1","x":0.83524904222656782,"y":0.38226744183714034,"w":0.024904214541117353},{"c":1,"t":"Q2","x":0.8352490420669253,"h":0.013081395068451962,"w":0.024904214541117353,"y":0.43168604659731469},{"y":0.51162790705152983,"t":"Q3","x":0.83524904206852191,"w":0.024904214541117353,"c":1,"h":0.013081395068451962},{"h":0.013081395068451962,"t":"Q4","y":0.62500000007478562,"x":0.83524904206852191,"w":0.024904214541117353,"c":1},{"y":0.71220930230225665,"t":"Q5","x":0.83333333405028587,"w":0.026819922129313167,"h":0.013081395068451962,"c":1},{"h":0.011627907397322002,"x":0.8352490420669253,"w":0.024904214541117353,"t":"Q6","y":0.7776162788110289,"c":1}]}