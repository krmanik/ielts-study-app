{"w":2400,"h":3395,"lines":[{"t":"Writing","c":1,"w":0.063786010742187593,"y":0.10901162771909223,"h":0.017441860778592888,"x":0.84567901099060516},{"t":"WRITING TASK 2","y":0.14958775022697979,"c":1,"x":0.17695473391916389,"w":0.21193415323893228,"h":0.019140164899882128},{"w":0.40123456319173179,"x":0.17695473476109261,"y":0.18459302310799508,"c":1,"t":"You should spend about 40 minutes on this task.","h":0.01598837238037687},{"c":1,"t":"Write about the following topic:","x":0.17673903020961892,"y":0.21341612192676018,"h":0.019566799923163236,"w":0.25761126200358075},{"h":0.018742852272779498,"y":0.25357147900139965,"c":1,"x":0.19541455490798076,"t":"Some people say that the main environmental problem of our time is the loss","w":0.67093663533528647},{"h":0.018944996405827252,"c":1,"y":0.26884570087334714,"t":"of particular species of plants and animals. Others say that there are more","w":0.65226338704427089,"x":0.19341563148415589},{"x":0.19341563242372209,"w":0.31275721232096354,"t":"important environmental problems.","h":0.016195524146054185,"c":1,"y":0.28621908102929061},{"w":0.47135182698567701,"y":0.31381254722072072,"h":0.020468441139823268,"x":0.19539348947587673,"t":"Discuss both these views and give your own opinion.","c":1},{"y":0.35600706720049569,"w":0.65843622843424487,"x":0.17901234188712994,"c":1,"t":"Give reasons for your answer and include any relevant examples from your own","h":0.016195524146054185},{"c":1,"y":0.3735465114882075,"h":0.014557139752750747,"t":"knowledge or experience.","x":0.17695473755828231,"w":0.21604937235514324},{"x":0.17676424236816166,"h":0.016512308019631439,"c":1,"t":"Write at least 250 words.","y":0.40219326340824635,"w":0.2082919692993164},{"y":0.86627906951907407,"x":0.88271604918771951,"w":0.022633744875590001,"h":0.013081395583944722,"c":1,"t":"51"}]}