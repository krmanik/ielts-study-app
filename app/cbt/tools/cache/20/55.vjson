{"w": 595.3200073242188, "h": 809.0257568359375, "lines": [{"t": "56", "x": 0.9034132915195562, "y": 0.9742087522985531, "w": 0.030329957084079588, "h": 0.017428414981790374, "c": 1, "size": 12.0, "bold": false}, {"t": "Procrastination is only a short-term measure for managing emotions. It's often", "x": 0.11675064998257588, "y": 0.12378835115115883, "w": 0.8071954165604251, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "followed by a feeling of 22 ............ , which worsens our mood and leads to", "x": 0.11675064998257588, "y": 0.15211877666808146, "w": 0.8072003377582078, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "more procrastination.", "x": 0.11675064998257588, "y": 0.17918093352600414, "w": 0.2230694628092268, "h": 0.02039118517446672, "c": 1, "size": 14.0, "bold": false}, {"t": "Questions 23 and 24", "x": 0.10727675473252624, "y": 0.2359232627676729, "w": 0.22246010574628786, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Choose TWO letters, A-E.", "x": 0.10727675473252624, "y": 0.26039712855707076, "w": 0.2653949932759009, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Which TWO comparisons between employees who often procrastinate and", "x": 0.10727675473252624, "y": 0.28505643271205194, "w": 0.826321216011568, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "those who do not are mentioned in the text?", "x": 0.10727675473252624, "y": 0.3095302985014498, "w": 0.45104364251476076, "h": 0.018822616509687834, "c": 1, "size": 13.0, "bold": false}, {"t": "A", "x": 0.10727675473252624, "y": 0.3440903931308439, "w": 0.026410812568698126, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "Their salaries are lower.", "x": 0.154847807857574, "y": 0.3440903931308439, "w": 0.24722045879301677, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "B", "x": 0.10727675473252624, "y": 0.36856425892024175, "w": 0.0256045