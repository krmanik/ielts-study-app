{"w": 595.3200073242188, "h": 809.0257568359375, "lines": [{"t": "125", "x": 0.8957535496958443, "y": 0.9742087522985531, "w": 0.037989698907791414, "h": 0.017428414981790374, "c": 1, "size": 12.0, "bold": false}, {"t": "Questions 8-13", "x": 0.10727675473252624, "y": 0.16353990900694812, "w": 0.16032547264260016, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Do the following statements agree with the information given in Reading Passage 1?", "x": 0.10727675473252624, "y": 0.20180811082364056, "w": 0.8320992148331463, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "TRUE", "x": 0.16774843308549978, "y": 0.23992806756776536, "w": 0.06857701925715955, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "if the statement agrees with the information", "x": 0.3492071437747412, "y": 0.23992806756776536, "w": 0.4540739213118929, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "FALSE", "x": 0.16774843308549978, "y": 0.2782333872346885, "w": 0.0760351970216911, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "if the statement contradicts the information", "x": 0.3492071437747412, "y": 0.2782333872346885, "w": 0.4508487938400547, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "NOT GIVEN", "x": 0.154847807857574, "y": 0.31635334397881326, "w": 0.13751473411742368, "h": 0.018822616509687834, "c": 1, "size": 13.0, "bold": true}, {"t": "if there is no information on this", "x": 0.3492071437747412, "y": 0.31635334397881326, "w": 0.32683143144417776, "h": 0.018822616509687834, "c": 1, "size": 13.0, "bold": false}, {"t": "8.", "x": 0.10727675473252624, "y": 0.3928898041942869, "w": 0.026612376627878402, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Georgia O'Keeffe's style was greatly influenced by the changing fashions in", "x": 0.154847807857574, "y": 0.3928898041942869, "w": 0.7791599551268782, "h": 0.01882263537038409, "c": 1, "