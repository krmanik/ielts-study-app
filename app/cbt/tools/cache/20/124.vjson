 "c": 1, "size": 13.0, "bold": true}, {"t": "at any other time in her life.", "x": 0.154847807857574, "y": 0.6761069983895983, "w": 0.28310034793893574, "h": 0.018822673091776602, "c": 1, "size": 13.0, "bold": false}], "source": "pdf text layer"}