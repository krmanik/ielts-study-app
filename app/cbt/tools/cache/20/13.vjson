{"w": 595.3200073242188, "h": 809.0257568359375, "lines": [{"t": "14", "x": 0.907881431531324, "y": 0.9742087522985531, "w": 0.025861817072311773, "h": 0.017428414981790374, "c": 1, "size": 12.0, "bold": false}, {"t": "Questions 1-6", "x": 0.10727675473252624, "y": 0.15360198182160828, "w": 0.14581227086313606, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Do the following statements agree with the information given in Reading Passage 1?", "x": 0.10727675473252624, "y": 0.18386064948090083, "w": 0.8259686326954333, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "In boxes 1-6 on your answer sheet, write", "x": 0.10727675473252624, "y": 0.20418138995485352, "w": 0.39779494968229057, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "TRUE", "x": 0.16774843308549978, "y": 0.26469857438786853, "w": 0.06538493045168496, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "if the statement agrees with the information", "x": 0.3492071437747412, "y": 0.26469857438786853, "w": 0.4540739213118929, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "FALSE", "x": 0.16774843308549978, "y": 0.29499428445460674, "w": 0.07566510756969416, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "if the statement contradicts the information", "x": 0.3492071437747412, "y": 0.29499428445460674, "w": 0.4508487938400547, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "NOT GIVEN", "x": 0.154847807857574, "y": 0.32525293325320304, "w": 0.13875723403258428, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "if there is no information on this", "x": 0.3492071437747412, "y": 0.32525293325320304, "w": 0.32683143144417776, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "1.", "x": 0.10727675473252624, "y": 0.38562179717086537, "w": 0.021371506039283665, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "There are other parrots that share the kākāpō's inability to fly.", "x": 0.154847807857574, "y": 0.38562179717086537, "w": 0.634323209199195, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "2.", "x": 0.10727675473252624, "y": 0.4139521849663955, "w": 0.025806094759918855, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Adult kākāpō produce chicks every year.", "x": 0.154847807857574, "y": 0.4139521849663955, "w": 0.41657476586119985, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "3.", "x": 0.10727675473252624, "y": 0.44228253504053316, "w": 0.026410812568698126, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Adult male kākāpō bring food back to nesting females.", "x": 0.154847807857574, "y": 0.44228253504053316, "w": 0.5607493031122578, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "4.", "x": 0.10727675473252624, "y": 0.47063763034815786, "w": 0.026209235693898627, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "The Polynesian rat was a greater threat to the kākāpō than Polynesian", "x": 0.154847807857574, "y": 0.47063763034815786, "w": 0.7791189451453563, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "settlers.", "x": 0.154847807857574, "y": 0.498968018143688, "w": 0.08913741194003562, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "5.", "x": 0.10727675473252624, "y": 0.5272983682178256, "w": 0.026612376627878402, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "Kākāpō were transferred from Rakiura Island to other locations because they", "x": 0.154847807857574, "y": 0.5272983682178256, "w": 0.7791545213043266, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "were at risk from feral cats.", "x": 0.154847807857574, "y": 0.5556287560133558, "w": 0.28511603979321537, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "6.", "x": 0.10727675473252624, "y": 0.5839591060874935, "w": 0.026410812568698126, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": true}, {"t": "One Recovery Plan initiative that helped increase the kākāpō population size", "x": 0.154847807857574, "y": 0.5839591060874935, "w": 0.7791383223616254, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}, {"t": "was caring for struggling young birds.", "x": 0.154847807857574, "y": 0.6122894938830236, "w": 0.39057192571492955, "h": 0.01882263537038409, "c": 1, "size": 13.0, "bold": false}], "source": "pdf text layer"}