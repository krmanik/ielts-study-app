{"blocks":[{"l":"header","b":[0.0054,0.015,0.1542,0.0334],"t":"CAMBRIDGE"},{"l":"header","b":[0.1013,0.0625,0.7312,0.0932],"t":"Cambridge University Press & Assessment\n978-1-009-45473-5 — IELTS 20 Academic Student's Book with Answers with Audio"},{"l":"text","b":[0.1046,0.1239,0.1729,0.1426],"t":"Test 2"},{"l":"paragraph_title","b":[0.3821,0.1536,0.5217,0.1741],"t":"LISTENING"},{"l":"paragraph_title","b":[0.1025,0.2131,0.3833,0.2333],"t":"PART 1 Questions 1-10"},{"l":"text","b":[0.1021,0.2517,0.3696,0.2713],"t":"Complete the table below."},{"l":"text","b":[0.1021,0.2891,0.6675,0.3102],"t":"Write ONE WORD AND/OR A NUMBER for each answer."},{"l":"text","b":[0.1021,0.3277,0.9304,0.3774],"t":"Local councils can arrange practical support to help those caring for elderly people at home."},{"l":"text","b":[0.1029,0.3942,0.3467,0.4148],"t":"This can give the carer:"},{"l":"text","b":[0.1017,0.4326,0.4338,0.4525],"t":"• time for other responsibilities"},{"l":"text","b":[0.1013,0.4608,0.9204,0.4841],"t":"• va (1) ___"},{"l":"text","b":[0.1029,0.489,0.4317,0.5095],"t":"Assessment of mother's needs"},{"l":"text","b":[0.1025,0.527,0.4242,0.5478],"t":"This may include discussion of:"},{"l":"text","b":[0.1013,0.5653,0.7246,0.5865],"t":"how much (2) ___ the caring involves"},{"l":"text","b":[0.1017,0.6042,0.5437,0.6245],"t":"what types of tasks are involved, e.g."},{"l":"text","b":[0.1321,0.6419,0.36,0.6628],"t":"- help with dressing"},{"l":"text","b":[0.1321,0.6698,0.9296,0.691],"t":"helping her have a (3) ___"},{"l":"text","b":[0.1329,0.6993,0.2675,0.7195],"t":"- shopping"},{"l":"text","b":[0.1321,0.7269,0.3638,0.7477],"t":"- helping with meals"},{"l":"text","b":[0.1321,0.7554,0.9296,0.7774],"t":"- dealing with (4)___"},{"l":"text","b":[0.1029,0.7839,0.7146,0.8044],"t":"• any aspects of caring that are especially difficult, e.g."},{"l":"text","b":[0.1321,0.821,0.9237,0.8446],"t":"loss of (5)"},{"l":"text","b":[0.1329,0.8498,0.4512,0.8706],"t":"- (6) ___ her"},{"l":"text","b":[0.1325,0.878,0.9221,0.9004],"t":"- preventing a (7) ___"},{"l":"number","b":[0.9021,0.9752,0.9313,0.9902],"t":"39"}]}