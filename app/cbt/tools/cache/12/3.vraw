{"lines":[{"y":0.017441860112681229,"w":0.19547325134277344,"x":0.06995884612216613,"t":"CAMBRIDGE","h":0.020348837575025147,"c":1},{"y":0.2020348840731947,"c":1,"w":0.21810699462890623,"t":"Introduction","h":0.021802324849949928,"x":0.13991769597417156},{"x":0.14197531292597396,"t":"The International English Language Testing System (IELTS) is widely recognised as","y":0.25872093009959096,"h":0.01454173212759069,"w":0.69341562906901033,"c":1},{"y":0.27470930219266632,"x":0.14197530571567199,"c":1,"h":0.01453488398216074,"w":0.68518519083658858,"t":"a reliable means of assessing the language ability of candidates who need to study"},{"x":0.14403292798416298,"h":0.013250883392226132,"c":1,"t":"or work where English is the language of communication. These Practice Tests are","w":0.68106994628906248,"y":0.28916372176230387},{"t":"designed to give future IELTS candidates an idea of whether their English is at the","w":0.67901234944661459,"c":1,"y":0.30523255800636961,"x":0.14197530663977109,"h":0.014555427856804859},{"t":"required level.","h":0.016299405002481615,"y":0.3198971991844568,"w":0.12402052561442053,"c":1,"x":0.13957751183330033},{"h":0.016195524146054074,"t":"IELTS is owned by three partners, Cambridge English Language Assessment, part of","x":0.15843622456497941,"w":0.70781890869140629,"c":1,"y":0.33568904593403071},{"h":0.014569123586018917,"c":1,"y":0.35174418591372691,"w":0.72839508056640634,"t":"the University of Cambridge, the British Council and IDP Education Pty Limited (through","x":0.13991768595597137},{"t":"its subsidiary company, IELTS Australia Pty Limited). Further information on IELTS can","x":0.13991769599300416,"h":0.014534883982160629,"c":1,"y":0.36773255800671745,"w":0.71810699462890615},{"h":0.016137949288663633,"t":"be found on the IELTS website www.ielts.org.","x":0.14389128256746431,"y":0.38078111736784259,"w":0.37481478373209631,"c":1},{"t":"WHAT IS THE TEST FORMAT?","y":0.42726737342826238,"w":0.34362139383951823,"h":0.014723203769140047,"c":1,"x":0.1419753112084402},{"h":0.013081395583944722,"c":1,"x":0.14197530288489391,"t":"IELTS consists of four components. All candidates take the same Listening and Speaking","y":0.46075581383395858,"w":0.70370371500651041},{"h":0.011778563015312216,"x":0.14197530382548923,"w":0.69753087361653643,"t":"tests. There is a choice of Reading and Writing tests according to whether a candidate is","c":1,"y":0.47673733779480609},{"x":0.14197531275192699,"c":1,"t":"taking the Academic or General Training module.","h":0.013250883392226132,"w":0.38888888041178382,"y":0.49116607761418307},{"t":"Academic","x":0.1542812722248777,"y":0.52021345224572724,"w":0.088556798299153638,"c":1,"h":0.013352164952578072},{"y":0.53626863422992033,"w":0.27387852986653644,"h":0.013699106951063134,"c":1,"t":"For candidates wishing to study at","x":0.15420221790623023},{"c":1,"h":0.013081395583944722,"w":0.30452674865722656,"t":"undergraduate or postgraduate levels,","y":0.55232558127156584,"x":0.15432098768784763},{"c":1,"w":0.27366254170735677,"h":0.011627907185728592,"t":"and for those seeking professional","x":0.15432099242720265,"y":0.56831395337911428},{"c":1,"x":0.15428325507429136,"h":0.013368764951456558,"y":0.58270515224537489,"t":"registration.","w":0.098840897878011091},{"w":0.14256516774495442,"h":0.015630277222542399,"c":1,"t":"General Training","y":0.51939637470321942,"x":0.48327042588557012},{"h":0.011778563015312216,"y":0.53621908107082794,"c":1,"t":"For candidates wishing to migrate to an","x":0.48559670689149015,"w":0.31069959004720049},{"h":0.013081395583944722,"c":1,"x":0.48559670394283538,"t":"English-speaking country (Australia, Canada,","y":0.55232558127383102,"w":0.35802469889322919},{"x":0.48148148758935083,"c":1,"t":"New Zealand, UK), and for those wishing to","w":0.34773661295572922,"h":0.016005492463128768,"y":0.56684334487919152},{"x":0.48353908936458578,"y":0.58421672562048266,"t":"train or study at below degree level.","h":0.011778563015312216,"c":1,"w":0.28395062764485679},{"h":0.013081395583944722,"x":0.14403292123151032,"y":0.61773255801857452,"t":"The test components are taken in the following order:","w":0.41975308736165362,"c":1},{"h":0.01746092977175584,"w":0.16717423756917316,"c":1,"t":"Academic Reading","x":0.21582198110322598,"y":0.69486919534634117},{"y":0.71220930216858103,"t":"3 sections, 40 items","w":0.16460905710856116,"h":0.016000356213644928,"c":1,"x":0.21810699394914879},{"w":0.092730439503987627,"x":0.2550751093362098,"t":"60 minutes","c":1,"h":0.013577317461389016,"y":0.72794971334239444},{"w":0.15738339742024743,"h":0.019017230776369964,"c":1,"x":0.22180251558622444,"y":0.75158663789059421,"t":"Academic Writing"},{"h":0.014723203769140158,"t":"2 tasks","c":1,"w":0.063786004384358719,"y":0.76884570081210946,"x":0.26954732659970776},{"w":0.091046937306722031,"y":0.78532830466544512,"x":0.25692490178743665,"t":"60 minutes","c":1,"h":0.01461381990861832},{"y":0.65386093197064621,"w":0.095863806406656926,"t":"Listening","h":0.016922282386303444,"c":1,"x":0.45622234818737428},{"h":0.016043156420524562,"c":1,"t":"4 sections, 40 items, approximately 30 minutes","x":0.32098765214101166,"y":0.67005813938336944,"w":0.37448560078938808},{"t":"General Training Reading","w":0.22108309427897144,"y":0.69179935024631289,"x":0.6044989498736375,"h":0.022083154415494466,"c":1},{"x":0.4979423867185836,"y":0.71366279052065973,"w":0.022633744875590001,"c":1,"t":"or","h":0.013081395583944722},{"t":"3 sections, 40 items","x":0.63168724266726395,"w":0.16666666666666674,"y":0.71075581378268393,"c":1,"h":0.017453844611860947},{"h":0.013432299430856109,"w":0.092690658569335893,"y":0.72802222235788772,"x":0.66661763355438097,"t":"60 minutes","c":1},{"h":0.018895348053517669,"c":1,"x":0.60905349937820552,"y":0.75145348875150764,"t":"General Training Writing","w":0.21193415323893228},{"c":1,"x":0.6830311905092562,"t":"2 tasks","y":0.77011817481094569,"w":0.061921157836914098,"h":0.013542720089250837},{"x":0.66857143604923686,"t":