{"w":2400,"h":3395,"lines":[{"h":0.018854049125464623,"c":1,"w":0.36446525573730471,"y":0.11011725808953654,"x":0.10480082319882883,"t":"Cork harvesting is a very specialised"},{"c":1,"x":0.10493827507908274,"t":"profession. No mechanical means","y":0.12779740851205634,"w":0.3374485524495443,"h":0.016195524146054296},{"y":0.14516181456328114,"x":0.10475129968426472,"w":0.31315422058105469,"c":1,"h":0.019207052403821812,"t":"of stripping cork bark has been"},{"y":0.1609024911735808,"t":"invented, so the job is done by teams","w":0.37324412027994791,"x":0.10246271979138072,"h":0.023369155587240176,"c":1},{"y":0.18006831194813255,"h":0.021173510871590695,"x":0.10464972985630397,"w":0.35859034220377606,"t":"of highly skilled workers. First, they","c":1},{"c":1,"t":"make vertical cuts down the bark","y":0.1976970442439987,"w":0.33584604899088538,"h":0.018658395369566816,"x":0.10268536616211037},{"h":0.01930345326346139,"x":0.10270223776593662,"w":0.35626515706380202,"t":"using small sharp axes, then lever","c":1,"y":0.21704992390072242},{"t":"it away in pieces as large as they","w":0.33176834106445308,"x":0.10057877175979665,"y":0.23435295902274544,"h":0.019432935051979849,"c":1},{"h":0.018082616466796209,"c":1,"x":0.1027430322661283,"y":0.25297291333591465,"t":"can manage. The most skilful cork-","w":0.35006078084309894},{"y":0.26884570064055358,"h":0.018944996405827363,"c":1,"t":"strippers prise away a semi-circular","x":0.10082304125248166,"w":0.36213991800944012},{"c":1,"x":0.1006219637838736,"t":"husk that runs the length of the trunk","w":0.3769005839029948,"y":0.28749498974151821,"h":0.02015534503159444},{"w":0.35223409016927082,"t":"from just above ground level to the","x":0.098561224000831851,"y":0.30585367974257671,"h":0.019557984333015921,"c":1},{"y":0.32217210625116133,"t":"first branches. It is then dried on the","h":0.019465449842041793,"c":1,"x":0.098585172382870595,"w":0.36869824727376299},{"w":0.37293457031249999,"t":"ground for about four months, before","c":1,"x":0.10060514269195101,"y":0.33989077717678895,"h":0.021310154765458278},{"y":0.35870212004577529,"c":1,"x":0.098499180133713268,"h":0.02063819516814358,"t":"being taken to factories, where it is","w":0.35236312866210934},{"x":0.098462062820521792,"h":0.021626877981304915,"w":0.35242833455403649,"c":1,"y":0.37580346172008183,"t":"boiled to kill any insects that might"},{"c":1,"t":"remain in the cork. Over 60% of","y":0.39478326208098835,"w":0.32335848490397134,"x":0.096558461728980569,"h":0.018868943968145091},{"w":0.34200116475423176,"t":"cork then goes on to be made into","h":0.020446195478854845,"x":0.096501670535056691,"c":1,"y":0.41209503867102515},{"t":"traditional bottle stoppers, with most","w":0.37304064432779949,"y":0.42943173062092321,"h":0.021098268326937841,"x":0.096394144340100255,"c":1},{"y":0.44743502799631929,"x":0.096447781765452115,"h":0.020489242248175721,"c":1,"w":0.34623725891113283,"t":"of the remainder being used in the"},{"t":"construction trade. Corkboard and","y":0.46370066318509662,"c":1,"x":0.096319604989660856,"w":0.34640881856282552,"h":0.023110071818033817},{"t":"cork tiles are ideal for thermal and","y":0.4832804064053875,"x":0.096475717731200769,"w":0.34820765177408847,"h":0.018569757014477939,"c":1},{"y":0.50175609465419768,"w":0.37280998229980467,"c":1,"h":0.020837231154155478,"x":0.094451540096176623,"t":"acoustic insulation, while granules of"},{"w":0.36240539550781253,"h":0.017867684223907498,"c":1,"t":"cork are used in the manufacture of","x":0.094497818085899091,"y":0.51946905999622517},{"y":0.53852397396678109,"h":0.014369990435309399,"c":1,"x":0.094427206142347037,"t":"concrete.","w":0.095250854492187509},{"x":0.092372715966839297,"y":0.57254793676955662,"w":0.34407274881998695,"h":0.019947833812700155,"t":"Recent years have seen the end of","c":1},{"y":0.59156976727740451,"c":1,"x":0.092592594166454961,"h":0.017441860778592888,"w":0.34979423522949216,"t":"the virtual monopoly of cork as the"},{"y":0.60778266881752629,"c":1,"w":0.34821172078450513,"h":0.020850459032541679,"x":0.092372803646307164,"t":"material for bottle stoppers, due to"},{"y":0.62505475274695865,"w":0.37306307474772132,"x":0.092319248814035151,"c":1,"h":0.021165413064585969,"t":"concerns about the effect it may have"},{"y":0.64332913435700789,"t":"on the contents of the bottle. This","c":1,"x":0.090313502772281423,"w":0.33589668273925777,"h":0.020096602512894357},{"t":"Reading","y":0.069013144736458476,"x":0.84508561701557006,"h":0.016317489992462963,"c":1,"w":0.0836431058247884},{"x":0.52231333686568815,"y":0.1132985076691666,"h":0.021065805208275834,"w":0.3483150990804037,"c":1,"t":"is caused by a chemical compound"},{"h":0.023208254217680246,"t":"called 2,4,6-trichloroanisole (TCA),","c":1,"x":0.52232867065603439,"y":0.12956785662800108,"w":0.35255101521809895},{"t":"which forms through the interaction","h":0.020277818605672349,"c":1,"y":0.14883354418748695,"x":0.52235437861551393,"w":0.36270693461100245},{"c":1,"w":0.37528544108072914,"y":0.16560875420445531,"h":0.023615261972020685,"t":"of plant phenols, chlorine and mould.","x":0.52223114512159274},{"w":0.35669003804524746,"x":0.52225142925854828,"y":0.18443057327491186,"h":0.019346088908165249,"t":"The tiniest concentrations - as little","c":1},{"x":0.52023650055095383,"c":1,"h":0.022614398187967621,"y":0.20142012210849369,"w":0.35460230509440105,"t":"as three or four parts to a trillion -"},{"y":0.22028819128455135,"c":1,"h":0.020133859838838419,"x":0.52038716648920125,"w":0.32964004516601564,"t":"can spoil the taste of the product"},{"y":0.23712802841285663,"c":1,"w":0.34009389241536458,"t":"contained in the bottle. The result","x":0.52031572813357285,"h":0.02019038610379742},{"h":0.022017929382683654,"c":1,"y":0.25525035868083945,"t":"has been a gradual yet steady move","x":0.52023334964163792,"w":0.35866808573404951},{"x":0.52011150579683929,"t":"first towards plastic stoppers and,","w":0.3425116221110025,"h":0.022852011367204605,"y":0.27242185726897739,"c":1},{"t":"more recently, to aluminium screw","w":0.34871177673339848,"c":1,"x":0.51805263675020474,"h":0.026871019594801204,"y":0.28915705458449503},{"h":0.025836605346104546,"c":1,"w":0.37949160257975256,"t":"caps. These substitutes are cheaper to","x":0.51813527446957364,"y":0.30673347926131911},{"y":0.32848837192042868,"w":0.38065844217936184,"x":0.51851851529453152,"t":"manulacture and, in the case of screw","h":0.017506916756062751,"c":1},{"c":1,"x":0.51824300742197593,"y":0.34505885655276491,"t":"caps, more convenient for the user.","w":0.35244633992513008,"h":0.021320161044387054},{"y":0.37896627575703212,"t":"The classic cork stopper does","w":0.2952048746744792,"x":0.51595179670685409,"c":1,"h":0.022551994862910374},{"t":"have several advantages, however.","x":0.51604825922022013,"y":0.3976643477969809,"w":0.34857884724934896,"h":0.022339484997716652,"c":1},{"c":1,"w":0.35681254069010404,"y":0.41397913939349462,"h":0.023549307923154128,"t":"Firstly, its traditional image is more","x":0.5160625902060566},{"y":0.43412812122681466,"h":0.019743575645419842,"x":0.51423974235867942,"c":1,"w":0.3418589019775391,"t":"in keeping with that of the type of"},{"w":0.36037768046061192,"y":0.45185320422670849,"h":0.019122392184883097,"x":0.5163073952407996,"c":1,"t":"high quality goods with which it has"},{"y":0.46760098085742541,"t":"long been associated. Secondly -","h":0.022612550373773854,"w":0.33190704345703126,"x":0.51203040448713866,"c":1},{"y":0.48837209284229277,"c":1,"x":0.51440329369335758,"t":"and very importantly - cork is a","w":0.32098765055338541,"h":0.017517188693384589},{"x":0.51395759712678579,"t":"sustainable product that can be","h":0.023470837039295978,"w":0.31572303771972654,"c":1,"y":0.50329232426390669},{"x":0.51211515616968217,"t":"recycled without difficulty. Moreover,","y":0.52249749650080934,"w":0.36886411031087241,"h":0.02121823359153574,"c":1},{"x":0.51201425383973931,"w":0.33614194234212236,"h":0.021038450818460563,"y":0.5397094154270059,"t":"cork forests are a resource which","c":1},{"t":"support local biodiversity, and prevent","x":0.51195216541800415,"y":0.55785529814356627,"w":0.38553207397460931,"h":0.02329337273947063,"c":1},{"y":0.57635243708894102,"c":1,"t":"desertification in the regions where","x":0.51210677867381682,"w":0.35440605163574213,"h":0.020610637462602388},{"t":"they are planted. So, given the current","y":0.59306137439618978,"c":1,"x":0.5117994523400391,"w":0.38369026184082022,"h":0.025067022748212486},{"w":0.37959704081217449,"h":0.024045953200197645,"c":1,"y":0.6099610136167114,"t":"concerns about environmental issues,","x":0.51193910113296626},{"y":0.63054571825521044,"t":"the future of this ancient material","w":0.33572199503580735,"h":0.01805667742402306,"x":0.51218764570464104,"c":1},{"w":0.28678690592447909,"t":"once again looks promising.","x":0.50789051339978153,"y":0.64749509408676076,"h":0.021252846689752247,"c":1},{"w":0.02880658467610675,"x":0.88065843594621374,"h":0.014534883982160851,"y":0.94186046492976028,"c":1,"t":"17"},{"c":1,"w":0.20856044769287113,"y":0.96595095099586725,"t":"leltsresources.org","x":0.39469720230611299,"h":0.018287739568380035}]}