{"w":2400,"h":3395,"lines":[{"x":0.10055027853435955,"w":0.0622739283243815,"y":0.070546718854666346,"c":1,"h":0.014429818053408372,"t":"Test 7"},{"c":1,"y":0.11773255800026794,"h":0.01453488398216074,"t":"Questions 37-40","x":0.10082304783577684,"w":0.17695472717285154},{"h":0.018979236571331048,"w":0.58230453491210943,"t":"Complete each sentence with the correct ending, A-F, below.","x":0.1008230413836444,"y":0.15253239092903792,"c":1},{"h":0.017465828445129006,"y":0.1889534882115298,"x":0.10082304174526721,"w":0.63374486287434895,"c":1,"t":"Write the correct letter, A-F, in boxes 37-40 on your answer sheet."},{"x":0.098765423465163926,"w":0.44650207519531249,"c":1,"t":"37 The Montreal researchers discovered that","h":0.014723203769140047,"y":0.22379269705405314},{"y":0.25132509496230315,"h":0.017963550958532415,"t":"38 Many studies have demonstrated that","w":0.40759124755859377,"x":0.09868591826467854,"c":1},{"c":1,"t":"39 Meyer's analysis of Beethoven's music shows that","w":0.52501851399739585,"h":0.020909573360663236,"x":0.10065375355711083,"y":0.27619141566468586},{"y":0.30668604636393382,"w":0.42592592875162766,"t":"40 Earlier theories of music suggested that","c":1,"x":0.098765430587169856,"h":0.016046580212416783},{"w":0.018518517812093099,"t":"B","h":0.013081395583944611,"c":1,"x":0.16460905374827445,"y":0.38517441839365896},{"x":0.16460905374827445,"h":0.013081395583944722,"c":1,"t":"C","w":0.018518517812093099,"y":0.41279069746342634},{"y":0.44040697653319372,"t":"D","x":0.16460905354711947,"w":0.016460905075073251,"h":0.013081395583944722,"c":1},{"x":0.16460905355299837,"y":0.49418604623566376,"h":0.014534883982160851,"w":0.016460905075073251,"t":"F","c":1},{"x":0.19747485156141995,"c":1,"w":0.59269958496093744,"h":0.018841023439512994,"t":"our response to music depends on our initial emotional state.","y":0.35497563697699497},{"y":0.38120799054523768,"t":"neuron activity decreases if outcomes become predictable.","w":0.56597915649414066,"h":0.0204701