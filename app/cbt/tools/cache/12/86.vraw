{"lines":[{"t":"Reading","h":0.018895348053517669,"x":0.83744856045448079,"y":0.061046511990228813,"w":0.084362138112386131,"c":1},{"h":0.016048292108362783,"c":1,"w":0.17901234944661454,"t":"Questions 23-26","x":0.082304524763514186,"y":0.10895170802579712},{"y":0.14534883705034496,"x":0.080246916303329571,"t":"Do the following statements agree with the claims of the writer in Reading Passage 2?","w":0.81481480916341142,"h":0.017489796673310853,"c":1},{"t":"In boxes 23-26 on your answer sheet, write","w":0.42012875874837241,"x":0.078020066715839484,"y":0.17748138714753037,"h":0.020725580491783746,"c":1},{"w":0.48581746419270833,"h":0.019119245845942823,"t":"if the statement agrees with the claims of the writer","x":0.29001306853494535,"c":1,"y":0.21427758599191082},{"t":"if the statement contradicts the claims of the writer","h":0.015988371257085632,"x":0.29012345662243993,"w":0.47942387898763023,"y":0.23255813975299788,"c":1},{"x":0.15218223600445194,"y":0.24941359899919846,"h":0.020584510830181646,"w":0.66271692911783853,"c":1,"t":"NOT GIVEN if it is impossible to say what the writer thinks about this"},{"h":0.01453488398216074,"x":0.078189299935806339,"c":1,"w":0.026748971939086916,"y":0.29651162771029382,"t":"23"},{"t":"Britain could become the first European country to reintroduce the lynx.","y":0.29651162774742523,"x":0.12345677996932247,"h":0.017441860778592999,"c":1,"w":0.67695475260416671},{"x":0.078189302958350027,"y":0.3226744184167667,"w":0.76337448120117191,"h":0.017441860778592888,"t":"24 The large growth in the European lynx population since 1970 has exceeded","c":1},{"y":0.33882534320770907,"c":1,"t":"conservationists' expectations.","x":0.12332013843324802,"w":0.29669100443522134,"h":0.019572488270322541},{"x":0.078189294027192963,"w":0.81893005371093752,"t":"25 Changes in agricultural practices have extended the habitat of the lynx in Europe.","h":0.017445284570484998,"c":1,"y":0.3691860463523321},{"c":1,"h":0.019277224411532012,"t":"26 It has become apparent that species reintroduction has commercial advantages.","y":0.39507833999413289,"w":0.80879506429036452,"x":0.078116939489579804},{"w":0.026748971939086874,"x":0.88683127524444827,"t":"87","y":0.93604651145089246,"h":0.013081395583944611,"c":1},{"t":"leltsresources.org","x":0.39469720757347232,"w":0.20851318359374998,"h":0.018254359844014467,"y":0.96598359674835832,"c":1}],"h":3395,"w":2400}