{"w":2400,"h":3395,"lines":[{"x":0.10288065708114023,"h":0.01453488398216074,"c":1,"w":0.063786010742187496,"t":"Test 8","y":0.074127906820173783},{"x":0.45676145245198979,"y":0.11472378574383379,"t":"READING","h":0.019098940109055218,"c":1,"w":0.13380219777425123},{"h":0.019090389615655345,"t":"READING PASSAGE 1","x":0.10475905660298589,"w":0.30905263264973959,"y":0.17814240890353861,"c":1},{"t":"You should spend about 20 minutes on Questions 1-13, which are based on Reading","h":0.02282371790586013,"x":0.10889965028265626,"y":0.21269790748090966,"w":0.8151124572753905,"c":1},{"t":"Passage 1 below.","y":0.23546511612309429,"h":0.016007204359074656,"c":1,"x":0.10699588190141301,"w":0.17078189849853515},{"h":0.024734982332155431,"c":1,"w":0.43209874471028642,"t":"The History of Glass","x":0.31069959876133568,"y":0.27179034151533821},{"y":0.31496313952676058,"x":0.10676035439381422,"t":"From our earliest origins, man has been","w":0.37496147155761722,"h":0.020051457435419251,"c":1},{"t":"making use of glass. Historians have","w":0.34406949361165362,"x":0.10473978104548602,"y":0.33302869302494209,"h":0.020006623509635113,"c":1},{"w":0.35802467346191408,"h":0.016041443962932944,"t":"discovered that a type of natural glass","x":0.10699589647891949,"c":1,"y":0.3517441863045967},{"t":"- obsidian - formed in places such as","h":0.018034852435647841,"x":0.10477533755426378,"w":0.3542569732666016,"y":0.36887383856317368,"c":1},{"x":0.10683289527173116,"y":0.3865601180807543,"h":0.016966084569025597,"w":0.34601613362630207,"c":1,"t":"the mouth of a volcano as a result of"},{"h":0.018387272164172908,"x":0.10684390333473516,"c":1,"w":0.36657137552897134,"y":0.40478312262517913,"t":"the intense heat of an eruption melting"},{"t":"sand - was first used as tips for spears.","y":0.4228504121674046,"x":0.10905349887539587,"h":0.016195524146054296,"c":1,"w":0.3683127593994141},{"x":0.10881540747586332,"y":0.43935485840937938,"w":0.38933652242024741,"h":0.019609583842319145,"t":"Archaeologists have even found evidence","c":1},{"y":0.45794736094749566,"c":1,"t":"of man-made glass which dates back to","x":0.10884727626876374,"w":0.36869822184244794,"h":0.018453546351061001},{"x":0.10884392525939593,"w":0.39350931803385425,"t":"4000 BC; this took the form of glazes used","h":0.021612129166494132,"c":1,"y":0.47481910726497711},{"c":1,"h":0.020662983960622383,"t":"for coating stone beads. It was not until","y":0.49231130167078141,"w":0.37506902058919267,"x":0.10875498799803855},{"w":0.36254684448242191,"x":0.11091762647800493,"t":"1500 BC, however, that the first hollow","y":0.51080680901434405,"h":0.020379404577967386,"c":1},{"t":"glass container was made by covering a","x":0.11086028051249922,"w":0.37287442525227865,"h":0.019437299038692735,"y":0.52863266424188493,"c":1},{"w":0.36419754028320317,"x":0.10905349321014199,"t":"sand core with a layer of molten glass.","y":0.54796511612697807,"h":0.01598837238037687,"c":1},{"x":0.11089340139202089,"w":0.38727142333984377,"t":"Glass blowing became the most common","c":1,"h":0.020081963780631096,"y":0.58163887299168326},{"w":0.36454653422037758,"c":1,"y":0.60108230083921343,"h":0.017731629496328338,"t":"way to make glass containers from the","x":0.11096276820279959},{"h":0.019468730975938486,"x":0.11089357761116878,"y":0.61744606283635806,"t":"first century BC. The glass made during","w":0.37281519571940114,"c":1},{"h":0.01913166832446489,"y":0.6354576674843625,"w":0.37902058919270837,"c":1,"t":"this time was highly coloured due to the","x":0.11089435790617387},{"h":0.019131225747691438,"y":0.65283222930500939,"c":1,"w":0.34822972615559888,"x":0.11083859034216029,"t":"impurities of the raw material. In the"},{"h":0.021785555234084653,"c":1,"x":0.11298547504790737,"t":"first century AD, methods of creating","w":0.35019635518391923,"y":0.67124928252939386},{"h":0.016012340046912876,"c":1,"w":0.37242797851562504,"t":"colourless glass were developed, which","x":0.11316872689793835,"y":0.69040697658695971},{"y":0.70699434003963491,"h":0.018637340397379853,"w":0.31942207336425776,"c":1,"x":0.11294761578605725,"t":"was then tinted by the addition of"},{"x":0.11301429659026269,"t":"colouring materials. The secret of glass","c":1,"y":0.72491514592246664,"h":0.018381008691866318,"w":0.37066378275553385},{"t":"making was taken across Europe by the","x":0.11299186263410722,"c":1,"y":0.74326915525751047,"w":0.37689112345377601,"h":0.018852337229518623},{"h":0.016195524146054185,"t":"Romans during this century. However,","x":0.11522633464117689,"c":1,"y":0.76148409906008951,"w":0.35802469889322919},{"c":1,"t":"they guarded the skills and technology","w":0.36444676717122398,"x":0.11305102722357503,"y":0.77867541615037072,"h":0.018147435991446637},{"y":0.79578495747469347,"x":0.11298728800265641,"t":"required to make glass very closely, and","w":0.37489837646484375,"h":0.019443606319360152,"c":1},{"x":0.11296891398177583,"h":0.018894489858962027,"w":0.35847020467122398,"t":"it was not until their empire collapsed","y":0.81382964219306875,"c":1},{"w":0.37271926879882811,"t":"in 476 AD that glass-making knowledge","h":0.018230657274226014,"c":1,"x":0.11302881583800797,"y":0.83219753723393541},{"c":1,"h":0.016022612545880555,"y":0.85029069750495423,"t":"became widespread throughout Europe","x":0.1152263356201739,"w":0.37448560078938797},{"y":0.86742143018932549,"h":0.01658111859828193,"w":0.33367136637369788,"t":"and the Middle East. From the 10th","c":1,"x":0.11504660457470209},{"c":1,"x":0.11706567834203516,"y":0.88467366434516681,"w":0.3790512339274088,"t":"century onwards, the Venetians gained a","h":0.020748789936690271},{"x":0.11491542624853669,"y":0.90150148389930762,"h":0.020424372175416594,"t":"reputation for technical skill and artistic","w":0.38126253763834639,"c":1},{"t":"80","w":0.026748971939086902,"c":1,"y":0.94622093002926855,"h":0.014534883982160851,"x":0.11728395015185572},{"t":"ability in the making of glass bottles, and","x":0.54306624949086579,"y":0.31241642020790006,"w":0.38511131286621092,"c":1,"h":0.019858790511096513},{"x":0.54320987446038804,"y":0.33127208487542692,"t":"many of the city's craftsmen left Italy to","h":0.016195524146054296,"c":1,"w":0.37448560078938808},{"y":0.34818452877611672,"x":0.54307306054401971,"w":0.3623809814453125,"h":0.018484072353870729,"c":1,"t":"set up glassworks throughout Europe."},{"h":0.016022611422589428,"x":0.5452674944710687,"t":"A major milestone in the history of glass","y":0.38368669028516855,"c":1,"w":0.37860081990559891},{"t":"occurred with the invention of lead crystal","y":0.40253239097835558,"w":0.3991769663492839,"x":0.54526748382491252,"c":1,"h":0.014723203769140158},{"w":0.37270998636881503,"h":0.018221000338892512,"t":"glass by the English glass manufacturer","y":0.41965807630878837,"x":0.54511894483016565,"c":1},{"c":1,"h":0.018430157179545992,"x":0.54513132645894946,"w":0.34390714009602863,"t":"George Ravenscroft (1632-1683). He","y":0.43685688988484372},{"t":"attempted to counter the effect of","y":0.45358813193477499,"x":0.54497849539248033,"w":0.32155202229817703,"h":0.019582865235381552,"c":1},{"x":0.54508100812961302,"w":0.34608937581380195,"t":"clouding that sometimes occurred in","y":0.4721944978059005,"c":1,"h":0.019843444105312358},{"t":"blown glass by introducing lead to the raw","x":0.54505921505508292,"c":1,"h":0.021462614600874619,"y":0.48864709879525148,"w":0.40168523152669255},{"t":"materials used in the process. The new","h":0.016014051942858987,"c":1,"x":0.54526748724988139,"w":0.3683127593994141,"y":0.50872093045067235},{"y":0.52517170532298796,"x":0.54700064167338447,"t":"glass he created was softer and easier","w":0.356564178466797,"h":0.020024464745403647,"c":1},{"t":"to decorate, and had a higher refractive","x":0.54699735254051629,"y":0.54210024224030107,"h":0.023331236642718522,"c":1,"w":0.37102518717447919},{"w":0.39094650268554687,"x":0.54526748927632218,"h":0.01896896407236337,"y":0.56242638436705816,"c":1,"t":"index, adding to its brilliance and beauty,"},{"x":0.54716489615797814,"y":0.57898125186929172,"h":0.018833350236620805,"c":1,"w":0.35835617065429692,"t":"and it proved invaluable to the optical"},{"y":0.5947052117484839,"h":0.021050577871369769,"c":1,"x":0.54702980634008014,"w":0.35034617106119803,"t":"industry. It is thanks to Ravenscroft's"},{"h":0.021156829995738313,"y":0.61455619831979824,"w":0.40160649617513022,"t":"invention that optical lenses, astronomical","x":0.5471729165274517,"c":1},{"c":1,"w":0.34803423563639324,"x":0.54718577141651414,"y":0.63318709765059722,"t":"telescopes, microscopes and the like","h":0.020074706195521208},{"t":"became possible.","x":0.54938271450862353,"y":0.65253239091282156,"h":0.016195524146054185,"w":0.16460905710856122,"c":1},{"w":0.39094650268554687,"x":0.549382715638014,"y":0.68749999983810139,"h":0.017446996466431108,"c":1,"t":"In Britain, the modern glass industry only"},{"w":0.37892326354980477,"h":0.017831603545603425,"c":1,"y":0.70441013079807824,"t":"really started to develop after the repeal","x":0.5492343463646896},{"x":0.54938271325956956,"c":1,"w":0.35185185750325521,"t":"of the Excise Act in 1845. Before that","h":0.016195524146054185,"y":0.72232037668644089},{"h":0.022215981365513948,"c":1,"x":0.5491923451086167,"y":0.73851957761990517,"w":0.3893808746337889,"t":"time, heavy taxes had been placed on the"},{"t":"amount of glass melted in a glasshouse,","x":0.54927488111659817,"h":0.019321592171425261,"w":0.3768271636962891,"y":0.75692185213028595,"c":1},{"w":0.32921811421712244,"c":1,"x":0.55144032566877887,"y":0.77616279053698878,"t":"and were levied continuously from","h":0.01598837238037687},{"y":0.79240988618656416,"x":0.55125923290017376,"t":"1745 to 1845. Joseph Paxton's Crystal","w":0.35226282755533855,"h":0.020024806225959702,"c":1},{"w":0.36419754028320306,"x":0.55349793765342692,"y":0.81095406347861165,"h":0.016195524146054185,"c":1,"t":"Palace at London's Great Exhibition of"},{"h":0.016195524146054185,"w":0.37448560078938808,"y":0.829799764524636,"c":1,"t":"1851 marked the beginning of glass as a","x":0.55144032709546043},{"y":0.84573108756948412,"t":"material used in the building industry. This","w":0.40575739542643219,"x":0.55124296839572684,"h":0.020020270375677551,"c":1},{"t":"revolutionary new building encouraged","h":0.017639933542312192,"c":1,"y":0.86476895351503813,"x":0.55132182175252886,"w":0.37063486735026041},{"c":1,"h":0.017476100382451065,"x":0.55349793870640063,"y":0.88368669046417514,"t":"the use of glass in public, domestic","w":0.32921811421712233},{"c":1,"y":0.90106007061897997,"h":0.014723203769140158,"t":"and horticultural architecture. Glass","x":0.55349793694478699,"w":0.34156379699707018},{"t":"leltsresources.org","x":0.39483721299237268,"c":1,"w":0.20824633280436194,"h":0.016454192297478354,"y":0.96768258536995222}]}