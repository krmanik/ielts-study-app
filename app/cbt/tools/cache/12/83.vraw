81768,"y":0.58435727384611758,"c":1},{"w":0.38504483540852874,"c":1,"x":0.10892227138751645,"y":0.60273396323296635,"t":"for human beings to control, as it hides in","h":0.019235148165897109},{"y":0.61983691108659633,"x":0.10889187484903971,"t":"impenetrable plantations of young trees.","w":0.37475550333658852,"h":0.019111188477425212,"c":1},{"w":0.37082394917805989,"x":0.11087837275839064,"y":0.63764586891076058,"h":0.019094269463816649,"c":1,"t":"The attempt to reintroduce this predator"},{"h":0.016015764400450716,"w":0.33744855244954425,"y":0.65694935200721249,"c":1,"t":"marries well with the aim of bringing","x":0.11111111479161111},{"y":0.67324622681907442,"t":"forests back to parts of our bare and barren","w":0.40153121948242188,"x":0.10891230170944245,"h":0.018076545077302608,"c":1},{"t":"uplands. The lynx requires deep cover, and","h":0.022476322097688461,"c":1,"y":0.69028474409818363,"x":0.11083810037530251,"w":0.38947245279947917},{"c":1,"h":0.022390511628455401,"x":0.11074090472230788,"y":0.70766337234601073,"t":"as such presents little risk to sheep and","w":0.35881579081217452},{"c":1,"y":0.72663645125158982,"h":0.020069558151478817,"t":"other livestock, which are supposed, as a","x":0.11091154243658811,"w":0.3789924875895182},{"t":"condition of farm subsidies, to be kept out","x":0.11094282831019872,"c":1,"w":0.39337031046549475,"h":0.01999833361981751,"y":0.74476494746958311},{"h":0.014723203769140158,"y":0.76590106020088977,"c":1,"w":0.13168724060058595,"t":"of the woods.","x":0.11111111211092482},{"c":1,"t":"On a recent trip to the Cairngorm","x":0.5390946459564242,"y":0.11773255795378335,"w":0.30658437093098956,"h":0.01598837238037687},{"t":"Mountains, I heard several conservationists","x":0.53897467725120651,"y":0.1348630915477641,"w":0.39118799845377605,"c":1,"h":0.018234395026037409},{"y":0.15089759683258097,"c":1,"w":0.39976264953613283,"h":0.02114602617998429,"x":0.53673018700395481,"t":"suggest that the lynx could be reintroduced"},{"c":1,"t":"there within 20 years. If trees return to","x":0.53689323015360302,"y":0.17047989810249042,"w":0.35424379984537768,"h":0.018443944457001371},{"c":1,"h":0.017465828445129006,"x":0.53909465636669518,"y":0.18895348820324231,"t":"the bare hills elsewhere in Britain, the big","w":0.37654319763183586},{"h":0.015988372380376759,"w":0.36213991800944012,"c":1,"t":"cats could soon follow. There is nothing","x":0.53909465013108238,"y":0.20639534867899767},{"w":0.33539093017578137,"t":"extraordinary about these proposals,","y":0.22379269738638397,"x":0.53909466194400224,"h":0.017486371758127284,"c":1},{"x":0.53909465118809807,"y":0.24263839808076249,"h":0.016195524146054185,"t":"seen from the perspective of anywhere","c":1,"w":0.35596707661946614},{"h":0.01472320376914027,"y":0.26148409915706483,"c":1,"t":"else in Europe. The lynx has now been","x":0.54115226954190521,"w":0.34773661295572911},{"h":0.01903304334804512,"c":1,"x":0.53897810817727232,"t":"reintroduced to the Jura Mountains, the","y":0.27750600786550395,"w":0.36650054931640619},{"h":0.022395114876215816,"x":0.54079712020276871,"c":1,"t":"Alps, the Vosges in eastern France and","y":0.29227302574171399,"w":0.35254422505696614},{"y":0.31204482355836105,"x":0.54091199356670194,"t":"the Harz mountains in Germany, and has","w":0.37498069763183606,"h":0.02204754832776612,"c":1},{"w":0.37860081990559891,"y":0.33127208487578141,"x":0.53909465171620052,"c":1,"t":"re-established itself in many more places.","h":0.016195524146054185},{"t":"The European population has tripled since","w":0.38097409566243479,"h":0.019056307834225406,"y":0.34822873813450927,"x":0.54305445901425908,"c":1},{"x":0.54320988263260173,"w":0.37654319763183597,"h":0.015988372380376759,"y":0.36773255798809679,"c":1,"t":"1970 to roughly 10,000. As with wolves,"},{"h":0.02113911456859574,"c":1,"x":0.54103468206511451,"t":"bears, beavers, boar, bison, moose and","y":0.38364627796146955,"w":0.35831192016601554},{"t":"many other species, the lynx has been able","h":0.023726441975336243,"c":1,"x":0.54283032051334523,"w":0.39171218872070312,"y":0.39956592236697097},{"h":0.022029527365389101,"c":1,"w":0.3792757415771485,"x":0.54085153642882855,"t":"to spread as farming has left the hills and","y":0.41778935023532571},{"x":0.5428847433449997,"t":"people discover that it is more lucrative to","c":1,"y":0.43525259708295183,"h":0.021288059625524491,"w":0.38328193664550791},{"t":"protect charismatic wildlife than to hunt it,","x":0.54309319057289696,"c":1,"y":0.45563352506383292,"w":0.39317634582519534,"h":0.018242924738548161},{"h":0.022423965490046882,"t":"as tourists will pay for the chance to see it.","x":0.54289066020509813,"c":1,"y":0.47101363409544272,"w":0.39145441691080729},{"c":1,"t":"Large-scale rewilding is happening almost","w":0.38511118570963543,"x":0.54303463866278923,"y":0.49002982896983904,"h":0.020415866613668787},{"y":0.50961942246200143,"x":0.54306588536642175,"t":"everywhere - except Britain.","w":0.26158170064290365,"h":0.018338264087906175,"c":1},{"x":0.54510911541862872,"h":0.020131937887418627,"w":0.32952768961588541,"t":"Here, attitudes are just beginning to","y":0.53541262175305548,"c":1},{"w":0.36243815104166666,"t":"change. Conservationists are starting to","h":0.018975638669286976,"c":1,"x":0.54511454103308876,"y":0.55412538936530986},{"c":1,"h":0.020865970562147451,"y":0.57110827959753463,"t":"accept that the old preservation-jar model","x":0.54500666183792668,"w":0.38539744059244785},{"y":0.59010600694456095,"h":0.017452132715914837,"w":0.37860081990559891,"t":"is failing, even on its own terms. Already,","c":1,"x":0.54526749168594246},{"c":1,"x":0.54685858471640647,"y":0.60632847007246149,"w":0.32382377624511716,"t":"projects such as Trees for Life in the","h":0.020693512771660427},{"x":0.5471630065666343,"y":0.62406977512870032,"h":0.020475434751476951,"t":"Highlands provide a hint of what might be","w":0.38919156392415377,"c":1},{"t":"coming. An organisation is being set up","w":0.366698786417