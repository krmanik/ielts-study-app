{"w":2400,"h":3395,"lines":[{"x":0.080246914073945894,"y":0.10600706732611853,"t":"manufacturing techniques also improved","h":0.016195524146054185,"c":1,"w":0.38477366129557283},{"h":0.016910889965906617,"t":"with the advancement of science and the","x":0.080120547965764316,"w":0.38504582722981773,"y":0.12294687993238163,"c":1},{"t":"development of better technology.","h":0.017968965222613709,"x":0.080069678587252238,"y":0.14065408038403726,"w":0.32545913696289064,"c":1},{"t":"From 1887 onwards, glass making","y":0.17525982403450824,"h":0.020447743374270688,"c":1,"x":0.078005389390123039,"w":0.32137110392252605},{"h":0.018453511529030631,"c":1,"w":0.40147196451822914,"t":"developed from traditional mouth-blowing","x":0.078061525804417331,"y":0.19382000931353116},{"y":0.21167212009828851,"x":0.07596010229591045,"t":"to a semi-automatic process, after factory-","w":0.40155708312988275,"h":0.020250515887257126,"c":1},{"t":"owner HM Ashley introduced a machine","w":0.37891222635904942,"x":0.078016184003855696,"y":0.22889707181335439,"h":0.019299674511517484,"c":1},{"w":0.3950617218017578,"h":0.016007204359074878,"t":"capable of producing 200 bottles per hour","x":0.078189303606647609,"c":1,"y":0.24852767950027288},{"t":"in Castleford, Yorkshire, England - more","h":0.018982660363223158,"x":0.076131687711734633,"w":0.38477366129557294,"y":0.2659010601673556,"c":1},{"x":0.076131684935054497,"y":0.2834302323963892,"h":0.017512052443900861,"w":0.40329218546549478,"c":1,"t":"than three times quicker than any previous"},{"h":0.019505989425173897,"x":0.076026182089110911,"c":1,"w":0.39735471089680985,"y":0.30066866366364575,"t":"production method. Then in 1907, the first"},{"t":"fully automated machine was developed","y":0.3182380808693992,"x":0.076011784948586722,"h":0.017698100374219594,"c":1,"w":0.38089726765950516},{"x":0.074074075519079852,"y":0.33716136628185722,"w":0.37860081990559896,"h":0.016036308275094724,"t":"in the USA by Michael Owens - founder","c":1},{"y":0.35347892374430701,"c":1,"t":"of the Owens Bottle Machine Company","x":0.075963492362173646,"w":0.3686906178792318,"h":0.018732687048131247},{"x":0.076131686021700437,"w":0.3683127593994141,"t":"(later the major manufacturers Owens-","h":0.014557139752750747,"c":1,"y":0.37354651149241425},{"c":1,"h":0.013875178931318288,"t":"Ilhinois) - and installed in its factory.","y":0.39174869760814257,"w":0.34387425740559896,"x":0.07600847791896935},{"w":0.32951334635416668,"x":0.078061699958137942,"t":"Owens' invention could produce an","y":0.40645156500639379,"h":0.015832944247691771,"c":1},{"t":"impressive 2,500 bottles per hour. Other","x":0.074074079906779111,"w":0.37654319763183591,"h":0.016195524146054185,"y":0.42579505305654242,"c":1},{"w":0.35239919026692706,"x":0.073787443989741922,"t":"developments followed rapidly, but it","y":0.44229980264247704,"h":0.020623435120419642,"c":1},{"x":0.073827484581274139,"w":0.37499585469563801,"t":"was not until the First World War, when","c":1,"h":0.021163747223583385,"y":0.45923562642602123},{"w":0.40178502400716143,"c":1,"y":0.47720658745631928,"h":0.020416212587390237,"t":"Britain became cut off from essential glass","x":0.073804018718144279},{"h":0.016007204359074767,"x":0.072016455154714026,"y":0.49852767949986265,"t":"suppliers, that glass became part of the","w":0.37037038167317704,"c":1},{"h":0.022627717052949525,"y":0.51169022736857916,"w":0.36689760843912766,"c":1,"t":"scientific sector. Previous to this, glass","x":0.071723492564453054},{"h":0.014567411690072807,"y":0.53343023242073229,"c":1,"w":0.35390945434570314,"x":0.072016466079331043,"t":"had been seen as a craft rather than a"},{"h":0.015988371257085521,"c":1,"x":0.072016461888945185,"t":"precise science.","w":0.15432098388671878,"y":0.5508720932413701},{"h":0.017489796673310853,"c":1,"w":0.35802469889322913,"t":"Today, glass making is big business. It","x":0.072016457009881615,"y":0.58716136626789606},{"w":0.3683127593994141,"h":0.017667844522968212,"c":1,"y":0.60453474696346721,"t":"has become a modern, hi-tech industry","x":0.069958846503845387},{"x":0.8370209593670811,"c":1,"w":0.081272691090901739,"t":"Reading","h":0.015300148648283329,"y":0.063363751858789841},{"h":0.018400865112232823,"c":1,"x":0.51839560257548711,"y":0.10688000163980493,"w":0.38090799967447908,"t":"operating in a fiercely competitive global"},{"t":"market where quality, design and service","x":0.5164609103584028,"h":0.017667844522968212,"w":0.38271603902180995,"y":0.12632508814677779,"c":1},{"w":0.37705744425455712,"c":1,"x":0.51416482187916979,"y":0.14120144277146596,"t":"levels are critical to maintaining market","h":0.019572971285582885},{"y":0.16075365047402346,"x":0.51630196979073384,"t":"share. Modern glass plants are capable","w":0.36244491577148441,"h":0.01831134216524255,"c":1},{"w":0.37273178100585935,"x":0.51630989227182589,"y":0.1783481891469928,"h":0.018155821361025004,"c":1,"t":"of making millions of glass containers a"},{"h":0.019776037640790611,"w":0.39128517150878894,"y":0.19597877797694163,"c":1,"t":"day in many different colours, with green,","x":0.51628945214967614},{"y":0.21231037280318721,"t":"brown and clear remaining the most","w":0.34213307698567696,"x":0.51614232381250658,"h":0.020020569171164126,"c":1},{"t":"popular. Few of us can imagine modern","h":0.01598837238037687,"c":1,"y":0.23255813937521852,"x":0.51440328625394638,"w":0.37037038167317704},{"c":1,"h":0.017736978609514287,"x":0.51424363795530226,"y":0.2496574254050834,"t":"life without glass. It features in almost","w":0.36038937886556},{"c":1,"y":0.265700962877086,"h":0.022212829410117152,"t":"every aspect of our lives - in our homes,","x":0.51415643156678681,"w":0.38121386210123698},{"t":"our cars and whenever we sit down to eat","x":0.51425803474536547,"c":1,"w":0.39331143697102866,"h":0.016927314731341792,"y":0.28528053014104815},{"h":0.018461468924622415,"y":0.30303881983238223,"c":1,"w":0.39745544433593749,"t":"or drink. Glass packaging is used for many","x":0.51425816018277737},{"c":1,"t":"products, many beverages are sold in","x":0.51222826912016828,"y":0.32097363020939274,"w":0.35208971659342447,"h":0.019099265863533055},{"t":"glass, as are numerous foodstuffs, as well","x":0.51422913409178761,"y":0.33855024265141886,"w":0.38919514973958336,"c":1,"h":0.019658981700668043},{"y":0.35570734922355485,"c":1,"w":0.27011619567871092,"h":0.017979789257611234,"x":0.51211395904323942,"t":"as medicines and cosmetics."},{"c":1,"t":"Glass is an ideal material for recycling,","x":0.51217283074444819,"y":0.39158722731993045,"w":0.36458930969238279,"h":0.018738200723493081},{"c":1,"h":0.021332148809174667,"x":0.51202789010866112,"y":0.40941922048476376,"t":"and with growing consumer concern","w":0.34627431233723971},{"h":0.017481236631934904,"w":0.31687243143717447,"c":1,"t":"for green issues, glass bottles and","x":0.51028806399069193,"y":0.4287396937503285},{"w":0.35634407043457039,"t":"jars are becoming ever more popular.","y":0.44500226283176714,"x":0.5080627515491285,"h":0.020230374150899566,"c":1},{"x":0.51234567896634831,"y":0.4636627905431947,"h":0.016019188192342826,"t":"Glass recycling is good news for","c":1,"w":0.30452674865722662},{"h":0.019428037501898032,"y":0.47960936334827298,"c":1,"t":"the environment. It saves used glass","x":0.51210590499035691,"w":0.33794904073079435},{"h":0.01598837238037687,"c":1,"x":0.51234567324045144,"t":"containers being sent to landfill. As less","y":0.49999999984912125,"w":0.37037038167317704},{"h":0.018894777421535669,"x":0.510166830973244,"c":1,"t":"energy is needed to melt recycled glass","y":0.5162509667046975,"w":0.36856508890787765},{"y":0.53396293030796249,"x":0.51007307453272099,"t":"than to melt down raw materials, this also","w":0.39339719136555995,"h":0.020463242547672067,"c":1},{"w":0.39949757893880211,"y":0.55249544528669003,"x":0.51014347515098146,"c":1,"t":"saves fuel and production costs. Recycling","h":0.018798054177292189},{"t":"also reduces the need for raw materials","w":0.37037038167317704,"h":0.01453488398216074,"y":0.571220930094818,"x":0.51028806001873306,"c":1},{"x":0.50823045606367956,"w":0.3374485524495443,"h":0.018924452531183356,"y":0.5886336865970927,"c":1,"t":"to be quarried, thus saving precious"},{"h":0.013081395583944722,"c":1,"x":0.50823045382102516,"t":"resources.","y":0.60901162777488804,"w":0.10288065592447915},{"t":". . . .","h":0.0029446407538280539,"c":0.30000001192092896,"x":0.012345677418122468,"w":0.10699588775634766,"y":0.70347467605406822},{"h":0.013081395583944611,"c":1,"w":0.026748971939086985,"x":0.87860082256955097,"t":"81","y":0.93604651145089246},{"x":0.3946971980310845,"t":"leltsresources.org","c":1,"y":0.96598359624214269,"h":0.018255094476526845,"w":0.2085594177246094}]}