{"lines":[{"c":1,"x":0.10072630456004555,"t":"Test 5","y":0.075373742437976121,"w":0.061921876271565757,"h":0.01495018948935789},{"y":0.12077511585252698,"x":0.10060384911346414,"w":0.30907592773437498,"c":1,"h":0.018353807069668382,"t":"READING PASSAGE 2"},{"y":0.15694935198896087,"t":"You should spend about 20 minutes on Questions 14-26, which are based on Reading","w":0.8271604919433595,"x":0.10082304630206133,"h":0.018922740635237134,"c":1},{"y":0.17873969375849152,"h":0.016027748233718775,"x":0.10082304239590163,"w":0.17078189849853515,"t":"Passage 2 below.","c":1},{"c":1,"t":"COLLECTING AS A HOBBY","y":0.2053082788281515,"w":0.64029474894205729,"h":0.027542484943942513,"x":0.20143133934529678},{"h":0.019729419928417036,"x":0.10067006459459341,"w":0.40161598205566407,"t":"Collecting must be one of the most varied","c":1,"y":0.25281437293606945},{"y":0.27048306156557622,"h":0.02156353558471813,"c":1,"x":0.10065658648255341,"t":"of human activities, and it's one that many","w":0.39951029459635423},{"w":0.3953618367513021,"h":0.021025429625673997,"c":1,"t":"of us psychologists find fascinating. Many","x":0.10066212814053396,"y":0.28800060389743787},{"y":0.3064849995779213,"w":0.37474947611490883,"c":1,"h":0.01988235716263731,"x":0.10070666110838365,"t":"forms of collecting have been dignified"},{"t":"with a technical name: an archtophilist","y":0.3238598720063175,"x":0.10061618880549134,"w":0.36665743509928383,"h":0.020142451894016422,"c":1},{"t":"collects teddy bears, a philatelist collects","y":0.34302325564963176,"c":1,"x":0.10288066260588119,"w":0.38888888041178382,"h":0.017441860778592888},{"y":0.35961796851224737,"x":0.10258500896662857,"h":0.02129634502217681,"c":1,"w":0.33185234069824215,"t":"postage stamps, and a deltiologist"},{"t":"collects postcards. Amassing hundreds or","w":0.39755521138509115,"y":0.3774949826046412,"h":0.020239863715828865,"x":0.10265456625903928,"c":1},{"w":0.37680033365885413,"t":"even thousands of postcards, chocolate","h":0.02043750569733338,"x":0.10276999290583613,"c":1,"y":0.39438778430368848},{"c":1,"t":"wrappers or whatever, takes time, energy","y":0.41569767426382476,"w":0.39300412495930992,"x":0.102880653482565,"h":0.01598837238037687},{"x":0.10268821771049261,"h":0.019741658187165334,"w":0.36457397460937502,"c":1,"y":0.43173877164862429,"t":"and money that could surely be put to"},{"y":0.44905771498027924,"c":1,"x":0.10288066370817452,"h":0.017512051882255353,"t":"much more productive use. And yet there","w":0.3950617218017578},{"w":0.40549924214680994,"t":"are millions of collectors around the world.","c":1,"x":0.10278773431522344,"y":0.46758424725501035,"h":0.016547082871795404},{"y":0.48691860448416457,"t":"Why do they do it?","h":0.017498356714686691,"c":1,"x":0.10493827142477627,"w":0.18106995900472003},{"w":0.36419754028320317,"t":"Some may spend their whole lives in a","x":0.52263374003591534,"y":0.25290697658203098,"h":0.017441860778592999,"c":1},{"c":1,"x":0.52251567294125056,"t":"hunt for this. Psychologically, this can give","w":0.39736086527506509,"y":0.26876340207819949,"h":0.019744387785032069},{"y":0.28488594981381343,"h":0.021228649871790184,"c":1,"t":"a purpose to a life that otherwise feels","x":0.52229054484056037,"w":0.36688540140787751},{"h":0.017500068610632802,"c":1,"x":0.52263375092571129,"y":0.3052325579728864,"t":"aimless. There is a danger, though, that","w":0.37654319763183597},{"w":0.37242797851562504,"h":0.01598837238037687,"c":1,"y":0.3241279068284465,"t":"if the individual is ever lucky enough to","x":0.52263374726244249},{"y":0.34156976728005184,"t":"find what they're looking for, rather than","w":0.38271603902180973,"h":0.017441860778592999,"x":0.52263374992755807,"c":1},{"w":0.37695866902669273,"t":"celebrating their success, they may feel","x":0.52244732209243183,"y":0.35729275530686411,"h":0.021102929985846175,"c":1},{"w":0.39768397013346357,"x":0.52231980277385315,"h":0.02262348673790171,"y":0.37417661075527375,"c":1,"t":"empty, now that the goal that drove them"},{"c":1,"w":0.13234418233235679,"y":0.39603975463661345,"t":"on has gone.","x":0.52244452742357017,"h":0.016682370391414292},{"t":"If you think about collecting postage","h":0.015990084276322869,"y":0.43168433446667553,"x":0.52263374191709655,"w":0.35185185750325521,"c":1},{"c":1,"x":0.52245119932806128,"y":0.44744299610677318,"h":0.018987131062609852,"w":0.35221135457356767,"t":"stamps, another potential reason for"},{"y":0.46511627886942453,"h":0.01751034054795475,"t":"it - or, perhaps, a result of collecting - is","w":0.384773661295573,"c":1,"x":0.52263374558163744},{"y":0.48255813972176775,"x":0.5226337548008797,"c":1,"h":0.017441860216947269,"t":"its educational value. Stamp collecting","w":0.37037035624186199},{"w":0.37889134724934903,"x":0.52662883593395793,"h":0.019338715624050984,"c":1,"t":"opens a window to other countries, and","y":0.50137590872891602},{"t":"There are the people who collect because","y":0.51901684521842306,"w":0.3996535746256511,"x":0.10469079465213472,"h":0.020696179465214071,"c":1},{"y":0.51786802941277144,"w":0.38718373616536461,"h":0.021448670062636843,"t":"to the plants, animals, or famous people","x":0.522492253920401,"c":1},{"y":0.5385684473304172,"h":0.019457984448040921,"w":0.39325017293294268,"c":1,"t":"they want to make money - this could be","x":0.10276925462183073},{"t":"shown on their stamps. Similarly, in the","x":0.52674897073110571,"y":0.53621908153105569,"w":0.3683127593994141,"h":0.017667844522968212,"c":1},{"x":0.10462623396282311,"t":"called an instrumental reason for collecting; 19th century, many collectors amassed","h":0.030104429337104999,"y":0.54856664143757938,"w":0.78253468831380213,"c":1},{"y":0.57402685570879619,"t":"that is, collecting as a means to an end.","x":0.10480028823442482,"w":0.37681175231933595,"h":0.01987493894687109,"c":1},{"x":0.52674896544999483,"y":0.57267441844249611,"w":0.37037038167317715,"c":1,"t":"fossils, animals and plants from around","h":0.017441860778592999},{"y":0.59302325564914027,"w":0.36213991800944012,"h":0.017441860778592888,"t":"They'll look for, say, antiques that they","c":1,"x":0.10493827138698852},{"x":0.52852027808138524,"h":0.02245630953983091,"y":0.58770261457866868,"c":1,"t":"the globe, and their collections provided","w":0.38744135538736968},{"h":0.02258710108600881,"w":0.3690174102783203,"c":1,"y":0.60768720898486328,"t":"can buy cheaply and expect to be able","x":0.10457962120931863},{"c":1,"x":0.52880658615371012,"t":"a vast amount of information about the","y":0.60747938752463926,"w":0.37242797851562504,"h":0.016195524146054185},{"y":0.62759947422874029,"h":0.01834330429598352,"t":"to sell at a profit. But there may well be a","c":1,"x":0.10480573370593968,"w":0.39121454874674477},{"w":0.38683128356933605,"x":0.52880658032881867,"y":0.62632508816292343,"t":"natural world. Without those collections,","c":1,"h":0.016195524146054185},{"x":0.10683035179837068,"c":1,"y":0.64343714740590885,"t":"psychological element, too - buying cheap","w":0.40769704182942706,"h":0.021265436538678295},{"t":"our understanding would be greatly inferior","y":0.64219133978363052,"w":0.42222178141276046,"h":0.022159169784563892,"x":0.52246504526265158,"c":1},{"y":0.66424418587233158,"x":0.10493827682242837,"h":0.017441860778592888,"w":0.38271603902180984,"t":"and selling dear can give the collector a","c":1},{"y":0.66108182265286775,"x":0.52435739271268667,"w":0.12423881530761716,"t":"to what it is.","h":0.018121894593794874,"c":1},{"t":"sense of triumph. And as selling online is so","y":0.6816843344530511,"w":0.41563786824544269,"x":0.10493826743300104,"h":0.017443572674538999,"c":1},{"h":0.019783406431739592,"c":1,"w":0.40766817728678384,"t":"easy, more and more people are joining in.","x":0.10685185855116666,"y":0.69897225250348971},{"h":0.017667844522968212,"y":0.69758539479618931,"c":1,"t":"In the past - and nowadays, too, though","x":0.52674896723241205,"w":0.38683128356933594},{"c":1,"x":0.52853569421133439,"t":"to a lesser extent - a popular form of","y":0.71276132087391286,"w":0.35659383138020839,"h":0.021273636565191545},{"c":1,"x":0.10878950469602046,"w":0.38733167012532554,"y":0.73216015051425076,"t":"Many collectors collect to develop their","h":0.021322636778419279},{"y":0.73061039930421989,"c":1,"x":0.53058259536307761,"h":0.021945980328131887,"w":0.33387799580891919,"t":"collecting, particularly among boys"},{"y":0.7509008879678879,"c":1,"w":0.39128196716308589,"h":0.02149273678046093,"x":0.10681929049065374,"t":"social life, attending meetings of a group"},{"y":0.74831424571164162,"w":0.37069351196289069,"x":0.53070420578484323,"c":1,"h":0.021092420472413553,"t":"and men, was trainspotting. This might"},{"y":0.76884570064055358,"t":"of collectors and exchanging information","c":1,"x":0.10905350333834671,"w":0.38888888041178382,"h":0.018944996405827252},{"t":"involve trying to see every locomotive of a","y":0.76731724352693731,"x":0.53076469153022321,"h":0.019563670433592528,"c":1,"w":0.40349484761555998},{"x":0.10905350320098023,"y":0.78916372230647436,"h":0.01472320376914027,"w":0.35390945434570314,"c":1,"t":"on items. This is a variant on joining a"},{"h":0.020599359617918478,"t":"particular type, using published data that","c":1,"x":0.53056912386405453,"y":0.78492026536729076,"w":0.39352371215820303},{"t":"bridge club or a gym, and similarly brings","h":0.022402160159269435,"c":1,"y":0.80285728428383552,"x":0.10885967524815414,"w":0.39337483723958327},{"c":1,"w":0.38091913859049475,"y":0.80203128126757528,"h":0.021516847104992465,"t":"identifies each one, and ticking off each","x":0.52868564431260323},{"w":0.41769546508789063,"x":0.1069958888683908,"y":0.82412790682377191,"h":0.01598837238037687,"t":"them into contact with like-minded people.","c":1},{"x":0.52871623705293147,"c":1,"h":0.01887024698605666,"y":0.82140275046938316,"w":0.4158329518636068,"t":"engine as it is seen. Trainspotters exchange"},{"y":0.84010600697054683,"c":1,"h":0.017452132715914948,"x":0.530864194446516,"w":0.38065844217936196,"t":"information, these days often by mobile"},{"y":0.85895170801316822,"c":1,"w":0.39917696634928385,"t":"Another motive for collecting is the desire","x":0.10905349208684641,"h":0.017501780506578801},{"h":0.018686021034231781,"c":1,"y":0.87631739834308975,"t":"to find something special, or a particular","x":0.10689412718453326,"w":0.38910100301106776},{"x":0.10905349393728585,"t":"example of the collected item, such as a","w":0.38683128356933594,"h":0.017489796673310853,"y":0.89534883704498058,"c":1},{"t":"rare early recording by a particular singer.","w":0.39754417419433591,"c":1,"x":0.10880170450260589,"h":0.021942723906643979,"y":0.91074537393324728},{"h":0.019383641659721951,"c":1,"w":0.38923467000325518,"t":"phone, so they can work out where to go","x":0.53272056077604057,"y":0.85650381770813555},{"y":0.87473928050416738,"w":0.36457987467447917,"x":0.53067484387891306,"t":"to, to see a particular engine. As a by-","h":0.019645398862229935,"c":1},{"c":1,"x":0.53276871654610281,"y":0.89190562206617419,"t":"product, many practitioners of the hobby","w":0.39326749165852859,"h":0.019821702802139129},{"y":0.9113372091381966,"t":"become very knowledgeable about railway","w":0.40740740458170566,"x":0.53292181204792088,"c":1,"h":0.017441860778592888},{"t":"20","x":0.10905349764671167,"y":0.94912790722608864,"w":0.026748971939086916,"h":0.014534882858869502,"c":1},{"c":1,"w":0.2082509613037109,"y":0.9676783313383841,"h":0.016460005329972383,"t":"leltsresources.org","x":0.39483478493883561}],"w":2400,"h":3395}