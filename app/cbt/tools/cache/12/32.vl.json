{"blocks":[{"l":"header","b":[0.84,0.0616,0.9313,0.0804],"t":"Listening"},{"l":"paragraph_title","b":[0.0892,0.1057,0.5088,0.1261],"t":"SECTION 3 Questions 21–30"},{"l":"text","b":[0.0912,0.1429,0.2737,0.1608],"t":"Questions 21–25"},{"l":"text","b":[0.0892,0.1788,0.4333,0.1968],"t":"Choose the correct letter, A, B or C."},{"l":"doc_title","b":[0.3554,0.2177,0.6613,0.2401],"t":"Scandinavian Studies"},{"l":"paragraph_title","b":[0.0862,0.2566,0.8321,0.2751],"t":"21 James chose to take Scandinavian Studies because when he was a child"},{"l":"text","b":[0.1329,0.2839,0.4875,0.3007],"t":"A he was often taken to Denmark."},{"l":"text","b":[0.1338,0.3028,0.5121,0.319],"t":"B his mother spoke to him in Danish."},{"l":"text","b":[0.1338,0.3202,0.6062,0.3378],"t":"C a number of Danish people visited his family."},{"l":"paragraph_title","b":[0.0854,0.3467,0.5242,0.3649],"t":"22 When he graduates, James would like to"},{"l":"text","b":[0.1321,0.3747,0.4487,0.3918],"t":"A take a postgraduate course."},{"l":"text","b":[0.1329,0.3932,0.3592,0.4097],"t":"B work in the media."},{"l":"text","b":[0.1321,0.4109,0.3779,0.4274],"t":"C become a translator."},{"l":"paragraph_title","b":[0.0842,0.4374,0.4446,0.4551],"t":"23 Which course will end this term?"},{"l":"text","b":[0.1313,0.4651,0.3412,0.4819],"t":"i Swedish cinema"},{"l":"text","b":[0.1308,0.4839,0.4717,0.5007],"t":"B Danish television programmes"},{"l":"text","b":[0.1313,0.5016,0.4025,0.5187],"t":"C Scandinavian literature"},{"l":"paragraph_title","b":[0.0829,0.5287,0.7017,0.547],"t":"24 They agree that James's literature paper this term will be on"},{"l":"text","b":[0.1304,0.5561,0.4188,0.5738],"t":"A 19th century playwrights."},{"l":"text","b":[0.1313,0.5753,0.3725,0.5912],"t":"B the Icelandic sagas."},{"l":"text","b":[0.13,0.5932,0.4625,0.6097],"t":"C modern Scandinavian novels."},{"l":"paragraph_title","b":[0.0821,0.6197,0.5938,0.6371],"t":"i25 Beth recommends that James's paper should be"},{"l":"text","b":[0.1288,0.6477,0.4992,0.6645],"t":"A a historical overview of the genre."},{"l":"text","b":[0.1292,0.6657,0.5383,0.6822],"t":"B an in-depth analysis of a single writer."},{"l":"text","b":[0.1292,0.6837,0.6412,0.701],"t":"辜负 a study of the social background to the literature."},{"l":"footer","b":[0.3954,0.9649,0.6033,0.9826],"t":"leitsresources.org"},{"l":"number","b":[0.8917,0.9361,0.9204,0.9508],"t":"33"}]}