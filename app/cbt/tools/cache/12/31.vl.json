{"blocks":[{"l":"paragraph_title","b":[0.0996,0.0692,0.1642,0.0866],"t":"Test 6"},{"l":"text","b":[0.0983,0.1152,0.2825,0.1352],"t":"Questions 16–20"},{"l":"text","b":[0.0958,0.1496,0.7612,0.1708],"t":"What does the man say about the play on each of the following days?"},{"l":"text","b":[0.0975,0.185,0.8246,0.223],"t":"Choose FIVE answers from the box and write the correct letter, A–G, next to Questions 16–20."},{"l":"paragraph_title","b":[0.4608,0.2527,0.5796,0.2716],"t":"iComments"},{"l":"text","b":[0.2104,0.2807,0.5525,0.301],"t":"A The playwright will be present."},{"l":"text","b":[0.21,0.3075,0.7275,0.3284],"t":"B The play was written to celebrate an anniversary."},{"l":"text","b":[0.2112,0.3346,0.7533,0.3561],"t":"C The play will be performed inside a historic building."},{"l":"text","b":[0.2121,0.3623,0.6817,0.3835],"t":"D The play will be accompanied by live music."},{"l":"text","b":[0.2121,0.39,0.6129,0.4109],"t":"E The play will be performed outdoors."},{"l":"text","b":[0.2117,0.4174,0.6767,0.4389],"t":"F The play will be performed for the first time."},{"l":"text","b":[0.2125,0.4448,0.8292,0.4666],"t":"G The performance will be attended by officials from the town."},{"l":"paragraph_title","b":[0.1475,0.5102,0.2079,0.5308],"t":"Days"},{"l":"text","b":[0.1021,0.5455,0.4029,0.5655],"t":"16 Wednesday"},{"l":"text","b":[0.1025,0.5729,0.4033,0.5932],"t":"17 Thursday"},{"l":"text","b":[0.1037,0.6009,0.4033,0.6209],"t":"18 Friday"},{"l":"text","b":[0.1042,0.6283,0.4033,0.6483],"t":"i9 Saturday"},{"l":"text","b":[0.1025,0.656,0.4033,0.676],"t":"20 Monday"},{"l":"number","b":[0.1071,0.9426,0.1371,0.9594],"t":"32"},{"l":"footer","b":[0.3954,0.9644,0.6033,0.9832],"t":"leitsresources.org"}]}