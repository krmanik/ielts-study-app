{"lines":[{"x":0.098694802997826417,"y":0.076883810992256718,"w":0.061869653065999355,"h":0.014837029123474732,"t":"Test 5","c":1},{"y":0.11728254102183699,"h":0.019795382963614161,"c":1,"x":0.45254845387762904,"t":"READING","w":0.13194012959798179},{"w":0.30704640706380204,"h":0.018573686849101989,"c":1,"t":"READING PASSAGE 1","x":0.10059967249614658,"y":0.18158484875639425},{"y":0.21546038826068381,"w":0.8192477925618491,"c":1,"h":0.022293336821107901,"x":0.10067161608223718,"t":"You should spend about 20 minutes on Questions 1-13, which are based on Reading"},{"t":"Passage 1 below.","y":0.23715346597358045,"x":0.10045018709985588,"w":0.16942005157470702,"h":0.019780813875411751,"c":1},{"t":"Cork","y":0.28211488450547817,"c":1,"x":0.45409655219385836,"w":0.13501677195231121,"h":0.0360609285963438},{"y":0.35416149031961819,"x":0.12117804930791153,"h":0.017998932949645829,"c":1,"w":0.37078175862630208,"t":"Cork - the thick bark of the cork oak"},{"t":"tree (Quercus suber) - is a remarkable","w":0.3812730916341146,"y":0.37058579631327992,"h":0.021295630608908045,"x":0.12106371087036914,"c":1},{"w":0.37273551940917971,"t":"material. It is tough, elastic, buoyant,","h":0.019554776213053904,"x":0.12119912409207037,"c":1,"y":0.3903286503078498},{"c":1,"t":"and fire-resistant, and suitable for a","y":0.40760133707621038,"w":0.3606177266438802,"x":0.12111204043187229,"h":0.021730209548285195},{"x":0.12114192840370767,"h":0.020789967549282418,"w":0.35027519226074216,"c":1,"y":0.42554345631397861,"t":"wide range of purposes. It has also"},{"y":0.44456930764421565,"c":1,"x":0.12127901834750522,"h":0.016497893945628839,"t":"been used for millennia: the ancient","w":0.36238126118977865},{"w":0.33979237874348955,"t":"Egyptians sealed their sarcophagi","c":1,"x":0.1212788227263826,"y":0.46196358296788076,"h":0.019397239100947039},{"y":0.48110465101228128,"t":"(stone coffins) with cork, while the","h":0.015988372380376759,"c":1,"x":0.12139917955398431,"w":0.34362139383951823},{"w":0.35626233418782555,"t":"ancient Greeks and Romans used it","x":0.12123795338466266,"y":0.49751210600779483,"h":0.017244377181162118,"c":1},{"c":1,"x":0.12121451566457551,"t":"for anything from beehives to sandals.","w":0.38512690226236979,"y":0.51440516478251197,"h":0.021049348990684114},{"y":0.55012223625747403,"h":0.018666858246245033,"c":1,"t":"And the cork oak itself is an","x":0.12316696576032418,"w":0.28033739725748696},{"h":0.017441860778592999,"c":1,"x":0.12551440680316811,"y":0.56976744169454685,"t":"extraordinary tree. Its bark grows","w":0.33744855244954425},{"t":"up to 20 cm in thickness, insalating","w":0.35390945434570314,"x":0.12551440882981779,"y":0.58716136625055515,"h":0.017489796673310853,"c":1},{"h":0.020054182540120702,"x":0.12531674073623444,"w":0.35642733256022135,"t":"the tree like a coat wrapped around","c":1,"y":0.60393267242158033},{"c":1,"t":"the trunk and branches and keeping","y":0.6220930230741587,"w":0.36419754028320311,"h":0.017482948527881015,"x":0.12551439882077348},{"y":0.63664824699664568,"h":0.022252596168832683,"x":0.12532771406412763,"w":0.37076143900553388,"t":"the inside at a constant 20°C all year","c":1},{"y":0.65683895252379687,"t":"round. Developed most probably as","w":0.35437159220377601,"x":0.12526832135057966,"h":0.02029590808881887,"c":1},{"y":0.67522143494359999,"x":0.125304791386708,"w":0.32964111328125001,"c":1,"h":0.020454023695946844,"t":"a defence against forest fires, the"},{"c":1,"x":0.12739938951218713,"t":"bark of the cork oak has a particular","y":0.6929132357218396,"w":0.36865587870279948,"h":0.019521376269444946},{"h":0.017440788035398391,"c":1,"w":0.30486305236816408,"y":0.71146703636056829,"x":0.1253345749058758,"t":"cellular structure - with about"},{"t":"40 million cells per cubic centimetre -","x":0.12735610955523261,"h":0.020242306874413307,"c":1,"y":0.72828606309264998,"w":0.381066640218099},{"w":0.36896886189778644,"h":0.022758225529718956,"c":1,"y":0.74512020445255633,"t":"that technology has never succeeded","x":0.12726227095830506},{"y":0.76349477820983869,"t":"in replicating. The cells are filled with","w":0.37704137166341145,"h":0.021344273615501286,"x":0.12526922502878476,"c":1},{"w":0.36855293273925782,"t":"air, which is why cork is so buoyant.","x":0.12743241036231381,"y":0.7822989417392282,"h":0.018749489801090147,"c":1},{"w":0.34567901611328133,"x":0.1275720144987921,"h":0.01453488398216074,"y":0.80232558125931008,"c":1,"t":"It also has an elasticity that means"},{"c":1,"w":0.37505821228027347,"y":0.81716600322337385,"t":"you can squash it and watch it spring","x":0.12725405574487761,"h":0.021214477305417923},{"t":"back to its original size and shape","h":0.020731127304238983,"y":0.83512180582984474,"x":0.12741761406163543,"w":0.34190546671549477,"c":1},{"c":1,"x":0.1296296377794556,"y":0.85453474675185614,"h":0.017667844522968212,"w":0.31275718688964849,"t":"when you release the pressure."},{"y":0.88916548246138605,"h":0.019954180408563227,"t":"Cork oaks grow in a number of","w":0.30899396260579426,"c":1,"x":0.12947300092703454},{"y":0.90694935239646135,"x":0.12962963033842109,"c":1,"h":0.017469251675375497,"t":"Mediterranean countries, including","w":0.34567901611328122},{"w":0.32304527282714846,"x":0.53909464746477154,"h":0.017667844522968323,"c":1,"t":"Portugal, Spain, Italy, Greece and","y":0.35306242661188114},{"t":"Morocco. They flourish in warm, sunny","y":0.36914676858412576,"w":0.3830537414550782,"x":0.53893872907980145,"h":0.020982196389996988,"c":1},{"y":0.38801820502491646,"w":0.37481508890787762,"h":0.016835013884958894,"t":"climates where there is a minimum of","x":0.53894329257967943,"c":1},{"y":0.40543992230556469,"h":0.019796441104021678,"w":0.36049845377604162,"c":1,"t":"400 millimetres of rain per year, and","x":0.53892803269713574},{"t":"not more than 800 millimetres. Like","x":0.53909465105755094,"y":0.42432273270472665,"w":0.35596707661946614,"h":0.016195524146054185,"c":1},{"x":0.54100049484437462,"t":"grape vines, the trees thrive in poor","h":0.018855327430967739,"y":0.44196014893520252,"w":0.35008519490559908,"c":1},{"y":0.45742806089125909,"t":"soil, putting down deep roots in search","x":0.53883625031961058,"w":0.38326004028320315,"h":0.022247123493603471,"c":1},{"x":0.5411522605103587,"y":0.47819767426529625,"w":0.35185185750325521,"c":1,"t":"of moisture and nutrients. Southern","h":0.01598837238037687},{"y":0.49412200377344329,"w":0.37273297627766933,"h":0.020091961073229636,"t":"Portugal's Alentejo region meets all of","c":1,"x":0.5410204497424691},{"x":0.54092525517392909,"h":0.021318779396084064,"y":0.51258139078826903,"c":1,"t":"these requirements, which explains","w":0.35024767557779957},{"h":0.022385427612017228,"w":0.34617304484049483,"c":1,"y":0.53032897440327287,"t":"why, by the early 20th century, this","x":0.54093469640949365},{"c":1,"x":0.54101454529204618,"t":"region had become the world's largest","y":0.54749372973406318,"w":0.37884610493977866,"h":0.019530239037827135},{"y":0.56548004874301505,"h":0.020348233244304015,"t":"producer of cork, and why today it","c":1,"x":0.54097123610678566,"w":0.34395088195800771},{"w":0.35033994038899741,"x":0.54090338790777137,"y":0.58312323295390256,"t":"accounts for roughly half of all cork","c":1,"h":0.020684286056895984},{"x":0.54302773103007784,"c":1,"y":0.60185305547656875,"t":"production around the world.","w":0.29247057596842441,"h":0.018862404166177793},{"t":"Most cork forests are family-owned.","y":0.63662790720723295,"w":0.36213991800944012,"h":0.01744185965530165,"x":0.54320987959610301,"c":1},{"y":0.65396138585639685,"x":0.54307584650631091,"h":0.020738900480056999,"w":0.37068636576334624,"t":"Many of these family businesses, and","c":1},{"y":0.6728504123446144,"x":0.54115226945274764,"w":0.37654319763183586,"t":"indeed many of the trees themselves,","h":0.017667844522968212,"c":1},{"t":"are around 200 years old. Cork","y":0.68951376073466319,"w":0.3153908284505208,"x":0.54291675495043712,"h":0.021665792161921327,"c":1},{"h":0.019867489278948325,"c":1,"w":0.38302101135253908,"t":"production is, above all, an exercise in","x":0.54509535638272233,"y":0.7075726991702791},{"h":0.021082641098328025,"y":0.72465049002104365,"c":1,"t":"patience. From the planting of a cork","x":0.5450132099683157,"w":0.37288396199544271},{"c":1,"x":0.54291184110975921,"t":"sapling to the first harvest takes 25","y":0.74139027432213045,"w":0.35457361857096359,"h":0.022675980387082295},{"c":1,"x":0.54299426532496464,"w":0.36252451578776035,"y":0.76032659347559683,"t":"years, and a gap of approximately a","h":0.021240929692316723},{"y":0.77858958122884103,"c":1,"x":0.5450498622065425,"h":0.020914623678362387,"w":0.36462537129720052,"t":"decade must separate harvests from"},{"y":0.79796511611468157,"c":1,"w":0.37860081990559891,"h":0.017441860778592888,"x":0.54526749122401086,"t":"an individual tree. And for top-quality"},{"y":0.81221074151587291,"w":0.36271591186523433,"x":0.54496707576882808,"c":1,"h":0.022694169843154754,"t":"cork, it's necessary to wait a further"},{"y":0.83185901669085704,"t":"15 or 20 years. You even have to wait","c":1,"x":0.5471064696705944,"w":0.37697751363118492,"h":0.02068334473878386},{"t":"for the right kind of summer's day to","y":0.84684550637767586,"x":0.54505784934444079,"h":0.022966782532816699,"c":1,"w":0.37073750813802087},{"x":0.54506211062657639,"y":0.86706008101293863,"h":0.02056188774333545,"w":0.38720352172851558,"c":1,"t":"harvest cork. If the bark is stripped on"},{"h":0.024374071083023918,"t":"a day when it's too cold - or when the","c":1,"x":0.54690464321600141,"y":0.8818654298897447,"w":0.38139058430989592},{"t":"air is damp - the tree will be damaged.","h":0.020078405193782678,"c":1,"y":0.90351945114045673,"x":0.54716132012870888,"w":0.38503578186035148},{"c":1,"w":0.024691357612609877,"y":0.94912790672500502,"h":0.01453488398216074,"t":"16","x":0.11316872448587614},{"w":0.20858486175537111,"x":0.39469719816268461,"y":0.96518376431307307,"h":0.019054927309213654,"t":"leltsresources.org","c":1}],"w":2400,"h":3395}