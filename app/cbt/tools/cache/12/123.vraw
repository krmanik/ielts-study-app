27045,"t":"However, the percentage coulan't over 50%.","w":0.41012420654296872},{"y":0.66217717938715681,"c":1,"t":"Then, women's percentages are increase until 5A age like 52.5, 53.3. Although","w":0.7658904520670573,"x":0.10678655530623625,"h":0.025615954988836842},{"c":1,"x":0.10883226897688833,"y":0.67863427484583216,"w":0.81938573201497389,"h":0.0258385823387981,"t":"women's percentages are decrease after 55 age, the percentages are higher than men's"},{"x":0.1085841373512887,"t":"percentages.","w":0.116123161315918,"h":0.018210418934816452,"c":1,"y":0.70559508292085105},{"c":1,"w":0.75969355265299487,"t":"In conclusion, men did regular physical ackivity more than women when they were","y":0.7235562827130233,"x":0.11091215569752781,"h":0.024310360246889706},{"y":0.74644000876838412,"h":0.020372309870096417,"x":0.1108295881426946,"t":"teenager and mid twenties.","c":1,"w":0.25982704162597653},{"w":0.80695760091145841,"t":"After mid-twenties, however, men's percentage was decreased and women's percentage","x":0.11297835685409799,"h":0.024699555971035458,"y":0.76503104896238494,"c":1},{"x":0.11096986320730534,"y":0.7922781516181886,"w":0.13001302083333335,"t":"was increase.","h":0.013054188345290152,"c":1},{"x":0.11522633805815626,"t":"124","w":0.037037035624186185,"y":0.9476744184312863,"h":0.01453488398216074,"c":1},{"w":0.20824633280436194,"t":"leltsresources.org","x":0.39483721299237268,"y":0.96768258536995222,"c":1,"h":0.016454192297478354}],"w":2400,"h":3395}