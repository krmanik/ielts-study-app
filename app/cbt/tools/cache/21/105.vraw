{"h":2857,"lines":[{"y":0.10150157919427527,"t":"FERGUS:","h":0.010659632272366548,"c":1,"w":0.050309524536132827,"x":0.19024316152110737},{"t":"NADIA:","x":0.19029901411066025,"h":0.011695710990377139,"c":1,"y":0.16421028392378145,"w":0.045007508595784507},{"c":1,"x":0.18853596057659217,"y":0.19607175772812613,"h":0.0119262519126343,"w":0.053723926544189449,"t":"FERGUS:"},{"c":1,"x":0.19188406066850897,"h":0.011120431151233179,"w":0.04183741569519045,"t":"NADIA:","y":0.21173629593307219},{"y":0.22819767419816162,"t":"FERGUS:","w":0.050173009236653632,"c":1,"x":0.19031141923166303,"h":0.011627907349230804},{"t":"TUTOR:","c":1,"y":0.24418604630212881,"x":0.18858131505088058,"w":0.046712802251180019,"h":0.011627907349230804},{"x":0.19026783120587978,"w":0.043339770634969077,"h":0.013285867145129915,"t":"NADIA:","y":0.27460706629785125,"c":1},{"t":"FERGUS:","y":0.30813953467742949,"h":0.011627907349230804,"w":0.051903114318847671,"x":0.18858131472937226,"c":1},{"t":"NADIA:","y":0.35591052186158034,"c":1,"x":0.19024774648176168,"w":0.043379939397176104,"h":0.010562677163190148},{"h":0.013081395100512871,"t":"FERGUS:","x":0.18858131524542046,"w":0.051903114318847643,"c":1,"y":0.40261627903041219},{"x":0.1902829630691231,"h":0.011777923188900363,"y":0.41852964286461725,"w":0.043309507369995115,"c":1,"t":"NADIA:"},{"h":0.013883608049909291,"t":"FERGUS:","y":0.45018028883950412,"w":0.052182041803995771,"c":1,"x":0.18844185137662786},{"y":0.46656976753758483,"x":0.18858131410316731,"t":"NADIA:","c":1,"w":0.04498270034790039,"h":0.013081395100512871},{"x":0.18858131479126822,"h":0.011627907349230804,"t":"FERGUS:","y":0.49854651140532646,"w":0.051903114318847643,"c":1},{"t":"TUTOR:","y":0.53633720907135951,"x":0.18858131514404003,"w":0.046712802251180019,"h":0.011627907349230804,"c":1},{"w":0.052222121556599943,"h":0.01267517922723771,"y":0.58377868943441558,"t":"FERGUS:","c":1,"x":0.18842181111109535},{"c":1,"t":"NADIA:","y":0.61473501099428474,"w":0.043329881032307949,"x":0.19027277607218337,"h":0.013262535826654265},{"y":0.63223043891484498,"w":0.050194238026936844,"x":0.19030080477549841,"c":1,"h":0.010248424457953154,"t":"FERGUS:"},{"t":"NADIA:","y":0.66246885490528962,"w":0.045242605209350584,"c":1,"x":0.18845136209783153,"h":0.01372508055017585},{"y":0.69614457670975038,"x":0.19028959750977345,"w":0.0502166525522868,"t":"FERGUS:","h":0.010327125613384114,"c":1},{"t":"NADIA:","x":0.18845281285087412,"h":0.012348704942045208,"y":0.75836053122441294,"w":0.045239702860514347,"c":1},{"w":0.051903114318847671,"c":1,"h":0.011627907349230804,"y":0.79069767415968695,"x":0.18858131494265232,"t":"FERGUS:"},{"y":0.83720930228622614,"c":1,"h":0.01308139510051276,"t":"NADIA:","w":0.044982697168986008,"x":0.18858131612138937},{"x":0.19028515338728638,"w":0.050225540796915685,"c":1,"h":0.010358502099028444,"t":"FERGUS:","y":0.87054749311869273},{"h":0.011627907349230804,"t":"NADIA:","x":0.18858131409940621,"y":0.88662790676627601,"w":0.04498270034790039,"c":1},{"y":0.91851156195704531,"w":0.050226135253906262,"t":"FERGUS:","x":0.19028485615898119,"c":1,"h":0.010360596979139824},{"w":0.04329569816589357,"t":"TUTOR:","y":0.93452809246642055,"x":0.19028986708982978,"h":0.010304280141586242,"c":1},{"x":0.27335639169594989,"h":0.016155182189087181,"c":1,"t":"Yeah. And another thing, we've had effective ways of analysing DNA for some","w":0.5432526143391927,"y":0.098670399125805219},{"y":0.11476557010884603,"c":1,"x":0.27508650828858205,"t":"time now and these can easily be applied to analysing food. But what the","w":0.50865051269531247,"h":0.013296011196641033},{"y":0.13081395360960124,"h":0.01308139510051276,"t":"researchers succeeded in doing was to ensure that these tests were carried out","w":0.55190312703450517,"x":0.27508649870325408,"c":1},{"c":1,"t":"at different stages in the food's journey from the producer to the consumer.","y":0.14520643800181743,"x":0.27335641116464371,"w":0.52595153808593742,"h":0.016130771063023075},{"t":"So they knew that the food actually came from the place it was supposed to,","x":0.2750865120514997,"c":1,"h":0.016095171448565426,"y":0.16270118984215154,"w":0.53287195841471358},{"x":0.27508650215140357,"y":0.17877906952665157,"w":0.2837370300292969,"h":0.014534884186538477,"c":1,"t":"and had the ingredients it was meant to."},{"w":0.42387542724609378,"h":0.014534884186538477,"c":1,"x":0.27508650773924143,"y":0.19476744162451487,"t":"Exactly. So customers can be confident about what they buy."},{"c":1,"t":"And the researchers had a good system for publicising their findings too.","y":0.20923722871802775,"x":0.27508650590827621,"w":0.50692042032877604,"h":0.016095171448565426},{"h":0.016136874178225069,"y":0.22529069759213627,"c":1,"t":"Well, I thought there were some problems with that, actually.","w":0.42387542724609378,"x":0.27508651165376968},{"y":0.24127906952820632,"w":0.50692042032877604,"t":"OK. And do you have any recommendations for new topics that we could","x":0.27681660649436801,"h":0.014534884186538477,"c":1},{"c":1,"y":0.2585724284646046,"h":0.011896431070678726,"t":"include in the course?","w":0.15397923787434897,"x":0.27508650556961689},{"h":0.016107377011597368,"c":1,"t":"Well, I'm interested in how crop yields can be increased without damaging the","y":0.27325581402553833,"w":0.54498270670572913,"x":0.27335639749716906},{"c":1,"t":"environment.","x":0.27508650495758585,"y":0.29069767470593466,"w":0.093425604502360038,"h":0.011627906014487266},{"y":0.30510846745700926,"c":1,"h":0.01469559132260323,"w":0.52941177368164061,"t":"But we've already done quite a bit on that - but not so much on the seafood","x":0.27681660442608746},{"h":0.016095171448565537,"x":0.27335639434018577,"y":0.32120363870026925,"w":0.53633219401041665,"c":1,"t":"industry, where stocks are in danger of being overexploited as a food source"},{"t":"unless we can find ways of keeping stocks up.","x":0.27326667301140239,"y":0.3360575816525706,"h":0.017667546148814051,"w":0.32027979532877604,"c":1},{"y":0.3530440868759479,"w":0.53114186604817704,"c":1,"x":0.2733564026614651,"h":0.01614195955141684,"t":"Yes, that'd be a good topic. And I'm interested in the idea of a personalised"},{"t":"approach to diet, now we have the technology to analyse exactly what","x":0.27335639813160278,"h":0.016095171448565426,"c":1,"y":0.36913925848279305,"w":0.49134948730468747},{"h":0.016557255685538008,"c":1,"t":"individuals need.","x":0.27481519284015549,"y":0.38333496739879425,"w":0.12009222666422525},{"y":0.4011627904613424,"h":0.014534884186538477,"t":"That sounds more like a medical topic than food science.","x":0.27335640714018183,"w":0.39792386372884114,"c":1},{"x":0.27335639997588906,"w":0.53806228637695308,"c":1,"h":0.016095171448565537,"t":"OK. What about sessions on the variety of food and eating habits around the","y":0.41707487759616413},{"c":1,"t":"world? That's very relevant nowadays.","w":0.26643597920735679,"h":0.014534884186538477,"x":0.27335640477421114,"y":0.4331395346448097},{"c":1,"w":0.38062283833821614,"y":0.44912790674046277,"x":0.27335640080986584,"t":"Yes, I think the whole class would be interested in that.","h":0.014534884186538477},{"c":1,"w":0.51038060506184901,"t":"Then there's technological stuff, things like 3D printing of food and smart","x":0.27335641005401734,"y":0.46361091693175926,"h":0.017494751574527623},{"c":1,"x":0.27333963323274568,"h":0.017239148171319996,"t":"packaging.","y":0.47928305307278685,"w":0.081518904368082679},{"y":0.49709302301621783,"w":0.20761245727539063,"c":1,"h":0.014534884186538477,"t":"Mmm - maybe too specialist.","x":0.27335640102630882},{"c":1,"h":0.015988371937820545,"x":0.27508650751198055,"t":"Now, I'm particularly interested in your project - the one where you developed","y":0.53343023261670708,"w":0.54671279907226555},{"x":0.27335640059610417,"y":0.55073477934594983,"w":0.5536332194010416,"t":"a new food product. So talk me through the stages... first you had to decide on","c":1,"h":0.016125685689831415},{"w":0.11072664896647133,"h":0.01469559132260323,"c":1,"t":"your initial aim.","y":0.56682995128686997,"x":0.27335639864068301},{"h":0.014534882851794828,"w":0.55017298380533863,"c":1,"t":"We decided we wanted to create something people could eat on the go rather","y":0.58139534902952894,"x":0.27508652251486237},{"w":0.14359862009684243,"t":"than in a restaurant.","y":0.59867039914905829,"x":0.27335639900694209,"h":0.013296011196641033,"c":1},{"x":0.27335640071127765,"h":0.016095171448565426,"c":1,"y":0.61336598998173653,"w":0.48442906697591148,"t":"Yeah so we chose falafel, which was originally a Middle Eastern snack."},{"t":"We made up our minds about that pretty quickly. I know some students found it","y":0.62918831203197734,"h":0.015709762893580725,"c":1,"w":0.5571873474121094,"x":0.27330815174560014},{"c":1,"w":0.3373702494303385,"t":"a lot harder to choose, and wasted a lot of time.","x":0.27335639768128667,"y":0.64520643779944931,"h":0.017584260149048792},{"h":0.017268007997869206,"c":1,"x":0.27501032563286598,"w":0.55727671305338544,"t":"Then we had to do the literature review. We hadn't done one of these before so.","y":0.65863150827044492},{"y":0.67732558115593799,"w":0.4221453348795573,"t":"the handout with advice for the project was very useful here.","h":0.014534884186538477,"x":0.27335639829472913,"c":1},{"h":0.016160268229650776,"y":0.69314205727135769,"c":1,"w":0.52595153808593742,"x":0.27335641079740358,"t":"Yes, especially the advice on how to present the information. Then product"},{"t":"development, actually deciding what we'd use to make the falafel, and for me","y":0.70646830439961805,"x":0.27328065952593872,"w":0.54167221069335936,"c":1,"h":0.019966742139833626},{"c":1,"y":0.72375368838239784,"x":0.27329735730327115,"w":0.53126149495442698,"t":"the interesting thing about that was that we wanted it to be something a bit","h":0.017904738765900818},{"t":"different from an ordinary falafel.","x":0.27335640481255996,"y":0.74127906952872924,"w":0.23183390299479167,"h":0.014534884186538477,"c":1},{"x":0.27335640568953978,"h":0.01469559132260323,"y":0.75717284834476095,"w":0.53979237874348962,"c":1,"t":"We really made the right choice when we finally decided to use jackfruit, even"},{"h":0.018836740850150968,"y":0.77054746729641221,"c":1,"t":"though it wasn't something that either of us had ever tasted before.","x":0.27329549205524034,"w":0.47414413452148435},{"h":0.015988371937820545,"w":0.53287195841471346,"x":0.27335640823757995,"c":1,"t":"Yeah, like the name tells you, it's a fruit but actually it's really good in savoury","y":0.78924418612116309},{"y":0.80370888749091141,"h":0.016095171448565426,"w":0.51211069742838533,"t":"dishes. The product production, working out how to make the falafel, was","x":0.27335642105224317,"c":1},{"w":0.42387542724609373,"h":0.014534884186538477,"c":1,"t":"harder than I expected because I'd never made them before.","x":0.27508650785535471,"y":0.81976744161984649},{"x":0.27335640458083277,"w":0.50865051269531247,"h":0.015988371937820434,"y":0.83575581402368782,"t":"It was mostly trial and error. We started off with the basic recipe and then","c":1},{"y":0.85214540529572702,"x":0.27502726814169498,"w":0.28561696370442702,"t":"experimented and when it went wrong...","h":0.014273925791927988,"c":1},{"t":"...which it did a lot of the time...","y":0.86773255788654335,"x":0.27335640611267203,"w":0.22837369283040371,"h":0.014702711512443511,"c":1},{"c":1,"y":0.883720930306923,"w":0.54152247111002594,"t":"...we just moved on and kept adapting it and in the end it turned out fine and","x":0.27335641143901929,"h":0.015988371937820545},{"w":0.14359862009684243,"h":0.01469559132260323,"c":1,"t":"we had a lot of fun.","y":0.89958012625297512,"x":0.27335639922166199},{"x":0.27335640201427208,"y":0.91567529743516562,"c":1,"h":0.013103772077300069,"w":0.058823528289794924,"t":"We did!"},{"x":0.27508649893735426,"w":0.3442906697591146,"h":0.014534884186538477,"t":"Thank you. Well, your project was a very good ....","c":1,"y":0.93168604627485263},{"w":0.052298641204834073,"t":"Test 2","c":1,"x":0.85966382810371722,"y":0.050358285876751729,"h":0.01556249796051179},{"h":0.013165502634976178,"c":1,"t":"Q23\/24","w":0.055391445159912012,"x":0.85292711470382798,"y":0.11478352773034561},{"w":0.057150541941324851,"t":"Q25\/26","c":1,"y":0.30658644239843791,"x":0.85118251441005388,"h":0.011827115165011115},{"x":0.85110316616834625,"y":0.4168217508388613,"h":0.013740219212312499,"w":0.055579134623209625,"c":1,"t":"Q25\/26"},{"t":"Q28","y":0.67732558135599363,"c":1,"h":0.01308139510051276,"x":0.85121107340972801,"w":0.032871971130371103},{"t":"Q29","y":0.72529069776010613,"h":0.01308139510051276,"c":1,"w":0.032871971130371103,"x":0.85121107317183864},{"x":0.84948096937041617,"y":0.88517441869247615,"w":0.032871971130370992,"h":0.01308139510051276,"t":"Q30","c":1},{"w":0.032871971130371103,"c":1,"x":0.87716263031244879,"t":"105","y":0.95058139504996542,"h":0.014534884186538477}],"w":2400}