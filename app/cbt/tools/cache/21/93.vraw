{"lines":[{"x":0.84256055216439985,"c":1,"y":0.053779069769853027,"t":"Reading","h":0.018895348775128218,"w":0.072664362589518139},{"y":0.10461861415880092,"t":"Questions 37-40","w":0.15224913279215493,"h":0.01469559132260323,"c":1,"x":0.19377162729006134},{"c":1,"w":0.32352940877278646,"x":0.19377162773022585,"t":"Choose the correct letter, A, B, C or D.","y":0.1409883721172176,"h":0.018913657453362154},{"c":1,"y":0.17732558111005137,"t":"Write the correct letter in boxes 37-40 on your answer sheet.","w":0.50692042032877604,"h":0.017565951470814856,"x":0.19204151991529084},{"t":"37 When Bellerby had to attach the gores to the globe surface,","x":0.19195767539540612,"y":0.21173151445446914,"h":0.020859779053588601,"w":0.53824030558268232,"c":1},{"w":0.32564181009928383,"t":"he decided it was best to work quickly.","h":0.020621391173590409,"c":1,"x":0.26973509981253774,"y":0.23972380093937584},{"y":0.25907629874154736,"h":0.019238945151476505,"w":0.34973416646321615,"c":1,"t":"he became aware of an unexpected issue.","x":0.26979121751700491},{"t":"c","w":0.012110726038614905,"y":0.2718023255836941,"x":0.23356401405681709,"h":0.020348836526410174,"c":1},{"y":0.29796511629422029,"c":1,"h":0.013081395100512871,"x":0.23183390975493415,"t":"D","w":0.015570934613545723},{"y":0.27716790285083004,"t":"he was worried about the quality of his materials.","x":0.26808241994904108,"w":0.41021278381347653,"h":0.022485261867728812,"c":1},{"h":0.020501074046834988,"c":1,"t":"he nearly gave up the whole project.","y":0.29630157762334708,"x":0.26636787560920022,"w":0.30811533610026048},{"w":0.56411595662434899,"t":"38 The reviewer mentions other globe makers of the past because","h":0.020465976295978461,"c":1,"x":0.19026281613400925,"y":0.33264491232526816},{"h":0.020532389134272799,"w":0.35487640380859375,"x":0.26806401323929074,"c":1,"t":"Bellerby was particularly inspired by them.","y":0.36176116202000652},{"t":"B","x":0.23010380661346402,"h":0.01308139510051276,"c":1,"y":0.38226744189118878,"w":0.013840829531351739},{"w":0.01557093461354575,"h":0.01308139510051276,"t":"C","y":0.39970930235630509,"c":1,"x":0.2301038059631233},{"t":"D","h":0.014534882851794828,"w":0.013840829531351739,"x":0.23183391040733453,"c":1,"y":0.41715116304357935},{"h":0.021083424690305219,"c":1,"y":0.37802144222264555,"x":0.26800919211719132,"t":"their achievements are not widely known.","w":0.3481396484375},{"x":0.26982418688592325,"t":"Bellerby had something in common with each of them.","y":0.39683184384428127,"w":0.45515864054361976,"h":0.021413844477638166,"c":1},{"h":0.016095171448565426,"w":0.35121106465657553,"t":"their difficulties could have been avoided.","x":0.26816609398178531,"c":1,"y":0.41707487758993755},{"x":0.19031143608175966,"t":"39 What point is made about Bellerby in the seventh paragraph?","y":0.45346396113694287,"w":0.55017298380533863,"c":1,"h":0.017494751574527623},{"t":"He had long working relationships with numerous craftsmen.","x":0.26643597779247213,"h":0.017494751574527623,"w":0.50519032796223962,"c":1,"y":0.48250524870144396},{"x":0.26638068985787622,"y":0.49897855975797101,"h":0.01849830058840618,"c":1,"t":"He understands the lack of interest in traditional crafts.","w":0.46033686319986977},{"x":0.2301038059631233,"w":0.01557093461354575,"h":0.013081395100512871,"c":1,"t":"C","y":0.52034883724002601},{"t":"D","x":0.23010380597754088,"y":0.53779069798786228,"h":0.014534882851794828,"c":1,"w":0.01557093461354575},{"t":"He appreciates the importance of careful planning.","y":0.51889433147933006,"w":0.42733566284179686,"x":0.26643597471635644,"h":0.017494751574527623,"c":1},{"h":0.017494751574527623,"t":"He regrets the loss of many globe-making skills.","x":0.26816608873214581,"y":0.53778866324177654,"c":1,"w":0.39965398152669268},{"h":0.017544591568665946,"w":0.64532872517903639,"t":"40 What does the reviewer say about Bellerby's book in the final paragraph?","y":0.57412790669502856,"x":0.19031141587068931,"c":1},{"x":0.23003752497181676,"w":0.49666498819986982,"t":"A It does not tell you how to create a profitable business.","y":0.60120886931256667,"h":0.020132919055252718,"c":1},{"y":0.6220930232709645,"w":0.013840829531351712,"x":0.23010380660110619,"t":"B","h":0.013081395100512871,"c":1},{"t":"It overlooks some important mapmakers.","x":0.26280048334218759,"y":0.61759968974519064,"w":0.34814076741536454,"h":0.022101856762917427,"c":1},{"w":0.37370241800944015,"h":0.015988371937820545,"y":0.63953488366529521,"t":"It fails to discuss the future of globe-making.","c":1,"x":0.26643599070692925},{"c":1,"w":0.52941177368164061,"t":"D It does not give enough details about individual customers.","x":0.23183390703893736,"y":0.65697674416372043,"h":0.015988371937820545},{"c":1,"t":"→ • р. 124","h":0.017659234700293069,"y":0.95337968485148128,"x":0.75257099931224403,"w":0.11077495574951157},{"h":0.01308139510051276,"c":1,"t":"93","x":0.8875432529838766,"w":0.02422145207722981,"y":0.95494186042576112}],"w":2400,"h":2857}