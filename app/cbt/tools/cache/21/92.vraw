{"lines":[{"h":0.015158483079465768,"c":1,"y":0.059281223549551898,"x":0.084653526256397951,"t":"Test 4","w":0.052146234512329095},{"t":"Questions 33-36","h":0.01469559132260323,"w":0.15051902770996095,"x":0.086505191941873158,"c":1,"y":0.10741777498507499},{"w":0.71280278523763019,"h":0.018929931314947579,"t":"Do the following statements agree with the claims of the writer in Reading Passage 3?","y":0.14240727794774866,"c":1,"x":0.084775078118838207},{"t":"In boxes 33-36 on your answer sheet, write","x":0.083044982769163667,"h":0.017494751574527623,"c":1,"y":0.18019594116518134,"w":0.3615916951497396},{"h":0.013081395100512871,"w":0.034602076212565086,"x":0.14705882340346066,"c":1,"t":"YES","y":0.21802325590369098},{"w":0.031141869227091473,"t":"NO","h":0.014534884186538477,"c":1,"x":0.14705882309207047,"y":0.23546511599036224},{"h":0.01308139510051276,"c":1,"t":"NOT GIVEN","y":0.2543604652293554,"x":0.1470588226729273,"w":0.10553633371988935},{"y":0.21478375547064554,"t":"if the statement agrees with the claims of the writer","x":0.27327891510978208,"w":0.43095275878906247,"h":0.019885795278262175,"c":1},{"y":0.23255813970486738,"c":1,"h":0.017441859689102501,"x":0.27335641272828687,"t":"if the statement contradicts the claims of the writer","w":0.42560551961263021},{"t":"if it is impossible to say what the writer thinks about this","w":0.46539789835611978,"y":0.25290697646151772,"x":0.27335641405690658,"h":0.017561883172261483,"c":1},{"y":0.28924418575314559,"h":0.014534884186538477,"w":0.024221453666687001,"c":1,"t":"33","x":0.084775086228940241},{"w":0.66262975056966145,"t":"The assumption today that people in the past knew very little about geography","h":0.019013336774266754,"c":1,"x":0.11937716617765526,"y":0.28924418607422553},{"t":"is correct.","x":0.12271003005706334,"y":0.30861001101838426,"h":0.013596522048939574,"w":0.085156281789143876,"c":1},{"c":1,"y":0.34447674390421801,"t":"34 Plato was criticised for saying the world was shaped like a leather ball.","w":0.6211072794596354,"h":0.017441861023846261,"x":0.084775079906616119},{"c":1,"w":0.65752466837565104,"x":0.08473560563237531,"t":"35 The globe made by Crates of Mallus was an accurate representation of the","y":0.37926913955143937,"h":0.019468350206913065},{"y":0.3990148052518171,"t":"known world.","w":0.11445121765136719,"h":0.017377366212133372,"c":1,"x":0.12443529073777175},{"x":0.084725525256526407,"c":1,"y":0.43347844911458833,"t":"36 Bellerby assumed he would have few problems locating a well-made globe.","h":0.020314300035245814,"w":0.66617996215820319},{"x":0.084775086142435049,"h":0.013081395100512871,"c":1,"y":0.9578488372244528,"t":"92","w":0.024221453666687001}],"w":2400,"h":2857}