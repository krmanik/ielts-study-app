{"h":2857,"lines":[{"c":1,"w":0.20242214202880859,"x":0.71107266560200699,"t":"Sample Writing answers","y":0.050734779467342173,"h":0.020643806857942537},{"y":0.10319767448582395,"t":"Example overview","h":0.016116531350714447,"x":0.19204152091403232,"w":0.15916955312093095,"c":1},{"t":"This process of forming a rain-shadow desert includes three main stages. Firstly,","x":0.23177163823345381,"y":0.12663042231490518,"w":0.65930374145507809,"h":0.020434867426429748,"c":1},{"w":0.64197362263997393,"x":0.23005288898605214,"t":"the wind pushes moist air up from the sea, then rain clouds form and rain falls","y":0.14519487384649843,"c":1,"h":0.020031081453914745},{"y":0.16410076987038735,"t":"over the mountains, finally, dry air reaches the inland areas, to make the desert.","h":0.019038764974969258,"x":0.23183391623668284,"w":0.6557093302408854,"c":1},{"c":1,"t":"133","x":0.87543252666664817,"y":0.95348837238224204,"h":0.014534882851794828,"w":0.032871971130371103}],"w":2400}