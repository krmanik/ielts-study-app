{"w":2400,"h":2857,"lines":[{"x":0.086505190799987558,"y":0.062500000100802588,"h":0.01308139510051276,"c":1,"t":"Test 1","w":0.05017300923665366},{"x":0.086505190665907505,"t":"Questions 22-26","h":0.014534884186538477,"w":0.15397923787434897,"y":0.11046511603781517,"c":1},{"w":0.66782007853190106,"x":0.086505185561778428,"h":0.01744186102384615,"t":"Look at the following statements (Questions 22-26) and the list of people below.","y":0.14680232529954584,"c":1},{"c":1,"h":0.017586294298325589,"x":0.086505190241549082,"t":"Match each statement with the correct person, A, B, C or D.","y":0.18299510132614971,"w":0.49999999999999994},{"x":0.086505183717329237,"y":0.2193841844155634,"h":0.01898790857356436,"w":0.62110727945963551,"c":1,"t":"Write the correct letter, A, B, C or D, in boxes 22-26 on your answer sheet."},{"w":0.36851211547851559,"h":0.018936034430149462,"y":0.25577326785880106,"t":"NB You may use any letter more than once.","x":0.086505187828502889,"c":1},{"y":0.29215116250847339,"w":0.68166091918945304,"c":1,"t":"22 It is unpleasant and upsetting for people to be placed in a silent environment","x":0.084775076630243598,"h":0.017505940062921388},{"y":0.30897230168682499,"x":0.12604420109704145,"w":0.14397546132405598,"h":0.019764595885974234,"c":1,"t":"against their will."},{"c":1,"w":0.67311024983723955,"h":0.019963586805916256,"x":0.086456028759298392,"y":0.34560473478484144,"t":"23 The trend towards creating quieter urban locations is likely to increase in the"},{"t":"coming years.","c":1,"w":0.12221529642740886,"x":0.12406732133253168,"y":0.36464732294690716,"h":0.020077336994061667},{"t":"24 When our body's senses are completely deprived of input, our minds compensate","w":0.71799306233723958,"y":0.40116279072150296,"h":0.019061141951756566,"x":0.086505198946412259,"c":1},{"y":0.42005813925200242,"w":0.44463668823242192,"c":1,"x":0.12456746894363108,"h":0.017441861023846039,"t":"for this by creating the illusion of images and sounds."},{"h":0.017574088735293314,"c":1,"t":"25 Even a short amount of silent time can have a positive impact.","x":0.086505195237806823,"y":0.45626312084306853,"w":0.55536331176757814},{"h":0.017494751574527623,"t":"26 External and internal quietness makes us more conscious of events occurring in","x":0.086505204435148073,"c":1,"y":0.49125262403831749,"w":0.69550170898437502},{"y":0.50942698675294995,"h":0.020281092948726709,"t":"our surroundings and helps us react appropriately to these events.","w":0.55203608194986975,"x":0.12622073454460159,"c":1},{"y":0.57255308210788514,"w":0.12461537679036455,"c":1,"h":0.017684533430864291,"t":"List of People","x":0.38405909352240392},{"y":0.60901162766095907,"t":"Nick Antonio","x":0.34602076164630219,"w":0.11937716166178391,"h":0.014534884186538477,"c":1},{"c":1,"w":0.16955017089843749,"x":0.3148788936991857,"y":0.63808139546573195,"t":"B Justin Feinstein","h":0.013081395100512871},{"y":0.66569767417838477,"t":"C Tai Dotan Ben-Soussan","x":0.31487889613871745,"w":0.23183390299479167,"h":0.014534884186538477,"c":1},{"c":1,"x":0.31487889248993994,"t":"D","w":0.01557093461354575,"h":0.014534882851794828,"y":0.69331395374125371},{"c":1,"t":"Eric Pfeifer","w":0.10726643880208342,"x":0.34083044845973587,"y":0.69314205758835989,"h":0.014706779810996884},{"t":"24","h":0.014534884186538477,"c":1,"w":0.025951557159423849,"y":0.95930232529268777,"x":0.086505190191914383},{"t":"→ • р. 118","h":0.019027576486575493,"c":1,"x":0.14186851356173211,"y":0.95626312102183586,"w":0.11591695149739586}]}