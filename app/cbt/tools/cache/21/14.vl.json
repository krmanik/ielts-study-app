{"blocks":[{"l":"paragraph_title","b":[0.0833,0.0578,0.1379,0.0749],"t":"Test 1"},{"l":"paragraph_title","b":[0.0829,0.1054,0.2408,0.125],"t":"Questions 25–30"},{"l":"text","b":[0.0804,0.1421,0.7558,0.1803],"t":"What is the students' opinion of each of the following resources related to ocean biodiversity?"},{"l":"text","b":[0.0821,0.1967,0.7117,0.2342],"t":"Choose SIX answers from the box and write the correct letter, A–H, next to Questions 25–30."},{"l":"paragraph_title","b":[0.4042,0.2664,0.4879,0.287],"t":"Opinions"},{"l":"text","b":[0.1963,0.2944,0.5921,0.315],"t":"A This is aimed at a very specialist audience."},{"l":"text","b":[0.1971,0.3231,0.4767,0.3427],"t":"B This is now rather outdated."},{"l":"text","b":[0.1967,0.3507,0.6554,0.3714],"t":"C This was an effective description of a new danger."},{"l":"text","b":[0.1975,0.3794,0.6825,0.3997],"t":"D This suggests possible ways to improve the situation."},{"l":"text","b":[0.1971,0.4071,0.5667,0.4277],"t":"E This does not give a balanced account."},{"l":"text","b":[0.1975,0.4358,0.5358,0.4568],"t":"F This is too predictable to be useful."},{"l":"text","b":[0.1971,0.4641,0.6121,0.4848],"t":"G This gives insufficient evidence for its claims."},{"l":"text","b":[0.1971,0.4921,0.6288,0.5138],"t":"H This gives a clear explanation of the problems."},{"l":"paragraph_title","b":[0.0829,0.5488,0.1767,0.567],"t":"Resources"},{"l":"text","b":[0.0833,0.5842,0.3425,0.6041],"t":"25 Article on invasive lionfish"},{"l":"text","b":[0.0838,0.6209,0.3796,0.6409],"t":"26 Documentary on microplastics"},{"l":"text","b":[0.0838,0.6573,0.3554,0.6769],"t":"27 Podcast on ocean pollution"},{"l":"text","b":[0.0842,0.6937,0.3617,0.7126],"t":"28 Book on coastal ecosystems"},{"l":"text","b":[0.0854,0.7301,0.6842,0.7494],"t":"29 Article on metal toxicity"},{"l":"text","b":[0.085,0.7662,0.6833,0.7854],"t":"30 Podcast on floating marine cities"},{"l":"number","b":[0.0871,0.9552,0.1104,0.9716],"t":"14"},{"l":"footer","b":[0.1425,0.9552,0.1633,0.9