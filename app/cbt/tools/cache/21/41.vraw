{"h":2857,"w":2400,"lines":[{"c":1,"x":0.8438531129953859,"h":0.021404123539854658,"y":0.050325166819583322,"t":"Reading","w":0.07364708582560231},{"x":0.19377162476020676,"t":"Questions 6-13","y":0.10174418611399383,"w":0.14186851501464842,"h":0.015988371937820434,"c":1},{"y":0.13953488374962064,"c":1,"x":0.19377161705910395,"t":"Do the following statements agree with the information given in Reading Passage 1?","w":0.69723185221354167,"h":0.018967565746053738},{"y":0.17587209273932491,"t":"In boxes 6-13 on your answer sheet, write","c":1,"w":0.34948097229003905,"h":0.017441861023846261,"x":0.19204152068481431},{"y":0.21199949238078641,"x":0.25423703782101892,"w":0.048619349797566713,"t":"TRUE","h":0.014954503555244414,"c":1},{"c":1,"h":0.015367593358161957,"w":0.05738645553588867,"x":0.25417874446341698,"y":0.23068829632200005,"t":"FALSE"},{"w":0.10726643880208336,"x":0.25432525802110362,"t":"NOT GIVEN","y":0.24702589238927031,"h":0.016095171448565315,"c":1},{"c":1,"t":"if the statement agrees with the information","x":0.38235294698097638,"w":0.36332178751627603,"h":0.017614773722942956,"y":0.21203638934269275},{"w":0.35986157735188801,"h":0.017561882504889659,"y":0.22953114097898963,"c":1,"t":"if the statement contradicts the information","x":0.3823529489690794},{"c":1,"x":0.380622840757878,"y":0.24842547247701652,"w":0.26643597920735673,"t":"if there is no information on this","h":0.016109411160874165},{"c":1,"x":0.19204152284678089,"w":0.013840829531351712,"t":"6","h":0.014534882851794828,"y":0.28488372121945149},{"x":0.23183390466385295,"c":1,"h":0.01896451385476694,"w":0.65224914550781254,"t":"Dreaming about past experiences helps us to create lasting memories of them.","y":0.28481455587897309},{"y":0.32120363865374646,"x":0.22318339413127319,"c":1,"t":"It is now possible to tell what type of dream a dog is having.","w":0.50865051269531247,"h":0.018912640378723644},{"x":0.21799307727224024,"t":"David Scheel's documentary was influential on other research into the sleeping","w":0.66089965820312502,"h":0.01892891424030918,"y":0.35755813955907823,"c":1},{"t":"patterns of octopuses.","h":0.019024335729066366,"c":1,"x":0.2299486222651711,"y":0.37542971622237498,"w":0.18896532694498697},{"w":0.66782007853190106,"c":1,"h":0.018979771309085791,"x":0.19031141386887063,"y":0.41279069770112531,"t":"9 While it was asleep, the octopus called Costello reacted as if it was hunting."},{"c":1,"y":0.44751574545995021,"h":0.019054021761916284,"w":0.67647059122721354,"t":"10 Scheel believes more research into octopuses' dreams should be carried out.","x":0.19031141872895374},{"x":0.19024837831595684,"t":"11 We may soon be able to share the dreams of other human beings.","h":0.020645913083374712,"y":0.48379556008934033,"w":0.58836842854817706,"c":1},{"w":0.58650517781575517,"y":0.52169349163865464,"t":"12 Hearing may be an important part of the dreams of some animals.","h":0.017550694683867718,"x":0.1903114248254868,"c":1},{"c":1,"y":0.55655840170326631,"h":0.021354850811754811,"t":"13 Interest in the reasons why humans dream has increased greatly in recent times.","x":0.19022210768504011,"w":0.69914515177408854},{"c":1,"x":0.75227455259716502,"y":0.95290095663421781,"t":"→ • p. 120","h":0.017468987018433135,"w":0.10789806365966792},{"x":0.88408304533722304,"y":0.9549418605347727,"h":0.013081395100512871,"t":"41","w":0.022491348584492976,"c":1}]}