{"blocks":[{"l":"paragraph_title","b":[0.0858,0.0578,0.1425,0.0746],"t":"Test 4"},{"l":"paragraph_title","b":[0.0838,0.1043,0.3996,0.1253],"t":"PART 3 Questions 21–30"},{"l":"text","b":[0.0854,0.1425,0.245,0.1614],"t":"Questions 21–23"},{"l":"text","b":[0.0858,0.1796,0.3883,0.1981],"t":"Choose the correct letter, A, B or C."},{"l":"paragraph_title","b":[0.2308,0.2184,0.6679,0.2415],"t":"Presentation on houses of the future"},{"l":"text","b":[0.0842,0.2583,0.7546,0.2779],"t":"21 Which aspect of their presentation are Mia and Leo both concerned about?"},{"l":"text","b":[0.1258,0.2874,0.3513,0.3052],"t":"A meeting the deadline"},{"l":"text","b":[0.1263,0.3063,0.3837,0.3234],"t":"B finding suitable examples"},{"l":"text","b":[0.1263,0.3252,0.3646,0.343],"t":"C including original ideas"},{"l":"text","b":[0.085,0.3598,0.6392,0.3791],"t":"22 The students decide to focus their assignment on housing for"},{"l":"text","b":[0.1267,0.3892,0.2892,0.4071],"t":"A family groups."},{"l":"text","b":[0.1271,0.4081,0.2675,0.4249],"t":"B old people."},{"l":"text","b":[0.1267,0.4267,0.2888,0.4449],"t":"C single people."},{"l":"text","b":[0.0858,0.4606,0.7779,0.4988],"t":"23 The students agree that demand for accommodation in urban areas should be met by"},{"l":"text","b":[0.1263,0.5079,0.4496,0.5268],"t":"A repurposing offices and factories."},{"l":"text","b":[0.1275,0.5278,0.3917,0.545],"t":"B constructing tall buildings."},{"l":"text","b":[0.1275,0.545,0.5425,0.5639],"t":"C developing creative ideas for smaller homes."},{"l":"number","b":[0.09,0.9562,0.1146,0.9716],"t":"78"}]}