{"w":2400,"h":2857,"lines":[{"x":0.8398259827707435,"t":"Listening","h":0.021398101176641648,"y":0.050493669918015738,"w":0.077990182240804118,"c":1},{"c":1,"y":0.10160592468807805,"h":0.016264894110410655,"w":0.090034573872884133,"t":"PART 2","x":0.19546714204449159},{"w":0.17301038106282557,"c":1,"h":0.016116531350714447,"x":0.33217993049024025,"y":0.10319767448796457,"t":"Questions 11-20"},{"t":"Questions 11 and 12","h":0.017697117393712491,"c":1,"x":0.19708941715392508,"y":0.13914204296800636,"w":0.18889943440755208},{"x":0.19723182845283779,"t":"Choose TWO letters, A-E.","w":0.22145329793294269,"h":0.018965530929405228,"y":0.17732558141864541,"c":1},{"y":0.21366279041578895,"x":0.19550173432868481,"c":1,"t":"Which TWO pieces of advice are given about the Marsden Coastal Walk?","w":0.60899653116861985,"h":0.01744186102384615},{"x":0.19539399331382801,"c":1,"h":0.019344287122188608,"w":0.32025174458821615,"t":"A Stop for lunch in an ancient town.","y":0.23985740300789227},{"c":1,"x":0.19536944634135817,"w":0.38266415913899737,"t":"B Don't miss the ruins of a certain building.","h":0.020362081187350278,"y":0.26756756091306255},{"c":1,"x":0.19550173529583476,"y":0.29941860472468551,"w":0.34775085449218751,"t":"C Catch a boat to the start of this walk.","h":0.015988371937820545},{"w":0.37197232564290361,"h":0.017611722499027871,"y":0.32703488343722653,"c":1,"t":"D Be careful of the steep and rocky paths.","x":0.1955017263619564},{"c":1,"t":"E Don't worry about getting lost.","x":0.19550173471606844,"w":0.29757784525553388,"h":0.017583243074410393,"y":0.35610465087768828},{"w":0.18685120900472002,"x":0.19723183485832546,"t":"Questions 13 and 14","y":0.41133720937231355,"h":0.015988371937820434,"c":1},{"c":1,"h":0.017441861023846039,"w":0.21972318013509112,"x":0.1972318354486724,"y":0.44912790669028912,"t":"Choose TWO letters, A-E."},{"y":0.48530440886059067,"x":0.19550172429806006,"w":0.49826990763346352,"t":"Which TWO things are said about the Melby Heritage Walk?","h":0.017602568159911014,"c":1},{"y":0.51294611612801133,"t":"A This walk is mostly downhill.","c":1,"w":0.27335639953613278,"h":0.017577139959208621,"x":0.19550173093462192},{"y":0.5419874034794625,"c":1,"x":0.19550172891105566,"t":"B The paths can get busy during the day.","w":0.36505190531412757,"h":0.017605620051197701},{"x":0.19535435407474561,"t":"C This is a circular walk.","y":0.56969301464935362,"w":0.22174804687499999,"h":0.01759071496919451,"c":1},{"c":1,"x":0.19542840002493533,"h":0.017378867798705788,"y":0.59748860617526922,"t":"D A tower stands on the site of an older structure.","w":0.43787043253580726},{"y":0.62631210603752496,"h":0.017583243074410504,"w":0.40311419169108065,"t":"E There are far-reaching views the whole way.","x":0.19550172757850079,"c":1},{"t":"33","x":0.89100346056213653,"y":0.9549418605347727,"h":0.013081395100512871,"c":1,"w":0.022491348584492976}]}