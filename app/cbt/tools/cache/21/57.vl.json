{"blocks":[{"l":"header","b":[0.8375,0.0532,0.9171,0.0714],"t":"Listening"},{"l":"paragraph_title","b":[0.1904,0.0987,0.505,0.1197],"t":"PART 3 Questions 21–30"},{"l":"text","b":[0.1908,0.1362,0.385,0.1561],"t":"Questions 21 and 22"},{"l":"text","b":[0.19,0.1736,0.4138,0.1925],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.1892,0.21,0.8888,0.2475],"t":"Which TWO points do the speakers make about the terms ‘ethical’ and ‘sustainable’ fashion?"},{"l":"text","b":[0.1883,0.2569,0.5017,0.2772],"t":"A Their definitions keep changing."},{"l":"text","b":[0.1892,0.2853,0.5629,0.3056],"t":"B People think they mean the same thing."},{"l":"text","b":[0.1888,0.3133,0.5358,0.3332],"t":"C The term 'eco-friendly' is preferable."},{"l":"text","b":[0.1888,0.3416,0.5017,0.3623],"t":"D They are often used imprecisely."},{"l":"text","b":[0.1879,0.37,0.6892,0.3913],"t":"E Companies should avoid using them on clothing labels."},{"l":"paragraph_title","b":[0.1896,0.426,0.3829,0.4459],"t":"Questions 23 and 24"},{"l":"text","b":[0.1888,0.4631,0.4125,0.4827],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.1862,0.4995,0.8054,0.5205],"t":"Which TWO claims about wool production do the speakers disagree with?"},{"l":"text","b":[0.1871,0.5282,0.5075,0.5478],"t":"A Sheep are generally well-treated."},{"l":"text","b":[0.1875,0.5565,0.4254,0.5761],"t":"B Wool is easy to recycle."},{"l":"text","b":[0.1875,0.5842,0.4667,0.6052],"t":"C Wool is a long-lasting fabric."},{"l":"text","b":[0.1871,0.6129,0.5717,0.6328],"t":"D Wool production involves few chemicals."},{"l":"text","b":[0.1867,0.6412,0.7142,0.6622],"t":"E Sheep do less environmental damage than other livestock."},{"l":"number","b":[0.8846,0.9527,0.9087,0.9692],"t":"57"}]}