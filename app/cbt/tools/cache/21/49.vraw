{"lines":[{"t":"Reading","x":0.84207226697891147,"h":0.016544364731657213,"y":0.052548106420405638,"c":1,"w":0.071944491068522076},{"w":0.15051902770996092,"y":0.10174418611448144,"c":1,"t":"Questions 30-35","x":0.19377162792911093,"h":0.015988371937820545},{"t":"Complete the summary using the list of words, A-l, below.","x":0.19204152197172628,"y":0.13808139536791864,"w":0.48442906697591148,"h":0.019021474038745434,"c":1},{"x":0.19195916354582571,"w":0.54688654581705731,"y":0.17276777513315267,"t":"Write the correct letter, A-l, in boxes 30-35 on your answer sheet.","h":0.02331426312157614,"c":1},{"t":"Al in government, medicine and the law","y":0.21511627869261107,"h":0.023255814698461497,"c":1,"w":0.47058822631835934,"x":0.3166090009352604},{"t":"Neural networks are a promising area of Al technology for governments. However,","c":1,"h":0.018907554338160271,"x":0.19204151271325268,"y":0.25436046514166233,"w":0.68166091918945304},{"y":0.27180232560844952,"x":0.19204151902732189,"c":1,"w":0.69896194458007799,"h":0.018960445556213457,"t":"many politicians overestimate their capabilities, believing that the mere addition of a"},{"x":0.19204151229220134,"h":0.017505940062921388,"y":0.29215116250757367,"c":1,"w":0.45847752888997395,"t":"neural network will produce solutions and promote 30 .."},{"w":0.55882354736328121,"h":0.017557814206336286,"x":0.19204151342686079,"y":0.32848837181085411,"t":"Most public sector organisations have not set up the necessary 31 ...","c":1},{"t":"to manage the huge amount of data required to enable Al to function. Complex","h":0.021296620619221884,"w":0.66274831136067713,"c":1,"x":0.19024900964112645,"y":0.34400812752116205},{"w":0.52076126098632813,"x":0.19204151477031633,"h":0.019009267808341557,"c":1,"t":"bureaucracy is another issue, as each person involved needs 32","y":0.3648255814224528},{"x":0.83685517498252682,"y":0.36504144585410725,"w":0.027564102808634527,"h":0.013570688086176674,"c":1,"t":".. to"},{"h":0.017608671275112786,"w"