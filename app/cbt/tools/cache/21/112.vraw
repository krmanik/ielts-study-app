{"w":2400,"lines":[{"t":"Audioscripts","x":0.082994576950283797,"h":0.016464058547023264,"c":1,"w":0.10563714345296225,"y":0.062262156755485076},{"t":"TEST 4","y":0.10746205437166534,"w":0.086559893290201861,"x":0.35983424008725173,"h":0.017634030736518813,"c":1},{"y":0.17187300277128581,"c":1,"x":0.082798448793515528,"h":0.016719110701115869,"w":0.085268154144287123,"t":"PART 1"},{"t":"WOMAN:","h":0.011627907349230804,"x":0.081314877464264509,"w":0.055363324483235679,"y":0.2034883718874001,"c":1},{"y":0.23546511642301793,"t":"MAN:","h":0.010174418263205198,"x":0.081314878124246731,"w":0.036332181294759111,"c":1},{"h":0.010693064263185725,"c":1,"x":0.082978987008028332,"w":0.055495313008626285,"t":"WOMAN:","y":0.25119416552505802},{"y":0.26744186030120898,"c":1,"h":0.0087209305119231306,"w":0.0346020762125651,"t":"MAN:","x":0.083044982568457923},{"h":0.010612621267330646,"c":1,"t":"WOMAN:","y":0.28321113120915775,"w":0.055475279490153004,"x":0.082989003767228439},{"c":1,"w":0.032871971130371103,"t":"MAN:","x":0.084775087012669129,"y":0.3154069765815537,"h":0.0087209305119231306},{"x":0.081200280141911996,"c":1,"w":0.057322622934977197,"h":0.011122915109109899,"y":0.33092110056713264,"t":"WOMAN:"},{"x":0.083044982568457923,"w":0.0346020762125651,"c":1,"t":"MAN:","y":0.34738372076874779,"h":0.0087209305119231306},{"w":0.057256666819254551,"y":0.36162946961088449,"h":0.012206177014083219,"t":"WOMAN:","c":1,"x":0.081233258202763239},{"h":0.010174418263205087,"c":1,"t":"MAN:","x":0.083044982573546478,"y":0.3938953489780076,"w":0.0346020762125651},{"t":"WOMAN:","h":0.011739374458414442,"x":0.083028444560690626,"w":0.055396397908528641,"y":0.4098279871704742,"c":1},{"h":0.0087209298445514172,"c":1,"t":"MAN:","x":0.083044982574224949,"y":0.42587209318818942,"w":0.0346020762125651},{"t":"WOMAN:","y":0.45784883705508483,"c":1,"x":0.084775085717587587,"w":0.053633219401041668,"h":0.0087209305119231306},{"c":1,"x":0.084775087017474979,"y":0.4898255812314416,"w":0.032871971130371103,"h":0.0087209305119230196,"t":"MAN:"},{"c":1,"h":0.0087209305119230196,"y":0.52180232542764693,"x":0.08477508571470406,"w":0.053633219401041668,"t":"WOMAN:"},{"h":0.0087209305119231306,"c":1,"x":0.084775087012669129,"y":0.53779069751178632,"w":0.032871971130371103,"t":"MAN:"},{"y":0.56770997310552407,"x":0.082873745791303785,"t":"WOMAN:","h":0.01283586767689171,"w":0.055705795288085933,"c":1},{"y":0.58575581379085606,"w":0.034602076212565114,"h":0.0087209305119231306,"c":1,"t":"MAN:","x":0.08477508637013341},{"h":0.0087209305119231306,"w":0.053633219401041668,"t":"WOMAN:","c":1,"x":0.084775085714704088,"y":0.63226744170574656},{"y":0.66424418588260437,"w":0.032871971130371103,"t":"MAN:","h":0.0087209305119231306,"c":1,"x":0.084775087017474979},{"t":"WOMAN:","x":0.08469604836602021,"y":0.89213978878544442,"w":0.0537912940979004,"h":0.010778561933128983,"c":1},{"c":1,"t":"MAN:","y":0.9084302327006003,"w":0.032871971130371089,"x":0.086505190814091651,"h":0.010174418263205198},{"x":0.16608995890612854,"t":"Good morning. I'm doing a survey of shoppers in Broadbeach. Would you have","y":0.2004898533666537,"w":0.55190312703450517,"c":1,"h":0.016095171448565315},{"t":"a few minutes to spare to answer some questions?","x":0.16782007312420091,"c":1,"h":0.014534884186538477,"w":0.35121106465657559,"y":0.21656976720532939},{"c":1,"y":0.23255813924915314,"h":0.017441861023846261,"w":0.28546712239583333,"x":0.16782007192473125,"t":"Oh...erm...yes, I guess that would be ok."},{"t":"Thank you very much. Everybody seems so busy today.","y":0.24842547247824731,"h":0.016109411160874054,"x":0.16608996927449909,"w":0.38581314086914059,"c":1},{"x":0.16608996489503378,"c":1,"w":0.31141868591308597,"y":0.26452064376990891,"h":0.01469559132260323,"t":"Well actually I don't have loads of time, so..."},{"t":"Oh yes, of course. It really won't take long. Could I start by taking your name","h":0.015988371937820545,"y":0.28052325588838256,"c":1,"x":0.16782008177042579,"w":0.53460205078125012},{"c":1,"y":0.31245626288249173,"w":0.22145329793294269,"x":0.16782006374979161,"h":0.01469559132260323,"t":"Martyn Leigh. Martyn's with a Y."},{"w":0.29584775288899745,"c":1,"h":0.01615823408037409,"x":0.16608996430046971,"y":0.32848837216589422,"t":"And is your family name spelt L-double-E?"},{"t":"It's L-E-I-G-H.","w":0.09688581466674806,"c":1,"h":0.013115977640332233,"y":0.34447674429738373,"x":0.16608996454735059},{"x":0.1660899620968784,"y":0.35899230222784395,"h":0.016095171448565426,"c":1,"w":0.56055363972981764,"t":"Thank you. We don't actually publish your name or details. It just makes it easier"},{"t":"for me to identify people when I look at all the results at the end.","x":0.16775151378125969,"y":0.37392387610083766,"h":0.016215870311995895,"w":0.45512329101562504,"c":1},{"w":0.024221453666687043,"h":0.01308139510051276,"c":1,"y":0.31250000006965639,"t":"Q1","x":0.74740484401440743},{"t":"And can I ask, how did you get into town today?","c":1,"x":0.16608996746061583,"y":0.40692792133831279,"w":0.33910034179687504,"h":0.016095171448565537},{"h":0.016153148039810494,"c":1,"x":0.16608997736926437,"w":0.51903111775716149,"t":"Well, normally I catch the bus, but I'm on my motorbike today because I'm","y":0.42296511635380574},{"t":"going to work later.","w":0.13840830485026043,"h":0.014534882851794828,"x":0.16782006735572338,"y":0.43895348856441263,"c":1},{"w":0.53817220052083337,"c":1,"t":"And could you tell me what you're doing this morning, I mean, the reason for","h":0.018911840867295471,"x":0.1677681073077438,"y":0.45341631745894029},{"w":0.14270342508951819,"h":0.01852254286940247,"c":1,"x":0.16563821218562316,"t":"your trip into town?","y":0.46864037490162391},{"x":0.16603333425290137,"w":0.55375829060872395,"y":0.48475206621700151,"h":0.0195335310768463,"c":1,"t":"I've just been to the hairdresser. You see, I have a job interview at the council in"},{"h":0.013081395100512871,"c":1,"t":"Q2","x":0.74740484402106155,"y":0.42441860472501181,"w":0.024221453666687043},{"h":0.011627907349230804,"x":0.74740484402106155,"c":1,"y":0.48691860442019674,"t":"Q3","w":0.024221453666687043},{"x":0.16782007197106588,"y":0.51889433152430264,"h":0.01469559132260323,"c":1,"t":"Oh really! Well, good luck with that.","w":0.25086504618326821},{"y":0.53488372069487844,"t":"Thanks a lot. And now I'm on my way to buy a suit that I can wear to the","w":0.50346018473307297,"h":0.014534884186538477,"c":1,"x":0.16782008055551781},{"x":0.74740484417115316,"y":0.53488372069926648,"c":1,"h":0.011627907349230804,"w":0.025951557159423877,"t":"Q4"},{"t":"interview. I don't actually own one at the moment!","c":1,"x":0.1678200731316315,"w":0.35121106465657548,"y":0.55073477939177351,"h":0.013296011196640922},{"x":0.16782007257658038,"t":"OK. Is that everything you're planning to do in town?","h":0.016118565499991133,"c":1,"y":0.56540697681300256,"w":0.37024220784505202},{"c":1,"x":0.16608997736741088,"t":"Yeah. Well, I've got to go and pick up my laptop. It broke a couple of days","y":0.58139534855464992,"w":0.51903111775716138,"h":0.01744186102384615},{"t":"Q5","c":1,"y":0.58139534909009105,"x":0.74740484498214643,"w":0.02422145207722981,"h":0.014534882851794828},{"t":"ago so I took it to the shop to get it fixed. They had to order a spare part, but","c":1,"h":0.016101273896395485,"y":0.59727081904419932,"x":0.16608996151453057,"w":0.54498270670572913},{"t":"apparently it's ready for collection now. I can't wait to get it back.","y":0.61336598998072056,"w":0.45501729329427076,"h":0.016095171448565426,"x":0.16782007302531962,"c":1},{"t":"I'm sure. I hate it when my technology breaks down....One more thing, it's","x":0.16782006727429633,"w":0.52249135335286456,"c":1,"y":0.62936046487835706,"h":0.014534884186538477},{"t":"Saturday today - is that when you like to do your shopping?","c":1,"h":0.016130771063023186,"x":0.1678200673219907,"y":0.64520643815805068,"w":0.41868512471516928},{"x":0.16773221900666149,"w":0.6057106018066406,"t":"Well it's more a question of when I'm free. If I'm free on a Monday, that's when I Q6","h":0.020768248342483364,"y":0.65812593838317002,"c":1},{"c":1,"w":0.54844289143880209,"x":0.16782007670554408,"y":0.67732558146963318,"t":"choose to come into town. The shops are less busy then, which I always prefer.","h":0.015988371937820545},{"c":1,"t":"So, I'd like to ask you a few more questions to get your views about shopping in","x":0.16782009074188892,"y":0.71366279086765805,"w":0.55882349650065111,"h":0.017441859689102501},{"w":0.1712802759806315,"y":0.73093072047931729,"t":"Broadbeach, if that's ok.","h":0.014708814627645395,"x":0.16782006955498568,"c":1},{"w":0.33044982910156245,"c":1,"x":0.16782006806167549,"t":"Sure. What would you like to know specifically?","y":0.74702589208880266,"h":0.01469559132260323},{"h":0.015133309147422946,"c":1,"x":0.1694953510117268,"t":"What would you say you like best about the shops here?","y":0.76160159923906845,"w":0.3911317189534505},{"x":0.16782007493928944,"t":"I'd probably say it's the service you get wherever you go.","w":0.39792386372884114,"y":0.77906976720475618,"h":0.014534884186538477,"c":1},{"h":0.01809727620044066,"y":0.79285427417350929,"t":"OK. And what do you think about the range of shops in Broadbeach?","c":1,"x":0.16775423091149785,"w":0.48458348592122391},{"y":0.81104651174828835,"h":0.013081395100512871,"x":0.16955017185990343,"c":1,"t":"Oh you can get almost anything you want here.","w":0.33044982910156251},{"h":0.015988371937820545,"c":1,"x":0.16782006848255945,"y":0.82558139542165165,"w":0.5536332194010416,"t":"And what about recent changes? What do you like and dislike about them? For"},{"x":0.16782008121812755,"t":"example, there are a lot of new coffee shops now, are you enjoying them?","h":0.016095171448565426,"y":0.84149755054443676,"w":0.51903111775716149,"c":1},{"h":0.018611538235001612,"x":0.16777468005650661,"t":"No, there are too many of them. It's a shame as those places could be occupied","y":0.8564680357361969,"w":0.55547368367513017,"c":1},{"x":0.16955017541800282,"c":1,"y":0.87354651188078858,"t":"by other kinds of shops.","w":0.16782006581624348,"h":0.014534882851794828},{"w":0.25259516398111975,"t":"What would you like to see instead?","y":0.88943317032051272,"h":0.016095171448565426,"x":0.16782006501907443,"c":1},{"w":0.52941177368164061,"y":0.90406976761184399,"h":0.017553745240411089,"c":1,"t":"Well, I think we have enough clothing shops. But there's only one place that","x":0.16782006752769177},{"y":0.91886372114690462,"x":0.16946043683001277,"w":0.46905832926432289,"h":0.017773789071469537,"t":"sells books at the moment. It'd be nice to have a choice, you know.","c":1},{"c":1,"h":0.014534884186538477,"x":0.73875432518406037,"t":"Q7","y":0.8415697671429887,"w":0.034602076212565169},{"x":0.74913494782849988,"h":0.014534884186538477,"y":0.9215116276081049,"c":1,"w":0.024221453666687043,"t":"Q8"},{"x":0.084775087017474979,"c":1,"y":0.96075581404131327,"w":0.032871971130371103,"h":0.013081395100512871,"t":"112"}],"h":2857}