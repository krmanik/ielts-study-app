{"lines":[{"y":0.099859113902036611,"t":"Audioscripts","w":0.23424860636393227,"x":0.18725971075579403,"h":0.041388875375351297,"c":1},{"y":0.1656976741111077,"x":0.47058823633730468,"c":1,"t":"TEST 1","w":0.083044980367024734,"h":0.01744186102384615},{"h":0.014932557033274452,"w":0.084870592753092444,"x":0.19199376928079176,"t":"PART 1","y":0.23090581415787625,"c":1},{"t":"WOMAN:","y":0.26109140256777275,"w":0.053949120839436843,"h":0.012700915753716235,"c":1,"x":0.19188357098222364},{"x":0.19377162685224134,"h":0.010174418263205087,"w":0.032871971130371103,"c":1,"t":"MAN:","y":0.27761627919424314},{"w":0.053867479960123699,"h":0.012414080684546969,"c":1,"y":0.29321156428886663,"t":"WOMAN:","x":0.19192439142172585},{"c":1,"x":0.19204152299882832,"y":0.30959302339976225,"t":"MAN:","h":0.010174418263205087,"w":0.032871971130371075},{"x":0.19031141725944256,"w":0.055363324483235693,"h":0.013081395100512871,"c":1,"y":0.32412790707980732,"t":"WOMAN:"},{"t":"MAN:","y":0.3415697675858087,"c":1,"h":0.010174418263205087,"x":0.19031141791663431,"w":0.036332181294759097},{"w":0.055363324483235693,"t":"WOMAN:","x":0.19031141725944256,"h":0.010174418263205087,"c":1,"y":0.35755813968919647},{"h":0.0087209305119230196,"y":0.40552325565004621,"x":0.19204152236084546,"t":"MAN:","w":0.034602076212565086,"c":1},{"w":0.055417219797770173,"y":0.41996707031191394,"x":0.19028447016098701,"h":0.011810045128856417,"t":"WOMAN:","c":1},{"h":0.011627907349230804,"t":"MAN:","x":0.19031141983048594,"y":0.43604651129631489,"w":0.036332178115844715,"c":1},{"w":0.055363318125406902,"x":0.19031141991653533,"t":"WOMAN:","y":0.45203488338933817,"h":0.011627907349230693,"c":1},{"t":"MAN:","y":0.48401162769013362,"h":0.011627907349230804,"w":0.034602076212565086,"c":1,"x":0.19031141855917},{"w":0.055363324483235693,"t":"WOMAN:","x":0.19031141725944256,"h":0.011627907349230804,"y":0.49999999979500198,"c":1},{"w":0.034602076212565086,"h":0.011627907349230804,"c":1,"y":0.53197674396920347,"t":"MAN:","x":0.19031141855917},{"y":0.54796511612485244,"x":0.19204152170374675,"t":"WOMAN:","w":0.053633219401041654,"h":0.0087209305119230196,"c":1},{"x":0.19031141881413266,"w":0.034602076212565114,"y":0.62645348806957069,"h":0.011627907349230693,"c":1,"t":"MAN:"},{"t":"WOMAN:","w":0.05365674972534179,"c":1,"y":0.64384408051334041,"h":0.0088234668515461134,"x":0.19202975654155752},{"c":1,"h":0.010174418263205087,"w":0.034602076212565114,"t":"MAN:","x":0.19031141855461711,"y":0.65988372107551951},{"x":0.19027993328845488,"y":0.67574998082153936,"w":0.055426292419433587,"h":0.010418642977053083,"c":1,"t":"WOMAN:"},{"w":0.034602076212565114,"h":0.010174418263205087,"t":"MAN:","y":0.70784883735458926,"x":0.19031141855461711,"c":1},{"h":0.011627907349230693,"y":0.72238372059864042,"w":0.055363318125406902,"c":1,"t":"WOMAN:","x":0.19031141991653533},{"y":0.73837209269166371,"t":"MAN:","h":0.011627907349230804,"c":1,"w":0.034602076212565142,"x":0.19031141829510154},{"t":"WOMAN:","x":0.1902453242925857,"h":0.012079580585968253,"y":0.75413462825155175,"w":0.055495510101318368,"c":1},{"t":"MAN:","x":0.1903114185500642,"y":0.83430232572534357,"w":0.034602076212565114,"h":0.010174418263205087,"c":1},{"h":0.011627907349230804,"x":0.1903114178946349,"y":0.87209302305081582,"w":0.053633219401041654,"c":1,"t":"WOMAN:"},{"x":0.1885813141147312,"c":1,"t":"MAN:","y":0.90406976758714752,"h":0.010174418263205087,"w":0.036332181294759125},{"y":0.26017441836831912,"c":1,"x":0.27508650655618699,"w":0.35813148498535158,"h":0.014534884186538477,"t":"Hello, Oyster Bay Sailing Club. How can I help you?"},{"h":0.016095171448565426,"c":1,"x":0.27681660625215804,"y":0.27466759964929832,"w":0.42214533487955724,"t":"Oh hi. I'd like to find out about sailing courses for beginners."},{"t":"No problem. Is it for yourself?","x":0.27508651110031673,"h":0.016160268229650665,"y":0.2906976742963514,"w":0.20934254964192711,"c":1},{"w":0.47577855428059901,"t":"Yes. I had a look online but I'm not sure which course would be best.","x":0.27681660526811791,"y":0.30668604662868071,"h":0.013118012456980632,"c":1},{"w":0.37038332621256509,"t":"OK. Well you might be interested in our Taster Days?","h":0.017455667611850245,"c":1,"x":0.27502820731724797,"y":0.32263252561493538},{"t":"Possibly.","x":0.27508650373065807,"y":0.34011627881273854,"h":0.014534884186538477,"c":1,"w":0.064013843536376958},{"t":"So these are for people who've never sailed before - it's basically an","h":0.015988371937820545,"c":1,"y":0.35465116286439946,"w":0.47404846191406252,"x":0.27508649561483139},{"w":0.52249135335286456,"c":1,"t":"introduction to sailing to find out whether you enjoy it and want to carry on","h":0.01469559132260323,"x":0.27508650317054484,"y":0.37053883825085987},{"t":"And how much is that?","h":0.013081395100512871,"x":0.27508650300500309,"y":0.40261627918565024,"w":0.16089965820312507,"c":1},{"w":0.52076126098632813,"h":0.016118565499991022,"c":1,"y":0.41847445767522751,"x":0.27508649744671648,"t":"It's £120 for the day - but it's reduced to £110 each if there are two of you."},{"y":0.43456962926600129,"h":0.016095171448565315,"w":0.1712802759806315,"c":1,"x":0.27508650544048008,"t":"No, it would just be me."},{"y":0.44832052829498403,"h":0.01957339853402873,"c":1,"x":0.27499759365224385,"w":0.52093566894531251,"t":"Oh that's fine. You'd be in a small group, usually about eight people but no"},{"y":0.46501049700713293,"w":0.36332178751627597,"x":0.27508651112940519,"h":0.01754764279258092,"t":"more than ten - and everyone's always very friendly.","c":1},{"y":0.48250524874776446,"c":1,"h":0.014695591322603119,"w":0.34775085449218751,"x":0.27508651038409665,"t":"Uh huh. And are there any other suitable courses?"},{"c":1,"h":0.01308139510051276,"t":"The other option is the Level 1 course. These are two-day weekend courses and","y":0.49854651175001885,"x":0.27681660248620765,"w":0.55190312703450517},{"c":1,"x":0.27681660742552416,"w":0.19377162933349606,"y":0.51453488383637147,"t":"we run those all year round.","h":0.013106823968586978},{"x":0.27508650153990227,"y":0.53044086785963951,"h":0.01469559132260323,"c":1,"w":0.30276817321777344,"t":"OK. And what do you learn on that course?"},{"t":"This is a mix of theory and practical skills. So you learn about things like the","w":0.5226213073730468,"y":0.54468088443574147,"h":0.017726262855396357,"x":0.27501535985824849,"c":1},{"w":0.5051902770996094,"c":1,"h":0.016153148039810494,"x":0.27335642036022989,"y":0.56088173540366382,"t":"weather, which is obviously really important and also the tides, as well as"},{"x":0.27335641000182459,"y":0.57697690700743187,"w":0.50865051269531247,"h":0.016095171448565426,"c":1,"t":"learning basic sailing skills. You go out into the harbour in special training"},{"y":0.59302325588893379,"h":0.016143993700693526,"w":0.54498270670572924,"c":1,"x":0.27508650123077594,"t":"dinghies for beginners, two people in each dinghy and an instructor. He or she"},{"y":0.60901162798167108,"t":"will make sure you understand everything you need to know about safety.","h":0.015988371937820545,"x":0.27335640191135935,"c":1,"w":0.51557093302408852},{"t":"It sounds like hard work!","y":0.62443404589143536,"c":1,"h":0.015534432973788204,"x":0.27319691321730843,"w":0.17334977467854823},{"y":0.64098837185373037,"w":0.24740483601888025,"h":0.014534884186538477,"c":1,"x":0.27508650921884087,"t":"Yes, but you'll have a lot of fun too."},{"x":0.27508650421064124,"w":0.20934256235758469,"c":1,"h":0.014534884186538477,"t":"And the cost of that one is...?","y":0.65697674394651318},{"c":1,"x":0.27335640886624485,"t":"£200. But it's a bit cheaper if you decide to join the club. There's a discount for","w":0.54844289143880198,"h":0.016105342862320793,"y":0.67284814542948823},{"y":0.68878090834781902,"t":"members.","w":0.071188818613688143,"h":0.012605389487584828,"x":0.27677267654423143,"c":1},{"t":"Well, I'm not sure about that yet.","w":0.23040809631347653,"h":0.017775548263560537,"c":1,"x":0.27493340220982371,"y":0.70340146178520568},{"x":0.27335640287648372,"y":0.7207837645387779,"h":0.016134840028948383,"t":"You've got plenty of time to decide.","w":0.25432525634765629,"c":1},{"h":0.01469559132260323,"t":"And does the cost include everything?","x":0.27508650158503184,"w":0.26816609700520827,"c":1,"y":0.73687893650059766},{"c":1,"h":0.016162302378927351,"y":0.75290697681914043,"t":"Yes, everything's included and you also get a really good dictionary explaining","w":0.5432526143391927,"x":0.27335639170297177},{"y":0.76731980404517108,"h":0.016110428235512564,"x":0.27335641019578549,"t":"all the sailing terminology. A lot of people struggle with this at first. It's got","w":0.52595153808593753,"c":1},{"t":"lots of pictures, so I'm sure you'd find it really helpful. And on completion of","y":0.78341497564893903,"w":0.53114186604817704,"x":0.27335640134009831,"h":0.016095171448565426,"c":1},{"x":0.27501515457761289,"w":0.53299524943033849,"c":1,"h":0.017899443170588891,"t":"the course you get a certificate. Then you're ready to move on to the Level 2","y":0.79864108042195725},{"h":0.0087209305119230196,"t":"course.","y":0.81976744170463278,"x":0.27508650439341736,"w":0.053633219401041654,"c":1},{"y":0.8320941897000228,"w":0.10233727773030599,"x":0.27323626628842868,"t":"Sounds good.","h":0.015184307699023236,"c":1},{"x":0.27328846373856513,"w":0.51571060180664063,"y":0.86850125503923503,"c":1,"h":0.016749179138012771,"t":"I think that's all the info you need for now. Just a couple of general things."},{"c":1,"w":0.42733566284179691,"x":0.27508649358535497,"y":0.88517441836309108,"h":0.014534884186538477,"t":"For example, it's really important that you know how to swim."},{"c":1,"w":0.26124567667643228,"t":"Yes, I'm pretty confident in the water.","x":0.27335640025295371,"h":0.015988371937820545,"y":0.90116279076515671},{"w":0.024221453666687043,"h":0.01308139510051276,"y":0.46656976750656176,"c":1,"t":"Q1","x":0.85294117620220222},{"h":0.011627907349230804,"c":1,"t":"Q2","y":0.56249999976903398,"x":0.85294117620099241,"w":0.024221453666686932},{"w":0.024221453666687043,"y":0.60901162797167807,"c":1,"t":"Q3","h":0.013081395100512871,"x":0.85294117620220222},{"c":1,"y":0.67296511604810372,"h":0.011627907349230693,"t":"Q4","x":0.85121107255816397,"w":0.025951557159423766},{"c":1,"w":0.024221453666686932,"x":0.85294117620099241,"t":"Q5","h":0.01308139510051276,"y":0.7529069768180352},{"t":"06","w":0.024221453666686932,"c":1,"y":0.80087209309710505,"h":0.01308139510051276,"x":0.85294117620099241},{"w":0.022491348584492976,"x":0.88754325297261671,"t":"97","c":1,"y":0.95348837179415158,"h":0.014534884186538477}],"h":2857,"w":2400}