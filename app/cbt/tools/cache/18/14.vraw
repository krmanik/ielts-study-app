":0.6904069769270661,"x":0.11262135948810714,"h":0.01453488311292217},{"w":0.37494847615559895,"t":"why they would like a career in fashion.","x":0.15716935999596321,"y":0.68920921627751053,"h":0.019071520748910942,"c":1},{"w":0.55728154500325533,"h":0.017499819128684146,"c":1,"x":0.064077674003568508,"t":"26 How does Hugo feel about being an unpaid assistant?","y":0.72087227400204779},{"c":1,"w":0.3126213582356771,"y":0.75000000009113821,"x":0.1553398062138201,"h":0.016043613707165116,"t":"He is realistic about the practice."},{"y":0.76889534862348508,"c":1,"w":0.015533979733785008,"x":0.11262135957000069,"t":"B","h":0.01308139551465759},{"y":0.76884735207523025,"h":0.016036368753308383,"w":0.3203883616129557,"t":"He feels the practice is dishonest.","c":1,"x":0.15728154725177462},{"w":0.47378641764322904,"y":0.78629283510073378,"h":0.017486234765929143,"t":"C He thinks others want to change the practice.","x":0.1126213543583123,"c":1},{"x":0.87378640854728473,"y":0.95494186032274531,"t":"13","h":0.013081395514657479,"w":0.029126211802164681,"c":1}],"w":2400}