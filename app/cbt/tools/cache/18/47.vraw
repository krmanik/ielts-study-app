{"lines":[{"x":0.093203883552374509,"y":0.046417445778134225,"w":0.060194174448649093,"c":1,"h":0.013175577538035776,"t":"Test 2"},{"y":0.094392523244750337,"x":0.093203883953596689,"w":0.17669902801513671,"t":"Questions 20-23","h":0.016199376947040545,"c":1},{"x":0.09118484677183214,"w":0.8118329366048177,"t":"Do the following statements agree with the claims of the writer in Reading Passage 2?","y":0.1321737417166422,"h":0.021838140042028664,"c":1},{"y":0.17441860453612057,"t":"In boxes 20-23 on your answer sheet, write","c":1,"h":0.017481707041137384,"w":0.41553398132324215,"x":0.08932038788607187},{"h":0.01308139551465759,"c":1,"w":0.042718445460001642,"y":0.21220930221152501,"t":"YES","x":0.16504854416782627},{"x":0.16310679677556703,"w":0.034951454798380521,"y":0.23110465103900113,"c":1,"h":0.01308139551465759,"t":"NO"},{"t":"if the statement agrees with the claims of the writer","y":0.20917435128990758,"w":0.48365214029947917,"x":0.29895196026232923,"h":0.019599501589005586,"c":1},{"x":0.29902914227162969,"y":0.22819767431547855,"t":"if the statement contradicts the claims of the writer","w":0.47766988118489584,"c":1,"h":0.016039085982373247},{"h":0.019183409028335596,"t":"NOT GIVEN if it is impossible to say what the writer thinks about this","w":0.66032847086588542,"c":1,"x":0.16304107402046858,"y":0.24647369237881622},{"t":"20 Machines with the ability to make moral decisions may prevent us from promoting","h":0.017590378972228815,"c":1,"x":0.091262140399940767,"y":0.28473520252859663,"w":0.81359222412109389},{"h":0.018913131190980259,"x":0.13763801241760737,"t":"the interests of our communities.","w":0.32471656799316406,"c":1,"y":0.30253233380848843},{"c":1,"x":0.091206812106097268,"y":0.33098208721967426,"w":0.74767079671223957,"t":"21 Silicon police would need to exist in large numbers in order to be effective.","h":0.019603804710126793},{"h":0.019652259684054596,"x":0.091208053871002712,"y":0.35996047380465546,"w":0.75740198771158851,"t":"22 Many peopl