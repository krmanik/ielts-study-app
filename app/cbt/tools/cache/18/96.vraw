{"h":3209,"lines":[{"t":"Reading","x":0.82307192321907152,"w":0.083953240712483668,"h":0.020056691867911591,"y":0.03430304938465667,"c":1},{"x":0.073786408226544614,"w":0.17669902801513673,"h":0.016010106166946536,"c":1,"y":0.08866279078531869,"t":"Questions 37-40"},{"y":0.12629147862907808,"w":0.36730888366699216,"t":"Choose the correct letter, A, B, C or D.","h":0.02294317584171468,"c":1,"x":0.073611433046509189},{"x":0.073619523509330709,"t":"Write the correct letter in boxes 37-40 on your answer sheet.","w":0.57504867553710937,"y":0.16242450732622649,"h":0.022427940962841841,"c":1},{"w":0.53225138346354173,"x":0.071751628844533719,"t":"37 What is Mott T Greene doing in the fifth paragraph?","y":0.20052428307388503,"h":0.019630052441748536,"c":1},{"t":"describing what motivated him to write the book","y":0.22945160119355745,"w":0.45068725585937497,"x":0.1649536704722496,"h":0.01948609159000203,"c":1},{"x":0.12038834982797576,"y":0.25145348841340187,"w":0.015533979733784994,"h":0.011627906728013615,"t":"B","c":1},{"h":0.014534883112922281,"t":"C","y":0.26889534899586442,"c":1,"x":0.12038834986126284,"w":0.015533979733785008},{"h":0.013081395514657479,"y":0.28779069749806996,"x":0.12038834982797576,"c":1,"t":"D","w":0.015533979733784994},{"h":0.018278766049774187,"c":1,"t":"explaining why it is desirable to read the whole book","x":0.16495811373336272,"y":0.24825742255730798,"w":0.49338653564453122},{"y":0.26490082268114257,"w":0.56926345825195312,"t":"suggesting why Wegener pursued so many different careers","h":0.022049691743939781,"c":1,"x":0.1629480832809018},{"c":1,"y":0.28272523128644933,"w":0.58097585042317701,"x":0.16294741085043682,"t":"indicating what aspects of Wegener's life interested him most","h":0.023619673779448958},{"x":0.071728924297003352,"y":0.31534222088581398,"w":0.53815307617187491,"h":0.021915305069302504,"t":"38 What is said about Wegener in the sixth paragraph?","c":1},{"x":0.12038834984184538,"y":0.34738372111311244,"w":0.015533979733784981,"c":1,"t":"A","h":0.014534883112922281},{"w":0.40776697794596362,"h":0.017577700748621972,"c":1,"t":"He was not a particularly ambitious person.","x":0.16699029737481955,"y":0.34579439237235587},{"h":0.018560203956294985,"c":1,"t":"He kept a record of all his scientific observations.","x":0.16690973715751156,"w":0.46228337605794267,"y":0.36394937530539673},{"w":0.017475727399190275,"t":"C","h":0.013081395514657479,"c":1,"x":0.12038834979555048,"y":0.38517441842830247},{"w":0.017475727399190275,"h":0.013081395514657479,"t":"D","c":1,"x":0.12038834979555048,"y":0.4040697672655118},{"w":0.56525446573893223,"y":0.38161527753393454,"h":0.020914261957566627,"c":1,"t":"He did not adopt many of the scientific practices of the time.","x":0.16493317218820588},{"x":0.16699029191338108,"h":0.017565928069973258,"t":"He enjoyed discussing new discoveries with other scientists.","y":0.40249221157203741,"c":1,"w":0.56893203735351561},{"x":0.073718504121277839,"y":0.4345572347109361,"w":0.61761459350585923,"h":0.019627127246321985,"c":1,"t":"39 What does Greene say about some other famous scientists?"},{"x":0.16686221535626344,"w":0.60603383382161458,"h":0.022004511943116034,"y":0.46186787284442499,"t":"Their published works had a greater impact than Wegener's did.","c":1},{"h":0.01308139551465759,"t":"B","x":0.12233009741466089,"w":0.015533979733784981,"c":1,"y":0.48546511608714793},{"w":0.017475727399190275,"h":0.014534883112922281,"c":1,"y":0.50290697690284114,"t":"C","x":0.12038834979555051},{"h":0.01308139551465759,"c":1,"w":0.015533979733784981,"x":0.12233009740079126,"t":"D","y":0.52180232540504667},{"x":0.16687941615031263,"h":0.020725468905915423,"c":1,"w":0.6487291463216146,"y":0.48094861932149779,"t":"They had fewer doubts about their scientific ideas than Wegener did."},{"y":0.49990598131498687,"x":0.16691215275070931,"c":1,"h":0.02078590749580167,"w":0.58848932902018225,"t":"Their scientific ideas were more controversial than Wegener's."},{"t":"They are easier subjects to write about than Wegener.","c":1,"x":0.16699029216371492,"y":0.5202492211823676,"w":0.51262135823567712,"h":0.017541476573528114},{"h":0.0160028618072795,"c":1,"t":"40 What is Greene's main point in the final paragraph?","x":0.073786410910487155,"y":0.55377906986032699,"w":0.5320388285319011},{"h":0.017462689408632159,"w":0.43495147705078119,"c":1,"t":"It is not enough in life to have good intentions.","y":0.58284883709426005,"x":0.16699028078899233},{"h":0.017466311588465677,"w":0.50291259765624996,"c":1,"x":0.16893205071405007,"t":"People need to plan carefully if they want to succeed.","y":0.60029069755587083},{"x":0.12038834981173172,"y":0.62063953506660097,"h":0.014534883112922281,"t":"C","w":0.017475727399190261,"c":1},{"h":0.014534883112922281,"c":1,"t":"D","y":0.63953488392111368,"x":0.12038834979555048,"w":0.017475727399190275},{"x":0.16885275833030183,"w":0.54188517252604163,"h":0.019079260662708708,"c":1,"t":"People have little control over many aspects of their lives.","y":0.61881132081782064},{"h":0.019342228779540283,"w":0.59430002848307284,"c":1,"y":0.63745968568577993,"x":0.16691575762515792,"t":"It is important that people ensure they have the freedom to act."},{"y":0.95189456215002599,"x":0.72812083439426389,"h":0.017722502972849385,"c":1,"w":0.12628260294596361,"t":"→ @ р. 126"},{"h":0.015988371899566256,"y":0.95058139538407194,"x":0.88349514642901494,"c":1,"t":"95","w":0.029126211802164681}],"w":2400}