{"blocks":[{"l":"header","b":[0.8117,0.0361,0.9025,0.0548],"t":"Listening"},{"l":"paragraph_title","b":[0.0629,0.0863,0.4292,0.1072],"t":"PART 2 Questions 11–20"},{"l":"text","b":[0.0646,0.125,0.2471,0.144],"t":"Questions 11–14"},{"l":"text","b":[0.0642,0.163,0.4079,0.1814],"t":"Choose the correct letter, A, B or C."},{"l":"paragraph_title","b":[0.0642,0.2001,0.4542,0.2188],"t":"11 The museum building was originally"},{"l":"text","b":[0.1092,0.2278,0.3417,0.2842],"t":"A a factory.\nB a private home.\nC a hall of residence."},{"l":"paragraph_title","b":[0.0638,0.2948,0.5967,0.3129],"t":"12 The university uses part of the museum building as"},{"l":"text","b":[0.1104,0.3244,0.315,0.3409],"t":"A teaching room."},{"l":"text","b":[0.1113,0.3437,0.3317,0.3602],"t":"B a research library."},{"l":"text","b":[0.1108,0.3624,0.3692,0.3789],"t":"C administration offices."},{"l":"paragraph_title","b":[0.065,0.392,0.5825,0.4101],"t":"13 What does the guide say about the entrance fee?"},{"l":"text","b":[0.1096,0.421,0.6083,0.4388],"t":"A Visitors decide whether or not they wish to pay."},{"l":"text","b":[0.1108,0.4403,0.6075,0.4578],"t":"B Only children and students receive a discount."},{"l":"text","b":[0.1113,0.459,0.6367,0.4768],"t":"C The museum charges extra for special exhibitions."},{"l":"text","b":[0.0696,0.4886,0.6117,0.5728],"t":"14 What are visitors advised to leave in the cloakroom?\nA cameras\nB coats\nC bags"},{"l":"number","b":[0.8783,0.9529,0.9067,0.9695],"t":"79"}]}