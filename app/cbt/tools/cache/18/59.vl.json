{"blocks":[{"l":"paragraph_title","b":[0.0946,0.0405,0.1596,0.0583],"t":"Test 3"},{"l":"paragraph_title","b":[0.0921,0.0882,0.4596,0.1097],"t":"PART 3 Questions 21–30"},{"l":"text","b":[0.0933,0.1268,0.315,0.1474],"t":"Questions 21 and 22"},{"l":"text","b":[0.0933,0.1673,0.3504,0.1864],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.0917,0.206,0.7242,0.2253],"t":"Which TWO opinions about the Luddites do the students express?"},{"l":"text","b":[0.1388,0.2353,0.4733,0.253],"t":"Their actions were ineffective."},{"l":"text","b":[0.1404,0.2549,0.4721,0.272],"t":"B They are still influential today."},{"l":"text","b":[0.1404,0.2736,0.525,0.2907],"t":"C They have received unfair criticism."},{"l":"text","b":[0.1404,0.2926,0.4158,0.3098],"t":"D They were proved right."},{"l":"text","b":[0.14,0.3104,0.4963,0.3288],"t":"E Their attitude is understandable."},{"l":"paragraph_title","b":[0.0954,0.3665,0.3175,0.3867],"t":"Questions 23 and 24"},{"l":"paragraph_title","b":[0.0954,0.406,0.3517,0.4254],"t":"Choose TWO letters, A-E."},{"l":"paragraph_title","b":[0.0929,0.4441,0.865,0.4649],"t":"Which TWO predictions about the future of work are the students doubtful about?"},{"l":"text","b":[0.1392,0.4743,0.4667,0.4927],"t":"A Work will be more rewarding."},{"l":"text","b":[0.1412,0.4936,0.4125,0.5114],"t":"B Unemployment will fall."},{"l":"text","b":[0.1408,0.5123,0.5033,0.5307],"t":"C People will want to delay retiring."},{"l":"text","b":[0.1408,0.531,0.4733,0.5488],"t":"D Working hours will be shorter."},{"l":"text","b":[0.1408,0.5491,0.5742,0.569],"t":"E People will change jobs more frequently."},{"l":"number","b":[0.0983,0.9576,0.1258,0.9748],"t":"58"}]}