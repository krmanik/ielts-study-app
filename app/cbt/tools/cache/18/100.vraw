{"lines":[{"t":"Audioscripts","x":0.069775807075249482,"y":0.088110509836500372,"w":0.25656489054361975,"h":0.034534794222157328,"c":1},{"c":1,"w":0.10291261672973634,"t":"TEST 1","x":0.39029126431474348,"y":0.15261627915718123,"h":0.019034811120909656},{"x":0.071806518606740116,"c":1,"t":"PART 1","y":0.21789688877259528,"w":0.10298890431722005,"h":0.017694594481281078},{"w":0.038834950129191081,"y":0.25290697645486238,"x":0.069902913182721793,"t":"MAN.","h":0.010174419129749035,"c":1},{"x":0.06990291300687336,"y":0.28488372064556544,"w":0.046601940790812188,"c":1,"h":0.010174419129748924,"t":"SADIE:"},{"y":0.30087209329130638,"h":0.010174417941369751,"t":"MAN:","w":0.036893202463785801,"x":0.071844660940437191,"c":1},{"w":0.04679300626118979,"h":0.010673661989586414,"x":0.071749127844085853,"c":1,"t":"SADIE:","y":0.31661084340269241},{"x":0.06990291341436887,"w":0.038834950129191081,"h":0.011627906728013615,"c":1,"y":0.33284883723676839,"t":"MAN:"},{"y":0.3647184811051023,"t":"SADIE:","w":0.046696996688842779,"h":0.011842107327185047,"c":1,"x":0.071797132996334126},{"x":0.0718446608123358,"y":0.38226744195253071,"w":0.036893202463785815,"h":0.011627906728013615,"c":1,"t":"MAN."},{"c":1,"y":0.3982558140525756,"t":"SADIE:","w":0.04854368845621744,"h":0.011627906728013615,"x":0.071844660529172835},{"h":0.011627906728013615,"w":0.036893202463785801,"c":1,"y":0.41424418607397773,"x":0.071844661017298042,"t":"MAN:"},{"t":"SADIE:","x":0.071788349702273713,"y":0.4286735430058366,"w":0.048656311035156247,"h":0.014745936883944211,"c":1},{"t":"MAN:","y":0.4462209302115745,"w":0.036893202463785815,"x":0.071844661171019716,"h":0.011627906728013726,"c":1},{"t":"SADIE:","h":0.012116429218993474,"x":0.073679163185704735,"y":0.46196504105504177,"w":0.046816431681315121,"c":1},{"h":0.010174419129749035,"c":1,"x":0.071844660806942046,"t":"MAN.","w":0.036893202463785815,"y":0.47965116250137396},{"w":0.046601940790812188,"t":"SADIE:","h":0.010174417941369751,"y":0.51017441880911174,"c":1,"x":0.073786408633720116},{"t":"MAN:","w":0.036893202463785815,"y":0.52761627877729389,"h":0.010174419129748924,"x":0.073786408379757584,"c":1},{"h":0.01308139551465759,"c":1,"x":0.071844661038881569,"y":0.54215116254426998,"w":0.04854368845621744,"t":"SADIE:"},{"x":0.0718446608123358,"t":"MAN:","y":0.55959302334787941,"h":0.011627906728013726,"c":1,"w":0.036893202463785815},{"x":0.071772073584906837,"w":0.048688863118489578,"t":"SADIE:","y":0.5913985095256824,"h":0.011970422572435968,"c":1},{"h":0.010174419129748924,"t":"MAN.","x":0.071844660806942046,"y":0.62499999971067632,"w":0.036893202463785815,"c":1},{"c":1,"w":0.046601940790812188,"t":"SADIE:","h":0.011627906728013615,"y":0.63953488369994671,"x":0.073786408633720116},{"c":1,"h":0.010174419129749035,"x":0.071844660765757046,"y":0.65697674389672278,"w":0.038834950129191081,"t":"MAN:"},{"h":0.011627906728013726,"y":0.67296511637921019,"c":1,"w":0.048543688456217454,"t":"SADIE:","x":0.071844660533218127},{"t":"MAN:","y":0.70494186052488217,"w":0.038834950129191081,"x":0.071844660879309519,"h":0.011627906728013615,"c":1},{"x":0.075688453364713346,"t":"SADIE:","y":0.71939115110609209,"w":0.044739599227905269,"h":0.011799092753282503,"c":1},{"c":1,"h":0.011627906728013615,"y":0.73691860463017922,"t":"MAN:","w":0.036893202463785815,"x":0.073786408695291544},{"y":0.75287353152526748,"x":0.075712581324115805,"c":1,"t":"SADIE:","w":0.044691343307495121,"h":0.01169479702863363},{"h":0.010174419129748924,"y":0.77034883691997857,"c":1,"x":0.073786408379757584,"w":0.036893202463785815,"t":"MAN."},{"t":"SADIE:","c":1,"w":0.046601940790812188,"y":0.78488372068380485,"h":0.01308139551465759,"x":0.073786408633720116},{"y":0.82703488377262113,"w":0.036893202463785801,"c":1,"t":"MAN:","h":0.011627906728013615,"x":0.07378640851325273},{"t":"SADIE:","y":0.84302325597602057,"c":1,"h":0.010174417941369751,"x":0.075728156414642811,"w":0.044660193125406908},{"t":"MAN:","x":0.071844660719746045,"h":0.010174419129748924,"c":1,"w":0.040776697794596348,"y":0.87645348808128176},{"w":0.046601940790812174,"t":"SADIE:","x":0.073786408342457976,"y":0.90843023260983036,"h":0.011627906728013726,"c":1},{"w":0.59238779703776046,"c":1,"t":"Excuse me. Would you mind if I asked you some questions? We're doing a","x":0.1669174609230212,"h":0.018588088680279169,"y":0.24651989329790247},{"t":"survey on transport.","w":0.15972216288248697,"h":0.015941375066929497,"c":1,"x":0.16867225218370924,"y":0.26572137896278814},{"w":0.12038834889729819,"y":0.28193146405012492,"x":0.16699029147033315,"h":0.016033652118433217,"t":"Yes, that's OK.","c":1},{"h":0.016199376947040434,"y":0.29781931471873313,"w":0.26601941426595055,"t":"First of all, can I take your name?","x":0.16893204034275294,"c":1},{"x":0.16699029014307068,"t":"Yes. It's Sadie Jones.","c":1,"h":0.014534883112922281,"y":0.31395348866491635,"w":0.17475728352864581},{"w":0.60981531778971354,"h":0.018506826121487796,"c":1,"y":0.32770626970493799,"t":"Thanks very much. And could I have your date of birth - just the year will do,","x":0.16692833849004748},{"x":0.16699029292316381,"y":0.34579439258179745,"w":0.19417475382486982,"h":0.016199376947040434,"c":1,"t":"actually. Is that all right?"},{"t":"Yes, that's fine. It's 1991.","y":0.3632398752293311,"w":0.20388348897298181,"x":0.16699029424745043,"h":0.016199376947040545,"c":1},{"x":0.16893203279197053,"h":0.015988371899566256,"t":"So next your postcode, please.","y":0.37936046520546585,"w":0.24854370117187499,"c":1},{"w":0.11844660441080729,"c":1,"x":0.1689320375067408,"t":"It's DW30 7YZ","y":0.39532710284753692,"h":0.01310312978203787},{"w":0.25083386739095054,"t":"Great. Thanks. Is that in Wells?","y":0.40980739129016652,"c":1,"x":0.16877428035953784,"h":0.017028164492218001},{"w":0.49902913411458338,"t":"No it's actually in Harborne - Wells isn't far from there, though.","h":0.016003767352237963,"x":0.16893203554673045,"y":0.42585669763876188,"c":1},{"c":1,"t":"I really like that area. My grandmother lived there when I was a kid.","x":0.16691642096048062,"h":0.018495417086877519,"y":0.44172466993415194,"w":0.53607615152994792},{"c":1,"x":0.168883242867883,"y":0.460561856284321,"t":"Yes, it is nice.","w":0.11271895090738929,"h":0.016376287394966327},{"c":1,"x":0.16893204320370453,"w":0.61359222412109382,"t":"Right, so now I want to ask you some questions about how you travelled here","y":0.47529069776803667,"h":0.015988371899566145},{"t":"today. Did you use public transport?","x":0.16687422346937505,"y":0.49120273857750618,"w":0.29151074727376303,"c":1,"h":0.017780216015016559},{"y":0.50716510923514579,"c":1,"t":"Yes. I came by bus.","w":0.15922330220540365,"h":0.016199376947040434,"x":0.16893203719826905},{"c":1,"t":"OK. And that was today. It's the 24th of April, isn't it?","y":0.52300692599711618,"w":0.41570988972981776,"h":0.017024074090975505,"x":0.16885679846975193},{"x":0.16699028650723308,"y":0.54069767450893791,"h":0.016000144578214748,"t":"Isn't it the 25th? No, actually, you're right.","c":1,"w":0.33009709676106769},{"c":1,"y":0.55514018670370802,"x":0.16893204769199827,"h":0.016199376947040434,"t":"Ha ha. And what was the reason for your trip today? I can see you've got some","w":0.62718444824218755},{"c":1,"t":"shopping with you.","x":0.16893203981720081,"y":0.57412790688125581,"h":0.013099507602204352,"w":0.15339805603027343},{"c":1,"y":0.58699291333397885,"t":"Yes. I did some shopping but the main reason I came here was to go to the","w":0.594344228108724,"x":0.16885403874898941,"h":0.018323001089125768},{"c":1,"w":0.060281263987223305,"y":0.60599202714703193,"t":"dentist.","x":0.16888849421273364,"h":0.0133066432869694},{"y":0.62056074740951439,"w":0.39611651102701817,"c":1,"x":0.16893203597857062,"h":0.014641744548286595,"t":"That's not much fun. Hope it was nothing serious."},{"t":"No, it was just a check-up. It's fine.","y":0.63622609727763513,"x":0.16879304998646441,"h":0.018050947219040547,"w":0.27986996968587241,"c":1},{"x":0.17078109999240429,"h":0.017666591513565311,"c":1,"y":0.65207129158586707,"t":"Good. Do you normally travel by bus into the city centre?","w":0.45068705240885409},{"w":0.63320617675781254,"h":0.019319304944570237,"c":1,"x":0.16884199320367088,"t":"Yes. I stopped driving in ages ago because parking was so difficult to find and it","y":0.6664742101740696},{"y":0.68598130835389415,"w":0.12427183787027993,"x":0.16893204334641335,"c":1,"t":"costs so much.","h":0.014641744548286595},{"w":0.048480243682861329,"y":0.70312641381974983,"h":0.013805312159648198,"x":0.16993463626731872,"c":1,"t":"I see."},{"x":0.17078826973363107,"t":"The bus is much more convenient too. It only takes about 30 minutes.","h":0.017665809560044821,"w":0.55354654947916671,"y":0.71621558717273892,"c":1},{"w":0.39611648559570312,"y":0.73255813947172865,"h":0.016039991527331598,"x":0.17087379976525521,"t":"That's good. So where did you start your journey?","c":1},{"c":1,"y":0.75000000015865509,"x":0.16893204684673971,"w":0.26407765706380204,"t":"At the bus stop on Claxby Street.","h":0.014534883112922281},{"h":0.015921686000170299,"t":"Is that C-L-A-X-B-Y?","y":0.76572875140127339,"w":0.17323115030924477,"c":1,"x":0.16873288198011546},{"h":0.01544689701353652,"t":"That's right.","y":0.78297422559989627,"x":0.1707526213074157,"w":0.095387961069742844,"c":1},{"x":0.1707968128377966,"t":"And how satisfied with the service are you? Do you have any complaints?","w":0.58462549845377609,"h":0.017191856598185562,"y":0.8225297599697704,"c":1},{"w":0.6467849222819011,"x":0.17078635382934654,"t":"Well, as I said, it's very convenient and quick when it's on time, but this morning it","h":0.018620822585631802,"c":1,"y":0.83794351774492448},{"y":0.85607476646667657,"c":1,"t":"was late. Only about 10 minutes, but still.","h":0.01601825666576151,"w":0.32815533955891929,"x":0.17087378686455337},{"x":0.17076953428384664,"t":"Yes, I understand that's annoying. And what about the timetable? Do you have","h":0.019293557520596027,"y":0.87043557005514238,"c":1,"w":0.621567637125651},{"h":0.015269674616067874,"w":0.21395680745442711,"c":1,"x":0.17069002143176462,"t":"any comments about that?","y":0.8890734520552297},{"t":"Mmm. I suppose I mainly use the bus during the day, but any time l've been in","y":0.90351270351801893,"x":0.17079139405483471,"w":0.61959106445312506,"h":0.018289479288356669,"c":1},{"t":"town in the evening - for dinner or at the cinema - I've noticed you have to wait a","y":0.91993769441673168,"x":0.16893204276463489,"w":0.64466018676757808,"h":0.016199376947040545,"c":1},{"x":0.16883165013212106,"y":0.93703397678064138,"w":0.34775899251302078,"c":1,"h":0.016637102168668427,"t":"long time for a bus - there aren't that many."},{"t":"Q1","x":0.83883495156977084,"w":0.025242718060811353,"c":1,"y":0.3924418603227452,"h":0.013081395514657479},{"w":0.027184467315673921,"t":"Q2","c":1,"y":0.52180232544397931,"x":0.83883495071109515,"h":0.01308139551465759},{"x":0.8388349507185634,"w":0.02718446731567381,"h":0.01308139551465759,"y":0.6031976742853814,"c":1,"t":"Q3"},{"c":1,"t":"Q4","w":0.029126211802164681,"x":0.83883495226234817,"y":0.66715116265328178,"h":0.013081395514657479},{"y":0.74854651149049101,"w":0.02718446731567381,"h":0.01308139551465759,"t":"Q5","x":0.84077669828391077,"c":1},{"y":0.85465116265747454,"h":0.013081395514657479,"w":0.02718446731567381,"c":1,"x":0.84077669829137902,"t":"Q6"},{"c":1,"y":0.91860465132144586,"t":"Q7","h":0.014534883112922281,"x":0.84077670000929028,"w":0.027184464136759345},{"x":0.88349514488585257,"y":0.95348837234511696,"w":0.02718446731567381,"h":0.014534883112922281,"c":1,"t":"99"}],"w":2400,"h":3209}