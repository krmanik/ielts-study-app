{"w":2400,"h":3209,"lines":[{"h":0.027616278627579871,"w":0.24660194396972657,"t":"Introduction","x":0.081553396898631836,"y":0.090116279263244947,"c":1},{"t":"Prepare for the exam with practice tests from Cambridge","w":0.7458187866210938,"c":1,"h":0.022299237117589077,"y":0.19132510383009516,"x":0.085351206595815743},{"c":1,"t":"Inside you'll find four authentic examination papers from Cambridge University Press &","x":0.081482307971592713,"h":0.020467669050270088,"w":0.78270182291666668,"y":0.22983392234788624},{"c":1,"x":0.083411568645766085,"t":"Assessment. They are the perfect way to practise - EXACTLY like the real exam.","w":0.732192128499349,"h":0.020691325582819164,"y":0.24890606435579787},{"w":0.2837972259521484,"y":0.30371640755716156,"h":0.021310431934962737,"x":0.087252567927617306,"c":1,"t":"Why are they unique?"},{"h":0.020416142116083114,"x":0.085335046876225062,"y":0.34096149801013942,"w":0.80990346272786462,"t":"All our authentic practice tests go through the same design process as the IELTS test. We","c":1},{"c":1,"x":0.085383063908711088,"y":0.3602614002618274,"w":0.79428298950195309,"t":"check every single part of our practice tests with real students under exam conditions, to","h":0.019447674855264996},{"h":0.018284571876407085,"x":0.087294505681128676,"t":"make sure we give you the most authentic experience possible.","w":0.57100672403971364,"c":1,"y":0.37920080321644523},{"t":"Students can take these tests on their own or with the help of a teacher to familiarise","h":0.017995678672909299,"c":1,"x":0.10481029614736448,"y":0.39767446816555163,"w":0.7263206481933594},{"h":0.021866408018308303,"t":"themselves with the exam format, understand the scoring system and practise exam technique.","w":0.82539321899414064,"c":1,"x":0.083406933561774393,"y":0.41548238840474538},{"x":0.085288874297236819,"y":0.469641479867138,"t":"Further information","w":0.2565940856933594,"c":1,"h":0.018932492265077427},{"t":"IELTS is jointly managed by the British Coun