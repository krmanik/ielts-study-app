{"h":3209,"w":2400,"lines":[{"c":1,"h":0.016400273640950536,"x":0.089271948256768444,"y":0.040491723630009746,"w":0.1204852294921875,"t":"Audioscripts"},{"c":1,"w":0.06990290959676107,"t":"CHANTAL:","h":0.010174419129749035,"y":0.09156976716434917,"x":0.089320389764726255},{"h":0.013205709487106865,"t":"HUGO:","x":0.089290476716713862,"y":0.1074959824292322,"w":0.048603512446085601,"c":1},{"x":0.09126213649826298,"w":0.067961165110270172,"t":"CHANTAL:","y":0.13953488392539071,"h":0.010174417941369751,"c":1},{"x":0.089270448401889524,"t":"HUGO:","y":0.15540592355014693,"h":0.011862571217189366,"c":1,"w":0.048643569946289072},{"h":0.013081395514657479,"c":1,"x":0.089320390492881596,"y":0.17151162766054917,"w":0.06990290959676107,"t":"CHANTAL:"},{"t":"HUGO:","w":0.048700100580851224,"y":0.1887687828490846,"h":0.01199731797072745,"x":0.089242182622544658,"c":1},{"w":0.067961165110270186,"t":"CHANTAL:","h":0.011627906728013615,"y":0.20494186047320251,"c":1,"x":0.089320388804088199},{"h":0.013251743732583088,"c":1,"x":0.089279465278830281,"t":"HUGO:","w":0.048625535964965813,"y":0.22084505823456757},{"t":"CHANTAL:","h":0.011834721550391891,"x":0.089289802250575839,"y":0.26007101130044019,"w":0.069964084625244144,"c":1},{"t":"HUGO:","y":0.27616279058751125,"w":0.048543688456217454,"x":0.089320388680467322,"h":0.01308139551465759,"c":1},{"t":"CHANTAL:","x":0.089276438091498586,"y":0.32397875123345976,"w":0.069990812937418614,"h":0.01192621843094388,"c":1},{"h":0.01326256511367363,"w":0.048630704879760733,"c":1,"y":0.35601406611549713,"x":0.089276880932811387,"t":"HUGO:"},{"c":1,"y":0.38800109538422189,"t":"CHANTAL:","w":0.069950497945149737,"h":0.011788506671275734,"x":0.089296596153159574},{"x":0.089320389145677651,"y":0.43604651138147932,"w":0.04854368845621744,"h":0.01308139551465759,"c":1,"t":"HUGO:"},{"y":0.45203488350720611,"t":"CHANTAL:","w":0.069902909596761084,"h":0.01308139551465759,"c":1,"x":0.089320390327833052},{"x":0.089235822077786006,"w":0.048712822596232094,"h":0.01343558718482285,"c":1,"y":0.48528802020022832,"t":"HUGO:"},{"w":0.068152535756429045,"h":0.013647264854930286,"x":0.089224703599896982,"c":1,"t":"CHANTAL:","y":0.51715892554350285},{"y":0.5654069768665041,"h":0.01453488311292217,"t":"HUGO:","w":0.04854368845621744,"x":0.089320389145677651,"c":1},{"x":0.089238681165894229,"y":0.61458471750885835,"w":0.06812458038330077,"c":1,"h":0.013563122853311849,"t":"CHANTAL:"},{"w":0.04854368845621744,"y":0.64825581370706087,"x":0.089320389145677651,"t":"HUGO:","h":0.01308139551465759,"c":1},{"x":0.091242578297564617,"c":1,"t":"CHANTAL:","y":0.68016129956003546,"w":0.066058533986409498,"h":0.010316935506565095},{"c":1,"w":0.04854368845621744,"t":"HUGO:","x":0.089320389145677651,"y":0.6962209299861305,"h":0.01308139551465759},{"y":0.088662790991442586,"w":0.39029126485188803,"c":1,"x":0.18446601813743627,"h":0.014534883112922281,"t":"Well, I think we'll just have to differ on that issue!"},{"t":"One thing's for certain, though. From what she said, we'll be unpaid assistants in","y":0.10465116288175658,"x":0.18640777237471173,"h":0.015988371899566145,"w":0.63883494059244794,"c":1},{"x":0.18446602091293557,"h":0.014667101589690201,"c":1,"y":0.12209302295946944,"t":"the industry for quite a long time.","w":0.26601941426595049},{"w":0.056009858449300121,"h":0.015546164111556182,"c":1,"x":0.18564056938240611,"t":"Mmm.","y":0.13750507428484293},{"y":0.15406976714625142,"w":0.26407765706380204,"x":0.18446602574139268,"c":1,"t":"I'm prepared for that, aren't you?","h":0.014534884301301343},{"w":0.33426221211751295,"y":0.16974275988680898,"h":0.017914798772223572,"x":0.18626024861684851,"c":1,"t":"Actually, I'm not going to accept that view."},{"x":0.18640776589330452,"t":"Really? But she knows it's the case - and everyone else says the same.","h":0.014680685358255507,"w":0.57475728352864586,"y":0.18749999970702991,"c":1},{"w":0.33805714925130204,"y":0.20213555087062018,"h":0.014470780749930023,"x":0.1882646133015414,"t":"That doesn't mean it has to be true for me.","c":1},{"c":1,"y":0.2194767438899039,"x":0.18640776751046881,"w":0.24077669779459634,"t":"OK. Well - I hope you're right!","h":0.014534884301301565},{"h":0.016096630868881912,"t":"I thought the speaker's account of her first job was fascinating.","y":0.25573116583131217,"w":0.49722254435221347,"c":1,"x":0.18634888245880973},{"h":0.016757005471678132,"t":"Yeah - she admitted she was lucky to get work being a personal dresser for a","y":0.27323253513182144,"x":0.1863485192782853,"w":0.61564931233723952,"c":1},{"x":0.1864077651688795,"t":"musician. She didn't even apply for the job and there she was getting paid to","w":0.60582524617513023,"h":0.014641744548286595,"y":0.29065420559115229,"c":1},{"w":0.17707026163736977,"x":0.1881910521060462,"t":"choose all his clothes.","h":0.014677002571082176,"c":1,"y":0.30517202108071007},{"y":0.32267441831205113,"c":1,"t":"It must have felt amazing - though she said all she was looking for back then","h":0.014534884301301565,"w":0.61165049235026037,"x":0.18446601586112432},{"x":0.18640776779003146,"t":"was experience, not financial reward.","h":0.016021879439784725,"y":0.33862928324691699,"c":1,"w":0.29708737691243492},{"h":0.016199376947040545,"w":0.63883494059244794,"c":1,"x":0.18640777231568714,"t":"Mmm. And then he was so mean, telling her she was more interested in her own","y":0.35451713391224859},{"t":"appearance than his!","y":0.36986059812477345,"x":0.1861465953675441,"w":0.17135944366455078,"h":0.015650790205625653,"c":1},{"t":"But - she did realise he was right about that, which really made me think. I'm","y":0.38660436132616893,"x":0.18640777309146775,"w":0.60776697794596357,"h":0.014641744548286706,"c":1},{"x":0.18834951772511488,"y":0.40249221180832229,"w":0.6368932088216146,"c":1,"h":0.014658950496685419,"t":"always considering my own clothes but now I can see you should be focusing on"},{"t":"your client!","x":0.18397169191268845,"w":0.092266813913981144,"c":1,"y":0.41942070757181626,"h":0.014619985324942797},{"w":0.30679611206054686,"t":"She obviously regretted losing the job.","c":1,"y":0.43604651133294015,"x":0.18640776911280266,"h":0.014534884301301454},{"x":0.18438888724438812,"w":0.62929611206054692,"h":0.019416993280808925,"y":0.44920031101670366,"c":1,"t":"Well, as she said, she should have hidden her negative feelings about him, but"},{"c":1,"t":"she didn't.","w":0.083495146433512385,"x":0.18446601899514756,"y":0.46791277268159726,"h":0.013191878535665835},{"y":0.48255451718636377,"w":0.64660191853841142,"h":0.017445482866043638,"t":"It was really brave the way she picked herself up and took that job in retail. Fancy","x":0.18446603271137671,"c":1},{"y":0.50000000029643377,"h":0.014641744548286595,"w":0.22330095926920573,"c":1,"x":0.1844660251398712,"t":"working in a shop after that!"},{"c":1,"y":0.51588785036593221,"t":"Yeah - well, she recommended we all do it at some point. I guess as a designer","h":0.014641744548286595,"x":0.18640777413448631,"w":0.63300969441731769},{"x":0.18446601245556479,"y":0.53197674427729957,"w":0.62330098470052075,"h":0.015998333488298044,"c":1,"t":"you'd get to find out some useful information, like how big or small the average"},{"h":0.017124043521108745,"c":1,"t":"shopper is.","x":0.18420145523180906,"y":0.5467808410712649,"w":0.093871269226074222},{"t":"I think that's an issue for manufacturers, not designers. However, it would be","x":0.18446602549114025,"y":0.56540697683831065,"w":0.60776697794596357,"h":0.015988371899566145,"c":1},{"w":0.61747573852539062,"x":0.18446601413893471,"y":0.58130841147507162,"h":0.014641744548286595,"t":"useful to know if there's a gap in the market - you know, an item that no one's","c":1},{"c":1,"t":"stocking but that consumers are looking for.","x":0.18446601798776649,"y":0.59738372119962968,"w":0.34951456705729167,"h":0.01453488311292217},{"c":1,"w":0.6252427164713541,"x":0.18640776788052524,"y":0.61337209311749397,"h":0.015988371899566145,"t":"Yeah, people don't give up searching. They also take things back to the store if"},{"x":0.18446601771251228,"t":"they aren t right.","y":0.63081395378119531,"w":0.1339805857340495,"h":0.014668912085417318,"c":1},{"c":1,"h":0.014641744548286706,"y":0.64672897198802426,"t":"Yeah. Imagine you worked in an expensive shop and you found out the garments","w":0.64466018676757808,"x":0.18446602302278658},{"y":0.66279069738159013,"x":0.18446601561997616,"c":1,"t":"sold there were being returned because they... fell apart in the wash!","w":0.55533981323242188,"h":0.014534884301301565},{"h":0.014678874268338693,"y":0.67877906947330646,"c":1,"x":0.18640776071211226,"w":0.39223302205403643,"t":"Yeah, it would be good to know that kind of thing."},{"t":"PART 4","c":1,"w":0.10294953664143881,"y":0.74701979740132562,"h":0.014681335401683593,"x":0.091243678184098939},{"y":0.77601246082216291,"w":0.73786407470703119,"c":1,"t":"For my presentation today I want to tell you about how groups of elephants have been moved","h":0.016199376947040545,"x":0.091262137306678523},{"t":"and settled in new reserves. This is known as translocation and has been carried out in","y":0.78929324080332641,"c":1,"h":0.018791157137196479,"x":0.091164172290986389,"w":0.68757446289062496},{"t":"Malawi in Africa in recent years. The reason this is being done is because of overpopulation","x":0.091262138760429157,"h":0.016028218254493409,"c":1,"w":0.72427185058593757,"y":0.80809968842566748},{"w":0.22330095926920573,"t":"of elephants in some areas.","x":0.091262141524734677,"y":0.82554517107800851,"h":0.013117619689751225,"c":1},{"w":0.71844660441080732,"c":1,"t":"Overpopulation is a good problem to have and not one we tend to hear about very often. In","x":0.091262134584240373,"h":0.015988371899566256,"y":0.8488372093967369},{"t":"Malawi's Majete National Park the elephant population had been wiped out by poachers,","w":0.69902913411458334,"h":0.014534884301301454,"c":1,"x":0.091262131869935204,"y":0.86627906947513744},{"w":0.7339805603027344,"y":0.88224299045843135,"x":0.089320399365165795,"h":0.016012823396011289,"t":"who killed the elephants for their ivory. But in 2003, the park was restocked and effective law","c":1},{"h":0.016199376947040545,"y":0.89813084111920483,"w":0.70485438028971348,"t":"enforcement was introduced. Since then, not a single elephant has been poached. In this","x":0.089320382575258844,"c":1},{"x":0.091262128485798927,"t":"safe environment, the elephant population boomed. Breeding went so well that there were","c":1,"h":0.013170144268285444,"y":0.91424418595979862,"w":0.71067962646484373},{"w":0.35339805603027347,"h":0.014641744548286595,"c":1,"y":0.93021806839047672,"t":"more elephants than the park could support.","x":0.089320391363504073},{"x":0.089320388915986981,"y":0.95784883709005486,"w":0.038834950129191081,"h":0.01308139551465759,"c":1,"t":"102"},{"t":"Q26","y":0.15406976732261302,"w":0.036893202463785801,"x":0.85436893265699609,"h":0.01308139551465759,"c":1},{"x":0.85399161383795563,"h":0.014138255609530193,"t":"Q27\/28","y":0.35335973964377509,"w":0.062885716756184817,"c":1},{"w":0.062566223144531197,"c":1,"x":0.8541537816101008,"t":"Q27\/28","y":0.44998649259426227,"h":0.014271200780185178},{"w":0.063414332071940138,"t":"Q29\/30","y":0.56285292487783467,"c":1,"x":0.8537095667047534,"h":0.015981405620634326},{"w":0.062743657430013089,"t":"Q29\/30","h":0.014207365802515359,"x":0.85404800719431551,"y":0.64519334053695254,"c":1}]}