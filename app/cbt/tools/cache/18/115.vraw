{"h":3209,"lines":[{"c":1,"t":"Audioscripts","w":0.11858328501383462,"h":0.016563030492479536,"x":0.091193794282266413,"y":0.043317321948022403},{"x":0.4115844441648443,"y":0.091354037271071942,"w":0.10110295613606768,"c":1,"h":0.017873320772640477,"t":"TEST 4"},{"x":0.091262137712801755,"t":"PART 1","y":0.15406976715689491,"h":0.017581322928455378,"c":1,"w":0.10291261672973631},{"x":0.091185438728426077,"t":"JULIE:","y":0.18873909636975317,"w":0.042871840794881183,"h":0.0091497141995534603,"c":1},{"x":0.091262136811082972,"y":0.20348837184659563,"w":0.044660193125406894,"h":0.01308139551465759,"t":"GREG:","c":1},{"t":"JULIE:","x":0.089320389189723723,"y":0.21947674393961891,"c":1,"w":0.044660193125406908,"h":0.013081395514657479},{"t":"GREG:","x":0.091204140218427196,"h":0.013313608377522046,"c":1,"y":0.23680249809800458,"w":0.046717933019002275},{"h":0.00872093034310506,"t":"JULIE.","y":0.27034883713326474,"w":0.042718445460001628,"x":0.091262136391589574,"c":1},{"h":0.013214129153813259,"x":0.091227427723379287,"t":"GREG:","y":0.28481735389768237,"w":0.044729611078898127,"c":1},{"w":0.042718445460001628,"y":0.30232558110857521,"t":"JULIE:","x":0.089320388828020472,"h":0.010174419129748813,"c":1},{"w":0.044660193125406894,"h":0.010174419129749035,"c":1,"t":"GREG:","x":0.093203883918320407,"y":0.31831395320269951},{"c":1,"t":"JULIE:","w":0.04696149826049803,"y":0.34847121740280795,"h":0.013813378877728932,"x":0.087198862788339188},{"h":0.011886278194059186,"c":1,"y":0.38213825622601472,"x":0.089263158739554122,"w":0.046716400782267242,"t":"GREG:"},{"w":0.040845324198404961,"y":0.4141669760217932,"c":1,"x":0.091227823627802088,"t":"JULIE:","h":0.010328838312737232},{"w":0.046734959284464528,"y":0.42864577143288374,"t":"GREG:","x":0.089253879851567935,"h":0.013347991753218658,"c":1},{"h":0.0088606154064523324,"c":1,"x":0.089295009965125821,"t":"JULIE.","w":0.042769203186035165,"y":0.44760457599663761},{"w":0.044725131988525402,"h":0.011767740932951742,"y":0.46213938515540476,"t":"GREG:","c":1,"x":0.091229667566686767},{"c":1,"x":0.087378641208699911,"w":0.044660193125406908,"h":0.010174419129748813,"t":"JULIE:","y":0.47965116250502526},{"h":0.01308139551465759,"c":1,"t":"GREG:","y":0.51017441839092703,"x":0.08932038909973955,"w":0.046601940790812174},{"h":0.010331973257094451,"y":0.54497936218226484,"x":0.089286978427894154,"c":1,"t":"JULIE.","w":0.042785266240437825},{"t":"GREG:","w":0.046601940790812174,"h":0.01308139551465759,"y":0.55959302304208991,"c":1,"x":0.08932038909973955},{"x":0.087362842123583417,"w":0.046633539199829099,"t":"JULIE:","y":0.60897621960601278,"h":0.011698723433545055,"c":1},{"x":0.091238821064085304,"t":"GREG:","w":0.044706824620564786,"h":0.010289157142520322,"y":0.6249426306048218,"c":1},{"h":0.011627906728013615,"c":1,"y":0.67441860474784243,"t":"JULIE:","x":0.089320388828020472,"w":0.042718445460001628},{"c":1,"x":0.091262136354330989,"w":0.044660193125406908,"y":0.69040697645851345,"t":"GREG:","h":0.010174419129749035},{"c":1,"y":0.75554297175621909,"t":"JULIE-","x":0.089224043880690121,"w":0.042911135355631499,"h":0.0092628936529902672},{"c":1,"x":0.091262136932442173,"w":0.044660193125406894,"h":0.011627906728013615,"y":0.77034883713986912,"t":"GREG:"},{"t":"GREG:","h":0.00872093034310506,"w":0.044660193125406894,"x":0.091262136349917922,"c":1,"y":0.7877906976001865},{"t":"JULIE:","y":0.81831395346738856,"h":0.011627906728013726,"x":0.087378641665451895,"w":0.044660193125406894,"c":1},{"y":0.83425833094176505,"h":0.013169384299780318,"x":0.089298308427809184,"c":1,"t":"GREG:","w":0.04664610226949055},{"h":0.0096100756683824562,"y":0.85275310168112994,"x":0.089165346800384571,"t":"JULIE:","c":1,"w":0.043028529485066747},{"y":0.86768389023143666,"t":"GREG:","w":0.04665077845255533,"h":0.01317873090227073,"c":1,"x":0.089295970268379043},{"c":1,"w":0.052554559707641585,"x":0.1882858268449546,"t":"Hello?","y":0.18590276517006865,"h":0.01336888821325577},{"c":1,"t":"Oh, hello. Is that Julie Davison?","w":0.25242719014485682,"y":0.20342679117489637,"h":0.014641744548286595,"x":0.18834951162584815},{"x":0.18462724708587616,"t":"Yes.","c":1,"y":0.21836003936812387,"w":0.042230230967203769,"h":0.01643150781173941},{"w":0.63495147705078125,"c":1,"y":0.23546511598556563,"t":"This is Greg Preston from the Employment Agency. We met last week when you","x":0.18640775647616106,"h":0.014534884301301565},{"w":0.29320388793945318,"t":"came in to enquire about office work.","y":0.25140186925033237,"h":0.013133014548233346,"c":1,"x":0.18834951226030786},{"y":0.2672897194872681,"t":"Oh, that's right.","w":0.12038834889729821,"x":0.18834951476582573,"h":0.016199376947040434,"c":1},{"h":0.015988371899566256,"c":1,"y":0.28343023265037692,"t":"Now we've just had some details come in of a job which might interest you.","x":0.18640777645435747,"w":0.59611648559570318},{"h":0.01453488311292217,"c":1,"t":"OK.","y":0.29941860480981797,"x":0.1864077677464408,"w":0.034951454798380549},{"y":0.31373006331405484,"t":"So this is a position for a receptionist - I believe you've done that sort of work","x":0.18631106188545876,"h":0.018783187866210915,"w":0.61379043579101566,"c":1},{"x":0.18628736089398462,"w":0.06237673441569011,"y":0.33106890392695965,"h":0.013734285110996503,"t":"before?","c":1},{"w":0.6368932088216146,"t":"Yes, I have, I worked in a sports centre for a couple of years before I got married","y":0.34735202516795249,"c":1,"h":0.016020067755678324,"x":0.18640776440725934},{"c":1,"w":0.17124851226806639,"x":0.18624176682246271,"y":0.36356769096499186,"h":0.015881172370316499,"t":"and had the children."},{"h":0.014663479409856572,"t":"Right. Well, this job's in Fordham, so not too far away for you, and it's at the","c":1,"y":0.38068535808721693,"x":0.1864077747919371,"w":0.60194173177083332},{"x":0.18640777175979484,"w":0.16504853566487632,"c":1,"y":0.39680232536767113,"h":0.013166522088452037,"t":"medical centre there"},{"x":0.18834951681162618,"w":0.23495145161946615,"y":0.41277258588476862,"h":0.014641744548286706,"c":1,"t":"OK. So where exactly is that?"},{"x":0.18640776145964538,"t":"It's quite near the station, on Chastons Road.","y":0.42866043633988105,"c":1,"w":0.36116505940755211,"h":0.016199376947040434},{"w":0.054545071919759103,"h":0.014906460770936825,"x":0.18631969695240438,"t":"Sorry?","c":1,"y":0.44458165330817589},{"c":1,"y":0.4607476637543515,"t":"Chastons Road - that's C-H-A-S-T-O-N-S.","w":0.33786407470703123,"h":0.014641744548286484,"x":0.18640776837348388},{"t":"OK, thanks. So what would the work involve? Dealing with enquiries from","x":0.18640775627211573,"w":0.57864079793294276,"h":0.016199376947040434,"c":1,"y":0.47663551420931394},{"x":0.18408543509693109,"y":0.49339007266879786,"w":0.076567497253417938,"h":0.01418530116571437,"t":"patients?","c":1},{"t":"Yes, and you'd also be involved in making appointments, whether face to face or","x":0.18640776441613374,"w":0.6368932088216146,"y":0.51017441869874136,"h":0.015993805763506064,"c":1},{"y":0.52616279040247682,"w":0.40194175720214842,"c":1,"x":0.18640776205845044,"h":0.014647178412226514,"t":"on the phone. And rescheduling them if necessary."},{"w":0.2737864176432292,"x":0.18640776189112102,"h":0.016199376947040545,"t":"Fine, that shouldn't be a problem.","c":1,"y":0.54205607471549511},{"t":"And another of your duties would be keeping the centre's database up-to-date.","w":0.6234384155273438,"h":0.017841326633346477,"c":1,"y":0.55777476639634627,"x":0.18439815912216698},{"y":0.57412790706850736,"w":0.6407767232259115,"c":1,"h":0.015988371899566145,"t":"Then you might have other general administrative duties as well, but those would","x":0.18640775489551675},{"t":"be the main ones.","x":0.18426640203549652,"h":0.015110934486270322,"y":0.5911216232848362,"c":1,"w":0.14800690968831379},{"h":0.014534883112922281,"c":1,"t":"OK.","w":0.033009707132975297,"y":0.60755813978697737,"x":0.18640776767484385},{"y":0.62354651133535399,"c":1,"w":0.62524271647135421,"x":0.18640776787671653,"t":"Now when the details came in, I immediately thought of you because one thing.","h":0.014534884301301565},{"y":0.63953488381340662,"c":1,"w":0.62330098470052087,"t":"they do require is someone with experience, and you did mention your work at","h":0.015988371899566145,"x":0.18446601246227828},{"w":0.36699028015136725,"c":1,"t":"the sports centre when you came in to see us.","y":0.65697674409880458,"h":0.013116713550603287,"x":0.18640777242415565},{"c":1,"w":0.56711985270182286,"t":"Yes, in fact I enjoyed that job. Is there anything else they're looking for?","y":0.67002755835144323,"h":0.02033851362091732,"x":0.1843844134777993},{"c":1,"t":"Well, they say it's quite a high-pressure environment, they're always very busy,","x":0.18446602030290232,"w":0.6252427164713541,"y":0.68895348807951673,"h":0.014534884301301454},{"c":1,"x":0.18446601803149976,"w":0.61941747029622396,"t":"and patients are often under stress, so they want someone who can cope with","y":0.70342679136758957,"h":0.016199376947040434},{"w":0.629126230875651,"y":0.72087227441738411,"h":0.014641744548286595,"t":"that and stay calm, and at the same time be confident when interacting with the","c":1,"x":0.18446601067684754},{"c":1,"x":0.18446601959642053,"w":0.056310679117838575,"t":"public.","y":0.73691860488249239,"h":0.014534883112922281},{"w":0.6368932088216146,"h":0.015988371899566145,"x":0.18640776443261492,"c":1,"y":0.75290697683823193,"t":"Well, after dealing with three children all under five, I reckon I can cope with that."},{"t":"I'm sure you can.","y":0.76871242813278307,"x":0.18592261155946271,"w":0.13883536020914711,"h":0.016331164636344542,"c":1},{"h":0.019133481058376201,"c":1,"x":0.18436431356516816,"y":0.78297484862225086,"w":0.60410914103190105,"t":"And then another thing they mention is that they're looking for someone with"},{"w":0.13009708404541012,"h":0.015988371899566145,"x":0.18446602083166388,"c":1,"t":"good IT skills ...","y":0.80087209296010076},{"c":1,"h":0.013150221090821756,"x":0.18446602113766317,"y":0.81831395339092705,"t":"Not a problem.","w":0.12233009338378906},{"w":0.34174756368001302,"y":0.83271028059748464,"c":1,"t":"So you'd be interested in following this up?","h":0.016199376947040434,"x":0.18446602402899392},{"t":"Sure. When would it start?","h":0.014669818224565256,"c":1,"y":0.85015576345424015,"x":0.18446602222243247,"w":0.21165047963460287},{"t":"Well, they're looking for someone from the beginning of next month, but I should","w":0.63495147705078137,"x":0.18446600895033743,"h":0.015988371899566145,"c":1,"y":0.86627906986171077},{"c":1,"x":0.18245129610671179,"w":0.59433364868164062,"h":0.017328703217788677,"t":"tell you that this isn't a permanent job, it's temporary, so the contract would","y":0.88107761032609677},{"t":"be just to the end of September. But they do say that there could be further","y":0.89636545652146882,"h":0.018971271455473615,"x":0.18436356334594697,"c":1,"w":0.59632807413736977},{"y":0.91463142640812556,"c":1,"x":0.18428037831826502,"w":0.18479967753092449,"t":"opportunities after that.","h":0.015894996191482269},{"y":0.93168604642411146,"w":0.28349515279134119,"c":1,"h":0.013173766448119073,"t":"OK. And what would the hours be?","x":0.18446601573888435},{"w":0.044660193125406908,"h":0.011627906728013615,"t":"JULIE:","c":1,"x":0.087378641553801414,"y":0.93313953489180712},{"h":0.014534883112922281,"c":1,"t":"114","x":0.089320388962281852,"y":0.96075581421474276,"w":0.036893202463785815},{"w":0.02718446731567381,"c":1,"h":0.01453488311292217,"x":0.85436893130244551,"t":"Q1","y":0.31540697698212239},{"t":"Q2","y":0.38081395335514889,"h":0.01308139551465759,"x":0.8543689312861511,"c":1,"w":0.02718446731567381},{"w":0.027184467315673921,"c":1,"y":0.42877906963002599,"x":0.85436893129361935,"t":"Q3","h":0.013081395514657479},{"t":"Q4","y":0.51017441847142797,"x":0.85242718372827198,"w":0.02718446731567381,"h":0.013081395514657479,"c":1},{"w":0.029126211802164681,"x":0.85242718526396632,"t":"Q5","y":0.55813953475049771,"h":0.01308139551465759,"c":1},{"x":0.85242718372827198,"w":0.02718446731567381,"y":0.62354651149468376,"t":"Q6","h":0.01308139551465759,"c":1},{"t":"Q7","x":0.85436893301899908,"y":0.71947674434470166,"h":0.014534883112922281,"c":1,"w":0.027184464136759456},{"y":0.88226744172724181,"t":"Q8","w":0.02718446731567381,"h":0.01308139551465759,"c":1,"x":0.85242718372827198}],"w":2400}