{"lines":[{"x":0.097037803527954131,"w":0.060293324788411456,"h":0.013338146625649583,"t":"Test 3","c":1,"y":0.043476275205150405},{"x":0.097087379099227794,"y":0.093023256109791785,"w":0.17669902801513673,"h":0.014534883112922281,"c":1,"t":"Questions 21-23"},{"h":0.018895348284474811,"t":"Choose the correct letter, A, B, C or D.","c":1,"y":0.13226744213166974,"w":0.37087379455566405,"x":0.097087374467618628},{"w":0.57475728352864575,"t":"Write the correct letter in boxes 21-23 on your answer sheet.","x":0.097087377695577529,"y":0.16853582546875101,"h":0.017510686262374398,"c":1},{"t":"21 What point does the writer make about the steam car in Paragraph B?","w":0.70679611206054693,"h":0.017502535763559313,"c":1,"x":0.095145633628449772,"y":0.20778816200819272},{"t":"Its success was short-lived.","y":0.2352615810411689,"w":0.26439877827962238,"x":0.18627358904600072,"c":1,"h":0.0191625167276257},{"c":1,"h":0.013081395514657479,"x":0.14368932070176213,"w":0.015533979733785008,"y":0.25726744168411642,"t":"B"},{"w":0.019417475064595541,"x":0.14174757306101399,"c":1,"t":"C","y":0.27470930254883608,"h":0.01453488311292217},{"w":0.017475727399190261,"x":0.14174757309652136,"h":0.014534883112922281,"c":1,"t":"D","y":0.29360465132144586},{"c":1,"t":"Not enough cars were made.","w":0.28155339558919273,"x":0.18640777038016088,"y":0.2557632397147892,"h":0.017492574174827413},{"t":"Car companies found them hard to sell.","y":0.27470930241647484,"c":1,"x":0.18640776105618889,"h":0.015988371899566145,"w":0.37669904073079424},{"y":0.29345794405342462,"w":0.3203883616129557,"h":0.016199376947040434,"x":0.18058251812192017,"c":1,"t":"People found them hard to drive."},{"t":"22 When building their first steam car, the Doble brothers","y":0.32703488399379832,"x":0.095145627262250038,"w":0.55533981323242188,"h":0.018895348284474811,"c":1},{"h":0.016018256665761621,"t":"constructed all the parts themselves.","y":0.3560747664876136,"c":1,"w":0.35145629882812496,"x":0.18640777282380155},{"x":0.18058251678206885,"w":0.51067962646484377,"h":0.017468123272571967,"c":1,"t":"made written notes at each stage of the construction.","y":0.37352024892665936},{"c":1,"x":0.1436893206693369,"w":0.017475727399190261,"y":0.3924418606237714,"t":"C","h":0.014534883112922281},{"t":"needed several attempts to achieve a competitive model.","h":0.015988371899566145,"y":0.39244186054647145,"w":0.54951456705729163,"c":1,"x":0.17864077504678352},{"h":0.018665626264435464,"x":0.1785923306334008,"c":1,"t":"sought the advice of experienced people in the car industry.","y":0.41027180170788702,"w":0.57484970092773446},{"w":0.53592234293619789,"h":0.017537854393694596,"c":1,"y":0.44476744174655103,"x":0.095145624545695667,"t":"23 In order to produce the Model C, the Doble brothers"},{"c":1,"h":0.014534883112922281,"y":0.47383720948520558,"t":"A","w":0.017475727399190261,"x":0.14174757311270261},{"h":0.01308139551465759,"y":0.49273255794761306,"c":1,"x":0.14368932071563179,"t":"B","w":0.015533979733785008},{"h":0.013081395514657479,"y":0.51162790681207537,"w":0.015533979733785008,"c":1,"x":0.14368932071563179,"t":"C"},{"y":0.52906976760051572,"h":0.014534883112922281,"c":1,"x":0.14368932073504928,"w":0.015533979733784981,"t":"D"},{"x":0.18834951111396572,"w":0.33980583190917968,"y":0.47227414333473683,"c":1,"t":"moved production to a different city.","h":0.017551438162259902},{"y":0.49012072702981757,"w":0.22178507486979168,"t":"raised financial capital.","x":0.18624697772566093,"h":0.019015426873418062,"c":1},{"c":1,"w":0.29730501810709636,"t":"employed an additional worker.","y":0.50964090636441672,"x":0.18821529816781701,"h":0.018422248578888523},{"w":0.30924705505371092,"x":0.18814929411665693,"h":0.02100942736474154,"c":1,"y":0.52597203097006573,"t":"abandoned their earlier designs."},{"y":0.95930232570371332,"w":0.025242718060811353,"c":1,"h":0.014534883112922281,"t":"68","x":0.097087378615225414}],"w":2400,"h":3209}