:0.019857179635781708,"x":0.49888218793450934,"c":1,"t":"possess similar cognitive structures to their","w":0.3711476135253905},{"y":0.27470930241299518,"c":1,"h":0.0188953482844747,"w":0.40194173177083337,"t":"struggling classmates. There is also something","x":0.49902913743497168},{"t":"exciting about passing on skills and knowledge","h":0.01748442367601255,"y":0.29501557642971621,"c":1,"w":0.40388348897298182,"x":0.4990291292055114},{"y":0.31395348825711922,"c":1,"t":"that you yourself have just mastered - a certain","w":0.40388348897298171,"h":0.017510686262374398,"x":0.49902912920233672},{"t":"pride and zeal, a certain freshness to the","x":0.4987840642984106,"y":0.32899001480772916,"w":0.34417470296223962,"h":0.02393306839131859,"c":1},{"t":"interaction between 'teacher' and 'learner' that","x":0.49700129788045766,"w":0.40602841695149738,"h":0.019069722731165362,"y":0.34764158023095026,"c":1},{"w":0.38856979370117184,"c":1,"y":0.36914157146528681,"t":"is often lost by the expert for whom the steps","x":0.4969723059240454,"h":0.018734574243658431},{"h":0.017526081715046105,"c":1,"x":0.49902912918895992,"y":0.38808139520714402,"w":0.40388348897298176,"t":"are obvious and the joy of discovery forgotten."},{"t":"Having a variety of different abilities in a","y":0.42585669766255418,"w":0.35533981323242181,"h":0.016003767352237852,"c":1,"x":0.49902912240655839},{"t":"collaborative learning environment provides","c":1,"w":0.38058252970377598,"y":0.44476744174490612,"h":0.017537854393694596,"x":0.49902912340165512},{"w":0.38252426147460927,"h":0.016199376947040434,"y":0.46355140162869513,"c":1,"x":0.49902913127928106,"t":"valuable resources for helping students meet"},{"t":"their learning needs, not to mention improving","x":0.49902912611811395,"y":0.48099688445361555,"w":0.39999999999999997,"h":0.019003115264797477,"c":1},{"t":"their communication and social skills. And","x":0.49887481140950724,"y":0.4989000451702339,"w":0.3653666687011719,"h":0.018881132892359043,"c":1},{"y":0.52024922120511785,"w":0.37475728352864579,"t":"today, more than ever, we need the many to","x":0.49708737753144194,"h":0.017541476573528114,"c":1},{"c":1,"w":0.37087379455566405,"t":"flourish - not suffer at the expense of a few","y":0.53769470385146012,"x":0.49902912203597416,"h":0.017537854393694596},{"w":0.37864077250162753,"x":0.4990291282110072,"h":0.019014887943446079,"c":1,"y":0.55668604678288836,"t":"bright stars. Once a year, I go on a hike with"},{"y":0.57410418309796629,"w":0.35367744445800786,"c":1,"h":0.019423257227627277,"t":"my class, a mixed bunch of students. It is","x":0.49889208882356861},{"x":0.49902912233761898,"t":"challenging. The fittest students realise they","y":0.59302325607957296,"w":0.3747572835286459,"h":0.017568644110658838,"c":1},{"t":"need to encourage the reluctant. There are","c":1,"y":0.61337209311419139,"w":0.35922330220540361,"x":0.499029125488687,"h":0.015988371899566256},{"w":0.38252426147460938,"h":0.016019162210719973,"x":0.49708738371036287,"y":0.6322674419523191,"c":1,"t":"lookouts who report back, and extra items to"},{"h":0.017580417383497027,"c":1,"x":0.49708738003511937,"y":0.64970930220862211,"w":0.33786407470703123,"t":"carry for others. We make it - together."},{"t":"71","w":0.023300970395406018,"y":0.95784883707188639,"h":0.01308139551465759,"x":0.87961165062753977,"c":1}],"h":3209}