{"lines":[{"h":0.016520175161391482,"c":1,"x":0.81323185963331357,"t":"Listening","y":0.036875817377676978,"w":0.090033709208170554},{"t":"PART 2","x":0.06789712632423274,"w":0.10498244603474936,"y":0.085538554902138797,"h":0.017876378472349019,"c":1},{"y":0.087209302206135542,"t":"Questions 11-20","x":0.22912621195396468,"h":0.017463594953590511,"c":1,"w":0.19805825551350911},{"y":0.12645348866783857,"h":0.014668006540458856,"t":"Questions 11-13","w":0.17475728352864583,"x":0.067961163966038976,"c":1},{"x":0.067961161616512361,"c":1,"y":0.16417445480971216,"t":"Choose the correct letter, A, B or C.","h":0.017511591807332638,"w":0.33980583190917968},{"h":0.022461313027830498,"t":"Becoming a volunteer for ACE","x":0.27563783199193165,"y":0.21934200385503799,"c":1,"w":0.41573733011881514},{"y":0.26292834863001158,"t":"11 Why does the speaker apologise about the seats?","h":0.017594907291210271,"c":1,"x":0.066019416144475873,"w":0.51844660441080714},{"c":1,"h":0.01750615794339283,"w":0.18446601867675783,"t":"They are too small.","x":0.15922330124090911,"y":0.29215116267046093},{"y":0.31090342670216997,"w":0.29126213073730473,"t":"There are not enough of them.","x":0.15922330345199942,"c":1,"h":0.016199376947040545},{"c":1,"y":0.3299065419276308,"t":"C Some of them are very close together.","x":0.11262136047775698,"w":0.40970873514811201,"h":0.01602369052970154},{"h":0.016015540030886455,"y":0.36915887847435358,"c":1,"t":"12 What does the speaker say about the age of volunteers?","x":0.066019414663000861,"w":0.580582529703776},{"t":"The age of volunteers is less important than other factors.","x":0.15728154341801059,"h":0.016199376947040545,"y":0.39813084111842056,"c":1,"w":0.54757283528645828},{"y":0.41547133022680927,"w":0.52640487670898439,"x":0.11252590949548638,"c":1,"h":0.019289605565531609,"t":"B Young volunteers are less reliable than older ones."},{"h":0.021061587705047624,"c":1,"y":0.43182591006219195,"w":0.42180910746256511,"t":"C Most volunteers are about 60 years old.","x":0.11435348844048482},{"w":0.45242716471354172,"h":0.017447293955960341,"t":"13 What does the speaker say about training?","c":1,"x":0.066019427257913654,"y":0.47383177591813508},{"t":"It is continuous.","h":0.017056566755348279,"c":1,"y":0.50196700292732765,"x":0.15896732824620807,"w":0.15201276143391929},{"y":0.52180232538947358,"w":0.017475727399190261,"t":"B","x":0.11262135952046962,"c":1,"h":0.01308139551465759},{"c":1,"y":0.54069767460148466,"x":0.11262135952046962,"t":"C","w":0.017475727399190261,"h":0.01453488311292217},{"h":0.018771100861261214,"y":0.52034970236516376,"x":0.15900732853770155,"t":"It is conducted by a manager.","c":1,"w":0.28201499938964847},{"t":"It takes place online.","w":0.20194174448649091,"h":0.016000144578214748,"y":0.54069767450481443,"c":1,"x":0.15533980726365285},{"h":0.014534884301301454,"c":1,"w":0.2155339813232422,"t":"Questions 14 and 15","x":0.067961164581097369,"y":0.59738372063337952},{"t":"Choose TWO letters, A-E.","x":0.06796116210970754,"w":0.25242719014485676,"h":0.017577700748621861,"c":1,"y":0.63662790685922055},{"y":0.67289719613514754,"w":0.81747573852539057,"c":1,"t":"Which TWO issues does the speaker ask the audience to consider before they apply to","x":0.067961159762325182,"h":0.017509780717416046},{"t":"be volunteers?","h":0.016031841028516514,"w":0.14174756368001301,"x":0.066019423227954607,"y":0.69331395342521696,"c":1},{"t":"their financial situation","y":0.72238372101836523,"h":0.015988371899566145,"w":0.21165047963460287,"c":1,"x":0.15922330376657995},{"t":"their level of commitment","x":0.1570768762184393,"y":0.74009403730230428,"c":1,"w":0.24313250223795574,"h":0.018090734749196868},{"t":"their work experience","x":0.15533980659151955,"w":0.2077669906616211,"y":0.75856697839182374,"h":0.017595812241979036,"c":1},{"x":0.15533980408537876,"y":0.77906976772813896,"w":0.1339805857340495,"h":0.014534883112922281,"t":"their ambition","c":1},{"h":0.021088288209148653,"y":0.79440703493957865,"w":0