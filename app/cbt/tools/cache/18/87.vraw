55868944,"t":"... as an activity to help people cope with mental","c":1,"x":0.40958671683828923,"w":0.44686935424804691,"h":0.019305791884567935},{"w":0.75145629882812504,"y":0.8444767440569444,"x":0.10873787024096743,"h":0.017517025671272557,"t":"health issues. Studies have also shown that the availability of green spaces can","c":1},{"w":0.35922330220540366,"y":0.8691588782621108,"t":"prevent physical problems such as 9...","c":1,"h":0.017469028817530319,"x":0.1087378634084547},{"h":0.014534883112922281,"y":0.95784883745274441,"c":1,"x":0.091262136026228624,"w":0.025242718060811353,"t":"86"}],"w":2400}