11627906728013615,"x":0.47378640795538796,"w":0.021359222730000793,"t":"or","y":0.27180232565290652},{"h":0.016111035213292046,"x":0.68541110873164424,"w":0.068012733459472563,"c":1,"t":"2 tasks","y":0.2688340172099748},{"h":0.016007168493538337,"y":0.28705455512859945,"t":"60 minutes","x":0.66778383063775948,"w":0.10326728820800779,"c":1},{"h":0.016342232011931745,"w":0.099130490620930989,"c":1,"y":0.31959051187793786,"t":"Speaking","x":0.4310172788384436},{"h":0.017174916252540307,"c":1,"x":0.40946195900147114,"t":"11 to 14 minutes","y":0.33614527538016037,"w":0.15002583821614585},{"c":1,"w":0.26213592529296881,"x":0.35339805665772284,"h":0.016015540030886455,"y":0.36915887847002371,"t":"Total (Maximum) Test Time"},{"h":0.01453488311292217,"y":0.38808139564130562,"x":0.39417475924772222,"t":"2 hours 44 minutes","c":1,"w":0.17864077250162763},{"c":1,"w":0.34757280985514322,"t":"ACADEMIC TEST FORMAT","h":0.017537854393694596,"y":0.44476744174496319,"x":0.066019420218611111},{"t":"Listening","y":0.48447277740425676,"h":0.016770006934430315,"c":1,"w":0.10383126576741537,"x":0.067600422347691189},{"c":1,"t":"This test consists of four parts, each with ten questions. The first two parts are concerned","x":0.066019425236899659,"y":0.51017441849103351,"w":0.8019417317708335,"h":0.017551438162259902},{"x":0.066019414912992153,"h":0.017539665483611411,"t":"with social needs. The first part is a conversation between two speakers and the second part","y":0.52897196253155532,"w":0.83689320882161455,"c":1},{"w":0.81165049235026054,"h":0.015988371899566145,"y":0.54796511637372736,"c":1,"x":0.06407766634109284,"t":"is a monologue. The final two parts are concerned with situations related to educational or"},{"c":1,"x":0.066019413924360323,"w":0.81165049235026032,"t":"training contexts. The third part is a conversation between up to four people and the fourth","y":0.56686046521102884,"h":0.016005578442154667},{"y":0.58566978173160955,"t":"part is a monologue.","c":1,"x":0.066019419597460383,"h":0.016199376947040434,"w":0.18834950764973957},{"x":0.087310449335400525,"h":0.020387628145307035,"c":1,"w":0.74187438964843744,"y":0.60279423379600705,"t":"A variety of question types is used, including: multiple choice, matching, plan\/map\/"},{"x":0.06597143502881124,"t":"diagram labelling, form completion, note completion, table completion, flowchart completion,","h":0.020388288884148009,"y":0.62062161559936935,"c":1,"w":0.82729471842447921},{"h":0.019019867846527538,"c":1,"y":0.64004032556506585,"w":0.64866261800130198,"t":"summary completion, sentence completion and short-answer questions.","x":0.065950713542510142},{"t":"Candidates hear the recording once only and answer the questions as they listen. Ten","x":0.089320396891355069,"h":0.017512497352291101,"w":0.77087376912434891,"y":0.65981308415133344,"c":1},{"x":0.066019418367437202,"t":"minutes are allowed at the end for candidates to transfer their answers to the answer sheet.","h":0.015988371899566145,"w":0.82524271647135417,"y":0.67877906986223946,"c":1},{"c":1,"w":0.092215620676676435,"y":0.70979308155881127,"t":"Reading","x":0.067503201985968653,"h":0.017379822537906375},{"t":"This test consists of three sections with 40 questions. There are three texts, which are","x":0.066019408436513161,"w":0.77281555175781258,"y":0.73546511616508936,"h":0.017494385264744339,"c":1},{"x":0.064077672486346271,"w":0.81941747029622403,"y":0.7542056073062009,"h":0.017596718381127086,"t":"taken from journals, books, magazines and newspapers. The texts are on topics of general","c":1},{"y":0.77059341273840798,"h":0.020568265350436876,"c":1,"x":0.063931080668714488,"t":"interest. At least one text contains detailed logical argument.","w":0.54594894409179695},{"y":0.79215116267781882,"t":"A variety of question types is used, including: multiple choice, identifying information","h":0.01750615794339283,"w":0.75533981323242183,"c":1,"x":0.087378636973166501},{"h":0.018895348284474811,"c":1,"w":0.80582524617513007,"x":0.066019415626027186,"t":"(True\/False\/Not Given), identifying the writer's views\/claims (Yes\/No\/Not Given), matching","y":0.80959302329598937},{"c":1,"x":0.064077658430222381,"w":0.80970876057942709,"t":"information, matching headings, matching features, matching sentence endings, sentence","y":0.82990654231614602,"h":0.017477178722155817},{"x":0.066019429726244805,"h":0.01751793121623102,"w":0.81553395589192701,"c":1,"t":"completion, summary completion, note completion, table completion, flowchart completion,","y":0.84883720918947769},{"x":0.065941360818540365,"w":0.49143539428710942,"t":"diagram-label completion and short-answer questions.","y":0.86622049726563966,"h":0.019058176438756402,"c":1},{"c":1,"x":0.88543689348487098,"y":0.95348837225167837,"w":0.017475727399190233,"h":0.01453488311292217,"t":"5"}]}