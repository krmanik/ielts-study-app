744161403747,"w":0.054368928273518857},{"t":"DAN:","x":0.069902913549660495,"y":0.46220930207915378,"c":1,"w":0.036893202463785801,"h":0.01308139551465759},{"x":0.071844660436583094,"y":0.50145348829937775,"w":0.052427183787027987,"h":0.00872093034310506,"t":"BREDA:","c":1},{"x":0.069902913239520262,"t":"DAN:","y":0.51744186055718178,"w":0.036893202463785815,"h":0.011627906728013726,"c":1},{"x":0.069852160268591951,"t":"BREDA:","y":0.54784651582149912,"h":0.013318596005068351,"c":1,"w":0.054470437367757168},{"x":0.069902913474596123,"y":0.56540697677165208,"w":0.034951454798380535,"c":1,"h":0.011627906728013726,"t":"DAN:"},{"c":1,"t":"BREDA:","w":0.054432729085286458,"h":0.013230021348994869,"x":0.069871014535821979,"y":0.57986754730271617},{"h":0.01308139551465759,"t":"DAN:","c":1,"x":0.069902913549660495,"y":0.59738372068380485,"w":0.036893202463785801},{"w":0.054368928273518885,"x":0.069902914814696876,"h":0.011627906728013726,"y":0.62936046512436528,"c":1,"t":"BREDA:"},{"y":0.64534883696287471,"x":0.069902913620227214,"c":1,"t":"DAN:","w":0.034951454798380535,"h":0.013081395514657479},{"x":0.069875967156889165,"w":0.054422823588053379,"t":"BREDA:","y":0.66127448227382868,"h":0.013206849142769705,"c":1},{"x":0.071844660853236916,"t":"DAN:","w":0.034951454798380535,"h":0.010174419129748924,"y":0.67877906947309796,"c":1},{"h":0.011938786729473905,"c":1,"y":0.69315851346935697,"t":"BREDA:","x":0.071781240086944892,"w":0.050612277984619133},{"c":1,"x":0.069902913286132407,"w":0.034951454798380535,"y":0.71075581404365396,"t":"DAN:","h":0.011627906728013615},{"c":1,"y":0.72657855579267616,"t":"BREDA:","x":0.069840223057667378,"w":0.054494311014811198,"h":0.011959167432933682},{"c":1,"x":0.069902913290952023,"w":0.052427183787028001,"h":0.011627906728013615,"y":0.78052325582203974,"t":"BREDA:"},{"t":"DAN:","h":0.011627906728013615,"w":0.034951454798380535,"x":0.069902913286132407,"c":1,"y":0.79796511636923528},{"t":"BREDA:","y":0.8123431871773823,"h":0.013395020672094082,"x":0.069835986079057555,"w":0.054502786000569681,"c":1},{"y":0.84738372102039816,"h":0.011627906728013615,"x":0.069902913234126507,"c":1,"t":"DAN.","w":0.036893202463785815},{"h":0.010174417941369751,"y":0.86191860485562322,"x":0.071844661016858546,"t":"BREDA:","c":1,"w":0.05048543612162272},{"y":0.89389534859078168,"t":"DAN:","w":0.034951454798380535,"h":0.01308139551465759,"c":1,"x":0.069902913620227214},{"c":1,"w":0.054471696217854818,"x":0.06985153096744455,"t":"BREDA:","y":0.90976364090455364,"h":0.013321555069302549},{"c":1,"t":"Hello, Wayside Camera Club, Breda speaking.","w":0.37087376912434888,"y":0.18459302315268789,"h":0.016030029938599699,"x":0.16699030017083524},{"x":0.16699028691158163,"t":"Oh, hello, um, my name's Dan and I'd like to join your club.","c":1,"y":0.20058139524571106,"w":0.46796117146809896,"h":0.015988371899566256},{"w":0.61747573852539062,"c":1,"y":0.21802325552147528,"t":"That's great, Dan. We have an application form - would you like to complete it","x":0.16699028598032933,"h":0.014687024767153778},{"w":0.51650487263997391,"t":"over the phone, then you can ask any questions you might have?","y":0.23395638619285664,"h":0.016043613707165116,"c":1,"x":0.16699028203742083},{"y":0.25000000007674306,"t":"Oh, yes, thanks.","w":0.13203882853190108,"x":0.16699029431171936,"h":0.016043613707165116,"c":1},{"h":0.014534884301301565,"c":1,"y":0.26598837179741408,"t":"OK, so what's your family name?","x":0.16699028968433727,"w":0.26213592529296875},{"h":0.014641744548286595,"c":1,"t":"It's Green - Dan Green.","y":0.28193146426136251,"x":0.1669902913226762,"w":0.19223300933837892},{"y":0.29781931492691815,"t":"So - can I take your email address?","x":0.16893204305871856,"h":0.014680685358255507,"w":0.28543688456217448,"c":1},{"x":0.16699029614219721,"w":0.25436892191569005,"y":0.31395348845723592,"h":0.015988371899566145,"t":"Yes, it's dan1068@market.com.","c":1},{"w":0.35939158121744791,"t":"Thanks. And what about your home address?","y":0.32990153221144103,"c":1,"h":0.015422963650427168,"x":0.16885629070804248},{"c":1,"w":0.60776697794596357,"x":0.16699029733071549,"y":0.34735202478144589,"h":0.014641744548286595,"t":"Well, I'm about ten miles away from your club in Peacetown. I live in a house"},{"h":0.015567980377102275,"t":"there.","c":1,"y":0.36281752957851454,"x":0.16431132650607885,"w":0.054015134175618512},{"x":0.16699028746145894,"w":0.35533981323242181,"c":1,"y":0.3793604648220783,"h":0.014534884301301565,"t":"OK, so what's the house number and street?"},{"x":0.16699029421496542,"w":0.20388348897298175,"y":0.39532710264164272,"h":0.014641744548286595,"c":1,"t":"It's 52 Marrowfield Street."},{"x":0.16504854761610857,"t":"Is that M-A double R-O-W-F-I-E-L-D?","y":0.41121495351215309,"c":1,"w":0.30097086588541666,"h":0.013203651214314438},{"w":0.095183277130126948,"h":0.014672963270145889,"x":0.16697146813181432,"t":"That's right.","c":1,"y":0.42871002997717933},{"c":1,"y":0.44325194932094392,"t":"... and that's Peacetown, you said?","w":0.27991958618164064,"h":0.017391853689033288,"x":0.16878537679845484},{"t":"Uhuh.","x":0.16699029153696948,"w":0.050485436121622707,"h":0.014534883112922281,"c":1,"y":0.46075581422288547},{"x":0.16699028820217687,"y":0.49844236751535298,"w":0.5242718505859375,"h":0.016199376947040545,"t":"So how did you hear about our club? Did you look on the internet?","c":1},{"t":"I usually do that, but this time, well, _was talking to a relative the other day and","x":0.16504854458772883,"w":0.6252427164713541,"y":0.51588785075477461,"h":0.016199376947040545,"c":1},{"y":0.53197674409275431,"w":0.12621359507242841,"c":1,"x":0.16893203731507261,"h":0.013194595764730588,"t":"he suggested it."},{"w":0.19805825551350908,"x":0.16699028921820713,"h":0.016199376947040434,"t":"Oh, is he a member too?","c":1,"y":0.54641744534406289},{"t":"He belongs to another club - but he'd heard good things about yours.","w":0.55145629882812497,"h":0.016004672897196204,"c":1,"y":0.56249999993684485,"x":0.16699029726554918},{"y":0.57848837205651538,"w":0.3631067911783854,"c":1,"h":0.015988371899566145,"t":"OK. So what do you hope to get from joining?","x":0.16699029653054831},{"t":"Well, one thing that really interests me is the competitions that you have. I enjoy","x":0.16699029042154792,"h":0.015988371899566145,"y":0.59593023265232214,"c":1,"w":0.63106796264648435},{"h":0.015059464594285421,"c":1,"t":"entering those.","w":0.12271500905354818,"y":0.61156032918793235,"x":0.1668344760066662},{"y":0.62790697703973952,"c":1,"w":0.17087378184000651,"x":0.16699029344892879,"t":"Right. Anything else?","h":0.014534883112922281},{"y":0.64389534888397415,"c":1,"w":0.42330095926920569,"t":"Well, Lalso like to socialise with other photographers.","h":0.015988371899566145,"x":0.16699029576588259},{"w":0.45825241088867186,"c":1,"t":"That's great. So what type of membership would you like?","y":0.65981308435747821,"h":0.016199376947040545,"x":0.16699029931335876},{"c":1,"w":0.17669902801513671,"t":"What are the options?","y":0.67587209329697873,"h":0.014534883112922281,"x":0.16699029198353194},{"c":1,"t":"It's £30 a year for full membership or £20 a year if you're an associate.","x":0.16699030333776327,"w":0.55922327677408856,"y":0.69186046520749422,"h":0.015988371899566256},{"c":1,"x":0.16504854987911813,"w":0.33592231750488288,"t":"Ithink IIl go for the full membership, then.","y":0.70930232528661008,"h":0.014685213677237074},{"w":0.57475728352864586,"y":0.72523364507840937,"h":0.014641744548286706,"t":"That's a good idea because you can't vote in meetings with an associate","c":1,"x":0.16699029017575651},{"c":1,"x":0.16697032424748631,"w":0.106836051940918,"t":"membership.","y":0.7411967781934875,"h":0.014699466503297787},{"w":0.35558392842610681,"h":0.016121195855541837,"x":0.16880707922542398,"c":1,"y":0.77781026556963506,"t":"If I could just find out a bit more about you ..."},{"t":"OK.","y":0.79505813928845614,"x":0.16699029215941888,"w":0.031067959467569989,"h":0.013081395514657479,"c":1},{"h":0.016199376947040434,"c":1,"x":0.16699030525381156,"y":0.81090342650851255,"w":0.59223297119140628,"t":"So you said you wanted to compete - have you ever won any photography"},{"w":0.11316697438557941,"h":0.014940701541128254,"x":0.16674119109226374,"c":1,"t":"competitions?","y":0.82809107388804937},{"c":1,"h":0.014534884301301454,"x":0.16699029708969476,"y":0.84447674389175487,"t":"Not yet, but I have entered three in the past.","w":0.35145629882812496},{"w":0.60582524617513023,"y":0.86043613715194867,"c":1,"t":"Oh, that's interesting. So why don't you tell me something about those? Let's","h":0.016017351120803269,"x":0.16699028943543756},{"t":"start with the first one.","h":0.013682184189650837,"c":1,"y":0.87591951786436051,"x":0.16687852612843723,"w":0.17893843332926429},{"t":"Well, the theme was entitled 'Domestic Life'.","w":0.35145629882812501,"x":0.16699029726647382,"h":0.015988371899566145,"c":1,"y":0.89244186054915564},{"c":1,"x":0.1669902825233395,"w":0.42912623087565105,"h":0.013169238723327092,"t":"I see - so it had to be something related to the home?","y":0.90988372084433577},{"t":"Q1","y":0.39534883707607904,"h":0.01308139551465759,"x":0.83495145640648749,"c":1,"w":0.025242718060811353},{"y":0.51453488358351418,"c":1,"x":0.81747572865574325,"w":0.044660193125406922,"t":"Q2","h":0.01308139551465759},{"y":0.64389534869979326,"w":0.025242718060811242,"c":1,"h":0.01308139551465759,"t":"Q3","x":0.83495145641457813},{"w":0.02718446731567381,"h":0.01308139551465759,"t":"Q4","c":1,"x":0.83300970800882967,"y":0.691860464978863},{"h":0.013081395514657479,"c":1,"t":"Q5","x":0.83300970800882967,"y":0.89244186032770034,"w":0.02718446731567381},{"w":0.036893202463785912,"c":1,"h":0.01453488311292217,"x":0.8660194183215052,"t":"109","y":0.95784883736795756}],"w":2400}