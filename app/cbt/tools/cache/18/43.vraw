{"w":2400,"h":3209,"lines":[{"x":0.093203883552374509,"w":0.060194174448649093,"y":0.04069767469754848,"c":1,"h":0.014534883112922281,"t":"Test 2"},{"t":"Questions 9-13","y":0.088662790594548291,"w":0.16504853566487626,"x":0.09320388927921229,"h":0.016010106761136234,"c":1},{"x":0.093083664415777326,"y":0.12543052402453425,"t":"Do the following statements agree with the information given in Reading Passage 1?","w":0.79445831298828129,"c":1,"h":0.022662956023884684},{"h":0.017510686262374286,"t":"In boxes 9-13 on your answer sheet, write","w":0.40194175720214848,"c":1,"x":0.091262131036883812,"y":0.16853582547045309},{"t":"TRUE","h":0.013418529189635597,"c":1,"x":0.16498146075508838,"y":0.20622678189479982,"w":0.058386592864990233},{"h":0.020235892322575944,"x":0.29891625735249761,"t":"if the statement agrees with the information","w":0.40993748982747391,"c":1,"y":0.20299157468089524},{"c":1,"x":0.16500273059301554,"y":0.22515281171597068,"w":0.069994538625081371,"t":"FALSE","h":0.01335716722910274},{"h":0.015988371899566145,"x":0.2990291293259647,"y":0.22238372101721215,"w":0.40388348897298176,"t":"if the statement contradicts the information","c":1},{"w":0.4349514770507813,"y":0.24267912772227662,"h":0.014641744548286706,"x":0.16504853323031266,"c":1,"t":"NOT GIVEN if there is no information on this"},{"c":1,"x":0.10281220071298273,"t":"9 During the third phase of construction, sandstone slabs were placed in both the","w":0.78273473103841162,"h":0.022489147245698282,"y":0.26845404567003417},{"c":1,"t":"outer areas and the middle of the Stonehenge site.","x":0.13786407887923449,"h":0.015988371899566145,"w":0.48155339558919275,"y":0.29215116288132381},{"y":0.3196261684099696,"h":0.017583134018372193,"c":1,"x":0.091262142712751224,"t":"10 There is scientific proof that the bluestones stood in the same spot until","w":0.72038833618164055},{"h":0.02041896689346645,"c":1,"x":0.13951601471106206,"w":0.24514834086100262,"t":"approximately 1600 BCE.","y":0.34024192396078801},{"w":0.76319869995117195,"x":0.13198386154008887,"h":0.020851624866141005,"y":0.36898773796314677,"t":"John Aubrey's claim about Stonehenge was supported by 20th-century findings.","c":1},{"y":0.39801303523835929,"w":0.79824076334635419,"c":1,"x":0.093118442147460123,"t":"12 Objects discovered at Stonehenge seem to indicate that it was constructed by a","h":0.020931517223702678},{"t":"number of different groups of people.","w":0.35339805603027341,"c":1,"h":0.017458160495460895,"y":0.42149532717496618,"x":0.13980582863534874},{"h":0.0188953482844747,"w":0.82912623087565096,"t":"13 Criticism of Gerald Hawkins' theory about Stonehenge has come mainly from other","x":0.09320387481091387,"y":0.44912790724944962,"c":1},{"h":0.01453488311292217,"t":"astronomers.","y":0.47238372122077843,"x":0.1398058252726799,"w":0.12815533955891925,"c":1},{"w":0.027184467315673824,"h":0.01308139551465759,"c":1,"x":0.095145630322745617,"t":"42","y":0.95784883707188639},{"t":"→ • р. 122","x":0.15922330254358491,"y":0.95638629287705923,"w":0.13009708404541015,"h":0.015997427943339582,"c":1}]}