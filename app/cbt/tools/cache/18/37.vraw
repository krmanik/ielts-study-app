61,"x":0.12815534008681265,"y":0.35029069749806996,"t":"B","c":1},{"w":0.017475727399190261,"t":"C","c":1,"y":0.36773255829819007,"x":0.12815534008681265,"h":0.01453488311292217},{"h":0.014534883112922281,"c":1,"y":0.34883720959053077,"t":"the contradictions in them","x":0.17087378530302194,"w":0.24660194396972657},{"w":0.39029126485188803,"y":0.36760124589382781,"c":1,"t":"the lack of scientific data to support them","x":0.17087378495445138,"h":0.016199376947040545},{"t":"23 According to Michelle, what did the contemporary sources say about the Laki haze?","w":0.83324167887369793,"h":0.022238104514243795,"x":0.081450253386773475,"y":0.39604145825896453,"c":1},{"x":0.1571834766216603,"w":0.43900995890299477,"c":1,"y":0.42567166972641846,"h":0.019793546682577601,"t":"People thought it was similar to ordinary fog."},{"t":"It was associated with health issues.","y":0.44490135707976075,"h":0.017352474367135717,"x":0.17077903895193497,"c":1,"w":0.3497264099121094},{"h":0.013081395514657479,"y":0.46511627889341878,"c":1,"x":0.12815534008681265,"t":"C","w":0.017475727399190261},{"h":0.015995616853422878,"x":0.16893203666161477,"y":0.46510903420764294,"w":0.42135922749837246,"c":1,"t":"It completely blocked out the sun for weeks."},{"w":0.64854370117187499,"t":"24 Adam corrects Michelle when she claims that Benjamin Franklin","x":0.081553392342217798,"y":0.49408099663819516,"h":0.017546910437468033,"c":1},{"c":1,"x":0.17458340995868185,"y":0.52218490028165077,"t":"came to the wrong conclusion about the cause of the haze.","w":0.55757364908854168,"h":0.021272503624081285},{"t":"B","w":0.017475727399190261,"x":0.12815534008681265,"y":0.54360465132144586,"c":1,"h":0.014534883112922281},{"x":0.12815534008681265,"h":0.014534883112922281,"w":0.017475727399190261,"c":1,"y":0.56250000020018331,"t":"C"},{"x":0.17272018847771384,"y":0.5414928728781031,"w":0.446769307454427,"h":0.01923957539496024,"t":"was the first to identify the reason for the haze.","c":1},{"c":1,"t":"supported the opinions of other observers about the haze.","x":0.1727466299735505,"y":0.56086334022959228,"w":0.54963699340820316,"h":0.018161805767879291},{"c":1,"x":0.083495145301701476,"y":0.61619937713655115,"t":"Questions 25 and 26","w":0.21553398132324214,"h":0.016199376947040545},{"w":0.2546085866292318,"y":0.65394925720844821,"x":0.083365347079362898,"h":0.020250835002768475,"t":"Choose TWO letters, A-E.","c":1},{"t":"Which TWO issues following the Laki eruption surprised the students?","x":0.08343187924177764,"w":0.66033360799153651,"h":0.019432868838681561,"y":0.68986936121387021,"c":1},{"c":1,"y":0.7187844005423194,"x":0.17463010508369572,"h":0.018907918365573595,"t":"how widespread the effects were","w":0.31095314025878906},{"w":0.015533979733785008,"h":0.01308139551465759,"x":0.13009708770592301,"y":0.73982558120342701,"c":1,"t":"B"},{"y":0.75290697683159991,"c":1,"h":0.0188953482844747,"t":"c","x":0.13009708772534051,"w":0.015533979733785008},{"h":0.01308139551465759,"w":0.015533979733785008,"t":"D","x":0.13009708769205341,"y":0.77761627889341889,"c":1},{"h":0.019247235093161397,"w":0.31286252339680987,"c":1,"x":0.17464807080935904,"t":"how long-lasting the effects were","y":0.73765271034071189},{"h":0.014534883112922281,"c":1,"y":0.75726744198278306,"t":"the number of deaths it caused","w":0.29320388793945318,"x":0.17475728275357436},{"w":0.46796117146809901,"y":0.77601246081901853,"h":0.016199376947040545,"c":1,"t":"the speed at which the volcanic ash cloud spread","x":0.17281553072928726},{"x":0.1631067919583479,"y":0.79501557603946293,"h":0.016030935483558162,"c":1,"w":0.37087379455566405,"t":"how people ignored the warning signs"},{"x":0.083495145734966483,"w":0.025242718060811367,"h":0.01308139551465759,"c":1,"y":0.96075581381607245,"t":"36"}],"w":2400,"h":3209}