{"lines":[{"h":0.014986193291494754,"x":0.091165786263713189,"c":1,"w":0.060386873881022152,"t":"Test 3","y":0.040472019310439644},{"w":0.105008176167806,"h":0.017964940056251266,"c":1,"x":0.091185232207211864,"t":"PART 2","y":0.088401250885820959},{"x":0.25048543679908858,"t":"Questions 11-20","w":0.20000000000000007,"h":0.017567739159890072,"y":0.088662790578228567,"c":1},{"c":1,"h":0.016018256665761621,"y":0.12790697683344332,"w":0.21359222412109372,"t":"Questions 11 and 12","x":0.09126214027227228},{"w":0.2543689219156901,"y":0.16569767430108095,"x":0.091262140885261786,"t":"Choose TWO letters, A-E.","c":1,"h":0.01747989595122057},{"y":0.20253240302394226,"h":0.020620665743343536,"t":"Which TWO warnings does Dan give about picking mushrooms?","w":0.60797363281249994,"x":0.09116854429478892,"c":1},{"t":"Don't pick more than one variety of mushroom at a time.","y":0.23138926828331563,"x":0.18433784897668298,"w":0.53031504313151046,"h":0.02031531645872886,"c":1},{"x":0.18446601351383043,"c":1,"y":0.25290697683652219,"t":"Don't pick mushrooms near busy roads.","h":0.015988371899566145,"w":0.37669904073079419},{"t":"Don't eat mushrooms given to you.","c":1,"x":0.18446602875259938,"w":0.33009707132975269,"y":0.27034883747492189,"h":0.017501629624411263},{"t":"Don't eat mushrooms while picking them.","y":0.28909657318012316,"w":0.39029126485188803,"c":1,"x":0.1844660181269604,"h":0.017589473427270463},{"c":1,"x":0.18446601644508956,"y":0.30809968840876756,"t":"Don't pick old mushrooms.","h":0.017481707041137384,"w":0.25242719014485671},{"t":"Questions 13 and 14","x":0.093203883028598306,"y":0.3647975078083967,"w":0.21553398132324217,"h":0.016016445575844807,"c":1},{"c":1,"t":"Choose TWO letters, A-E.","w":0.25271906534830729,"x":0.093055564903574653,"y":0.40373823129212638,"h":0.020638189583181199},{"w":0.64488327026367187,"x":0.093108043679208857,"y":0.4418068546512034,"t":"Which TWO ideas about wild mushrooms does Dan say are correct?","h":0.019919239174911119,"c":1}