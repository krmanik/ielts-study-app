{"blocks":[{"l":"header","b":[0.8121,0.0355,0.9033,0.0542],"t":"Listening"},{"l":"paragraph_title","b":[0.0642,0.0838,0.4308,0.1053],"t":"PART 2 Questions 11–20"},{"l":"paragraph_title","b":[0.065,0.1222,0.2475,0.1424],"t":"Questions 11–13"},{"l":"text","b":[0.0646,0.1605,0.4083,0.1798],"t":"Choose the correct letter, A, B or C."},{"l":"paragraph_title","b":[0.2721,0.216,0.6954,0.2409],"t":"Becoming a volunteer for ACE"},{"l":"text","b":[0.0638,0.2599,0.5879,0.2795],"t":"11 Why does the speaker apologise about the seats?"},{"l":"text","b":[0.1092,0.2892,0.3446,0.3076],"t":"A They are too small."},{"l":"text","b":[0.11,0.3082,0.4508,0.326],"t":"B There are not enough of them."},{"l":"text","b":[0.1104,0.3269,0.5229,0.3459],"t":"C Some of them are very close together."},{"l":"paragraph_title","b":[0.0642,0.3652,0.6504,0.3845],"t":"12 What does the speaker say about the age of volunteers?"},{"l":"text","b":[0.11,0.3942,0.7046,0.4123],"t":"A The age of volunteers is less important than other factors."},{"l":"text","b":[0.1104,0.4135,0.6408,0.4319],"t":"B Young volunteers are less reliable than older ones."},{"l":"text","b":[0.11,0.4325,0.5392,0.4509],"t":"C Most volunteers are about 60 years old."},{"l":"paragraph_title","b":[0.0646,0.4702,0.5221,0.4905],"t":"13 What does the speaker say about training?"},{"l":"text","b":[0.11,0.4998,0.3117,0.5182],"t":"A It is continuous."},{"l":"text","b":[0.1104,0.5192,0.4404,0.5372],"t":"B It is conducted by a manager."},{"l":"text","b":[0.1108,0.5382,0.3579,0.5562],"t":"C It takes place online."},{"l":"paragraph_title","b":[0.065,0.593,0.2879,0.6133],"t":"Questions 14 and 15"},{"l":"paragraph_title","b":[0.0646,0.6332,0.3217,0.6525],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.0625,0.67,0.8883,0.7096],"t":"Which TWO issues does the speaker ask the audience to consider before they apply to be volunteers?"},{"l":"text","b":[0.1079,0.7199,0.3783,0.7385],"t":"A their financial situation"},{"l":"text","b":[0.11,0.7389,0.4025,0.7569],"t":"B their level of commitment"},{"l":"text","b":[0.1104,0.7582,0.3692,0.7756],"t":"C their work experience"},{"l":"text","b":[0.1104,0.7772,0.2933,0.7934],"t":"D their ambition"},{"l":"text","b":[0.1104,0.7956,0.3108,0.8136],"t":"E their availability"},{"l":"number","b":[0.8754,0.9529,0.9008,0.9691],"t":"11"}]}