2,"c":1,"t":"MAN:","y":0.5087209302115745},{"y":0.52470930235304747,"h":0.011627906728013615,"t":"WOMAN:","w":0.060194174448649107,"x":0.09126213638408967,"c":1},{"x":0.09126213648880252,"y":0.59011627916183307,"w":0.038834950129191081,"c":1,"h":0.011627906728013615,"t":"MAN:"},{"w":0.06037714004516602,"y":0.63781144489399633,"x":0.091170653838930374,"t":"WOMAN:","h":0.012167807605779069,"c":1},{"x":0.091262136780064645,"c":1,"t":"MAN:","y":0.67005813954296978,"w":0.038834950129191081,"h":0.011627906728013726},{"x":0.091247099724852343,"t":"WOMAN:","y":0.68745643293349135,"w":0.060224246978759777,"h":0.011715041068484089,"c":1},{"c":1,"h":0.011627906728013615,"y":0.71947674422735519,"t":"MAN:","w":0.038834950129191095,"x":0.09126213664136841},{"y":0.75868116122713247,"x":0.093189694514345833,"c":1,"t":"WOMAN:","w":0.058280804951985676,"h":0.011707444948570789},{"h":0.013286804484429759,"y":0.78914148134687601,"c":1,"x":0.091200489681553282,"w":0.038958244323730462,"t":"MAN:"},{"t":"WOMAN:","c":1,"w":0.06218822479248047,"y":0.80516294085519247,"h":0.013220629588094446,"x":0.091235985224462399},{"y":0.82256169844021121,"w":0.038955005009969082,"c":1,"t":"MAN:","h":0.011853347017757643,"x":0.091202109389720218},{"t":"WOMAN:","y":0.83824323946170565,"c":1,"h":0.012467009404737994,"x":0.091121707447403277,"w":0.06047503153483072},{"t":"MAN:","x":0.093095596435442851,"h":0.01062084685233522,"c":1,"w":0.037109778722127285,"y":0.85442794850162473},{"w":0.060272916158040382,"t":"WOMAN:","x":0.091222765630503341,"y":0.87053777910729124,"h":0.013284906642830552,"c":1},{"w":0.42718444824218738,"c":1,"t":"So, I understand you're interested in restaurant work?","x":0.18834952335463437,"h":0.015988371899566256,"y":0.18313953497678237},{"t":"Yes. I've got a bit of experience and I can provide references.","w":0.48543685913085943,"h":0.014641744548286595,"c":1,"x":0.1902912833471915,"y":0.19906542033760655},{"w":0.58462173461914069,"y":0.21429879320150147,"x":0.18827852258934447,"h":0.018145636680341637,"t":"That's good. I can check all that later. Now, Milo's Restaurants have some","c":1},{"h":0.015988371899566145,"y":0.23110465125307234,"w":0.60776697794596346,"t":"vacancies at the moment. They're a really good company to work for. Lots of","x":0.18834952078664866,"c":1},{"x":0.18811875436705697,"t":"benefits.","c":1,"h":0.014360993524949461,"y":0.24814241347434096,"w":0.072411136627197253},{"w":0.60000000000000009,"h":0.017503441308517775,"c":1,"y":0.27906976715689491,"t":"Yes. They've got a very good reputation for looking after staff. For example,","x":0.18834951691262128},{"x":0.18826690456750839,"y":0.29643448125407124,"w":0.39432230631510412,"h":0.01656022829430126,"c":1,"t":"all employees get training - even temporary staff."},{"t":"Oh really? That's quite unusual, isn't it?","y":0.31246105907239419,"w":0.3126213582356771,"x":0.19029126256106271,"h":0.017480801496178922,"c":1},{"x":0.18974855982288441,"h":0.016414058839791967,"t":"Certainly is.","y":0.32797731289080923,"w":0.096277910868326821,"c":1},{"w":0.27961163838704428,"c":1,"x":0.18834952051521572,"t":"And do staff get free uniforms too?","y":0.34447674389066996,"h":0.014534884301301343},{"w":0.62718444824218755,"t":"Um... you just need to wear a white T-shirt and black trousers, it says here. So","y":0.36043613694452603,"c":1,"x":0.18834952335309821,"h":0.017470839907447133},{"w":0.6213592020670573,"t":"I guess not... But another benefit of working for a big company like this is that","h":0.016199376947040545,"x":0.18834952708297617,"y":0.3763239876554243,"c":1},{"c":1,"t":"you can get a discount at any of their restaurants.","x":0.18823372598294033,"h":0.016194447550075486,"y":0.39260362938719739,"w":0.39435076395670576},{"c":1,"x":0.18834951384875448,"y":0.40988372083914659,"t":"Even at weekends?","w":0.15922330220540365,"h":0.013169238723326981},{"c":1,"x":0.18834950874799081,"w":0.30485438028971357,"t":"No, but you'll be working then anyway.","y":0.42585669765997847,"h":0.016003767352237963},{"t":"Oh yes. I suppose so. Most of their restaurants are in the city centre, aren't they?","x":0.19029126747076636,"y":0.44174454832562959,"w":0.63883494059244783,"c":1,"h":0.016199376947040545},{"y":0.45784883729848924,"c":1,"t":"So, easy to get to by bus?","w":0.20970873514811195,"h":0.015988371899566145,"x":0.18834951582400228},{"c":1,"t":"Yes. That's right. But if you have to do a late shift and finish work after midnight,","y":0.47383177553245837,"w":0.6330096944173178,"h":0.015993805763506064,"x":0.18834952161887392},{"x":0.18633563608915002,"y":0.48911051398003624,"h":0.016757230075348906,"t":"the company will pay for you to get a taxi home.","c":1,"w":0.38269373575846355},{"c":1,"y":0.5071651090443402,"x":0.18640776380287566,"h":0.014641744548286595,"t":"I probably won't need one. I think I'd use my bike.","w":0.39611651102701823},{"c":1,"t":"OK. Now, they do have some quite specific requirements for the kind of person","x":0.19029127352957811,"y":0.52180232564737705,"h":0.015988371899566145,"w":0.6213592020670573},{"c":1,"y":0.53924418614058434,"t":"they're looking for. Milo's is a young, dynamic company and they're really keen","w":0.6213592020670573,"x":0.18834952507878294,"h":0.015988371899566145},{"c":1,"w":0.62912623087565112,"y":0.55514018670480558,"t":"on creating a strong team. It's really important that you can fit in and get on well","x":0.18834950587609028,"h":0.016199376947040545},{"y":0.57220023636659678,"w":0.12105532328287757,"c":1,"x":0.18803116824872443,"h":0.014939134068949533,"t":"with everyone."},{"t":"Yeah. I've got no problem with that. It sounds good, actually. The last place I","y":0.5872093024197228,"x":0.1883495048366865,"h":0.015988371899566256,"w":0.60388351440429688,"c":1},{"x":0.18829817499893628,"h":0.017331087700674486,"c":1,"y":0.6031207005680711,"t":"worked for was quite demanding too. We had to make sure we gave a really high","w":0.64282643636067704},{"w":0.12869720458984374,"h":0.015494555179203839,"c":1,"x":0.18808554882245038,"t":"level of service.","y":0.61985184442327945},{"y":0.63662790668422931,"w":0.629126230875651,"x":0.18834950582119858,"c":1,"t":"That's good to hear because that will be equally important at Milo's. I know they","h":0.014534884301301454},{"w":0.31864280700683589,"y":0.65131280018836302,"h":0.017590846599448207,"x":0.18823933692458694,"c":1,"t":"want people who have an eye for detail."},{"x":0.18834951668817326,"t":"That's fine. I'm very used to working in that kind of environment.","h":0.014641744548286595,"w":0.50679611206054687,"y":0.66853582529363487,"c":1},{"w":0.62330098470052087,"y":0.6845930233475146,"h":0.016030029344410224,"x":0.19029125519874118,"t":"Perfect. So the only other thing that's required is good communication skills, so","c":1},{"c":1,"y":0.70028750476251378,"x":0.18824328109937302,"w":0.33802838643391919,"t":"you'll need to have a certificate in English.","h":0.016334120135440999},{"h":0.013803764889916081,"t":"Sure.","y":0.71833347988759444,"w":0.048043874104817696,"c":1,"x":0.18950622569259959},{"h":0.016199376947040434,"t":"OK. Let's have a look at the current job vacancies at Milo's. The first one is in","y":0.75420560735820685,"x":0.19029127904451418,"w":0.60970870971679691,"c":1},{"x":0.1883495194609644,"t":"Wivenhoe Street.","w":0.14174756368001301,"h":0.014686118628005729,"y":0.77165109022496703,"c":1},{"w":0.11084587097167969,"x":0.1902081323780927,"t":"Sorry, where?","h":0.015258325594607935,"c":1,"y":0.78888246509755855},{"y":0.80373831796130202,"c":1,"t":"Wivenhoe. W-I-V-E-N-H-O-E. It's quite central, just off Cork Street.","h":0.016029123799451761,"w":0.5281553649902343,"x":0.1883495018738148},{"x":0.190291263545423,"t":"Oh right.","h":0.014641744548286595,"y":0.8211838007951352,"c":1,"w":0.06990290959676107},{"h":0.015988371899566145,"w":0.33592231750488277,"c":1,"x":0.18834952195144203,"t":"They're looking for a breakfast supervisor.","y":0.83575581385036224},{"t":"That would be OK","y":0.85319767432685556,"x":0.18834951730543811,"w":0.14757280985514323,"h":0.01315746604467849,"c":1},{"t":"So you're probably familiar with the kind of responsibilities involved. Obviously","y":0.86760124585423148,"x":0.1902912582346078,"w":0.61747573852539062,"h":0.016199376947040545,"c":1},{"x":0.18827914514079283,"y":0.88424820478258004,"w":0.62539683024088544,"c":1,"h":0.018322732515424156,"t":"checking that all the portions are correct, etc., and then things like checking all"},{"t":"the procedures for cleaning the equipment are being followed.","x":0.18834951264879105,"w":0.49320388793945313,"c":1,"y":0.90116279077490491,"h":0.015988371899566256},{"w":0.036893202463785815,"t":"104","c":1,"y":0.95784883708791746,"x":0.093203884107912902,"h":0.01308139551465759},{"x":0.85631067886643486,"w":0.02718446731567381,"h":0.01308139551465759,"y":0.29651162776956075,"c":1,"t":"Q1"},{"c":1,"t":"Q2","w":0.027184467315673921,"x":0.85631067887526091,"y":0.39244186070305265,"h":0.01453488311292217},{"y":0.47383720916490957,"w":0.02718446731567381,"h":0.01308139551465759,"t":"Q3","x":0.85631067886643486,"c":1},{"y":0.60319767428118864,"h":0.01308139551465759,"w":0.02718446731567381,"c":1,"x":0.85631067886643486,"t":"Q4"},{"c":1,"y":0.69767441854149603,"t":"Q5","h":0.015988371899566145,"x":0.85631068049922454,"w":0.031067959467570017},{"x":0.85631068063064919,"y":0.77034883736795756,"w":0.027184464136759456,"h":0.01453488311292217,"c":1,"t":"Q6"},{"h":0.01453488311292217,"c":1,"t":"Q7","x":0.85631068056493709,"y":0.88372093039121324,"w":0.029126211802164681}],"w":2400}