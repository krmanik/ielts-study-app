{"h":3209,"w":2400,"lines":[{"t":"ADAM:","c":1,"x":0.071844660971277133,"y":0.090116279299663926,"w":0.044660193125406894,"h":0.010174417941369751},{"y":0.10585469422511307,"x":0.071782687840161091,"c":1,"t":"MICHELLE:","w":0.071968606313069672,"h":0.010674332235461104},{"w":0.048756767908732096,"x":0.06785462566088718,"h":0.012133867495527806,"y":0.15527027553131112,"c":1,"t":"ADAM:"},{"h":0.013081395514657479,"t":"MICHELLE:","c":1,"x":0.056310679018544627,"y":0.18604651153013163,"w":0.087378641764322904},{"c":1,"t":"ADAM:","w":0.046601940790812174,"h":0.011627906728013615,"x":0.067961165798768666,"y":0.25145348838017934},{"x":0.069863361149960668,"y":0.26730401499450773,"w":0.071923764546712232,"c":1,"h":0.011903597632672569,"t":"MICHELLE:"},{"x":0.067961165866729831,"t":"ADAM:","y":0.31540697672320239,"h":0.011627906728013726,"c":1,"w":0.046601940790812174},{"x":0.069861338589510019,"t":"MICHELLE:","y":0.3326825143455403,"w":0.071927808125813814,"h":0.010507064296449098,"c":1},{"x":0.067656425106437323,"y":0.36513958662629453,"w":0.047366971969604488,"h":0.013212249137902088,"t":"ADẠM:","c":1},{"t":"MICHELLE:","x":0.069766403461486826,"y":0.39768767572212183,"c":1,"w":0.072117678324381512,"h":0.0113106950421199},{"t":"ADAM:","x":0.067907581652901255,"h":0.01186966227593822,"c":1,"y":0.41412330837211953,"w":0.046709108352661136},{"h":0.00872093034310506,"t":"MICHELLE:","y":0.46366279063028859,"w":0.071844660441080732,"x":0.069902912398121991,"c":1},{"h":0.010174419129748924,"x":0.069902913044533985,"t":"ADAM:","y":0.49563953459804844,"w":0.044660193125406894,"c":1},{"w":0.071951828002929694,"y":0.5593776298396288,"t":"MICHELLE:","x":0.067907581059014857,"h":0.010605205405166962,"c":1},{"w":0.071844660441080718,"h":0.00872093034310506,"c":1,"t":"MICHELLE:","x":0.067961164828003337,"y":0.63081395342064017},{"c":1,"t":"ADAM:","w":0.046859512329101558,"y":0.66249622275403708,"h":0.012216856769312279,"x":0.065890632091539156},{"h":0.010174419129748924,"c":1,"y":0.6787790694867244,"x":0.067961164859209972,"w":0.071844660441080732,"t":"MICHELLE:"},{"w":0.044788093566894532,"y":0.72658539740022521,"c":1,"x":0.067897215718152618,"t":"ADAM:","h":0.010491995648060248},{"w":0.071844660441080704,"y":0.76017441853726531,"t":"MICHELLE:","x":0.067961164830700194,"h":0.00872093034310506,"c":1},{"h":0.010544727598766568,"c":1,"x":0.065948135469945726,"t":"ADAM:","w":0.046744505564371749,"y":0.79196600827321695},{"w":0.071844660441080746,"h":0.00872093034310506,"y":0.84156976737480194,"t":"MICHELLE:","c":1,"x":0.067961164828003309},{"c":1,"x":0.064077670699075717,"w":0.048543688456217468,"h":0.01308139551465759,"t":"ADAM:","y":0.88808139510240969},{"h":0.011627906728013726,"c":1,"t":"MICHELLE:","y":0.9055232559159575,"x":0.064077669638326187,"w":0.075728155771891278},{"h":0.016698828961619006,"y":0.08655006581876834,"x":0.16881280987150765,"c":1,"t":"I know. That should be the main focus of our presentation.","w":0.46047398885091145},{"w":0.6176069641113282,"y":0.10433932881898556,"x":0.16691871652775575,"t":"The observations made by people at the time were interesting, weren't they? I","h":0.017486324488559579,"c":1},{"t":"mean, they all gave a pretty consistent account of what happened, even if they","w":0.62343048095703124,"h":0.018596110239949892,"y":0.11981418433652791,"c":1,"x":0.16692689521346835},{"y":0.13800623065857942,"w":0.3184466044108073,"x":0.16699028982851549,"h":0.014641744548286484,"t":"didn't always use the same terminology.","c":1},{"w":0.62524271647135421,"c":1,"y":0.15406976773837222,"t":"Yeah. was surprised there were so many weather stations established by that","x":0.16699029192947157,"h":0.014534883112922281},{"h":0.015477454996554729,"t":"time - so, you know, you can see how the weather changed, often by the hour.","c":1,"y":0.1696689528918609,"x":0.16692478129645849,"w":0.62148935953776041},{"y":0.18455587490994607,"w":0.63130371093750004,"c":1,"x":0.16687860115749287,"h":0.01897902206468427,"t":"Right. Writers at the time talked about the Laki haze to describe the volcanic fog"},{"w":0.62931350708007816,"x":0.16495187103035011,"h":0.018436206092715568,"t":"that spread across Europe. They all realised that this wasn't the sort of fog they","c":1,"y":0.20123935057455},{"t":"were used to - and of course this was in pre-industrial times - so they hadn't","w":0.60989334106445314,"h":0.018241074226355569,"c":1,"y":0.2169494124366026,"x":0.16496125434688622},{"y":0.23546511619112831,"w":0.32621358235677084,"c":1,"h":0.013133014548233346,"t":"experienced sulphur-smelling fog before.","x":0.16699029610615534},{"t":"No, that's true.","x":0.16699028985402559,"h":0.016043613707165116,"y":0.25000000007250378,"c":1,"w":0.11844660441080729},{"h":0.018134481364692867,"c":1,"t":"Reports from the period blamed the haze for an increase in headaches,","w":0.57111470540364584,"y":0.26536868226478461,"x":0.1649515960705572},{"y":0.28343023265045142,"c":1,"w":0.62718444824218755,"x":0.16504855243364527,"t":"respiratory issues and asthma attacks. And they all describe how it covered the","h":0.015988371899566145},{"y":0.29937694691045547,"c":1,"w":0.33398058573404943,"t":"sun and made it look a strange red colour.","h":0.014641744548286706,"x":0.16699028957077863},{"w":0.22185226440429687,"c":1,"t":"Must have been very weird.","y":0.31438359602430777,"h":0.016274631060543943,"x":0.16674665968823685},{"c":1,"w":0.62152587890625011,"t":"It's interesting that Benjamin Franklin wrote about the haze. Did you read that?","y":0.33052886673724879,"h":0.017274053223036434,"x":0.16495733438317378},{"c":1,"t":"He was the American ambassador in Paris at the time.","x":0.16688234779435002,"w":0.43132746378580727,"y":0.34525775346870258,"h":0.0167145547837112},{"c":1,"x":0.16498284120058582,"w":0.62925633748372389,"t":"Yeah. At first no one realised that the haze was caused by the volcanic eruption","y":0.36314685162227711,"h":0.016712386585841621},{"w":0.085580972035725927,"y":0.38054632860808857,"h":0.01361664507619309,"t":"in Iceland.","c":1,"x":0.16497650416939},{"c":1,"x":0.1649503213575241,"w":0.49923492431640626,"t":"It was Benjamin Franklin who realised that before anyone else.","y":0.39521523369781708,"h":0.016489512601002732},{"w":0.62731018066406241,"h":0.01731182050853497,"x":0.16498662953070758,"c":1,"y":0.4112383287546062,"t":"He's often credited with that, apparently. But a French naturalist beat him to it -"},{"t":"I can't remember his name. I'd have to look it up. Then other naturalists had the","y":0.42866043615916549,"x":0.16699029988499481,"w":0.62718444824218744,"h":0.013200029034480809,"c":1},{"h":0.01453488311292217,"c":1,"x":0.16504854468574165,"y":0.44476744215754782,"w":0.35339805603027347,"t":"same idea - all independently of each other."},{"w":0.62922673543294261,"h":0.016651190404208593,"x":0.16499370869819113,"c":1,"t":"Oh right. We should talk about the immediate impact of the eruption, which was","y":0.46071656426911933},{"c":1,"h":0.015992900218547712,"x":0.16504854259611856,"y":0.47819314619331199,"t":"obviously enormous - especially in Iceland, where so many people died.","w":0.57475728352864586},{"w":0.60605158487955735,"y":0.49155654724800546,"c":1,"t":"Mmm. You'd expect that - and the fact that the volcanic ash drifted so swiftly","h":0.018689554279838316,"x":0.16492689689349949},{"t":"- but not that the effects would go on for so long. Or that two years after the","h":0.019168666590040018,"c":1,"y":0.50769679804795143,"x":0.16301168083627318,"w":0.60022557576497393},{"t":"eruption, strange weather events were being reported as far away as North","w":0.59622777303059893,"x":0.16499269026982374,"h":0.016334857524741064,"c":1,"y":0.52603868683158439},{"c":1,"x":0.16489295663764864,"w":0.20809446970621748,"h":0.015929802630177958,"t":"America and North Africa.","y":0.54084329917453433},{"t":"No. I found all that hard to believe too. It must have been terrible - and there was","y":0.5571121511134367,"h":0.017057474677065088,"x":0.16495751564207145,"c":1,"w":0.64096633911132805},{"y":0.5732397175053886,"c":1,"x":0.16498480079835842,"w":0.63701751708984378,"t":"nothing anyone could do about it, even if they knew the ash cloud was coming in","h":0.018416121295679488},{"y":0.58875112675504948,"w":0.11913318634033201,"c":1,"h":0.016103443252706073,"t":"their direction.","x":0.16279844159338011},{"w":0.58074549357096361,"h":0.017993234771063071,"t":"We should run through some of the terrible consequences of the eruption","c":1,"x":0.16303109378609862,"y":0.62751205093548834},{"h":0.018457000352140596,"c":1,"t":"experienced in different countries. There's quite a varied range.","x":0.16299345319637487,"y":0.64305037811374144,"w":0.50317932128906251},{"w":0.53786407470703124,"c":1,"h":0.015988371899566145,"x":0.16310679749564552,"t":"Starting with Iceland, where the impact on farming was devastating.","y":0.66133720939599128},{"t":"Mmm. One of the most dramatic things there was the effect on livestock as they","y":0.67725856720991784,"h":0.014641744548286595,"x":0.16504854281021039,"c":1,"w":0.63106796264648435},{"w":0.61954549153645833,"c":1,"y":0.69274915368098067,"x":0.16304678689146054,"t":"grazed in the fields. They were poisoned because they ate vegetation that had","h":0.017200509781406748},{"t":"been contaminated with fluorine as a result of the volcanic fallout.","y":0.70818061598238924,"x":0.16305024132124429,"w":0.51857315063476572,"h":0.015807342529296831,"c":1},{"x":0.16305270692923576,"w":0.63505477905273433,"t":"That was horrible. In Egypt, the bizarre weather patterns led to a severe drought","y":0.72525852934352653,"h":0.017202608459092383,"c":1},{"x":0.16310678787373528,"t":"and as a result the Nile didn't flood, which meant the crops all failed.","w":0.54174758911132814,"h":0.014641744548286595,"y":0.74267912772309341,"c":1},{"h":0.017321141560872388,"c":1,"y":0.7572192441311193,"t":"It's so far from where the eruption happened and yet the famine there led to more","x":0.16303802980150314,"w":0.64285720825195314},{"c":1,"x":0.16310680884895598,"w":0.52815531412760419,"y":0.77470930203198385,"t":"people dying than any other country. It was worse than the plague.","h":0.014534884301301454},{"c":1,"y":0.78844002960427606,"t":"OK. Then in the UK the mortality rate went up a lot - presumably from respiratory","x":0.16495596052391279,"w":0.64095703124999992,"h":0.018304965057848399},{"c":1,"x":0.16310679546433088,"w":0.60000000000000009,"h":0.014678873674149107,"y":0.80654205623860631,"t":"illnesses. According to one report it was about double the usual number and"},{"t":"included an unusually high percentage of people under the age of 25.","h":0.017292711965020247,"w":0.55164581298828119,"x":0.16107949333233515,"c":1,"y":0.82140734652281033},{"t":"Mmm. I think people will be surprised to hear that the weather in the USA was","y":0.83862772400822216,"h":0.017326535614108796,"x":0.16304096032811469,"w":0.61371810913085934,"c":1},{"y":0.8544816088435736,"h":0.017640451330262263,"x":0.16304234994796238,"c":1,"t":"badly affected too. George Washington even makes a note in his diary that they","w":0.62924931844075516},{"h":0.016199376947040545,"y":0.87196261655681806,"x":0.16116504944501325,"t":"were snowbound until March in Virginia. That was before he became president.","c":1,"w":0.6252427164713541},{"y":0.88808139544089071,"t":"Yes, and there was ice floating down the Mississippi, which was unprecedented.","w":0.63495147705078125,"h":0.015988371899566256,"c":1,"x":0.16116503798911566},{"c":1,"w":0.38446601867675778,"x":0.16116504881174118,"t":"Astonishing, really. Anyway, what do you think ..","y":0.90404984435682745,"h":0.016008295077029833},{"c":1,"t":"Test 2","w":0.060418065388997411,"y":0.040434875215212274,"h":0.015060481846889573,"x":0.84454824829356179},{"x":0.83300970930433649,"t":"Q22","c":1,"y":0.15552325569470604,"w":0.038834950129191026,"h":0.01308139551465759},{"w":0.036893202463785801,"c":1,"y":0.26889534871796195,"t":"Q23","x":0.83300970935602514,"h":0.01308139551465759},{"w":0.036893202463785801,"t":"Q24","y":0.39825581383424091,"h":0.01308139551465759,"c":1,"x":0.83300970935602514},{"y":0.51139688654842896,"t":"Q25\/26","w":0.062307510375976483,"x":0.83292391461755211,"h":0.013543436163311107,"c":1},{"h":0.013465906303619657,"c":1,"y":0.52742402357189877,"t":"Q25\/26","x":0.83293811164613207,"w":0.062279116312662697},{"h":0.013081395514657479,"c":1,"t":"Q27","y":0.67877906964819446,"x":0.83106796182411069,"w":0.034951454798380577},{"y":0.75872093011117314,"t":"Q28","x":0.82912621416441656,"h":0.01308139551465759,"w":0.038834950129191026,"c":1},{"x":0.8291262142103939,"w":0.036893202463785801,"y":0.79215116267145025,"h":0.01308139551465759,"t":"Q29","c":1},{"w":0.036893202463785801,"t":"Q30","y":0.88808139547115506,"c":1,"h":0.014534883112922281,"x":0.82912621422927224},{"c":1,"w":0.040776697794596362,"x":0.86019417527206543,"y":0.9578488374729317,"h":0.014534883112922281,"t":"107"}]}