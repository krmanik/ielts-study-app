{"blocks":[{"l":"header","b":[0.0746,0.0848,0.2558,0.105],"t":"Questions 25–30"},{"l":"header","b":[0.8213,0.0343,0.9113,0.0527],"t":"Listening"},{"l":"text","b":[0.0704,0.1234,0.7475,0.1449],"t":"What comment do the students make about each of the following jobs?"},{"l":"text","b":[0.0617,0.1611,0.7837,0.2004],"t":"Choose SIX answers from the box and write the correct letter, A–G, next to Questions 25–30."},{"l":"paragraph_title","b":[0.4346,0.2322,0.5517,0.2505],"t":"Comments"},{"l":"text","b":[0.2146,0.2605,0.5842,0.2811],"t":"These jobs are likely to be at risk."},{"l":"text","b":[0.2154,0.2889,0.6625,0.3285],"t":"B Their role has become more interesting in recent years."},{"l":"text","b":[0.2167,0.3366,0.7225,0.3761],"t":"C The number of people working in this sector has fallen dramatically."},{"l":"text","b":[0.2171,0.3845,0.6417,0.406],"t":"D This job will require more qualifications."},{"l":"text","b":[0.2171,0.4135,0.77,0.4531],"t":"E Higher disposable income has led to a huge increase in jobs."},{"l":"text","b":[0.2162,0.4609,0.7496,0.5008],"t":"F There is likely to be a significant rise in demand for this service."},{"l":"text","b":[0.2167,0.5089,0.7021,0.5304],"t":"Both employment and productivity have risen."},{"l":"text","b":[0.12,0.5793,0.1808,0.5974],"t":"Jobs"},{"l":"text","b":[0.0742,0.608,0.5146,0.627],"t":"25 Accountants"},{"l":"text","b":[0.0746,0.636,0.5154,0.6563],"t":"26 Hairdressers"},{"l":"text","b":[0.075,0.6647,0.5154,0.6846],"t":"27 Administrative staff"},{"l":"text","b":[0.075,0.694,0.515,0.7136],"t":"28 Agricultural workers"},{"l":"text","b":[0.075,0.7223,0.515,0.742],"t":"29 Care workers"},{"l":"text","b":[0.0762,0.7513,0.515,0.771],"t":"30 Bank clerks"},{"l":"footer_image","b":[0.6204,0.9473,0.8629,0.9713],"t":""},{"l":"number","b":[0.8883,0.9508,0.9158,0.9682],"t":"59"},{"l":"footer","b":[0.7667,0.995,0.8617,1.0],"t":"."}]}