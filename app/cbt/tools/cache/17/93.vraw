{"w":2400,"h":3395,"lines":[{"h":0.008720930389296444,"y":0.046511627815394085,"x":0.7716049391467531,"t":"1718867188","w":0.069958845774332645,"c":0.30000001192092896},{"t":"TEST 2","y":0.095812792078193487,"h":0.017676740990089423,"w":0.096792176564534538,"c":1,"x":0.3991347761478054},{"t":"PART 1","w":0.094650204976399754,"x":0.10082304516612112,"c":1,"h":0.014723203769140158,"y":0.15253239083763559},{"t":"JANE:","w":0.039094648361206061,"x":0.10082304616170899,"y":0.18168604639361807,"c":1,"h":0.0087209303892965551},{"t":"FRANK:","w":0.051440327962239588,"h":0.010174418787512574,"x":0.10082304608403796,"c":1,"y":0.19622093005634067},{"x":0.10082304611432155,"c":1,"t":"JANE:","h":0.008720930389296444,"y":0.23982558128790987,"w":0.039094648361206047},{"x":0.10082304578786638,"w":0.051440327962239574,"c":1,"t":"FRANK:","y":0.2543604650017246,"h":0.010174418787512574},{"h":0.0088823327467775215,"w":0.039166202545166007,"t":"JANE:","x":0.10078726898825285,"y":0.26881464755329887,"c":1},{"y":0.31060204522744406,"x":0.10064692325093189,"c":1,"h":0.011063351086368356,"w":0.049734961191813143,"t":"FRANK:"},{"x":0.1008230461511871,"h":0.010174418787512574,"c":1,"w":0.039094648361206061,"t":"JANE:","y":0.32558139519381646},{"t":"FRANK:","h":0.008720930389296444,"c":1,"x":0.10288065852956263,"w":0.047325102488199877,"y":0.38372093013523045},{"t":"JANE:","y":0.39825581385089448,"h":0.008720930389296444,"x":0.1008230445031451,"c":1,"w":0.039094651540120443},{"t":"FRANK:","x":0.10082304596763705,"y":0.41133720910915073,"c":1,"w":0.049382715225219725,"h":0.010174418787512574},{"c":1,"w":0.039094648361206061,"t":"JANE:","x":0.10082304630979479,"h":0.010174418787512574,"y":0.44040697656796846},{"t":"FRANK:","c":1,"y":0.46934392556307714,"x":0.10077671130981708,"h":0.0089865674399655093,"w":0.049475383758544933},{"x":0.10082304615547379,"y":0.48401162778015805,"t":"JANE:","h":0.008720930389296444,"c":1,"w":0.039094648361206061},{"t":"FRANK:","y":0.49840817481475352,"w":0.05154861768086752,"h":0.010451092175235432,"c":1,"x":0.10076890096150395},{"t":"JANE:","x":0.10078726901397256,"y":0.51300069406482052,"w":0.039166202545166007,"h":0.0088823327467776325,"c":1},{"h":0.010174418787512463,"c":1,"x":0.10082304609109384,"t":"FRANK:","w":0.049382715225219712,"y":0.52616279047906356},{"w":0.041152264277140305,"h":0.010174418787512463,"x":0.10082304471328171,"t":"JANE:","y":0.54215116267100472,"c":1},{"h":0.0087209298276508251,"c":1,"y":0.5697674419757095,"t":"FRANK:","w":0.049382715225219725,"x":0.10082304596763705},{"h":0.0087209298276508251,"w":0.039094648361206061,"x":0.10082304630979479,"t":"JANE:","y":0.59883720943210472,"c":1},{"w":0.051551736195882158,"h":0.0090548747841123767,"t":"FRANK:","c":1,"x":0.10076734204494467,"y":0.61320512065853472},{"c":1,"t":"JANE:","y":0.62790697662449302,"w":0.039094651540120443,"x":0.1008230445031451,"h":0.010174418787512574},{"h":0.008720930389296444,"c":1,"w":0.049382715225219739,"t":"FRANK:","x":0.10082304557669057,"y":0.65697674408785711},{"h":0.008720930389296444,"t":"JANE:","w":0.039094648361206047,"y":0.67151162779953788,"c":1,"x":0.10082304611432155},{"h":0.010174418787512574,"x":0.10082304622826804,"t":"FRANK:","y":0.68459302299480962,"w":0.049382715225219725,"c":1},{"t":"JANE:","x":0.1008230445031451,"w":0.039094651540120443,"y":0.70058139524624319,"h":0.0087209303892965551,"c":1},{"c":1,"x":0.10082304558116363,"t":"FRANK:","w":0.049382715225219712,"y":0.75726744176313743,"h":0.0087209303892965551},{"t":"JANE:","x":0.1008230461511871,"y":0.77180232544852045,"w":0.039094648361206061,"c":1,"h":0.008720930389296444},{"y":0.78621911309760006,"w":0.049465243021647134,"c":1,"x":0.10078178168277031,"h":0.0089571226050351171,"t":"FRANK:"},{"y":0.81976744195390716,"w":0.039094648361206061,"h":0.0087209298276508251,"t":"JANE:","x":0.1008230463698085,"c":1},{"y":0.18021201414098698,"w":0.24074073791503905,"t":"Hello, Jane Fairbanks speaking.","h":0.013101939458588618,"c":1,"x":0.19341563915806639},{"h":0.013250883392226132,"t":"Oh, good morning. My name's Frank Pritchard. I've just retired and moved to","w":0.56790125528971358,"y":0.19464075357608324,"c":1,"x":0.19341562733742157},{"c":1,"h":0.013081395583944611,"w":0.58024693806966154,"x":0.19341562549584562,"y":0.2093023254611277,"t":"Southoe. I'd like to become a volunteer, and I gather you co-ordinate voluntary"},{"t":"work in the village.","x":0.19322932654536951,"c":1,"w":0.14039095560709636,"h":0.013264888588194301,"y":0.22251725070410711},{"w":0.088683662414550779,"x":0.19331248967466796,"y":0.23796676503300074,"t":"That's right.","h":0.012438562368476069,"c":1},{"h":0.011627907185728592,"w":0.21810699462890626,"c":1,"t":"What sort of thing could I do?","x":0.19341563838513537,"y":0.25290697663420902},{"w":0.54949951171875,"h":0.014213227270910456,"c":1,"x":0.19335874434187578,"y":0.26565353553261606,"t":"Well, we need help with the village library. We borrow books from the town"},{"w":0.55349792480468751,"x":0.19135803468270421,"h":0.013081394460653373,"c":1,"t":"library, and individuals also donate them. So, one thing you could do is get","y":0.28052325604002215},{"x":0.19327478234885462,"w":0.40564244588216147,"t":"involved in collecting them - if you've got a car, that is.","y":0.29340816084211441,"h":0.015639548868958908,"c":1},{"t":"Yes, that's no problem.","y":0.3095039400070807,"w":0.17121182759602863,"c":1,"h":0.014734718066643504,"x":0.19316878377842864},{"t":"The times are pretty flexible so we can arrange it to suit you. Another thing is the","x":0.19341563179074464,"w":0.59465021769205728,"y":0.32412790685688742,"h":0.013081395583944611,"c":1},{"t":"records that we keep of the books we're given, and those we borrow and need to","h":0.013250883392226243,"c":1,"y":0.33863368666161375,"w":0.60288065592447915,"x":0.18930041267953224},{"h":0.011778563015312216,"c":1,"x":0.19135802773572247,"t":"return to the town library. It would be very useful to have another person to help","y":0.35306242610743555,"w":0.59053497314453129},{"h":0.011627907185728703,"t":"keep them up to date.","x":0.1934156359633234,"w":0.16460905710856122,"c":1,"y":0.36773255802212268},{"w":0.56790125528971358,"x":0.19341562739666965,"y":0.38221436960965705,"c":1,"t":"Right. I'm used to working on a computer - I presume they're computerised?","h":0.011778563015312105},{"h":0.01140878338134188,"c":1,"t":"Oh yes.","x":0.19291163109104986,"y":0.39714984736472392,"w":0.060496711730956998},{"t":"Is the library purpose-built? I haven't noticed it when I've walked round","w":0.52287846883138023,"y":0.40757855134794285,"c":1,"x":0.19329233952740707,"h":0.016102218515600564},{"y":0.42560095740192283,"t":"the village.","x":0.1930987179458207,"w":0.082896467844645189,"h":0.011338204742180058,"c":1},{"c":1,"t":"No, we simply have the use of a room in the village hall, the West Room. It's on","x":0.19341563272758985,"y":0.43895348825209879,"h":0.013081395583944722,"w":0.5884773763020833},{"c":1,"x":0.19341563786700486,"t":"the left as you go in.","y":0.45347467624667792,"h":0.011778563015312105,"w":0.15226337432861328},{"y":0.46790341568559213,"h":0.011778563015312216,"c":1,"x":0.19341563796839101,"t":"I must go and have a look inside the hall.","w":0.30452674865722662},{"y":0.48255813942231662,"w":0.17489711761474611,"c":1,"x":0.19341563860203484,"h":0.011627907185728592,"t":"Yes, it's a nice building."},{"w":0.59465021769205728,"h":0.011778563015312105,"x":0.19341563178888141,"c":1,"y":0.49705535919184196,"t":"Do you run a lunch club in the village for elderly people? I know a lot of places do."},{"y":0.51148409918359139,"c":1,"t":"Yes, we have a very successful club.","w":0.27366254170735677,"h":0.011778563015312216,"x":0.19341564262049776},{"y":0.52041233098334239,"t":"I could help with transport, if that's of any use.","x":0.19331177145547959,"w":0.34181307474772138,"c":1,"h":0.017620526438467121},{"t":"Ooo definitely. People come to the club from neighbouring villages, and we're","y":0.53906405370203125,"w":0.57212697347005204,"h":0.014955184765783169,"c":1,"x":0.19335596161619303},{"x":0.19341564009406076,"w":0.2345678965250651,"c":1,"t":"always in need of more drivers.","h":0.010174418787512574,"y":0.55523255804257465},{"t":"And does the club have groups that focus on a particular hobby, too? I could get","w":0.59465021769205728,"y":0.56831395336841373,"h":0.013081395583944611,"c":1,"x":0.19341563178615787},{"t":"involved in one or two, particularly if there are any art groups.","y":0.58089143241832575,"w":0.4529544067382813,"x":0.19328521323335773,"h":0.015705998289290202,"c":1},{"x":0.19329712493852,"y":0.59507805227944299,"w":0.46528574625651031,"h":0.015624497888787614,"c":1,"t":"Excellent. I'll find out where we need help and get back to you."},{"y":0.61189634877386145,"w":0.54320988972981765,"h":0.011778563015312105,"t":"Fine. What about help for individual residents. Do you arrange that at all?","c":1,"x":0.19341563116389768},{"y":0.62632508819305888,"w":0.55967076619466138,"x":0.19341564560285235,"h":0.013250883392226132,"t":"Yes, we do it as a one-off. In fact, there's Mrs Carroll. She needs a lift to the","c":1},{"c":1,"y":0.64098837198509084,"t":"hospital next week, and we're struggling to find someone.","w":0.42798355102539065,"x":0.19341563176808976,"h":0.011627907185728592},{"x":0.19341564034742817,"w":0.19135801951090495,"c":1,"h":0.011778563015312105,"y":0.65547703170443783,"t":"When's her appointment?"},{"t":"On Tuesday. It would take the whole morning.","x":0.19135801908808381,"c":1,"y":0.6700581394131101,"w":0.34156379699707029,"h":0.01309851566669662},{"w":0.10905349731445316,"x":0.19341563806919007,"h":0.010174418787512574,"t":"I could do that.","y":0.68459302315460013,"c":1},{"h":0.013250883392226132,"y":0.69758539484064186,"x":0.19341563650017832,"w":0.56378601074218748,"t":"Oh, that would be great. Thank you. And also, next week, we're arranging to","c":1},{"c":1,"t":"have some work done to Mr Selsbury's house betore he moves, as he isn't","y":0.71366279059102899,"x":0.19341562928009656,"w":0.55555557250976562,"h":0.011627907185728592},{"w":0.59066055297851561,"x":0.1933609130468083,"y":0.72520688590737381,"t":"healthy enough to do it himself. We've got some people to decorate his kitchen,","h":0.014646646973662691,"c":1},{"h":0.011778563015312105,"c":1,"x":0.19341564843546166,"y":0.7411660777883694,"t":"but if you could do some weeding in his garden, that would be wonderful.","w":0.54115224202473955},{"y":0.75581395338131863,"h":0.011627907185728703,"t":"OK. I'd enjoy that. And presumably the day and time are flexible.","x":0.19341563241795218,"c":1,"w":0.47942387898763023},{"w":0.5576131693522135,"h":0.013250883392226132,"t":"Oh yes. Just say when would suit you best, and we'll let Mr Selsbury know.","x":0.19341563742733892,"c":1,"y":0.77031802127697557},{"c":1,"x":0.1934156381530388,"h":0.011627907185728592,"t":"Good.","w":0.049382715225219725,"y":0.78488372079514057},{"y":0.81831395336809309,"h":0.013081395583944722,"w":0.59670781453450517,"c":1,"x":0.19341563993439345,"t":"The volunteers group also organises monthly social events, which is a great way"},{"y":0.83421672561964433,"h":0.011778563015312105,"w":0.24074073791503908,"c":1,"x":0.19135802599768642,"t":"to meet other people, of course."},{"y":0.29505813935786906,"c":1,"h":0.013081395583944722,"w":0.024691357612609877,"x":0.8189300412647762,"t":"Q1"},{"y":0.33866279054473258,"w":0.026748971939086874,"x":0.8189300406679737,"h":0.011627907185728592,"c":1,"t":"Q2"},{"w":0.026748971939086874,"x":0.81893004067654707,"y":0.43895348821474667,"t":"Q3","h":0.011627907185728703,"c":1},{"t":"Q4","x":0.81893004067654707,"w":0.026748971939086874,"c":1,"h":0.013081395583944611,"y":0.52470930214856681},{"y":0.58284883706008739,"t":"Q5","w":0.026748971939086874,"h":0.011627907185728703,"c":1,"x":0.81893004067654707},{"t":"Q6","x":0.81893004080000387,"y":0.63953488347256249,"w":0.026748971939086874,"h":0.013081395583944722,"c":1},{"y":0.73982558167592327,"x":0.81687242792943637,"c":1,"h":0.013081394460653373,"t":"Q7","w":0.02880658467610675},{"t":"101","x":0.84773662590209575,"w":0.034979422887166378,"h":0.013081395583944611,"y":0.86773255797837645,"c":1},{"w":0.30618598937988273,"x":0.66992475471958191,"y":0.95318838622914936,"t":"IELTSXpress.com","h":0.03366544698798335,"c":1}]}