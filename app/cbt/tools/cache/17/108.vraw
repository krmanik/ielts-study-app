{"w":2400,"h":3395,"lines":[{"h":0.008720930389296444,"w":0.069958845774332645,"y":0.046511627815394085,"x":0.7716049391467531,"c":0.5,"t":"1718867188"},{"x":0.11498440172267685,"c":1,"y":0.053835978121185457,"h":0.014196644121401425,"t":"Audioscripts","w":0.11360797882080076},{"h":0.0087209303892965551,"y":0.098837209204997833,"c":1,"w":0.055555553436279312,"t":"JEANNE:","x":0.11728395159193371},{"h":0.008920556103242494,"c":1,"t":"THOMAS:","y":0.1132722800732221,"x":0.11725503660037272,"w":0.059728609720865897},{"h":0.0096266749890869807,"c":1,"w":0.056169528961181645,"y":0.14153430055154925,"t":"JEANNE:","x":0.11699301059489405},{"x":0.11728395289737818,"c":1,"w":0.059670778910319008,"y":0.17587209308036067,"t":"THOMAS:","h":0.0087209298276508251},{"w":0.057613169352213542,"h":0.008720930389296444,"x":0.11522633705407752,"c":1,"y":0.20494186036778861,"t":"JEANNE:"},{"w":0.059901822408040373,"y":0.21767383954144148,"c":1,"t":"THOMAS:","x":0.11716843089682383,"h":0.010873250882673213},{"c":1,"t":"JEANNE:","x":0.11522633702723908,"w":0.057613169352213528,"h":0.008720930389296444,"y":0.23401162780964901},{"y":0.2616279067835694,"x":0.11728395249957302,"t":"THOMAS:","w":0.059670778910319022,"h":0.010174418787512463,"c":1},{"h":0.0088853796744374769,"t":"JEANNE:","y":0.30515033327517727,"w":0.055606829325358084,"x":0.11725831307994829,"c":1},{"c":1,"x":0.11712051447975094,"w":0.059997653961181646,"y":0.31926570965152234,"t":"THOMAS:","h":0.011177882990932586},{"h":0.008720930389296444,"t":"JEANNE:","x":0.11728395158690152,"y":0.34883720920578787,"c":1,"w":0.055555553436279298},{"t":"THOMAS:","x":0.11725016421520164,"y":0.36181879939358641,"w":0.05973835627237957,"h":0.010374028775380295,"c":1},{"c":1,"x":0.11522633703552254,"t":"JEANNE:","y":0.39244186037059725,"h":0.008720930389296444,"w":0.057613169352213556},{"y":0.42005813934170888,"h":0.010174418787512574,"t":"THOMAS:","w":0.059670778910319022,"c":1,"x":0.11728395249957302},{"y":0.47819767432127691,"w":0.057613169352213542,"x":0.11522633705407752,"h":0.008720930389296444,"c":1,"t":"JEANNE:"},{"w":0.059670778910319008,"t":"THOMAS:","x":0.11728395264874995,"c":1,"y":0.5058139532697612,"h":0.010174418787512574},{"x":0.11726407700587345,"h":0.0088481577321694038,"w":0.055595302581787118,"c":1,"y":0.52173871181199449,"t":"JEANNE:"},{"y":0.54941860445798796,"w":0.059670778910319022,"c":1,"x":0.11728395249957302,"h":0.010174418787512574,"t":"THOMAS:"},{"t":"JEANNE:","c":1,"w":0.05591134389241538,"y":0.57898932107866818,"h":0.010083961262158048,"x":0.11701795558399254},{"t":"THOMAS:","h":0.010826488265721634,"y":0.59124373247824691,"x":0.11717592041933218,"c":1,"w":0.059886843363444006},{"h":0.0088434444018612446,"t":"JEANNE:","y":0.60749688242864208,"x":0.11726407202725217,"w":0.053537699381510429,"c":1},{"x":0.11725503660037272,"y":0.6365280940267104,"c":1,"h":0.008920556103242494,"w":0.059728609720865897,"t":"THOMAS:"},{"t":"JEANNE:","h":0.011880223124833278,"y":0.6641180278248997,"c":1,"w":0.055660336812337244,"x":0.11723156047624193},{"t":"THOMAS:","x":0.11719604221330684,"h":0.01008844768762307,"c":1,"w":0.060081958770751953,"y":0.6938985336101261},{"c":1,"t":"JEANNE.","w":0.055555553436279312,"x":0.11728395157404141,"y":0.70930232550262962,"h":0.0072674419910803145},{"x":0.11728395204493851,"t":"THOMAS:","w":0.059670778910319008,"y":0.72238372083109925,"h":0.008720930389296444,"c":1},{"c":1,"y":0.73637892786469605,"t":"JEANNE:","x":0.11500328727303677,"w":0.057991517384847008,"h":0.010105088124988448},{"w":0.059859644571940096,"t":"THOMAS:","y":0.76565361265552945,"h":0.0093904490746091751,"x":0.11718951919101434,"c":1},{"t":"JEANNE:","h":0.0090832637252179493,"x":0.1172280853363281,"c":1,"w":0.055667285919189444,"y":0.79487697277242941},{"x":0.11716843089682383,"c":1,"t":"THOMAS:","y":0.80779011861120886,"w":0.059901822408040373,"h":0.010873250882673324},{"h":0.010174418787512574,"x":0.11728395165634595,"t":"JEANNE:","y":0.83720930220023615,"c":1,"w":0.055555553436279298},{"h":0.013081395583944722,"y":0.86773255798110183,"w":0.03497942288716635,"c":1,"x":0.11728395099854647,"t":"116"},{"t":"I'm sorry to hear that.","x":0.20781893087880046,"y":0.097383720817988406,"h":0.011627907185728592,"w":0.16049382527669268,"c":1},{"h":0.011778563015312105,"y":0.1118963487740261,"w":0.59053497314453129,"c":1,"x":0.20370370674194571,"t":"It's OK. I'm over it now and I think it's much better to do a university course and"},{"y":0.12500000022606872,"w":0.53909464518229178,"h":0.013103651354534618,"c":1,"t":"this one has such a variety of sports-related areas. It's going to be good.","x":0.20781893413039038},{"x":0.20987654514494888,"c":1,"h":0.013081395583944722,"t":"Oh, I agree - I chose it because of that.","y":0.13953488359737587,"w":0.29218106587727855},{"c":1,"t":"So Jeanne - have you thought of any ideas for the discussion session next week","w":0.60082305908203126,"h":0.013250883392226132,"y":0.17432273274011079,"x":0.20781892294856855},{"c":1,"t":"on technology and sport?","h":0.01313657726921369,"y":0.18887896087142253,"w":0.18963484446207685,"x":0.2076904318800416},{"t":"We have to cover more than one sport, don't we?","y":0.20200132600333465,"w":0.36641906738281249,"h":0.015752844029798374,"c":1,"x":0.20775953631655908},{"t":"Yeah.","h":0.011627907185728592,"c":1,"w":0.045267489751180001,"y":0.21802325567716152,"x":0.20781892989578632},{"x":0.20781893307496888,"t":"You know - we always think technology is about the future, but we could gather","y":0.23255813941496872,"w":0.59053497314453118,"h":0.013081395583944611,"c":1},{"t":"some ideas about past developments in sport.","c":1,"w":0.34156379699707029,"x":0.20781892446063363,"y":0.24705535918980248,"h":0.011778563015312105},{"y":0.25892871977266518,"w":0.31716807047526047,"c":1,"t":"Look at early types of equipment perhaps?","x":0.20770216412356318,"h":0.015204945217172972},{"w":0.5576131693522135,"h":0.013081395583944722,"x":0.20987654278905685,"t":"Uh, I remember reading something about table tennis bats once - how they","c":1,"y":0.27470930220550227},{"c":1,"t":"ended up being covered with pimpled rubber.","y":0.28916372175836402,"h":0.011778563015312105,"x":0.2078189255812255,"w":0.33539095560709642},{"c":1,"w":0.34567901611328122,"x":0.20987654121589358,"h":0.011627907185728592,"t":"Cos they were just wooden at first, I'd imagine.","y":0.30377906965919865},{"w":0.56995885213216146,"c":1,"x":0.20576131456948465,"t":"Yeah. In about the 1920s, a factory was making rolls of the rubber in bulk for","h":0.01453488398216074,"y":0.31831395335505519},{"t":"something like horse harnesses.","y":0.33274440526446725,"w":0.24279836018880205,"h":0.011778563015312216,"c":1,"x":0.20781892676993144},{"y":0.34717731432642129,"t":"Really!","x":0.20772290234775009,"c":1,"h":0.013494208507739969,"w":0.055747610727945984},{"h":0.01310365135453484,"c":1,"y":0.36189634876062304,"x":0.20576132084697102,"w":0.58436213175455731,"t":"Yeah - and someone realised that it'd make a perfect covering for the wooden"},{"w":0.037037035624186199,"x":0.20576131746911405,"h":0.011627907185728592,"c":1,"y":0.37645348822884106,"t":"bats."},{"c":1,"x":0.20774647415680231,"y":0.38825764405063534,"h":0.014909110726400221,"w":0.57421376546223968,"t":"So what about cricket - that's had a few innovative changes. Maybe the pads"},{"h":0.014587604536184573,"c":1,"x":0.20766685397449541,"t":"they wear on their legs?","y":0.40396255904645417,"w":0.18139668782552082},{"w":0.58655517578125005,"x":0.20774908009618467,"c":1,"t":"I don't think they've changed much but, I'm just looking on the internet ... and it","y":0.4175182695004781,"h":0.014395263366339783},{"h":0.012490460673266091,"t":"says that when the first cricket helmet came in, in 1978, the Australian batsman","y":0.43251329285822981,"c":1,"x":0.20776647961323835,"w":0.58857162475585934},{"t":"who first wore it was booed and jeered by people watching because it was so","w":0.57201644897460935,"x":0.20781893589520906,"h":0.011778563015312105,"y":0.44758539485377036,"c":1},{"w":0.041152264277140305,"h":0.011627907185728703,"t":"ugly!","c":1,"x":0.20576131632965114,"y":0.46366279056088233},{"w":0.56584360758463537,"y":0.47673733779389793,"h":0.011778563015312105,"x":0.20781893681839336,"c":1,"t":"Wow, players have to protect themselves from getting hurt! I mean everyone"},{"h":0.010306242638398078,"x":0.20781893291908615,"c":1,"t":"wears one now.","y":0.49263839814536503,"w":0.11934155782063804},{"x":0.205761313787861,"y":0.50581395336446822,"w":0.21399177551269533,"c":1,"h":0.013081395583944611,"t":"Mm, unlike the cycle helmet."},{"h":0.013250883392226132,"w":0.58024693806966154,"c":1,"y":0.52031802127744664,"t":"Well, unless you're a professional, but you're right, many ordinary bikers don't","x":0.20576130452484004},{"c":1,"x":0.20781893216042852,"w":0.1111111068725586,"t":"wear a helmet.","h":0.010311378887881917,"y":0.53474676071886618},{"w":0.56378601074218748,"x":0.20576131550589213,"y":0.54796511614555909,"h":0.01453488398216074,"t":"Hey, look at these pictures of original helmet designs. This one looks like an","c":1},{"t":"upside-down bowl!","x":0.20781892736970414,"w":0.1419753138224284,"h":0.011778563015312105,"y":0.56242638386646215,"c":1},{"y":0.57703488358695032,"w":0.44855967203776043,"h":0.0145434440235368,"t":"Yet, the woman's laughing - she's so proud to be wearing it!","c":1,"x":0.20576131614161369},{"h":0.013081395583944611,"y":0.59156976732169053,"w":0.54115224202473966,"t":"It says serious cyclists ended up with wet hair from all the hard exercise.","x":0.20576132743989356,"c":1},{"y":0.60600706735729015,"x":0.20576130640016865,"t":"I guess that's why they have large air vents in them now so that the skin can","w":0.56790125528971358,"h":0.013250883392226132,"c":1},{"w":0.15020576477050779,"h":0.011627907185728592,"t":"breathe more easily.","c":1,"y":0.62063953476846212,"x":0.2078189282400319},{"t":"OK, so we've done helmets. What about golf balls or better still golf clubs -","c":1,"h":0.01309680320910489,"x":0.20781892961912082,"y":0.63515901085940207,"w":0.5576131693522135},{"t":"they've changed a lot.","y":0.64958775028618476,"x":0.20576131676694279,"h":0.013250883392226132,"c":1,"w":0.16666666666666666},{"w":0.56790125528971358,"y":0.66279069753816966,"c":1,"t":"Yeah - I remember my great grandfather telling me that because a club was","x":0.20576130629300016,"h":0.01453488398216074},{"c":1,"w":0.56172836303710938,"x":0.20781894053219996,"t":"made entirely of wood, it would easily break and players had to get another.","y":0.6772673732650184,"h":0.011778563015312105},{"t":"There's no wood at all in them now, is there?","x":0.20987654806782294,"y":0.69186046497828568,"h":0.013086531271782942,"c":1,"w":0.33127571105957032},{"w":0.25308642069498699,"x":0.20781892946732133,"y":0.70784883710000535,"c":1,"t":"No - they're much more powertul.","h":0.011627907185728592},{"x":0.20987654781057752,"y":0.72084805638924287,"c":1,"h":0.011778563015312105,"w":0.30246912638346357,"t":"The same must be true of hockey sticks."},{"c":1,"t":"I don't think so because players still use wooden sticks today. What it does say","x":0.20781893401033774,"y":0.73546511617224253,"h":0.011627907185728703,"w":0.58436213175455731},{"x":0.20576132808008935,"y":0.74999999986665256,"w":0.59259256998697918,"h":0.01453488398216074,"c":1,"t":"here, though, is that when the game started you had to produce a stick yourself."},{"t":"I guess they just weren't being manufactured. So, one more perhaps. What about","w":0.60493825276692703,"y":0.7644287398731211,"h":0.013250883392226132,"c":1,"x":0.20781893939083726},{"x":0.20576131594216931,"h":0.011627907185728592,"c":1,"t":"football?","y":0.77906976731919975,"w":0.067901236216227207},{"w":0.38906425476074225,"h":0.014331931079374693,"x":0.2097937404191155,"y":0.79093437961186719,"c":1,"t":"Well, I know the first balls were made of animal skin."},{"h":0.011778563015312105,"c":1,"x":0.20781893119085548,"w":0.60288065592447915,"t":"Yeah, they covered them with pieces of leather that were stitched together, but ...","y":0.80800942282222754},{"h":0.011627906062437354,"c":1,"w":0.26543207804361979,"y":0.82122093049591316,"x":0.20781894434581677,"t":"the balls let in water when it rained."},{"c":1,"t":"Oh, that would have made them much heavier.","w":0.34773661295572922,"h":0.013250883392226132,"x":0.2098765493682202,"y":0.83568904595791271},{"y":0.31831395334968016,"h":0.011627907185728592,"x":0.83333333394292997,"w":0.037037035624186143,"c":1,"t":"Q25"},{"c":1,"x":0.83333333393687814,"w":0.037037035624186254,"y":0.43313953474289146,"t":"Q26","h":0.011627907185728592},{"x":0.83333333394292997,"w":0.037037035624186143,"y":0.59156976730316857,"h":0.011627907185728592,"t":"Q27","c":1},{"x":0.83539094694119043,"y":0.66279069749145791,"w":0.034979422887166267,"h":0.013081395583944611,"c":1,"t":"Q28"},{"h":0.013081395583944611,"x":0.83333333401689624,"c":1,"t":"Q29","w":0.037037035624186254,"y":0.74854651143767881},{"h":0.035152653221247165,"t":"IELTSXpress.com","x":0.66984496081179823,"y":0.95314993691982619,"w":0.30619837443033859,"c":1}]}