{"w":2400,"lines":[{"h":0.008720930389296444,"w":0.069958845774332645,"x":0.7716049391467531,"t":"1718867188","y":0.046511627815394085,"c":0.5},{"h":0.014119819982593929,"c":1,"y":0.053874390191341215,"t":"Audioscripts","w":0.11358988444010416,"x":0.11499344891375264},{"w":0.028806584676106778,"h":0.011627907185728703,"x":0.1152263373327285,"t":"ED:","y":0.097383720709461219,"c":1},{"h":0.0089652069325441008,"c":1,"x":0.1172445789183134,"t":"GEMMA:","w":0.053576685587565107,"y":0.12778483837630028},{"t":"ED:","x":0.1152263373327285,"y":0.15552325559318225,"w":0.028806584676106778,"h":0.011627907185728592,"c":1},{"t":"GEMMA:","y":0.17005813931627278,"w":0.053497943878173831,"h":0.010174418787512574,"c":1,"x":0.11728395033457564},{"x":0.11728395102908602,"y":0.19767441834364685,"t":"ED:","h":0.010174418787512463,"c":1,"w":0.024691357612609863},{"t":"ED:","c":1,"y":0.23255813927387936,"x":0.11728395102908602,"h":0.010174418787512574,"w":0.024691357612609863},{"c":1,"w":0.053497943878173831,"t":"GEMMA:","x":0.11728395033457564,"h":0.010174418787512574,"y":0.24709302303720304},{"t":"ED:","x":0.11728395072979685,"y":0.26308139525049579,"c":1,"w":0.024691357612609863,"h":0.0072674419910803145},{"t":"GEMMA:","y":0.27616279047906356,"h":0.010174418787512463,"x":0.11728395033457564,"c":1,"w":0.053497943878173831},{"t":"ED:","h":0.011627907185728592,"c":1,"x":0.1152263373327285,"w":0.028806584676106778,"y":0.30523255791876358},{"x":0.11516143178532208,"h":0.011941242555004949,"c":1,"w":0.055685367584228526,"t":"GEMMA:","y":0.33269216930587175},{"y":0.36191860443255175,"x":0.11728395092620536,"c":1,"h":0.010174418787512574,"w":0.024691357612609849,"t":"ED:"},{"h":0.012301609007854486,"w":0.055830631256103519,"t":"GEMMA:","x":0.11508879990971499,"y":0.37611663724402833,"c":1},{"x":0.11728395072044405,"w":0.024691357612609863,"c":1,"t":"ED:","y":0.39244186035040984,"h":0.0087209303892965551},{"x":0.11725298216252647,"c":1,"t":"GEMMA:","h":0.0089050625462976374,"y":0.40688467801136152,"w":0.051502265930175789},{"t":"ED:","w":0.024691357612609849,"h":0.010174418787512574,"x":0.11728395092620536,"c":1,"y":0.42005813931627278},{"t":"GEMMA:","w":0.05373013814290363,"x":0.11716785294697725,"y":0.43427940520498687,"c":1,"h":0.010801654541590766},{"t":"ED:","w":0.02674896876017252,"x":0.11728395200537325,"c":1,"h":0.010174418787512574,"y":0.47674418578550726},{"t":"GEMMA:","y":0.49122646578670148,"h":0.011733114649185139,"w":0.055599505106608091,"c":1,"x":0.11520436311082645},{"y":0.52034883699069145,"t":"ED:","x":0.11728395092620536,"w":0.024691357612609849,"c":1,"h":0.010174418787512574},{"t":"GEMMA:","y":0.54888307306549655,"w":0.053886070251464843,"h":0.011245481538267099,"c":1,"x":0.11708988710144551},{"x":0.11522633720432486,"w":0.026748971939086916,"c":1,"t":"ED:","h":0.013081394460653373,"y":0.56250000028057445},{"t":"GEMMA:","w":0.055555553436279298,"y":0.59156976719201948,"h":0.011627907185728481,"c":1,"x":0.11522633894544057},{"t":"ED:","y":0.60610465144336512,"w":0.026748971939086902,"x":0.11522633715288452,"h":0.013081394460653373,"c":1},{"x":0.11522633894544057,"y":0.6497093020757404,"w":0.055555553436279298,"h":0.011627907185728592,"c":1,"t":"GEMMA:"},{"y":0.67877906954883083,"w":0.026748971939086916,"h":0.010174418787512574,"t":"ED:","c":1,"x":0.11728395032160881},{"y":0.69326854986128172,"w":0.053532409667968753,"x":0.11726671730627856,"h":0.010265225656462151,"t":"GEMMA:","c":1},{"c":1,"y":0.72093023282149449,"t":"ED:","w":0.024691357612609863,"x":0.11728395102908602,"h":0.011627906062437243},{"x":0.11728394977284724,"w":0.053497943878173818,"c":1,"h":0.010174418787512574,"y":0.75145348826031355,"t":"GEMMA:"},{"t":"ED:","x":0.11728395072979685,"c":1,"y":0.7659883719553453,"w":0.024691357612609863,"h":0.010174418787512463},{"w":0.055790322621663405,"x":0.11510895417468099,"h":0.013587660727708673,"t":"GEMMA:","y":0.79335151836670126,"c":1},{"h":0.010174418787512574,"y":0.80813953466511013,"x":0.11728395092620536,"w":0.024691357612609849,"t":"ED:","c":1},{"c":1,"t":"And part of that means talking about the emotional impact the performance had","y":0.097383720823693176,"x":0.20781892491480192,"w":0.5884773763020833,"h":0.011627907185728592},{"w":0.21810699462890623,"x":0.20781893052799252,"y":0.1118963487594693,"t":"on us. I think that's important.","h":0.011778563015312105,"c":1},{"h":0.011778563015312105,"c":1,"x":0.20781892585670239,"y":0.12632508820653832,"t":"Yes. And we should definitely mention how well the director handled important","w":0.58230453491210943},{"y":0.13953488359936383,"h":0.013081395583944611,"t":"bits of the play - like when Romeo climbs onto Juliet's balcony.","x":0.20576132146327097,"c":1,"w":0.4691357930501302},{"w":0.31893002827962241,"h":0.011778563015312105,"t":"And the fight between Mercutio and Tybalt.","x":0.2078189363739153,"c":1,"y":0.15547703170686455},{"c":1,"x":0.20781892239235039,"h":0.013081395583944722,"t":"Yes. It would also be interesting to mention the theatre space and how the","w":0.54938273111979163,"y":0.16860465104251166},{"y":0.18027267603351427,"h":0.016001104887298445,"w":0.46322326660156254,"c":1,"x":0.20772559247888922,"t":"director used it but I don't think we'll have space in 800 words."},{"y":0.19758539485190929,"h":0.011778563015312105,"w":0.34156379699707029,"c":1,"x":0.20781892442357588,"t":"No. OK. That all sounds quite straightforward."},{"y":0.23110465144336512,"c":1,"h":0.013081394460653484,"w":0.46913579305013015,"x":0.20987655352637519,"t":"So what about The Emporium Theatre's production of the play?"},{"y":0.24705535919170685,"w":0.56378601074218748,"x":0.20781892867769206,"h":0.011778563015312105,"c":1,"t":"I thought some things worked really well but there were some problems too."},{"w":0.29629628499348953,"x":0.20781893560853643,"y":0.26017441849531397,"t":"Yeah. What about the set, for example?","h":0.011627907185728703,"c":1},{"t":"I think it was visually really stunning. I'd say that was probably the most","x":0.20576132021170054,"w":0.53292180379231768,"c":1,"h":0.013081395583944611,"y":0.2747093022051077},{"y":0.28785513178976396,"t":"memorable thing about this production.","w":0.29239133199055989,"h":0.014513197720261384,"c":1,"x":0.20774349709177689},{"t":"You're right. The set design was really amazing, but actually I have seen similar","x":0.20781893307571161,"y":0.30377906966085078,"w":0.59053497314453118,"h":0.011627907185728592,"c":1},{"y":0.31831395337794732,"x":0.20781893133537541,"c":1,"h":0.011627907185728592,"t":"ideas used in other productions.","w":0.24074073791503905},{"t":"What about the lighting? Some of the scenes were so dimly lit it was quite hard","x":0.20576132901425456,"w":0.5864197285970052,"h":0.013250883392226132,"y":0.33274440525864191,"c":1},{"w":0.50617284138997398,"x":0.20576131581599991,"y":0.36189634877333798,"t":"I didn't dislike it. It helped to change the mood of the quieter scenes.","h":0.011778563015312216,"c":1},{"w":0.15020576477050782,"y":0.37632508819697941,"x":0.20576131499951975,"h":0.011778563015312105,"t":"That's a good point.","c":1},{"t":"What did you think of the costumes?","w":0.27402305603027344,"x":0.20561416366990679,"y":0.38852095646621132,"c":1,"h":0.016224173129096409},{"h":0.015861917861920483,"c":1,"w":0.4466791788736979,"t":"I was a bit surprised by the contemporary dress, I must say.","x":0.20568181649703432,"y":0.40280592719618458},{"h":0.013081395583944611,"t":"Yeah - I think it worked well, but I had assumed it would be more conventional.","w":0.58436213175455731,"y":0.41860465104277811,"c":1,"x":0.20576132084492807},{"h":0.013081395583944611,"x":0.20987655183646267,"t":"Me too. I liked the music at the beginning and I thought the musicians were","y":0.43313953476225064,"w":0.55349792480468751,"c":1},{"t":"brilliant, but I thought they were wasted because the music didn't have much","x":0.2078189195792777,"w":0.56790125528971358,"y":0.44758539485399174,"h":0.011778563015312105,"c":1},{"c":1,"x":0.20781892998590157,"t":"impact in Acts 2 and 3.","w":0.16666666666666669,"y":0.46220930221032253,"h":0.011627907185728703},{"t":"Yes - that was a shame.","x":0.2055054482480429,"y":0.47564113345548464,"w":0.18576849619547525,"c":1,"h":0.015666418558576756},{"y":0.49116607778872201,"w":0.59053497314453118,"c":1,"x":0.2098765462466643,"h":0.011778563015312105,"t":"One problem with this production was that the actors didn't deliver the lines that"},{"y":0.50436046499211851,"w":0.25514404296875004,"h":0.013081395583944722,"t":"well. They were speaking too fast.","x":0.20576131174503848,"c":1},{"y":0.51884570071096847,"w":0.56995885213216146,"t":"It was a problem I agree, but I thought it was because they weren't speaking","h":0.013250883392226132,"c":1,"x":0.20781892952376826},{"h":0.015897862060331169,"t":"loudly enough - especially at key points in the play.","w":0.37878517150878899,"y":0.53211647783422389,"c":1,"x":0.20773762102632096},{"c":1,"h":0.014451005573969167,"w":0.30473785400390629,"x":0.20566011986415322,"y":0.54765557173038826,"t":"actually didn't have a problem with that."},{"t":"It's been an interesting experience watching different versions of Romeo and","x":0.20987653274571566,"c":1,"w":0.56790125528971358,"h":0.011778563015312105,"y":0.56242638387454791},{"w":0.12020409901936849,"x":0.20532026399393435,"y":0.57558389667810672,"t":"Juliet, hasn't it?","h":0.015513528502591245,"c":1},{"h":0.011627907185728703,"w":0.4423868306477865,"c":1,"t":"Definitely. It's made me realise how relevant the play still is.","x":0.20781893025025036,"y":0.59156976733455957},{"w":0.55144032796223963,"h":0.014723203769140158,"c":1,"x":0.20781892606003263,"y":0.60453474685065367,"t":"Right. I mean a lot's changed since Shakespeare's time, but in many ways"},{"w":0.55144032796223963,"x":0.2057613130559173,"h":0.014534883982160851,"c":1,"t":"nothing's changed. There are always disagreements and tension between","y":0.61918604623566376},{"x":0.20576131387391508,"w":0.2139917755126953,"t":"teenagers and their parents.","y":0.635159010849359,"h":0.01309680320910489,"c":1},{"t":"Yes, that's something all young people can relate to - more than the violence and","y":0.64958775029223936,"w":0.60699590047200513,"c":1,"h":0.013250883392226132,"x":0.20576130892002606},{"t":"the extreme emotions in the play.","x":0.20768343579411161,"w":0.24927258809407551,"y":0.66189113085262541,"h":0.014077853257861039,"c":1},{"t":"How did you find watching it in translation?","h":0.016494940812792791,"c":1,"y":0.67473464654442084,"w":0.31729128519694005,"x":0.20966340235538258},{"h":0.013086531271782831,"c":1,"x":0.20987654416838816,"t":"Really interesting. I expected to find it more challenging, but I could follow the","y":0.69186046534234769,"w":0.57201644897460935},{"h":0.011627907185728592,"t":"story pretty well.","x":0.20781892837415294,"w":0.12139918009440104,"c":1,"y":0.70784883709404356},{"w":0.59670781453450528,"x":0.20781893213779823,"y":0.72084805639094107,"c":1,"t":"I stopped worrying about not being able to understand all the words and focused","h":0.011778563015312216},{"h":0.014684615343001806,"c":1,"t":"on the actors' expressions. The ending was pretty powerful.","x":0.20774734252063637,"y":0.73353358406676239,"w":0.44049306233723956},{"t":"Yes. That somehow intensified the emotion for me.","w":0.37860081990559902,"y":0.74999999989185129,"c":1,"x":0.20781893149322375,"h":0.011627907185728592},{"y":0.76442873988731685,"t":"Did you know Shakespeare's been translated into more languages than any","x":0.20987655094613,"w":0.5596707661946615,"h":0.011778563015312216,"c":1},{"c":1,"t":"other writer?","x":0.20781893034327661,"y":0.77906976733802191,"h":0.010174418787512574,"w":0.094650204976399727},{"c":1,"x":0.2077802935980094,"t":"What's the reason for his international appeal, do you think?","y":0.7921238996726222,"h":0.014357274777757278,"w":0.4466164143880208},{"y":0.80800942282215171,"h":0.011778563015312216,"c":1,"x":0.20781892051888776,"t":"I was reading that it's because his plays are about basic themes that people","w":0.5617284138997396},{"y":0.82023128544368562,"w":0.21838750203450519,"c":1,"x":0.20770835986242275,"h":0.014150718356470637,"t":"everywhere are familiar with."},{"w":0.062201595306396462,"h":0.012518197543769816,"x":0.83308612503989277,"c":1,"y":0.096047002642083878,"t":"Q21\/22"},{"y":0.12491243087617221,"c":1,"t":"Q21\/22","w":0.061802323659261083,"h":0.013256533547481131,"x":0.8332963689356353},{"t":"Q23","w":0.037037035624186254,"y":0.27470930218475198,"h":0.011627907185728592,"c":1,"x":0.83333333393687814},{"t":"Q24","h":0.013081395583944722,"w":0.037037035624186143,"c":1,"x":0.83333333394373676,"y":0.36046511611791132},{"x":0.83333333393687814,"y":0.40406976728342736,"w":0.037037035624186254,"h":0.013081395583944722,"c":1,"t":"Q25"},{"x":0.83333333424552014,"w":0.037037035624186143,"c":1,"y":0.44622093051313261,"t":"Q26","h":0.013081394460653373},{"t":"Q27","x":0.83333333393687814,"y":0.50436046495784603,"h":0.013081395583944722,"w":0.037037035624186254,"c":1},{"c":1,"y":0.61918604626326035,"t":"Q28","x":0.83333333416321564,"w":0.037037035624186143,"h":0.013081395583944722},{"x":0.83333333393687814,"h":0.011627907185728592,"y":0.73546511613824039,"w":0.037037035624186254,"c":1,"t":"Q29"},{"h":0.013081395583944722,"t":"104","c":1,"y":0.86773255798110183,"x":0.11522633805210442,"w":0.037037035624186199},{"c":1,"h":0.03375352650564889,"x":0.66991655033568553,"w":0.30612678527832038,"t":"IELTSXpress.com","y":0.95314993796778535}],"h":3395}