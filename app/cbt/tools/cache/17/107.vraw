{"w":2400,"h":3395,"lines":[{"t":"2 1718867188","c":1,"w":0.069958845774332645,"y":0.045053003472280473,"h":0.0088339222614840507,"x":0.76954732599584375},{"y":0.095930232433398155,"w":0.64814814249674479,"c":1,"x":0.10288066130374621,"h":0.013081395583944722,"t":"A year ago, The Portland recognised the need to invest in staff retention. Their first step"},{"x":0.10288066508696762,"h":0.011778563015312105,"w":0.68106994628906259,"c":1,"y":0.11042402841543542,"t":"was to introduce a scheme for recognising talent amongst their employees. The hope is that"},{"w":0.69341562906901044,"t":"organising training for individuals with management potential will encourage them to stay with","x":0.10082304956808429,"c":1,"y":0.12632508819344268,"h":0.013250883392226132},{"y":0.13931802724611886,"w":0.10378636678059897,"x":0.10048872450321833,"h":0.013521549418059609,"c":1,"t":"the business."},{"y":0.16001746537048078,"h":0.015637303409643755,"t":"At Bluewater, managers decided to recognise 50 high achievers from across the company's","w":0.67710820515950521,"c":1,"x":0.1028094684184678},{"c":1,"x":0.10082303609500694,"t":"huge hotel chain. As a reward, they're sent on an all-expenses-paid trip abroad every year.","y":0.17579505310479582,"h":0.011778563015312105,"w":0.67078191121419262},{"t":"Fun is an important element in the trips, but there's also the opportunity to learn something","x":0.1028806664941925,"y":0.190406976637854,"w":0.66872426350911462,"h":0.011627907185728592,"c":1},{"h":0.011627907185728703,"t":"useful. This year's trip included a visit to a brewery, where staff learned about the new beer","x":0.10288065739645134,"y":0.20494186035859829,"c":1,"w":0.67283950805664061},{"c":1,"x":0.10073265534648125,"w":0.25124374389648441,"y":0.21813935195208689,"t":"that would be served in the hotel.","h":0.013029494470926606},{"h":0.013250883392226021,"t":"Pentlow Hotels identified that retention of junior reception staff was an issue. In order to","y":0.23969375740510723,"w":0.64609054565429691,"x":0.10288065334569102,"c":1},{"y":0.25322499797065934,"x":0.10280507492736887,"t":"encourage them to see that working in a hotel could be worthwhile and rewarding, with good","w":0.6812199910481771,"h":0.015193359590671918,"c":1},{"c":1,"t":"prospects, they introduced a management programme. These staff were given additional","x":0.10288065129566708,"w":0.65843622843424487,"h":0.011778563015312105,"y":0.26884570093635318},{"w":0.50011367797851558,"y":0.28305644719007206,"c":1,"t":"responsibilities and the chance to work in various roles in the hotel.","x":0.10075282650702605,"h":0.01350607832694084},{"w":0.67901234944661459,"h":0.013081395583944833,"x":0.10288065733735417,"c":1,"y":0.30377906962566326,"t":"Green Planet wanted to be seen as a caring employer. To make life easier for staff, many of"},{"x":0.10288065554817583,"c":1,"w":0.68518519083658858,"y":0.31976744173968941,"t":"whom had childcare responsibilities, the hotel began issuing vouchers to help cover the cost","h":0.013081395583944611},{"h":0.01517876185854139,"c":1,"w":0.095797106424967457,"y":0.33323768400252451,"t":"of childcare.","x":0.1003008833670246},{"h":0.011778563015312216,"c":1,"t":"Louise Marsh at The Amesbury has one of the best staff retention rates in the business.","y":0.35600706737075538,"x":0.10288066116132967,"w":0.64814814249674479},{"h":0.013081394460653373,"y":0.36918604673769662,"c":1,"w":0.64814814249674479,"t":"Since she joined the company, she has made a huge effort to achieve this by creating a","x":0.1028806706926424},{"x":0.10280088614016071,"c":1,"y":0.38273834561514408,"h":0.015550407841011804,"t":"co-operative and supportive environment. For her, the staff are part of a large family where","w":0.67092213948567714},{"h":0.011778563015312105,"w":0.14609053293863933,"y":0.39958775019124648,"x":0.10288066058829348,"c":1,"t":"everyone is valued."},{"w":0.15637859344482424,"c":1,"x":0.10288066006771142,"t":"OK, now I'd like to ...","h":0.01309851510505089,"y":0.42005813976095241},{"c":1,"x":0.81893004153995586,"y":0.095930232414887628,"h":0.011627907185728592,"w":0.034979422887166378,"t":"Q16"},{"h":0.011627907185728592,"c":1,"x":0.81893004153352589,"t":"Q17","y":0.17587209288242645,"w":0.034979422887166378},{"w":0.034979422887166378,"x":0.81893004153352589,"c":1,"t":"Q18","y":0.23982558123691577,"h":0.013081395583944722},{"h":0.011627907185728592,"t":"Q19","y":0.31976744171963567,"c":1,"x":0.81893004153352589,"w":0.034979422887166378},{"t":"Q20","w":0.034979422887166378,"x":0.81893004153995586,"h":0.011627907185728592,"y":0.37063953474502886,"c":1},{"w":0.096749795277913414,"h":0.014674893256772625,"t":"PART 3","c":1,"x":0.1008020565795732,"y":0.47376720438831099},{"w":0.055779654184977212,"y":0.50108221572950551,"h":0.0094634753655207238,"x":0.10071099620798357,"c":1,"t":"JEANNE:"},{"h":0.010301026073586073,"x":0.10285915482856139,"c":1,"t":"THOMAS:","y":0.51592506827322338,"w":0.05971378962198895},{"x":0.10078401233828335,"y":0.53185094220514584,"w":0.0556336212158203,"c":1,"h":0.0089725341617148402,"t":"JEANNE:"},{"h":0.01198465888716449,"w":0.057755425771077479,"c":1,"y":0.55796115873004215,"t":"THOMAS:","x":0.10280953066483633},{"c":1,"x":0.10080317166119661,"w":0.055595302581787118,"t":"JEANNE:","h":0.0088481577321694038,"y":0.588599176927318},{"w":0.059670778910319008,"x":0.10288066064772113,"y":0.60174418630986648,"h":0.011627906062437354,"t":"THOMAS:","c":1},{"t":"JEANNE:","x":0.1007877793518477,"w":0.05562608718872071,"h":0.01036833256518177,"y":0.63217048486097926,"c":1},{"y":0.65969246804339154,"w":0.061870581309000666,"h":0.012010412586872632,"t":"THOMAS:","c":1,"x":0.10075195235063958},{"h":0.0088639983861269478,"y":0.67434707055563903,"w":0.055600204467773431,"t":"JEANNE:","x":0.1008007207262951,"c":1},{"y":0.68873225027828167,"x":0.10280396121183429,"t":"THOMAS:","w":0.057766564687093111,"h":0.010616894464751225,"c":1},{"w":0.055555553436279298,"h":0.008720930389296444,"t":"JEANNE:","c":1,"y":0.70348837199569558,"x":0.10082304624213947},{"t":"THOMAS:","c":1,"h":0.010304070193017711,"x":0.10285785566637977,"y":0.71795843000183335,"w":0.057658774058024095},{"t":"JEANNE:","y":0.73255813943755599,"x":0.10082304624213947,"h":0.008720930389296444,"c":1,"w":0.055555553436279298},{"w":0.061728394826253252,"y":0.74563953516429538,"c":1,"t":"THOMAS:","x":0.10082304589963056,"h":0.013081394460653373},{"c":1,"w":0.05583659489949544,"x":0.10068252610494197,"t":"JEANNE:","y":0.81791651646923169,"h":0.010969292289095822},{"t":"THOMAS:","x":0.10075518351393602,"y":0.83264644129340382,"h":0.010579210288111818,"c":1,"w":0.059806505839029953},{"w":0.38683128356933594,"x":0.19341563383261595,"y":0.49999999987892974,"c":1,"t":"Hi Thomas, how are you enjoying the course so far?","h":0.013081395583944722},{"x":0.193415635947777,"y":0.51442873986789783,"c":1,"h":0.013250883392226132,"w":0.16460905710856122,"t":"Yeah, I think it's good."},{"c":1,"t":"Remind me - why did you decide to study sports science? Didn't you want to be","x":0.19341564903034908,"y":0.52906976732136046,"h":0.013081395583944722,"w":0.59259256998697918},{"x":0.1934156340014703,"y":0.54358068338803545,"w":0.35802469889322908,"h":0.011778563015312105,"c":1,"t":"a professional athlete when you were at school?"},{"t":"Yeah - that was my goal, and all my classmates assumed I would achieve it; they","w":0.60288065592447926,"y":0.55800942282222754,"h":0.011778563015312105,"c":1,"x":0.19341563900905592},{"x":0.19341563869910222,"h":0.010174418787512463,"c":1,"t":"thought was brilliant.","y":0.57412790687879145,"w":0.1604938252766927},{"w":0.26773147583007817,"h":0.013179724011460503,"x":0.19331174039938928,"y":0.58574370398822717,"c":1,"t":"That must have been a nice feeling."},{"h":0.01309680320910489,"c":1,"x":0.19341562927693104,"w":0.55555557250976562,"t":"Mm, I thought I could win anything. There was no one who could run faster","y":0.60174418592644219},{"h":0.013250883392226243,"c":1,"w":0.54938273111979163,"y":0.63074204924519328,"x":0.19341563021128044,"t":"Exactly - so what happened? Did your mum and dad want you to be more"},{"c":1,"t":"'academic'?","w":0.09053497950236003,"h":0.011627906062437354,"x":0.19135802314319592,"y":0.64389534910056434},{"t":"Not at all. Perhaps they should have pushed me harder, though.","h":0.014543444023536689,"y":0.6584216723829609,"x":0.19135803651831529,"c":1,"w":0.47736623128255207},{"h":0.011778563015312105,"t":"What do you mean?","y":0.67285041239836896,"x":0.19341563603181286,"w":0.15020576477050782,"c":1},{"x":0.19327828676822217,"y":0.68711162335664822,"c":1,"h":0.013541577701995489,"w":0.27188407897949218,"t":"I think I should have practised more."},{"t":"What makes you say that?","h":0.011778563015312105,"y":0.70200235590116655,"c":1,"w":0.19958848317464192,"x":0.19341563487384486},{"t":"Well, I went out to Kenya for a couple of weeks to train ...","x":0.19135802920394074,"h":0.014565699794126807,"c":1,"w":0.43004114786783865,"y":0.71511627881802808},{"c":1,"t":"Really! I didn't know that.","w":0.18724280039469401,"x":0.1934156367356403,"y":0.73110465106557909,"h":0.010174418787512574},{"x":0.19135802633018281,"t":"I was chosen to go there out of loads of kids and run with some of the top","w":0.54526748657226565,"y":0.74411071844375443,"h":0.016195524146054185,"c":1},{"c":1,"y":0.75872093009551145,"t":"teenage athletes in the world. And... I was so calm about it. Ijust kept thinking","x":0.18930042285821666,"w":0.59259256998697918,"h":0.01454173212759069},{"w":0.60114913940429693,"t":"how fortunate I was. What a great chance this was! Everyone back home was so","y":0.76903981351671324,"h":0.021499006992515279,"x":0.1911950902925964,"c":1},{"t":"proud of me. But once we started competing, I very quickly realised I wasn't good","h":0.016195524146054185,"x":0.19135803693958167,"c":1,"w":0.60493825276692714,"y":0.78621908139876828},{"x":0.19330425864473202,"c":1,"t":"enough.","y":0.80347668907866721,"w":0.061951154073079412,"h":0.012232668127412638},{"h":0.012100363507849377,"x":0.19331146459948095,"t":"That must have been a huge shock.","y":0.81680147977444539,"c":1,"w":0.26769396464029949},{"h":0.017400804481461418,"y":0.82860287123280429,"w":0.42611834208170574,"c":1,"x":0.19333601428393821,"t":"I thought 'this can't be happening'! I was used to winning."},{"t":"Q21\/22","x":0.81685473878427317,"y":0.55664566740067578,"h":0.013162153488896045,"w":0.059706160227457672,"c":1},{"h":0.016877245144793607,"y":0.6550788192534962,"w":0.06217858632405604,"c":1,"x":0.81664733222976205,"t":"Q21\/22"},{"y":0.75522089874555887,"w":0.062324085235595739,"h":0.017174481503112626,"c":1,"t":"Q23\/24","x":0.81657458282321727},{"x":0.81683553672839593,"c":1,"h":0.016131074184242533,"t":"Q23\/24","y":0.82841702101249093,"w":0.061802177429199245},{"c":1,"t":"115","w":0.039094651540120373,"h":0.01598837238037687,"y":0.86482558120464748,"x":0.84773662474434297},{"c":1,"t":"IELTSXpress.com","h":0.03616788165448559,"y":0.95194935564360039,"w":0.31034790039062499,"x":0.66784505699597163}]}