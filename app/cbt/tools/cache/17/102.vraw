{"h":3395,"w":2400,"lines":[{"t":"1718867188","y":0.046511627815394085,"w":0.069958845774332645,"x":0.7716049391467531,"h":0.008720930389296444,"c":0.5},{"h":0.015022712545765593,"t":"Audioscripts","y":0.053535155339712981,"w":0.113292236328125,"x":0.11516458131326605,"c":1},{"c":1,"x":0.11728395097449579,"w":0.049382715225219725,"y":0.098837209194886699,"t":"TUTOR:","h":0.008720930389296444},{"h":0.008720930389296444,"t":"HOLLY:","x":0.11728395071063256,"y":0.12790697664505279,"c":1,"w":0.047325102488199863},{"t":"TUTOR:","x":0.11725354280492177,"y":0.14235878398994917,"w":0.04738591829935708,"h":0.0088870831456986377,"c":1},{"c":1,"x":0.11522633810755475,"t":"HOLLY:","y":0.1700581393141124,"h":0.011627907185728592,"w":0.049382715225219725},{"y":0.19901413599436846,"h":0.0089484721387093069,"t":"TUTOR:","w":0.047408110300699885,"c":1,"x":0.11724244685953372},{"y":0.21511627897243979,"w":0.047325102488199863,"x":0.11728395071063259,"h":0.008720930389296444,"c":1,"t":"HOLLY:"},{"w":0.047361927032470691,"t":"TUTOR:","x":0.11726553846005916,"c":1,"y":0.24268243256809752,"h":0.0088211813298776365},{"x":0.11522633776223358,"h":0.010174418787512574,"w":0.049382715225219739,"c":1,"y":0.25726744174691607,"t":"HOLLY:"},{"y":0.29215116270887309,"w":0.047325102488199877,"c":1,"x":0.11728395071530898,"h":0.0072674419910804255,"t":"TUTOR:"},{"t":"HOLLY:","c":1,"w":0.047325102488199863,"y":0.31976744176133187,"h":0.008720930389296444,"x":0.11728395071063256},{"h":0.008720930389296444,"x":0.11728395092648479,"y":0.34883720920578787,"w":0.049382715225219712,"c":1,"t":"TUTOR:"},{"c":1,"t":"HOLLY:","x":0.11522633775776053,"y":0.37790697662963169,"w":0.049382715225219725,"h":0.010174418787512574},{"y":0.39235878398994906,"x":0.11725354280492177,"t":"TUTOR:","w":0.04738591829935708,"h":0.0088870831456987487,"c":1},{"c":1,"t":"HOLLY:","x":0.11728395108100297,"w":0.047325102488199863,"h":0.0087209298276507141,"y":0.42005813965012817},{"w":0.047325102488199877,"y":0.43459302299480962,"c":1,"t":"TUTOR:","x":0.11728395119074231,"h":0.010174418787512574},{"w":0.04749826749165853,"h":0.010583844988028668,"x":0.11719736864391175,"c":1,"y":0.46345807737591693,"t":"HOLLY:"},{"x":0.11724989820118727,"c":1,"w":0.047393207550048819,"y":0.47810453690002497,"t":"TUTOR:","h":0.0089072052244584254},{"h":0.010174418787512574,"c":1,"w":0.047325102488199863,"y":0.49273255802266813,"t":"HOLLY:","x":0.11728395070548854},{"h":0.008720930389296444,"c":1,"t":"TUTOR:","y":0.52180232548007632,"x":0.11728395073229166,"w":0.047325102488199863},{"h":0.008720930389296444,"y":0.53633720920413608,"c":1,"w":0.047325102488199877,"t":"HOLLY:","x":0.11728395071530898},{"x":0.11728395139650362,"c":1,"y":0.54941860439015844,"h":0.010174418787512463,"t":"TUTOR:","w":0.047325102488199863},{"w":0.047325102488199877,"c":1,"x":0.11728395103985068,"t":"HOLLY:","h":0.010174418787512463,"y":0.56395348817891822},{"h":0.0092181356270546466,"w":0.04788257280985514,"y":0.57910968774701865,"x":0.11706679149510327,"c":1,"t":"TUTOR:"},{"c":1,"y":0.62209302315564252,"t":"HOLLY:","h":0.008720930389296444,"x":0.11728395070548854,"w":0.047325102488199863},{"t":"TUTOR:","y":0.63647047676149238,"c":1,"x":0.11722679382968745,"w":0.04743941624959308,"h":0.0090357906265169374},{"y":0.68023255804134541,"h":0.008720930389296444,"x":0.11728395070595619,"w":0.047325102488199863,"c":1,"t":"HOLLY:"},{"c":1,"x":0.11725354280492177,"w":0.04738591829935708,"y":0.69468436538529799,"t":"TUTOR:","h":0.0088870831456987487},{"x":0.1172248435656771,"w":0.047443316777547193,"y":0.72224480394136314,"h":0.010452252535151585,"t":"HOLLY:","c":1},{"x":0.11728395073229166,"y":0.76598837199170433,"w":0.047325102488199863,"h":0.008720930389296444,"c":1,"t":"TUTOR:"},{"h":0.011627907185728592,"x":0.11522633810755475,"c":1,"t":"HOLLY:","w":0.049382715225219725,"y":0.79360465094201937},{"h":0.010174418787512574,"t":"TUTOR:","x":0.11728395139650362,"y":0.80813953462271659,"w":0.047325102488199863,"c":1},{"t":"HOLLY:","y":0.83720930210697053,"x":0.11728395114787536,"w":0.047325102488199863,"h":0.010174418787512463,"c":1},{"c":1,"h":0.013081395583944722,"x":0.11728395099854647,"w":0.03497942288716635,"y":0.86773255798110183,"t":"110"},{"t":"And that's not always easy, especially when a proud parent's trying to get a snap","x":0.20781894028900705,"c":1,"w":0.59876541137695316,"y":0.097383720823529751,"h":0.011627907185728592},{"t":"of their child and you want them to move elsewhere.","x":0.20576131644831833,"y":0.11189634875917154,"w":0.39094650268554687,"h":0.013103651354534729,"c":1},{"w":0.24074073791503903,"c":1,"t":"OK. What about the scheduling?","y":0.12632508820363819,"h":0.011778563015312105,"x":0.20987654451984672},{"t":"With sporting events there are all sorts of things that can alter the timetable - like","c":1,"h":0.01531096201201354,"w":0.60097157796223954,"x":0.20774552012763167,"y":0.13778294956946224},{"t":"rain, for instance - though so far, we've always been lucky with that.","x":0.20781892083539427,"y":0.15547703170824656,"c":1,"w":0.5041152445475261,"h":0.011778563015312216},{"c":1,"x":0.20576131362359604,"y":0.16860465102940159,"h":0.014552004064912638,"w":0.57613169352213534,"t":"Yeah, and I was thinking about what to do if someone got hurt as well. Iknow"},{"w":0.30452674865722651,"t":"that last year that caused a terrible delay.","y":0.18313953463387989,"h":0.011627907185728592,"c":1,"x":0.20781893297591345},{"h":0.011778563015312105,"w":0.30452674865722651,"c":1,"t":"You have to be prepared for such things.","x":0.20781893008347482,"y":0.197585394851715},{"c":1,"x":0.20987654373492953,"t":"Oh. What if a match ends in a draw - do you let the teams keep going until","y":0.21220930221890355,"w":0.55144032796223952,"h":0.011627907185728592},{"w":0.11934155782063804,"t":"someone wins?","x":0.2078189339703394,"y":0.22673733826955256,"h":0.010306242638398078,"c":1},{"y":0.23967148663587645,"c":1,"x":0.20777302144222023,"t":"That'll be up to you - and again, you need to plan for it.","w":0.40957468668619801,"h":0.015646887331042691},{"x":0.20576131696577657,"y":0.25581395333967216,"h":0.013081395583944722,"c":1,"t":"Right.","w":0.047325102488199849},{"y":0.28916372177570382,"w":0.60082305908203126,"t":"Now, the aim of your work placement is to give you the opportunity to develop the","h":0.011778563015312105,"x":0.20987653619792013,"c":1},{"y":0.30377906965802259,"c":1,"x":0.20781892187975784,"w":0.49794240315755212,"t":"skills that an events manager needs. So, let's talk about those a bit.","h":0.011627907185728592},{"w":0.5864197285970052,"y":0.31831395338178092,"c":1,"t":"Well, I think my communication skills are pretty good. I can talk on the phone to","x":0.20781894218297889,"h":0.011627907185728592},{"w":0.34773661295572911,"c":1,"h":0.011778563015312216,"x":0.20781893623971526,"y":0.33274440526919347,"t":"people and book venues and that kind of thing."},{"y":0.34738372082328728,"w":0.5617284138997396,"t":"Good - just remember it isn't only about what you say. If you meet someone","x":0.20987653367323106,"h":0.011627907185728592,"c":1},{"y":0.36069281523028951,"t":"face-to-face and want to persuade them to be a sponsor, for example ...","w":0.53508514404296881,"x":0.20776939816730447,"c":1,"h":0.012912044817202206},{"y":0.37382699417181486,"x":0.20750323492044656,"c":1,"t":"Oh, I'Il dress up for that! Sure.","h":0.017300551855943258,"w":0.22699696858723958},{"w":0.57407409667968745,"h":0.013081395583944722,"c":1,"t":"Good. Let's go on to think about your organisational skills. You're working in a","y":0.38953488360091759,"x":0.20987653179993468},{"y":0.40547703170812821,"t":"very people-based industry and that means things won't always go to plan.","x":0.20781892147249711,"h":0.011778563015312216,"c":1,"w":0.55555557250976562},{"h":0.013081395583944611,"c":1,"t":"Lguess it's being prepared to make changes that matters.","y":0.41860465093622534,"w":0.43004114786783854,"x":0.20576131648103277},{"x":0.20781893245876235,"w":0.53909464518229167,"t":"That's right. You may have to make an on-the-spot change to a timetable","h":0.011627907185728592,"c":1,"y":0.4331395347761362},{"t":"because of a problem you hadn't anticipated ...","w":0.35185185750325521,"c":1,"x":0.20781892713431707,"h":0.011778563015312105,"y":0.44758539485142634},{"t":".. just do it! OK.","h":0.013555491911368067,"y":0.46184088291826342,"x":0.2116281627660353,"c":1,"w":0.12189216613769532},{"h":0.013250883392226132,"t":"How's your time management these days?","y":0.47526501742843397,"x":0.20987654593337443,"w":0.31481480916341142,"c":1},{"x":0.20781892491370363,"y":0.4911660777753728,"c":1,"h":0.013250883392226243,"w":0.58847737630208341,"t":"I'm working on it - I'm certainly better when I have a deadline, which is why this"},{"t":"work suits me.","h":0.012836739929882213,"y":0.50472556576484373,"c":1,"w":0.11160743713378907,"x":0.20760647024999723},{"t":"Yes, but it's how you respond as that deadline approaches!","x":0.20781892208910033,"h":0.011778563015312216,"c":1,"w":0.4403292338053385,"y":0.52031802129010163},{"c":1,"t":"I know l've got to look calm even if l'm in a panic.","w":0.36419751485188806,"x":0.20781893890893249,"y":0.53343023238097287,"h":0.011627907185728592},{"x":0.20781894271426116,"t":"Just think to yourself - no one must know I'm under pressure.","w":0.45884770711263023,"y":0.54796511655964431,"h":0.013081394460653373,"c":1},{"c":1,"y":0.56242638387326216,"t":"Yeah - even though I'm multi-tasking like crazy!","x":0.20781893072318874,"w":0.35596707661946619,"h":0.011778563015312105},{"w":0.59053497314453129,"t":"Another skill that events managers need is creativity. Often your client has what","y":0.5770348836008895,"h":0.013081395583944722,"x":0.20781893308028732,"c":1},{"t":"we call the 'big picture' idea, but it's up to the events manager to think of all the","h":0.01453488398216074,"x":0.20576131174896992,"c":1,"w":0.5884773763020833,"y":0.59156976730832656},{"x":0.20576132257712401,"c":1,"t":"fine points that go to making it work.","y":0.60600706735470489,"w":0.26748970031738284,"h":0.013250883392226243},{"h":0.01444366261872021,"x":0.20775442681894332,"t":"Right, so I need to listen carefully to that idea and then fill in all the gaps.","y":0.61931146708922458,"c":1,"w":0.53923085530598958},{"h":0.01447556746160461,"y":0.63368328753456216,"w":0.570057118733724,"c":1,"x":0.20983084282140907,"t":"That's right. And you'll have a team working under you, so another key skill is"},{"t":"leadership. Your team may have lots of ideas too, but you've got to make the","x":0.20781891957504475,"y":0.64958775030533999,"h":0.011778563015312105,"w":0.56790125528971358,"c":1},{"h":0.01577465722361493,"y":0.66276699166022524,"w":0.52274948120117193,"c":1,"x":0.207777099273349,"t":"ultimate choices. Do we have refreshments inside or out, for example?"},{"y":0.67726737330230469,"w":0.22839505513509115,"h":0.010306242638398078,"c":1,"t":"Isn't it better to be democratic?","x":0.20987655003876435},{"x":0.20987655534558389,"c":1,"h":0.011778563015312216,"t":"It's a nice idea, but you have the ultimate responsibility. So, believe in what you","y":0.69316843323997313,"w":0.5864197285970052},{"c":1,"t":"think best. Be prepared to say 'yes', that's a good idea but it won't work here.","w":0.57201644897460935,"h":0.013081395583944722,"y":0.70639534871587484,"x":0.207818935889964},{"c":1,"t":"I see what you mean. What about the networking side of things? I know it's an","h":0.013250883392226132,"y":0.72084805637682869,"w":0.57818929036458333,"x":0.20781893499733239},{"t":"area that a lot of students worry about because we don't have much experience","y":0.73546511617121679,"w":0.59053497314453129,"h":0.011627907185728703,"c":1,"x":0.20781893304582713},{"t":"to offer others.","h":0.012987355882624452,"c":1,"w":0.11170791625976564,"y":0.74879511192689818,"x":0.20755823140822008},{"x":0.20987655440944403,"t":"But even without it - you can still be an interesting person with useful ideas. And","y":0.76442873988765447,"w":0.59259256998697918,"h":0.011778563015312105,"c":1},{"t":"the more people you impress, the better.","c":1,"w":0.30246912638346352,"x":0.20781893464176676,"y":0.7790697673331245,"h":0.011627907185728592},{"y":0.79212680306811489,"w":0.38084185282389327,"c":1,"t":"I guess that will help me when I apply for a real job.","x":0.20771579496384476,"h":0.014567272963596833},{"w":0.56995885213216146,"h":0.011778563015312216,"x":0.20987654090772045,"t":"Exactly - think ahead - remember what your ambitions are and keep them in","c":1,"y":0.80800942282215948},{"c":1,"t":"Definitely.","y":0.83563521526917006,"h":0.013975544447612398,"x":0.2053875722243555,"w":0.079114061991373719},{"c":1,"w":0.037037035624186254,"x":0.83333333393687814,"h":0.013081395583944722,"t":"Q23","y":0.095930232399706439},{"w":0.037037035624186143,"c":1,"x":0.83333333416321564,"t":"Q24","h":0.013081395583944722,"y":0.16715116254232998},{"t":"Q25","y":0.34593023283871394,"w":0.037037035624186143,"h":0.013081394460653484,"c":1,"x":0.83333333424552014},{"y":0.41860465100435762,"t":"Q26","x":0.83333333393687814,"c":1,"h":0.013081395583944722,"w":0.037037035624186254},{"h":0.013081395583944722,"c":1,"y":0.51889534867877629,"x":0.83333333393687814,"w":0.037037035624186254,"t":"Q27"},{"w":0.037037035624186143,"x":0.83333333394292997,"h":0.011627907185728592,"c":1,"y":0.59156976730316857,"t":"Q28"},{"c":1,"x":0.83333333393687814,"y":0.69186046497544951,"h":0.011627907185728703,"w":0.037037035624186254,"t":"Q29"},{"h":0.013081395583944722,"c":1,"x":0.83333333395157527,"t":"Q30","y":0.7921511626264246,"w":0.037037035624186143},{"w":0.30612678527832038,"x":0.66991655033568553,"c":1,"t":"IELTSXpress.com","y":0.95314993796778535,"h":0.03375352650564889}]}