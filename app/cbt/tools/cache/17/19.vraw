{"lines":[{"h":0.008720930389296444,"c":0.30000001192092896,"x":0.7716049391467531,"t":"1718867188","y":0.046511627815394085,"w":0.069958845774332645},{"y":0.097383720790418016,"x":0.10288065833333335,"t":"Questions 36-40","w":0.16666666666666666,"h":0.01453488398216074,"c":1},{"t":"Choose the correct letter, A, B, C or D.","w":0.34567901611328128,"c":1,"h":0.016195524146054185,"y":0.13074204921686094,"x":0.10082304327953778},{"h":0.01453488398216074,"c":1,"y":0.16424418591310119,"t":"Write the correct letter in boxes 36-40 on your answer sheet.","x":0.10288065268153426,"w":0.53703704833984378},{"x":0.10082305209218527,"w":0.56584360758463548,"t":"36 What is the reviewer's main purpose in the first paragraph?","h":0.015993508068214979,"y":0.18895348822490998,"c":1},{"t":"to describe what happened during the Battle of Worcester","x":0.18518519135991729,"y":0.21511627892162466,"w":0.51440327962239585,"c":1,"h":0.016038020171040723},{"t":"B","h":0.011627907185728703,"y":0.2325581393141124,"x":0.14609053479805151,"c":1,"w":0.014403292338053375},{"x":0.18718648600312776,"y":0.23056716131082378,"c":1,"w":0.61945943196614572,"t":"to give an account of the circumstances leading to Charles Il's escape","h":0.016426188645289885},{"c":1,"x":0.14403292186575556,"h":0.013081395583944611,"y":0.24854651137953931,"w":0.016460905075073251,"t":"C"},{"t":"to provide details of the Parliamentarians' political views","c":1,"x":0.18717063182820654,"y":0.24654599802642196,"h":0.016671990618127186,"w":0.49398020426432293},{"y":0.26598837189163183,"w":0.016460905075073223,"x":0.14403292184517943,"h":0.011627907185728592,"c":1,"t":"D"},{"w":0.47942387898763028,"t":"to compare Charles II's beliets with those of his father","h":0.013250883392226243,"y":0.26590106022445004,"x":0.18518517974021279,"c":1},{"c":1,"h":0.013081395583944611,"w":0.024691357612609863,"y":0.29069767423564397,"t":"37","x":0.1008230453706498},{"h":0.017916086284516131,"c":1,"y":0.28865433728928225,"t":"Why does the reviewer include examples of the fugitives' behaviour in the third","x":0.14396407815548221,"w":0.69355779012044272},{"w":0.10512664159138996,"t":"paragraph?","h":0.015229505981517177,"c":1,"x":0.14393873711677946,"y":0.30779222368273296},{"h":0.014723203769140158,"x":0.18312756751666029,"w":0.4732510375976563,"y":0.33274440524461635,"t":"to explain how close Charles Il came to losing his life","c":1},{"x":0.14814814814828789,"w":0.012345678806304938,"h":0.010174418787512463,"c":1,"t":"B","y":0.35029069749820119},{"c":1,"y":0.3662790695190743,"x":0.14403292186575556,"h":0.013081395583944611,"t":"C","w":0.016460905075073251},{"c":1,"w":0.016460905075073223,"h":0.011627907185728592,"y":0.38372093004500951,"t":"D","x":0.14403292185987668},{"t":"to suggest that Charles Il's supporters were badly prepared","h":0.016003780005537038,"c":1,"x":0.17695474385271326,"w":0.53497940063476557,"y":0.34883720913961502},{"x":0.18312756446849032,"y":0.36627906961792989,"c":1,"h":0.01598837238037687,"w":0.54938273111979163,"t":"to illustrate how the events of the six weeks are brought to life"},{"y":0.38368669049558735,"h":0.014569123586018917,"c":1,"t":"to argue that certain aspects are not as well known as they should be","w":0.61522633870442711,"x":0.18518518445224952},{"w":0.72222223917643225,"y":0.4084216723707963,"t":"38 What point does the reviewer make about Charles II in the fourth paragraph?","c":1,"h":0.015996932421752708,"x":0.10082303668750399},{"y":0.43459302312195436,"w":0.4691357930501302,"t":"He chose to celebrate what was essentially a defeat.","h":0.014534883982160629,"x":0.18518518979180734,"c":1},{"x":0.14609053479805151,"w":0.014403292338053375,"y":0.45058139510046957,"h":0.013081395583944611,"t":"B","c":1},{"y":0.46802325559318225,"t":"C","c":1,"x":0.14403292186575556,"h":0.011627907185728592,"w":0.016460905075073251},{"x":0.14403292186575556,"y":0.48401162765860906,"t":"D","w":0.016460905075073251,"h":0.013081395583944611,"c":1},{"c":1,"x":0.18303778891418768,"t":"He misunderstood the motives of his opponents.","y":0.4491734974545849,"w":0.43437026977539062,"h":0.016378811587995257},{"y":0.46514019906188953,"t":"He aimed to restore people's faith in the monarchy.","x":0.18504690114969777,"c":1,"h":0.018965863788366621,"w":0.45504119873046867},{"t":"He was driven by a desire to be popular.","c":1,"y":0.48401162775154383,"w":0.36419754028320311,"x":0.18312756705126948,"h":0.01598837238037687},{"x":0.10082305252770936,"c":1,"t":"39 What does the reviewer say about Charles Spencer in the fifth paragraph?","y":0.50872093045067235,"w":0.69958847045898431,"h":0.016014051942858987},{"x":0.183127583342275,"t":"His decision to write the book comes as a surprise.","y":0.53474676104797736,"h":0.016195524146054185,"c":1,"w":0.45679011027018235},{"x":0.14609053479805151,"h":0.011627907185728592,"y":0.55232558117457753,"w":0.014403292338053375,"c":1,"t":"B"},{"h":0.01453488398216074,"y":0.55232558126141507,"c":1,"w":0.48559672037760415,"x":0.17695472612572147,"t":"He takes an unbiased approach to the subject matter."},{"t":"C","y":0.56831395324000444,"w":0.018518517812093072,"h":0.013081395583944611,"x":0.14403292206103166,"c":1},{"w":0.63580245971679683,"h":0.01598837238037687,"c":1,"y":0.56831395334199453,"x":0.1728395107811995,"t":"His descriptions of events would be better if they included more detail."},{"c":1,"t":"D","w":0.016460905075073251,"y":0.58575581370512075,"x":0.14403292186575556,"h":0.013081395583944722},{"t":"He chooses language that is suitable for a twenty-first-century audience.","y":0.58568904593357096,"x":0.18518519700359301,"w":0.6440328979492187,"h":0.016195524146054185,"c":1},{"x":0.10082304526776914,"y":0.61046511603070208,"c":1,"w":0.024691357612609849,"h":0.013081395583944611,"t":"40"},{"t":"When the reviewer says the book 'doesn't quite hit the mark', she is making the","c":1,"x":0.13168724425831557,"w":0.71193415323893228,"h":0.017482948527880904,"y":0.61042402837022114},{"t":"point that","c":1,"y":0.62640814722460125,"h":0.016313243951337042,"w":0.087581170399983699,"x":0.14345756233073806},{"y":0.65020341141286786,"w":0.47359476725260419,"h":0.020416619218841969,"c":1,"t":"it overlooks the impact of events on ordinary people.","x":0.17885283774489372},{"y":0.67005813931411229,"h":0.011627907185728703,"t":"B","c":1,"w":0.014403292338053375,"x":0.14609053479805151},{"x":0.17901235028372928,"w":0.46913579305013009,"y":0.67005813940090397,"c":1,"h":0.014570836043610647,"t":"it lacks an analysis of prevalent views on monarchy."},{"h":0.017441860778592888,"t":"it omits any references to the deceit practised by Charles II during his time","x":0.17695473253899896,"y":0.6860465114644082,"w":0.66666666666666663,"c":1},{"c":1,"t":"in hiding.","h":0.016575774539907107,"w":0.087736059824625651,"x":0.18459045092843193,"y":0.70198508991947295},{"y":0.7164310950867917,"w":0.69753087361653643,"h":0.019140164899882239,"t":"D it fails to address whether Charles Il's experiences had a lasting influence","c":1,"x":0.13991768395304879},{"h":0.011950362557095584,"c":1,"y":0.73669631313953499,"t":"on him.","x":0.18924592755199712,"w":0.0685897382100423},{"y":0.86599779172991975,"t":"→O p. 120","c":1,"w":0.11585203806559241,"h":0.018185924444659163,"x":0.71161729128870832},{"x":0.85802469089088185,"c":1,"h":0.013081395583944722,"y":0.86773255796747517,"t":"27","w":0.026748971939086874},{"t":"IELTSXpress.com","y":0.95420213982109725,"x":0.67016044169348621,"h":0.031291510106817966,"c":1,"w":0.3077012634277343}],"w":2400,"h":3395}