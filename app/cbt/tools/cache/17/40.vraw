{"lines":[{"y":0.046511627815782663,"h":0.008720930389296444,"c":0.5,"t":"1718867188","w":0.069958845774332645,"x":0.77160493914987061},{"w":0.057613169352213556,"h":0.013081395583944722,"x":0.11728395020043644,"y":0.053779069624731557,"c":1,"t":"Test 2"},{"y":0.09738372079030011,"t":"Questions 32-36","x":0.11934156187781819,"w":0.16460905710856122,"h":0.01453488398216074,"c":1},{"t":"Do the following statements agree with the claims of the writer in Reading Passage 3?","y":0.13074204921942356,"x":0.11728396182636856,"w":0.75925923665364581,"h":0.016195524146054074,"c":1},{"w":0.38888888041178388,"x":0.11522634158255414,"y":0.16424418591194667,"h":0.01453488398216074,"t":"In boxes 32-36 on your answer sheet, write","c":1},{"c":1,"t":"YES","x":0.18518518463097716,"y":0.19622093007866726,"w":0.041152264277140305,"h":0.013081395583944611},{"x":0.18518518514117333,"y":0.21366279052980763,"w":0.030864197413126626,"c":1,"t":"NO","h":0.013081395583944611},{"w":0.45267491658528641,"y":0.19611307446062598,"t":"if the statement agrees with the claims of the writer","c":1,"h":0.016195524146054185,"x":0.31069957859007286},{"x":0.31069958774207879,"c":1,"t":"if the statement contradicts the claims of the writer","y":0.21366279057696091,"h":0.013081395583944722,"w":0.44855967203776043},{"c":1,"y":0.22965116264430174,"h":0.01598837238037687,"t":"NOT GIVEN if it is impossible to say what the writer thinks about this","w":0.617283935546875,"x":0.18518519261610919},{"y":0.26295641952373139,"t":"32 Acknowledging people such as Plato or da Vinci as geniuses will help us","w":0.68106994628906248,"x":0.11934156995685896,"h":0.013250883392226132,"c":1},{"x":0.15843620354017238,"y":0.27906976729439492,"h":0.01598837238037687,"w":0.56790125528971347,"c":1,"t":"understand the process by which great minds create new ideas."},{"y":0.30236768366486033,"w":0.74094161987304685,"x":0.11717691931754169,"h":0.018962318681013723,"t":"33 The Law of Effect was discovered at a time when psychologists were seeking a","c":1},{"w":0.3439520009358723,"c":1,"t":"scientific reason why creativity occurs.","y":0.32102555372205688,"x":0.15827434172495289,"h":0.017329529401691635},{"c":1,"t":"34 The Law of Effect states that no planning is involved in the behaviour of organisms.","x":0.11927152624744622,"w":0.77587488810221361,"y":0.34515239004304199,"h":0.016793477942440904},{"w":0.75720163981119792,"h":0.013084819375836831,"c":1,"x":0.11934156682307635,"t":"35 The Law of Effect sets out clear explanations about the sources of new ideas and","y":0.37354651150857099},{"h":0.013507374605104761,"w":0.10784520467122397,"x":0.16011565554271176,"y":0.3900036476661769,"t":"behaviours.","c":1},{"t":"36 Many scientists are now turning away from the notion of intelligent design","w":0.68724278767903646,"x":0.1193415690027507,"y":0.41569767428542148,"h":0.01453488398216074,"c":1},{"x":0.16220714388742608,"t":"and genius.","c":1,"w":0.10559478123982746,"h":0.013934842548887105,"y":0.43306409609368024},{"w":0.026748971939086902,"x":0.11522633696426998,"y":0.86773255796747517,"t":"48","c":1,"h":0.013081395583944722},{"t":"IELTSXpress.com","x":0.66991094639740412,"y":0.95311055968589831,"c":1,"w":0.30613845825195307,"h":0.033792529426278195}],"w":2400,"h":3395}