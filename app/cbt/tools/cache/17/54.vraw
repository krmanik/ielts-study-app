{"lines":[{"c":0.30000001192092896,"h":0.008720930389296444,"x":0.77160493914987061,"t":"1718867188","y":0.046511627815782663,"w":0.069958845774332645},{"c":1,"t":"Test 3","w":0.057613169352213542,"x":0.1172839502042468,"y":0.053779069625663367,"h":0.013081395583944611},{"y":0.097383720803594587,"w":0.15226337432861331,"h":0.013081395583944611,"x":0.11934156376161929,"c":1,"t":"Questions 6-13"},{"w":0.74485595703124996,"h":0.016195524146054185,"y":0.13074204921937316,"c":1,"t":"Do the following statements agree with the information given in Reading Passage 1?","x":0.11728395554722568},{"x":0.115226334360104,"w":0.38065844217936201,"y":0.16424418589834366,"c":1,"t":"In boxes 6-13 on your answer sheet, write","h":0.01598837238037687},{"t":"TRUE","y":0.19611827137297189,"w":0.055651766459147184,"h":0.013286713014923901,"x":0.18513707963070408,"c":1},{"y":0.21336391307120306,"h":0.013679150557770692,"t":"FALSE","w":0.068127117156982442,"x":0.18301463061942053,"c":1},{"h":0.016195524146054185,"t":"if the statement agrees with the information","w":0.38477366129557294,"c":1,"y":0.19611307446155657,"x":0.31069958899647249},{"x":0.31069958993833846,"y":0.21366279057631787,"t":"if the statement contradicts the information","w":0.37860081990559891,"c":1,"h":0.013081395583944722},{"c":1,"x":0.18518519098337435,"t":"NOT GIVEN if there is no information on this","h":0.013081395583944611,"w":0.40534978230794272,"y":0.22965116266769336},{"x":0.12962964175155473,"y":0.27179034161512927,"h":0.014546867815428799,"c":1,"w":0.75308639526367194,"t":"6 Significant numbers of thylacines were killed by humans from the 1830s onwards."},{"y":0.29796511614568066,"x":0.12757201604052373,"w":0.55761316935221361,"t":"7 Several thylacines were born in zoos during the late 1800s.","c":1,"h":0.014534883982160851},{"y":0.32267441845669942,"h":0.01598837238037687,"x":0.12551440504834413,"t":"8 John Gould's prediction about the thylacine surprised some biologists.","c":1,"w":0.65432098388671878},{"x":0.12757200945130856,"y":0.34883720915649397,"c":1,"w":0.767489725748698,"h":0.016003780005537038,"t":"9 In the early 1900s, many scientists became worried about the possible extinction of"},{"w":0.12345678965250653,"h":0.01453488398216074,"t":"the thylacine.","x":0.15843621409464295,"y":0.3662790696206768,"c":1},{"t":"10","y":0.39098837184465562,"x":0.11522633723993875,"w":0.030864197413126626,"h":0.013081395583944611,"c":1},{"t":"T. T. Flynn's proposal to rehome captive thylacines on an island proved to be","x":0.14609054048960105,"y":0.38953488387242619,"h":0.015988371257085521,"c":1,"w":0.68930038452148434},{"t":"impractical.","y":0.40797519496970613,"c":1,"w":0.10928923288981118,"x":0.1562607332420124,"h":0.015444958869925252},{"c":1,"t":"11 There were still reasonable numbers of thylacines in existence when a piece of","h":0.01453488398216074,"y":0.43313953475108136,"w":0.74279836018880208,"x":0.11522633420601039},{"w":0.67078191121419273,"c":1,"x":0.15637859161814183,"t":"legislation protecting the species during their breeding season was passed.","y":0.45053003552924475,"h":0.014723203769140047},{"c":1,"h":0.015995219964160978,"x":0.11728395679020386,"y":0.47673733831655252,"t":"12 From 1930 to 1936, the only known living thylacines were all in captivity.","w":0.68106994628906248},{"t":"13 Attempts to find living thylacines are now rarely made.","x":0.11728393853004902,"c":1,"y":0.50145348821715685,"w":0.52263376871744793,"h":0.015988372380376759},{"t":"62","y":0.86773255796252025,"h":0.013081395583944722,"c":1,"x":0.11522633697284339,"w":0.026748971939086916},{"y":0.86627906952383771,"c":1,"t":"→ • p. 124","x":0.17901234830161514,"h":0.01598837238037687,"w":0.11934155782063802},{"c":1,"y":0.95311055968589831,"t":"IELTSXpress.com","x":0.66991094639740412,"h":0.033792529426278195,"w":0.30613845825195307}],"h":3395,"w":2400}