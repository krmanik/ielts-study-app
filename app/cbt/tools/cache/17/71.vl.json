{"blocks":[{"l":"header","b":[0.7471,0.0189,0.8629,0.0303],"t":"雅思、托福等快速保分解决方案"},{"l":"header_image","b":[0.6538,0.0065,0.73,0.0751],"t":""},{"l":"header","b":[0.7688,0.0445,0.8413,0.056],"t":"微信1718867188"},{"l":"paragraph_title","b":[0.0996,0.0948,0.2708,0.1116],"t":"Questions 25–30"},{"l":"text","b":[0.0971,0.1278,0.8512,0.1629],"t":"What comment do the students make about the development of each of the following items of sporting equipment?"},{"l":"text","b":[0.0988,0.1773,0.7642,0.2115],"t":"Choose SIX answers from the box and write the correct letter, A–H, next to Questions 25–30."},{"l":"paragraph_title","b":[0.2408,0.2401,0.7417,0.258],"t":"Comments about the development of the equipment"},{"l":"text","b":[0.2621,0.2666,0.6196,0.2842],"t":"A It could cause excessive sweating."},{"l":"text","b":[0.2637,0.2916,0.7638,0.3264],"t":"B The material was being mass produced for another purpose."},{"l":"text","b":[0.2642,0.3337,0.6654,0.352],"t":"C People often needed to make their own."},{"l":"text","b":[0.2642,0.3594,0.5513,0.377],"t":"D It often had to be replaced."},{"l":"text","b":[0.2637,0.3853,0.5667,0.4029],"t":"E The material was expensive."},{"l":"text","b":[0.2629,0.4103,0.6296,0.43],"t":"F It was unpopular among spectators."},{"l":"text","b":[0.2637,0.4365,0.4692,0.4548],"t":"G It caused injuries."},{"l":"text","b":[0.2629,0.4616,0.5742,0.4804],"t":"H No one using it liked it at first."},{"l":"paragraph_title","b":[0.1417,0.5214,0.4175,0.5396],"t":"Items of sporting equipment"},{"l":"text","b":[0.0975,0.547,0.5096,0.5652],"t":"25 the table tennis bat"},{"l":"text","b":[0.0983,0.5726,0.5096,0.5915],"t":"26 the cricket helmet"},{"l":"text","b":[0.0983,0.5988,0.5096,0.6171],"t":"27 the cycle helmet"},{"l":"text","b":[0.0992,0.6247,0.5092,0.6427],"t":"28 the golf club"},{"l":"text","b":[0.0992,0.6495,0.5088,0.6683],"t":"29 the hockey stick"},{"l":"text","b":[0.1,0.6754,0.5092,0.6931],"t":"30 the football"},{"l":"footer","b":[0.6062,0.8627,0.8317,0.8825],"t":"