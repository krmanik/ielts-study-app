944661448,"h":0.018980948467277048},{"y":0.41569767428426241,"w":0.53497940063476568,"c":1,"x":0.098765443642731154,"h":0.014534883982160851,"t":"infrastructure of the area between the farmland and the main road."},{"w":0.68518519083658858,"t":"Firstly, the planned development of the norbiton area replaces what once were factories","y":0.44316843320031163,"h":0.016195524146054185,"x":0.10082304232940023,"c":1},{"y":0.46234638938831851,"x":0.098107872347260164,"h":0.016389490718414668,"c":1,"w":0.10824727376302083,"t":"tor housings."},{"y":0.48681879570870512,"w":0.72644810994466147,"h":0.020443566977205396,"c":1,"t":"Moreover, the roads have been developed to acomodate all the new biuldings that have been","x":0.10076748524025581},{"y":0.50726744170110005,"w":0.7366255187988282,"t":"planned for the area, which are, a school and a playground to the east side of the roundabout","x":0.10082304296126324,"h":0.017467540902720735,"c":1},{"w":0.76337448120117191,"c":1,"x":0.098765434192362708,"t":"located in the center of the map, as well as shops and a medical center around the round about.","y":0.52616279053820225,"h":0.017441860778592999},{"t":"Secondly, a bridge is planned for the north of the map to cross the river and provide acess to the","w":0.77366256713867188,"c":1,"y":0.55377906960834011,"x":0.10082303731348607,"h":0.017481236631934904},{"h":0.021552978893050856,"t":"housing that will be located in farmland.","c":1,"x":0.09857603632340016,"y":0.56925427940228868,"w":0.31735008239746093},{"c":1,"x":0.10288065990909728,"y":0.60600706734966092,"w":0.29218106587727866,"h":0.011778563015312105,"t":"Here is the examiner's comment:"},{"c":1,"y":0.63808139556695143,"w":0.71810699462890615,"t":"This response covers the key changes to be made to the industrial area, although","x":0.14609053918246037,"h":0.015988371257085521},{"t":"more detail could be provided, for example, housing to the west of the roundabout.","w":0.73045267740885422,"y":0.65547703166891769,"x":0.14403292046526939,"h":0.016034596379148724,"c":1},{"w":0.73251027425130222,"t":"There is an overview in the second paragraph and the response could be improved","y":0.67285041239153476,"h":0.013250883392226132,"c":1,"x":0.14609054178381398},{"t":"by adding a summary of the main changes.","x":0.14609053564906593,"y":0.688953488221836,"h":0.01453488398216074,"c":1,"w":0.384773661295573},{"c":1,"y":0.72084805671603214,"t":"Ideas are arranged coherently, with some effective use of cohesive devices [what","w":0.72016459147135414,"h":0.016195524146054185,"x":0.14403293121905544},{"w":0.72440836588541668,"x":0.1439791250802267,"y":0.73681692725797665,"t":"once were], sequencing adverbs [Firstly | Secondly] and referencing [which | that].","c":1,"h":0.019030924820647166},{"y":0.77179034162871007,"x":0.14609052451446464,"w":0.73456792195638032,"c":1,"t":"There is some less common vocabulary but spelling is often inaccurate [acomodate","h":0.01309337941721278},{"w":0.7366255187988282,"y":0.78769140138549065,"h":0.016195524146054185,"c":1,"t":"\/ accommodate | biuldings \/ buildings] and word formation is incorrect [substantially","x":0.14197530633986105},{"y":0.80523255800084459,"w":0.25308642069498699,"x":0.14403292125630163,"h":0.014555427856804859,"t":"growth \/ substantial growth].","c":1},{"h":0.0150577266589772,"x":0.14605290466220786,"y":0.83719159048644209,"w":0.68527506510416658,"t":"To achieve a higher score, the candidate would need to reduce the number of","c":1},{"x":0.14609053000226302,"t":"errors in vocabulary and sentence structure.","w":0.39300412495930992,"c":1,"y":0.85453474699915388,"h":0.013250883392226132},{"t":"127","h":0.013081395583944611,"c":1,"w":0.034979422887166378,"y":0.86773255797837645,"x":0.84773662590209575},{"x":0.66991655033568553,"t":"IELTSXpress.com","w":0.30612678527832038,"h":0.03375352650564889,"y":0.95314993796778535,"c":1}],"w":2400,"h":3395}