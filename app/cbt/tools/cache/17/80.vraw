{"lines":[{"w":0.069958845774332645,"x":0.7716049391467531,"t":"1718867188","y":0.046511627815394085,"h":0.008720930389296444,"c":0.5},{"h":0.013153948969217621,"t":"Test 4","y":0.053742792932902073,"x":0.11726748660669259,"w":0.057646096547444653,"c":1},{"x":0.11934156258424357,"y":0.097383720792047046,"w":0.20164609273274742,"c":1,"h":0.01453488398216074,"t":"Questions 23 and 24"},{"w":0.23868311564127603,"c":1,"x":0.11728395647699297,"y":0.13074204921459365,"t":"Choose TWO letters, A-E.","h":0.016195524146054296},{"x":0.11728394643246678,"w":0.58230453491210943,"c":1,"h":0.014534883982160851,"t":"Write the correct letters in boxes 23 and 24 on your answer sheet.","y":0.16424418591330081},{"w":0.73456792195638021,"y":0.19611307446388038,"c":1,"h":0.016195524146054185,"x":0.11728394015320154,"t":"Which TWO of the following statements does the writer make about literacy rates in"},{"h":0.013930606055737149,"y":0.21323818532940464,"w":0.098983764648437514,"t":"Section B?","x":0.11717478423762619,"c":1},{"y":0.24116607776246957,"c":1,"t":"Very little research has been done into the link between high literacy rates and","x":0.20164608666480358,"w":0.69135803222656256,"h":0.014723203769140158},{"h":0.013081394460653373,"c":1,"x":0.20370370877669644,"w":0.17283949534098306,"t":"improved earnings.","y":0.25726744208653374},{"x":0.20164608352410349,"y":0.27325581380699671,"t":"Literacy rates in Germany between 1600 and 1900 were very good.","w":0.60082305908203126,"c":1,"h":0.01598837238037687},{"t":"There is strong evidence that high literacy rates in the modern world result in","x":0.20370369355228624,"w":0.67695475260416671,"c":1,"y":0.29063604264851328,"h":0.016195524146054074},{"y":0.30800942279401533,"t":"economic growth.","x":0.20576131598465272,"h":0.013250883392226021,"c":1,"w":0.15843621571858721},{"t":"England is a good example of how high literacy rates helped a country","x":0.20164609702329594,"c":1,"y":0.32412790683033899,"w":0.62345677693684898,"h":0.01598837238037687},{"h":0.015217362079238406,"c":1,"w":0.11816045125325519,"y":0.33995767097945273,"x":0.20123993460650813,"t":"industrialise."},{"y":0.35747938769330956,"x":0.19753085244882801,"w":0.46502059936523438,"c":1,"t":"Economic growth can help to improve literacy rates.","h":0.01472320376914027},{"h":0.01472320376914027,"y":0.42137809201929399,"w":0.20164609273274736,"t":"Questions 25 and 26","c":1,"x":0.11728394945464297},{"x":0.11728395647699297,"w":0.23868311564127603,"y":0.45639534868633058,"t":"Choose TWO letters, A-E.","h":0.015988372380376759,"c":1},{"w":0.58256663004557296,"h":0.018635780145759617,"x":0.1171651308443991,"t":"Write the correct letters in boxes 25 and 26 on your answer sheet.","c":1,"y":0.48665973209829283},{"c":1,"w":0.76337448120117191,"t":"Which TWO of the following statements does the writer make in Section F about guilds","x":0.11728395271131868,"y":0.52179034160224214,"h":0.016000356213644928},{"y":0.53726958438566041,"t":"in German-speaking Central Europe between 1600 and 1900?","w":0.55366836547851572,"h":0.017610511734853507,"x":0.11514320657332305,"c":1},{"t":"They helped young people to learn a skill.","x":0.2035966030111275,"y":0.56535607766331419,"w":0.37058553059895838,"c":1,"h":0.017424662065449903},{"w":0.014403292338053375,"t":"B","y":0.58284883698273693,"c":1,"x":0.16049382699626824,"h":0.013081395583944722},{"c":1,"t":"c","x":0.15843621407768974,"w":0.016460905075073251,"y":0.59593023277625379,"h":0.015988371257085521},{"c":1,"y":0.60901162802118647,"t":"D","x":0.16255144029506427,"w":0.012345678806304938,"h":0.01744185965530165},{"h":0.017441859655301539,"y":0.62645348848630267,"c":1,"t":"E","x":0.16255144036365138,"w":0.012345678806304938},{"w":0.51028808593749997,"x":0.20576130672133797,"t":"They were opposed to people moving to an area for work.","h":0.014723203769140158,"c":1,"y":0.58274440524488458},{"t":"They kept better records than guilds in other parts of the world.","y":0.59883720915563199,"w":0.557613169352213