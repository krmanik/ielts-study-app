{"lines":[{"h":0.008720930389296444,"c":0.5,"x":0.77160493914987061,"t":"1718867188","y":0.046511627815782663,"w":0.069958845774332645},{"h":0.030365536153948325,"t":"Audioscripts","x":0.11690039032891453,"w":0.23963551839192709,"y":0.09461853180585067,"c":1},{"y":0.15394753844191111,"t":"TEST 1","x":0.41559576805829113,"h":0.017686318171740378,"c":1,"w":0.10090723037719729},{"h":0.013081395583944722,"y":0.21366279056558579,"x":0.11728395090914809,"t":"PART 1","w":0.094650204976399754,"c":1},{"t":"PETER:","y":0.24127906964943213,"h":0.008720930389296444,"w":0.047325102488199863,"c":1,"x":0.11728395082286604},{"t":"JAN:","w":0.030864197413126626,"x":0.11728395070187289,"c":1,"h":0.0087209298276508251,"y":0.25581395358181414},{"t":"PETER:","w":0.051440327962239574,"x":0.11522633816651395,"y":0.28343023238097298,"c":1,"h":0.011627907185728592},{"t":"JAN:","w":0.030864197413126612,"h":0.008720930389296333,"x":0.11728395057327208,"c":1,"y":0.29941860454372393},{"x":0.11728395069980303,"c":1,"t":"PETER:","h":0.008720930389296444,"y":0.34156976734054156,"w":0.047325102488199863},{"x":0.1172839505806207,"w":0.030864197413126612,"c":1,"t":"JAN:","y":0.39970930221606604,"h":0.0087209303892965551},{"h":0.008720930389296333,"w":0.047325102488199863,"t":"PETER:","x":0.11728395071063256,"y":0.41424418594737844,"c":1},{"y":0.44331395337885682,"x":0.1172839505806207,"c":1,"h":0.008720930389296444,"w":0.030864197413126612,"t":"JAN:"},{"x":0.11728395071063259,"h":0.008720930389296444,"c":1,"w":0.047325102488199863,"t":"PETER:","y":0.45784883711197455},{"t":"JAN:","h":0.010174418787512574,"c":1,"x":0.11522633772328068,"w":0.032921810150146488,"y":0.49999999983589483},{"t":"PETER:","y":0.5145348836227408,"h":0.008720930389296444,"x":0.11728395071530898,"c":1,"w":0.047325102488199877},{"t":"JAN:","x":0.1172839505806207,"y":0.57267441849513578,"c":1,"w":0.030864197413126612,"h":0.0087209303892965551},{"c":1,"w":0.04740439732869467,"t":"PETER:","x":0.11724430329021279,"h":0.0089381766122699213,"y":0.58710067911724007},{"t":"JAN.","c":1,"y":0.6162790696600029,"x":0.11728395057327208,"h":0.008720930389296444,"w":0.030864197413126612},{"x":0.11728395071530898,"y":0.64389534872265497,"t":"PETER:","h":0.010174418787512574,"c":1,"w":0.047325102488199877},{"t":"JAN:","y":0.68749999988199029,"w":0.03086419741312664,"h":0.008720930389296444,"c":1,"x":0.11728395061068321},{"t":"PETER:","x":0.11724848992547526,"y":0.72228669064804829,"w":0.047396024068196624,"h":0.0089149907564808339,"c":1},{"h":0.010174418787512574,"c":1,"x":0.11728395069672888,"t":"JAN:","w":0.030864197413126612,"y":0.74999999980682519},{"w":0.047325102488199877,"h":0.008720930389296444,"x":0.11728395071530898,"t":"PETER:","y":0.77906976734367095,"c":1},{"h":0.008720930389296444,"c":1,"y":0.82267441849513601,"t":"JAN:","w":0.030864197413126612,"x":0.1172839505806207},{"h":0.011718454574387249,"w":0.05148120562235517,"x":0.20574087857200671,"t":"Hello?","y":0.23978030757027324,"c":1},{"w":0.59670781453450528,"h":0.011627907185728592,"t":"Oh hello. My name's Jan. Are you the right person to talk to about the Buckworth","c":1,"x":0.20987654530476391,"y":0.25436046500976817},{"c":1,"t":"Conservation Group?","y":0.26884570093459936,"w":0.1604938252766927,"x":0.20987654404889644,"h":0.011778563015312105},{"t":"Yes, I'm Peter. I'm the secretary.","x":0.20781893134024082,"h":0.011627907185728592,"y":0.28343023244805698,"w":0.24074073791503908,"c":1},{"y":0.29796511617237531,"t":"Good. I've just moved to this area, and I'm interested in getting involved. I was","w":0.58024693806966143,"x":0.20781891768732919,"c":1,"h":0.011627907185728592},{"x":0.207818934019011,"t":"in a similar group where I used to live. Could you tell me something about your","y":0.31242638387431776,"c":1,"h":0.011778563015312105,"w":0.58436213175455731},{"y":0.3254416844857928,"t":"activities, please?","x":0.20758768458485269,"w":0.13430928548177082,"c":1,"h":0.014197984207926284},{"t":"Of course. Well, we have a mixture of regular activities and special events. One","y":0.34010600702583127,"w":0.5884773763020833,"h":0.011778563015312216,"c":1,"x":0.20987653807977136},{"x":0.207818925841075,"w":0.58230453491210943,"c":1,"t":"of the regular ones is trying to keep the beach free of litter. A few of us spend a","h":0.013250883392226021,"y":0.3545347470063045},{"t":"couple of hours a month on it, and it's awful how much there is to clear. I wish","w":0.57407409667968745,"y":0.36918604640407571,"h":0.011627907185728592,"c":1,"x":0.20781891862084498},{"t":"people would be more responsible and take it home with them.","y":0.38368668995885891,"w":0.46707819620768232,"x":0.20781892649643141,"h":0.011778563015312216,"c":1},{"x":0.20781893088236111,"y":0.39811542995426064,"w":0.49382715861002602,"h":0.011778563015312105,"c":1,"t":"I totally agree. I'd be happy to help with that. Is it OK to take dogs?"},{"y":0.41279069756759146,"w":0.58847737630208341,"h":0.011627907185728592,"t":"I'm afraid not, as they're banned from the beach itself. You can take them along","c":1,"x":0.20781892490034087},{"y":0.42726737343894194,"w":0.33127571105957027,"x":0.20781893442327554,"h":0.013250883392226132,"t":"the cliffs, though. And children are welcome.","c":1},{"c":1,"y":0.44186046496757925,"t":"Right.","w":0.047325102488199849,"x":0.20576131696577657,"h":0.013081395583944611},{"x":0.20979939627925631,"w":0.5762734985351563,"c":1,"h":0.015306680025565789,"y":0.45385195591536132,"t":"We also manage a nature reserve, and there's a lot to do there all year round."},{"t":"For example, because it's a popular place to visit, we spend a lot of time looking","x":0.20781894123811773,"c":1,"y":0.47084805639133431,"w":0.59259256998697918,"h":0.011778563015312105},{"w":0.51452418009440104,"x":0.2077724783564231,"h":0.014548185997773078,"t":"after the paths and making sure they're in good condition for walking.","y":0.48259863804092795,"c":1},{"h":0.013100227000997,"y":0.4985276793681378,"x":0.20576132271537623,"w":0.22839505513509112,"t":"I could certainly help with that.","c":1},{"c":1,"t":"Good. And we have a programme of creating new habitats there. We've just","y":0.51295641953666171,"x":0.20987653368326012,"w":0.5617284138997396,"h":0.011778563015312105},{"w":0.5617284138997396,"x":0.20781892050197143,"y":0.52761627894939445,"t":"finished making and installing nesting boxes for birds to use, and next we're","h":0.013081395583944611,"c":1},{"h":0.015019271904503917,"c":1,"x":0.20773533079624806,"y":0.5410015477029485,"t":"going to work on encouraging insects - they're important for the biodiversity of","w":0.58248046875000004},{"y":0.55800942282494292,"h":0.010306242638398078,"t":"the reserve.","x":0.20781892851538364,"c":1,"w":0.092592595418294288},{"w":0.13991769154866535,"h":0.011627907185728592,"t":"They certainly are.","x":0.20781893184553524,"c":1,"y":0.57122093011454511},{"c":1,"x":0.20981156718839258,"h":0.015108414617387989,"t":"Oh, and we're also running a project to identify the different species of butterflies","w":0.59478403727213547,"y":0.5835450820401985},{"y":0.59806841887067808,"h":0.015125393727081216,"w":0.48988901774088545,"c":1,"x":0.20773471430096682,"t":"that visit the reserve. You might be interested in taking part in that."},{"y":0.61336866910998511,"h":0.013084819375836831,"w":0.57201644897460935,"c":1,"x":0.20987654909703338,"t":"Sure. I was involved in something similar where I used to live, counting all the"},{"y":0.62779740855120958,"c":1,"h":0.011778563015312105,"w":0.23662551879882812,"x":0.20781892772601337,"t":"species of moths. I'd enjoy that."},{"y":0.64084084300738398,"w":0.59886866251627602,"x":0.20777971626545594,"h":0.014710779044035616,"c":1,"t":"Another job we're doing at the reserve is replacing the wall on the southern side,"},{"w":0.58436213175455731,"x":0.20781893403344934,"y":0.65694935204495819,"t":"between the parking area and our woodshed. It was badly damaged in a storm","h":0.013250883392226132,"c":1},{"t":"ast month.","x":0.20982492160764177,"w":0.084465382893880225,"c":1,"h":0.010610659074727136,"y":0.67274699603087285},{"y":0.686046511478692,"t":"OK.","w":0.030864197413126626,"h":0.011627907185728592,"c":1,"x":0.2078189299813126},{"t":"Then as I said, we have a programme of events as well, both at the weekend,","x":0.20781893530467679,"y":0.71937573637319552,"w":0.57818929036458333,"h":0.013250883392226132,"c":1},{"y":0.73367378242017356,"x":0.20766693894269334,"c":1,"h":0.013007133672599647,"t":"and during the week.","w":0.15882648468017579},{"t":"Right. I presume you have guided walks? I'd like to get to know the local","x":0.20987655472416672,"w":0.53497940063476568,"h":0.011778563015312105,"y":0.74852767954247212,"c":1},{"w":0.26748970031738284,"x":0.2078189357543361,"y":0.76295641951606552,"t":"countryside, as l'm new to the area.","h":0.013250883392226132,"c":1},{"w":0.5617284138997396,"y":0.77761627894976404,"x":0.20781892051772463,"h":0.013081395583944611,"t":"Yes, we do. The next walk is to Ruston Island, a week on Saturday. We'll be","c":1},{"t":"meeting in the car park at Dunsmore Beach at low tide - that's when the sands","w":0.58436213175455731,"x":0.20781893402492604,"y":0.79210836303876075,"c":1,"h":0.011778563015312105},{"h":0.011629619081674591,"c":1,"w":0.46090535481770833,"t":"are dry enough for us to walk to the island without getting wet.","x":0.20781892741975347,"y":0.80668604640394126},{"h":0.013082577286395614,"t":"Sounds good.","w":0.10542573928833007,"y":0.8200640011050192,"c":1,"x":0.20962324463936657},{"h":0.013081394460653373,"x":0.83333333303765822,"t":"Q1","y":0.35319767469917918,"w":0.026748971939086763,"c":1},{"t":"Q2","x":0.83333333303765822,"w":0.026748971939086763,"y":0.39680232586196984,"h":0.013081394460653484,"c":1},{"c":1,"x":0.83333333303765822,"t":"Q3","w":0.026748971939086763,"y":0.54069767469917918,"h":0.013081394460653373},{"t":"Q4","x":0.83333333286619049,"y":0.5843023254093358,"w":0.026748971939086985,"c":1,"h":0.013081395583944722},{"y":0.64244186031217454,"w":0.026748971939086985,"c":1,"x":0.83333333286619049,"h":0.011627907185728592,"t":"Q5"},{"y":0.8052325578911671,"w":0.026748971939086874,"h":0.013081395583944722,"t":"Q6","x":0.83333333302222612,"c":1},{"y":0.86773255795657411,"w":0.024691357612609863,"t":"96","h":0.013081395583944722,"c":1,"x":0.11728395072044402},{"h":0.03375352650564889,"t":"IELTSXpress.com","w":0.30612678527832038,"y":0.95314993796778535,"c":1,"x":0.66991655033568553}],"h":3395,"w":2400}