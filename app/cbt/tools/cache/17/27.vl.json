{"blocks":[{"l":"header","b":[0.7475,0.0191,0.8629,0.03],"t":"雅思、托福等快速保分解决方案"},{"l":"header_image","b":[0.6542,0.0071,0.73,0.0748],"t":""},{"l":"header","b":[0.7688,0.0448,0.8408,0.0554],"t":"微信1718867188"},{"l":"paragraph_title","b":[0.1004,0.0954,0.2704,0.1113],"t":"Questions 28–30"},{"l":"text","b":[0.0996,0.1287,0.4196,0.1446],"t":"Choose the correct letter, A, B or C."},{"l":"text","b":[0.0975,0.1543,0.8588,0.187],"t":"28 The students think the story of Romeo and Juliet is still relevant for young people today because"},{"l":"text","b":[0.1421,0.1968,0.5433,0.2118],"t":"A it illustrates how easily conflict can start."},{"l":"text","b":[0.1425,0.2138,0.6025,0.2289],"t":"B it deals with problems that families experience."},{"l":"text","b":[0.1425,0.2303,0.5033,0.2457],"t":"C it teaches them about relationships."},{"l":"text","b":[0.0983,0.2554,0.7446,0.2716],"t":"29 The students found watching Romeo and Juliet in another language"},{"l":"text","b":[0.1425,0.2816,0.2863,0.2969],"t":"A frustrating."},{"l":"text","b":[0.1433,0.299,0.295,0.3134],"t":"B demanding."},{"l":"text","b":[0.1425,0.3158,0.2608,0.3305],"t":"C moving."},{"l":"text","b":[0.0988,0.3399,0.8525,0.3564],"t":"30 Why do the students think Shakespeare's plays have such international appeal?"},{"l":"text","b":[0.1412,0.3667,0.4025,0.3817],"t":"A The stories are exciting."},{"l":"text","b":[0.1421,0.3835,0.5004,0.3982],"t":"B There are recognisable characters."},{"l":"text","b":[0.1425,0.3997,0.5325,0.4156],"t":"C They can be interpreted in many ways."},{"l":"footer","b":[0.6062,0.8627,0.8304,0.8822],"t":"→ p. 121 p. 103"},{"l":"number","b":[0.8588,0.8648,0.8858,0.8801],"t":"35"},{"l":"footer","b":[0.6708,0.9538,0.9767,0.9803],"t":"IELTSXpress.com"}]}