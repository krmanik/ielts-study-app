{"w":2400,"lines":[{"x":0.063917526846645714,"h":0.01453488361674482,"t":"Test 2","w":0.06391752243041994,"y":0.043604651069534595,"c":1},{"t":"really hoped for was to find the Mary","x":0.059793820753270333,"h":0.015988371754420583,"c":1,"w":0.37113400777180983,"y":0.093023255977779384},{"w":0.42061856587727864,"h":0.016147974163241319,"y":0.11186142075728567,"c":1,"t":"Rose. Ordinary search techniques proved","x":0.061855665412389078},{"c":1,"x":0.061855674526268181,"t":"unsatisfactory, so McKee entered into","w":0.37938143412272135,"y":0.12936046494888598,"h":0.018907298358552094},{"y":0.14573739967163124,"c":1,"h":0.020657566807512184,"w":0.38606854756673176,"t":"collaboration with Harold E. Edgerton,","x":0.061635868609991269},{"c":1,"w":0.4041237131754557,"t":"professor of electrical engineering at the","h":0.016147974163241319,"x":0.061855669084205304,"y":0.16705813294969785},{"y":0.18272793187877867,"x":0.061617146818486027,"h":0.020917279819705814,"c":1,"t":"Massachusetts Institute of Technology.","w":0.39022842407226566},{"x":0.059431588611221005,"t":"In 1967, Edgerton's side-scan sonar","y":0.19922752319855741,"w":0.36974980672200519,"c":1,"h":0.024457743359676098},{"h":0.01614797416324143,"w":0.36494845072428383,"c":1,"y":0.22372284190806335,"x":0.059793815779860038,"t":"systems revealed a large, unusually"},{"x":0.061694959689487516,"w":0.38176376342773438,"c":1,"h":0.019564052364508311,"y":0.24018235308245539,"t":"shaped object, which McKee believed"},{"w":0.20206185658772785,"h":0.016147974163241319,"c":1,"t":"was the Mary Rose.","x":0.061855669601830435,"y":0.26012918390002548},{"h":0.018745342843755175,"w":0.35097951253255205,"y":0.29533808798539329,"t":"Further excavations revealed stray","c":1,"x":0.061619911207997972},{"w":0.37525772094726567,"h":0.017615971814445075,"c":1,"y":0.31532589566859737,"t":"pieces of timber and an iron gun. But","x":0.059793819831873853},{"h":0.021707581829758626,"c":1,"x":0.059529979396948152,"y":0.33017647587004817,"t":"the climax to the operation came when,","w":0.40271331787109377},{"c":1,"y":0.35173223711796098,"x":0.059793815233429845,"w":0.39587628682454423,"h":0.017453809660879616,"t":"on 5 May 1971, part of the ship's frame"},{"x":0.059793819882037316,"h":0.016147974163241319,"t":"was uncovered. McKee and his team","y":0.37052260717988217,"c":1,"w":0.37525772094726562},{"c":1,"y":0.38953488388566349,"t":"now knew for certain that they had found","w":0.4103092702229818,"h":0.015988371754420583,"x":0.059793818407802207},{"t":"the wreck, but were as yet unaware","h":0.017615971814445075,"c":1,"w":0.3608247375488281,"x":0.057731960985300458,"y":0.4083969466363162},{"y":0.42718731647063357,"h":0.013219660335054617,"t":"that it also housed a treasure trove of","c":1,"x":0.057731956433554783,"w":0.38144330342610677},{"y":0.44442999187637766,"h":0.019166920651286334,"c":1,"x":0.059664418110278061,"w":0.39611218770345052,"t":"beautifully preserved artefacts. Interest"},{"h":0.017615971814445075,"c":1,"x":0.057731965089775766,"t":"in the project grew, and in 1979, The","y":0.46359365827060284,"w":0.37113400777180994},{"w":0.41674186706542971,"t":"Mary Rose Trust was formed, with Prince","y":0.48077533736425626,"h":0.01982515416842523,"x":0.059655290169380822,"c":1},{"y":0.49752830000549253,"w":0.41685951232910157,"c":1,"h":0.020364007597031164,"x":0.059627951121483329,"t":"Charles as its President and Dr Margaret"},{"y":0.51879036990401162,"w":0.36494845072428383,"c":1,"t":"Rule its Archaeological Director. The","h":0.017615971814445075,"x":0.0618556714343921},{"t":"decision whether or not to salvage the","y":0.53751162645293593,"w":0.3857983144124349,"h":0.018019062452153789,"c":1,"x":0.059657590419638022},{"t":"wreck was not an easy one, although","y":0.55666470923978328,"c":1,"x":0.059793819850000221,"w":0.37525772094726562,"h":0.017463198004928127},{"c":1,"h":0.013211978860833917,"t":"an excavation in 1978 had shown that it","w":0.40206184387207033,"x":0.059793820263993498,"y":0.57545507907198334},{"t":"might be possible to raise the hull. While","w":0.40824742635091144,"y":0.5930232555352758,"c":1,"h":0.017441861012089777,"x":0.059793812486056294},{"y":0.61186142075684602,"h":0.016147974163241319,"w":0.40824742635091149,"t":"the original aim was to raise the hull if at","c":1,"x":0.059793812488382087},{"x":0.057731964484413346,"c":1,"h":0.0174538091008829,"w":0.40206184387207028,"y":0.63081395376589144,"t":"all feasible, the operation was not given"},{"h":0.01889534914976565,"x":0.057731973954286107,"y":0.64825581360825679,"c":1,"t":"the go-ahead until January 1982, when all","w":0.42680409749348958},{"c":1,"t":"the necessary information was available.","w":0.41237113952636717,"h":0.01614797416324143,"x":0.057731955904702467,"y":0.66705813295013006},{"x":0.059793810254470732,"c":1,"y":0.70493247228561062,"w":0.38969072977701824,"h":0.015997760098469094,"t":"An important factor in trying to salvage"},{"y":0.72225484413887597,"x":0.057731955513651768,"w":0.38556701660156251,"h":0.017615971814445075,"c":1,"t":"the Mary Rose was that the remaining"},{"t":"hull was an open shell. This led to an","c":1,"y":0.093023255954704176,"h":0.015988371754420583,"x":0.5237113448164008,"w":0.37938143412272129},{"t":"important decision being taken: namely to","x":0.52371133454803898,"y":0.1118614207554699,"h":0.01614797416324143,"c":1,"w":0.42474227905273432},{"h":0.015988371754420583,"y":0.1308139536511741,"x":0.5237113345981822,"c":1,"t":"carry out the lifting operation in three very","w":0.42474227905273443},{"t":"distinct stages. The hull was attached to","x":0.52349757408719921,"w":0.4107159423828125,"h":0.020837581094684587,"y":0.14599175485206417,"c":1},{"h":0.016147974163241319,"t":"a lifting frame via a network of bolts and","x":0.52371134508999739,"y":0.16705813295015304,"c":1,"w":0.40618555704752601},{"h":0.015988371754420694,"y":0.18604651179286358,"t":"lifting wires. The problem of the hull being","x":0.5237113345861385,"w":0.42474227905273432,"c":1},{"c":1,"x":0.5237113593274304,"h":0.014679976512037562,"t":"sucked back downwards into the mud was","y":0.20346447466585016,"w":0.43298965454101557},{"y":0.22100703124117438,"c":1,"h":0.020241287688402609,"w":0.39205301920572921,"t":"overcome by using 12 hydraulic jacks.","x":0.5235185077798894},{"y":0.24120848772354431,"w":0.4105472310384114,"t":"These raised it a few centimetres over a","h":0.016523098007623194,"c":1,"x":0.52358324943030032},{"t":"period of several days, as the lifting frame","x":0.52371134639110684,"h":0.017615971814445186,"c":1,"y":0.26012918403558594,"w":0.42886596679687505},{"t":"rose slowly up its four legs. It was only","h":0.015997760098469094,"c":1,"y":0.2790697675968864,"x":0.52371133519717983,"w":0.39381444295247392},{"y":0.29651162797546338,"x":0.52371135001787006,"c":1,"t":"when the hull was hanging freely from","w":0.38969070434570308,"h":0.017441859892096456},{"h":0.017615971814445075,"x":0.52371133735288933,"y":0.31679389299502059,"t":"the lifting frame, clear of the seabed and","w":0.41237113952636717,"c":1},{"y":0.33430232530259096,"x":0.52371134641549266,"c":1,"w":0.42886596679687505,"h":0.017441861012089777,"t":"the suction effect of the surrounding mud,"},{"y":0.35319767458380635,"h":0.015988371754420694,"x":0.52371134324606283,"w":0.41443298339843748,"t":"that the salvage operation progressed to","c":1},{"x":0.52371134232513306,"w":0.41855669657389327,"h":0.016147974163241319,"y":0.37199060507131043,"t":"the second stage. In this stage, the lifting","c":1},{"x":0.52371134509403006,"w":0.40618555704752601,"c":1,"t":"frame was fixed to a hook attached to a","y":0.38953488375956469,"h":0.01453488361674482},{"t":"crane, and the hull was lifted completely","w":0.41051821390787768,"y":0.40710028027170453,"h":0.019062339034559228,"c":1,"x":0.52360241732820434},{"c":1,"x":0.52371134246390516,"w":0.36082473754882805,"y":0.4271873164704223,"h":0.013219660335054728,"t":"clear of the seabed and transferred"},{"h":0.018975271873451716,"x":0.5236110269045271,"w":0.38373023986816412,"t":"underwater into the lifting cradle. This","c":1,"y":0.44467838327240528},{"x":0.52371134323033453,"w":0.41443298339843737,"h":0.01614797416324143,"y":0.46359365814566089,"t":"required precise positioning to locate the","c":1},{"t":"legs into the 'stabbing guides' of the lifting","y":0.47965116244546602,"w":0.42680409749348958,"h":0.01889534914976565,"c":1,"x":0.5237113549439768},{"c":1,"t":"cradle. The lifting cradle was designed","w":0.39175257364908855,"y":0.50145348853679994,"x":0.52371134194782198,"h":0.015988371754420583},{"c":1,"x":0.52147037555674725,"t":"to fit the hull using archaeological survey","w":0.41892392476399742,"y":0.51805923957033539,"h":0.019895730547812573},{"t":"drawings, and was fitted with air bags to","x":0.52371134412562248,"w":0.41030927022298169,"h":0.017441859892096456,"c":1,"y":0.5377906977865099},{"t":"provide additional cushioning for the hull's","y":0.55666470923963984,"x":0.52371134642349315,"w":0.42886596679687505,"h":0.017463198004928127,"c":1},{"x":0.52371133735074182,"y":0.57545507919004513,"w":0.41237113952636717,"h":0.014679976512037562,"c":1,"t":"delicate timber framework. The third and"},{"t":"final stage was to lift the entire structure","x":0.52371134498454752,"w":0.40618555704752601,"c":1,"y":0.59302325609156459,"h":0.017441859892096345},{"y":0.61186142086505457,"t":"into the air, by which time the hull was","w":0.38969072977701813,"h":0.017615971814445075,"x":0.52164948031846947,"c":1},{"w":0.41443298339843759,"h":0.017453809660879616,"y":0.63081395320882927,"t":"also supported from below. Finally, on 11","x":0.52371134328861058,"c":1},{"t":"October 1982, millions of people around","w":0.40824742635091149,"h":0.015988371754420583,"c":1,"x":0.52371133826731997,"y":0.64970930249082481},{"c":1,"t":"the world held their breath as the timber","w":0.40618555704752601,"y":0.66705813283331206,"x":0.52371134507838746,"h":0.014679976512037674},{"y":0.68604651179224285,"h":0.015988371754420694,"w":0.42886596679687505,"t":"skeleton of the Mary Rose was lifted clear","x":0.52371134637296557,"c":1},{"w":0.43092783610026042,"c":1,"t":"of the water, ready to be returned home to","x":0.52371133956093996,"h":0.017451249356138288,"y":0.70493247184239005},{"c":1,"x":0.52347787302221327,"t":"Portsmouth.","y":0.72269890859815933,"w":0.12627971649169922,"h":0.015304681908993367},{"y":0.94767441865974977,"h":0.015988371754420694,"t":"42","x":0.055670102553698954,"c":1,"w":0.030927836100260418},{"c":1,"w":0.29138303120930992,"t":"leltsresources.org","x":0.35225085358620672,"h":0.021137844585210397,"y":0.95436135787191323}],"h":3406}