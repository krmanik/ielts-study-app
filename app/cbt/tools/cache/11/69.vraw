{"h":3406,"lines":[{"h":0.015032531370923419,"t":"Test 3","x":0.069987029467791395,"y":0.04771629242901898,"c":1,"w":0.062087796529134126},{"c":1,"x":0.0677738454531151,"y":0.088640699619747298,"h":0.021858705889107655,"t":"become sensitive to blue light (from the","w":0.38819689432779947},{"y":0.10815451409135379,"w":0.37767707824707025,"h":0.020031768297071095,"t":"sky) when it's time for takeoff on their","c":1,"x":0.065795711215768479},{"w":0.39175257364908861,"y":0.12936046495480991,"c":1,"x":0.06804123884329305,"h":0.018907298358552094,"t":"big journey, and sensitive to yellow light"},{"y":0.14825581367504659,"t":"(reflected from tender young leaves) when","h":0.017441861012089777,"x":0.065979384486934023,"w":0.41443298339843748,"c":1},{"t":"It's appropriate to land. Birds will fatten","y":0.1651800245672117,"w":0.38384788513183599,"x":0.065848148356915132,"h":0.020013248087445534,"c":1},{"w":0.40824742635091149,"y":0.18604651179239251,"x":0.068041235161396776,"c":1,"t":"themselves with heavy teeding in advance","h":0.015988371754420583},{"x":0.068041243336496443,"c":1,"t":"of a long migrational flight. The value of his","y":0.20346447451610383,"h":0.017465758309669455,"w":0.42886596679687505},{"w":0.41030927022298175,"t":"definition, Dingle argues, is that it focuses","x":0.068041241061519972,"y":0.22225484413921825,"h":0.017615971814445075,"c":1},{"h":0.015988371754420694,"w":0.35051546732584637,"y":0.24127906977685942,"x":0.068041236563880947,"c":1,"t":"attention on what the phenomenon"},{"x":0.068041236226319246,"t":"of wildebeest migration shares with","h":0.017615971814445075,"w":0.34639175415039064,"y":0.260129184035363,"c":1},{"x":0.067879895703430906,"c":1,"y":0.27599004205050992,"t":"the phenomenon of the aphids, and","w":0.35288220723470054,"h":0.020821126152750891},{"x":0.067920994185783692,"y":0.29626358851716494,"h":0.0187887291451867,"c":1,"t":"therefore helps guide researchers towards","w":0.40641868591308589},{"c":1,"w":0.42886596679687505,"x":0.068041243354527367,"y":0.3153258956673578,"t":"understanding how evolution has produced","h":0.017615971814445186},{"t":"them all.","w":0.091963774363199871,"x":0.063333972080762038,"y":0.33383545688832095,"c":1,"h":0.016736268577194902},{"c":1,"y":0.3705226074179514,"w":0.38144330342610677,"h":0.019083969465648831,"t":"Human behaviour, however, is having a","x":0.065979379089548137},{"t":"detrimental impact on animal migration.","h":0.015988371754420694,"w":0.3979381561279296,"x":0.063917519746317694,"y":0.38953488388504054,"c":1},{"c":1,"x":0.063749222997077623,"t":"The pronghorn, which resembles an","y":0.40592442113997018,"w":0.35083208719889319,"h":0.01962080690626955},{"w":0.36082473754882816,"c":1,"x":0.063917528041393529,"y":0.42718731626006246,"t":"antelope, though they are unrelated,","h":0.017615971814445075},{"w":0.37938143412272129,"h":0.014534883616744709,"t":"is the fastest land mammal of the New","y":0.44476744190612649,"c":1,"x":0.063917530244542081},{"x":0.06391752382219304,"y":0.46359365827109322,"w":0.40824742635091149,"h":0.017615971814445075,"c":1,"t":"World. One population, which spends the"},{"w":0.4041237131754557,"h":0.014534883616744709,"c":1,"y":0.48255813958151217,"x":0.063917524767205885,"t":"summer in the mountainous Grand Teton"},{"w":0.42680414835611979,"x":0.065979369052542397,"h":0.018895349149765539,"c":1,"t":"National Park of the western USA, follows a","y":0.49999999983377696},{"t":"narrow route from its summer range in the","y":0.51879036990164407,"x":0.065979377707112458,"h":0.017615971814445186,"w":0.41649485270182296,"c":1},{"x":0.067788643908850948,"c":1,"t":"mountains, across a river, and down onto","w":0.40050130208333334,"h":0.022894679555036213,"y":0.53642835256717325},{"x":0.063917520675180556,"h":0.01614797416324143,"y":0.55666470912309785,"t":"the plains. Here they wait out the frozen","w":0.39381444295247403,"c":1},{"h":0.021344371354376945,"w":0.36735033671061201,"y":0.57224585883410328,"c":1,"t":"months, feeding mainly on sagebrush","x":0.063748441399845077},{"x":0.065697961221287265,"t":"blown clear of snow. These pronghorn are","c":1,"w":0.41288948059082031,"h":0.021271571788239019,"y":0.59068973411443459},{"h":0.017615971814445075,"t":"notable for the invariance of their migration","y":0.61186142087337136,"w":0.42680414835611974,"x":0.063917513354947886,"c":1},{"t":"route and the severity of its constriction","x":0.061855672768799226,"y":0.6308139536511741,"w":0.38762886047363287,"c":1,"h":0.015988371754420583},{"w":0.37113400777180988,"t":"at three bottlenecks. It they can't pass","x":0.063917532080504547,"c":1,"h":0.015988371754420583,"y":0.64970930248958847},{"y":0.66705813250291901,"x":0.061855675487191966,"w":0.37525772094726562,"c":1,"h":0.017615971814445186,"t":"through each of the three during their"},{"w":0.38144330342610677,"x":0.061855667777005581,"y":0.68604651134922923,"h":0.017441861012089777,"c":1,"t":"spring migration, they can't reach their"},{"c":1,"t":"bounty of summer grazing; if they can't","w":0.3878429921468099,"y":0.70342390964647916,"x":0.063814317919560604,"h":0.020001311198585725},{"t":"pass through again in autumn, escaping","y":0.091414993612329409,"x":0.53388520356419888,"h":0.020464661397166739,"c":1,"w":0.39200785319010412},{"y":0.10783934650459603,"w":0.40249565124511721,"h":0.020557681322797783,"c":1,"t":"south onto those windblown plains, they","x":0.53178497113114476},{"h":0.017441859892096456,"c":1,"y":0.12936046539623192,"x":0.5340206225576819,"t":"are likely to die trying to overwinter in the","w":0.4103092702229818},{"y":0.14825581367410912,"h":0.017441861012089777,"w":0.3731958770751953,"t":"deep snow. Pronghorn, dependent on","x":0.53402061803874668,"c":1},{"x":0.53608246860859066,"w":0.42474227905273432,"h":0.016147974163241319,"c":1,"t":"distance vision and speed to keep sate from","y":0.16705813295015304},{"t":"predators, traverse high, open shoulders","x":0.53389203504425498,"y":0.18439754814841192,"h":0.020460221743625717,"c":1,"w":0.39406092325846354},{"w":0.38969072977701824,"t":"of land, where they can see and run. At","h":0.017465758309669566,"x":0.53402061436795178,"c":1,"y":0.20346447451598348},{"y":0.22225484425491371,"t":"one of the bottlenecks, forested hills rise to","w":0.42474227905273454,"c":1,"h":0.019083969465648831,"x":0.53402061293313208},{"w":0.42680414835611968,"h":0.017441861012089777,"x":0.5319587504611154,"y":0.24127906948970101,"t":"form a V, leaving a corridor of open ground","c":1},{"y":0.26012918403558594,"h":0.017615971814445186,"t":"only about 150 metres wide, filled with","x":0.5340206153099063,"c":1,"w":0.38556701660156256},{"t":"private homes. Increasing development is","y":0.27906976760414937,"x":0.53402062434267705,"w":0.40206184387207033,"h":0.015997760098469094,"c":1},{"x":0.53195876683510945,"y":0.29796511600068365,"w":0.41030927022298169,"t":"leading toward a crisis tor the pronghorn,","h":0.017441861012089777,"c":1},{"x":0.53195875834824302,"c":1,"y":0.31532589564384272,"t":"threatening to choke off their passageway.","w":0.42061856587727864,"h":0.017615971814445075},{"c":1,"x":0.53195875686677951,"y":0.35319767458300155,"w":0.39793815612792971,"t":"Conservation scientists, along with some","h":0.015988371754420583},{"w":0.39417320251464838,"h":0.019863287701161525,"c":1,"t":"biologists and land managers within the","x":0.53177065487551967,"y":0.36929249298400246},{"y":0.38808139531828389,"w":0.3690721638997394,"x":0.53195875977693441,"h":0.015988371754420583,"c":1,"t":"USA's National Park Service and other"},{"w":0.37966489156087235,"t":"agencies, are now working to preserve","h":0.017631259723334125,"x":0.53182389069748581,"y":0.40885168058426102,"c":1},{"t":"migrational behaviours, not just species","y":0.42452536536398922,"w":0.38799102783203121,"h":0.021452712788696648,"c":1,"x":0.53178942724687395},{"t":"and habitats. A National Forest has","h":0.018768508785693583,"y":0.44457809549055816,"c":1,"x":0.53183053754932386,"w":0.344591573079427},{"t":"recognised the path of the pronghorn,","c":1,"y":0.4626666430916252,"x":0.52979474387342185,"w":0.38374382019042963,"h":0.019946227686865714},{"y":0.48255813925503133,"h":0.017441861012089777,"w":0.4103092702229818,"c":1,"t":"much of which passes across its land, as a","x":0.53195876685479693},{"h":0.015988371754420583,"c":1,"x":0.52989690713518223,"y":0.50145348853576466,"w":0.40000000000000002,"t":"protected migration corridor. But neither"},{"y":0.52025836743902543,"w":0.3731958770751953,"x":0.5298969067255962,"t":"the Forest Service nor the Park Service","h":0.013211978860833806,"c":1},{"t":"can control what happens on private","h":0.021562339975353728,"y":0.53585499757286703,"x":0.52961571323471934,"w":0.36344225565592447,"c":1},{"x":0.52783505008255016,"y":0.55666470912154165,"h":0.016147974163241319,"t":"land at a bottleneck. And with certain","w":0.37731959025065109,"c":1},{"w":0.39814689636230471,"c":1,"x":0.52979027476791996,"h":0.019945183853086745,"y":0.57405248877682002,"t":"other migrating species, the challenge is"},{"t":"complicated further - by vastly greater","x":0.52989691052626819,"h":0.017441859892096456,"y":0.59302325592604477,"w":0.37938143412272141,"c":1},{"x":0.52989691151595897,"y":0.61186142080672645,"h":0.019083969465648831,"c":1,"w":0.37938143412272141,"t":"distances traversed, more jurisdictions,"},{"c":1,"y":0.63081395375984606,"w":0.42886596679687494,"h":0.0174538091008829,"t":"more borders, more dangers along the way.","x":0.52989691329903854},{"t":"We will require wisdom and resoluteness to","h":0.015988371754420694,"y":0.64970930249098313,"c":1,"x":0.52371135137375124,"w":0.43505152384440104},{"y":0.66705813285361337,"c":1,"w":0.43298965454101568,"x":0.52371135644083244,"h":0.017615971814445075,"t":"ensure that migrating species can continue"},{"y":0.68604651190378163,"w":0.31340207417805988,"t":"their journeying a while longer.","x":0.52371133392178226,"h":0.017441859892096456,"c":1},{"c":1,"w":0.028865979512532551,"y":0.95348837208455395,"x":0.059793814264352284,"t":"70","h":0.01453488361674482},{"c":1,"h":0.022583511809496359,"t":"leltsresources.org","y":0.95433624955947682,"w":0.29146217346191411,"x":0.35219444028158703}],"w":2400}