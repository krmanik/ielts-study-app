{"lines":[{"y":0.038559117514124441,"h":0.015905020171169348,"t":"Test 1","w":0.064518839518229176,"c":1,"x":0.059493157458514738},{"w":0.42268040974934895,"h":0.018905590368731184,"c":1,"y":0.087199060714145737,"t":"floating objects displace their own weight","x":0.057731961852129622},{"t":"in water. So when a boat enters a gondola,","y":0.10745742833703587,"x":0.053608244949185986,"w":0.43917526245117183,"h":0.017615971814445186,"c":1},{"w":0.41237113952636717,"h":0.017441861012089777,"x":0.05773195590637973,"c":1,"t":"the amount of water leaving the gondola","y":0.12645348809404033},{"c":1,"h":0.019583421529074441,"x":0.055575153514221542,"t":"weighs exactly the same as the boat. This","y":0.14381055133833742,"w":0.42081273396809893},{"c":1,"y":0.16265414008170986,"w":0.428865966796875,"t":"keeps the Wheel balanced and so, despite","h":0.019083969465648831,"x":0.057731965014830092},{"c":1,"h":0.021786396880046244,"t":"its enormous mass, it rotates through 180°","y":0.18144382510944934,"w":0.42931004842122394,"x":0.055498047704537659},{"y":0.198317274435026,"w":0.42325838724772136,"h":0.021953008207096003,"c":1,"t":"in five and a half minutes while using very","x":0.053319485679118844},{"h":0.017458076275451928,"c":1,"x":0.053608235019534621,"w":0.42680414835611979,"t":"little power. It takes just 1.5 kilowatt-hours","y":0.21947674445802157},{"w":0.4041237131754557,"t":"(5.4 MJ) of energy to rotate the Wheel -","h":0.018895349149765539,"x":0.055670102058403094,"y":0.23837209286128636,"c":1},{"w":0.39822998046874997,"h":0.022478338836293688,"t":"roughly the same as boiling eight small","y":0.25418337313682904,"x":0.055530310296548181,"c":1},{"t":"domestic kettles of water.","x":0.055361120336042687,"y":0.27388669447942293,"w":0.26046272277832033,"h":0.019838643368033981,"c":1},{"w":0.39587628682454423,"h":0.017615971814445075,"c":1,"x":0.055670103903953772,"y":0.31385789778355433,"t":"Boats needing to be lifted up enter the"},{"y":0.33139534880665589,"w":0.37938143412272129,"h":0.015988371754420694,"t":"canal basin at the level of the Forth &","c":1,"x":0.053608253505649607},{"t":"Clyde Canal and then enter the lower","w":0.37938143412272129,"x":0.055670107551140262,"y":0.3502642397925122,"h":0.017468318614410894,"c":1},{"t":"gondola of the Wheel. Two hydraulic steel","w":0.42680414835611979,"c":1,"y":0.36905460941431423,"h":0.017615971814445186,"x":0.05567009067997622},{"c":1,"t":"gates are raised, so as to seal the gondola","x":0.0556700907028502,"y":0.38808139506933603,"w":0.42680414835611979,"h":0.017441861012089777},{"c":1,"y":0.40473376641471837,"x":0.053536649292874848,"t":"off from the water in the canal basin. The","w":0.41461652119954429,"h":0.018458090315688236},{"w":0.4164948527018229,"c":1,"t":"water between the gates is then pumped","h":0.017463198004928127,"y":0.42587209274466908,"x":0.055670099336675209},{"c":1,"x":0.055670098905132095,"y":0.44476744213964658,"w":0.38969072977701824,"t":"out. A hydraulic clamp, which prevents","h":0.017441859892096345},{"c":1,"y":0.46159758791220384,"x":0.053469596098833706,"t":"the arms of the Wheel moving while the","h":0.0201078516836386,"w":0.40646301269531254},{"t":"gondola is docked, is removed, allowing","w":0.40618555704752601,"h":0.01889534914976565,"x":0.055670105213350446,"c":1,"y":0.48110465077032072},{"h":0.018816190261527255,"c":1,"t":"the Wheel to turn. In the central machine","x":0.051449205016811654,"y":0.49951906455730988,"w":0.41669319152832029},{"y":0.51686027306016935,"t":"room an array of ten hydraulic motors","x":0.051256293394619803,"w":0.38404167175292975,"h":0.022618182322871161,"c":1},{"h":0.019400593818669098,"c":1,"x":0.051445737254082032,"t":"then begins to rotate the central axle. The","w":0.42905766805013018,"y":0.53764078570613938},{"h":0.016147974163241319,"w":0.38350514729817708,"c":1,"t":"axle connects to the outer arms of the","x":0.053608253979777393,"y":0.55666470952820712},{"x":0.50927834857765031,"h":0.017441861012089666,"t":"Wheel, which begin to rotate at a speed","y":0.088662790419715476,"c":1,"w":0.40824742635091149},{"h":0.018290787952756959,"t":"of 1\/8 of a revolution per minute. As the","c":1,"w":0.40637545267740882,"x":0.50919239858480314,"y":0.10600684997925947},{"t":"wheel rotates, the gondolas are kept in","h":0.017441861012089666,"y":0.12645348809370693,"x":0.50927835133115418,"w":0.39587628682454434,"c":1},{"t":"the upright position by a simple gearing","y":0.14337663420820268,"w":0.41067059834798181,"c":1,"x":0.50705013165375645,"h":0.020581836218842242},{"y":0.16412213729184477,"w":0.41649485270182296,"t":"system. Two eight-metre-wide cogs orbit","h":0.017615971814445186,"c":1,"x":0.50721649105357602},{"w":0.36741856892903657,"c":1,"x":0.50706147484471475,"t":"a fixed inner cog of the same width,","y":0.17930987770700935,"h":0.021362192688167525},{"h":0.020925531930525931,"y":0.20002591589040319,"c":1,"t":"connected by two smaller cogs travelling","w":0.41474319458007813,"x":0.50913360692489162},{"h":0.019612695914608347,"x":0.50709064073205434,"t":"in the opposite direction to the outer cogs","y":0.218868234205009,"w":0.43529479980468744,"c":1},{"x":0.50705157745439333,"y":0.23606642970840463,"c":1,"t":"- so ensuring that the gondolas always","w":0.39625434875488275,"h":0.021832374846032176},{"c":1,"h":0.017615971814445075,"t":"remain level. When the gondola reaches","x":0.50721649197167451,"w":0.41237113952636728,"y":0.25719318826269122},{"h":0.017441861012089666,"c":1,"t":"the top, the boat passes straight onto the","x":0.50721648926451146,"y":0.2761627904184123,"w":0.42474227905273443},{"x":0.50701803420690472,"c":1,"y":0.29237687059749606,"t":"aqueduct situated 24 metres above the","w":0.40035789489746099,"h":0.020315301327304969},{"h":0.017739536758037522,"t":"canal basin.","c":1,"x":0.50709043141133503,"w":0.12431935628255208,"y":0.31259805572788979},{"t":"The remaining 11 metres of lift needed","x":0.50721649565989291,"y":0.35026423979402077,"w":0.39587628682454423,"h":0.017468318614410894,"c":1},{"w":0.40454859415690103,"c":1,"h":0.020522686011358648,"y":0.3662162298157976,"t":"to reach the Union Canal is achieved by","x":0.5070374669018094},{"c":1,"t":"means of a pair of locks. The Wheel could","x":0.50721648926245066,"w":0.42474227905273443,"y":0.38808139551323417,"h":0.015988371754420583},{"h":0.014679976512037562,"x":0.5072164910511503,"c":1,"y":0.4069289490775998,"t":"not be constructed to elevate boats over","w":0.41649485270182296},{"c":1,"h":0.01453488361674482,"t":"the full 35-metre difference between the","y":0.42587209307146212,"x":0.50515464313482916,"w":0.4103092702229818},{"c":1,"y":0.4429991195857661,"w":0.41473027547200525,"x":0.50501204962143253,"h":0.020429939364098981,"t":"two canals, owing to the presence of the"},{"t":"historically important Antonine Wall, which","h":0.019809372342479814,"w":0.43529535929361984,"x":0.50503377809206251,"y":0.4616415986405864,"c":1},{"t":"was built by the Romans in the second","y":0.48110465088405041,"x":0.50721649069154306,"c":1,"w":0.38969072977701813,"h":0.017441861012089777},{"x":0.5070128165039246,"c":1,"y":0.49859788591016851,"w":0.43335988362630218,"h":0.020884917612574272,"t":"century AD. Boats travel under this wall via"},{"h":0.019083969465648942,"y":0.51879036945028456,"w":0.43711339314778652,"t":"a tunnel, then through the locks, and finally","c":1,"x":0.50721649939126856},{"t":"on to the Union Canal.","x":0.50694894466373908,"y":0.53604322227148815,"w":0.23162055969238282,"h":0.019296964196268362,"c":1},{"h":0.013081395479068947,"c":1,"w":0.026804122924804684,"t":"22","y":0.95639534871758769,"x":0.049484536381240264},{"w":0.29147308349609374,"h":0.022623007254116145,"c":1,"y":0.95429937978979607,"x":0.35215268594653687,"t":"leltsresources.org"}],"h":3406,"w":2400}