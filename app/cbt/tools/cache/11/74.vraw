{"lines":[{"t":"Reading","y":0.035713886836145847,"x":0.86765450978194092,"h":0.017514121861438192,"w":0.093541736602783199,"c":1},{"w":0.18556700388590494,"x":0.061855673211686717,"h":0.014679976512037562,"c":1,"t":"Questions 27-34","y":0.085731062704832439},{"w":0.46391754150390624,"h":0.017441861012089777,"c":1,"y":0.12209302297834501,"x":0.059793806462658805,"t":"Reading Passage 3 has seven sections, A-G."},{"x":0.057731962068545785,"y":0.15988372109618909,"w":0.49896906534830732,"h":0.015988371754420583,"c":1,"t":"Which section contains the following information?"},{"w":0.6805393981933594,"h":0.021058609537425887,"t":"Write the correct letter, A-G, in boxes 27-34 on your answer sheet.","y":0.19478756513236239,"c":1,"x":0.059723327764272464},{"w":0.45182083129882811,"c":1,"x":0.059657377503966463,"y":0.23225756949450282,"t":"NB You may use any letter more than once.","h":0.019336110202970769},{"c":1,"x":0.05761754389693588,"t":"27 a reference to books that assume a lack of mathematical knowledge","y":0.26721421951755631,"w":0.73631230672200521,"h":0.020685656240108208},{"c":1,"x":0.057731950790792248,"y":0.29941860481789362,"h":0.015988371754420583,"t":"28 the way in which this is not a typical book about mathematics","w":0.66391754150390625},{"y":0.32703488344414011,"w":0.56907216389973958,"h":0.017441861012089777,"t":"29 personal examples of being helped by mathematics","c":1,"x":0.055670103510923684},{"w":0.74432988484700513,"y":0.35610465132978819,"c":1,"x":0.057731964689899468,"h":0.015988371754420583,"t":"30 examples of people who each had abilities that seemed incompatible"},{"y":0.38372093020200482,"t":"31 mention of different focuses of books about mathematics","h":0.015988371754420694,"x":0.055670101207799784,"w":0.62268040974934891,"c":1},{"t":"32 a contrast between reading this book and reading other kinds of publication","y":0.41276734850105024,"w":0.8104008992513021,"x":0.055622538956662124,"h":0.018408185093107488,"c":1},{"w":0.66413777669270835,"