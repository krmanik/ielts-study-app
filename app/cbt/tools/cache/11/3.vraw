{"lines":[{"y":0.10029069819321224,"w":0.26185567220052081,"c":1,"h":0.027616277975820447,"t":"Introduction","x":0.072164947356503736},{"y":0.16705813250727952,"x":0.072164937252420222,"w":0.84948455810546875,"h":0.017615971814445075,"t":"The International English Language Testing System (IELTS) is widely recognised as","c":1},{"h":0.017441861012089888,"x":0.072164939138676235,"y":0.18604651134922912,"t":"a reliable means of assessing the language ability of candidates who need to study","w":0.84123713175455728,"c":1},{"c":1,"w":0.8352563476562499,"t":"or work where English is the language of communication. These Practice Tests are","x":0.074117143318632187,"y":0.20311209049592804,"h":0.020847540075332294},{"t":"designed to give future IELTS candidates an idea of whether their English is at the","w":0.82886596679687496,"h":0.017615971814445075,"c":1,"x":0.074226810307290142,"y":0.22372284202793069},{"h":0.015988371754420583,"t":"required level.","y":0.24273255828304852,"w":0.14845361073811847,"c":1,"x":0.072164947214911498},{"y":0.26015682145288477,"t":"ELTS is owned by three partners, Cambridge English Language Assessment, part of","x":0.094805369849422713,"h":0.020260810292054066,"w":0.86402201334635431,"c":1},{"c":1,"t":"the University of Cambridge, the British Council and IDP Education Pty Limited (through","w":0.88865976969401039,"y":0.27906976728039123,"x":0.07216496036597779,"h":0.018933755960873322},{"w":0.87651814778645853,"t":"its subsidiary company, IELTS Australia Pty Limited). Further information on IELTS can","h":0.02302133736019607,"c":1,"x":0.072048649552731658,"y":0.2950178392974534},{"y":0.31606040527281398,"t":"be found on the lELTS website www.ielts.org.","x":0.072081559213541008,"w":0.46203725179036459,"c":1,"h":0.016971911252840033},{"t":"WHAT IS THE TEST FORMAT?","c":1,"x":0.074226805320629127,"h":0.016147974163241319,"y":0.36905460929981282,"w":0.42268040974934895},{"x":0.07010309162317592,"w":0.86185567220052084,"y":0.40839694664069892,"h":0.017615971814445186,"c":1,"t":"ELTS consists of four components. All candidates take the same Listening and Speaking"},{"t":"tests. There is a choice of Reading and Writing tests according to whether a candidate is","y":0.42718731670639976,"c":1,"x":0.072164967751140813,"w":0.85567006429036463,"h":0.016147974163241319},{"t":"taking the Academic or General Training module.","h":0.015988371754420694,"c":1,"x":0.07010309477362299,"y":0.44622093039822563,"w":0.47628865559895839},{"y":0.48110465108313982,"h":0.013081395479069058,"w":0.10515464146931966,"c":1,"t":"Academic","x":0.088659792550563526},{"h":0.018041685197329627,"y":0.49849037047741129,"w":0.33218963623046877,"c":1,"x":0.086473627752895077,"t":"For candidates wishing to study at"},{"x":0.086487495823044283,"y":0.51695427143994799,"w":0.37140139261881511,"h":0.017989179350247575,"t":"undergraduate or postgraduate levels,","c":1},{"h":0.015988371754420694,"c":1,"x":0.08659794000757591,"t":"and for those seeking professional","y":0.53633720946496499,"w":0.33402061462402344},{"x":0.084407055413645654,"w":0.11984568277994792,"h":0.016975295312671945,"c":1,"t":"registration.","y":0.55473909649981756},{"t":"General Training","x":0.48822695257810284,"y":0.47873581902026796,"c":1,"h":0.01862376084834505,"w":0.17414004007975264},{"w":0.38580210367838541,"h":0.018259187901083052,"c":1,"t":"For candidates wishing to migrate to an","x":0.48646444256939181,"y":0.49848298036382077},{"y":0.51732237201886877,"c":1,"x":0.48659794746123342,"t":"English-speaking country (Australia, Canada,","h":0.017615971814445075,"w":0.44329895019531251},{"h":0.017441861012089777,"t":"New Zealand, UK), and for those wishing to","w":0.42474227905273443,"c":1,"y":0.53633720902393944,"x":0.48865978818937472},{"t":"train or study at below degree level.","x":0.48659793633520243,"y":0.55519671179762498,"h":0.016147974163241319,"c":1,"w":0.35051546732584637},{"t":"The test components are taken in the following order:","y":0.59738372109632332,"c":1,"x