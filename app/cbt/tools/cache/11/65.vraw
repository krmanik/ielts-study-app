{"w":2400,"h":3406,"lines":[{"t":"Test 3","c":1,"x":0.069935466567079996,"y":0.046172883129306452,"h":0.016665860196806381,"w":0.064252777099609387},{"w":0.38762886047363282,"x":0.072164951115662748,"c":1,"t":"wool to the Last. It was named the Silk","y":0.091569767489627307,"h":0.01453488361674482},{"t":"Road after its most precious commodity,","x":0.071974344490293538,"y":0.10773640195444389,"w":0.40454335530598956,"h":0.018791235690248431,"c":1},{"h":0.01453488361674482,"c":1,"t":"which was considered to be worth more","x":0.070103098641532899,"y":0.12790697678752283,"w":0.40206184387207028},{"c":1,"t":"than gold. The Silk Road stretched over","x":0.068041231123565832,"y":0.14679976487961399,"h":0.015990932619158738,"w":0.39793815612792971},{"y":0.16559013518056509,"x":0.070103094497620658,"w":0.39175257364908855,"h":0.017615971814445075,"c":1,"t":"6,000 kilometres from Eastern China to"},{"w":0.36907216389973951,"x":0.070103093201701133,"y":0.18459302342035677,"t":"the Mediterranean Sea, following the","c":1,"h":0.015988371754420694},{"c":1,"x":0.070001849310100922,"t":"Great Wall of China, climbing the Pamir","y":0.20177651653963413,"h":0.018957327340395347,"w":0.39813667297363287},{"x":0.067892695875028483,"y":0.22047560437869751,"w":0.37968610127766933,"t":"mountain range, crossing modern-day","h":0.02055912835417395,"c":1},{"w":0.38969072977701824,"c":1,"y":0.23982558167504564,"t":"Afghanistan and going on to the Middle","h":0.017441859892096456,"x":0.070103088620672618},{"c":1,"t":"East, with a major trading market in","y":0.25866118614993439,"w":0.36082473754882816,"h":0.017615971814445075,"x":0.070103095036950641},{"t":"Damascus. From there, the merchandise","h":0.018919246447345328,"y":0.27761627890832663,"w":0.40206184387207033,"c":1,"x":0.070103098574921988},{"t":"was shipped across the Mediterranean","x":0.070103096331752587,"h":0.015988371754420694,"y":0.2965116280692035,"w":0.38350514729817708,"c":1},{"y":0.3153258953186755,"t":"Sea. Few merchants t