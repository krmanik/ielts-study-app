{"lines":[{"c":1,"h":0.01453488361674482,"x":0.072164953250091438,"w":0.1237113316853841,"t":"Introduction","y":0.049418604557906698},{"x":0.076288660308186373,"w":0.11134020487467447,"t":"Speaking","y":0.097383721193792683,"h":0.017441859892096456,"c":1},{"y":0.12354651179505349,"h":0.015988371754420583,"c":1,"x":0.07628865286963446,"t":"This test takes between 11 and 14 minutes and is conducted by a trained examiner.","w":0.80206186930338541},{"t":"There are three parts:","w":0.21237113952636721,"h":0.014679976512037562,"c":1,"x":0.076288656927762155,"y":0.14239577222398103},{"t":"Part 1","h":0.013211978860833806,"x":0.076288658642007623,"y":0.1729301231191418,"w":0.061855672200520823,"c":1},{"t":"The candidate and the examiner introduce themselves. Candidates then answer general","h":0.017615971814445075,"y":0.19465648832610238,"x":0.076288667293898313,"w":0.851546376546224,"c":1},{"w":0.86391754150390621,"h":0.01889534914976565,"y":0.21366279053820447,"t":"questions about themseives, their home\/family, their job\/studies, their interests and a wide","c":1,"x":0.076288651798548421},{"c":1,"h":0.016147974163241319,"y":0.23253082810443948,"w":0.79175257364908846,"x":0.074226805857813355,"t":"range of similar familiar topic areas. This part lasts between four and five minutes."},{"t":"Part 2","x":0.074226805695688416,"w":0.06391752243041994,"y":0.26306517899161919,"h":0.014679976512037562,"c":1},{"w":0.85773193359375,"h":0.016147974163241319,"t":"The candidate is given a task card with prompts and is asked to talk on a particular topic.","c":1,"x":0.074226816603155429,"y":0.286259541852532},{"t":"The candidate has one minute to prepare and they can make some notes if they wish,","h":0.017441861012089666,"c":1,"y":0.30523255786384595,"x":0.074226803495480456,"w":0.83092783610026033},{"h":0.015988371754420583,"x":0.074226815292743997,"w":0.83505152384440096,"y":0.32412790714404194,"c":1,"t":"before speaking for between one and two minutes. The examiner then asks one or two"},{"c":1,"t":"questions on the same topic.","w":0.28041236877441411,"y":0.34145625347998287,"h":0.01614797416324143,"x":0.074226805214299724},{"y":0.37199060481771906,"t":"Part 3","x":0.076288658642007623,"w":0.061855672200520823,"h":0.013211978860833806,"c":1},{"c":1,"t":"The examiner and the candidate engage in a discussion of more abstract issues which are","x":0.074226812929558725,"y":0.39534883737661497,"h":0.015988371754420694,"w":0.87422678629557293},{"y":0.41279069739757768,"c":1,"x":0.074226802492353181,"t":"thematically linked to the topic in Part 2. The discussion lasts between four and five minutes.","w":0.89278350830078135,"h":0.017441861012089777},{"x":0.074226816610449955,"y":0.43893129766823524,"w":0.85773193359375,"t":"The Speaking test assesses whether candidates can communicate effectively in English.","h":0.017464051439841977,"c":1},{"w":0.89690724690755197,"h":0.017615971814445075,"c":1,"y":0.45918966517731286,"t":"The assessment takes into account Fluency and Coherence, Lexical Resource, Grammatical","x":0.074226788814265116},{"w":0.8845361328125001,"x":0.07422677884881286,"y":0.47674418577020261,"h":0.017441861012089777,"t":"Range and Accuracy, and Pronunciation. More information on assessing the Speaking test,","c":1},{"y":0.49559600718736663,"w":0.88453613281249999,"h":0.017615971814445186,"c":1,"x":0.070103067499432167,"t":"including Speaking Assessment Criteria (public version), is available on the IELTS website."},{"c":1,"t":"@cambridgematerials","x":0.19764859202449769,"w":0.7655268351236979,"h":0.061085963627204198,"y":0.71368797581613486},{"x":0.35012993453550306,"t":"leltsresources.org","w":0.29562784830729166,"y":0.95280143051852273,"h":0.024170842509513291,"c":1}],"w":2400,"h":3405}