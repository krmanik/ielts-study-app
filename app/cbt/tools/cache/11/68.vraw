{"h":3406,"w":2400,"lines":[{"h":0.017682105180311436,"w":0.087678400675455737,"y":0.042436631820837789,"c":1,"t":"Reading","x":0.86565420052304409},{"x":0.05773196246844331,"h":0.015988371754420583,"y":0.091569767605686359,"t":"READING PASSAGE 2","w":0.32577318827311197,"c":1},{"x":0.055576943238655092,"c":1,"t":"You should spend about 20 minutes on Questions 14-26, which are based on Reading","w":0.88266286214192691,"h":0.021261314889367,"y":0.12800171542594163},{"t":"Passage 2 below.","y":0.14970930248329695,"x":0.055670101656386729,"h":0.015988371754420583,"w":0.17731959025065105,"c":1},{"w":0.40206184387207033,"x":0.30103093360554556,"h":0.037882873750194945,"c":1,"t":"Great Migrations","y":0.17732558107019569},{"w":0.3917525736490885,"h":0.017615971814445075,"c":1,"y":0.22959483244784984,"x":0.053608249159632207,"t":"Animal migration, however it is defined,"},{"x":0.51752577674610056,"y":0.22959483244565271,"w":0.38350514729817708,"h":0.017615971814445075,"c":1,"t":"Reaching some gravelly coastline in the"},{"w":0.37113400777180988,"h":0.015988371754420583,"t":"is far more than just the movement of","y":0.24854651179253329,"c":1,"x":0.053608253748386972},{"w":0.40855817159016927,"c":1,"x":0.51942573074151444,"y":0.24717907348041068,"t":"Arctic, upon which other arctic terns have","h":0.019236335597595522},{"c":1,"x":0.051546397529397533,"t":"animals. It can loosely be described as travel","y":0.26598837216150995,"w":0.428865966796875,"h":0.017441859892096456},{"t":"converged, will serve its larger purpose","h":0.017441859892096456,"w":0.38144330342610688,"x":0.51752577083402562,"y":0.26744186073999821,"c":1},{"c":1,"y":0.28398139931797606,"w":0.41676467895507813,"h":0.019574499662245781,"t":"that takes place at regular intervals - often","x":0.051429969934628825},{"t":"as shaped by evolution: finding a place, a","w":0.40847023010253902,"x":0.51740777030268725,"y":0.28473290085532255,"c":1,"h":0.01917805338493872},{"c":1,"w":0.42138926188151038,"x":0.049147577440128931,"y":0.29883754809989849,"t":"in an annual cycle - that may involve many","h":0.025468242777422878},{"x":0.51743064168948061,"y":0.30225857618147767,"h":0.020602028578502352,"c":1,"t":"time, and a set of circumstances in which it","w":0.42701639811197922},{"x":0.053608241845881345,"c":1,"y":0.32266588397613383,"t":"members of a species, and is rewarded only","w":0.42474227905273437,"h":0.017450395361227833},{"x":0.51546391561902383,"t":"can successtully hatch and rear offspring.","h":0.017450394801231117,"w":0.4082474263509116,"y":0.32266588397499341,"c":1},{"h":0.019195572320531484,"w":0.40229700724283851,"y":0.33966549441689908,"x":0.05141876384470024,"c":1,"t":"after a long journey. It suggests inherited"},{"w":0.37731959025065104,"t":"instinct. The biologist Hugh Dingle has","x":0.049484534671149397,"y":0.35901162762786365,"h":0.017441861012089666,"c":1},{"x":0.049332999894392632,"c":1,"t":"identified five characteristics that apply, in","y":0.37692142675702267,"h":0.018667204269436133,"w":0.40854176839192713},{"w":0.39381444295247392,"y":0.39680232530286763,"x":0.051546386677627537,"c":1,"t":"varying degrees and combinations, to all","h":0.017466611744583305},{"t":"migrations. They are prolonged movements","y":0.41569767413875236,"w":0.42061856587727869,"x":0.053608242693086131,"h":0.017441861012089666,"c":1},{"y":0.43452730456897581,"t":"that carry animals outside familiar habitats;","h":0.017615971814445186,"x":0.051546387049510922,"w":0.42061856587727864,"c":1},{"w":0.39837778727213541,"y":0.45092031425879353,"c":1,"x":0.051325015537494023,"h":0.021350251319334212,"t":"they tend to be linear, not zigzaggy; they"},{"y":0.47093023283618263,"w":0.36701032002766926,"h":0.017441859892096456,"t":"involve special behaviours concerning","c":1,"x":0.04742267486155323},{"c":1,"x":0.05154638632214642,"y":0.48972401664339194,"h":0.016147974163241319,"t":"preparation (such as overteeding) and","w":0.36701032002766926},{"h":0.015988371754420583,"t":"arrival; they demand special allocations","x":0.051546396244188816,"y":0.50872093039618993,"c":1,"w":0.37938143412272141},{"w":0.3484535980224609,"t":"of energy. And one more: migrating","x":0.051546396607326225,"y":0.52613035820340726,"h":0.017615971814445075,"c":1},{"w":0.40618555704752607,"c":1,"x":0.049484540754587511,"h":0.014679976512037562,"y":0.5449207281504419,"t":"animals maintain an intense attentiveness"},{"t":"to the greater mission, which keeps","x":0.049229194614622003,"h":0.022221095409382108,"y":0.56058439947753669,"w":0.34691281636555993,"c":1},{"x":0.049312071043101945,"y":0.58010901909595503,"h":0.020044796059429881,"c":1,"w":0.37354034423828125,"t":"them undistracted by temptations and"},{"c":1,"y":0.35901162774195083,"w":0.36494845072428395,"h":0.018895349149765428,"t":"But migration is a complex issue, and","x":0.51752577459872096},{"t":"biologists define it differently, depending","h":0.017615971814445075,"y":0.37786259561026792,"c":1,"x":0.51752577308404679,"w":0.40000000000000002},{"y":0.39528444333890689,"c":1,"w":0.42710001627604166,"x":0.51530823880899279,"h":0.019290845672732981,"t":"in part on what sorts of animals they study."},{"y":0.41569767413952763,"w":0.41030927022298169,"t":"Joel Berger, of the University of Montana,","x":0.51546392145935238,"h":0.017441861012089777,"c":1},{"c":1,"w":0.39175257364908866,"y":0.43452730501187165,"x":0.51546391925350266,"t":"who works on the American pronghorn","h":0.016147974163241319},{"c":1,"h":0.017441861012089888,"t":"and other large terrestrial mammals, prefers","y":0.45203488344265175,"w":0.42886596679687505,"x":0.51752577938506761},{"h":0.017441861012089777,"t":"what he calls a simple, practical definition","x":0.51546392147562881,"y":0.47093023227926956,"w":0.41030927022298169,"c":1},{"x":0.5154639229321375,"t":"suited to his beasts: 'movements from","y":0.48825601875857227,"w":0.37525772094726562,"h":0.01614797416324143,"c":1},{"y":0.50707867102403592,"c":1,"t":"a seasonal home area away to another","x":0.51533592805603712,"w":0.38171493530273437,"h":0.019178263943683937},{"x":0.51737595974599537,"h":0.018824455812267216,"t":"home area and back again'","y":0.52462753935165884,"c":1,"w":0.27040003458658846},{"x":0.77731958535259027,"t":"'. Generally the","h":0.016147974163241319,"y":0.52613035794038099,"c":1,"w":0.14845361073811847},{"c":1,"x":0.51534284313469658,"t":"reason tor such seasonal back-and-forth","y":0.54332963539070644,"w":0.39405576070149739,"h":0.017914818513414477},{"t":"movement is to seek resources that aren't","h":0.01453488361674482,"x":0.51752578093499968,"w":0.40618555704752601,"y":0.56249999987040666,"c":1},{"w":0.40206184387207033,"y":0.5813270698456009,"x":0.51546392332884772,"h":0.017615971814445075,"c":1,"t":"available within a single area year-round."},{"c":1,"h":0.017442714447003627,"t":"undeterred by challenges that would turn","y":0.60029069739544694,"x":0.051546397542017154,"w":0.40206184387207028},{"y":0.617798425274528,"w":0.19631397247314453,"t":"other animals aside.","h":0.017457639478055231,"x":0.049299267015386526,"c":1},{"w":0.36907216389973957,"y":0.65552325565215042,"h":0.018895349149765539,"c":1,"t":"An arctic tern, on its 20,000 km flight","x":0.051546392170224255},{"t":"from the extreme south of South America","y":0.67293012317706402,"h":0.016147974163241319,"w":0.40412371317545576,"c":1,"x":0.051546391968973163},{"h":0.020554657340819737,"x":0.049225082736991652,"y":0.69071926489812052,"w":0.36957425435384111,"c":1,"t":"to the Arctic circle, will take no notice"},{"x":0.051546398058328058,"t":"of a nice smelly herring offered from a","w":0.37113400777180988,"h":0.017441861012089777,"y":0.71075581367414875,"c":1},{"x":0.051546385747696821,"w":0.39793815612792971,"h":0.017615971814445075,"t":"bird-watcher's boat along the way. While","c":1,"y":0.72959483244823131},{"c":1,"x":0.047422678092007543,"t":"local gulis will dive voraciously for such","y":0.74854651179236331,"h":0.015988371754420583,"w":0.38144330342610672},{"y":0.76438302262485336,"x":0.049324639531717812,"c":1,"w":0.42713083902994797,"h":0.019711206047519636,"t":"handouts, the tern flies on. Why? The arctic"},{"h":0.014679976512037562,"c":1,"y":0.78479154440545662,"x":0.049484541904831897,"w":0.40206184387207033,"t":"tern resists distraction because it is driven"},{"w":0.4041237131754557,"c":1,"t":"at that moment by an instinctive sense of","h":0.015988371754420583,"y":0.8037790699322771,"x":0.049484535070395734},{"x":0.04742267901154662,"h":0.015996906663555355,"y":0.82266588385914818,"c":1,"t":"something we humans find admirable:","w":0.37731959025065104},{"x":0.047422689097115882,"t":"larger purpose. In other words, it is","y":0.83998825606123062,"w":0.34432988484700522,"h":0.017615971814445075,"c":1},{"t":"determined to reach its destination. The","h":0.015988371754420583,"x":0.051546388499886811,"y":0.85901162807181208,"c":1,"w":0.38556701660156245},{"h":0.016147974163241319,"c":1,"w":0.39381444295247392,"y":0.87786259549265688,"t":"bird senses that it can eat, rest and mate","x":0.049484530987680554},{"x":0.047422685823304486,"t":"later. Right now it is totally focused on","c":1,"w":0.37525772094726562,"h":0.015998613533382833,"y":0.89680232574486152},{"h":0.017441861012089777,"t":"the journey; its undivided intent is arrival.","y":0.9156976741404792,"w":0.40206184387207033,"x":0.049484541878946214,"c":1},{"t":"But daily vertical movements by","x":0.51546391157344018,"y":0.61773255837153906,"w":0.30927836100260409,"c":1,"h":0.017441859892096456},{"w":0.38144330342610677,"t":"zooplankton in the ocean - upward by","x":0.51546391520480506,"c":1,"h":0.016147974163241319,"y":0.63652378136144427},{"y":0.65552325565145986,"x":0.51546391151755988,"w":0.3979381561279296,"c":1,"h":0.01889534914976565,"t":"night to seek food, downward by day to"},{"w":0.41268053690592454,"x":0.51532576385080153,"y":0.6714712549230798,"h":0.019430145962547773,"c":1,"t":"escape predators - can also be considered"},{"c":1,"t":"migration. So can the movement of aphids","w":0.42268040974934895,"y":0.69172049311241302,"x":0.51546391873465247,"h":0.017615971814445186},{"t":"when, having depleted the young leaves","y":0.70930232523616366,"x":0.51546392234241434,"h":0.01889534914976565,"c":1,"w":0.39793813069661454},{"y":0.72812683467401018,"w":0.38144330342610677,"h":0.019083969465648831,"c":1,"t":"on one food plant, their offspring then","x":0.51546391517010814},{"h":0.017441859892096456,"c":1,"y":0.74709302353529083,"x":0.51340206759422746,"t":"fly onward to a different host plant, with","w":0.40206184387207022},{"y":0.76598837181317092,"h":0.017441861012089777,"w":0.39175257364908855,"t":"no one aphid ever returning to where it","x":0.51546391929028756,"c":1},{"x":0.51340206390665688,"w":0.078350512186686205,"h":0.017441859892096456,"c":1,"t":"started.","y":0.78343023267023082},{"t":"Dingle is an evolutionary biologist who","x":0.51546391519006274,"y":0.82119788609145039,"h":0.017464904874755716,"c":1,"w":0.38144330342610666},{"w":0.36288660685221363,"t":"studies insects. His definition is more","h":0.016147974163241319,"x":0.5134020572407062,"c":1,"y":0.83998825615354089},{"y":0.85661957473504735,"t":"Intricate than Berger's, citing those five","w":0.38586484273274746,"c":1,"h":0.021235272804569383,"x":0.51121244334212079},{"w":0.39381441752115887,"h":0.017615971814445186,"x":0.51134021430643084,"y":0.8763945975115508,"t":"features that distinguish migration from","c":1},{"y":0.89268210900531175,"h":0.020804245613353589,"t":"other forms of movement. They allow","x":0.51320413062681891,"c":1,"w":0.373601811726888},{"t":"for the fact that, for example, aphids will","y":0.91424418588538847,"x":0.51134021106386585,"w":0.40618555704752612,"h":0.018895349149765539,"c":1},{"x":0.35219444028158703,"y":0.95433624955947682,"w":0.29146217346191411,"t":"leltsresources.org","h":0.022583511809496359,"c":1},{"x":0.91546391735713584,"c":1,"y":0.94912790707942718,"t":"69","w":0.028865979512532558,"h":0.015988371754420583}]}