{"lines":[{"h":0.018578504158060283,"c":1,"x":0.86779802465302014,"t":"Reading","y":0.038985230058609766,"w":0.087182725270589234},{"y":0.087209302598464822,"h":0.017441859892096456,"c":1,"x":0.43505154641813815,"w":0.14226804097493495,"t":"READING"},{"y":0.15261627911720155,"h":0.01453488361674482,"t":"READING PASSAGE 1","c":1,"x":0.061855667903232832,"w":0.32371134440104166},{"t":"You should spend about 20 minutes on Questions 1-13, which are based on Reading","h":0.020397485317514619,"c":1,"w":0.87010304768880209,"x":0.061855692556621496,"y":0.1904069772623409},{"c":1,"y":0.20930232573691354,"t":"Passage 1 below.","w":0.17731959025065103,"h":0.015988371754420694,"x":0.059793812976345277},{"x":0.3379794199649544,"h":0.026498954714709644,"t":"Raising the Mary Rose","y":0.24667481748792808,"c":1,"w":0.33645612080891929},{"c":1,"y":0.29157848081404425,"x":0.11746439584152503,"w":0.77539042154947913,"h":0.020478354435560675,"t":"How a sixteenth-century warship was recovered from the seabed"},{"h":0.017441861012089666,"c":1,"x":0.057731964166118387,"y":0.33139534855885056,"t":"On 19 July 1545, English and French","w":0.37525772094726567},{"w":0.38782770792643229,"h":0.018188436242740247,"c":1,"y":0.3487810874438031,"t":"fleets were engaged in a sea battle off","x":0.057640721452134475},{"h":0.018260671332242295,"w":0.36735415140787764,"y":0.36622646017179394,"t":"the coast of southern England in the","c":1,"x":0.055502952968670818},{"w":0.40660662333170572,"h":0.020860749276609747,"c":1,"t":"area of water called the Solent, between","x":0.057535750217953943,"y":0.38417702462324055},{"x":0.057731955889939568,"w":0.41237113952636717,"c":1,"h":0.016147974163241319,"y":0.40546095130986826,"t":"Portsmouth and the Isle of Wight. Among"},{"h":0.019119977251053966,"w":0.4146512349446615,"c":1,"y":0.42274028216515713,"x":0.05554966425406889,"t":"the English vessels was a warship by the"},{"x":0.055670102059770459,"t":"name of Mary Rose. Built in Portsmouth","y":0.44186046539478818,"w":0.4041237131754557,"c":1,"h":0.017441859892096456},{"y":0.46065766305939304,"x":0.0556700974924784,"h":0.017615971814445186,"c":1,"t":"some 35 years earlier, she had had a long","w":0.42474227905273437},{"c":1,"w":0.39793815612792965,"t":"and successtul fighting career, and was","h":0.017441861012089666,"x":0.055670097083404972,"y":0.47965116251162065},{"y":0.49853200227820493,"c":1,"h":0.016147974163241319,"w":0.39793815612792971,"t":"a favourite of King Henry VIlI. Accounts","x":0.055670097068784799},{"c":1,"x":0.055670107971082343,"t":"of what happened to the ship vary: while","w":0.40618555704752601,"y":0.51585437457658667,"h":0.016147974163241319},{"w":0.37340276082356771,"h":0.018123386470416114,"y":0.53476725326472851,"c":1,"t":"witnesses agree that she was not hit","x":0.053506782145516067},{"t":"by the French, some maintain that she","x":0.055670105738533475,"h":0.01614797416324143,"c":1,"w":0.38762886047363282,"y":0.55372871391238287},{"x":0.05360824640622288,"h":0.0174461276266622,"t":"was outdated, overladen and sailing too","w":0.40412371317545576,"y":0.57122093051186063,"c":1},{"h":0.018940939598061091,"y":0.58982799843177802,"t":"low in the water, others that she was","x":0.051376109099491744,"w":0.37347696940104164,"c":1},{"h":0.018586937707799067,"x":0.055573041353525525,"w":0.40636110941569009,"t":"mishandled by undisciplined crew. What","c":1,"y":0.60746347877224116},{"x":0.055670103025817257,"w":0.40000000000000002,"h":0.018895349149765539,"y":0.62645348820773994,"t":"is undisputed, however, is that the Mary","c":1},{"t":"Rose sank into the Solent that day, taking","y":0.64533176750312427,"w":0.41649482727050779,"h":0.017458929710365778,"c":1,"x":0.055670111890519347},{"c":1,"t":"at least 500 men with her. After the battle,","w":0.4230727895100912,"y":0.6616033909684258,"x":0.053440784041437678,"h":0.020185788659158987},{"c":1,"x":0.053416519363836318,"t":"attempts were made to recover the ship,","w":0.41077311197916666,"y":0.67981063883415616,"h":0.020876236544310589},{"t":"but these failed.","x":0.053101198746425764,"w":0.16397336324055989,"h":0.019707810227757583,"c":1,"y":0.69851331425683039},{"t":"The Mary Rose came to rest on the","y":0.73415073332096281,"x":0.053342352710685506,"w":0.35719449361165367,"h":0.021261310409393497,"c":1},{"x":0.05360824864406126,"y":0.75572519093865798,"w":0.4226804097493489,"h":0.017615971814445186,"c":1,"t":"seabed, lying on her starboard (right) side"},{"t":"at an angle of approximately 60 degrees.","x":0.051425114656825172,"w":0.41676790873209635,"c":1,"y":0.77300097316182403,"h":0.01949395534226428},{"y":0.79213153273617354,"t":"The hull (the body of the ship) acted as","w":0.39381441752115881,"h":0.017461490015107217,"x":0.053608255234265934,"c":1},{"w":0.38762886047363282,"h":0.016147974163241319,"y":0.81238990034016689,"t":"a trap for the sand and mud carried by","x":0.053608250088164812,"c":1},{"t":"Solent currents. As a result, the starboard","w":0.41855669657389327,"h":0.015988371754420583,"c":1,"x":0.053608249548104919,"y":0.82994186063040043},{"c":1,"t":"side filled rapidly, leaving the exposed","w":0.38350514729817714,"y":0.84879624190814484,"x":0.051546395322274584,"h":0.017615971814445075},{"y":0.8675866119735377,"h":0.01614797416324143,"w":0.38144330342610683,"t":"port (left) side to be eroded by marine","x":0.051546389422280514,"c":1},{"w":0.40618555704752601,"c":1,"t":"organisms and mechanical degradation.","x":0.051546396676492447,"h":0.015988371754420694,"y":0.88662790713897088},{"c":1,"x":0.051546396316245101,"t":"Because of the way the ship sank, nearly","y":0.90399295388813183,"w":0.41443298339843754,"h":0.017615971814445075},{"y":0.32994186053360297,"h":0.017441859892096345,"t":"all of the starboard haff survived intact.","x":0.5216494849897898,"c":1,"w":0.39587628682454423},{"c":1,"w":0.39381444295247392,"t":"During the seventeenth and eighteenth","x":0.52371133512170109,"h":0.01614797416324143,"y":0.35026423967717235},{"y":0.36905460941645052,"x":0.52164948667868904,"w":0.41855669657389327,"h":0.017615971814445075,"t":"centuries, the entire site became covered","c":1},{"t":"with a layer of hard grey clay, which","y":0.38808139507006501,"x":0.52164947998032862,"h":0.017441861012089888,"w":0.36288660685221352,"c":1},{"t":"minimised further erosion.","h":0.019307298374679926,"c":1,"x":0.52141507210548432,"y":0.40377595688863499,"w":0.26658635457356772},{"y":0.4418604653863345,"w":0.41237113952636717,"c":1,"h":0.017441859892096456,"t":"Then, on 16 June 1836, some fishermen","x":0.52164948179487913},{"c":1,"x":0.52153735492987552,"t":"in the Solent found that their equipment","y":0.45972767773180157,"w":0.40433939615885417,"h":0.017481005898798863},{"x":0.52155019997806396,"y":0.47792707467511863,"c":1,"w":0.42704315185546893,"h":0.019211030468405998,"t":"was caught on an underwater obstruction,"},{"h":0.016147974163241319,"x":0.51958763058900137,"c":1,"t":"which turned out to be the Mary Rose.","y":0.49853200227862082,"w":0.39175257364908855},{"h":0.017811764567582933,"c":1,"x":0.52148779521395416,"y":0.51510524215818454,"t":"Diver John Deane happened to be","w":0.34879641215006507},{"t":"exploring another sunken ship nearby,","c":1,"y":0.53364796774728662,"w":0.38994588216145831,"h":0.018764645928714963,"x":0.52153912515344913},{"t":"and the fishermen approached him,","y":0.55049000689954108,"x":0.51939762925987221,"w":0.3654481252034506,"h":0.020851743410281842,"c":1},{"h":0.0174461276266622,"x":0.5195876391913995,"y":0.57122093034464938,"w":0.42680409749348958,"c":1,"t":"asking him to free their gear. Deane dived"},{"t":"down, and found the equipment caught","h":0.017441859892096456,"x":0.52164948412371137,"w":0.39999999999999991,"c":1,"y":0.59011627933810884},{"w":0.39199117024739594,"h":0.019000151405177634,"y":0.60727146822589351,"c":1,"t":"on a timber protruding slightly from the","x":0.52153236178262541},{"y":0.62597255300710897,"w":0.40641113281249996,"x":0.51947367256977039,"t":"seabed. Exploring further, he uncovered","h":0.020102731074155611,"c":1},{"w":0.35670102437337237,"t":"several other timbers and a bronze","y":0.6453317672614397,"h":0.014679976512037562,"x":0.51752577557104573,"c":1},{"y":0.6641221371773931,"w":0.36288660685221352,"c":1,"h":0.016147974163241319,"x":0.51752576864770161,"t":"gun. Deane continued diving on the"},{"y":0.68313953460525068,"w":0.3979381561279296,"c":1,"t":"site intermittently until 1840, recovering","h":0.017441861012089777,"x":0.51958762286033566},{"t":"several more guns, two bows, various","y":0.70032840107050431,"w":0.38787058512369799,"h":0.019335107808944763,"c":1,"x":0.51742018772204212},{"t":"timbers, part of a pump and various other","y":0.71947674401682638,"c":1,"x":0.51752577422573509,"w":0.42268040974934884,"h":0.018926075046649005},{"c":1,"h":0.017324463311742533,"t":"small finds.","w":0.11820976257324223,"x":0.51726250768691495,"y":0.73710922672228374},{"t":"The Mary Rose then faded into obscurity","w":0.41466718037923178,"y":0.77292058631829963,"c":1,"h":0.019295614604311617,"x":0.51740990106952678},{"y":0.79359953027523122,"h":0.017446981621572544,"w":0.40206184387207022,"t":"for another hundred years. But in 1965,","c":1,"x":0.51752577898908692},{"x":0.51958763203235059,"c":1,"h":0.016147974163241319,"w":0.35670102437337237,"y":0.81238990033998548,"t":"military historian and amateur diver"},{"h":0.01889534914976565,"x":0.51752577536561262,"y":0.82994186030055073,"c":1,"t":"Alexander McKee, in conjunction with the","w":0.41855669657389327},{"c":1,"t":"British Sub-Aqua Club, initiated a project","w":0.41477684020996086,"h":0.021384160237247873,"x":0.51733467091262586,"y":0.84614591919452908},{"x":0.51752577852489445,"c":1,"y":0.8662790700414934,"w":0.37525772094726562,"h":0.017455515970710489,"t":"called 'Solent Ships'. While on paper"},{"y":0.88574041580097995,"x":0.51535178928077774,"w":0.40437690734863285,"h":0.01753019600564143,"c":1,"t":"this was a plan to examine a number of"},{"t":"known wrecks in the Solent, what Mckee","c":1,"y":0.90546095142714056,"h":0.017615971814445075,"x":0.51752576941570394,"w":0.41649485270182296},{"t":"leltsresources.org","x":0.35219444028158703,"y":0.95433624955947682,"h":0.022583511809496359,"c":1,"w":0.29146217346191411},{"h":0.01453488361674482,"y":0.94767441859067625,"x":0.91546391736650778,"c":1,"t":"41","w":0.028865979512532558}],"w":2400,"h":3406}