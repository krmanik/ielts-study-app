{"h":3406,"w":2400,"lines":[{"w":0.27166671752929689,"t":"Audioscripts","c":1,"x":0.067378123491267705,"h":0.036113745733631797,"y":0.087785978327118874},{"c":1,"w":0.10802232106526694,"x":0.40581397804473635,"y":0.15511565838362795,"h":0.020324859350342228,"t":"TEST 1"},{"t":"SECTION 1","h":0.014679976512037562,"y":0.22078684657520464,"w":0.16082473754882812,"x":0.068041239369915824,"c":1},{"x":0.067715790770103493,"h":0.013902562825174436,"w":0.14292795817057291,"c":1,"y":0.2489804362068746,"t":"OFFICIAL: Hello?"},{"y":0.26889534907810664,"w":0.059793815612792955,"h":0.010174418083724102,"c":1,"x":0.068041236408512312,"t":"WOMAN:"},{"c":1,"w":0.64536081949869795,"t":"Oh, hello. I wanted to enquire about hiring a room in the Village Hall, for the","x":0.14845361076509078,"y":0.26598837214270943,"h":0.014534883616744931},{"w":0.26391751607259117,"x":0.15257732437106028,"h":0.014679976512037562,"t":"evening of September the first.","y":0.28185554919060207,"c":1},{"w":0.068138300577799474,"x":0.067992705271173084,"h":0.010501459494661858,"t":"OFFICIAL:","y":0.30070857256017869,"c":1},{"x":0.14226804138272048,"w":0.68453608194986981,"c":1,"y":0.29796511632859446,"t":"Let me just see... Yes, we have both rooms available that evening. There's our","h":0.01453488361674482},{"x":0.15463917409475073,"t":"Main Hall - that's got seating for 200 people. Or there's the Charlton Room...","y":0.3138578976682902,"w":0.66185567220052088,"h":0.016147974163241319,"c":1},{"t":"Sorry?","x":0.15257731935344684,"h":0.015988371754420583,"y":0.3299418606036707,"w":0.057731959025065116,"c":1},{"t":"Example","x":0.83672430670677422,"y":0.31372053827314506,"w":0.10800381978352869,"h":0.014833319278163781,"c":1},{"x":0.067994798835247089,"h":0.0090424968296124453,"w":0.059886690775553392,"y":0.33268805389342848,"c":1,"t":"WOMAN:"},{"c":1,"w":0.074226805369059248,"y":0.34883720943312202,"t":"OFFICIAL:","x":0.068041236390580864,"h":0.0087209299460482281},{"c":1,"y":0.34586024646437308,"t":"The Charlton Room - C-H-A-R L-T-O-N. That's got seating for up to one","x":0.13814431745382347,"w":0.62680414835611975,"h":0.014679976512037562},{"t":"Q1","h":0.013081395479069058,"x":0.86804123695413671,"c":1,"w":0.028865979512532558,"y":0.3459302324335628},{"x":0.065942854557943131,"w":0.061928723653157547,"c":1,"h":0.010397034677000372,"y":0.38070264543363141,"t":"WOMAN:"},{"y":0.41263438452823076,"h":0.0090335564828941672,"t":"OFFICIAL:","w":0.066061236063639325,"c":1,"x":0.06800030963807914},{"y":0.42877906976534796,"t":"WOMAN:","c":1,"w":0.061855665842692073,"h":0.0087209299460482281,"x":0.065979383092399688},{"h":0.010145530095887145,"t":"OFFICIAL:","x":0.065809939601949405,"y":0.44550863028936993,"c":1,"w":0.068380120595296232},{"t":"WOMAN:","x":0.068022915743548559,"y":0.47669050546096514,"h":0.010281779523884205,"w":0.05983045578002931,"c":1},{"c":1,"w":0.064134960174560524,"h":0.0095494494883369141,"t":"OFFICIAL:","x":0.067932519746020964,"y":0.49231829848958164},{"c":1,"t":"WOMAN:","x":0.063917524625207306,"h":0.011627907341393184,"w":0.061855672200520823,"y":0.5566860463077703},{"h":0.010203619669691855,"w":0.06456859588623047,"x":0.067735498833015148,"y":0.5882853550123589,"t":"OFFICIAL:","c":1},{"c":1,"x":0.068041236416725742,"t":"WOMAN:","w":0.059793815612792983,"h":0.0087209299460482281,"y":0.60755813966256567},{"x":0.067833252855814319,"y":0.62026703947100481,"w":0.064455318450927723,"t":"OFFICIAL:","h":0.010140065648453489,"c":1},{"c":1,"h":0.010085131095845856,"y":0.65338766699220741,"t":"WOMAN:","x":0.065793935597656755,"w":0.060164705912272159},{"c":1,"h":0.010859905518438184,"t":"OFFICIAL:","x":0.065732363032971072,"w":0.070701433817545581,"y":0.66840046966752809},{"h":0.0087209299460482281,"c":1,"x":0.065979380287937234,"t":"WOMAN:","w":0.06185567220052085,"y":0.70203488384914914},{"t":"OFFICIAL:","c":1,"w":0.06810298283894857,"x":0.065948508225777594,"y":0.71646634522108466,"h":0.01038126293099495},{"c":1,"w":0.061915664672851561,"y":0.76588156433762766,"h":0.0089345457129665906,"t":"WOMAN:","x":0.06594938404785608},{"w":0.066054541269938122,"h":0.0090075681577761468,"c":1,"t":"OFFICIAL:","x":0.06594180143009104,"y":0.78183342520980537},{"w":0.061920744578043627,"c":1,"x":0.063884988432519399,"y":0.82982589060536727,"h":0.0089528699237602094,"t":"WOMAN:"},{"c":1,"t":"OFFICIAL:","x":0.063717129802886685,"y":0.84417505370812573,"w":0.068578065236409497,"h":0.010121481599208448},{"y":0.88507293585621172,"h":0.0089238956964373672,"t":"WOMAN:","x":0.063888021575877807,"w":0.059852822621663415,"c":1},{"w":0.068272590637207031,"x":0.063801848907826836,"y":0.90214374897652261,"h":0.0096659903937903469,"t":"OFFICIAt:","c":1},{"y":0.91860465140571224,"w":0.061855672200520823,"h":0.010174418083723991,"c":1,"t":"WOMAN:","x":0.063917524617834148},{"t":"Well, we're organising a dinner to raise money for a charity, and we're hoping for at","h":0.016147974163241319,"x":0.15257732105243632,"y":0.3778625954954804,"w":0.70721649169921874,"c":1},{"t":"least 150 people, so I think we'll go for the Main Hall. How much would that cost?","x":0.15043860641898088,"y":0.39275895878244449,"w":0.69088597615559899,"h":0.018206993412145378,"c":1},{"c":1,"t":"Let's see. You wanted it for the evening of September 1st?","x":0.15042790221454472,"w":0.49913146972656253,"h":0.016989776266370216,"y":0.40952231908377068},{"w":0.19175257364908851,"c":1,"x":0.15257732125757448,"y":0.42718731657892572,"t":"Yes, that's a Saturday.","h":0.014679976512037562},{"w":0.67835052490234382,"c":1,"t":"So from six pm to midnight that'd be £115 - that's the weekend price, it's £75 on","x":0.15257731476108177,"y":0.44331395365514359,"h":0.015988371754420694},{"x":0.86804123694476476,"t":"Q2","y":0.44331395325759804,"w":0.028865979512532558,"h":0.011627907341393184,"c":1},{"x":0.15028281736028129,"y":0.45886447042333423,"w":0.095535780588785812,"t":"weekdays.","h":0.014508775452341083,"c":1},{"x":0.15257731738536071,"t":"That's all right.","y":0.47529069771419363,"h":0.01453488361674482,"c":1,"w":0.12371134440104167},{"x":0.15257732476965885,"h":0.016147974163241319,"y":0.48972401664586585,"t":"And I have to tell you there's also a deposit of £250, which is returnable of course","c":1,"w":0.6907216389973958},{"t":"as long as there's no damage. But we do insist that this is paid in cash, we don't","h":0.01453488361674482,"c":1,"x":0.15051547089681871,"y":0.50726744191027251,"w":0.68247421264648434},{"y":0.50581395329244228,"w":0.028865979512532558,"x":0.86804123684167189,"h":0.013081395479068947,"c":1,"t":"Q3"},{"h":0.013211978860833917,"t":"take cards for that. You can pay the actual rent of the room however you like","y":0.52319436265247854,"w":0.64742268880208331,"c":1,"x":0.15257731528767163},{"y":0.53924418609181235,"t":"though - cash, credit card, cheque ...","c":1,"x":0.1505154694079141,"h":0.01453488361674482,"w":0.3175257619222005},{"h":0.015634697462206137,"y":0.55335263430293569,"w":0.69082661946614587,"t":"Oh, well I suppose that's OK. So does the charge include use of tables and chairs","c":1,"x":0.15458339186941042},{"y":0.57068423259085621,"w":0.095098743438720684,"c":1,"h":0.012701302224303213,"t":"and so on?","x":0.15245062820826766},{"t":"Oh, yes.","h":0.017171751101858423,"x":0.15232193469905836,"c":1,"w":0.072675717671712242,"y":0.58661761276425506},{"c":1,"x":0.15031671872449001,"t":"And what about parking?","y":0.60030683689654085,"w":0.21483362833658856,"h":0.017614941420585839},{"x":0.15051546984482495,"w":0.74432988484700524,"c":1,"t":"Yeah, thats all incluged. The only thing that isn't included is ... you said you were Q4","y":0.61918604656170184,"h":0.01453488361674482},{"h":0.016628875777221608,"w":0.17585982004801431,"c":1,"x":0.15023843515588997,"y":0.63428083178822647,"t":"organising a dinner?"},{"t":"Yeah.","y":0.64970930223232537,"c":1,"x":0.15051546468864688,"h":0.01453488361674482,"w":0.051546389261881514},{"w":0.70721649169921874,"x":0.14845360971740093,"t":"Well, youll have to pay extra for the kitchen if you want to use that. It's £25. It's got","c":1,"y":0.66705813295208372,"h":0.016147974163241319},{"w":0.55257731119791664,"y":0.68313953493096868,"c":1,"t":"very good facilities - good quality cookers and fridges and so on.","x":0.1505154680037909,"h":0.01453488361674482},{"y":0.6975924838814429,"w":0.65773193359374993,"x":0.15257732436291899,"t":"OK, well I suppose that's all right. We can cover the cost in our entry charges.","h":0.017615971814445075,"c":1},{"c":1,"w":0.67422678629557287,"t":"Right. So I'll make a note of that. Now there are just one or two things you need","x":0.15051547262729523,"y":0.71511627911742881,"h":0.01453488361674482},{"y":0.7285408046958598,"h":0.019736157258818277,"t":"to think about before the event. For example, you'll have to see about getting a","x":0.1504228907316203,"c":1,"w":0.67237269083658857},{"x":0.86597938128403351,"w":0.028865979512532558,"y":0.72965116266612084,"h":0.013081395479068947,"t":"Q5","c":1},{"w":0.5135751342773438,"t":"licence if you're planning to have any mysic during the meal.","x":0.15043115984190081,"c":1,"y":0.7468287918682287,"h":0.015856173342280844},{"t":"Oh, really?","w":0.09516794204711912,"x":0.15035417320363823,"c":1,"y":0.76254001860966847,"h":0.015617637163880094},{"t":"It's quite straightforward, I'll give you the details later on. And about a week or ten","x":0.15051547584631342,"w":0.68865976969401044,"c":1,"y":0.7790697674911794,"h":0.01453488361674482},{"y":0.79505813970166317,"w":0.67010309855143235,"h":0.015988371754420583,"x":0.15051546092851822,"c":1,"t":"days before your event you'll need to contact the caretaker, that's Mr Evans, to"},{"h":0.013081395479069058,"y":0.79505813941526204,"c":1,"t":"Q6","x":0.86597938127466156,"w":0.028865979512532558},{"y":0.81092190233695383,"c":1,"x":0.15051546177660546,"t":"make the arrangements for entry - he'll sort that out with you.","w":0.52371134440104161,"h":0.014679976512037562},{"t":"And do I give him the payment as well?","y":0.82703488376848089,"c":1,"x":0.15051545896348634,"h":0.01453488361674482,"w":0.33608248392740886},{"c":1,"x":0.15051545999642277,"t":"No, you do that directly with me.","w":0.27422681172688801,"h":0.014679976512037562,"y":0.84292425124965065},{"x":0.15051545358947124,"c":1,"t":"Right. Now is there anything I need to know about what happens during the event?","y":0.88226658859248042,"w":0.70309280395507812,"h":0.015989225189334433},{"t":"Well, as you'll be aware, of course the building is no smoking throughout.","c":1,"w":0.62061854044596365,"x":0.1484536162715176,"y":0.89958896088939744,"h":0.016147974163241319},{"x":0.14996781910188117,"c":1,"w":0.093887360890706345,"t":"Of course.","h":0.0161541346865266,"y":0.91477337934990077},{"x":0.35215498527080541,"t":"leltsresources.org","w":0.29360280354817708,"c":1,"y":0.95282647550815269,"h":0.0241457972187753},{"h":0.01453488361674482,"c":1,"w":0.043298969268798837,"y":0.94912790698608729,"t":"103","x":0.91546391731223475}]}