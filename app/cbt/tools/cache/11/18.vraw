{"h":3406,"lines":[{"x":0.8612827492083337,"y":0.042955544523677891,"w":0.085817012786865265,"h":0.017121186763205731,"t":"Reading","c":1},{"h":0.015988371754420583,"y":0.094476744350672881,"w":0.36907216389973962,"t":"bearing plants to the rigours of the","x":0.070103093201152072,"c":1},{"w":0.37561175028483074,"h":0.019044346341789975,"c":1,"y":0.11043247482195562,"t":"great outdoors and can do no more","x":0.067853044730811884},{"y":0.13081395376384286,"h":0.017453809100883011,"t":"than hope for a good weather year.","w":0.3731958770751953,"c":1,"x":0.068041236554402834},{"t":"However, more often than not now,","y":0.14841997711860599,"x":0.069952866471271261,"w":0.37352495829264321,"h":0.02023923138065753,"c":1},{"w":0.36082473754882816,"h":0.017615971814445075,"x":0.070103095020111403,"c":1,"t":"due to a rapidly changing climate,","y":0.16852613039124653},{"c":1,"h":0.015988371754420583,"x":0.068041239363591091,"t":"that is not what happens. Massive","y":0.18750000016439694,"w":0.36082473754882821},{"c":1,"y":0.20493247251677982,"w":0.39587628682454434,"t":"floods, long droughts, hurricanes and","h":0.018904736933817445,"x":0.068041237866777307},{"c":1,"h":0.014679976512037562,"t":"severe monsoons take their toll each","y":0.22372284178303481,"w":0.38762886047363276,"x":0.068041239899413367},{"y":0.24069526241528572,"w":0.36741195678710942,"h":0.020565655675273242,"c":1,"t":"year, destroying millions of tons of","x":0.067834125283856628},{"h":0.019253957572574087,"c":1,"x":0.067658239585246679,"w":0.16583807627360025,"t":"valuable crops.","y":0.25897876108426732},{"w":0.3632254028320312,"t":"The supporters of vertical farming","h":0.020433476303019948,"x":0.067879241670446983,"y":0.29502646744791694,"c":1},{"w":0.38762886047363282,"h":0.017615971814445075,"t":"claim many potential advantages for","y":0.31532589566180258,"x":0.065979384227673854,"c":1},{"t":"the system. For instance, crops would","x":0.068041231158510976,"y":0.33430232586124808,"w":0.39793815612792971,"h":0.017441859892096456,"c":1},{"w":0.37319587707519536,"h":0.017441861012089888,"c":1,"x":0.068041236586412493,"y":0.35319767413879832,"t":"be produced all year round, as they"},{"y":0.37052260736871756,"w":0.40618555704752601,"h":0.019083969465648831,"t":"would be kept in artificially controlled,","c":1,"x":0.068041243022628733},{"t":"optimum growing conditions. There","w":0.37731959025065098,"x":0.068041236910756933,"y":0.38953488378941681,"h":0.017441859892096456,"c":1},{"t":"would be no weather-related crop","w":0.35709055582682292,"c":1,"y":0.40589200919524915,"h":0.020102016518414145,"x":0.067867134217870467},{"c":1,"t":"failures due to droughts, floods or","x":0.065979377787231494,"y":0.42718731626013895,"w":0.35876289367675779,"h":0.017615971814445075},{"c":1,"y":0.44622093050998379,"x":0.068041240275727874,"t":"pests. All the food could be grown","w":0.35670102437337237,"h":0.017441859892096456},{"w":0.38144330342610677,"c":1,"t":"organically, eliminating the need for","h":0.017615971814445075,"y":0.46359365827017873,"x":0.06597937912448662},{"h":0.017441861012089777,"y":0.48255813925598023,"w":0.38350514729817708,"c":1,"t":"herbicides, pesticides and fertilisers.","x":0.068041240666080874},{"h":0.017441861012089777,"c":1,"x":0.065979377272430209,"y":0.50145348809376133,"t":"The system would greatly reduce the","w":0.38969072977701824},{"c":1,"x":0.063743947419161007,"y":0.51792693479085405,"w":0.39829780578613283,"t":"incidence of many infectious diseases","h":0.019984399299375233},{"c":1,"y":0.53779069795347467,"x":0.063917523499740697,"t":"that are acquired at the agricultural","h":0.017441859892096456,"w":0.38144330342610677},{"t":"interface. Although the system would","w":0.39175257364908855,"h":0.017615971814445186,"x":0.063917527518402337,"c":1,"y":0.55519671191415887},{"h":0.023387888775666998,"c":1,"t":"consume energy, it would return","x":0.06562987763121346,"y":0.57265524065203244,"w":0.34297025044759116},{"y":0.59040764122225986,"t":"energy to the grid via methane","x":0.06557686743499877,"w":0.32653111775716148,"h":0.022781575909097684,"c":1},{"h":0.017615971814445075,"c":1,"x":0.065979377666874756,"t":"generation from composting non-","w":0.35463918050130205,"y":0.6118614212640493},{"h":0.017441859892096456,"w":0.37113400777180994,"c":1,"t":"edible parts of plants. It would also","x":0.063917532148619172,"y":0.62936046539264845},{"x":0.063917520279946127,"h":0.017441861012089777,"t":"dramatically reduce fossil fuel use,","y":0.64970930204639477,"c":1,"w":0.36701032002766926},{"h":0.017615971814445075,"t":"by cutting out the need for tractors,","c":1,"w":0.37731959025065109,"x":0.063917524313025026,"y":0.66705813250466328},{"t":"ploughs and shipping.","h":0.017441859892096456,"y":0.68604651190483346,"x":0.063917530113543064,"w":0.23711339314778646,"c":1},{"t":"A major drawback of vertical farming,","y":0.71952182291411704,"w":0.4064607493082682,"c":1,"x":0.063804792743223024,"h":0.020393476861403803},{"y":0.7412790694887641,"w":0.34845359802246095,"t":"however, is that the plants would","h":0.017441861012089777,"c":1,"x":0.063917530781970322},{"w":0.35051546732584637,"c":1,"x":0.061855670099963428,"t":"require artificial light. Without it,","y":0.75866118593710219,"h":0.017615971814445075},{"h":0.017451249356138177,"y":0.77761627879030748,"c":1,"t":"those plants nearest the windows","w":0.35670102437337242,"x":0.06185567326663962},{"h":0.015988371754420694,"x":0.063917532103583641,"t":"would be exposed to more sunlight","y":0.79651162807105302,"w":0.37113400777180994,"c":1},{"x":0.061855675101116343,"y":0.81385789789806351,"c":1,"t":"and grow more quickly, reducing","w":0.34845359802246095,"h":0.019083969465648831},{"c":1,"h":0.017441861012089777,"t":"the effciency of the system. Single-","x":0.5134020672552394,"w":0.37525772094726562,"y":0.094476743907337624},{"h":0.020707310191057648,"c":1,"t":"storey greenhouses have the benefit","x":0.51522091720308438,"y":0.11076335685333427,"w":0.38604270935058593},{"x":0.51314235892805893,"c":1,"y":0.12814495840934492,"t":"of natural overhead light: even so,","w":0.36766520182291662,"h":0.021838767767932477},{"h":0.017441859892096456,"t":"many still need artificial lighting.","c":1,"x":0.51340205919716708,"w":0.35463918050130205,"y":0.14970930260014481},{"t":"A multi-storey facility with no natural","x":0.51546392332169677,"y":0.16852613039274233,"w":0.40206184387207033,"h":0.017615971814445075,"c":1},{"w":0.3484535980224609,"c":1,"h":0.017441861012089777,"y":0.18749999972005338,"t":"overhead light would require far","x":0.51340206687422196},{"c":1,"t":"more. Generating enough light could","x":0.51340205771172009,"w":0.38969072977701824,"y":0.20493247184188113,"h":0.017451249356138177},{"h":0.017615971814445075,"x":0.51340206412727052,"c":1,"y":0.22372284202333936,"t":"be prohibitively expensive, unless","w":0.36082473754882816},{"c":1,"h":0.020587959222351238,"t":"cheap, renewable energy is available,","y":0.24108426007464656,"x":0.51327813520327903,"w":0.40028689066569001},{"c":1,"y":0.26159718136070764,"w":0.40206184387207022,"x":0.51340206764289109,"h":0.017615971814445075,"t":"and this appears to be rather a future"},{"t":"aspiration than a likelihood for the","h":0.01746575774967285,"w":0.37113400777180994,"x":0.51340206816657863,"y":0.27906976772176362,"c":1},{"t":"near future.","y":0.29695011512445113,"x":0.51306459655442371,"c":1,"w":0.13066253662109373,"h":0.018798168448931563},{"x":0.51134021108462757,"c":1,"y":0.33430232530185244,"w":0.40618555704752601,"h":0.017441861012089666,"t":"One variation on vertical farming that"},{"h":0.017441861012089666,"y":0.35319767413992698,"w":0.39381444295247392,"t":"has been developed is to grow plants","c":1,"x":0.51340205675829909},{"t":"in stacked trays that move on rails.","x":0.50913801073556153,"y":0.36977878157233235,"w":0.37971074422200524,"h":0.019823138180439903,"c":1},{"h":0.020940689920189159,"c":1,"w":0.39409184773763017,"t":"Moving the trays allows the plan