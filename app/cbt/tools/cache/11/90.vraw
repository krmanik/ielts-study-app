{"lines":[{"t":"Reading","x":0.87569585311903131,"h":0.017728485223901136,"c":1,"w":0.085892333984375013,"y":0.038078420107681143},{"y":0.088662790861818164,"c":1,"x":0.065979378325153368,"t":"READING PASSAGE 2","w":0.32783505757649739,"h":0.015988371754420694},{"y":0.12645348821101909,"x":0.065979369888082048,"w":0.88041239420572925,"h":0.01889534914976565,"c":1,"t":"You should spend about 20 minutes on Questions 14-26, which are based on Reading"},{"c":1,"h":0.018893575080338509,"t":"Passage 2 below.","x":0.063642932982983264,"y":0.1451682594595638,"w":0.17997088114420573},{"h":0.017441861012089888,"t":"An Introduction to Film Sound","x":0.29072165387929999,"y":0.1860465113485672,"w":0.43711339314778647,"c":1},{"y":0.22665883723548974,"w":0.36907216389973957,"c":1,"t":"Though we might think of film as an","x":0.061855670498035427,"h":0.017615971814445075},{"t":"essentially visual experience, we really","y":0.24563953460464383,"h":0.017441861012089777,"x":0.061855671849788317,"c":1,"w":0.39175257364908855},{"c":1,"h":0.014679976512037562,"w":0.35051546732584637,"y":0.26306517900912385,"t":"cannot afford to underestimate the","x":0.061855668293442204},{"t":"importance of film sound. A meaningful","x":0.059793812433462247,"h":0.017615971814445075,"y":0.28185554886775321,"w":0.40824742635091149,"c":1},{"x":0.061855673676810927,"t":"sound track is often as complicated as","y":0.30087209274383642,"c":1,"h":0.017441861012089777,"w":0.38350514729817708},{"x":0.06185566632896676,"c":1,"t":"the image on the screen, and is ultimately","h":0.017615971814445186,"y":0.3197298882062658,"w":0.4164948527018229},{"t":"just as much the responsibility of the","y":0.33575581360825679,"x":0.059793810349000394,"h":0.018912418968034861,"c":1,"w":0.3731958770751953},{"x":0.061855680100047203,"y":0.3546511627601443,"h":0.015988371754420694,"t":"director. The entire sound track consists","c":1,"w":0.40206184387207022},{"c":1,"t":"of three essential ingredients: the human","y":0.37345860206967263,"w":0.40824742635091138,"x":0.061855668150022941,"h":0.019083969465648831},{"t":"voice, sound effects and music. These","w":0.37731959025065104,"y":0.39389534855802255,"c":1,"x":0.061855668685064605,"h":0.017441861012089777},{"y":0.41133294159908851,"h":0.014679976512037562,"x":0.061855674322971572,"c":1,"t":"three tracks must be mixed and balanced","w":0.4103092702229818},{"t":"so as to produce the necessary emphases","x":0.061855668193960107,"y":0.43012331202985088,"c":1,"w":0.40824742635091149,"h":0.017615971814445075},{"t":"which in turn create desired effects.","y":0.44780517464362979,"c":1,"h":0.017354620252016728,"x":0.061769200258956027,"w":0.35692186991373698},{"t":"Topics which essentially refer to the","c":1,"w":0.35876289367675784,"h":0.017467465179497044,"y":0.46799765136780591,"x":0.061855666456863932},{"h":0.017615971814445075,"c":1,"w":0.38144330342610683,"y":0.48532002366002702,"x":0.059793812098953888,"t":"three previously mentioned tracks are"},{"y":0.50436046483760133,"w":0.40824742635091149,"c":1,"h":0.017441861012089777,"t":"discussed below. They include dialogue,","x":0.05979381247869256},{"y":0.52319436300091038,"c":1,"x":0.059793817096600747,"h":0.017615971814445075,"w":0.38762886047363287,"t":"synchronous and asynchronous sound"},{"w":0.1881668472290039,"h":0.019536638287887542,"x":0.059446363998533702,"c":1,"y":0.53957056003896198,"t":"effects, and music."},{"w":0.40206184387207033,"c":1,"t":"Let us start with dialogue. As is the case","h":0.017615971814445075,"x":0.059793820208422804,"y":0.57839107463397987},{"x":0.061855670648068323,"y":0.59593023267023082,"w":0.36907216389973962,"c":1,"h":0.017441859892096456,"t":"with stage drama, dialogue serves to"},{"x":0.05773195867178136,"t":"tell the story and expresses feelings and","y":0.61479741608464633,"h":0.017615971814445186,"c":1,"w":0.39999999999999997},{"w":0.39793815612792965,"x":0.059793808445914844,"y":0.63358778603310106,"h":0.014679976512037562,"c":1,"t":"motivations of characters as well. Often"},{"c":1,"t":"with film characterization the audience","y":0.65116279066901772,"w":0.39381441752115887,"h":0.01453488361674482,"x":0.059793823622009273},{"h":0.020175929357917344,"y":0.66743346032029427,"t":"perceives little or no difference between","x":0.059533777545157707,"c":1,"w":0.40039304097493489},{"t":"the character and the actor. Thus, for","w":0.36907216389973957,"c":1,"h":0.017446981621572655,"y":0.68895348809259183,"x":0.059793814862785739},{"y":0.70629864736398751,"w":0.39613258361816406,"h":0.0206100029309777,"c":1,"x":0.059672878358314654,"t":"example, the actor Humphrey Bogart is"},{"w":0.41704307556152342,"h":0.02322897516274125,"x":0.05950656700893215,"y":0.7222446091950242,"c":1,"t":"the character Sam Spade; film personality"},{"x":0.059534502201680703,"w":0.35513577779134115,"t":"and life personality seem to merge.","h":0.020715284543532997,"c":1,"y":0.7437966153266854},{"x":0.059793815640789394,"c":1,"t":"Perhaps this is because the very texture of","y":0.76306517924769557,"h":0.017458076835448644,"w":0.42268040974934895},{"y":0.77906976770842717,"h":0.020401753612076967,"c":1,"w":0.4041237131754557,"t":"a performer's voice supplies an element","x":0.059793811453509281},{"h":0.015910996455552717,"c":1,"t":"of character.","w":0.12647856394449869,"y":0.80005399440178826,"x":0.059522814121862243},{"t":"When voice textures fit the performer's","y":0.83412559547369325,"w":0.39620638529459634,"h":0.021299767620200916,"c":1,"x":0.059633477279532103},{"x":0.059589916412371338,"w":0.36327247619628905,"h":0.021625073041484644,"c":1,"y":0.85326225668768585,"t":"physiognomy and gestures, a whole"},{"x":0.52371133919020796,"t":"and very realistic persona emerges. The","h":0.017615971814445075,"c":1,"y":0.2266588372366628,"w":0.4041237131754557},{"x":0.52371134010422571,"y":0.24563953460544252,"t":"viewer sees not an actor working at his","w":0.39999999999999991,"h":0.017441861012089666,"c":1},{"h":0.017443567881917366,"t":"craft, but another human being struggling","x":0.52371134639596595,"y":0.26453317657263253,"w":0.42886596679687505,"c":1},{"t":"with life. It is interesting to note that how","w":0.42089426676432284,"h":0.020599887151264484,"x":0.52356364879532125,"y":0.28127892524181686,"c":1},{"t":"dialogue is used and the very amount of","c":1,"h":0.017441861012089666,"x":0.52371134325081281,"y":0.30087209274531967,"w":0.41443298339843748},{"w":0.42680414835611979,"y":0.3197298882061208,"c":1,"t":"dialogue used varies widely among films.","h":0.017615971814445186,"x":0.52371132777188223},{"y":0.33720930216122835,"h":0.018926928481562744,"t":"For example, in the highly successful","c":1,"x":0.52371133781818291,"w":0.38144330342610677},{"x":0.52371134100067163,"c":1,"h":0.017441861012089888,"y":0.35610465088324772,"t":"science-fiction film 2001, little dialogue","w":0.39587628682454445},{"c":1,"t":"was evident, and most of it was banal","w":0.38556701660156245,"y":0.37492659983802046,"x":0.52371133698360051,"h":0.017615971814445075},{"t":"and of little intrinsic interest. In this","c":1,"h":0.015988371754420694,"x":0.52371134017909526,"y":0.39244186043456297,"w":0.36494845072428383},{"y":0.41133294178252489,"h":0.018899616324334678,"c":1,"w":0.40206184387207045,"x":0.52371134389901641,"t":"way the film-maker was able to portray"},{"w":0.37113400777180994,"y":0.43012331179513086,"h":0.014679976512037562,"c":1,"x":0.5237113465887514,"t":"what Thomas Sobochack and Vivian"},{"h":0.017441861012089777,"w":0.42061856587727875,"x":0.52371133550896876,"c":1,"t":"Sobochack call, in An Introduction to Film,","y":0.44912790669864322},{"t":"the 'inadequacy of human responses","w":0.37369784037272125,"h":0.021897398298513227,"y":0.46610524984878887,"c":1,"x":0.52342700609894122},{"w":0.38581181844075529,"t":"when compared with the magnificent","x":0.52360142363792528,"y":0.48519218621176463,"h":0.020611685160952131,"c":1},{"t":"technology created by man and the visual","x":0.52371132778825957,"w":0.42680414835611979,"h":0.017441861012089777,"c":1,"y":0.50436046483822639},{"h":0.01614797416324143,"c":1,"w":0.25567011515299487,"t":"beauties of the universe'.","y":0.52319436288235754,"x":0.52371133407298709},{"x":0.52371133878927156,"h":0.017441861012089777,"c":1,"y":0.55959302297737212,"t":"The comedy Bringing Up Baby, on the","w":0.37731959025065109},{"w":0.41649485270182285,"h":0.017615971814445075,"c":1,"t":"other hand, presents practically non-stop","y":0.5783910746329366,"x":0.52371133639975676},{"t":"dialogue delivered at breakneck speed.","x":0.52371133392511937,"w":0.39793815612792971,"h":0.01889534914976565,"c":1,"y":0.59593023238333642},{"h":0.017615971814445075,"t":"This use of dialogue underscores not","x":0.52371134555901322,"c":1,"w":0.37525772094726573,"y":0.6147974160824492},{"w":0.38556701660156245,"x":0.52371133694148686,"h":0.017615971814445075,"t":"only the dizzy quality of the character","y":0.63358778626633594,"c":1},{"y":0.65261627879132555,"h":0.017441861012089777,"t":"played by Katherine Hepburn, but also","w":0.3979381561279296,"x":0.52371133420114768,"c":1},{"h":0.017615971814445075,"x":0.52164947210749146,"w":0.42680414835611991,"t":"the absurdity of the film itself and thus its","y":0.66999412827849958,"c":1},{"x":0.5235825844205978,"h":0.019154439445670302,"t":"humor. The audience is bounced from gag","y":0.68740754436667761,"c":1,"w":0.42708724975585943},{"t":"to gag and conversation to conversation;","c":1,"y":0.70652450532427225,"w":0.41258766174316408,"h":0.019032646891514959,"x":0.52360473860349543},{"y":0.72372790710231771,"h":0.019064380782391144,"w":0.39616589864095042,"c":1,"t":"there is no time for audience reflection.","x":0.52358794720020707},{"w":0.42061856587727864,"x":0.52371133553509941,"y":0.74418604623298079,"h":0.017441861012089777,"c":1,"t":"The audience is caught up in a whirlwind"},{"h":0.017458076835448644,"t":"of activity in simply managing to follow","c":1,"y":0.76306517924664119,"x":0.52371134507183492,"w":0.40618555704752601},{"y":0.78038755143023586,"w":0.42268040974934906,"x":0.52164948350161422,"h":0.019083969465648831,"c":1,"t":"the plot. This film presents pure escapism"},{"x":0.5215199165120421,"c":1,"t":"- largely due to its frenetic dialogue.","h":0.020590235048787986,"w":0.37341351826985691,"y":0.79800777671960255},{"x":0.52164948490037433,"t":"Synchronous sound effects are those","c":1,"y":0.83575581423234846,"w":0.36907216389973962,"h":0.0174444207568345},{"w":0.35051546732584626,"t":"sounds which are synchronized or","c":1,"h":0.017441859892096345,"y":0.85465116307049915,"x":0.52164948273675971},{"w":0.032989689509073883,"h":0.01453488361674482,"y":0.94622093021197651,"t":"91","c":1,"x":0.92577319635886512},{"y":0.9543054561580997,"t":"leltsresources.org","w":0.29146792093912754,"h":0.022615832576874939,"c":1,"x":0.3521918184962084}],"h":3406,"w":2400}