{"h":3406,"lines":[{"x":0.069791102518223985,"y":0.042892485406356817,"w":0.064541505177815761,"c":1,"h":0.015959214408189148,"t":"Test 4"},{"w":0.34639175415039064,"c":1,"t":"matched with what is viewed. For","h":0.015988371754420583,"x":0.068041236233145855,"y":0.090116279233012575},{"w":0.4041237131754557,"h":0.019083969465648831,"x":0.065979378154540219,"c":1,"y":0.10745742822261861,"t":"example, if the film portrays a character"},{"y":0.12645348820959934,"c":1,"x":0.065979382774727355,"h":0.018895349149765539,"w":0.36494845072428383,"t":"playing the piano, the sounds of the"},{"y":0.1438637702329354,"w":0.41649482727050779,"c":1,"h":0.018926927361569534,"t":"piano are projected. Synchronous sounds","x":0.068041241261653437},{"h":0.014679976512037562,"c":1,"w":0.41030927022298175,"y":0.16412213761789929,"x":0.068041241173732489,"t":"contribute to the realism of film and also"},{"t":"help to create a particular atmosphere.","c":1,"w":0.39175257364908861,"h":0.017441861012089666,"y":0.18313953460507393,"x":0.06597938316386541},{"t":"For example, the 'click' of a door being","y":0.1990604814560194,"c":1,"h":0.020551967116852587,"x":0.068041239484734076,"w":0.39175257364908861},{"t":"opened may simply serve to convince","x":0.068041232348802369,"y":0.21947674384081495,"c":1,"w":0.38144330342610672,"h":0.018926075046649005},{"y":0.2383720927441062,"h":0.017441861012089666,"x":0.068041240700891362,"c":1,"t":"the audience that the image portrayed","w":0.38350514729817703},{"t":"is real, and the audience may only","w":0.34639175415039059,"y":0.25719318825566173,"c":1,"x":0.065979380385122119,"h":0.017615971814445075},{"c":1,"t":"subconsciously note the expected sound.","y":0.27616279041942215,"w":0.41443298339843748,"x":0.065979384490854998,"h":0.017441861012089666},{"x":0.068041238476346091,"y":0.29359953036553743,"h":0.018900469759248528,"t":"However, if the 'click' of an opening","c":1,"w":0.36494845072428389},{"t":"door is part of an ominous action such","y":0.30983655034491187,"x":0.065792124926706025,"h":0.022503548766050541,"c":1,"w":0.38809140523274743},{"x":0.065979382200316031,"c":1,"t":"as a burglary, the sound mixer may call","h":0.017441859892096456,"y":0.33139534911453927,"w":0.39587628682454434},{"x":0.065979384651296685,"t":"attention to the 'click' with an increase in","y":0.34732824441294685,"c":1,"h":0.017615971814445075,"w":0.41443298339843748},{"t":"volume; this helps to engage the audience","x":0.068041232412925576,"h":0.017615971814445075,"y":0.36905460941624046,"w":0.42061856587727864,"c":1},{"c":1,"h":0.019397924874575034,"w":0.26055043538411454,"y":0.38425989438935115,"t":"in a moment of suspense.","x":0.065621521854688378},{"t":"Asynchronous sound effects, on the other","y":0.42441860437229284,"h":0.017448688491400133,"x":0.065979376764809819,"c":1,"w":0.42061856587727869},{"y":0.44331395365307902,"w":0.36907216389973962,"c":1,"t":"hand, are not matched with a visible","x":0.063917526191497653,"h":0.015988371754420694},{"h":0.016147974163241319,"t":"source of the sound on screen. Such","x":0.063917521242746703,"y":0.46065766294168298,"w":0.36288660685221352,"c":1},{"c":1,"h":0.017441861012089777,"t":"sounds are included so as to provide an","x":0.061855669085834723,"y":0.47965116251135798,"w":0.40412371317545576},{"y":0.49853200195099734,"x":0.063917530662346567,"w":0.40618555704752601,"h":0.018909858663293533,"c":1,"t":"appropriate emotional nuance, and they"},{"y":0.51556726693762078,"c":1,"x":0.063805740049260651,"t":"may also add to the realism of the film.","w":0.39606132507324221,"h":0.019505505833427028},{"t":"For example, a film-maker might opt","x":0.063741976090815528,"h":0.020417950955545994,"c":1,"w":0.37761881510416662,"y":0.53350018054002313},{"h":0.019930520900473203,"t":"to include the background sound of an","x":0.061747122228605157,"c":1,"w":0.39403795878092446,"y":0.55217138114728015},{"w":0.40230194091796878,"x":0.063798648133785371,"h":0.01988859731032433,"t":"ambulance's siren while the foreground","y":0.570612094269488,"c":1},{"y":0.59156976716248122,"h":0.017441861012089777,"t":"sound and image portrays an arguing","w":0.38350514729817708,"x":0.061855673678857956,"c":1},{"h":0.020877522296647855,"x":0.06170859475056744,"w":0.38378880818684896,"t":"couple. The asynchronous ambulance","y":0.60845778861814459,"c":1},{"x":0.061619283828582685,"h":0.022435942608961534,"t":"siren underscores the psychic injury","y":0.62450225906795243,"c":1,"w":0.36555811564127599},{"t":"incurred in the argument; at the same","c":1,"y":0.64609076935017928,"w":0.38176910400390618,"h":0.021045133777737091,"x":0.061687624469436028},{"y":0.6655901349473976,"h":0.014679976512037562,"w":0.37731959025065098,"c":1,"t":"time the noise of the siren adds to the","x":0.063917524356826946},{"w":0.41649485270182285,"x":0.063917522004237379,"y":0.68459302297742786,"h":0.017441861012089777,"c":1,"t":"realism of the film by acknowledging the"},{"h":0.021042477153569772,"t":"film's city setting.","c":1,"y":0.70130908530415015,"x":0.063438489919678265,"w":0.18233786265055338},{"y":0.090116278903946245,"w":0.33195877075195312,"x":0.53608247013063604,"h":0.018895349149765539,"c":1,"t":"We are probably all familiar with"},{"x":0.53402061534211209,"c":1,"t":"background music in films, which has","h":0.017615971814445075,"w":0.38556701660156256,"y":0.10892542566007779},{"x":0.53195876592751068,"t":"become so ubiquitous as to be noticeable","c":1,"y":0.12790697646618066,"w":0.41443298339843748,"h":0.017441861012089777},{"w":0.42699503580729159,"t":"in its absence. We are aware that it is used","c":1,"h":0.018499429269321466,"y":0.14531289653644941,"x":0.53184964687617409},{"w":0.41443298339843748,"h":0.017615971814445075,"y":0.16412213729461933,"t":"to add emotion and rhythm. Usually not","c":1,"x":0.53195876592281988},{"y":0.18313953460396015,"t":"meant to be noticeable, it often provides","w":0.40618555704752601,"h":0.017441861012089666,"c":1,"x":0.53402062346021673},{"y":0.20199647695305245,"t":"a tone or an emotional attitude toward","h":0.014679976512037562,"w":0.39175257364908855,"c":1,"x":0.53195876475202108},{"w":0.41855669657389305,"t":"the story and\/or the characters depicted.","x":0.53195876505311024,"h":0.017615971814445186,"c":1,"y":0.22078684681286476},{"x":0.53195876237960094,"y":0.23837209285947958,"h":0.018895349149765539,"t":"In addition, background music often","w":0.3731958770751953,"c":1},{"c":1,"t":"toreshadows a change in mood. For","x":0.53186053448064075,"y":0.25698091374866472,"w":0.36518000284830732,"h":0.020199924094916333},{"y":0.27761627879105855,"w":0.42680414835611979,"h":0.017451249356138288,"c":1,"t":"example, dissonant music may be used in","x":0.53195875047593122},{"h":0.017441861012089777,"w":0.40824742635091149,"c":1,"t":"film to indicate an approaching (but not","x":0.53195876090167282,"y":0.29505813925493707},{"x":0.52972860734397342,"h":0.018804721529877111,"t":"yet visible) menace or disaster.","y":0.31267081591922663,"c":1,"w":0.31571767171223952},{"y":0.35026423979267807,"w":0.35670102437337237,"h":0.017468318614411005,"c":1,"x":0.53195876604390491,"t":"Background music may aid viewer"},{"c":1,"t":"understanding by linking scenes. For","y":0.36758075234850152,"x":0.53183856019744136,"w":0.37756960550944008,"h":0.020234408689399297},{"x":0.5319587633161097,"t":"example, a particular musical theme","y":0.38808139562837041,"h":0.017441859892096456,"c":1,"w":0.36907216389973962},{"h":0.017433163143926178,"c":1,"t":"associated with an individual character","x":0.53184187740207922,"y":0.40425587060489154,"w":0.40020083109537763},{"y":0.42441860437219114,"c":1,"x":0.52989690711405046,"w":0.40000000000000002,"h":0.017448688491400244,"t":"or situation may be repeated at various"},{"y":0.44005894533019529,"c":1,"h":0.020810535495867866,"w":0.38598536173502607,"x":0.53167860740198947,"t":"points in a film in order to remind the"},{"c":1,"t":"audience of salient motifs or ideas.","y":0.46087860295415317,"h":0.017371604950793484,"w":0.3569232177734375,"x":0.52980989616829732},{"w":0.3979381561279296,"x":0.53195875688448879,"t":"Film sound comprises conventions and","y":0.498532002396323,"h":0.017456369965621055,"c":1},{"t":"innovations. We have come to expect an","w":0.40855242411295567,"h":0.017490005045166734,"x":0.52973093981817598,"y":0.5163760424194962,"c":1},{"w":0.39999999999999991,"x":0.52989690711271942,"t":"acceleration of music during car chases","c":1,"h":0.017441861012089777,"y":0.53633720902306337},{"w":0.40206184387207033,"x":0.52989691546946305,"y":0.5537287138887087,"h":0.017615971814445186,"c":1,"t":"and creaky doors in horror films. Yet, it"},{"c":1,"t":"is important to note as well that sound","y":0.57267441832655019,"w":0.39381444295247403,"h":0.017460637700186687,"x":0.52989690213091944},{"h":0.017441861012089666,"y":0.59156976716302345,"t":"is often brilliantly conceived. The effects","x":0.52783504868979214,"c":1,"w":0.41237113952636717},{"t":"of sound are often largely subtle and","w":0.3731958770751953,"c":1,"h":0.017615971814445075,"y":0.61039342354780601,"x":0.5298969067237097},{"y":0.62735834651878009,"w":0.41882130940755213,"h":0.020592271196653189,"c":1,"x":0.52976758372538668,"t":"often are noted by only our subconscious"},{"w":0.42886596679687505,"h":0.015990932619158627,"x":0.52371134628525506,"y":0.64679976487687441,"c":1,"t":"minds. We need to foster an awareness of"},{"x":0.52346353140929314,"w":0.41079874674479167,"t":"film sound as well as film space so as to","h":0.021337289636581769,"c":1,"y":0.66316632871944903},{"x":0.5237113441048038,"c":1,"t":"truly appreciate an art form that sprang","y":0.68459302353385698,"h":0.017441859892096456,"w":0.41030927022298169},{"y":0.7034644745170574,"h":0.017465758309669455,"c":1,"w":0.41855669657389327,"t":"to life during the twentieth century - the","x":0.523711342334506},{"h":0.017341679289140766,"c":1,"t":"modem film.","w":0.14082267761230471,"y":0.71970006708386303,"x":0.52346881775309462},{"t":"92","y":0.94912790701280902,"w":0.028865979512532544,"h":0.015988371754420583,"c":1,"x":0.059793814367445075},{"x":0.35218917154682977,"w":0.29147308349609374,"h":0.022623007254116145,"c":1,"y":0.954299835015052,"t":"leltsresources.org"}],"w":2400}