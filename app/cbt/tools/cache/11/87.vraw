{"lines":[{"x":0.07213387027139874,"w":0.063979682922363265,"h":0.014671052405222373,"t":"Test 4","c":1,"y":0.044990055048224509},{"w":0.39587628682454429,"c":1,"t":"@cambridgematerials","y":0.036337209838511408,"x":0.28865979466601394,"h":0.027616277975820558},{"y":0.091750444978209167,"x":0.069849563042706245,"w":0.40880521138509124,"h":0.022308589287946545,"c":1,"t":"elemental forces at work. According to a"},{"h":0.017615971814445075,"y":0.11332941875831692,"c":1,"x":0.070103096757833896,"t":"recent field called epigenetics, there is a","w":0.4103092702229818},{"x":0.069943258902693511,"c":1,"t":"third factor also in play, one that in some","w":0.41063769022623697,"y":0.13044160899290447,"h":0.020373044823172259},{"h":0.015988371754420583,"t":"cases serves as a bridge between the","c":1,"w":0.37731959025065104,"y":0.15116279085819095,"x":0.07010309145561934},{"x":0.072031676021583307,"w":0.4250053405761719,"h":0.018414360176306044,"y":0.16752499342175686,"t":"environment and our genes, and in others","c":1},{"x":0.072091979887453403,"y":0.18635496664833529,"w":0.42491683959960935,"t":"operates on its own to shape who we are.","h":0.017184753104370509,"c":1},{"y":0.22372284220674477,"w":0.34845359802246095,"h":0.016147974163241319,"c":1,"t":"Epigenetic processes are chemical","x":0.072164948583271382},{"x":0.070103101296621631,"h":0.013081394359075738,"c":1,"w":0.354639155069987,"y":0.24273255841639241,"t":"reactions tied to neither nature nor"},{"c":1,"x":0.07010308037324435,"t":"nurture but representing what researchers","y":0.26159718136051768,"w":0.42680414835611985,"h":0.017615971814445075},{"w":0.39381444295247392,"x":0.070103087734530528,"y":0.27906976771868042,"c":1,"t":"have called a 'third component'. These","h":0.01746575774967285},{"w":0.36288660685221352,"h":0.017441859892096456,"x":0.068041232587638945,"c":1,"t":"reactions influence how our genetic","y":0.29941860493058248},{"x":0.069940476726677622,"t":"code is expressed: how each gene is","w":0.37148279825846353,"h":0.020118077222697539,"c":1,"y":0.31618798875217946},{"t":"strengthened or weakened, even turned","x":0.068041235220962379,"c":1,"w":0.40824742635091138,"h":0.018912418968034972,"y":0.33575581379031405},{"c":1,"t":"on or otf, to build our bones, brains and","w":0.39999999999999997,"y":0.35610465132706426,"x":0.07010309270310576,"h":0.015988371754420694},{"w":0.32595209757486981,"h":0.016993799842391022,"c":1,"y":0.37328988712334299,"t":"all the other parts of our bodies.","x":0.069992540441770737},{"h":0.017460637700186687,"x":0.070103088587694817,"w":0.38969072977701824,"c":1,"t":"If you think of our DNA as an immense","y":0.40986494396267559},{"x":0.070103080366398896,"w":0.42680414835611985,"t":"piano keyboard and our genes as the keys","h":0.017615971814445075,"c":1,"y":0.42865531414604674},{"x":0.068041243308242322,"c":1,"t":"- each key symbolizing a segment of DNA","w":0.42886596679687494,"h":0.018895349149765539,"y":0.44622093006980901},{"y":0.46459383093708961,"w":0.41054300944010413,"x":0.067937842730004069,"c":1,"t":"responsible for a particular note, or trait,","h":0.019466742864441944},{"h":0.017456369965621055,"c":1,"y":0.48401162762782701,"x":0.068041239757828192,"t":"and all the keys combining to make us","w":0.38762886047363276},{"x":0.065979379422278259,"y":0.50290697702206144,"w":0.40824742635091144,"h":0.017441859892096345,"c":1,"t":"who we are - then epigenetic processes"},{"h":0.017615971814445075,"x":0.068041243297930931,"w":0.42886596679687494,"y":0.52172636511622461,"c":1,"t":"determine when and how each key can be"},{"c":1,"t":"struck, changing the tune being played.","x":0.0659793804204485,"y":0.53924418588371781,"w":0.40412371317545576,"h":0.01889534914976565},{"h":0.017615971814445075,"c":1,"y":0.57692307674861532,"x":0.068041239367475775,"t":"One way the study of epigenetics is","w":0.36082473754882816},{"t":"revolutionizing our understanding of","y":0.5944298586513731,"w":0.37347236633300779,"x":0.065874616147734641,"h":0.020489191490975278,"c":1},{"t":"biology is by revealing a mechanism by","y":0.61284668154604605,"w":0.39611653645833328,"h":0.020533724665571795,"c":1,"x":0.067924089559465647},{"t":"which the environment directly impacts on","w":0.43092783610026042,"y":0.63226744158065884,"x":0.065979380776255564,"h":0.017468318614410894,"c":1},{"c":1,"t":"genes. Studies of animals, for example,","x":0.065979381316255303,"w":0.40000000000000002,"y":0.64970930215976019,"h":0.018895349149765539},{"h":0.016508682573534661,"c":1,"x":0.065850504823458306,"w":0.40436498006184896,"t":"have shown that when a rat experiences","y":0.66855979194388671},{"x":0.065979381840175655,"y":0.68895348853279836,"c":1,"w":0.36907216389973962,"h":0.015988371754420694,"t":"stress during pregnancy, it can cause"},{"x":0.065790703140524681,"y":0.70462137427598059,"c":1,"h":0.020651637562848602,"w":0.41895245869954423,"t":"epigenetic changes in a fetus that lead to"},{"x":0.065831000989339347,"c":1,"y":0.72343447920522241,"w":0.41677472432454427,"h":0.019664067768448645,"t":"behavioral problems as the rodent grows"},{"c":1,"t":"up. Other epigenetic processes appear to","y":0.74418604666355048,"w":0.42268040974934895,"x":0.065979382384402166,"h":0.015988371754420583},{"t":"occur randomly, while others are normal,","y":0.76113036489179187,"w":0.40855117797851559,"x":0.067906919884447442,"h":0.02063725908853975,"c":1},{"t":"such as those that guide embryonic cells","x":0.063917522924178863,"w":0.41237113952636723,"h":0.017615971814445075,"c":1,"y":0.78038755154431982},{"y":0.094476744024460713,"w":0.42474227905273443,"h":0.018895349149765539,"c":1,"x":0.53608246862375453,"t":"as they become heart, brain, or liver cells,"},{"y":0.11358051104511879,"w":0.13263618469238281,"x":0.53573732192012324,"c":1,"t":"tor example.","h":0.017469784685673617},{"t":"Geneticist Danielle Reed has worked with","y":0.14970930249090553,"x":0.53814432520517752,"w":0.42061856587727864,"c":1,"h":0.015988371754420583},{"t":"many twins over the years and thought","c":1,"y":0.16852613022284235,"h":0.017615971814445075,"x":0.53814433954869889,"w":0.39381441752115887},{"h":0.017441861012089777,"w":0.37113400777180994,"c":1,"x":0.53814433620616531,"t":"deeply about what twin studies have","y":0.18749999972102838},{"w":0.40000000000000002,"x":0.53402061670103096,"h":0.018904736933817334,"t":"taught us. 'It's very clear when you look","c":1,"y":0.20493247233583289},{"w":0.37731959025065109,"c":1,"t":"at twins that much of what they share","y":0.22519083990890221,"h":0.017615971814445075,"x":0.53608247283563437},{"h":0.018895349149765539,"c":1,"w":0.3731958770751953,"x":0.53195876112735085,"y":0.2412790693749719,"t":"is hardwired,' she says. 'Many things"},{"w":0.41052447001139325,"c":1,"t":"about them are absolutely the same and","x":0.53598401135356921,"h":0.018485436072716466,"y":0.26158929269399933},{"t":"unalterable. But it's also clear, when you","y":0.28038755165986684,"h":0.019083969465648831,"c":1,"x":0.5360824731931999,"w":0.40412371317545581},{"t":"get to know them, that other things about","h":0.020676205736430253,"c":1,"x":0.53599439897656931,"y":0.29801861523604578,"w":0.42906351725260417},{"c":1,"w":0.37525772094726573,"h":0.017615971814445075,"t":"them are different. Epigenetics is the","x":0.53608247965195299,"y":0.31826189087723211},{"c":1,"x":0.53802322612487286,"h":0.020463203165857369,"t":"origin of a lot of those differences, in my","w":0.4105734761555988,"y":0.33452250484009693},{"c":1,"t":"view.'","x":0.53399019249544988,"y":0.35314105161220621,"w":0.059854666392008427,"h":0.016101617639511456},{"t":"Reed credits Thomas Bouchard's work for","w":0.42268040974934895,"h":0.01453488361674482,"c":1,"x":0.53608247542926224,"y":0.3909883721413504},{"h":0.020183012195705841,"y":0.40779194818298703,"t":"today's surge in twin studies. 'He was the","x":0.53388129869877976,"c":1,"w":0.41675801595052087},{"y":0.42718731675412813,"c":1,"t":"trailblazer,' she says. 'We forget that 50","w":0.39587628682454423,"h":0.019083969465648942,"x":0.53608247320628477},{"y":0.44767441888077908,"w":0.40824742635091149,"h":0.017441859892096456,"c":1,"t":"years ago things like heart disease were","x":0.53195876094580097},{"c":1,"y":0.46652965348287245,"x":0.53402061294516079,"t":"thought to be caused entirely by litestyle.","w":0.42474227905273443,"h":0.017615971814445075},{"t":"Schizophrenia was thought to be due","h":0.017456369965620944,"c":1,"y":0.48401162762832972,"w":0.38144330342610677,"x":0.53402061621777075},{"c":1,"x":0.5319587605981887,"t":"to poor mothering. Twin studies have","y":0.50290697702239029,"w":0.38144330342610677,"h":0.017441859892096456},{"t":"allowed us to be more reflective about","h":0.014679976512037562,"c":1,"w":0.39381444295247392,"y":0.52172636544183471,"x":0.53402061346480878},{"x":0.5340206193757645,"h":0.017441861012089666,"t":"what people are actually born with and","c":1,"y":0.54069767414032621,"w":0.39587628682454434},{"w":0.30364481608072924,"c":1,"t":"what's caused by experience.'","x":0.53380870097383182,"y":0.55661338372426372,"h":0.021910185262307147},{"x":0.53402061345775853,"y":0.59593023227933517,"t":"Having said that, Reed adds, the latest","w":0.39381444295247392,"h":0.017441861012089666,"c":1},{"c":1,"t":"work in epigenetics promises to take our","h":0.019768870023860741,"y":0.61307779422447561,"x":0.5318523135454345,"w":0.41466201782226553},{"h":0.02018218676062522,"y":0.6307321297830959,"x":0.53177484312146095,"c":1,"t":"understanding even further. 'What I like","w":0.4024243672688802},{"h":0.01889534914976565,"w":0.42474227905273432,"c":1,"t":"to say is that nature writes some things in","x":0.52783504595493946,"y":0.64970930216361189},{"h":0.019083969465648831,"w":0.42061856587727864,"t":"pencil and some things in pen,' she says.","x":0.52783504693831451,"c":1,"y":0.66852613049923149},{"h":0.017446981621572544,"c":1,"y":0.68895348809328871,"t":"Things written in pen you can't change.","x":0.53195876093191163,"w":0.40824742635091149},{"y":0.70603211137450794,"w":0.40434000651041668,"x":0.52977316660537688,"h":0.0186899591738241,"c":1,"t":"That's DNA. But things written in pencil"},{"c":1,"x":0.52989690386197363,"t":"you can. That's epigenetics. Now that","y":0.72519083989749544,"w":0.38556701660156256,"h":0.017615971814445075},{"h":0.017441861012089777,"c":1,"t":"we're actually able to look at the DNA","y":0.74418604623307083,"x":0.53195876554477084,"w":0.38762886047363276},{"h":0.017458076835448644,"t":"and see where the pencil writings are, it's","y":0.76306517924711958,"c":1,"x":0.52783505275764719,"w":0.42268040974934895},{"c":1,"w":0.28495811462402343,"y":0.7789971004932309,"t":"sort of a whole new world.'","x":0.52353238512302069,"h":0.019200115013458641},{"y":0.9520348836013085,"x":0.059793814264352284,"w":0.028865979512532551,"h":0.013081395479068947,"c":1,"t":"88"},{"x":0.35219182921665737,"y":0.95430545575796244,"c":1,"w":0.29150405883789066,"h":0.02261628057420495,"t":"leltsresources.org"}],"w":2400,"h":3406}