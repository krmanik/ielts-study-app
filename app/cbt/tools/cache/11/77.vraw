{"w":2400,"h":3406,"lines":[{"t":"Test 3","w":0.063917522430419926,"y":0.046388726026465377,"c":1,"h":0.014679976512037562,"x":0.068041238681697258},{"x":0.070103093467807021,"w":0.25360824584960939,"t":"WRITING TASK 2","h":0.015988371754420583,"c":1,"y":0.095930232720779052},{"y":0.13505578403757568,"w":0.49278350830078121,"h":0.01614797416324143,"c":1,"t":"You should spend about 40 minutes on this task.","x":0.068041235436360856},{"x":0.070103093330703997,"h":0.017615971814445075,"c":1,"w":0.31134020487467451,"y":0.17146212560227703,"t":"Write about the following topic:"},{"c":1,"x":0.094845372518329321,"t":"Some people say that the only reason for learning a foreign language is in","y":0.22372284202814052,"w":0.80412368774414056,"h":0.017615971814445186},{"w":0.822832539876302,"x":0.092707777216024564,"y":0.24005452282826256,"c":1,"t":"order to travel to or work in a foreign country. Others say that these are not","h":0.021243506995496264},{"w":0.69896906534830727,"h":0.016147974163241319,"x":0.09278350844395078,"c":1,"t":"the only reasons why someone should learn a foreign language.","y":0.26159718124635711},{"x":0.092783515533219549,"t":"Discuss both these views and give your own opinion.","w":0.58144327799479167,"h":0.017441861012089888,"c":1,"y":0.2979651160022796},{"t":"Give reasons for your answer and include any relevant examples from your own","x":0.068041235154441132,"c":1,"w":0.8082474263509114,"h":0.016147974163241319,"y":0.34586024658207615},{"c":1,"t":"knowledge or experience.","w":0.26185567220052081,"y":0.3648255814047664,"x":0.068041234889430313,"h":0.015988371754420583},{"h":0.020136055355553517,"c":1,"y":0.39861775816112188,"x":0.067718379316098046,"w":0.25230468750000001,"t":"Write at least 250 words."},{"c":1,"h":0.013081395479068947,"y":0.9520348836013085,"t":"78","x":0.059793814264352284,"w":0.028865979512532551},{"c":1,"h":0.022590341528793467,"y":0.95433050061023428,"t":"leltsresources.org","x":0.35215565856554271,"w":0.29146728515625003}]