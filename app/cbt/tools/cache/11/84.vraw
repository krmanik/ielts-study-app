{"lines":[{"h":0.022001681997015798,"x":0.86298573299007553,"y":0.032353708651178481,"c":1,"t":"Listening","w":0.099012463887532598},{"h":0.014679976512037562,"x":0.065979384551892936,"w":0.18556700388590491,"c":1,"t":"Questions 27-30","y":0.085731062704832439},{"w":0.3608247375488281,"h":0.01889534914976565,"c":1,"y":0.12354651146610385,"t":"Choose the correct letter, A, B or C.","x":0.063917528028503909},{"c":1,"t":"27 Joanna concentrated on women performers because","w":0.58366322835286466,"y":0.15980984225392914,"x":0.061766286830435981,"h":0.018125375018565038},{"t":"women are more influenced by fashion.","x":0.16082474224143667,"c":1,"w":0.40000000000000008,"h":0.017446981061575939,"y":0.18895348864922556},{"x":0.1134020620557212,"t":"B","w":0.016494844754536941,"h":0.013081395479069058,"c":1,"y":0.20784883703517476},{"w":0.018556701342264822,"h":0.013081395479068947,"x":0.11134020592680575,"c":1,"t":"C","y":0.22674418588795719},{"w":0.44764022827148442,"x":0.15867979297783744,"y":0.2060494970798632,"c":1,"t":"women's dress has led to more controversy.","h":0.017865575206888695},{"c":1,"x":0.15876288677167386,"t":"women's code of dress is less strict than men's.","y":0.2251908397946345,"w":0.48453608194986986,"h":0.016147974163241319},{"x":0.061855679974112544,"h":0.019083969465648831,"c":1,"w":0.85979380289713547,"y":0.25278919566088986,"t":"28 Mike Frost's article suggests that in popular music, women's dress is affected by"},{"y":0.28079627923863937,"w":0.32013684590657554,"h":0.020284604550248053,"c":1,"t":"their wish to be taken seriously.","x":0.15852786529994717},{"x":0.1134020620557212,"y":0.30232558122122133,"w":0.016494844754536941,"t":"B","h":0.013081395479068947,"c":1},{"x":0.10927835057789131,"w":0.020618556340535471,"h":0.013081395479069058,"y":0.32122093007400365,"t":"C","c":1},{"h":0.015988371754420583,"t":"their tendency to copy each other.","c":1,"w":0.34432988484700522,"y":0.30232558155924871,"x":0.15876289251310927},{"x":0.15245937399001042,"c":1,"t":"their reaction to the masculine nature of the music.","w":0.52193522135416659,"y":0.31687286616947818,"h":0.020395806447520259},{"h":0.019391015635751963,"y":0.34676404779211689,"c":1,"x":0.061771815320713491,"t":"29 What did Joanna's subjects say about the audience at a performance?","w":0.76098052978515618},{"y":0.37407982420684038,"x":0.15861323008497757,"w":0.70959599812825513,"h":0.022092396976383544,"c":1,"t":"The musicians' choice of clothing is linked to respect for the audience."},{"w":0.014432989756266265,"c":1,"t":"B","y":0.39680232584278852,"x":0.11340206171980501,"h":0.011627906221399864},{"x":0.11134020592680575,"w":0.018556701342264822,"h":0.013081395479068947,"t":"C","c":1,"y":0.41569767426005022},{"c":1,"x":0.15670103211905911,"h":0.015998613533382944,"w":0.62268040974934902,"y":0.39680232574756169,"t":"The clothing should not distract the audience from the music."},{"t":"The audience should make the effort to dress appropriately.","y":0.41212022398899151,"c":1,"x":0.15037461037760447,"w":0.612687021891276,"h":0.020323463838659017},{"c":1,"t":"30 According to the speakers, musicians could learn from sports scientists about","x":0.061855662654169329,"y":0.44331395321261424,"w":0.83298970540364581,"h":0.017441861012089777},{"t":"the importance of clothing for physical freedom.","w":0.48659795125325522,"h":0.016147974163241319,"c":1,"x":0.15463916860017649,"y":0.46212566082928153},{"h":0.015988371754420583,"y":0.48110465132837377,"t":"the part played by clothing in improving pertormance.","x":0.15876288752246126,"c":1,"w":0.53814432779947918},{"y":0.49854651155887564,"c":1,"t":"C","w":0.018556701342264809,"h":0.01453488361674482,"x":0.11134020594398786},{"y":0.49853200218286575,"w":0.52783503214518224,"h":0.017456369405624339,"c":1,"t":"the way clothing may protect against physical injury.","x":0.15670104562843964},{"c":1,"y":0.94331395336379531,"x":0.92577319635136746,"t":"85","w":0.032989689509073883,"h":0.013081395479068947},{"t":"leltsresources.org","h":0.0211970541523403,"c":1,"y":0.95429938113709101,"w":0.28948605855305992,"x":0.35218791086497353}],"w":2400,"h":3406}