35,"t":"something that was important to them personally.","w":0.51340204874674478},{"c":1,"x":0.055670108235474532,"t":"25 What was the aim of the writing exercise done by the subjects?","y":0.59156976716569865,"w":0.6907216389973958,"h":0.017441861012089777},{"x":0.15257732043505945,"c":1,"y":0.62209302317979698,"h":0.013081395479068947,"w":0.16701030731201172,"t":"to reduce stress"},{"t":"B","x":0.10515463891649647,"y":0.63953488356237598,"c":1,"w":0.018556701342264822,"h":0.013081395479068947},{"h":0.017615971814445186,"x":0.1525773248707229,"w":0.27216494242350259,"c":1,"t":"to strengthen verbal ability","y":0.63945977703702905},{"h":0.018427461858224081,"t":"C to encourage logical thinking","x":0.10503249250484586,"y":0.65689564724565819,"w":0.34253300984700513,"c":1},{"y":0.68604651135109163,"t":"26 What surprised the researchers about the study?","w":0.54639175415039065,"h":0.017441861012089777,"c":1,"x":0.055670102203548642},{"x":0.10496518653147215,"h":0.021570201208503281,"w":0.48906412760416673,"c":1,"t":"A how few students managed to get A grades","y":0.71158986631613252},{"x":0.13402062394360656,"y":0.73399882542887662,"w":0.57525772094726557,"c":1,"h":0.016001174398120988,"t":"the positive impact it had on physics results for women"},{"w":0.59399734497070311,"h":0.018382118928453539,"c":1,"x":0.10505753272784228,"t":"C the difference between male and female performance","y":0.75100276989576609},{"y":0.77814668152799082,"h":0.020054083044082294,"w":0.71146209716796871,"t":"27 Greg and Lisa think Miyake's results could have been affected by","c":1,"x":0.055603991819596341},{"w":0.34226804097493491,"t":"A the length of the writing task.","y":0.80945390512921944,"c":1,"x":0.10721649487206861,"h":0.016147974163241319},{"c":1,"t":"B the number of students who took part.","w":0.43711339314778652,"x":0.10515464352819867,"h":0.015988371754420583,"y":0.82848837225844396},{"c":1,"t":"C the information the students were given.","y":0.84499752687276075,"w":0.460147