{"lines":[{"x":0.86134510906473793,"h":0.01739647552257273,"t":"Reading","c":1,"y":0.046987277459339616,"w":0.089489657084147134},{"t":"READING","x":0.4266421075799347,"y":0.092398117840849725,"w":0.14259207407633456,"h":0.020145624578524091,"c":1},{"h":0.015988371754420583,"c":1,"y":0.1598837210943429,"t":"READING PASSAGE 1","x":0.051546389552725932,"w":0.32371134440104166},{"h":0.019083969465648831,"c":1,"w":0.87010304768880209,"t":"You should spend about 20 minutes on Questions 1-13, which are based on Reading","x":0.05154641419326348,"y":0.19759248421433628},{"x":0.051546390316180558,"y":0.21656976771573133,"h":0.017441859892096456,"t":"Passage 1 below.","w":0.17731959025065105,"c":1},{"y":0.25132119775086115,"t":"THE STORY OF SILK","x":0.22474226217773907,"h":0.0234879624192601,"c":1,"w":0.54020619710286455},{"t":"The history of the world's most luxurious fabric,","x":0.15016782689097,"h":0.0336347065879119,"y":0.28921855766451499,"w":0.69775833129882814,"c":1},{"t":"from ancient China to the present day","h":0.018932902525959472,"y":0.31972988832415261,"w":0.55257731119791675,"c":1,"x":0.21443299377661787},{"c":1,"t":"Silk is a fine, smooth material produced","y":0.35901162762890004,"w":0.39381444295247398,"h":0.017441861012089777,"x":0.049484530998532443},{"w":0.40824742635091144,"c":1,"y":0.37786259549382273,"t":"from the cocoons - soft protective shells","h":0.01614797416324143,"x":0.047422678471881079},{"x":0.04536081964095217,"y":0.39680232574525842,"w":0.39381444295247398,"t":"- that are made by mulberry silkworms","h":0.015998613533382944,"c":1},{"c":1,"x":0.047422680286597893,"t":"(insect larvae). Legend has it that it was","y":0.41424418620781878,"h":0.015988371754420583,"w":0.40000000000000002},{"w":0.36494845072428383,"x":0.04742268172169678,"y":0.4330593073586253,"t":"Lei Tzu, wife of the Yellow Emperor,","c":1,"h":0.019083969465648831},{"y":0.45203488355671295,"x":0.047422680838833269,"w":0.36907216389973957,"h":0.018898762889420717,"c":1,"t":"ruler of China in about 3000 BC, who"},{"c":1,"t":"discovered silkworms. One account of the","x":0.049484538743981211,"y":0.46946564887891429,"h":0.014679976512037674,"w":0.41855669657389327},{"h":0.016147974163241319,"c":1,"t":"story goes that as she was taking a walk","x":0.047422686300159569,"y":0.48825601875640845,"w":0.40206184387207033},{"t":"in her husband's gardens, she discovered","x":0.045360828703462773,"y":0.50726744158257397,"w":0.41030927022298186,"h":0.017441861012089666,"c":1},{"w":0.39999999999999991,"x":0.047422680305377538,"c":1,"t":"that silkworms were responsible for the","y":0.52613035809594355,"h":0.016147974163241319},{"t":"destruction of several mulberry trees. She","c":1,"x":0.047287179104449517,"y":0.54319623429803354,"h":0.018391625431797731,"w":0.41881301879882815},{"w":0.38556701660156251,"h":0.01453488361674482,"t":"collected a number of cocoons and sat","x":0.047422677159873861,"c":1,"y":0.56250000004749301},{"x":0.047422674410804576,"y":0.58132706972922588,"w":0.39793815612792971,"c":1,"h":0.016147974163241319,"t":"down to have a rest. It just so happened"},{"w":0.40824740091959638,"x":0.047422691138139947,"h":0.017441859892096456,"t":"that while she was sipping some tea, one","y":0.5988372093708122,"c":1},{"t":"of the cocoons that she had collected","y":0.61768075259188981,"h":0.016091983456927972,"w":0.37339144388834633,"c":1,"x":0.047324898529023378},{"y":0.63652378180419888,"w":0.35257731119791663,"h":0.014679976512037562,"x":0.043298973167610152,"t":"landed in the hot tea and started to","c":1},{"y":0.65328746057160092,"c":1,"x":0.047250350996529654,"t":"unravel into a fine thread. Lei Tzu found","h":0.019970719700901252,"w":0.39829594930013024},{"w":0.42903350830078124,"c":1,"t":"that she could wind this thread around her","h":0.016826930916876259,"y":0.6723921870900702,"x":0.045278297045149997},{"t":"fingers. Subsequently, she persuaded her","x":0.045360822823122315,"y":0.69172049311096473,"w":0.40824742635091149,"h":0.017615971814445075,"c":1},{"c":1,"w":0.39175257364908855,"t":"husband to allow her to rear silkworms","x":0.047422682030289993,"h":0.01453488361674482,"y":0.71075581399576027},{"c":1,"w":0.37731959025065104,"t":"on a grove of mulberry trees. She also","x":0.047422679026186125,"y":0.72959483288672577,"h":0.016147974163241319},{"h":0.015988371754420583,"x":0.04742267531781446,"c":1,"y":0.74854651179261411,"t":"devised a special reel to draw the fibres","w":0.39381444295247398},{"h":0.01453488361674482,"y":0.76744186051303231,"c":1,"t":"from the cocoon into a single thread so","x":0.047422676236624189,"w":0.38969072977701824},{"c":1,"x":0.045207075150619433,"y":0.78328920805175684,"h":0.01958908645531332,"w":0.39204699198404952,"t":"that they would be strong enough to be"},{"w":0.38556701660156251,"t":"woven into fabric. While it is unknown","c":1,"y":0.80377906993019055,"x":0.047422677165671369,"h":0.015988371754420583},{"w":0.42680414835611979,"h":0.017464904874755716,"y":0.82119788608989719,"x":0.043298956625909948,"t":"just how much of this is true, it is certainly","c":1},{"y":0.83998825603749594,"x":0.045360821976897607,"t":"known that silk cultivation has existed in","h":0.014679976512037562,"w":0.41237113952636717,"c":1},{"t":"China for several millennia.","x":0.047422683318464109,"w":0.27216494242350259,"h":0.013081395479069058,"c":1,"y":0.85901162783654306},{"c":1,"w":0.39793815612792982,"h":0.015988371754420583,"x":0.51340205585135579,"t":"Originally, silkworm farming was solely","y":0.35901162807200315},{"c":1,"t":"restricted to women, and it was they","y":0.37551550948516699,"w":0.36941576639811202,"h":0.021376860120754237,"x":0.51323472511906154},{"h":0.017452102231055422,"t":"who were responsible for the growing,","x":0.51340207434776686,"y":0.39534883727778891,"w":0.38969070434570319,"c":1},{"x":0.51340207076670896,"y":0.41424418615860292,"h":0.017441859892096456,"t":"harvesting and weaving. Silk quickly grew","c":1,"w":0.42061854044596358},{"h":0.019083969465648831,"x":0.51134020295299365,"y":0.43305930735602904,"c":1,"w":0.38556701660156245,"t":"into a symbol of status, and originally,"},{"x":0.51340205808207817,"y":0.45203488388574042,"w":0.41649485270182285,"h":0.015988371754420694,"t":"only royalty were entitled to have clothes","c":1},{"t":"made of silk. The rules were gradually","y":0.47093023272262502,"w":0.38556701660156256,"x":0.5134020586120247,"c":1,"h":0.015988371754420694},{"c":1,"x":0.51134020242445144,"y":0.48825601875923175,"w":0.41649485270182285,"h":0.016147974163241319,"t":"relaxed over the years until fnally during"},{"t":"the Qing Dynasty (1644-1911 AD), even","x":0.51134020606756148,"y":0.50726744158149351,"w":0.40000000000000002,"h":0.017441861012089777,"c":1},{"c":1,"x":0.51340206821270551,"h":0.017615971814445075,"t":"peasants, the lowest caste, were also","y":0.52613035820988985,"w":0.37113400777180994},{"h":0.01614797416324143,"c":1,"x":0.51340205716777909,"t":"entitled to wear silk. Sometime during the","w":0.42061856587727853,"y":0.5449207282788151},{"x":0.51118718900157056,"y":0.5607265867914667,"h":0.019793850354985931,"t":"Han Dynasty (206 BC-220 AD), silk was","w":0.40236475626627599,"c":1},{"w":0.42287656148274744,"h":0.017638705998956672,"t":"so prized that it was also used as a unit of","y":0.57991736415786654,"c":1,"x":0.51123689231765601},{"x":0.51340205903315694,"w":0.41237113952636717,"y":0.6002906978384257,"h":0.015988371754420694,"t":"currency. Government offcials were paid","c":1},{"h":0.018895349149765539,"y":0.61773255797645987,"t":"their salary in silk, and farmers paid their","w":0.41443298339843759,"x":0.51340206493728635,"c":1},{"t":"taxes in grain and silk. Silk was also used","w":0.41443298339843748,"c":1,"x":0.51134020924549706,"h":0.016147974163241319,"y":0.63652378136192689},{"h":0.015988371754420583,"t":"as diplomatic gifts by the emperor. rishing","x":0.51340205624855662,"c":1,"y":0.6555232559787888,"w":0.42474227905273421},{"c":1,"x":0.51134020289525606,"y":0.67439812081293826,"h":0.017462344010017672,"w":0.38556701660156256,"t":"lines, bowstrings, musical instruments"},{"x":0.51134020018707516,"h":0.017615971814445075,"t":"and paper were all made using silk. The","y":0.691720493111879,"c":1,"w":0.3979381561279296},{"c":1,"x":0.51134020058609764,"t":"earliest indication of silk paper being used","w":0.42474227905273443,"h":0.015988371754420583,"y":0.71075581411851485},{"h":0.014679976512037562,"y":0.72959483277381088,"w":0.37938143412272129,"x":0.51340206635200814,"c":1,"t":"was discovered in the tomb of a noble"},{"w":0.37525772094726562,"h":0.013081395479069058,"x":0.51340206726066906,"y":0.7485465115590747,"c":1,"t":"who is estimated to have died around"},{"c":1,"y":0.76598837223271654,"t":"168 AD.","x":0.51340206293238055,"h":0.015988371754420694,"w":0.080412368774414045},{"h":0.016965067533626255,"c":1,"y":0.8014035436253194,"w":0.40226799011230463,"x":0.51330228914525722,"t":"Demand for this exotic fabric eventually"},{"y":0.82119788585400211,"t":"created the lucrative trade route now","x":0.51134020565975136,"h":0.014679976512037674,"c":1,"w":0.37319587707519541},{"w":0.35051546732584626,"y":0.83998825627204654,"t":"known as the Silk Road, taking silk","x":0.51340206009016531,"h":0.017615971814445186,"c":1},{"h":0.018895349149765539,"x":0.51134020225021404,"w":0.38969072977701824,"t":"westward and bringing gold, silver and","y":0.85755813936203062,"c":1},{"t":"leltsresources.org","x":0.35219381067853611,"h":0.022608783338886163,"w":0.29146280924479168,"y":0.95433624876220058,"c":1},{"t":"65","x":0.91134020602630172,"y":0.95494186045114138,"w":0.028865979512532558,"h":0.01453488361674482,"c":1}],"h":3406,"w":2400}