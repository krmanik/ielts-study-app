{"h":3406,"w":2400,"lines":[{"x":0.88247422831755518,"h":0.021802325425117175,"w":0.078350512186686205,"y":0.036337209341531951,"c":1,"t":"Writing"},{"c":1,"w":0.25567011515299476,"y":0.084263065170097962,"t":"WRITING TASK 2","x":0.063917519627233563,"h":0.018934609395787061},{"c":1,"y":0.12350154921585921,"t":"You should spend about 40 minutes on this task.","x":0.061757780697583468,"w":0.4929724629720052,"h":0.020072151896397883},{"t":"Write about the following topic:","h":0.023693203436089272,"x":0.061489140252999591,"c":1,"w":0.31615819295247394,"y":0.15752348192777244},{"x":0.088659795541734823,"w":0.79175257364908846,"c":1,"h":0.020348836167448092,"y":0.21220930284369011,"t":"Many governments think that economic progress is their most important"},{"y":0.23106283068713873,"h":0.021844145975880136,"t":"goal. Some people, however, think that other types of progress are equally","w":0.81030929565429688,"c":1,"x":0.088659785060881305},{"y":0.24999999982797583,"t":"important for a country.","c":1,"w":0.26185567220052086,"h":0.018937169700528389,"x":0.086597936884275653},{"h":0.020551967116852587,"t":"Discuss both these views and give your own opinion.","x":0.088659804194662156,"y":0.28625954164236189,"c":1,"w":0.58144327799479167},{"t":"Give reasons for your answer and include any relevant examples from your own","x":0.061855675921121928,"y":0.33284883769109708,"h":0.020351397592182852,"w":0.80618555704752604,"c":1},{"c":1,"w":0.25979380289713538,"h":0.01453488361674482,"t":"knowledge or experience.","x":0.06185567573710557,"y":0.35610465120739121},{"c":1,"t":"Write at least 250 words.","x":0.059543792150660718,"h":0.018918423252251348,"w":0.25214836120605466,"y":0.38963772239043082},{"h":0.0211970541523403,"w":0.28948605855305992,"x":0.35218791086497353,"y":0.95429938113709101,"t":"leltsresources.org","c":1},{"x":0.91134020643690561,"y":0.94622093012896746,"c":1,"t":"101","w":0.041237112681070887,"h":0.013081395479068947}]}