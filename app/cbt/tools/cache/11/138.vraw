688491400244,"t":"not the most important thing. There are other progress are equally important. In this","y":0.55813270712870466,"c":1,"x":0.059793806463492465,"w":0.86391754150390632},{"x":0.059718331386518837,"c":1,"y":0.57501176709016322,"w":0.71151194254557293,"h":0.02115767182704642,"t":"essay, we are going to takking abot why people have different views."},{"y":0.60305343479963192,"h":0.019083969465648831,"c":1,"x":0.061855668421117303,"w":0.89278350830078124,"t":"Generally people think money is everyt.hing, if we do not have any money, we ean not buy"},{"t":"anything. So the goverrient.s put the economic progress to the top list. They believe","x":0.061855677593075406,"y":0.62209302297981395,"w":0.85154637654622389,"c":1,"h":0.017441861012089777},{"h":0.020551967116852587,"c":1,"x":0.059793820102643926,"y":0.63945977636683349,"w":0.85979380289713547,"t":"the if the economic progress could bring a good result, then people cars have money to"},{"h":0.023409214568572034,"w":0.87861094156901043,"x":0.059673399535054725,"y":0.65525941627487461,"c":1,"t":"rise satisfaction about their life. Hawever, other types of progress are not importonk."},{"w":0.87010304768880209,"c":1,"y":0.68604651135229311,"x":0.061855692544837096,"t":"Some people suggest that the government should not put. t.he economic progress to the","h":0.017441861012089777},{"h":0.018919246447345328,"y":0.70346447463582695,"c":1,"w":0.88041239420572925,"t":"most important place. Because there are other progress such as health system, building","x":0.059793802780199697},{"h":0.019213197655490233,"y":0.72090299339364239,"t":"design, or education system are the same important as economic for a country. A","x":0.061818442037151915,"c":1,"w":0.82691197713216147},{"h":0.01889534914976565,"c":1,"y":0.73982558123602304,"t":"country doesn't. have a completed system is not a completed country, even if it has","w":0.84742268880208349,"x":0.059793810143354734},{"c":1,"y":0.75854892319707168,"x":0.061811959426640799,"w":0.84132486979166676,"t":"a lot of money. In this morden society, more and more people realize that money is","h":0.017713426913643859},{"w":0.86804128011067705,"h":0.018919246447345328,"t":"not the important thing in the world, and it doesn't mean anyt.hing, while they think","x":0.059793792828366464,"y":0.77761627891107921,"c":1},{"h":0.017441861012089777,"y":0.79651162763018657,"t":"health, happeness are more important. t.han it. Oing to that., some peopte aigue thak","c":1,"w":0.87835052490234378,"x":0.059793809673164257},{"w":0.45800725301106776,"c":1,"x":0.059645973240092187,"t":"other types of progress are equally important.","y":0.81325204413657837,"h":0.022383142763631736},{"t":"From the paint of my view, I agree with that. other types of progress are as","x":0.061855678625778412,"y":0.84145625360200949,"h":0.017615971814445186,"c":1,"w":0.7896907043457031},{"x":0.059702308540550364,"h":0.02177407023350908,"c":1,"y":0.85799151539156593,"t":"important as economic. Even though we have a lot of money, we can not buy happeness","w":0.88264160156249993},{"c":1,"y":0.8778625957208821,"t":"and health. Therefore the government.s should put other types of progress to the","w":0.79999999999999993,"h":0.019083969465648831,"x":0.059793814510937862},{"c":1,"x":0.059793817774805025,"y":0.89812096286906329,"t":"important place as well.","w":0.24123710632324219,"h":0.014679976512037562},{"h":0.024146245216105311,"t":"leltsresources.org","c":1,"x":0.35211882393593585,"y":0.95282602791095983,"w":0.29363896687825519},{"w":0.045360825856526676,"h":0.013081395479068947,"c":1,"t":"139","x":0.91340206117725509,"y":0.95058139524524665}],"w":2400,"h":3406}