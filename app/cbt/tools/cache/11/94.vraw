{"h":3406,"lines":[{"t":"Reading","y":0.038428016721097746,"h":0.015607373545048042,"x":0.87382958662309762,"c":1,"w":0.085628573099772121},{"c":1,"h":0.016147974163241319,"w":0.18556700388590491,"y":0.085731062821110759,"t":"Questions 24-26","x":0.063917528882974778},{"t":"Complete each sentence with the correct ending, A-E, below.","x":0.063917533782965899,"h":0.018895349149765539,"y":0.12354651146799511,"w":0.62061854044596343,"c":1},{"x":0.063917534584172278,"t":"Write the correct letter, A-E, in boxes 24-26 on your answer sheet.","y":0.16133720914314054,"c":1,"h":0.018932902525959472,"w":0.67422678629557298},{"x":0.059719412070402884,"c":1,"t":"24 The audience's response to different parts of a film can be controlled","h":0.019284663309577788,"y":0.19570540208463783,"w":0.74241246541341144},{"t":"25 The feelings and motivations of characters become clear","y":0.22665883712112134,"x":0.059793808797404563,"h":0.016147974163241319,"c":1,"w":0.62474227905273438},{"x":0.059699585134659824,"y":0.2529154233664781,"h":0.018546239390348163,"t":"26 A character seems to be a real person rather than an actor","c":1,"w":0.64142827351888021},{"c":1,"t":"when the audience listens to the dialogue.","y":0.30615693076364681,"w":0.42905914306640625,"x":0.21847830228644663,"h":0.016691269485375027},{"t":"B if the film reflects the audience's own concerns.","w":0.53215123494466154,"y":0.33306559376220846,"c":1,"x":0.17105672142545594,"h":0.018727506390054716},{"y":0.36107795878364013,"h":0.021966608286043909,"x":0.17100661324598898,"c":1,"t":"C if voice, sound and music are combined appropriately.","w":0.59815602620442709},{"t":"D when the director is aware of how the audience will respond.","x":0.17107391485292472,"y":0.39241383404633934,"c":1,"w":0.66403722127278653,"h":0.016151915419752805},{"t":"E","y":0.42151162783794538,"c":1,"h":0.014534883616744931,"x":0.17113402081860779,"w":0.016494844754536941},{"t":"when the actor's appearance, voice and moves are","c":1,"w":0.5198732503255209,"h":0.021210180474111606,"y":0.41909784538247963,"x":0.2184202710909843},{"h":0.016391636551091548,"c":1,"w":0.2785984547932942,"y":0.43864250330948684,"x":0.21847487249130859,"t":"consistent with each other."},{"y":0.94476744174503624,"w":0.035051546096801722,"c":1,"h":0.013081395479068947,"t":"95","x":0.92371134021884738},{"y":0.95435630675035765,"c":1,"x":0.35221552505032294,"h":0.021121889160299556,"w":0.28942573547363282,"t":"leltsresources.org"}],"w":2400}