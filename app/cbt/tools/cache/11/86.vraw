{"w":2400,"h":3406,"lines":[{"h":0.016696004817154053,"x":0.86336220461221913,"w":0.087765464782714853,"c":1,"t":"Reading","y":0.032008857892241394},{"w":0.14432989756266279,"h":0.017441859892096345,"c":1,"y":0.079941860735476378,"t":"READING","x":0.42474226762951239},{"c":1,"t":"READING PASSAGE 1","w":0.32577318827311197,"y":0.1453317673604797,"x":0.049484541842825372,"h":0.016147974163241319},{"t":"You should spend about 20 minutes on Questions 1-13, which are based on Reading","x":0.049484551707325866,"c":1,"w":0.87216491699218746,"h":0.01889534914976565,"y":0.18459302309723147},{"x":0.047422678495136879,"t":"Passage 1 below.","w":0.17938144683837889,"h":0.01746575774967285,"c":1,"y":0.20346447450692062},{"w":0.30820185343424483,"h":0.027770525696553361,"x":0.34177078252690601,"c":1,"t":"Research using twins","y":0.23989373579320683},{"w":0.38144330342610677,"x":0.047422678013890052,"y":0.28479154428856701,"c":1,"t":"To biomedical researchers all over the","h":0.013211978860833917},{"c":1,"x":0.04742267847820017,"t":"world, twins offer a precious opportunity","y":0.3037790694889142,"w":0.40824742635091149,"h":0.017441861012089666},{"x":0.043298969956946015,"h":0.017450394801231006,"c":1,"w":0.39587628682454423,"y":0.32266588397430884,"t":"to untangle the influence of genes and"},{"y":0.33933718838394977,"w":0.41462972005208337,"h":0.016812414683388566,"c":1,"t":"the environment - of nature and nurture.","x":0.04321392580072294},{"x":0.045264360461945236,"y":0.35772828261021705,"w":0.36722554524739581,"t":"Because identical twins come from a","h":0.017322665722455666,"c":1},{"x":0.043172308190856795,"w":0.4023552958170572,"h":0.020789530021053659,"y":0.37636355129587229,"t":"single fertilized egg that splits into two,","c":1},{"h":0.017466611744583305,"t":"they share virtually the same genetic","c":1,"w":0.36907216389973957,"y":0.39680232530189419,"x":0.043298969510492828},{"x":0.045360826275602999,"c":1,"t":"code. Any differences between them -","w":0.39175257364908855,"y":0.41569767468954155,"h":0.017441859892096345},{"h":0.019083969465648831,"y":0.43452730524528838,"c":1,"x":0.043298971212409089,"t":"one twin having younger looking skin, for","w":0.41855669657389322},{"y":0.45240721348312007,"x":0.043191938274629631,"w":0.41877660115559895,"h":0.017370744235922997,"c":1,"t":"example - must be due to environmental"},{"w":0.41676961263020829,"c":1,"t":"factors such as less time spent in the sun.","y":0.47088152472620282,"x":0.043158234821290622,"h":0.018241600645897527},{"x":0.043298962804322369,"w":0.31340207417805988,"h":0.017441861012089777,"t":"Alternatively, by comparing the","c":1,"y":0.51017441832514998},{"c":1,"x":0.043074945183716552,"h":0.019703292174683695,"w":0.34477518717447914,"y":0.52568567031427149,"t":"experiences of identical twins with"},{"c":1,"t":"those of fraternal twins, who come from","x":0.045360818754352814,"y":0.54638872560294449,"w":0.39793815612792971,"h":0.016147974163241319},{"t":"separate eggs and share on average","w":0.36494845072428383,"h":0.014534883616744709,"c":1,"x":0.045360826144158178,"y":0.56686046512799715},{"h":0.017615971814445186,"y":0.58426306505693193,"t":"half their DNA, researchers can quantify","x":0.043298974873360312,"c":1,"w":0.40206184387207028},{"y":0.60305343523310773,"c":1,"t":"the extent to which our genes affect our","w":0.40618555704752607,"h":0.017615971814445075,"x":0.041237118354587494},{"y":0.62037293972291552,"w":0.38783749898274733,"h":0.017947454558914,"c":1,"t":"lives. Ifidentical twins are more similar","x":0.041132680199549111},{"c":1,"y":0.6409277743410311,"x":0.043298974871055267,"t":"to each other with respect to an ailment","w":0.40206184387207028,"h":0.014679976512037562},{"t":"than traternal twins are, then vulnerability","h":0.017450395361227722,"c":1,"y":0.65988372065213163,"w":0.41855669657389327,"x":0.041237115523122675},{"c":1,"x":0.043298973941408338,"t":"to the disease must be rooted at least in","y":0.67877906958118905,"w":0.40618555704752607,"h":0.011767025632292705},{"t":"part in heredity.","h":0.017615971814445075,"c":1,"w":0.15670102437337238,"y":0.69612448603942656,"x":0.041237116555581842},{"x":0.041237117051710709,"h":0.01745466253579675,"t":"These two lines of research - studying","c":1,"y":0.73399882553998752,"w":0.38350514729817708},{"w":0.39587628682454434,"c":1,"t":"the differences between identical twins","x":0.039175258514147944,"y":0.75278919549109269,"h":0.014679976512037562},{"x":0.039175259814353276,"y":0.77180232586032194,"t":"to pinpoint the intluence of environment,","w":0.41855669657389322,"h":0.017441859892096456,"c":1},{"c":1,"t":"and comparing identical twins with","h":0.020049941308765806,"y":0.7890711854406337,"x":0.041120225679697503,"w":0.35075531005859373},{"h":0.016053831444301836,"y":0.808102087038298,"x":0.041117963961196151,"c":1,"t":"fraternal ones to measure the role","w":0.342493158976237},{"h":0.015988371754420583,"w":0.36494845072428383,"c":1,"t":"of inheritance - have been crucial to","x":0.041237110643012803,"y":0.82703488369037692},{"h":0.021069399553120927,"w":0.42296984354654948,"t":"understanding the interplay of nature and","x":0.039050847449173885,"c":1,"y":0.8452647210834664},{"h":0.017455516530707205,"c":1,"y":0.86627906948768107,"t":"nurture in determining our personalities,","x":0.039175254887116796,"w":0.41237113952636723},{"y":0.88517441832542687,"w":0.38144330342610677,"x":0.041237111049426241,"h":0.017441861012089777,"c":1,"t":"behavior, and vulnerability to disease."},{"c":1,"x":0.51323341179836501,"t":"The idea of using twins to measure the","y":0.28423149850448648,"w":0.3941284688313802,"h":0.019375640367383595},{"h":0.018895349149765539,"c":1,"t":"influence of heredity dates back to 1875,","y":0.30377906960613832,"x":0.50927834674516215,"w":0.41649485270182285},{"h":0.017450395361227833,"t":"when the English scientist Francis Galton","y":0.32266588397674101,"c":1,"x":0.51134020240135347,"w":0.41649485270182296},{"c":1,"w":0.42492708841959625,"y":0.34007252984041658,"t":"first suggested the approach (and coined","x":0.50916609729238782,"h":0.020187859526817231},{"y":0.35778131928301149,"x":0.51120753054998624,"w":0.37342435201009105,"h":0.018914277036961469,"c":1,"t":"the phrase 'nature and nurture'). But"},{"x":0.50927834906797353,"y":0.37786259560792756,"c":1,"w":0.37731959025065098,"h":0.017615971814445075,"t":"twin studies took a surprising twist in"},{"x":0.51118161811789131,"c":1,"w":0.40856257120768225,"y":0.394540440361272,"h":0.021801335351017692,"t":"the 1980s, with the arrival of studies into"},{"w":0.4103092702229818,"h":0.017441861012089777,"y":0.41569767414069103,"t":"identical twins who had been separated","x":0.50721649880603481,"c":1},{"y":0.43452730501118553,"t":"at birth and reunited as adults. Over two","h":0.01614797416324143,"c":1,"x":0.51134020331590235,"w":0.41237113952636717},{"c":1,"h":0.020689981654330114,"t":"decades 137 sets of twins eventually","x":0.51112222412370079,"y":0.45035973172782662,"w":0.36955833435058594},{"y":0.47238372097717107,"h":0.01453488361674482,"x":0.50927835226589957,"w":0.39175257364908855,"t":"visited Thomas Bouchard's lab in what","c":1},{"x":0.5112580943571714,"y":0.48978946263059298,"w":0.42700871785481775,"c":1,"t":"became known as the Minnesota Study of","h":0.020326926858020622},{"w":0.42474227905273432,"h":0.015988371754420583,"c":1,"x":0.50927834481677114,"t":"Twins Reared Apart. Numerous tests were","y":0.5101744187666184},{"x":0.50927835900220808,"w":0.39793813069661454,"h":0.018913272402948711,"t":"carried out on the twins, and they were","c":1,"y":0.5275983554713527},{"x":0.50927835444586478,"w":0.41030927022298169,"t":"each asked more than 15,000 questions.","h":0.019083969465648831,"c":1,"y":0.54638872527565974},{"x":0.51134020203520225,"c":1,"t":"Bouchard and his colleagues used this","w":0.38969072977701824,"h":0.017615971814445075,"y":0.58426306505491044},{"y":0.60155616115891863,"w":0.36735626220703121,"x":0.50911624084853713,"c":1,"t":"mountain of data to identify how far","h":0.020926618324051294},{"h":0.01889534914976565,"c":1,"y":0.62063953471869482,"x":0.50927835190876303,"t":"twins were affected by their genetic","w":0.36494845072428372},{"x":0.50927835630543994,"y":0.64092777457508632,"w":0.40206184387207033,"h":0.017615971814445075,"c":1,"t":"makeup. The key to their approach was"},{"h":0.021658782600586513,"x":0.50705840078496633,"w":0.38802858988444011,"y":0.65579283139163191,"c":1,"t":"a statistical concept called heritability."},{"c":1,"t":"in broad terms, the heritability of a trait","x":0.50712728491287729,"y":0.6772471434181988,"w":0.40431732177734381,"h":0.019578564118023056},{"h":0.013211978860833917,"c":1,"y":0.69759248374194782,"x":0.50721649698564575,"t":"measures the extent to which ditterences","w":0.41855669657389316},{"t":"among members of a population can be","y":0.71351061444351838,"w":0.41270256042480469,"x":0.50704267262249758,"h":0.021020507364502672,"c":1},{"t":"explained by differences in their genetics.","y":0.73399882553940432,"w":0.42474227905273443,"h":0.01745466253579675,"c":1,"x":0.50927834486243984},{"t":"And wherever Bouchard and other","w":0.35463918050130205,"y":0.7527891954931355,"x":0.50721649212264575,"h":0.014679976512037562,"c":1},{"c":1,"t":"scientists looked, it seemed, they found","x":0.50721649972807015,"w":0.40618555704752601,"y":0.77180232542006511,"h":0.018895349149765539},{"h":0.022485326474649514,"c":1,"x":0.50490357342468906,"w":0.39022356669108071,"t":"the invisible hand of genetic influence","y":0.78741820574285593},{"x":0.50721649773745892,"y":0.80945390468342693,"c":1,"w":0.27216494242350264,"h":0.017615971814445075,"t":"helping to shape our lives."},{"x":0.50515464038305746,"y":0.84732824402307272,"c":1,"h":0.017615971814445075,"w":0.42268040974934895,"t":"Lately, however, twin studies have helped"},{"x":0.50497157494366107,"c":1,"y":0.86298386087577306,"w":0.43544255574544277,"h":0.019355386408090758,"t":"lead scientists to a radical new conclusion:"},{"c":1,"t":"that nature and nurture are not the only","y":0.88517441876965453,"w":0.40206184387207033,"x":0.50721650064183865,"h":0.015988371754420583},{"t":"leltsresources.org","y":0.95433624864730393,"w":0.29149803161621091,"x":0.35219443363911673,"h":0.022583953086866559,"c":1},{"t":"87","x":0.91134020616125955,"w":0.028865979512532558,"h":0.01453488361674482,"c":1,"y":0.95058139525558105}]}