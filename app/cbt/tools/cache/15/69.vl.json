{"blocks":[{"l":"paragraph_title","b":[0.13,0.0987,0.1921,0.1158],"t":"Test 4"},{"l":"text","b":[0.1292,0.142,0.3375,0.1605],"t":"Questions 17 and 18"},{"l":"text","b":[0.1292,0.1758,0.3713,0.1938],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.1275,0.2088,0.6746,0.2274],"t":"What does the speaker say about the adventure playground?"},{"l":"text","b":[0.17,0.2353,0.48,0.2515],"t":"A Children must be supervised."},{"l":"text","b":[0.1704,0.2527,0.4217,0.268],"t":"B It costs more in winter."},{"l":"text","b":[0.17,0.2686,0.62,0.2854],"t":"C Some activities are only for younger children."},{"l":"text","b":[0.1713,0.286,0.4342,0.3019],"t":"D No payment is required."},{"l":"text","b":[0.1708,0.3028,0.4475,0.3193],"t":"E It was recently expanded."},{"l":"paragraph_title","b":[0.13,0.3726,0.3383,0.3909],"t":"Questions 19 and 20"},{"l":"text","b":[0.1296,0.4068,0.3708,0.4239],"t":"Choose TWO letters, A-E."},{"l":"text","b":[0.1713,0.466,0.4879,0.4822],"t":"A They are closed at weekends."},{"l":"text","b":[0.1708,0.4831,0.5513,0.4987],"t":"B Volunteers are needed to work there."},{"l":"text","b":[0.1279,0.4398,0.5996,0.4574],"t":"What does the speaker say about the glass houses?"},{"l":"text","b":[0.1713,0.4993,0.5233,0.5158],"t":"C They were badly damaged by fire."},{"l":"text","b":[0.1713,0.5158,0.6708,0.5325],"t":"D More money is needed to repair some of the glass."},{"l":"text","b":[0.1713,0.5334,0.6542,0.5502],"t":"E Visitors can see palm trees from tropical regions."},{"l":"number","b":[0.1325,0.9175,0.1588,0.9325],"t":"76"},{"l":"footer","b":[0.2204,0.9161,0.3133,0.9334],"t":"p. 125"},{"l":"footer","b":[0.3275,0.9152,0.4188,0.9337],"t":"目 p. 114"}]}