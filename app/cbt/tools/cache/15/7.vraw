{"lines":[{"h":0.013250883392226132,"c":1,"t":"Test 1","x":0.12962962921278212,"y":0.10306242663311671,"w":0.057613169352213528},{"w":0.20164609273274742,"h":0.014563987898180697,"c":1,"y":0.14680232544054428,"t":"Questions 27 and 28","x":0.13168724163281487},{"y":0.18021201409361765,"x":0.12962963156487106,"h":0.017462404653237007,"c":1,"t":"Choose the correct letter, A, B or C.","w":0.32098765055338546},{"x":0.1295154139396047,"y":0.20303091992217548,"w":0.77389414469401041,"h":0.020169126692593298,"t":"27 What do the speakers say about the evidence relating to birth order and academic","c":1},{"h":0.013081395583944722,"y":0.22383720907576021,"c":1,"w":0.086419754028320334,"t":"success?","x":0.17283950621629249},{"t":"A There is conflicting evidence about whether oldest children perform best in","h":0.020051652888105842,"c":1,"w":0.7060215759277344,"y":0.24553732510240289,"x":0.17271411033219836},{"h":0.016195524146054185,"w":0.16460905710856122,"y":0.2659010601859132,"t":"intelligence tests.","x":0.21193415449019554,"c":1},{"x":0.1748064899777188,"w":0.63595932006835931,"h":0.016650199328490989,"c":1,"y":0.27990456493777116,"t":"B There is little doubt that birth order has less influence on academic"},{"y":0.29799036642286847,"h":0.014542998638535032,"t":"achievement than socio-economic status.","c":1,"w":0.37258084615071618,"x":0.21599043472054943},{"y":0.31315956300736514,"c":1,"t":"C Some studies have neglected to include important factors such as family size.","h":0.019056657177820568,"w":0.73472793579101559,"x":0.1748124105776615},{"c":1,"x":0.12946371976536833,"y":0.33712492530957383,"w":0.70402562459309903,"t":"28 What does Ruth think is surprising about the difference in oldest children's","h":0.021195512778346082},{"t":"academic performance?","x":0.17467881974833915,"w":0.21654838562011719,"c":1,"y":0.35745308036421952,"h":0.018404457397820373},{"y":0.38221437011169146,"h":0.017494932361148963,"t":"It is mainly thanks to their roles as teachers for their younger siblings.","w":0.617283935546875,"c":1,"x":0.21810700350720311},{"y":0.39753768182684968,"c":1,"x":0.22004131687583936,"t":"The advantages they have only lead to a slightly higher level of achievement.","h":0.020244681512228357,"w":0.68540008544921871},{"c":1,"w":0.60507944742838538,"h":0.018782106810660615,"t":"The extra parental attention they receive at a young age makes little","x":0.21804297786327159,"y":0.41549411969394057},{"c":1,"x":0.21792101853520393,"t":"difference.","w":0.099248701731363936,"y":0.43470931432780602,"h":0.013985160944459007},{"y":0.49999999986189247,"w":0.20370370229085286,"h":0.014534883982160851,"c":1,"x":0.13374485657062293,"t":"Questions 29 and 30"},{"t":"Choose TWO letters, A-E.","c":1,"w":0.24074073791503908,"y":0.53343023239354448,"x":0.1337448572751947,"h":0.017512052443900861},{"c":1,"x":0.13158763528016143,"t":"Which TWO experiences of sibling rivalry do the speakers agree has been valuable","y":0.56370695129867943,"h":0.020454220271924894,"w":0.74096150716145837},{"h":0.013491311539469142,"y":0.58409736747097274,"t":"for them?","w":0.090651893615722651,"c":1,"x":0.1295711724306825},{"c":1,"t":"A","y":0.61046511606807752,"w":0.018518517812093099,"h":0.013081395583944722,"x":0.17489711959189586},{"t":"learning to share","h":0.017492695326518648,"c":1,"y":0.60847497348671109,"w":0.15490222930908207,"x":0.21780297580032973},{"t":"learning to stand up for oneself","w":0.2823002624511719,"h":0.018217305833796327,"x":0.21792022382891083,"y":0.62420747698602019,"c":1},{"t":"learning to be a good loser","h":0.01598837238037687,"c":1,"x":0.21810699263787739,"w":0.2427983601888021,"y":0.64244186031018014},{"w":0.19958848317464195,"h":0.01453488398216074,"c":1,"x":0.21810699287877128,"t":"learning to be tolerant","y":0.65988372079204705},{"w":0.18518519083658855,"h":0.014723203769140158,"t":"learning to say sorry","y":0.67726737342372145,"c":1,"x":0.21810699294730038},{"w":0.026748971939086902,"h":0.013081395583944611,"c":1,"y":0.9