{"w":2400,"h":3395,"lines":[{"w":0.080344740549723292,"h":0.017667770385742188,"c":1,"t":"Reading","x":0.79213215635500089,"y":0.097270765943001991},{"h":0.01453488398216074,"c":1,"x":0.090534979322306627,"y":0.14389534869727683,"t":"Questions 23-26","w":0.16666666666666663},{"w":0.70781890869140629,"t":"Look at the following statements (Questions 23-26) and the list of people below.","x":0.088477376851747072,"y":0.17726737340315069,"h":0.017500068610632802,"c":1},{"w":0.50617284138997398,"y":0.21075581379310115,"c":1,"t":"Match each statement with the correct person, A, B or C.","x":0.088477365209932379,"h":0.017453844611860947},{"w":0.63798497517903652,"h":0.019730845385080742,"c":1,"y":0.24262119471157761,"t":"Write the correct letter, A, B or C, in boxes 23-26 on your answer sheet.","x":0.090477625706737688},{"x":0.088477368480960619,"y":0.27761627892089957,"c":1,"w":0.40123456319173173,"t":"NB You may use any letter more than once.","h":0.01598837238037687},{"c":1,"h":0.013081395583944611,"y":0.31249999982298537,"t":"23","x":0.088477365985927162,"w":0.028806584676106792},{"y":0.31095406346810539,"h":0.017667844522968323,"t":"Reintroducing an extinct species to its original habitat could improve the health of a","w":0.75102879842122394,"c":1,"x":0.11522634155031426},{"t":"particular species living there.","x":0.13168724849658558,"w":0.26748970031738284,"y":0.32979976453895254,"c":1,"h":0.01472320376914027},{"t":"24 It is important to concentrate on the causes of an animal's extinction.","x":0.08841450335034215,"w":0.65237335205078117,"h":0.018068566339176084,"c":1,"y":0.35287602221744019},{"h":0.018918274429015725,"t":"25 A species brought back from extinction could have an important beneficial impact","w":0.76143839518229162,"c":1,"x":0.088425311313050939,"y":0.37911670045442458},{"x":0.12962962529874839,"h":0.014723203769140158,"t":"on the vegetation of its habitat.","c":1,"w":0.27777778625488281,"y":0.39811542992440008},{"x":0.088477354851361795,"h":0.016195524146054185,"t":"26 Our current efforts at preserving biodiversity are insufficient.","y":0.42285041236429843,"c":1,"w":0.57407409667968756},{"w":0.13380830128987631,"t":"List of People","x":0.41354852419159027,"y":0.47515719209215646,"h":0.016255383216309705,"c":1},{"t":"Ben Novak","w":0.10699588775634766,"c":1,"x":0.40534979265102672,"y":0.50145348824062286,"h":0.013081395583944611},{"t":"B Michael Archer","y":0.52616279042171032,"c":1,"w":0.18106995900472,"h":0.014534883982160851,"x":0.36625514453056174},{"t":"Beth Shapiro","h":0.016784401748711208,"w":0.12571269989013667,"y":0.55192756650039954,"c":1,"x":0.40319303269467111},{"w":0.11739359537760419,"h":0.014983078335423894,"y":0.91838055384221051,"t":"→ • p. 122","c":1,"x":0.69541842854954461},{"x":0.84773662535741989,"c":1,"y":0.91569767467668972,"t":"43","w":0.02880658467610675,"h":0.015988371257085632}]}