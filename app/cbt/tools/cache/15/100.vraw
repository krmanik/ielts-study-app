{"lines":[{"w":0.09682772318522137,"y":0.14660060758508509,"h":0.01493831967015713,"x":0.3867713235144517,"t":"TEST 3","c":1},{"x":0.086419752006965139,"w":0.096707820892333984,"y":0.20494186031835115,"c":1,"t":"PART 1","h":0.01453488398216074},{"w":0.047325102488199877,"x":0.086419753346949429,"y":0.23255813937986292,"h":0.010174418787512463,"c":1,"t":"SALLY:"},{"t":"JOE:","h":0.011627907185728703,"y":0.26162790679957759,"c":1,"w":0.034979422887166337,"x":0.084362140421128759},{"y":0.27616279056549664,"w":0.047325102488199877,"h":0.011627907185728703,"t":"SALLY:","x":0.086419753179768383,"c":1},{"c":1,"t":"JOE:","x":0.086419753305024022,"w":0.032921810150146488,"y":0.30523255802152516,"h":0.008720930389296444},{"t":"SALLY:","x":0.086419753179768383,"w":0.047325102488199877,"c":1,"h":0.011627907185728592,"y":0.31976744172828742},{"h":0.010174418787512463,"w":0.032921810150146488,"t":"JOE:","c":1,"x":0.086419753265118804,"y":0.34883720917698025},{"w":0.045267489751180015,"h":0.008720930389296333,"y":0.36337209292308437,"c":1,"t":"SALLY:","x":0.088477366132640442},{"h":0.010174418787512463,"c":1,"t":"JOE:","x":0.086419753258260096,"y":0.3779069766209604,"w":0.032921810150146488},{"t":"SALLY:","y":0.39220268186275753,"w":0.045478382110595697,"x":0.088371919958356956,"h":0.01065277575884882,"c":1},{"y":0.43604651152046814,"w":0.032921810150146488,"h":0.008720930389296444,"c":1,"t":"JOE:","x":0.088477366420125672},{"c":1,"t":"SALLY:","x":0.088395564722659359,"y":0.45036450398772487,"h":0.0091547129151396955,"w":0.04543109258015951},{"h":0.008720930389296444,"t":"JOE:","w":0.030864197413126626,"y":0.47965116268118235,"c":1,"x":0.088477366218480777},{"y":0.49273255794635995,"c":1,"t":"SALLY:","x":0.088477366441282429,"w":0.045267489751180001,"h":0.010174418787512574},{"t":"JOE:","x":0.088477366218480777,"y":0.50872093012304287,"h":0.008720930389296444,"c":1,"w":0.030864197413126626},{"h":0.011627907185728592,"t":"SALLY:","x":0.086419753184912407,"y":0.5363372091687636,"w":0.047325102488199877,"c":1},{"w":0.032921810150146488,"h":0.010174418787512463,"t":"JOE:","y":0.56540697660650796,"x":0.086419753305024022,"c":1},{"w":0.045267489751180029,"h":0.010174418787512463,"y":0.57994186034824957,"c":1,"t":"SALLY:","x":0.090534979301364726},{"t":"JOE:","h":0.010174418787512574,"y":0.60901162776467388,"x":0.088477366262572493,"w":0.030864197413126626,"c":1},{"y":0.62345190960285357,"t":"SALLY:","x":0.090492725171107694,"h":0.010363622604747547,"c":1,"w":0.045351998011271169},{"x":0.088477366262572493,"t":"JOE:","c":1,"y":0.65261627894779373,"w":0.030864197413126626,"h":0.008720930389296444},{"t":"SALLY:","w":0.047325102488199877,"x":0.088477366348492653,"h":0.011627907185728592,"y":0.66715116266092733,"c":1},{"w":0.030864197413126626,"t":"JOE:","h":0.008720930389296444,"x":0.090534979405576602,"y":0.6962209301178518,"c":1},{"w":0.047325102488199877,"y":0.70930232533155435,"t":"SALLY:","x":0.088477366785735451,"h":0.011627907185728592,"c":1},{"c":1,"y":0.7252906975524448,"h":0.008720930389296444,"t":"JOE:","x":0.090534979410720626,"w":0.030864197413126626},{"h":0.010174418787512574,"y":0.73982558128179976,"w":0.047325102488199877,"c":1,"t":"SALLY:","x":0.088477366348492653},{"h":0.011627907185728592,"x":0.088477366848597902,"c":1,"t":"JOE:","y":0.76744186024434502,"w":0.034979422887166337},{"y":0.79784579428191982,"t":"SALLY:","w":0.045358457565307625,"c":1,"h":0.0089595741883042868,"x":0.090489495394094205},{"y":0.83284883698853118,"h":0.011627907185728592,"x":0.088477366677710764,"w":0.047325102488199863,"c":1,"t":"SALLY:"},{"h":0.0072674419910803145,"w":0.032921810150146474,"y":0.86337209293199313,"x":0.090534979610405894,"c":1,"t":"JOE:"},{"x":0.088477366755408959,"y":0.87645348816110069,"h":0.013081395583944722,"c":1,"t":"SALLY:","w":0.049382715225219725},{"x":0.090534979595708664,"t":"JOE.","y":0.89244186037709783,"w":0.032921810150146488,"h":0.0072674419910804255,"c":1},{"t":"Good morning. Thanks for coming in to see us here at the agency, Joe. I'm one","c":1,"y":0.22949791158630062,"x":0.1810137070944314,"w":0.58448125203450518,"h":0.016039360819211201},{"h":0.011778563015312105,"c":1,"t":"of the agency representatives, and my name's Sally Baker.","x":0.17901235506928553,"w":0.43827158610026046,"y":0.24558303883789712},{"c":1,"y":0.25867944991919201,"x":0.18098766104547717,"w":0.37055595397949226,"t":"Hi Sally. I think we spoke on the phone, didn't we?","h":0.015755634285395503},{"y":0.27271271568147415,"w":0.55980779012044279,"t":"That's right, we did. So thank you for sending in your CV. We've had quite a","h":0.015885382293952865,"c":1,"x":0.18099723470642373},{"w":0.5596707661946615,"t":"careful look at it and I think we have two jobs that might be suitable for you.","h":0.013250883392226132,"x":0.17901236086700378,"y":0.28769140175751373,"c":1},{"w":0.030864197413126626,"h":0.011627907185728592,"c":1,"t":"OK.","x":0.17901234562642709,"y":0.30377906961450007},{"x":0.17895031175525816,"w":0.55981033325195306,"h":0.016101034004921244,"c":1,"y":0.31661615990327041,"t":"The first one is in a company based in North London. They're looking for an"},{"y":0.3320963560190533,"w":0.18343574523925782,"x":0.17680632643387117,"h":0.01392100303838617,"c":1,"t":"administrative assistant."},{"w":0.23662551879882815,"t":"OK. What sort of company is it?","x":0.18106995654708802,"h":0.011627907185728592,"c":1,"y":0.34738372082059532},{"c":1,"t":"They're called Home Solutions and they design and make furniture.","x":0.17893998189824192,"w":0.50218678792317717,"h":0.015915077622843832,"y":0.36013659296490008},{"x":0.18100704404518742,"t":"Oh, I don't know much about that, but it sounds interesting.","y":0.37488891727471829,"w":0.43632456461588542,"h":0.014097102539278206,"c":1},{"h":0.013081395583944722,"c":1,"x":0.18106995577152712,"y":0.38953488359726374,"w":0.57613169352213545,"t":"Yes, well as I said, they want someone in their office, and looking at your past"},{"h":0.015365229338161646,"x":0.18097799399746037,"w":0.58249018351236981,"t":"experience it does look as if you fit quite a few of the requirements. So on your","c":1,"y":0.4030222280127389},{"t":"CV it appears you've done some data entry?","x":0.18106996728400077,"w":0.33127571105957027,"h":0.013081394460653373,"y":0.41860465144336523,"c":1},{"t":"So that's one skill they want. Then they expect the person they appoint to attend","x":0.17895419582037353,"h":0.017174702791499352,"w":0.59682973225911462,"c":1,"y":0.44619015017911134},{"y":0.46240429709830666,"w":0.24713025410970052,"x":0.18097810774209488,"h":0.012990097836695469,"c":1,"t":"meetings and take notes there ..."},{"t":"OK. I've done that before, yes.","x":0.18092037685141341,"w":0.22871271769205728,"c":1,"y":0.47676256852383314,"h":0.013439566002296455},{"t":"And you'd need to be able to cope with general admin.","x":0.18099449396515241,"y":0.49044517941879318,"h":0.014088613826900076,"c":1,"w":0.40547203063964843},{"t":"Filing, and keeping records and so on? That should be OK. And in my last job I","x":0.18100708581590311,"w":0.58450642903645833,"y":0.50401772742363538,"h":0.015309161937700155,"c":1},{"y":0.521790341651167,"x":0.18106995481020591,"h":0.010306242638398078,"w":0.22016461690266928,"t":"also had to manage the diary.","c":1},{"h":0.015744021699903077,"c":1,"t":"Excellent. That's something they want here too. I'd suggest you add it to your","x":0.18306857570610996,"y":0.5332337061511383,"w":0.57213923136393219},{"w":0.34773661295572922,"y":0.54941860452969249,"x":0.18106996502542519,"c":1,"h":0.013081395583944722,"t":"CV - I don't think you mentioned that, did you?"},{"x":0.18312756647793596,"y":0.57703488357485233,"h":0.014543444023536689,"t":"So as far as the requirements go, they want good computer skills, of course, and","c":1,"w":0.59465021769205728},{"h":0.011627907185728592,"x":0.18106995621735719,"t":"they particularly mention spreadsheets.","w":0.29423868815104159,"c":1,"y":0.59302325570477266},{"t":"That should be fine.","x":0.1829158057045962,"c":1,"w":0.14859659830729166,"h":0.012995604210663814,"y":0.60627592534301533},{"h":0.014534883982160851,"c":1,"y":0.62063953474078792,"w":0.5617284138997396,"t":"And interpersonal skills - which would be something they'd check with your","x":0.17901233644658693},{"w":0.088833166758219423,"y":0.6369019655008783,"x":0.18095044263653723,"c":1,"h":0.010852463253816613,"t":"references."},{"x":0.17901234885153655,"w":0.22839505513509117,"y":0.64958775027350313,"c":1,"t":"I think that should be OK, yes.","h":0.014723203769140158},{"t":"Then they mention that they want someone who is careful and takes care with","h":0.016864714830306493,"w":0.582477773030599,"x":0.17892967927677678,"c":1,"y":0.66363800907237691},{"t":"details - just looking at your CV, I'd say you're probably alright there.","y":0.67873969373806309,"w":0.51440327962239585,"c":1,"x":0.17901235314147698,"h":0.014574259835502756},{"w":0.39726122538248698,"x":0.1810027970450806,"y":0.69327432799320143,"h":0.014137551697460338,"t":"I think so, yes. Do they want any special experience?","c":1},{"x":0.18106995764972481,"y":0.70784883707251134,"h":0.013081395583944611,"c":1,"w":0.4259259287516276,"t":"I think they wanted some experience of teleconferencing."},{"c":1,"x":0.18106995262250233,"y":0.72379269709082483,"h":0.011778563015312105,"t":"I've got three years' experience of that.","w":0.29012346903483077},{"w":0.57424580891927091,"c":1,"y":0.73597242778162764,"h":0.017343253213188192,"t":"Let's see, yes, good. In fact they're only asking for at least one year, so that's","x":0.18098211534817002},{"t":"great. So is that something that might interest you?","x":0.18302782233764836,"y":0.75140895890980974,"w":0.37880040486653643,"c":1,"h":0.014632859696207423},{"c":1,"w":0.57423390706380217,"t":"It is, yes. The only thing is, you said they were in North London so it would be","x":0.18306561959477666,"y":0.76499903758828047,"h":0.016364550281610102},{"x":0.18312756797253371,"y":0.78197674407380235,"w":0.22016461690266925,"h":0.011627907185728592,"c":1,"t":"quite a long commute for me."},{"h":0.013081395583944722,"t":"OK.","x":0.18106995892718156,"y":0.79505813928651603,"w":0.030864197413126626,"c":1},{"w":0.58045516967773436,"c":1,"t":"So the second position might suit you better as far as the location goes; that's","y":0.8298568338463358,"x":0.18303725163652151,"h":0.017366860864861722},{"x":0.18099356566527716,"y":0.844623716301523,"w":0.40551211039225266,"h":0.014426526809890095,"c":1,"t":"for a warehouse assistant and that's in South London."},{"x":0.18093522096250539,"y":0.86038232987661278,"t":"Yes, that would be a lot closer.","h":0.014520517086392903,"w":0.22866696675618489,"c":1},{"x":0.1790123407742511,"c":1,"y":0.87499999987238364,"w":0.42181070963541667,"t":"And you've worked in a warehouse before, haven't you?","h":0.013103651354534729},{"c":1,"t":"Yes.","x":0.17901234630979479,"y":0.88953488349436494,"w":0.039094648361206047,"h":0.013081395583944722},{"y":0.3590116277299622,"h":0.013081395583944611,"t":"Q1","x":0.8189300412647762,"c":1,"w":0.024691357612609877},{"t":"Q2","c":1,"x":0.81893004067654707,"y":0.46075581377647379,"w":0.026748971939086874,"h":0.013081395583944611},{"h":0.013081395583944722,"t":"Q3","x":0.81893004068512043,"y":0.51889534866514975,"w":0.026748971939086985,"c":1},{"x":0.82098765396872819,"w":0.026748971939086874,"y":0.67732558114698105,"h":0.013081395583944722,"t":"Q4","c":1},{"w":0.026748971939086874,"t":"Q5","h":0.013081395583944611,"x":0.82098765396872819,"y":0.73546511603070208,"c":1},{"t":"107","c":1,"x":0.83744856027432657,"h":0.013081395583944611,"y":0.92151162774854367,"w":0.037037035624186254}],"w":2400,"h":3395}