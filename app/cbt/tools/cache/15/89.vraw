{"lines":[{"y":0.14807751137538283,"t":"Audioscripts","h":0.032333349311028825,"x":0.12925635008891467,"c":1,"w":0.24148729960123699},{"y":0.20784883706217017,"h":0.01453488398216074,"t":"TEST 1","x":0.42798353801296135,"w":0.09670782089233404,"c":1},{"h":0.015093971899457159,"t":"PART 1","y":0.26570882798254458,"c":1,"w":0.094819107055664043,"x":0.13160279207500339},{"w":0.049382715225219725,"c":1,"y":0.29505813942744474,"t":"AMBER:","x":0.13168724316928315,"h":0.0087209303892965551},{"y":0.32388938608273166,"x":0.13161677856164677,"h":0.0091979719865167286,"c":1,"t":"WILLIAM:","w":0.057754096984863279},{"c":1,"h":0.0088386586192640282,"w":0.051480073928832998,"t":"AMBER:","x":0.13166737036187506,"y":0.35313881020211602},{"x":0.13168724238150639,"w":0.057613169352213556,"h":0.008720930389296444,"y":0.36773255804559268,"t":"WILLIAM:","c":1},{"t":"AMBER:","x":0.13160465989561787,"h":0.0092205973199455116,"w":0.051605494817097974,"y":0.38201760829881559,"c":1},{"w":0.057784207661946613,"t":"WILLIAM.","x":0.13160172323078814,"c":1,"y":0.39651109620862246,"h":0.0093033889438014494},{"y":0.41129250052715549,"h":0.0088103477469040348,"w":0.051470562616984072,"c":1,"t":"AMBER.","x":0.1316721260002584},{"t":"WILLIAM.","h":0.0095068344098238056,"x":0.13157318929153883,"c":1,"w":0.057841275533040359,"y":0.42547914091764649},{"h":0.01052065311247663,"c":1,"t":"AMBER:","x":0.13162230638617511,"y":0.48238502223869051,"w":0.053627815246582028},{"c":1,"w":0.057789986928304032,"x":0.13365644754780903,"h":0.0093237559000650672,"t":"WILLIAM:","y":0.49679161026953977},{"y":0.54061817646866217,"h":0.0088799260951604175,"w":0.049438505172729491,"t":"AMBER:","c":1,"x":0.13577457447560012},{"x":0.13374485735554009,"w":0.059670778910318995,"c":1,"h":0.010174418787512574,"y":0.55523255803056215,"t":"WILLIAM:"},{"h":0.010174418787512574,"w":0.051440327962239574,"t":"AMBER:","y":0.62645348819587543,"c":1,"x":0.13580246995235071},{"h":0.011627907185728592,"t":"WILLIAM:","x":0.13374485780821496,"y":0.65552325559318225,"w":0.059670778910319022,"c":1},{"t":"AMBER:","c":1,"y":0.6991279067581333,"x":0.13580247014953864,"w":0.051440327962239601,"h":0.010174418787512463},{"h":0.0089524839735986017,"y":0.72808189752228902,"x":0.13576779318758758,"w":0.057682520548502592,"t":"WILLIAM:","c":1},{"x":0.13540693711224577,"w":0.054150460561116526,"t":"AMBER:","y":0.7428145246698139,"h":0.010960146451305275,"c":1},{"x":0.13580247052059008,"w":0.059670778910318995,"y":0.77761627896016816,"h":0.010174418787512463,"t":"WILLIAM:","c":1},{"w":0.051440327962239601,"c":1,"x":0.13786008282957979,"t":"AMBER:","y":0.79215116269336983,"h":0.008720930389296444},{"t":"WILLIAM:","x":0.13782950073138681,"y":0.80658408442206486,"w":0.057674331665039075,"c":1,"h":0.0089248543774140821},{"x":0.1378600828338665,"w":0.051440327962239574,"c":1,"t":"AMBER:","y":0.83575581385695064,"h":0.008720930389296444},{"t":"WILLIAM:","w":0.057613169352213556,"c":1,"y":0.86482558130082976,"x":0.13786008189148963,"h":0.008720930389296444},{"c":1,"t":"AMBER.","w":0.051440327962239574,"x":0.1378600828338665,"y":0.87936046503583098,"h":0.0072674419910803145},{"h":0.0099940766153683303,"x":0.13973470393884899,"w":0.057854919433593777,"y":0.89297630504921721,"c":1,"t":"WILLIAM:"},{"w":0.026748971939086902,"c":1,"y":0.92441860447414803,"t":"96","x":0.13786008182881046,"h":0.013081395583944722},{"t":"Hello William. This is Amber - you said to phone if I wanted to get more","x":0.22203105913945648,"w":0.53331334431966138,"c":1,"y":0.28834326396538978,"h":0.019758781639791057},{"t":"information about the job agency you mentioned. Is now a good time?","c":1,"h":0.01677745419200094,"w":0.52089797973632812,"x":0.22208215019814323,"y":0.30338069065117157},{"y":0.31691564165107466,"w":0.59704950968424475,"c":1,"t":"Oh, hi Amber. Yes. Fine. So the agency I was talking about is called Bankside -","h":0.019675118903529687,"x":0.22000164485960133},{"h":0.017065798576364033,"y":0.33221933735540188,"w":0.57018386840820312,"x":0.22004244754961519,"c":1,"t":"they're based in Docklands - I can tell you the address now - 497 Eastside."},{"y":0.3461681846910476,"h":0.019122318047657183,"t":"OK, thanks. So is there anyone in particular I should speak to there?","c":1,"x":0.22201833668607132,"w":0.5127664184570313},{"h":0.015759559626854491,"w":0.40967844645182294,"x":0.22416095104104841,"c":1,"y":0.36244750541406212,"t":"The agent I always deal with is called Becky Jamieson."},{"x":0.22222222069339684,"y":0.37926972890490385,"h":0.011778563015312216,"w":0.25925926208496097,"c":1,"t":"Let me write that down - Becky ..."},{"h":0.015081163008727083,"w":0.21019028981526697,"t":"Jamieson J-A-M-I-E-S-O-N.","c":1,"y":0.39203622654695369,"x":0.22201908907974535},{"t":"Do you have her direct line?","h":0.013693382096936491,"x":0.22415650260348524,"c":1,"y":0.40666178458713942,"w":0.21223008473714194},{"t":"Yes, it's in my contacts somewhere - right, here we are: 078 double 6, 510 triple","x":0.2241117189242228,"y":0.4180452177311148,"c":1,"w":0.597039540608724,"h":0.018289294765189368},{"c":1,"h":0.017298541164510461,"y":0.43267261030136706,"x":0.22415649232651599,"t":"3. I wouldn't call her until the afternoon if I were you - she's always really busy in","w":0.60107447306315098},{"t":"the morning trying to fill last-minute vacancies. She's really helpful and friendly so","w":0.60729522705078121,"h":0.018622002977926044,"c":1,"y":0.44719218452256859,"x":0.22208286644089659},{"t":"I'm sure it would be worth getting in touch with her for an informal chat.","c":1,"y":0.46187864467484463,"w":0.52704228719075519,"x":0.22414996459118469,"h":0.017072554050261424},{"t":"It's mainly clerical and admin jobs they deal with, isn't it?","w":0.42000762939453129,"y":0.47792132063498027,"h":0.016633053971684908,"x":0.2241675189947111,"c":1},{"w":0.59500579833984379,"x":0.22410259495686471,"h":0.01987996230557898,"t":"That's right. I know you're hoping to find a full-time job in the media eventually -","c":1,"y":0.49009342785787213},{"x":0.2261374457512727,"h":0.01859148146828149,"w":0.59298665364583336,"c":1,"y":0.50436102300608043,"t":"but Becky mostly recruits temporary staff for the finance sector - which will look"},{"t":"good on your CV - and generally pays better too.","y":0.5198108868662229,"w":0.36863070170084633,"h":0.017114177609500958,"x":0.22612107006158136,"c":1},{"y":0.53411787935919697,"w":0.54959030151367183,"c":1,"t":"Yeah - I'm just a bit worried because I don't have much office experience.","h":0.015921590465819757,"x":0.22620468070957619},{"c":1,"t":"I wouldn't worry. They'll probably start you as a receptionist, or something like","w":0.57637186686197917,"x":0.22622288287387979,"y":0.54926446277981833,"h":0.015798252519084066},{"x":0.22417188941562302,"c":1,"t":"that. So what's important for that kind of job isn't so much having business skills","y":0.56334579489166292,"w":0.59691126505533854,"h":0.017203812885621339},{"c":1,"x":0.22616935325095786,"t":"or knowing lots of different computer systems - it's communication that really","y":0.57703557385186488,"w":0.57439743041992186,"h":0.018173445239926367},{"x":0.22620047450636718,"w":0.58668991088867195,"h":0.016774693141977659,"c":1,"t":"matters - so you'd be fine there. And you'll pick up office skills really quickly on","y":0.59175668158727013},{"h":0.016584770418308636,"t":"the job. It's not that complicated.","y":0.60744582007957482,"w":0.24722778320312502,"x":0.22410279319084594,"c":1},{"x":0.22619494158243222,"w":0.59905578613281252,"c":1,"y":0.62130379396824265,"h":0.018005350874506498,"t":"OK good. So how long do people generally need temporary staff for? It would be"},{"c":1,"t":"great if I could get something lasting at least a month.","y":0.63557668539647694,"x":0.22608951463795865,"w":0.40161234537760415,"h":0.017153655682351499},{"h":0.020298356863859834,"c":1,"t":"That shouldn't be too difficult. But you're more likely to be offered something for","y":0.64848758267728823,"w":0.5929764302571614,"x":0.22613718661357307},{"w":0.59910334269205734,"c":1,"y":0.66369587630433091,"t":"a week at first, which might get extended. It's unusual to be sent somewhere for","h":0.018744144057778245,"x":0.22411226551938948},{"x":0.22633744774522066,"t":"just a day or two.","y":0.68459302315590453,"w":0.12962963104248046,"h":0.010174418787512574,"c":1},{"w":0.5475504048665365,"c":1,"t":"Right. I've heard the pay isn't too bad - better than working in a shop or a","h":0.016175018463314483,"y":0.69404080852148387,"x":0.22828335667560129},{"x":0.22631154523551195,"y":0.71210099885459899,"t":"restaurant.","w":0.084413948059082033,"h":0.010391025296088818,"c":1},{"y":0.72309672648774437,"w":0.49401814778645825,"h":0.016904571452326045,"t":"Oh yes - definitely. The hourly rate is about £10, 11 if you're lucky.","x":0.22624596384457182,"c":1},{"w":0.5681126403808594,"y":0.73634063219897861,"t":"That's pretty good. I was only expecting to get eight or nine pounds an hour.","x":0.2282808336016931,"h":0.017356107035570667,"c":1},{"y":0.77172131547945333,"t":"Do you want me to tell you anything about the registration process?","c":1,"w":0.50238052368164066,"h":0.016710425153357078,"x":0.23030715250260925},{"t":"Yes, please. I know you have to have an interview.","w":0.37886271158854168,"h":0.015986898060541321,"c":1,"x":0.2282568101729657,"y":0.78663571134822352},{"t":"The interview usually takes about an hour and you should arrange that about a","h":0.016000081568921298,"w":0.58664713541666669,"c":1,"x":0.23033263560822206,"y":0.80032727388816904},{"t":"week in advance.","y":0.81737025218460668,"h":0.012668483810514664,"w":0.13211865743001303,"c":1,"x":0.23028124873626485},{"w":0.58670578002929685,"c":1,"y":0.82755751611104511,"t":"I suppose I should dress smartly if it's for office work - I can probably borrow a","x":0.22826354067141505,"h":0.019117020605871282},{"y":0.84738372080698554,"h":0.011627907185728592,"c":1,"w":0.11316872914632159,"x":0.23045267234108319,"t":"suit from Mum."},{"x":0.23032692525569112,"c":1,"y":0.85898242099580369,"h":0.015171817110059327,"t":"Good idea. It's better to look too smart than too casual.","w":0.40970387776692707},{"x":0.22822429672116015,"h":0.018733697448658493,"y":0.87198982995260244,"t":"Will I need to bring copies of my exam certificates or anything like that?","w":0.533305918375651,"c":1},{"t":"No - they don't need to see those, I don't think.","x":0.22825875372377114,"y":0.88799237577040158,"w":0.35420107523600264,"h":0.017696280642308437,"c":1},{"y":0.38808139562941169,"c":1,"x":0.86419753112167863,"w":0.024691357612609877,"t":"Q1","h":0.013081394460653373},{"x":0.8662551441454347,"y":0.43313953472637456,"w":0.024691357612609877,"h":0.011627907185728592,"c":1,"t":"Q2"},{"t":"Q3","h":0.013081395583944722,"y":0.57703488354391552,"x":0.86831275672592978,"w":0.026748971939086874,"c":1},{"w":0.026748971939086985,"t":"Q4","h":0.013081395583944611,"x":0.86831275689053877,"y":0.66279069742605101,"c":1},{"x":0.87037037001811091,"y":0.72093023230977193,"h":0.013081395583944722,"w":0.026748971939086874,"c":1,"t":"Q5"},{"w":0.024691357612609877,"x":0.87242798364225471,"y":0.84302325566101166,"t":"Q6","h":0.011627907185728592,"c":1}],"w":2400,"h":3395}