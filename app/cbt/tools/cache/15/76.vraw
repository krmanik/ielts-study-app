{"h":3395,"w":2400,"lines":[{"c":1,"x":0.7921321213725061,"t":"Reading","w":0.080344810485839857,"y":0.10018645210551891,"h":0.019103839905719733},{"c":1,"w":0.15432098388671872,"h":0.013250883392226132,"t":"Questions 9-13","x":0.090534981203398507,"y":0.1481154299348344},{"y":0.1802120141025978,"c":1,"x":0.088477371308757047,"t":"Do the following statements agree with the information given in Reading Passage 1?","h":0.017462404653237007,"w":0.74485595703125007},{"y":0.21511627890810203,"h":0.017510340547954861,"t":"in boxes 9-13 on your answer sheet, write","w":0.37654319763183591,"c":1,"x":0.086419759103567764},{"t":"TRUE","x":0.15620829642503187,"w":0.057953777313232424,"c":1,"y":0.24816204032565392,"h":0.01385033790579393},{"c":1,"x":0.15637859989600164,"y":0.26453488358227739,"w":0.067901236216227207,"t":"FALSE","h":0.013081395583944833},{"y":0.24705535914280974,"c":1,"t":"if the statement agrees with the information","h":0.016026036337772664,"w":0.38477366129557294,"x":0.28189300479076157},{"y":0.26295641929985014,"h":0.016195524146054074,"t":"if the statement contradicts the information","c":1,"w":0.38065841674804685,"x":0.28189301773194347},{"x":0.15637860852023985,"w":0.40534978230794272,"h":0.016002068109590928,"c":1,"y":0.28052325553704027,"t":"NOT GIVEN if there is no information on this"},{"h":0.017441860778592999,"w":0.77366256713867188,"y":0.32267441844554301,"t":"9 Local families have told Whaley about some traditional uses of huarango products.","x":0.088477358300855444,"c":1},{"t":"10 Farmer Alberto Benevides is now making a good profit from growing huarangos.","h":0.016003780005537038,"c":1,"w":0.75102879842122394,"y":0.34883720915577321,"x":0.088477370218659437},{"h":0.016048292108362783,"y":0.37499999985400601,"c":1,"w":0.73045267740885422,"t":"11 Whaley needs the co-operation of farmers to help preserve the area's wildlife.","x":0.088477364894010299},{"x":0.088477378358000652,"y":0.40106007061610383,"w":0.75308639526367194,"h":0.016195524146054296,"t":"12 For Whaley's project to succeed, it needs to be extended over a very large area.","c":1},{"y":0.42726737341668231,"x":0.088477364896016292,"h":0.016046580212416783,"c":1,"t":"13 Whaley has plans to go to Africa to set up a similar project.","w":0.56378601074218748},{"w":0.087665971120198583,"h":0.016857771766761509,"c":1,"y":0.92183521029756665,"t":"• p. 126","x":0.72571628156416446},{"h":0.013081395583944611,"y":0.92296511610205512,"t":"83","w":0.026748971939086874,"c":1,"x":0.84773662503868707}]}