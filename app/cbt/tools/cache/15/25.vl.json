{"blocks":[{"l":"header","b":[0.1333,0.0692,0.1946,0.086],"t":"Test 2"},{"l":"paragraph_title","b":[0.1313,0.1125,0.4746,0.1317],"t":"PART 2 Questions 11–20"},{"l":"text","b":[0.1329,0.1473,0.3033,0.1649],"t":"Questions 11–14"},{"l":"text","b":[0.1325,0.1809,0.4537,0.1982],"t":"Choose the correct letter, A, B or C."},{"l":"paragraph_title","b":[0.4404,0.2159,0.6112,0.2371],"t":"Minster Park"},{"l":"text","b":[0.1333,0.2462,0.4938,0.2636],"t":"11 The park was originally established"},{"l":"text","b":[0.175,0.2722,0.5996,0.289],"t":"A as an amenity provided by the city council."},{"l":"text","b":[0.1767,0.2895,0.5517,0.3054],"t":"B as land belonging to a private house."},{"l":"text","b":[0.1762,0.3063,0.6462,0.3231],"t":"C as a shared area set up by the local community."},{"l":"text","b":[0.1333,0.3308,0.6421,0.3487],"t":"12 Why is there a statue of Diane Gosforth in the park?"},{"l":"text","b":[0.175,0.3573,0.6821,0.3735],"t":"A She was a resident who helped to lead a campaign."},{"l":"text","b":[0.1762,0.3744,0.8208,0.3906],"t":"B She was a council member responsible for giving the public access."},{"l":"text","b":[0.1767,0.3918,0.6871,0.408],"t":"C She was a senior worker at the park for many years."},{"l":"text","b":[0.1346,0.4162,0.6829,0.4342],"t":"13 During the First World War, the park was mainly used for"},{"l":"text","b":[0.1762,0.4433,0.4033,0.4595],"t":"A exercises by troops."},{"l":"text","b":[0.1771,0.4604,0.4037,0.4763],"t":"B growing vegetables."},{"l":"text","b":[0.1779,0.4775,0.3704,0.4934],"t":"C public meetings."},{"l":"text","b":[0.1338,0.501,0.6763,0.5193],"t":"14 When did the physical transformation of the park begin?"},{"l":"text","b":[0.1783,0.5284,0.2729,0.5434],"t":"A 2013"},{"l":"text","b":[0.1787,0.5449,0.2729,0.5605],"t":"B 2015"},{"l":"text","b":[0.1792,0.562,0.2733,0.5779],"t":"C 2016"},{"l":"number","b":[0.1375,0.8895,0.165,0.904],"t":"32"}]}