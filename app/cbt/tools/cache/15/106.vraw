7942288716635,"y":0.45784883695946132},{"h":0.008720930389296444,"x":0.094650204912764935,"c":1,"t":"SOPHIE:","w":0.053497943878173831,"y":0.47383720920718542},{"w":0.037037035624186199,"t":"MAN:","x":0.09259259350477933,"h":0.011627907185728703,"y":0.48691860440132173,"c":1},{"x":0.094650204912764935,"t":"SOPHIE:","y":0.50290697664904582,"w":0.053497943878173831,"h":0.008720930389296444,"c":1},{"h":0.011627907185728592,"c":1,"x":0.09259259350477933,"y":0.51598837184318225,"t":"MAN:","w":0.037037035624186199},{"y":0.53182962101303821,"c":1,"h":0.009015176546166459,"x":0.094602912203232442,"t":"SOPHIE:","w":0.053592529296874997},{"t":"MAN:","w":0.037037035624186199,"x":0.09259259350477933,"y":0.54505813928504265,"c":1,"h":0.011627907185728592},{"x":0.092521764162107806,"w":0.055697212219238262,"h":0.011970251552909872,"t":"SOPHIE:","y":0.57395673466569042,"c":1},{"c":1,"x":0.092592593422474792,"w":0.037037035624186213,"t":"MAN:","y":0.60319767419783332,"h":0.011627907185728592},{"h":0.010765533986445419,"w":0.053717136383056655,"y":0.6319718841481281,"c":1,"x":0.094540608664902423,"t":"SOPHIE:"},{"h":0.008720930389296444,"c":1,"x":0.094650206149009417,"y":0.6482558138494694,"t":"MAN:","w":0.034979422887166337},{"h":0.010359142919030395,"c":1,"t":"SOPHIE:","x":0.094616592877200881,"y":0.66124484712512965,"w":0.055622781117757161},{"t":"MAN:","w":0.034979422887166337,"x":0.094650206483371566,"h":0.0087209298276508251,"c":1,"y":0.67587209311669794},{"c":1,"w":0.053546244303385421,"h":0.010301908980550389,"x":0.094626054695792355,"y":0.70487811525479249,"t":"SOPHIE:"},{"c":1,"w":0.037037035624186185,"h":0.008720930389296444,"y":0.73401162780135476,"t":"MAN:","x":0.094650206364861642},{"x":0.094592218335661823,"t":"SOPHIE:","h":0.010483057675850227,"c":1,"y":0.74839219207051733,"w":0.053613917032877614},{"t":"MAN:","w":0.034979422887166337,"h":0.008720930389296444,"c":1,"x":0.096707819317733715,"y":0.7630813952413984},{"t":"SOPHIE:","x":0.0946143562953633,"c":1,"w":0.053569641113281247,"h":0.010364182003816502,"y":0.77752139734862313},{"w":0.039094648361206047,"h":0.011627907185728592,"t":"MAN:","x":0.092592593634897663,"y":0.81976744165907389,"c":1},{"t":"SOPHIE:","x":0.096628778928084427,"h":0.0091985774405292098,"w":0.051598409016927096,"y":0.83551699033110571,"c":1},{"w":0.037340885798136395,"x":0.094498281278907678,"t":"MAN:","y":0.87175963562518843,"h":0.0093877054356011902,"c":1},{"w":0.59670781453450517,"y":0.22526501741714333,"h":0.014560564106288476,"x":0.18106996094298231,"t":"Hello. Do you mind if I ask you some questions about your journey today? We're","c":1},{"w":0.27366254170735677,"h":0.011778563015312105,"c":1,"y":0.24116607778632393,"x":0.18312757678006647,"t":"doing a customer satisfaction survey."},{"y":0.25436046498302112,"h":0.014534883982160851,"c":1,"x":0.18312755966700234,"w":0.58024693806966143,"t":"Yes. OK. I've got about ten minutes before my train home leaves. I'm on a day"},{"c":1,"t":"trip.","x":0.18106995893955866,"w":0.032921810150146474,"h":0.011627907185728592,"y":0.27034883704021062},{"x":0.18306092955612338,"c":1,"y":0.28192967240240185,"w":0.46106547037760404,"h":0.017273480535536345,"t":"Great. Thank you. So first of all, could you tell me your name?"},{"h":0.013081395583944611,"c":1,"t":"It's Sophie Bird.","x":0.18106995717700017,"y":0.29796511614893784,"w":0.12139918009440101},{"x":0.18305487883553903,"y":0.31100984467165682,"h":0.017045281660711287,"c":1,"t":"Thank you. And would you mind telling me what you do?","w":0.41992632548014319},{"t":"I'm a journalist.","x":0.18106995990472,"y":0.32703488358946009,"w":0.11728394826253255,"h":0.013081395583944722,"c":1},{"c":1,"h":0.013081395583944611,"y":0.34156976731871636,"t":"Oh really? That must be interesting.","x":0.18106995999193018,"w":0.26954732259114578},{"c":1,"t":"Yes. It is.","x":0.18309034913595534,"y":0.35599521437828374,"w":0.067975680033365904,"h":0.01184678049615473},{"w":0.36641998291015632,"t":"So was the reason for your visit here today work?","h":0.014408670971334692,"c":1,"x":0.18511388714387114,"y":0.36915248873585482},{"c":1,"x":0.18312757410827715,"w":0.43004114786783854,"h":0.01455029160732102,"t":"Actually, it's my day off. I came here to do some shopping.","y":0.38515901084526005},{"c":1,"t":"Oh right.","w":0.068008467356363927,"x":0.18307395551574066,"y":0.39956903680163625,"h":0.013361926354002795},{"t":"But I do sometimes come here for work.","x":0.18518519073297823,"w":0.29629628499348959,"h":0.010174418787512574,"y":0.41424418595147294,"c":1},{"w":0.57419443766276035,"t":"OK. Now I'd like to ask some questions about your journey today, if that's OK.","x":0.18306657638284152,"h":0.016240724826448893,"y":0.42706699205565024,"c":1},{"y":0.4416961247271467,"h":0.015788031691516324,"c":1,"t":"Yes. No problem.","x":0.18273984836544305,"w":0.13243293762207031},{"x":0.18304849453736438,"y":0.45600408026709216,"c":1,"t":"Right, so can you tell me which station you're travelling back to?","w":0.47754175821940104,"h":0.016092015099048118},{"x":0.18312757276447661,"c":1,"w":0.17489711761474608,"y":0.4723203767223163,"t":"Staunfirth, where I live.","h":0.013250883392226243},{"y":0.48546511614019594,"h":0.014534883982160851,"x":0.1831275762702117,"w":0.38888888041178382,"c":1,"t":"Can I just check the spelling? S-T-A-U-N-F-I-R-T-H?"},{"t":"That's right.","x":0.18285646321235252,"y":0.50043328099940543,"w":0.091063677469889331,"h":0.0140216151171213,"c":1},{"y":0.51352440468247884,"h":0.014330146169493907,"t":"And you travelled from there this morning?","c":1,"x":0.18508083047672216,"w":0.31708867390950513},{"x":0.18312757239366823,"h":0.013081395583944722,"c":1,"t":"Yes.","y":0.52906976719349275,"w":0.037037035624186199},{"y":0.54358068337629617,"h":0.013250883392226132,"w":0.57613169352213545,"c":1,"t":"OK, good. Next, can I ask what kind of ticket you bought? I assume it wasn't a","x":0.18518518194112307},{"h":0.014723203769140158,"w":0.32716049194335939,"x":0.18312757287104262,"y":0.55800942279205901,"t":"season ticket, as you don't travel every day.","c":1},{"c":1,"w":0.60082305908203126,"h":0.013081395583944722,"t":"That's right. No, I just got a normal return ticket. I don't have a rail card so I didn't","y":0.57267441848484202,"x":0.1851851781750338},{"y":0.58716136630803506,"x":0.18518517322125747,"w":0.52263376871744793,"h":0.013250883392226132,"c":1,"t":"get any discount. I keep meaning to get one because it's a lot cheaper."},{"t":"Yes - you'd have saved 20% on your ticket today. So you paid the full price for","x":0.18514218306941435,"w":0.58240717569986977,"y":0.6000292470852201,"c":1,"h":0.014960430536169134},{"t":"your ticket?","x":0.182243391837904,"w":0.092189451853434246,"h":0.016954963423478464,"y":0.61432481898488467,"c":1},{"x":0.18312757177947528,"t":"I paid £23.70.","h":0.013250883392226243,"w":0.10493827184041341,"y":0.63074204923305344,"c":1},{"y":0.64534883707436119,"c":1,"t":"OK. Do you think that's good value for money?","w":0.34773661295572916,"x":0.18518519136225392,"h":0.0145451559194828},{"c":1,"h":0.016079972292986522,"y":0.65691133266659218,"t":"Not really. I think it's too much for a journey that only takes 45 minutes.","x":0.18716993747533497,"w":0.52691350301106776},{"h":0.015728688773614552,"t":"Yes, that's one of the main complaints we get. So, you didn't buy your ticket in","c":1,"x":0.18719380702093077,"w":0.57418518066406243,"y":0.67280943314825736},{"c":1,"t":"advance?","y":0.68852339280022357,"w":0.076352647145589175,"h":0.011034609431793685,"x":0.18507470623202063},{"t":"No. I know it's cheaper if you buy a week in advance but I didn't know I was","x":0.18514421678900675,"y":0.70191911562668363,"w":0.55976420084635414,"h":0.013897767757779733,"c":1},{"t":"coming then.","w":0.096760152180989573,"c":1,"x":0.18721663210654291,"h":0.011847093894428284,"y":0.71791366216216912},{"x":0.18513479273697564,"h":0.015442483135892915,"w":0.51247660319010413,"t":"I know. You can't always plan ahead. So, did you buy it this morning?","c":1,"y":0.73108092146416503},{"w":0.1568484878540039,"c":1,"y":0.74661659525773483,"x":0.1869780059294554,"h":0.013699973008657884,"t":"No, it was yesterday."},{"w":0.41991439819335935,"x":0.1871761236614346,"t":"Right. And do you usually buy your tickets at the station?","h":0.014110507897690416,"c":1,"y":0.76003300213450053},{"x":0.18717916828771222,"c":1,"t":"Well, I do usually but the ticket office closes early and I hate using ticket","y":0.7742223603396996,"w":0.5330594380696615,"h":0.014025272553604529},{"x":0.18718582283418547,"w":0.59683893839518221,"h":0.015037354647902568,"c":1,"y":0.78883670605394829,"t":"machines. I think ticket offices should be open for longer hours. There's always a"},{"y":0.80350683415431234,"h":0.014544555520281222,"w":0.4013959757486979,"c":1,"t":"queue for the machines and they're often out of order.","x":0.18714516219115818},{"y":0.81821101993512391,"h":0.013936734733087319,"x":0.18714995629524728,"c":1,"t":"A lot of customers are saying the same thing.","w":0.33558474222819007},{"h":0.013250883392226132,"x":0.18724279698941387,"t":"So to answer your question... I got an e-ticket online.","y":0.83274440525728288,"c":1,"w":0.3971193440755208},{"w":0.59271280924479175,"x":0.18923579169000276,"y":0.86844802701108015,"h":0.014800983828846759,"t":"OK. Thank you. Now I'd like to ask you about your satisfaction with your journey.","c":1},{"y":0.88368668994642985,"x":0.18724279856499559,"c":1,"t":"So what would you say you were most satisfied with today?","h":0.013250883392226243,"w":0.4423868306477865},{"w":0.026748971939086874,"t":"Q1","y":0.32412790670078007,"h":0.014534883982160851,"c":1,"x":0.82098765396872819},{"t":"Q2","y":0.3837209300752118,"h":0.011627907185728592,"x":0.82304526760222485,"w":0.024691357612609877,"c":1},{"t":"Q3","x":0.82304526713745252,"h":0.013081395583944611,"y":0.4694767439376788,"w":0.026748971939086874,"c":1},{"w":0.026748971939086985,"y":0.57122093005554353,"x":0.8230452670327012,"c":1,"t":"Q4","h":0.013081395583944722},{"t":"Q5","x":0.82510288077094918,"y":0.62936046493926445,"h":0.013081395583944722,"c":1,"w":0.024691357612609766},{"h":0.013081395583944722,"c":1,"x":0.82510288030617673,"w":0.026748971939086874,"t":"Q6","y":0.83139534858884157},{"x":0.84156378665853915,"h":0.013081395583944722,"w":0.037037035624186254,"y":0.91569767424158999,"t":"113","c":1}],"w":2400}