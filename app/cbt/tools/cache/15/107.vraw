{"lines":[{"h":0.015839838448065025,"c":1,"x":0.12740839974361681,"y":0.096731243550502111,"t":"Audioscripts","w":0.11143834431966146},{"h":0.008720930389296444,"w":0.051440327962239601,"y":0.14244186036778861,"c":1,"x":0.12962963015468265,"t":"SOPHIE:"},{"c":1,"x":0.12757201705839832,"w":0.037037035624186199,"t":"MAN:","y":0.17151162778562123,"h":0.010174418787512574},{"x":0.12962963015896936,"w":0.051440327962239601,"h":0.008720930389296444,"t":"SOPHIE:","y":0.20058139525229945,"c":1},{"t":"MAN:","w":0.03497942288716635,"x":0.12962963000997357,"y":0.21511627896025209,"c":1,"h":0.008720930389296444},{"y":0.22945597201509205,"c":1,"h":0.0091113117474127536,"x":0.12956200489723257,"t":"SOPHIE:","w":0.049517965316772466},{"h":0.0087209303892965551,"c":1,"x":0.12962963001732219,"y":0.25872093012853914,"t":"MAN.","w":0.03497942288716635},{"x":0.12962963048047144,"t":"SOPHIE:","y":0.30087209284703831,"w":0.051440327962239574,"h":0.010174418787512574,"c":1},{"w":0.037037035624186199,"t":"MAN:","x":0.12757201719305097,"h":0.010174418787512574,"y":0.34447674403102568,"c":1},{"h":0.010242450925290192,"x":0.12961618811953599,"c":1,"t":"SOPHIE:","w":0.051467212041219068,"y":0.35897761172533016},{"c":1,"h":0.008720930389296444,"t":"MAN:","x":0.12962963002375225,"w":0.034979422887166323,"y":0.40261627896414531},{"h":0.010174418787512463,"x":0.12962963015896936,"y":0.4171511626780704,"t":"SOPHIE:","w":0.051440327962239601,"c":1},{"x":0.12757201707050195,"t":"MAN:","y":0.43168604639027242,"w":0.037037035624186199,"h":0.010174418787512463,"c":1},{"h":0.0087951675882328439,"t":"SOPHIE:","x":0.12961707026388097,"c":1,"w":0.051465447743733739,"y":0.46071869525684106},{"c":1,"t":"MAN:","w":0.037037035624186199,"y":0.47383720905248461,"x":0.12757201737309207,"h":0.011627907185728592},{"c":1,"y":0.48960417440392812,"t":"SOPHIE:","h":0.0091637441772172146,"w":0.051587165196736645,"x":0.1295562115334693},{"y":0.50290697652341476,"x":0.12757201729078754,"t":"MAN:","c":1,"h":0.011627907185728592,"w":0.037037035624186199},{"t":"SOPHIE:","y":0.51744186020411209,"x":0.12962963090914081,"w":0.051440327962239601,"h":0.010174418787512463,"c":1},{"x":0.12757201729078754,"y":0.53197674396527528,"w":0.037037035624186199,"h":0.011627907185728592,"c":1,"t":"MAN:"},{"w":0.57201644897460935,"t":"Well, I like the wifi on the train. It's improved a lot. It makes it easier for me to","x":0.21810700174537895,"c":1,"h":0.011627907185728703,"y":0.14098837198640135},{"y":0.15412404124631951,"h":0.013132798517269895,"w":0.12599379221598306,"c":1,"t":"work if I want to.","x":0.21792135866948531},{"h":0.013081394460653373,"x":0.21810700345192743,"c":1,"t":"That's the first time today anyone's mentioned that. It's good to get some positive","w":0.60493825276692703,"y":0.16860465138885938},{"h":0.011627907185728592,"x":0.21604938096152401,"y":0.18459302314194437,"t":"feedback on that.","c":1,"w":0.13580247243245444},{"y":0.21217574488113833,"c":1,"t":"And, is there anything you weren't satisfied with?","h":0.014249043414112483,"w":0.36641866048177085,"x":0.21803570595396618},{"h":0.01308824372937456,"x":0.21810700522757134,"t":"Well, normally, the trains run on time and are pretty reliable but today there was a","y":0.22673733777545313,"w":0.60493825276692714,"c":1},{"c":1,"t":"delay; the train was about 15 minutes behind schedule.","x":0.21804404412917364,"w":0.41371625264485679,"h":0.013088698662352294,"y":0.24130139116625704},{"t":"OK. I'll put that down. Now I'd also like to ask about the facilities at this station.","h":0.013081395583944722,"c":1,"x":0.22016461302984813,"y":0.25581395336834079,"w":0.58436213175455731},{"h":0.014326404486163069,"w":0.58240880330403644,"x":0.21804799030084021,"y":0.27032213861962684,"t":"You've probably noticed that the whole station's been upgraded. What are you","c":1},{"c":1,"w":0.15283353169759115,"h":0.014590194284283986,"t":"most satisfied with?","y":0.28471334204640353,"x":0.21578051351142921},{"y":0.29941860453005931,"x":0.21810700132858435,"w":0.57818929036458333,"h":0.011627907185728592,"c":1,"t":"I think the best thing is that they've improved the amount of information about"},{"t":"train times etc. that's given to passengers - it's much clearer - before there was","x":0.2181069898354745,"w":0.59465021769205728,"y":0.31389870422439303,"c":1,"h":0.011778563015312216},{"t":"only one board and I couldn't always see it properly - which was frustrating.","x":0.2181070027180334,"w":0.56584360758463548,"h":0.013089955625320671,"y":0.32848837197213243,"c":1},{"x":0.21604937382257314,"t":"That's good. And is there anything you're not satisfied with?","h":0.01453488398216074,"w":0.44650207519531249,"y":0.3430232556799736,"c":1},{"y":0.35747938772159349,"c":1,"t":"Let's see... I think things have generally improved a lot. The trains are much","w":0.57201644897460935,"x":0.2181070017468891,"h":0.011778563015312105},{"c":1,"h":0.011627907185728592,"y":0.37209302314869097,"t":"more modern and I like the new café. But one thing is that there aren't enough","x":0.21810699172825537,"w":0.58230453491210943},{"h":0.013081395583944611,"t":"places to sit down, especially on the platforms.","c":1,"x":0.21810699753493518,"w":0.34979423522949221,"y":0.38662790685277804},{"c":1,"t":"OK - so I'II put'seating' down, shall I, as the thing you're least satisfied with?","y":0.39949911489408796,"w":0.5700899759928385,"h":0.015555838954462664,"x":0.22010507544305977},{"t":"Can I ask your opinion about some of the other facilities? We'd like feedback on","x":0.22016462024933844,"y":0.43021201415829968,"w":0.59259256998697918,"h":0.011778563015312216,"c":1},{"t":"whether people are satisfied, dissatisfied or neither satisfied nor dissatisfied.","w":0.56995885213216146,"c":1,"x":0.21810699358528532,"h":0.013250883392226132,"y":0.44464075357740507},{"x":0.21604938104333446,"h":0.013250883392226132,"w":0.28806584676106772,"t":"What about the parking at the station?","c":1,"y":0.47379269707727412},{"w":0.48159393310546872,"c":1,"y":0.48688038323204508,"x":0.21806187980583758,"h":0.013833513248654783,"t":"Well to be honest, I don't really have an opinion as I never use it."},{"w":0.36419754028320311,"x":0.2201646042329593,"t":"So, neither satisfied nor dissatisfied for that then.","h":0.011627907185728592,"c":1,"y":0.50290697663614869},{"x":0.21772577108137511,"c":1,"t":"Yes, I suppose so ...","y":0.51314352463409718,"w":0.15491481781005859,"h":0.018223874841337362},{"x":0.21995590932600034,"w":0.18145623524983723,"h":0.013817605197218974,"c":1,"y":0.53012371197236607,"t":"OK, and what about ...?"},{"y":0.57676595865007019,"h":0.015072733830787888,"w":0.094812806447346992,"c":1,"t":"PART 2","x":0.12954832918354897},{"y":0.60306242665544174,"h":0.013250883392226132,"x":0.12962962571327352,"c":1,"t":"As chair of the town council subcommittee on park facilities, I'd like to bring you up to date on","w":0.69135803222656256},{"h":0.013081395583944722,"x":0.12962961976541862,"t":"some of the changes that have been made recently to the Croft Valley Park. So if you could","y":0.61773255801221882,"c":1,"w":0.6769547526041666},{"w":0.66265619913736984,"x":0.12751820200593084,"y":0.63202159530289637,"h":0.014502016478629476,"t":"just take a look at the map I handed out, let's begin with a general overview. So the basic","c":1},{"y":0.64525757572924058,"x":0.12747563678631896,"c":1,"t":"arrangement of the park hasn't changed - it still has two gates, north and south, and a lake in","h":0.02047023615932575,"w":0.69569422403971348},{"w":0.087025648752848295,"t":"the middle.","y":0.66082255421535385,"h":0.014266237634090406,"c":1,"x":0.12726513456591046},{"t":"The café continues to serve an assortment of drinks and snacks and is still in the same place,","y":0.68313953477742306,"h":0.011627907185728703,"x":0.129629642080311,"w":0.69547322591145833,"c":1},{"t":"looking out over the lake and next to the old museum.","x":0.12757201868868379,"h":0.013250883392226243,"y":0.69758539483895177,"w":0.40123456319173173,"c":1},{"w":0.68312759399414058,"y":0.71937573601428928,"x":0.12757200536761179,"c":1,"t":"We're hoping to change the location of the toilets, and bring them nearer to the centre of the","h":0.014723203769140158},{"t":"park as they're a bit out of the way at present, near the adventure playground, in the corner of","x":0.12757201981447441,"y":0.73401162778743501,"h":0.013081395583944611,"c":1,"w":0.69958847045898442},{"h":0.012236489564426023,"c":1,"x":0.12542825825312434,"w":0.080419203440348308,"t":"your map.","y":0.74969570869037438},{"x":0.12962962670138797,"h":0.014723203769140158,"w":0.68518519083658858,"y":0.76884570091352356,"t":"The formal gardens have been replanted and should be at their best in a month or two. They","c":1},{"y":0.78343023242490073,"w":0.65432098388671878,"c":1,"t":"used to be behind the old museum, but we've now used the space near the south gate -","h":0.014567411690072807,"x":0.12962963140572176},{"t":"between the park boundary and the path that goes past the lake towards the old museum.","h":0.013081395583944722,"c":1,"y":0.79941860453134583,"x":0.12757201634556509,"w":0.66666666666666674},{"t":"We have a new outdoor gym for adults and children, which is already proving very popular.","x":0.12757200625844878,"y":0.81976744171307014,"w":0.67695475260416671,"h":0.01598837238037687,"c":1},{"t":"It's by the glass houses, just to the right of the path from the south gate. You have to look for","w":0.68724278767903646,"x":0.12757202182577676,"h":0.01472320376914027,"c":1,"y":0.83421672559328297},{"c":1,"w":0.2390210978190104,"h":0.01480707038277318,"x":0.12740213470906211,"y":0.848761670993053,"t":"it as it's a bit hidden in the trees."},{"c":1,"w":0.032921810150146502,"h":0.013081395583944722,"y":0.91424418588535317,"t":"114","x":0.12962962979461123},{"x":0.86008230405103248,"t":"Q7","h":0.011627907185728592,"c":1,"y":0.24127906961009549,"w":0.026748971939086985},{"t":"Q8","w":0.026748971939086985,"h":0.011627907185728703,"c":1,"x":0.86008230405103248,"y":0.29941860449381641},{"t":"Q9","x":0.86008230463926183,"c":1,"w":0.024691357612609877,"h":0.013081395583944833,"y":0.38517441842763644},{"w":0.034979422887166378,"h":0.013081395583944722,"t":"Q10","x":0.85596707864558008,"y":0.47238372074000434,"c":1},{"t":"Q11","x":0.85433728618321447,"h":0.016233266733841289,"w":0.036181395848592035,"y":0.69537173934064822,"c":1},{"w":0.034979422887166267,"x":0.85390946569119064,"t":"Q12","y":0.73255813981545814,"h":0.013081394460653373,"c":1},{"w":0.037037035624186254,"y":0.78343023239698117,"h":0.013081395583944611,"x":0.85390946563097958,"t":"Q13","c":1},{"w":0.034979422887166267,"h":0.013081395583944611,"c":1,"y":0.83430232542023708,"x":0.85596707857699283,"t":"Q14"}],"h":3395,"w":2400}