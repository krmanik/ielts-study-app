{"h":3395,"w":2400,"lines":[{"y":0.10308735637743627,"c":1,"t":"Audioscripts","h":0.016209008134857594,"w":0.11323078155517577,"x":0.12754098768699693},{"h":0.013081394460653484,"x":0.12962965035783811,"y":0.14534883743537097,"t":"The third main area that saw changes that contributed to consumerism was retailing.","c":1,"w":0.65020573933919268},{"h":0.014416550859826516,"x":0.12958780614354187,"c":1,"t":"The number and quality of shops grew rapidly, and in particular, small shops suffered as","w":0.67498560587565115,"y":0.15972608926475007},{"y":0.17432273252615005,"h":0.013250883392226132,"w":0.67283950805664072,"c":1,"t":"customers flocked to the growing number of department stores - a form of retailing that","x":0.12962962844767428},{"w":0.66049382527669265,"t":"was new in the 19th century. The entrepreneurs who opened these found new ways to","x":0.12962963047922946,"c":1,"h":0.011627907185728592,"y":0.19040697663763217},{"x":0.12752009923983357,"y":0.20335579481985611,"w":0.66266840616861977,"h":0.017346260825652493,"c":1,"t":"stock them with goods, and to attract customers: for instance, improved lighting inside"},{"t":"greatly increased the visibility of the goods for sale. Another development that made","y":0.21937573604064364,"x":0.1296296241928358,"w":0.64609054565429691,"h":0.011778563015312105,"c":1},{"y":0.23255813940998094,"x":0.12962962535546968,"t":"goods more visible from outside resulted from the use of plate glass, which made it","c":1,"h":0.013081395583944611,"w":0.63991770426432293},{"c":1,"y":0.24705535917856125,"t":"possible for windows to be much larger than previously. New ways of promoting goods","h":0.013250883392226132,"w":0.66255142211914064,"x":0.12962963864193086},{"c":1,"t":"were introduced, too. Previously, the focus had been on informing potential customers","w":0.66062596638997395,"y":0.26084934773478785,"x":0.12956773211325326,"h":0.015787926663779595},{"h":0.011627907185728592,"t":"about the availability of goods; now there was an explosion in advertising trying to","x":0.12962962701639044,"c":1,"w":0.62757202148437496,"y":0.27761627896333074},{"x":0.12962962452101739,"t":"persuade people to go shopping.","y":0.29210836303428867,"w":0.25514404296874998,"h":0.011778563015312216,"c":1},{"h":0.013250883392226132,"x":0.129629628585166,"y":0.31242638386158184,"t":"Flanders claims that one of the great effects of the Industrial Revolution was that it created","w":0.67283950805664061,"c":1},{"c":1,"h":0.013081395583944611,"t":"choice. All sorts of things that had previously been luxuries - from sugar to cutlery - became","x":0.12962963486529172,"w":0.68724278767903635,"y":0.32703488360103217},{"h":0.014888563481882389,"x":0.12958521982107726,"c":1,"t":"conveniences, and before long they'd turned into necessities: life without sugar or cutlery was","w":0.70583592732747391,"y":0.34005649846856023},{"w":0.39732716878255209,"t":"unimaginable. Rather like mobile phones these days!","x":0.12952848371877196,"h":0.015141954410764269,"y":0.3546079396875883,"c":1},{"x":0.85596707866844246,"t":"Q38","y":0.20348837190279512,"w":0.034979422887166378,"h":0.013081395583944722,"c":1},{"h":0.011627907185728592,"c":1,"x":0.85802469159159334,"y":0.24709302309318226,"t":"Q39","w":0.032921810150146391},{"y":0.2761627905544225,"c":1,"h":0.011627907185728592,"x":0.85802469174571716,"t":"Q40","w":0.034979422887166378},{"t":"118","w":0.037037035624186199,"x":0.12757201706445012,"y":0.92151162776614737,"c":1,"h":0.011627907185728703}]}