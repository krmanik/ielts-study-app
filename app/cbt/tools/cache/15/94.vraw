{"w":2400,"lines":[{"x":0.38680867838839089,"w":0.10704107920328776,"c":1,"t":"TEST 2","h":0.014701799453357922,"y":0.14817235607094004},{"y":0.20487321654860491,"w":0.094692262013753262,"h":0.014672170960299491,"c":1,"x":0.08845633802828469,"t":"PART 1"},{"t":"TIM.","x":0.08836791121331844,"y":0.23382803537832597,"c":1,"h":0.009088115220356352,"w":0.02902549425760903},{"y":0.26162790677535275,"w":0.041152264277140291,"t":"JEAN:","x":0.086419752772266614,"h":0.011627907185728592,"c":1},{"w":0.030864197413126612,"h":0.010174418787512463,"t":"TIM:","y":0.29069767419999382,"x":0.086419753273889358,"c":1},{"h":0.011627907185728592,"x":0.086419752772266614,"y":0.30523255793814341,"w":0.041152264277140291,"t":"JEAN:","c":1},{"w":0.030864197413126612,"y":0.33430232545362748,"h":0.010174418787512574,"t":"TIM:","c":1,"x":0.086419753035059263},{"x":0.086419752537626515,"c":1,"h":0.010174418787512574,"w":0.041152264277140305,"y":0.36337209290505035,"t":"JEAN:"},{"h":0.010174418787512463,"t":"TIM","x":0.086419753049756493,"y":0.37790697661641814,"w":0.03086419741312664,"c":0.5},{"c":1,"t":"JEAN:","y":0.40552325556411239,"w":0.041152261098225909,"x":0.086419754481751224,"h":0.011627907185728592},{"h":0.0087209303892965551,"t":"TIM:","x":0.088477365987366052,"y":0.42151162779506546,"c":1,"w":0.028806584676106764},{"c":1,"w":0.039094648361206061,"h":0.010174418787512574,"y":0.44912790671573988,"t":"JEAN:","x":0.088477367623237838},{"c":1,"x":0.088477366003193836,"t":"TIM:","y":0.47965116267878649,"w":0.028806584676106778,"h":0.008720930389296444},{"y":0.53633720910093408,"w":0.041152264277140291,"h":0.011627907185728703,"x":0.086419752772266614,"t":"JEAN:","c":1},{"t":"TIM.","w":0.028806584676106792,"x":0.088477365995279944,"y":0.55232558128583342,"c":1,"h":0.008720930389296444},{"w":0.03916845321655274,"c":1,"t":"JEAN:","y":0.57987067334426079,"h":0.010316792590317592,"x":0.088440464980297645},{"y":0.59593023243037169,"h":0.010174418787512463,"c":1,"t":"TIM.","x":0.086419753035059263,"w":0.030864197413126612},{"y":0.62354651143473216,"x":0.088477367362606835,"c":1,"t":"JEAN:","h":0.010174418787512574,"w":0.039094648361206047},{"x":0.088477365995279944,"w":0.028806584676106792,"t":"TIM.","h":0.008720930389296444,"y":0.63953488361141486,"c":1},{"h":0.008720930389296444,"t":"JEAN:","x":0.088477367101975846,"y":0.66715116268325869,"w":0.039094648361206047,"c":1},{"w":0.03086419741312664,"h":0.010174418787512463,"c":1,"x":0.086419753042407871,"y":0.68168604638106489,"t":"TIM:"},{"c":1,"y":0.71802325568339043,"h":0.010174418787512463,"x":0.086419753042407871,"w":0.03086419741312664,"t":"TIM:"},{"t":"JEAN:","y":0.74563953463535326,"w":0.041152261098225895,"h":0.013081395583944722,"x":0.086419754430310913,"c":1},{"c":1,"t":"TIM:","x":0.086419753042407871,"w":0.03086419741312664,"y":0.77616279056711135,"h":0.010174418787512574},{"t":"JEAN:","x":0.086419754430310913,"w":0.041152261098225895,"h":0.011627907185728592,"c":1,"y":0.81831395326760081},{"y":0.83430232545362748,"x":0.086419753049756493,"t":"TIM:","h":0.010174418787512574,"c":1,"w":0.03086419741312664},{"c":1,"t":"Good morning. You're through to the tourist information office, Tim speaking.","x":0.1810013449643888,"w":0.56597106933593744,"h":0.014989392355839071,"y":0.23099102973561036},{"t":"How can I help you?","y":0.24553483950937616,"x":0.17882524845065498,"h":0.013691242788649527,"w":0.15265916188557946,"c":1},{"x":0.17901235436681381,"h":0.014560564106288587,"c":1,"y":0.26017441847128309,"t":"Oh hello. Could you give me some information about next month's festival,","w":0.55349792480468751},{"c":1,"x":0.17901235312353336,"y":0.27616279059018534,"w":0.45061726888020837,"t":"please? My family and I will be staying in the town that week.","h":0.011627907185728592},{"h":0.011778563015311994,"w":0.49382715861002602,"y":0.2891637217752161,"t":"Of course. Well it starts with a concert on the afternoon of the 17th.","c":1,"x":0.1810699596831781},{"x":0.18106994775434998,"y":0.30377906964724,"c":1,"w":0.51646092732747406,"h":0.013081395583944833,"t":"Oh I heard about that. The orchestra and singers come from the USA,"},{"h":0.013211355894558352,"x":0.17668907215509047,"t":"don't they?","w":0.086905975341796865,"c":1,"y":0.3179523028325506},{"x":0.17695472643676122,"w":0.59465021769205728,"h":0.014723203769140047,"c":1,"t":"They're from Canada. They're very popular over there. They're going to perform","y":0.33274440524521331},{"x":0.17901233612463746,"y":0.34738372082234037,"w":0.5617284138997396,"t":"a number of well-known pieces that will appeal to children as well as adults.","c":1,"h":0.011627907185728592},{"t":"That sounds good. My whole family are interested in music.","y":0.36189634875934451,"h":0.013103651354534618,"c":1,"x":0.17901234586986911,"w":0.44238683064778639},{"c":1,"x":0.17695474308267309,"t":"The next day, the 18th, there's a performance by a ballet company called","h":0.016195524146054185,"y":0.37632508816637156,"w":0.54115224202473955},{"t":"Eustatis.","y":0.3909883719493068,"x":0.17901234429557292,"w":0.06378601074218751,"h":0.013081395583944611,"c":1},{"y":0.40552325568523639,"c":1,"t":"Sorry?","h":0.011627907185728592,"x":0.1790123462083521,"w":0.051440327962239546},{"y":0.42005813941496872,"c":1,"t":"The name is spelt E-U-S-T-A-T-I-S. They appeared in last year's festival, and","x":0.17901234337836372,"w":0.56995885213216146,"h":0.013098515666696509},{"x":0.17901233458629784,"t":"went down very well. Again, their programme is designed for all ages.","h":0.011627907185728592,"w":0.51646092732747395,"c":1,"y":0.43459302314851311},{"w":0.54732508341471364,"t":"Good. I expect we'll go to that. I hope there's going to be a play during the","x":0.17901235530713316,"y":0.4490577151780365,"h":0.014723203769140158,"c":1},{"x":0.17876407305423495,"y":0.46190981351486493,"w":0.19391579945882162,"h":0.014972402013232688,"t":"festival, a comedy, ideally.","c":1},{"t":"You're in luck! On the 19th and 20th a local amateur group are performing one","y":0.47670946488716504,"w":0.58242991129557298,"c":1,"x":0.17688584872112159,"h":0.015339721077603397},{"t":"written by a member of the group. It's called Jemima. That'll be on in the town","x":0.17901234243327299,"h":0.011778563015312216,"w":0.57613169352213545,"y":0.49263839813929944,"c":1},{"w":0.60082305908203126,"y":0.50726744174066374,"x":0.17901233866850741,"c":1,"t":"hall. They've already performed it two or three times. I haven't seen it myself, but","h":0.013081395583944611},{"h":0.013093379417212669,"c":1,"x":0.17901234196354701,"t":"the review in the local paper was very good.","w":0.32921811421712244,"y":0.52179034162640758},{"h":0.011778563015312216,"y":0.53621908107072824,"x":0.17695473664692143,"c":1,"w":0.22222221374511722,"t":"And is it suitable for children?"},{"w":0.5884773763020833,"x":0.17901234053086532,"y":0.55087209290293049,"h":0.013081395583944722,"t":"Yes, in fact it's aimed more at children than at adults, so both performances are","c":1},{"y":0.56454594179165263,"w":0.12396890004475911,"c":1,"h":0.012596075891465497,"t":"in the afternoon.","x":0.17874712051487648},{"y":0.57979976456958049,"w":0.42386830647786455,"c":1,"h":0.011778563015312105,"t":"And what about dance? Will there be any performances?","x":0.17901234871630209},{"y":0.59302325568031011,"h":0.01453488398216074,"c":1,"x":0.17901233958975665,"t":"Yes, also on the 20th, but in the evening. A professional company is putting on a","w":0.59465021769205739},{"h":0.013250883392226132,"y":0.60895170805744891,"w":0.50205759684244788,"x":0.17901235369661209,"c":1,"t":"show of modern pieces, with electronic music by young composers."},{"y":0.63491538548293469,"t":"The show is about how people communicate, or fail to communicate, with each","c":1,"h":0.016636044173134024,"w":0.58658767700195313,"x":0.17892780774423264},{"h":0.014925841027070064,"x":0.17890715380878475,"t":"other, so it's got the rather strange name, Chat.","y":0.65071576139255116,"c":1,"w":0.35206771850585938},{"c":1,"t":"I suppose that's because that's something we do both face to face and online.","w":0.58024693806966143,"x":0.17901233348931053,"y":0.66569767429457494,"h":0.013081395583944611},{"c":1,"h":0.01403373992344803,"w":0.092975451151529942,"t":"That's right.","y":0.68033324713270849,"x":0.17681501139458178},{"t":"Now there are also some workshops and other activities. They'll all take place at","y":0.7164310953385139,"w":0.59670781453450528,"h":0.011778563015312105,"c":1,"x":0.18106996091521901},{"w":0.57416844685872392,"c":1,"t":"least once every day, so everyone who wants to take part will have a chance.","y":0.73024108144171851,"x":0.17896533275698726,"h":0.01485006267246558},{"x":0.18106996656491012,"t":"Good. We're particularly interested in cookery - you don't happen to have a","y":0.74558303882698818,"w":0.55967076619466138,"h":0.013250883392226132,"c":1},{"h":0.011778563015312105,"y":0.76148409918156579,"x":0.17901234810058209,"t":"cookery workshop, do you?","w":0.20576131184895835,"c":1},{"h":0.013081395583944722,"y":0.77470930220547274,"w":0.54115224202473966,"t":"We certainly do. It's going to focus on how to make food part of a healthy","x":0.18106996941691572,"c":1},{"t":"lifestyle, and it'll show that even sweet things like cakes can contain much less","x":0.18106995465793244,"w":0.58230453491210943,"h":0.013250883392226132,"c":1,"y":0.7891637217622508},{"t":"sugar than they usually do.","x":0.17901234629785018,"h":0.011627907185728592,"y":0.80523255802718585,"w":0.20370370229085288,"c":1},{"x":0.18106994838319887,"t":"That might be worth going to. We're trying to encourage our children to cook.","y":0.81831395338175794,"h":0.011627907185728592,"c":1,"w":0.56790125528971347},{"t":"Another workshop is just for children, and that's on creating posters to reflect the","y":0.83274440524532556,"x":0.17695472549833169,"w":0.60082305908203126,"h":0.014723203769140158,"c":1},{"x":0.17901233961076143,"w":0.59465021769205728,"h":0.011627907185728592,"c":1,"y":0.84738372082371449,"t":"history of the town. The aim is to make children aware of how both the town and"},{"t":"people's lives have changed over the centuries. The results will be exhibited in","x":0.18106994651185856,"h":0.01310365135453484,"y":0.86189634876036014,"w":0.58024693806966143,"c":1},{"t":"the community centre. Then the other workshop is in toy-making, and that's for","h":0.013250883392226132,"y":0.87632508819318455,"c":1,"x":0.17901235781786767,"w":0.5864197285970052},{"x":0.17680492343960055,"c":1,"w":0.088858788808186845,"t":"adults only.","h":0.012638471713476096,"y":0.89095418555880168},{"w":0.026748971939086874,"x":0.81687242751811096,"h":0.013081395583944722,"y":0.3895348835379695,"c":1,"t":"Q1"},{"t":"Q2","x":0.81893004067654707,"h":0.011627907185728592,"w":0.026748971939086874,"c":1,"y":0.520348837051956},{"h":0.013081395583944611,"c":1,"y":0.5784883719209637,"t":"Q3","x":0.8189300406679737,"w":0.026748971939086874},{"h":0.01453488398216074,"y":0.64825581376231112,"x":0.81893004089239918,"w":0.028806584676106861,"c":1,"t":"Q4"},{"h":0.013081394460653373,"x":0.81893004085658827,"c":1,"w":0.026748971939086874,"t":"Q5","y":0.77325581423406287},{"x":0.81893004085658827,"y":0.83139534911778368,"t":"Q6","w":0.026748971939086874,"c":1,"h":0.013081394460653373},{"x":0.83539094694119043,"y":0.92296511609610909,"c":1,"w":0.034979422887166267,"h":0.013081395583944722,"t":"101"}],"h":3395}