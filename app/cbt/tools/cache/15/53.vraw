{"lines":[{"x":0.13155355313745573,"y":0.10144417726147481,"h":0.013681412304809681,"c":1,"w":0.05788054784138999,"t":"Test 3"},{"x":0.13374485327397101,"w":0.1419753138224284,"t":"Questions 1-7","c":1,"h":0.014545155919482688,"y":0.14534883706784019},{"c":1,"x":0.13363188675431825,"y":0.17576353674387468,"w":0.74715764363606774,"t":"Do the following statements agree with the information given in Reading Passage 1?","h":0.021168093237635355},{"h":0.01898816112073487,"y":0.2106627639361851,"x":0.12952521468939249,"w":0.36854710896809895,"t":"In boxes 1-7 on your answer sheet, write","c":1},{"y":0.24563953474101063,"h":0.013081395583944722,"x":0.19958847832696955,"w":0.055555553436279298,"c":1,"t":"TRUE"},{"y":0.26157270267373234,"h":0.013191803886135056,"c":1,"w":0.067943693796793603,"t":"FALSE","x":0.19956724771379347},{"y":0.24259591411858494,"h":0.018262374527462821,"t":"if the statement agrees with the information","c":1,"x":0.32705163277800553,"w":0.38498382568359368},{"y":0.25972816074372451,"t":"if the statement contradicts the information","w":0.38088109334309894,"h":0.017140352543447812,"c":1,"x":0.32500021403637325},{"h":0.014534883982160629,"w":0.40740740458170577,"t":"NOT GIVEN if there is no information on this","c":1,"x":0.19958847868900931,"y":0.27761627893485197},{"t":"1 On leaving school, Moore did what his father wanted him to do.","c":1,"h":0.017441860778592999,"x":0.13168725211120708,"w":0.60493825276692714,"y":0.31976744170064519},{"h":0.011627907185728592,"c":1,"y":0.34738372070946122,"t":"2","w":0.012345678806304938,"x":0.13374485598779406},{"y":0.34222137999587221,"h":0.021518754453625277,"t":"Moore began studying sculpture in his first term at the Leeds School of Art.","w":0.67309127807617186,"c":1,"x":0.16653770860654069},{"y":0.37017501928940932,"w":0.677107899983724,"c":1,"t":"When Moore started at the Royal College of Art, its reputation for teaching","h":0.01934643937505176,"x":0.15425692762292612},{"y":0.38914105230393492,"x":0.17471996162243689,"c":1,"t":"sculpture was excellent.","w":0.21635353088378909,"h":0.015358872071031371},{"h":0.017995125553773583,"t":"4 Moore became aware of ancient sculpture as a result of visiting London museums.","w":0.77788441975911471,"y":0.41242184769937063,"x":0.13162551062343322,"c":1},{"w":0.68116917928059895,"c":1,"y":0.43855145705221643,"h":0.018636576559293627,"t":"The Trocadero Museum's Mayan sculpture attracted a lot of public interest.","x":0.1604452929118593},{"c":1,"x":0.15837147025726286,"h":0.019141112957742124,"t":"Moore thought the Mayan sculpture was similar in certain respects to other stone","y":0.46390130776871907,"w":0.73472462972005215},{"x":0.17478740949483001,"t":"sculptures.","w":0.10310007731119791,"h":0.015330852692764685,"c":1,"y":0.48361364327253209},{"h":0.019104933991448969,"c":1,"x":0.17071783278639638,"t":"The artists who belonged to Unit One wanted to make modern art and architecture","y":0.50641161404941759,"w":0.73472991943359367},{"t":"more popular.","w":0.12551439921061197,"h":0.013081395583944722,"x":0.17695473472254036,"y":0.52761627890860907,"c":1},{"x":0.13374485536790512,"y":0.918604650914423,"c":1,"t":"60","w":0.026748971939086902,"h":0.013081395583944722}],"h":3395,"w":2400}